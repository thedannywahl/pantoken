{
  "source": "en",
  "catalogs": {
    "template": "l10n/{space}.pot",
    "target": "l10n/{locale}/{space}.po"
  },
  "poOptions": {
    "defaultFlags": ["no-c-format"],
    "preserveObsolete": true
  },
  "locales": {
    "registry": "@pantoken/i18n#LOCALES",
    "exclude": [],
    "tiers": {
      "source": ["en"],
      "primary": ["en-*", "hu"],
      "secondary": ["*"]
    }
  },
  "defaults": {
    "translate": "always"
  },
  "drift": {
    "surfaces": {
      "ui.strings": { "source": "block", "primary": "warn", "secondary": "warn" },
      "cli.scaffold": { "source": "block", "primary": "warn", "secondary": "warn" },
      "cli.ai": { "source": "block", "primary": "warn", "secondary": "warn" },
      "docs.guides": { "source": "block", "primary": "warn", "secondary": "warn" },
      "docs.api": { "source": "block", "primary": "warn", "secondary": "warn" },
      "docs.glossary": { "source": "block", "primary": "warn", "secondary": "warn" },
      "docs.demos": { "source": "block", "primary": "warn", "secondary": "warn" },
      "docs.home": { "source": "block", "primary": "warn", "secondary": "warn" },
      "docs.chrome": { "source": "block", "primary": "warn", "secondary": "warn" },
      "docs.parity": "block"
    },
    "fallback": { "source": "block", "primary": "warn", "secondary": "warn" }
  },
  "spaces": {
    "docs.guides": {
      "kind": "content",
      "include": ["docs/guide/**/*.md"],
      "render": "docs/{locale}/guide/{path}",
      "transientRender": false,
      "segment": "block"
    },
    "ui.strings": {
      "kind": "messages",
      "source": "renderers/web-components/src/i18n.json"
    },
    "cli.scaffold": {
      "kind": "messages",
      "source": "packages/scaffold/src/i18n.json"
    },
    "cli.ai": {
      "kind": "messages",
      "source": "ai/pantoken-ai/src/i18n.json"
    }
  }
}
