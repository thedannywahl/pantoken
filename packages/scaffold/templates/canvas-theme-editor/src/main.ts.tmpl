let activeEditor: Editor | undefined;
let cssObjectUrl: string | undefined;
let jsObjectUrl: string | undefined;

// Only the tray (below) and the preview it drives read these — the chrome has its own,
// docs-driven theme/color tracked separately by `applyChromeTheme`/`applyChromeColor` above.
let selectedTheme: ThemeVariant = "rebrand";
let selectedColor: PantokenColorNamespace = "navy";
let selectedCustomColor = DEFAULT_CUSTOM_COLOR;
setupStandaloneAppShell();

interface CanvasThemePreset {
  readonly version: 1;
  readonly theme: ThemeVariant;
  readonly color: PantokenColorNamespace;
  readonly customColor?: string;
  readonly mode: ThemeMode;
  readonly cdnProvider: string;
  readonly customCss: string;
  readonly customJs: string;
  readonly editorHtml: string;
}

function selectThemeColor(color: PantokenColorNamespace): void {
  selectedColor = color;
  const colorButton = [...colorButtons].find((button) => button.dataset.color === color);
  if (colorButton) selectButton(colorButtons, colorButton);
  customColorRow.hidden = color !== CUSTOM_COLOR_KEY;
}

/** Stores a validated custom hex and reflects it in the tray. */
function setCustomColor(hex: string): void {
  selectedCustomColor = parseHexColor(hex);
  customColorPicker.value = selectedCustomColor;
  const typed = customColorHex.value;
  if (!isHexColor(typed) || parseHexColor(typed) !== selectedCustomColor) {
    customColorHex.value = selectedCustomColor;
  }
  customColorHex.classList.remove("-invalid");
  customColorHex.removeAttribute("aria-invalid");
  syncCustomSwatch(customColorSwatch, selectedCustomColor);
}

/** The `custom` scale's rule, only while it's the selected color. */
function selectedCustomColorCss(): string {
  return selectedColor === CUSTOM_COLOR_KEY
    ? customColorCss(selectedCustomColor, { selector: "" })
    : "";
}

const debouncedCustomColorRefresh = debounce(() => void refreshAll(), 150);

function onCustomColorInput(value: string): void {
  if (!isHexColor(value)) {
    customColorHex.classList.add("-invalid");
    customColorHex.setAttribute("aria-invalid", "true");
    return;
  }
  setCustomColor(value);
  if (selectedColor === CUSTOM_COLOR_KEY) debouncedCustomColorRefresh();
}

customColorPicker.addEventListener("input", () => onCustomColorInput(customColorPicker.value));
customColorHex.addEventListener("input", () => onCustomColorInput(customColorHex.value));
setCustomColor(DEFAULT_CUSTOM_COLOR);

function parseEditorHtml(html: string): HTMLTemplateElement {
  const template = document.createElement("template");
  template.innerHTML = html;
  return template;
}

function findColorWrapper(content: DocumentFragment): HTMLElement | undefined {
  const wrapper = content.firstElementChild as HTMLElement | null;
  if (!wrapper?.hasAttribute("data-pantoken-color")) return undefined;
  const hasContentOutsideWrapper = [...content.childNodes].some(
    (node) => node !== wrapper && (node.nodeType !== Node.TEXT_NODE || node.textContent?.trim()),
  );
  return hasContentOutsideWrapper ? undefined : wrapper;
}

function normalizeEditorHtml(html: string, fallbackColor: PantokenColorNamespace): string {
  const template = parseEditorHtml(html);
  let wrapper = findColorWrapper(template.content);
  if (!wrapper) {
    wrapper = document.createElement("div");
    wrapper.dataset.pantokenColor = fallbackColor;
    wrapper.append(...template.content.childNodes);
    template.content.append(wrapper);
  } else if (!isThemeColor(wrapper.dataset.pantokenColor)) {
    wrapper.dataset.pantokenColor = fallbackColor;
  }
  return template.innerHTML;
}

function editorHtmlColor(html: string): PantokenColorNamespace | undefined {
  const wrapper = findColorWrapper(parseEditorHtml(html).content);
  const color = wrapper?.dataset.pantokenColor;
  return isThemeColor(color) ? color : undefined;
}

function setEditorHtmlColor(html: string, color: PantokenColorNamespace): string {
  const template = parseEditorHtml(normalizeEditorHtml(html, color));
  findColorWrapper(template.content)!.dataset.pantokenColor = color;
  return template.innerHTML;
}

function syncThemeColorFromEditor(): void {
  const color = editorHtmlColor(getEditorHtml());
  if (color) selectThemeColor(color);
}

function applyThemeColor(color: PantokenColorNamespace, refresh = true): void {
  selectThemeColor(color);
  if (activeEditor) {
    const sourceToggle = activeEditor.plugins[SOURCE_TOGGLE_PLUGIN_NAME] as
      | SourceTogglePluginApi
      | undefined;
    const nextHtml = setEditorHtmlColor(getEditorHtml(), color);
    if (sourceToggle?.isSourceMode()) {
      sourceToggle.replaceAll(nextHtml);
    } else {
      activeEditor.undoManager.transact(() => activeEditor!.setContent(nextHtml));
    }
  }
  if (refresh) void refreshAll();
}

/** Reads the author's current HTML from whichever view (WYSIWYG or raw source) is active. */
function getEditorHtml(): string {
  const sourceToggle = activeEditor?.plugins[SOURCE_TOGGLE_PLUGIN_NAME] as
    | SourceTogglePluginApi
    | undefined;
  if (sourceToggle?.isSourceMode()) return sourceToggle.getContent();
  return activeEditor?.getContent() ?? "";
}

function getNormalizedEditorHtml(): string {
  return normalizeEditorHtml(getEditorHtml(), selectedColor);
}

function assetKey(asset: CdnFile): string {
  return `${asset.package}:${asset.path}`;
}

async function inlineAssetCss(assets: readonly CdnFile[]): Promise<string[]> {
  await Promise.all(
    assets.map(async (asset) => {
      const key = assetKey(asset);
      if (inlineAssetContents.has(key)) return;
      const response = await fetch(buildFileUrl(asset));
      if (!response.ok) {
        throw new Error(`Unable to inline ${asset.package}/${asset.path}: ${response.status}`);
      }
      inlineAssetContents.set(key, await response.text());
    }),
  );
  return assets.map((asset) => inlineAssetContents.get(assetKey(asset))!);
}

function syncIconAssetsFromEditor(): boolean {
  const content = parseEditorHtml(getEditorHtml()).content;
  const iconAssetKeys = new Set(availableIcons.map((icon) => assetKey(getIconCdnFile(icon))));
  const logoAssetKeys = new Set(logos.map((logo) => assetKey(getLogoCdnFile(logo))));
  const nonSyncedAssets = currentAssets.filter(
    (asset) => !iconAssetKeys.has(assetKey(asset)) && !logoAssetKeys.has(assetKey(asset)),
  );
  const usedIconAssets = getUsedIconCdnFiles(content, availableIcons, currentAssets);
  const usedLogoAssets = getUsedLogoCdnFiles(content, logos);
  const nextAssets = [...nonSyncedAssets, ...usedIconAssets, ...usedLogoAssets];
  const changed = currentAssets.map(assetKey).join("\n") !== nextAssets.map(assetKey).join("\n");
  if (changed) currentAssets.splice(0, currentAssets.length, ...nextAssets);
  return changed;
}

function captureCanvasThemePreset(): CanvasThemePreset {
  return {
    version: 1,
    theme: selectedTheme,
    color: selectedColor,
    customColor: selectedCustomColor,
    mode: includeDarkModeCheckbox.checked ? "adaptive" : "light",
    cdnProvider: providerSelect.value,
    customCss: cssEditorView.state.doc.toString(),
    customJs: jsEditorView.state.doc.toString(),
    editorHtml: getNormalizedEditorHtml(),
  };
}

function isThemeVariant(value: unknown): value is ThemeVariant {
  return value === "rebrand" || value === "canvas" || value === "canvasHighContrast";
}

function isThemeMode(value: unknown): value is ThemeMode {
  return value === "light" || value === "adaptive";
}

function isCdnProvider(value: unknown): value is string {
  return (
    typeof value === "string" &&
    (Object.hasOwn(CDN_PROVIDERS, value) || value === LOCAL_PROVIDER_ID)
  );
}

function isCanvasThemePreset(value: unknown): value is CanvasThemePreset {
  if (typeof value !== "object" || value === null) return false;
  const preset = value as Partial<CanvasThemePreset>;
  return (
    preset.version === 1 &&
    isThemeVariant(preset.theme) &&
    isThemeColor(preset.color) &&
    (preset.customColor === undefined || isHexColor(preset.customColor)) &&
    isThemeMode(preset.mode) &&
    isCdnProvider(preset.cdnProvider) &&
    typeof preset.customCss === "string" &&
    typeof preset.customJs === "string" &&
    typeof preset.editorHtml === "string"
  );
}

function replaceEditorDocument(view: EditorView, content: string): void {
  view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: content } });
}

function resetCanvasThemePreset(): void {
  selectedTheme = "rebrand";
  const themeButton = [...themeButtons].find((button) => button.dataset.theme === selectedTheme);
  if (themeButton) selectToggleButton(themeButtons, themeButton);
  includeDarkModeCheckbox.checked = false;
  syncDarkModeAvailability();
  providerSelect.value = isLocalPreview ? LOCAL_PROVIDER_ID : DEFAULT_CDN_PROVIDER_ID;
  selectThemeColor("navy");
  setCustomColor(DEFAULT_CUSTOM_COLOR);
  replaceEditorDocument(cssEditorView, "");
  replaceEditorDocument(jsEditorView, "");

  if (activeEditor) {
    const nextHtml = normalizeEditorHtml("", "navy");
    activeEditor.resetContent(nextHtml);
    const sourceToggle = activeEditor.plugins[SOURCE_TOGGLE_PLUGIN_NAME] as
      | SourceTogglePluginApi
      | undefined;
    if (sourceToggle?.isSourceMode()) sourceToggle.replaceAll(nextHtml);
  }

  syncThemeColorFromEditor();
  applyEditorTheme(activeEditor);
  void refreshAll();
}

function restoreCanvasThemePreset(preset: CanvasThemePreset): void {
  if (!activeEditor || !isCanvasThemePreset(preset)) throw new TypeError("invalid-preset");

  selectedTheme = preset.theme;
  const themeButton = [...themeButtons].find((button) => button.dataset.theme === preset.theme);
  if (themeButton) selectToggleButton(themeButtons, themeButton);
  includeDarkModeCheckbox.checked = preset.mode === "adaptive";
  syncDarkModeAvailability();
  providerSelect.value = preset.cdnProvider;
  selectThemeColor(preset.color);
  setCustomColor(preset.customColor ?? DEFAULT_CUSTOM_COLOR);
  replaceEditorDocument(cssEditorView, preset.customCss);
  replaceEditorDocument(jsEditorView, preset.customJs);

  const editorHtml = normalizeEditorHtml(preset.editorHtml, preset.color);
  activeEditor.resetContent(editorHtml);
  const sourceToggle = activeEditor.plugins[SOURCE_TOGGLE_PLUGIN_NAME] as
    | SourceTogglePluginApi
    | undefined;
  if (sourceToggle?.isSourceMode()) sourceToggle.replaceAll(editorHtml);
  syncThemeColorFromEditor();

  applyEditorTheme(activeEditor);
  void refreshAll();
}

function currentSelection(): { provider: string; theme: ThemeVariant; mode: ThemeMode } {
  return {
    provider: providerSelect.value,
    theme: selectedTheme,
    mode: includeDarkModeCheckbox.checked ? "adaptive" : "light",
  };
}

/** `css`/`js` are theme.css/theme.js's actual downloadable content and the live preview's styling
 * alike — both follow the visitor's/browser's own dark-mode preference, same as a real Canvas
 * page would. The preview's manual light/dark toggle overrides that via `PREVIEW_SCHEME_FORCE_CSS`
 * (see `updatePreview`), not by swapping this CSS. */
async function buildCurrentTheme(): Promise<{ css: string; js: string }> {
  const selection = currentSelection();
  const customCss = selectedCustomColorCss();
  if (selection.provider !== LOCAL_PROVIDER_ID) {
    const theme = buildTheme({
      ...selection,
      css: [...defaultThemeCssAssets(selection.theme, selection.mode), ...currentAssets],
    });
    return { ...theme, css: [theme.css, customCss].filter(Boolean).join("\n") };
  }

  const tokensCss =
    selection.theme === "canvas"
      ? canvasTokensCss
      : selection.theme === "canvasHighContrast"
        ? canvasHighContrastTokensCss
        : selection.mode === "adaptive"
          ? adaptiveTokensCss
          : rebrandLightTokensCss;
  const dynamicCss = await inlineAssetCss(currentAssets);
  return {
    css: [tokensCss, LOCAL_COMPONENT_CSS, ...dynamicCss, customCss].filter(Boolean).join("\n"),
    js: localInteractionsJs,
  };
}

/** Marks the clicked button as selected within its `role="group"` (theme or color pickers). */
function selectButton(buttons: NodeListOf<HTMLButtonElement>, target: HTMLButtonElement): void {
  for (const button of buttons) {
    const selected = button === target;
    button.classList.toggle("-selected", selected);
    button.setAttribute("aria-checked", String(selected));
  }
}

/** Marks the clicked instui-button `-toggle` as pressed within its `role="group"` (preview width). */
function selectToggleButton(buttons: NodeListOf<HTMLButtonElement>, target: HTMLButtonElement): void {
  for (const button of buttons) button.setAttribute("aria-pressed", String(button === target));
}

/** Only "rebrand" ships a dark scheme — canvas/canvasHighContrast are single-scheme themes. */
function syncDarkModeAvailability(): void {
  const supportsDarkMode = selectedTheme === "rebrand";
  includeDarkModeRow.hidden = !supportsDarkMode;
  includeDarkModeCheckbox.disabled = !supportsDarkMode;
  if (!supportsDarkMode) includeDarkModeCheckbox.checked = false;
  syncPreviewSchemeToggleAvailability();
}

/** The preview's own light/dark switch only makes sense once "include dark mode" is on. */
function syncPreviewSchemeToggleAvailability(): void {
  previewSchemeToggle.disabled = !includeDarkModeCheckbox.checked;
  if (previewSchemeToggle.disabled) {
    previewDarkOverride = false;
    previewSchemeToggle.setAttribute("aria-pressed", "false");
    previewSchemeToggle.classList.replace("-icon-sun", "-icon-moon");
