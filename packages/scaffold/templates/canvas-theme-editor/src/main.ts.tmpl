let activeEditor: Editor | undefined;
let cssObjectUrl: string | undefined;
let jsObjectUrl: string | undefined;
// Once the author hand-edits the CSS/JS tab, config-select changes no longer overwrite it —
// they only re-enable "Regenerate from config" so the edit isn't silently discarded.
let cssDirty = false;
let jsDirty = false;

// Only the rebrand theme ships light/dark values — the toggle is hidden for the other themes.
let selectedTheme: ThemeVariant = "rebrand";
let selectedColor: PantokenColorNamespace = "navy";
document.documentElement.dataset.pantokenColor = selectedColor;

function applyThemeColor(color: PantokenColorNamespace, refresh = true): void {
  selectedColor = color;
  document.documentElement.dataset.pantokenColor = color;
  const colorButton = [...colorButtons].find((button) => button.dataset.color === color);
  if (colorButton) selectButton(colorButtons, colorButton);
  if (refresh) updatePreview();
}

/** Reads the author's current HTML from whichever view (WYSIWYG or raw source) is active. */
function getEditorHtml(): string {
  const sourceToggle = activeEditor?.plugins[SOURCE_TOGGLE_PLUGIN_NAME] as
    | SourceTogglePluginApi
    | undefined;
  if (sourceToggle?.isSourceMode()) return sourceToggle.getContent();
  return activeEditor?.getContent() ?? "";
}

function currentSelection(): { provider: string; theme: ThemeVariant; mode: ThemeMode } {
  return {
    provider: providerSelect.value,
    theme: selectedTheme,
    mode: includeDarkModeCheckbox.checked ? "adaptive" : "light",
  };
}

function buildCurrentTheme(): { css: string; js: string } {
  const selection = currentSelection();
  if (!import.meta.env.DEV || selection.provider !== LOCAL_PROVIDER_ID) return buildTheme(selection);

  const tokensCss =
    selection.theme === "canvas"
      ? canvasTokensCss
      : selection.theme === "canvasHighContrast"
        ? canvasHighContrastTokensCss
        : selection.mode === "adaptive"
          ? adaptiveTokensCss
          : rebrandLightTokensCss;
  return {
    css: [tokensCss, LOCAL_COMPONENT_CSS].join("\n"),
    js: localInteractionsJs,
  };
}

/** Marks the clicked button as selected within its `role="group"` (theme or color pickers). */
function selectButton(buttons: NodeListOf<HTMLButtonElement>, target: HTMLButtonElement): void {
  for (const button of buttons) {
    const selected = button === target;
    button.classList.toggle("-selected", selected);
    button.setAttribute("aria-checked", String(selected));
  }
}

/** Marks the clicked instui-button `-toggle` as pressed within its `role="group"` (preview width). */
function selectToggleButton(buttons: NodeListOf<HTMLButtonElement>, target: HTMLButtonElement): void {
  for (const button of buttons) button.setAttribute("aria-pressed", String(button === target));
}

themeButtons.forEach((button) => {
  button.addEventListener("click", () => {
    selectedTheme = button.dataset.theme as ThemeVariant;
    selectButton(themeButtons, button);
    includeDarkModeRow.hidden = selectedTheme !== "rebrand";
    applyEditorTheme(activeEditor);
    refreshAll();
  });
});

colorButtons.forEach((button) => {
  button.addEventListener("click", () => {
    const color = button.dataset.color;
    if (isThemeColor(color)) applyThemeColor(color);
  });
});

// Canvas's own responsive breakpoints for course content, reused as-is from pantoken's tokens —
// "large" is unconstrained (the current default), matching the desktop RCE width.
const PREVIEW_WIDTHS: Record<string, string> = {
  medium: "var(--instui-breakpoints-md)",
  small: "var(--instui-breakpoints-sm)",
};

let selectedPreviewWidth = "large";

/**
 * In row layout, the *pane's* width is constrained so the editor pane's flex:1 can claim
 * whatever space a fixed-width (medium/small) preview gives up. In fullscreen the pane is
 * forced to fill the viewport (app.css's `!important` overlay), so there's no sibling to
 * reclaim space from — the constraint has to move to the iframe itself instead, centered
 * via app.css's `margin-inline: auto`.
 */
function applyPreviewWidth(): void {
  const fullscreen = previewPane.classList.contains("-fullscreen");
  previewPane.style.removeProperty("flex");
  previewPane.style.removeProperty("width");
  previewFrame.style.removeProperty("max-width");
  if (selectedPreviewWidth === "large") return;
  if (fullscreen) {
    previewFrame.style.maxWidth = PREVIEW_WIDTHS[selectedPreviewWidth];
  } else {
    previewPane.style.flex = "0 0 auto";
    previewPane.style.width = PREVIEW_WIDTHS[selectedPreviewWidth];
  }
}

previewWidthButtons.forEach((button) => {
  button.addEventListener("click", () => {
    selectToggleButton(previewWidthButtons, button);
    selectedPreviewWidth = button.dataset.previewWidth!;
    applyPreviewWidth();
    persistPreferences();
  });
});
if (
  preferences.previewWidth &&
  ["large", "medium", "small"].includes(preferences.previewWidth) &&
  preferences.previewWidth !== "large"
) {
  const savedWidthButton = [...previewWidthButtons].find(
    (button) => button.dataset.previewWidth === preferences.previewWidth,
  );
  if (savedWidthButton) {
    selectToggleButton(previewWidthButtons, savedWidthButton);
    selectedPreviewWidth = preferences.previewWidth;
    applyPreviewWidth();
  }
}

const previewFullscreenToggle = document.querySelector<HTMLButtonElement>(
  "#preview-fullscreen-toggle",
)!;
previewFullscreenToggle.addEventListener("click", () => {
  const fullscreen = previewFullscreenToggle.getAttribute("aria-pressed") !== "true";
  previewFullscreenToggle.setAttribute("aria-pressed", String(fullscreen));
  previewFullscreenToggle.classList.toggle("-icon-expand", !fullscreen);
  previewFullscreenToggle.classList.toggle("-icon-minimize", fullscreen);
  previewPane.classList.toggle("-fullscreen", fullscreen);
  applyPreviewWidth();
  resizePreviewFrame();
  persistPreferences();
});
if (preferences.previewFullscreen === true) {
  previewFullscreenToggle.setAttribute("aria-pressed", "true");
  previewFullscreenToggle.classList.toggle("-icon-expand", false);
  previewFullscreenToggle.classList.toggle("-icon-minimize", true);
  previewPane.classList.toggle("-fullscreen", true);
  applyPreviewWidth();
}

const layoutDirectionToggle = document.querySelector<HTMLButtonElement>(
  "#layout-direction-toggle",
)!;
const contentEl = document.querySelector<HTMLElement>(".content")!;
layoutDirectionToggle.addEventListener("click", () => {
  const row = layoutDirectionToggle.getAttribute("aria-pressed") !== "true";
  layoutDirectionToggle.setAttribute("aria-pressed", String(row));
  layoutDirectionToggle.classList.toggle("-icon-layout-panel-left", row);
  layoutDirectionToggle.classList.toggle("-icon-layout-panel-top", !row);
  contentEl.style.flexDirection = row ? "row" : "column";
  contentEl.dataset.layout = row ? "row" : "column";
  persistPreferences();
});
if (preferences.layout === "row" || preferences.layout === "column") {
  const row = preferences.layout === "row";
  layoutDirectionToggle.setAttribute("aria-pressed", String(row));
  layoutDirectionToggle.classList.toggle("-icon-layout-panel-left", row);
  layoutDirectionToggle.classList.toggle("-icon-layout-panel-top", !row);
  contentEl.style.flexDirection = row ? "row" : "column";
  contentEl.dataset.layout = row ? "row" : "column";
}

/** Saves this app's current layout/preview/CDN provider settings for the next visit. */
function persistPreferences(): void {
  savePreferences({
    layout: contentEl.dataset.layout === "row" ? "row" : "column",
    previewWidth: selectedPreviewWidth as "large" | "medium" | "small",
    previewFullscreen: previewPane.classList.contains("-fullscreen"),
    cdnProvider: providerSelect.value,
  });
}


includeDarkModeCheckbox.addEventListener("change", refreshAll);

/** Debounce helper — the preview pane only needs to refresh a beat after typing settles. */
function debounce<Args extends unknown[]>(fn: (...args: Args) => void, ms: number) {
  let handle: ReturnType<typeof setTimeout> | undefined;
  return (...args: Args) => {
    if (handle) clearTimeout(handle);
    handle = setTimeout(() => fn(...args), ms);
  };
}

/**
 * Renders the editor's current HTML with the CSS/JS tab's *current editable text* embedded
 * directly (not linked from the CDN) — so hand-edits in those tabs show up in the preview too.
 * The body content is wrapped to match Canvas's own content-area background and max width.
 * `data-pantoken-color` on the root element, plus the inlined `CUSTOM_THEME_COLORS_CSS`, remaps
 * brand colors instantly — a no-op for the default "navy" scheme. `#content`'s height is a min,
 * not a fixed viewport height, so the iframe (resized to match in `resizePreviewFrame`) grows to
 * fit instead of scrolling internally.
 */
function updatePreview(): void {
  if (!activeEditor) return;
  // Canvas's own theme already frames the RCE content area — the picker's border would double up.
  previewFrame.style.borderColor =
    selectedTheme === "canvas" || selectedTheme === "canvasHighContrast" ? "transparent" : "";
  const themeCss = cssEditorView.state.doc.toString();
  const themeJs = jsEditorView.state.doc.toString();
  // Elevation is a rebrand-only affordance — Canvas's own themes don't use drop-shadow surfaces.
  const contentClass =
    selectedTheme === "rebrand"
      ? "instui-view -background-primary --elevation-resting"
      : "instui-view -background-primary";
  previewFrame.srcdoc = `<!doctype html><html data-pantoken-color="${selectedColor}"><head><style>${themeCss}
${CUSTOM_THEME_COLORS_CSS}</style><style>#wrapper{padding:32px;}#content{padding:36px 48px 48px;min-height:20rem;margin:0 auto;border-radius:12px;}@media not all and (min-width: 768px) {
  #wrapper{padding:24px;}#content{padding-left:12px;padding-right:12px;min-height:16rem;border-radius:8px;}</style></head><body>
    <div id="wrapper" class="instui-view"><div id="content" class="${contentClass}" style="max-width: ${CANVAS_CONTENT_MAX_WIDTH};">
      ${getEditorHtml()}
    </div></div>
    <script>${themeJs}</script>
  </body></html>`;
}
const debouncedUpdatePreview = debounce(updatePreview, 300);

// Keep the same-origin preview frame at its content height; the docs embedding page separately
// receives its own postMessage height updates from `canvas-rce-iframe-height.js`.
let previewResizeObserver: ResizeObserver | undefined;
let previewMutationObserver: MutationObserver | undefined;
const PREVIEW_BORDER_PX = 2;
function resizePreviewFrame(): void {
  // Fullscreen pins the pane to the viewport, so the frame flexes to fill it (app.css) rather than
  // growing past it — a content-height frame would push the overlay into a scrollbar.
  if (previewPane.classList.contains("-fullscreen")) {
    previewFrame.style.removeProperty("height");
    return;
  }
  const root = previewFrame.contentDocument?.documentElement;
  const body = previewFrame.contentDocument?.body;
  if (!root || !body) return;
  const style = getComputedStyle(body);
  const margins = Number.parseFloat(style.marginTop) + Number.parseFloat(style.marginBottom);
  const height = Math.ceil(Math.max(root.getBoundingClientRect().height, body.offsetHeight + margins));
  previewFrame.style.height = `${height + PREVIEW_BORDER_PX}px`;
}
previewFrame.addEventListener("load", () => {
  previewResizeObserver?.disconnect();
  previewMutationObserver?.disconnect();
  resizePreviewFrame();
  const root = previewFrame.contentDocument?.documentElement;
  if (!root) return;
  previewResizeObserver = new ResizeObserver(resizePreviewFrame);
  previewResizeObserver.observe(root);
  previewMutationObserver = new MutationObserver(resizePreviewFrame);
  previewMutationObserver.observe(root, { childList: true, subtree: true, attributes: true });
});

/** Regenerates the downloadable theme.css/theme.js blobs for the chosen provider/theme/mode. */
function updateDownloads(): void {
  const { css: generatedCss, js: generatedJs } = buildCurrentTheme();
  if (cssObjectUrl) URL.revokeObjectURL(cssObjectUrl);
  if (jsObjectUrl) URL.revokeObjectURL(jsObjectUrl);
  cssObjectUrl = URL.createObjectURL(new Blob([generatedCss], { type: "text/css" }));
  jsObjectUrl = URL.createObjectURL(new Blob([generatedJs], { type: "text/javascript" }));
  downloadCss.href = cssObjectUrl;
  downloadJs.href = jsObjectUrl;
}

/** Re-seeds the CSS/JS editors from the current config, unless the author has hand-edited them. */
function updateThemeEditors(): void {
  const { css, js } = buildCurrentTheme();
  if (!cssDirty) replaceEditorDoc(cssEditorView, css);
  if (!jsDirty) replaceEditorDoc(jsEditorView, js);
}

function refreshAll(): void {
  updateThemeEditors();
  updatePreview();
  updateDownloads();
}

// CSS/JS editors, seeded from the initial config selection.
const cssEditorView = createEditor(
  document.querySelector<HTMLElement>("#css-editor")!,
  "css",
  buildCurrentTheme().css,
  () => {
    cssDirty = true;
    regenerateCssButton.hidden = false;
    debouncedUpdatePreview();
  },
);
const jsEditorView = createEditor(
  document.querySelector<HTMLElement>("#js-editor")!,
  "javascript",
  buildCurrentTheme().js,
  () => {
    jsDirty = true;
    regenerateJsButton.hidden = false;
    debouncedUpdatePreview();
  },
);

regenerateCssButton.addEventListener("click", () => {
  replaceEditorDoc(cssEditorView, buildCurrentTheme().css);
  cssDirty = false;
  regenerateCssButton.hidden = true;
  debouncedUpdatePreview();
});
regenerateJsButton.addEventListener("click", () => {
  replaceEditorDoc(jsEditorView, buildCurrentTheme().js);
  jsDirty = false;
  regenerateJsButton.hidden = true;
  debouncedUpdatePreview();
});

providerSelect.addEventListener("change", () => {
  refreshAll();
  persistPreferences();
});

copyButton.addEventListener("click", () => {
  void navigator.clipboard.writeText(getEditorHtml()).then(() => {
    copyStatus.textContent = "Copied. Paste into the Canvas Rich Content Editor HTML view.";
  });
});

