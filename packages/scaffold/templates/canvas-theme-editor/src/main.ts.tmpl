// The generated wrapper markup ships generic placeholder text/actions — replace them with this
// app's own copy and controls.
document.querySelector(".title")!.textContent = "RCE template authoring";
document.querySelector(".description")!.textContent =
  "Author Canvas RCE page templates styled with pantoken, with a live preview.";
document.querySelector(".actions")!.innerHTML = `
  <button class="instui-button" type="button" popovertarget="theme-tray">Edit theme</button>
  <button class="instui-button -color-secondary" type="button" command="show-modal" commandfor="help-modal" aria-label="Help">?</button>
`;
document.querySelector('slot[name="content"]')!.innerHTML = `
  <p>
    <button type="button" id="copy-html">Copy HTML</button>
    <span id="copy-status" role="status"></span>
  </p>
  <div class="split-pane" id="split-pane">
    <div class="pane editor-pane" id="editor-pane">
      <div class="pane-toolbar" data-pane-handle="editor-pane">
