// pantoken's token sheets express dark mode as `light-dark()`, which lightningcss (this bundle's
// minifier) downlevels to two OS-preference-gated control variables — fine for theme.css (a real
// Canvas page can't force a scheme anyway), but it means `color-scheme`/`data-pantoken-scheme`
// alone can't force the *preview's* scheme against the visitor's own OS setting. This block
// re-derives those two control variables from `data-pantoken-scheme` so the preview's light/dark
// toggle actually overrides it. `--lightningcss-light`/`-dark` are lightningcss's fixed,
// undocumented-but-stable names for this downlevel — see the vendored `--lightningcss-*` custom
// properties in @pantoken/css's built output.
const PREVIEW_SCHEME_FORCE_CSS = `
[data-pantoken-scheme="light"] { --lightningcss-light: initial; --lightningcss-dark: ; }
[data-pantoken-scheme="dark"] { --lightningcss-light: ; --lightningcss-dark: initial; }
`;

/** Minimal `{{key}}` substitution — every key must exist in `strings`, values are inserted raw. */
function render(template: string, strings: Record<string, string>): string {
  return template.replace(/\{\{(\w+)\}\}/g, (match, key: string) => strings[key] ?? match);
}

function syncPreviewPopupChrome(): void {
  if (!previewPopup || previewPopup.closed) return;
  const popupDocument = previewPopup.document;
  for (const { source, clone } of previewPopupStylePairs) clone.textContent = source.textContent;
  for (const attribute of [
    "lang",
    "dir",
    "data-pantoken-instance",
    "data-pantoken-theme",
    "data-pantoken-scheme",
    "data-pantoken-color",
  ]) {
    const value = document.documentElement.getAttribute(attribute);
    if (value === null) popupDocument.documentElement.removeAttribute(attribute);
    else popupDocument.documentElement.setAttribute(attribute, value);
  }
  popupDocument.documentElement.style.colorScheme = document.documentElement.style.colorScheme;
}

function createShellIcon(icon: Parameters<typeof createElement>[0]): SVGSVGElement {
  const svg = createElement(icon, { width: 16, height: 16, "stroke-width": 2 });
  svg.classList.add("canvas-rce-shell__icon");
  return svg;
}

function syncBrowserMetadata(): void {
  const themeColorMeta =
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]') ??
    document.createElement("meta");
  themeColorMeta.name = "theme-color";
  const backgroundColor = getComputedStyle(document.documentElement).backgroundColor;
  if (backgroundColor) themeColorMeta.content = backgroundColor;
  if (!themeColorMeta.parentElement) document.head.append(themeColorMeta);

  const favicon = document.querySelector<HTMLLinkElement>(
    'link[rel="icon"][data-pantoken-themed-icon]',
  );
  if (!favicon) return;
  const accentColor = getComputedStyle(document.documentElement)
    .getPropertyValue("--instui-primitive-color-navy-navy100")
    .trim();
  if (!accentColor) return;
  const mark = PANTOKEN_ICON.replace(
    "<svg ",
    '<svg x="32" y="32" width="64" height="64" ',
  ).replaceAll(/fill="[^"]+"/gu, 'fill="#fff"');
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><rect width="128" height="128" rx="24" fill="${accentColor}"/>${mark}</svg>`;
  favicon.href = `data:image/svg+xml,${encodeURIComponent(svg)}`;
}

function setupStandaloneAppShell(): void {
  if (window.self !== window.top || document.getElementById("canvas-rce-shell")) return;

  document.body.classList.add("canvas-rce-shell-enabled");
  document.title =
    document.querySelector<HTMLMetaElement>('meta[name="application-name"]')?.content ||
    "Canvas Theme Editor";

  const shell = document.createElement("header");
  shell.id = "canvas-rce-shell";
  shell.className = "canvas-rce-shell";

  const brand = document.createElement("div");
  brand.className = "canvas-rce-shell__brand";

  const brandMark = document.createElement("a");
  brandMark.className = "instui-button -color-primary -shape-square canvas-rce-shell__brand-mark";
  brandMark.href = "https://pantoken.app/";
  brandMark.target = "_blank";
  brandMark.rel = "noopener noreferrer";
  brandMark.setAttribute("aria-label", "Pantoken (opens pantoken.app in a new tab)");
  brandMark.innerHTML = PANTOKEN_ICON;

  const brandText = document.createElement("div");
  const eyebrow = document.createElement("span");
  eyebrow.className = "canvas-rce-shell__eyebrow";
  eyebrow.textContent = "Pantoken";
  const title = document.createElement("strong");
  title.textContent = "Canvas Theme Editor";
  brandText.append(eyebrow, title);
  brand.append(brandMark, brandText);

  const actions = document.createElement("div");
  actions.className = "canvas-rce-shell__actions";

  const localeMenu = document.createElement("details");
  localeMenu.className = "canvas-rce-shell__menu";
  const localeSummary = document.createElement("summary");
  localeSummary.className = "canvas-rce-shell__summary instui-button -color-tertiary";
  localeSummary.append(createShellIcon(Languages));
  const localeLabel = document.createElement("span");
  localeLabel.className = "canvas-rce-shell__label";
  const localeLocale = (
    document.documentElement.lang || navigator.languages?.[0] || navigator.language || "en-US"
  ).trim();
  let localeText = "English";
  try {
    // Names itself, in its own script (matching the picker's own option labels below).
    localeText = new Intl.DisplayNames([localeLocale], { type: "language" }).of(localeLocale) ?? localeText;
  } catch {
    localeText = localeLocale.split("-")[0].toUpperCase();
  }
  localeLabel.textContent = localeText;
  localeSummary.append(localeLabel, createShellIcon(ChevronDown));

  const localePanel = document.createElement("div");
  localePanel.className = "canvas-rce-shell__panel";
  const localePanelScroll = document.createElement("div");
  localePanelScroll.className = "canvas-rce-shell__panel-scroll";
  const availableLocales = ["en", ...Object.keys(LOCALE_STRINGS).sort()];
  const localeDisplayNames = new Intl.DisplayNames(availableLocales, { type: "language" });
  for (const locale of availableLocales) {
    const option = document.createElement("button");
    option.type = "button";
    option.className = "canvas-rce-shell__option";
    option.dataset.locale = locale;
    const optionLabel = document.createElement("span");
    // Each locale names itself, in its own script — matching the summary's own display name.
    optionLabel.textContent =
      new Intl.DisplayNames([locale], { type: "language" }).of(locale) ??
      localeDisplayNames.of(locale) ??
      locale;
    const optionMark = document.createElement("span");
    optionMark.className = "canvas-rce-shell__mark";
    optionMark.append(createShellIcon(Check));
    option.append(optionLabel, optionMark);
    if (document.documentElement.lang === locale || (!document.documentElement.lang && locale === "en")) {
      option.classList.add("is-selected");
    }
    option.addEventListener("click", () => {
      if (locale === document.documentElement.lang) {
        localeMenu.removeAttribute("open");
        return;
      }
      try {
        localStorage.setItem(LOCALE_STORAGE_KEY, locale);
      } catch {
        // Private mode / storage disabled — the reload below still applies it for this load.
      }
      // The app's own strings are only ever resolved once, at the initial `render()` call — a
      // reload re-runs that with the newly persisted locale instead of trying to re-render (and
      // re-initialize TinyMCE, the popup, etc.) in place.
      window.location.reload();
    });
    localePanelScroll.append(option);
  }
  localePanel.append(localePanelScroll);
  localeMenu.append(localeSummary, localePanel);

  const themeMenu = document.createElement("details");
  themeMenu.className = "canvas-rce-shell__menu";
  const themeSummary = document.createElement("summary");
  themeSummary.className = "canvas-rce-shell__summary instui-button -color-tertiary";
  themeSummary.append(createShellIcon(Palette));
  const themeLabel = document.createElement("span");
  themeLabel.className = "canvas-rce-shell__label";
  themeLabel.textContent = activeStrings.themeLabel;
  themeSummary.append(themeLabel, createShellIcon(ChevronDown));

  const themePanel = document.createElement("div");
  themePanel.className = "canvas-rce-shell__panel";
  const themePanelScroll = document.createElement("div");
  themePanelScroll.className = "canvas-rce-shell__panel-scroll";

  const appearanceGroup = document.createElement("div");
  appearanceGroup.className = "canvas-rce-shell__group";
  const appearanceTitle = document.createElement("span");
  appearanceTitle.className = "canvas-rce-shell__group-title";
  appearanceTitle.textContent = activeStrings.appearanceLabel;
  appearanceGroup.append(appearanceTitle);
  // Shared by the click handler below and the initial application at the end of this function.
  const applyAppearance = (appearance: "light" | "dark"): void => {
    document.body.dataset.appearanceMode = appearance;
    document.documentElement.style.colorScheme = appearance;
    document.documentElement.dataset.pantokenScheme = appearance;
    if (typeof applyChromeTheme === "function") {
      applyChromeTheme(selectedTheme ?? "rebrand", appearance);
    }
    for (const candidate of themePanel.querySelectorAll<HTMLButtonElement>("[data-appearance]")) {
      candidate.classList.toggle("is-selected", candidate.dataset.appearance === appearance);
    }
  };
  for (const [appearance, label, icon] of [
    ["light", activeStrings.appearanceLightLabel, SunMedium],
    ["dark", activeStrings.appearanceDarkLabel, MoonStar],
  ] as const) {
    const option = document.createElement("button");
    option.type = "button";
    option.className = "canvas-rce-shell__option";
    option.dataset.appearance = appearance;
    const text = document.createElement("span");
    text.textContent = label;
    const mark = document.createElement("span");
    mark.className = "canvas-rce-shell__mark";
    mark.append(createShellIcon(icon));
    option.append(text, mark);
    if (appearance === "light") option.classList.add("is-selected");
    option.addEventListener("click", () => {
      applyAppearance(appearance);
      // The editor content and the live preview both default to following the app's own
      // appearance — only guide mode (via `applyParentTheme`) did this before; tools mode's own
      // shell toggle left both stuck on their prior scheme until a tray/preview control changed.
      applyEditorTheme(activeEditor);
      syncPreviewSchemeToAppearance(appearance);
      void refreshAll();
      themeMenu.removeAttribute("open");
    });
    appearanceGroup.append(option);
  }

  const colorGroup = document.createElement("div");
  colorGroup.className = "canvas-rce-shell__group";
  const colorTitle = document.createElement("span");
  colorTitle.className = "canvas-rce-shell__group-title";
  colorTitle.textContent = activeStrings.colorLabel;
  colorGroup.append(colorTitle);
  for (const color of [...COLOR_KEYS, CUSTOM_COLOR_KEY]) {
    const option = document.createElement("button");
    option.type = "button";
    option.className = "canvas-rce-shell__option";
    option.dataset.color = color;
    const swatch = document.createElement("span");
    swatch.className = "theme-picker__swatch";
    swatch.dataset.swatch = color;
    const text = document.createElement("span");
    const colorKey = `color${color.charAt(0).toUpperCase()}${color.slice(1)}Label`;
    text.textContent = activeStrings[colorKey] ?? color.charAt(0).toUpperCase() + color.slice(1);
    const mark = document.createElement("span");
    mark.className = "canvas-rce-shell__mark";
    mark.append(createShellIcon(Check));
    option.append(swatch, text, mark);
    // "navy" is the app's actual default (see `selectedColor`/`applyChromeColor("navy")` below) —
    // without this the picker showed no color as selected until the user picked one explicitly.
    if (color === "navy") option.classList.add("is-selected");
    option.addEventListener("click", () => {
      applyChromeColor(color);
      // Custom stays open so the hex field below is reachable.
      if (color !== CUSTOM_COLOR_KEY) themeMenu.removeAttribute("open");
    });
    colorGroup.append(option);
  }

  const customRow = document.createElement("div");
  customRow.className = "theme-picker__custom canvas-rce-shell__custom";
  customRow.hidden = true;
  const customLabel = document.createElement("label");
  customLabel.htmlFor = "canvas-rce-shell-custom-hex";
  customLabel.textContent = activeStrings.customColorInputLabel;
  const customInputs = document.createElement("div");
  customInputs.className = "theme-picker__custom-inputs";
  const customPicker = document.createElement("input");
  customPicker.type = "color";
  customPicker.setAttribute("aria-label", activeStrings.customColorInputLabel);
  const customHex = document.createElement("input");
  customHex.type = "text";
  customHex.id = "canvas-rce-shell-custom-hex";
  customHex.className = "instui-text-input -size-sm";
  customHex.maxLength = 7;
  customHex.spellcheck = false;
  customHex.autocomplete = "off";
  customInputs.append(customPicker, customHex);
  customRow.append(customLabel, customInputs);
  colorGroup.append(customRow);

  const onShellCustomInput = (value: string): void => {
    const valid = isHexColor(value);
    customHex.classList.toggle("-invalid", !valid);
    customHex.toggleAttribute("aria-invalid", !valid);
    if (valid) applyChromeColor(CUSTOM_COLOR_KEY, value);
  };
  customPicker.addEventListener("input", () => onShellCustomInput(customPicker.value));
  customHex.addEventListener("input", () => onShellCustomInput(customHex.value));

  syncShellCustomColor = () => {
    const color = document.documentElement.dataset.pantokenColor;
    for (const candidate of themePanel.querySelectorAll<HTMLButtonElement>("[data-color]")) {
      candidate.classList.toggle("is-selected", candidate.dataset.color === color);
    }
    customRow.hidden = color !== CUSTOM_COLOR_KEY;
    customPicker.value = chromeCustomColor;
    if (!isHexColor(customHex.value) || parseHexColor(customHex.value) !== chromeCustomColor) {
      customHex.value = chromeCustomColor;
    }
    syncCustomSwatch(colorGroup.querySelector('[data-swatch="custom"]')!, chromeCustomColor);
  };
  syncShellCustomColor();

  themePanelScroll.append(appearanceGroup, colorGroup);
  themePanel.append(themePanelScroll);
  themeMenu.append(themeSummary, themePanel);
  actions.append(localeMenu, themeMenu);
  shell.append(brand, actions);
  document.body.prepend(shell);

  // Native <details> doesn't close on its own for either of these — without this a click
  // elsewhere on the page, or Escape, leaves the panel open.
  const shellMenus = [localeMenu, themeMenu];
  document.addEventListener("click", (event) => {
    for (const menu of shellMenus) {
      if (menu.open && !menu.contains(event.target as Node)) menu.removeAttribute("open");
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const menu of shellMenus) {
      if (!menu.open) continue;
      menu.removeAttribute("open");
      menu.querySelector<HTMLElement>("summary")?.focus();
    }
  });

  applyAppearance("light");
}

/** Persists the shell's own locale choice — never the authored content's own `lang`/`dir`. */
const LOCALE_STORAGE_KEY = "pantoken-canvas-theme-editor-locale";

/** Reads the persisted locale choice, tolerating missing/corrupt/blocked storage. */
function loadLocale(): string {
  try {
    return localStorage.getItem(LOCALE_STORAGE_KEY) || "en";
  } catch {
    return "en";
  }
}

const activeLocale = loadLocale();
