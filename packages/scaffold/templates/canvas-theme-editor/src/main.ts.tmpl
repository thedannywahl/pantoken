import "tinymce/skins/ui/oxide/skin.css";
import "tinymce/skins/ui/oxide/content.css";
import "tinymce/skins/content/default/content.css";
import {
  buildTheme,
  buildThemeCss,
  buildThemeJs,
  CDN_PROVIDERS,
  DEFAULT_CDN_PROVIDER_ID,
  type ThemeMode,
  type ThemeVariant,
} from "@pantoken/canvas-theme-editor";
import type { Editor, Ui } from "tinymce";
import { basicSetup, EditorView } from "codemirror";
import { css } from "@codemirror/lang-css";
import { html } from "@codemirror/lang-html";
import { javascript } from "@codemirror/lang-javascript";
import type { CdnFile } from "@pantoken/cdn";
import {
  createTemplatesPlugin,
  createComponentsPlugin,
  createIconsPlugin,
  createLogosPlugin,
  listComponents,
  listUtilities,
  loadAllIcons,
  logos,
  products,
  pantokenHtmlLinter,
  pantokenHtmlCompletion,
} from "@pantoken/tinymce";

// Shared with the toolbar's source-view editor so both stay the same size.
const EDITOR_HEIGHT_PX = 400;
// Canvas's content area caps out at this width — the preview mirrors that constraint.
const CANVAS_CONTENT_MAX_WIDTH = "59.25rem";

// Bundled starter templates: filename (minus .html) -> raw HTML content.
const templateModules = (import.meta as any).glob("../templates/pages/*.html", {
  query: "?raw",
  import: "default",
  eager: true,
});
const starterTemplates = Object.entries(templateModules).map(([path, module]) => ({
  title: path.split("/").pop()!.replace(/\.html$/, ""),
  content: (module as unknown as { default: string }).default,
}));

document.querySelector<HTMLDivElement>("#app")!.innerHTML = `
