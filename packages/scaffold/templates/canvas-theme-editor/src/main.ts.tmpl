/** Minimal `{{key}}` substitution — every key must exist in `strings`, values are inserted raw. */
function render(template: string, strings: Record<string, string>): string {
  return template.replace(/\{\{(\w+)\}\}/g, (match, key: string) => strings[key] ?? match);
}

