      toolbar: `undo redo | pantoken ${SAVE_TOOLBAR_NAME} | fontsize blocks | bold italic underline forecolor backcolor ${SUP_SUB_TOOLBAR_NAME} | link image placehold | align | bullist numlist | removeformat table media`,
      menubar: false,
      theme: "silver",
      icons: PANTOKEN_ICON_PACK_NAME,
      branding: false,
      // Self-hosted TinyMCE 6+ requires a license_key; "gpl" opts into the GPL license terms.
      license_key: "gpl",
      browser_spellcheck: true,
