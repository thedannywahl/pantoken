      elementpath: false,
      block_formats: "Paragraph=p;Heading 2=h2;Heading 3=h3;Heading 4=h4;Heading 5=h5;Heading 6=h6",
      // The icons picker pre-registers its own database under this id (see @pantoken/tinymce's
      // icons plugin) — the url is never fetched since the id is already cached by the time the
      // `emoticons` plugin initializes (it comes after `pantoken` in the `plugins` list above).
      emoticons_database_id: PANTOKEN_ICONS_DATABASE_ID,
      emoticons_database_url: "about:blank",
      // Hides the image dialog's Upload tab so only a remote http/https URL can be inserted — no
      // local file picker, no base64 data-URI embedding.
      image_uploadtab: false,
