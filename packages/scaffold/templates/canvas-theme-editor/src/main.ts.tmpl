}

const editorThemeCss: Record<
  ThemeVariant,
  { skin: string; content: string }
> = {
  rebrand: { skin: nextGenSkinCss, content: nextGenContentCss },
  canvas: { skin: canvasSkinCss, content: canvasContentCss },
  canvasHighContrast: {
    skin: canvasHighContrastSkinCss,
    content: canvasHighContrastContentCss,
  },
};

const editorSkinStyle = document.createElement("style");
document.head.append(editorSkinStyle);
let editorContentStyle: HTMLStyleElement | undefined;

function isThemeColor(color: unknown): color is PantokenColorNamespace {
  return color === CUSTOM_COLOR_KEY || isShippedColor(color);
}

/** The docs host only ever offers the 13 shipped scales, so the chrome never takes `custom`. */
function isShippedColor(color: unknown): color is (typeof COLOR_KEYS)[number] {
  return typeof color === "string" && (COLOR_KEYS as readonly string[]).includes(color);
}

/** Applies the selected static skin to TinyMCE's chrome and iframe document. */
function applyEditorTheme(editor: Editor | undefined): void {
  const css = editorThemeCss[selectedTheme];
  editorSkinStyle.textContent = css.skin;

  if (!editor) return;
  const editorDocument = editor.getDoc();
  if (!editorContentStyle || editorContentStyle.ownerDocument !== editorDocument) {
    editorContentStyle?.remove();
    editorContentStyle = editorDocument.createElement("style");
    editorDocument.head.append(editorContentStyle);
  }
  editorContentStyle.textContent = [css.content, PREVIEW_SCHEME_FORCE_CSS].join("\n");
  // The content CSS's dark rules key off this attribute on the iframe's own root, which doesn't
  // inherit it from the host document.
  editorDocument.documentElement.dataset.pantokenScheme =
    document.documentElement.dataset.pantokenScheme;
}

/** Temporarily overrides the editing iframe's scheme so the a11y checker can test contrast under
 * both light and dark; the next `applyEditorTheme` call restores the chrome-mirrored value. */
function forceEditorColorScheme(scheme: A11yColorScheme): void {
  if (!activeEditor) return;
  activeEditor.getDoc().documentElement.dataset.pantokenScheme = scheme;
}

function getEditorColorScheme(): A11yColorScheme {
  return activeEditor?.getDoc().documentElement.dataset.pantokenScheme === "dark"
    ? "dark"
    : "light";
}

/** Only "rebrand" ships a dark scheme (`syncDarkModeAvailability` hides/disables the checkbox for
 * the others), so the a11y checker only ever tests both schemes for it. */
const a11yRuntimeConfig: A11yCheckConfig = {
  setColorScheme: forceEditorColorScheme,
  getColorScheme: getEditorColorScheme,
  get colorSchemes(): readonly A11yColorScheme[] {
    return selectedTheme === "rebrand" && includeDarkModeCheckbox.checked
      ? ["light", "dark"]
      : ["light"];
  },
};

/** Re-themes the chrome's token variant + light/dark scheme — the tray and shell are regular app
 * chrome and inherit this too; only the preview `srcdoc` has its own independent theme/scheme. */
function applyChromeTheme(theme: ThemeVariant, mode: "light" | "dark"): void {
  const tokensCss =
    theme === "canvas"
      ? canvasTokensCss
      : theme === "canvasHighContrast"
        ? canvasHighContrastTokensCss
        : adaptiveTokensCss;
  // Without `PREVIEW_SCHEME_FORCE_CSS`, the chrome's own buttons/text stay pinned to the OS
  // `prefers-color-scheme` (see that constant's comment) even though `colorScheme` below is set
  // explicitly — only the native-CSS background rules that key off `color-scheme` directly would
  // follow the toggle, leaving everything else stuck on the OS default.
  chromeThemeStyle.textContent = [tokensCss, PREVIEW_SCHEME_FORCE_CSS].join("\n");
  // Pins `light-dark()` resolution to the docs page's explicit mode instead of the OS preference —
  // single-scheme themes (canvas/canvasHighContrast) only ever render light.
  const scheme = theme === "rebrand" ? mode : "light";
  document.documentElement.dataset.pantokenTheme = theme;
  document.documentElement.dataset.pantokenScheme = scheme;
  document.documentElement.style.colorScheme = scheme;
  syncBrowserMetadata();
  syncPreviewPopupChrome();
}

/** Re-colors the chrome only — the tray's `#theme-tray` reset scope keeps it (and the preview,
 * which reads `selectedColor` directly) immune to this. */
function applyChromeColor(color: PantokenColorNamespace, customHex?: string): void {
  if (customHex !== undefined) chromeCustomColor = parseHexColor(customHex);
  chromeCustomColorStyle.textContent =
    color === CUSTOM_COLOR_KEY ? customColorCss(chromeCustomColor) : "";
  document.documentElement.dataset.pantokenColor = color;
  syncShellCustomColor?.();
  syncBrowserMetadata();
  syncPreviewPopupChrome();
}

/** A host color message: a shipped scale, or `custom` with a valid hex. */
function applyHostColor(color: unknown, customHex: unknown): void {
  if (isShippedColor(color)) applyChromeColor(color);
  else if (color === CUSTOM_COLOR_KEY && isHexColor(customHex)) applyChromeColor(color, customHex);
}

function applyParentTheme(theme: ThemeVariant, mode: "light" | "dark"): void {
  selectedTheme = theme;
  // The docs page's own light/dark mode re-themes the chrome only — "include dark mode" is an
  // independent authoring choice about what ships with the exported theme, not a mirror of it.
  document.documentElement.dataset.pantokenScheme = mode;
  const themeButton = [...themeButtons].find((button) => button.dataset.theme === theme);
  if (themeButton) selectToggleButton(themeButtons, themeButton);
  syncDarkModeAvailability();
  syncPreviewSchemeToAppearance(mode);
  applyEditorTheme(activeEditor);
  void refreshAll();
  syncPreviewPopupChrome();
}

// This app is its own pantoken instance. Claiming the root stops an embedding page's scope from
// being mistaken for ours, and stops our own preview/tray scopes from being re-themed by it.
document.documentElement.dataset.pantokenInstance = EDITOR_INSTANCE;
applyChromeTheme("rebrand", "light");
applyChromeColor("navy");

window.addEventListener("message", (event) => {
  if (event.source !== window.parent || event.origin !== window.location.origin) return;
  const data = event.data as {
    type?: unknown;
    theme?: unknown;
    mode?: unknown;
    color?: unknown;
    customColor?: unknown;
    instanceId?: unknown;
  };
  // A message tagged for a different instance belongs to another pantoken on the host page.
  if (typeof data?.instanceId === "string" && data.instanceId !== HOST_INSTANCE) return;
  if (data?.type === "pantoken-demo-color") {
    applyHostColor(data.color, data.customColor);
    return;
  }
  if (data?.type !== "pantoken-demo-theme") return;
  if (
    (data.theme !== "rebrand" &&
      data.theme !== "canvas" &&
      data.theme !== "canvasHighContrast") ||
    (data.mode !== "light" && data.mode !== "dark")
  ) {
    return;
  }
  applyChromeTheme(data.theme, data.mode);
  applyParentTheme(data.theme, data.mode);
  applyHostColor(data.color, data.customColor);
});

window.parent.postMessage({ type: "pantoken-demo-request-theme" }, window.location.origin);

/** Creates a CodeMirror editor for the given language, wired to call `onChange` on user edits. */
function createEditor(
  container: HTMLElement,
  lang: "html" | "css" | "javascript",
  value: string,
  onChange: () => void,
): EditorView {
  const langExtension = lang === "css" ? css() : lang === "javascript" ? javascript() : html();
  const extensions: any[] = [
    basicSetup,
    langExtension,
    EditorView.lineWrapping,
    EditorView.updateListener.of((update: any): void => {
      if (update.docChanged) onChange();
    }),
  ];
  
  // Add pantoken linter + autocomplete for HTML editor only.
  if (lang === "html") {
    extensions.push(
      pantokenHtmlLinter({ model: [...listComponents(), ...listUtilities()] as any }),
      pantokenHtmlCompletion({ model: [...listComponents(), ...listUtilities()] as any })
    );
  }
  
  return new EditorView({
    doc: value,
    extensions,
    parent: container,
  });
}

// Register one pantoken plugin that composes components, icons, logos, layouts, and templates
