/** Fill the Custom swatch's center with a picked hex; the untouched default leaves it empty. */
function syncCustomSwatch(swatch: HTMLElement, hex: string): void {
  if (hex === DEFAULT_CUSTOM_COLOR) swatch.style.removeProperty("--custom-swatch-fill");
  else swatch.style.setProperty("--custom-swatch-fill", hex);
}
