// Shared CSS assets array — tracks stylesheet URLs for dynamic injection into WYSIWYG editor.
// Each picker plugin calls onMissingAsset to add new assets, and they're injected when an item is inserted.
const currentAssets: CdnFile[] = [];
const onMissingAsset = (asset: CdnFile) => {
  currentAssets.push(asset);
  // In a real app, you'd also trigger a download/export of the aggregated theme.css here.
};

const editorThemeUrls: Record<
  ThemeVariant,
  { skin: string; content: string }
> = {
  rebrand: { skin: nextGenSkinUrl, content: nextGenContentUrl },
  canvas: { skin: canvasSkinUrl, content: canvasContentUrl },
  canvasHighContrast: {
    skin: canvasHighContrastSkinUrl,
    content: canvasHighContrastContentUrl,
  },
};

let editorSkinLink: HTMLLinkElement | undefined;
let editorContentLink: HTMLLinkElement | undefined;

function isThemeColor(color: unknown): color is PantokenColorNamespace {
  return typeof color === "string" && (COLOR_KEYS as readonly string[]).includes(color);
}

/** Applies the selected static skin to TinyMCE's chrome and iframe document. */
function applyEditorTheme(editor: Editor | undefined): void {
  const urls = editorThemeUrls[selectedTheme];
  editorSkinLink?.remove();
  editorContentLink?.remove();

  editorSkinLink = document.createElement("link");
  editorSkinLink.rel = "stylesheet";
  editorSkinLink.href = urls.skin;
  document.head.append(editorSkinLink);

  if (!editor) return;
  editorContentLink = editor.getDoc().createElement("link");
  editorContentLink.rel = "stylesheet";
  editorContentLink.href = urls.content;
  editor.getDoc().head.append(editorContentLink);
}

function applyParentTheme(
  theme: ThemeVariant,
  mode: "light" | "dark",
  color: PantokenColorNamespace = selectedColor,
): void {
  selectedTheme = theme;
  document.documentElement.dataset.pantokenScheme = mode;
  applyThemeColor(color, false);
  selectButton(themeButtons, [...themeButtons].find((button) => button.dataset.theme === theme)!);
  includeDarkModeRow.hidden = theme !== "rebrand";
  applyEditorTheme(activeEditor);
  refreshAll();
}

window.addEventListener("message", (event) => {
  if (event.source !== window.parent || event.origin !== window.location.origin) return;
  const data = event.data as { type?: unknown; theme?: unknown; mode?: unknown; color?: unknown };
  if (data?.type === "pantoken-demo-color") {
    if (isThemeColor(data.color)) applyThemeColor(data.color);
    return;
  }
  if (data?.type !== "pantoken-demo-theme") return;
  const color = data.color === undefined ? selectedColor : data.color;
  if (
    (data.theme !== "rebrand" &&
      data.theme !== "canvas" &&
      data.theme !== "canvasHighContrast") ||
    (data.mode !== "light" && data.mode !== "dark") ||
    !isThemeColor(color)
  ) {
    return;
  }
  applyParentTheme(data.theme, data.mode, color);
});

window.parent.postMessage({ type: "pantoken-demo-request-theme" }, window.location.origin);

// Set around `replaceEditorDoc`'s dispatch so its own doc replacement isn't mistaken for a user
// edit by the update listener below (which otherwise marks the CSS/JS tab dirty on every
// programmatic theme/mode/provider refresh — see `docs/engineering-log.md`).
let isProgrammaticDocChange = false;

/** Creates a CodeMirror editor for the given language, wired to call `onChange` on user edits. */
function createEditor(
  container: HTMLElement,
  lang: "html" | "css" | "javascript",
  value: string,
  onChange: () => void,
): EditorView {
  const langExtension = lang === "css" ? css() : lang === "javascript" ? javascript() : html();
  const extensions: any[] = [
    basicSetup,
    langExtension,
    EditorView.lineWrapping,
    EditorView.updateListener.of((update: any): void => {
      if (update.docChanged && !isProgrammaticDocChange) onChange();
    }),
  ];
  
  // Add pantoken linter + autocomplete for HTML editor only.
  if (lang === "html") {
    extensions.push(
      pantokenHtmlLinter({ model: [...listComponents(), ...listUtilities()] as any }),
      pantokenHtmlCompletion({ model: [...listComponents(), ...listUtilities()] as any })
    );
  }
  
  return new EditorView({
    doc: value,
    extensions,
    parent: container,
  });
}

/** Replaces an editor's full document contents without triggering the "user edited" dirty tracking. */
function replaceEditorDoc(view: EditorView, content: string): void {
  isProgrammaticDocChange = true;
  view.dispatch({ changes: { from: 0, to: view.state.doc.length, insert: content } });
  isProgrammaticDocChange = false;
}

// Register one pantoken plugin that composes components, icons, logos, layouts, and templates
// behind a single toolbar menu. tinymce.init() waits until the icon catalog is available.
const registerPantokenPlugin = (async () => {
  const componentModel = [...listComponents(), ...listUtilities()];
  const allIcons = await loadAllIcons();

  tinymce.PluginManager.add(
    "pantoken",
    createPantokenPlugin({
      components: {
        model: componentModel as any,
        currentAssets,
        onMissingAsset,
      },
      icons: {
        icons: allIcons,
        currentAssets,
        onMissingAsset,
      },
      logos: {
        logos,
        products,
        currentAssets,
        onMissingAsset,
      },
      layouts: {
        onInsert: () => refreshAll(),
      },
      templates: {
        templates: pageLayouts.map(({ title, html }) => ({ title, content: html })),
        onInsert: () => refreshAll(),
      },
    }),
  );
})();

tinymce.PluginManager.add(
  PLACEHOLD_PLUGIN_NAME,
  createPlaceholdPlugin({ onInsert: () => refreshAll() }),
);
tinymce.PluginManager.add(CONTENT_CLASSES_PLUGIN_NAME, createContentClassesPlugin());
tinymce.PluginManager.add(A11Y_PLUGIN_NAME, createA11yPlugin({ display: "footer" }));
tinymce.PluginManager.add(SUP_SUB_PLUGIN_NAME, createSupSubPlugin());

// Toggles between TinyMCE's WYSIWYG view and a syntax-highlighted CodeMirror source view, reusing
// the shared renderer's implementation (live preview + pantoken lint/autocomplete) instead of a
// second, drifted reimplementation.
tinymce.PluginManager.add(
  SOURCE_TOGGLE_PLUGIN_NAME,
  createSourceTogglePlugin({
    height: EDITOR_HEIGHT_PX,
    display: "footer",
    extensions: [
      pantokenHtmlLinter({ model: [...listComponents(), ...listUtilities()] as any }),
      pantokenHtmlCompletion({ model: [...listComponents(), ...listUtilities()] as any }),
    ],
    onChange: () => debouncedUpdatePreview(),
    onToggle: () => refreshAll(),
  }),
);
// Fullscreen and find-and-replace ship as toolbar-only controls upstream — these footer-only
// wrappers surface both from the statusbar instead, alongside word count and the a11y checker.
tinymce.PluginManager.add(FULLSCREEN_FOOTER_PLUGIN_NAME, createFullscreenFooterPlugin());
tinymce.PluginManager.add(SEARCHREPLACE_FOOTER_PLUGIN_NAME, createSearchReplaceFooterPlugin());

