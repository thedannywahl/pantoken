});

const previewFullscreenToggle = document.querySelector<HTMLButtonElement>(
  "#preview-fullscreen-toggle",
)!;
const previewPopupToggle = document.querySelector<HTMLButtonElement>("#preview-popup-toggle")!;
const previewFullscreenLabel = document.querySelector<HTMLElement>("#preview-fullscreen-label")!;
const previewFullscreenTooltip = document.querySelector<HTMLElement>(
  "#preview-fullscreen-toggle-tip",
)!;
const previewPopupReturnLabel = document.querySelector<HTMLElement>(
  "#preview-popup-return-label",
)!;
const previewPopupTitle = document.querySelector<HTMLElement>("#preview-popup-title")!;
const previewPopupBlockedMessage = document.querySelector<HTMLElement>(
  "#preview-popup-blocked-message",
)!;
const previewAnchor = document.createComment("preview-pane-anchor");
previewPane.before(previewAnchor);
let previewWasFullscreen = false;
let restoringPreview = false;

function setPreviewFullscreen(fullscreen: boolean): void {
  previewFullscreenToggle.setAttribute("aria-pressed", String(fullscreen));
  previewFullscreenToggle.classList.toggle("-icon-maximize", !fullscreen);
  previewFullscreenToggle.classList.toggle("-icon-minimize", fullscreen);
  previewPane.classList.toggle("-fullscreen", fullscreen);
  applyPreviewWidth();
  resizePreviewFrame();
}

function setPreviewPopupLabels(detached: boolean): void {
  previewFullscreenLabel.hidden = detached;
  previewPopupReturnLabel.hidden = !detached;
  const label = (detached ? previewPopupReturnLabel : previewFullscreenLabel).textContent?.trim() ?? "";
  previewFullscreenToggle.setAttribute(
    "aria-label",
    label,
  );
  previewFullscreenTooltip.textContent = label;
}

function restorePreviewFromPopup(closePopup = true): void {
  if (restoringPreview || previewPane.ownerDocument === document) return;
  restoringPreview = true;
  const popup = previewPopup;
  if (previewPopupCloseTimer !== undefined) window.clearInterval(previewPopupCloseTimer);
  previewPopupCloseTimer = undefined;
  previewPopup = null;
  previewPopupStylePairs = [];
  document.adoptNode(previewPane);
  previewAnchor.after(previewPane);
  setPreviewPopupLabels(false);
  setPreviewFullscreen(previewWasFullscreen);
  if (closePopup && popup && !popup.closed) popup.close();
  restoringPreview = false;
  previewPopupToggle.focus();
  layoutDirectionToggle.disabled = false;
}

function openPreviewPopup(): void {
  if (previewPopup && !previewPopup.closed) {
    previewPopup.focus();
    return;
  }

  const width = Math.max(320, Math.min(1200, window.screen.availWidth - 80));
  const height = Math.max(320, Math.min(900, window.screen.availHeight - 80));
  const left = Math.max(
    0,
    (window.screen.availLeft ?? 0) + (window.screen.availWidth - width) / 2,
  );
  const top = Math.max(
    0,
    (window.screen.availTop ?? 0) + (window.screen.availHeight - height) / 2,
  );
  const popup = window.open(
    "",
    "pantoken-canvas-preview",
    `popup=yes,width=${width},height=${height},left=${Math.round(left)},top=${Math.round(top)}`,
  );
  if (!popup) {
    window.alert(previewPopupBlockedMessage.textContent?.trim() ?? "Preview popup blocked.");
    return;
  }

  previewPopup = popup;
  previewWasFullscreen = previewPane.classList.contains("-fullscreen");
  const popupDocument = popup.document;
  popupDocument.head.replaceChildren();
  popupDocument.body.replaceChildren();
  popupDocument.title = previewPopupTitle.textContent?.trim() ?? "Preview";
  popupDocument.body.className = "preview-popup";
  previewPopupStylePairs = [];
  for (const source of document.head.querySelectorAll<HTMLLinkElement | HTMLStyleElement>(
    'link[rel="stylesheet"], style',
  )) {
    const clone = source.cloneNode(true) as HTMLLinkElement | HTMLStyleElement;
    if (source instanceof HTMLLinkElement && clone instanceof HTMLLinkElement) {
      clone.href = source.href;
    }
    popupDocument.head.append(clone);
    if (source instanceof HTMLStyleElement && clone instanceof HTMLStyleElement) {
      previewPopupStylePairs.push({ source, clone });
    }
  }
  syncPreviewPopupChrome();
  popupDocument.body.append(previewPane);
  setPreviewPopupLabels(true);
  setPreviewFullscreen(true);
  layoutDirectionToggle.disabled = true;
  popup.addEventListener("pagehide", () => restorePreviewFromPopup(false), { once: true });
  previewPopupCloseTimer = window.setInterval(() => {
    if (previewPopup?.closed) restorePreviewFromPopup(false);
  }, 500);
  popup.focus();
}

previewPopupToggle.addEventListener("click", openPreviewPopup);
previewFullscreenToggle.addEventListener("click", () => {
  if (previewPane.ownerDocument !== document) {
    restorePreviewFromPopup();
    return;
  }
  const fullscreen = previewFullscreenToggle.getAttribute("aria-pressed") !== "true";
  setPreviewFullscreen(fullscreen);
  persistPreferences();
});
if (preferences.previewFullscreen === true) {
  setPreviewFullscreen(true);
}

window.addEventListener("beforeunload", () => {
