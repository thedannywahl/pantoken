/**
 * Authors starter page templates against pantoken's classes: TinyMCE for editing (pinned/
 * configured to match instructure/canvas-lms's own RCE — see README), a custom "Insert template"
 * plugin for the bundled starters, and a live styled preview pane fed by the chosen CDN
 * provider/theme/mode.
 */
import tinymce from "tinymce";
import "tinymce/themes/silver/theme";
import "tinymce/icons/default";
// canvas-lms injects its skin CSS as a raw string via a custom mechanism (RCEWrapper.tsx's
// injectTinySkin()) — out of scope here; plain side-effect imports achieve the same look.
import "tinymce/skins/ui/oxide/skin.css";
import "tinymce/skins/ui/oxide/content.css";
import "tinymce/skins/content/default/content.css";
import {
  buildTheme,
  CDN_PROVIDERS,
  DEFAULT_CDN_PROVIDER_ID,
  defaultThemeCssAssets,
  type ThemeMode,
  type ThemeVariant,
} from "@pantoken/canvas-theme-editor";
import { buildFileUrls } from "@pantoken/cdn";
import type { Editor, Ui } from "tinymce";
import { basicSetup, EditorView } from "codemirror";
import { html } from "@codemirror/lang-html";

// Shared with the toolbar's source-view editor so both stay the same size.
const EDITOR_HEIGHT_PX = 400;

// Bundled starter templates: filename (minus .html) -> raw HTML content.
const templateModules = import.meta.glob<string>("../templates/pages/*.html", {
  query: "?raw",
  import: "default",
  eager: true,
});
const starterTemplates = Object.entries(templateModules).map(([path, content]) => ({
  title: path.split("/").pop()!.replace(/\.html$/, ""),
  content,
}));

// A small custom plugin — same `tinymce.PluginManager.add` convention canvas-lms's own
// `instructure_*` RCE plugins use — modeled on TinyMCE's stock `template` plugin's UX (toolbar
// button + "Insert template" menu item, dialog listing title), but replaces the whole document
// (with a confirm) instead of the stock plugin's insert-at-cursor behavior.
tinymce.PluginManager.add("pantoken_templates", function (editor: Editor) {
  const openDialog = () => {
    editor.windowManager.open({
      title: "Insert template",
      body: {
        type: "panel",
        items: [
          {
            type: "selectbox",
            name: "template",
            label: "Starter template",
            items: starterTemplates.map((t) => ({ value: t.title, text: t.title })),
          },
        ],
      },
      initialData: { template: starterTemplates[0]?.title ?? "" },
      buttons: [
        { type: "cancel", text: "Cancel" },
        { type: "submit", text: "Insert", primary: true },
      ],
      onSubmit: (api) => {
        const { template } = api.getData() as { template: string };
        const chosen = starterTemplates.find((t) => t.title === template);
        api.close();
        if (!chosen) return;
        editor.windowManager.confirm(
          `Replace the current content with the "${chosen.title}" template?`,
          (confirmed: boolean) => {
            if (!confirmed) return;
            editor.setContent(chosen.content);
            replaceSourceDoc(chosen.content);
            refreshAll();
          },
        );
      },
    });
  };

  editor.ui.registry.addButton("pantokenTemplates", {
    text: "Insert template",
    onAction: openDialog,
  });
  editor.ui.registry.addMenuItem("pantokenTemplates", {
    text: "Insert template…",
    onAction: openDialog,
  });

  return {};
});

/** Lazily creates the CodeMirror instance (HTML syntax highlighting) alongside the hidden iframe. */
function ensureSourceView(editor: Editor): EditorView {
  if (sourceView) return sourceView;
  const container = document.createElement("div");
  container.style.cssText = `display: none; width: 100%; height: ${EDITOR_HEIGHT_PX}px; box-sizing: border-box; overflow: auto; border: 1px solid #ccc; font-size: 13px;`;
  editor.contentAreaContainer.insertAdjacentElement("afterend", container);
  sourceContainer = container;
  sourceView = new EditorView({
    extensions: [
      basicSetup,
      html(),
      EditorView.lineWrapping,
      EditorView.updateListener.of((update) => {
        if (update.docChanged) debouncedUpdatePreview();
      }),
    ],
    parent: container,
  });
  return sourceView;
}

/** Replaces the CodeMirror document's full contents, if the source view has been created. */
function replaceSourceDoc(content: string): void {
  if (!sourceView) return;
  sourceView.dispatch({ changes: { from: 0, to: sourceView.state.doc.length, insert: content } });
}

// Toggles between TinyMCE's WYSIWYG view and a syntax-highlighted CodeMirror source view so
// authors can hand-edit markup with the preview pane updating live as they type — unlike TinyMCE's
// stock `code` plugin, which edits raw HTML in a one-shot modal dialog with no live preview.
tinymce.PluginManager.add("pantoken_source_toggle", function (editor: Editor) {
  const toggle = (api: Ui.Toolbar.ToolbarToggleButtonInstanceApi) => {
    sourceMode = !sourceMode;
    api.setActive(sourceMode);
    const view = ensureSourceView(editor);
    const contentArea = editor.contentAreaContainer;
    if (sourceMode) {
      replaceSourceDoc(editor.getContent());
      contentArea.style.display = "none";
      sourceContainer!.style.display = "block";
      view.focus();
    } else {
      contentArea.style.display = "";
      sourceContainer!.style.display = "none";
      editor.setContent(view.state.doc.toString());
    }
    refreshAll();
  };

  editor.ui.registry.addToggleButton("sourcecode", {
    icon: "sourcecode",
    tooltip: "Source code",
    onAction: toggle,
  });

  return {};
});

const providerSelect = document.querySelector<HTMLSelectElement>("#cdn-provider")!;
for (const [id, provider] of Object.entries(CDN_PROVIDERS)) {
  const option = document.createElement("option");
  option.value = id;
  option.textContent = provider.label;
  providerSelect.append(option);
}
providerSelect.value = DEFAULT_CDN_PROVIDER_ID;

const themeSelect = document.querySelector<HTMLSelectElement>("#theme-variant")!;
const modeSelect = document.querySelector<HTMLSelectElement>("#theme-mode")!;
const previewFrame = document.querySelector<HTMLIFrameElement>("#preview")!;
const downloadCss = document.querySelector<HTMLAnchorElement>("#download-theme-css")!;
const downloadJs = document.querySelector<HTMLAnchorElement>("#download-theme-js")!;
const copyButton = document.querySelector<HTMLButtonElement>("#copy-html")!;
const copyStatus = document.querySelector<HTMLElement>("#copy-status")!;

let activeEditor: Editor | undefined;
let cssObjectUrl: string | undefined;
let jsObjectUrl: string | undefined;
let sourceView: EditorView | undefined;
let sourceContainer: HTMLDivElement | undefined;
let sourceMode = false;

/** Reads the author's current HTML from whichever view (WYSIWYG or raw source) is active. */
function getEditorHtml(): string {
  if (sourceMode && sourceView) return sourceView.state.doc.toString();
  return activeEditor?.getContent() ?? "";
}

function currentSelection(): { provider: string; theme: ThemeVariant; mode: ThemeMode } {
  return {
    provider: providerSelect.value,
    theme: themeSelect.value as ThemeVariant,
    mode: modeSelect.value as ThemeMode,
  };
}

/** Debounce helper — the preview pane only needs to refresh a beat after typing settles. */
function debounce<Args extends unknown[]>(fn: (...args: Args) => void, ms: number) {
  let handle: ReturnType<typeof setTimeout> | undefined;
  return (...args: Args) => {
    if (handle) clearTimeout(handle);
    handle = setTimeout(() => fn(...args), ms);
  };
}

/** Renders the editor's current HTML with the real, resolved CDN stylesheet URLs `<link>`ed in. */
function updatePreview(): void {
  if (!activeEditor) return;
  const { provider, theme, mode } = currentSelection();
  const cssUrls = buildFileUrls(defaultThemeCssAssets(theme, mode), provider);
  const linkTags = cssUrls.map((url) => `<link rel="stylesheet" href="${url}">`).join("\n");
  previewFrame.srcdoc = `<!doctype html><html><head>${linkTags}</head><body>${getEditorHtml()}</body></html>`;
}
const debouncedUpdatePreview = debounce(updatePreview, 300);

/** Regenerates the downloadable theme.css/theme.js blobs for the chosen provider/theme/mode. */
function updateDownloads(): void {
  const { provider, theme, mode } = currentSelection();
  const { css, js } = buildTheme({ provider, theme, mode });
  if (cssObjectUrl) URL.revokeObjectURL(cssObjectUrl);
  if (jsObjectUrl) URL.revokeObjectURL(jsObjectUrl);
  cssObjectUrl = URL.createObjectURL(new Blob([css], { type: "text/css" }));
  jsObjectUrl = URL.createObjectURL(new Blob([js], { type: "text/javascript" }));
  downloadCss.href = cssObjectUrl;
  downloadJs.href = jsObjectUrl;
}

function refreshAll(): void {
  updatePreview();
  updateDownloads();
}

providerSelect.addEventListener("change", refreshAll);
themeSelect.addEventListener("change", refreshAll);
modeSelect.addEventListener("change", refreshAll);

copyButton.addEventListener("click", () => {
  void navigator.clipboard.writeText(getEditorHtml()).then(() => {
    copyStatus.textContent = "Copied. Paste into Canvas's Rich Content Editor HTML view.";
  });
});

void tinymce
  .init({
    selector: "#editor",
    plugins: "pantoken_templates pantoken_source_toggle",
    toolbar: "pantokenTemplates sourcecode",
    menubar: false,
    theme: "silver",
    branding: false,
    browser_spellcheck: true,
    convert_urls: false,
    toolbar_mode: "floating",
    height: EDITOR_HEIGHT_PX,
    skin: false,
    content_css: false,
    setup(editor: Editor) {
      editor.on("input change Undo Redo SetContent", () => debouncedUpdatePreview());
    },
  })
  .then((editors) => {
    activeEditor = editors[0];
    refreshAll();
  });
