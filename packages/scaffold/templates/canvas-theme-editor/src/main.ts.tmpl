/** Debounce helper — the preview pane only needs to refresh a beat after typing settles. */
function debounce<Args extends unknown[]>(fn: (...args: Args) => void, ms: number) {
  let handle: ReturnType<typeof setTimeout> | undefined;
  return (...args: Args) => {
    if (handle) clearTimeout(handle);
    handle = setTimeout(() => fn(...args), ms);
  };
}

/**
 * Renders the editor's current HTML with the CSS/JS tab's *current editable text* embedded
 * directly (not linked from the CDN) — so hand-edits in those tabs show up in the preview too.
 * The body content is wrapped to match Canvas's own content-area background and max width.
 * The editable outer `data-pantoken-color` wrapper, plus the inlined `CUSTOM_THEME_COLORS_CSS`,
 * remaps brand colors instantly — a no-op for the default "navy" scheme. `#content`'s height is a min,
 * not a fixed viewport height, so the iframe (resized to match in `resizePreviewFrame`) grows to
 * fit instead of scrolling internally.
 */
function updatePreview(theme: { css: string; js: string }): void {
  if (!activeEditor) return;
  // Canvas's own theme already frames the RCE content area — the picker's border would double up.
  previewFrame.style.borderColor =
    selectedTheme === "canvas" || selectedTheme === "canvasHighContrast" ? "transparent" : "";
  const themeCss = [theme.css, PREVIEW_SCHEME_FORCE_CSS, cssEditorView.state.doc.toString()]
    .filter(Boolean)
    .join("\n");
  const themeJs = [theme.js, jsEditorView.state.doc.toString()]
    .filter(Boolean)
    .join("\n");
  // Elevation is a rebrand-only affordance — Canvas's own themes don't use drop-shadow surfaces.
  const contentClass =
    selectedTheme === "rebrand"
      ? "instui-view -background-primary --elevation-resting"
      : "instui-view -background-primary";
  // The preview is a srcdoc document, so it's a hard scope boundary: it declares its own theme,
  // scheme, and color outright rather than inheriting anything from the editor chrome around it.
  // That's what lets the preview sit in light Canvas while the chrome sits in dark rebrand.
  const previewScheme =
    selectedTheme === "rebrand" && includeDarkModeCheckbox.checked && previewDarkOverride
      ? "dark"
      : "light";
  previewFrame.srcdoc = `<!doctype html><html data-pantoken-boundary data-pantoken-instance="${EDITOR_INSTANCE}-preview" data-pantoken-theme="${selectedTheme}" data-pantoken-scheme="${previewScheme}" data-pantoken-color="${selectedColor}" style="color-scheme:${previewScheme}"><head><style>${themeCss}
${CUSTOM_THEME_COLORS_CSS}</style><style>#wrapper{padding:32px;}#content{padding:36px 48px 48px;min-height:20rem;margin:0 auto;border-radius:12px;}@media not all and (min-width: 768px) {
  #wrapper{padding:24px;}#content{padding-left:12px;padding-right:12px;min-height:16rem;border-radius:8px;}</style></head><body>
    <div id="wrapper" class="instui-view"><div id="content" class="${contentClass}" style="max-width: ${CANVAS_CONTENT_MAX_WIDTH};">
      ${getNormalizedEditorHtml()}
    </div></div>
    <script>${themeJs}</script>
  </body></html>`;
}
const debouncedUpdatePreview = debounce(() => void refreshAll(), 300);

// Keep the same-origin preview frame at its content height; the docs embedding page separately
// receives its own postMessage height updates from `canvas-rce-iframe-height.js`.
let previewResizeObserver: ResizeObserver | undefined;
let previewMutationObserver: MutationObserver | undefined;
const PREVIEW_BORDER_PX = 2;
function resizePreviewFrame(): void {
  // Fullscreen pins the pane to the viewport, so the frame flexes to fill it (app.css) rather than
  // growing past it — a content-height frame would push the overlay into a scrollbar.
  if (previewPane.classList.contains("-fullscreen")) {
    previewFrame.style.removeProperty("height");
    return;
  }
  const root = previewFrame.contentDocument?.documentElement;
  const body = previewFrame.contentDocument?.body;
  if (!root || !body) return;
  const style = getComputedStyle(body);
  const margins = Number.parseFloat(style.marginTop) + Number.parseFloat(style.marginBottom);
  const height = Math.ceil(Math.max(root.getBoundingClientRect().height, body.offsetHeight + margins));
  previewFrame.style.height = `${height + PREVIEW_BORDER_PX}px`;
}

function handlePreviewLinkClick(event: MouseEvent): void {
  if (event.defaultPrevented) return;
  const anchor = (event.target as Element | null)?.closest("a[href]");
  const href = anchor?.getAttribute("href")?.trim();
  if (!href?.startsWith("#")) return;

  event.preventDefault();
  let fragment: string;
  try {
    fragment = decodeURIComponent(href.slice(1));
  } catch {
    return;
  }
  if (!fragment) return;

  const previewDocument = event.currentTarget as Document;
  const target =
    previewDocument.getElementById(fragment) ?? previewDocument.getElementsByName(fragment)[0];
  target?.scrollIntoView();
}

previewFrame.addEventListener("load", () => {
  previewResizeObserver?.disconnect();
  previewMutationObserver?.disconnect();
  resizePreviewFrame();
  previewFrame.contentDocument?.addEventListener("click", handlePreviewLinkClick);
  const root = previewFrame.contentDocument?.documentElement;
  if (!root) return;
  previewResizeObserver = new ResizeObserver(resizePreviewFrame);
  previewResizeObserver.observe(root);
  previewMutationObserver = new MutationObserver(resizePreviewFrame);
  previewMutationObserver.observe(root, { childList: true, subtree: true, attributes: true });
});

function buildDownloadFiles(theme: { css: string; js: string }): {
  css: string;
  js: string;
} {
  const { css: presetCss, js: presetJs } = theme;
  return {
    css: [presetCss, cssEditorView.state.doc.toString()].filter(Boolean).join("\n"),
    js: [presetJs, jsEditorView.state.doc.toString()].filter(Boolean).join("\n"),
  };
}

/** Regenerates the downloadable theme.css/theme.js blobs, appending the author's custom CSS/JS
 * tab content onto the generated preset for the chosen provider/theme/mode. */
function updateDownloads(theme: { css: string; js: string }): void {
  const files = buildDownloadFiles(theme);
  if (cssObjectUrl) URL.revokeObjectURL(cssObjectUrl);
  if (jsObjectUrl) URL.revokeObjectURL(jsObjectUrl);
  cssObjectUrl = URL.createObjectURL(new Blob([files.css], { type: "text/css" }));
  jsObjectUrl = URL.createObjectURL(new Blob([files.js], { type: "text/javascript" }));
  downloadCss.href = cssObjectUrl;
  downloadJs.href = jsObjectUrl;
}

function downloadBlob(blob: Blob, filename: string): void {
  const objectUrl = URL.createObjectURL(blob);
  const anchor = document.createElement("a");
  anchor.href = objectUrl;
  anchor.download = filename;
  document.body.append(anchor);
  anchor.click();
  anchor.remove();
  setTimeout(() => URL.revokeObjectURL(objectUrl), 0);
}

/** The currently open/saved preset's name, if any — downloads use it so the file the author is
 * actually working on isn't always exported as a generic "canvas-theme"/"untitled". */
function activePresetName(): string | undefined {
  const savePlugin = activeEditor?.plugins[SAVE_PLUGIN_NAME] as
    | SavePluginApi<CanvasThemePreset>
    | undefined;
  const activeId = savePlugin?.activePresetId;
  if (!activeId) return undefined;
  return savePlugin.list().find((preset) => preset.id === activeId)?.name;
}

async function refreshAll(): Promise<void> {
  const generation = ++refreshGeneration;
  try {
    const theme = await buildCurrentTheme();
    if (generation !== refreshGeneration) return;
    updatePreview(theme);
    updateDownloads(theme);
  } catch (error) {
    console.error("Unable to build the selected theme", error);
  }
}

