  },
  "canvas-theme-editor.helpModalBody2": {
    "message": "Use <strong>Edit theme</strong> to change the CDN provider, theme, or mode, and to hand-edit the generated <code>theme.css</code>/<code>theme.js</code> before downloading them.",
    "translate": "always"
