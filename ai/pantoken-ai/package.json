{
  "name": "@pantoken/ai",
  "version": "0.2.3",
  "description": "Agent assets for projects that use pantoken: AGENTS.md, llms.txt, Cursor/Copilot/Windsurf rules, and init-pantoken/create-pantoken-app Claude Code skills, with an installer CLI (init, scaffold <platform>).",
  "homepage": "https://pantoken.app",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "ai/pantoken-ai"
  },
  "bin": {
    "pantoken-ai": "bin/pantoken-ai.mjs"
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "translate": "I18N_TRANSLATION_ADAPTER=ai node scripts/translate.ts",
    "translate:agy": "I18N_TRANSLATION_ADAPTER=ai I18N_TRANSLATION_COMMAND=\"$(git rev-parse --show-toplevel)/tools/translation-adapters/agy-wrapper.sh\" node scripts/translate.ts",
    "translate:force": "I18N_TRANSLATION_ADAPTER=ai I18N_TRANSLATION_FORCE=1 node scripts/translate.ts",
    "check:drift": "node scripts/check-drift.ts",
    "dev": "vp pack --watch",
    "test": "vp run generate && vp test",
    "check": "vp check && node scripts/check-drift.ts",
    "eval": "waza run evals --discover -v"
  },
  "dependencies": {
    "@bomb.sh/tab": "catalog:",
    "@pantoken/scaffold": "workspace:*",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@pantoken/translation-adapters": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
