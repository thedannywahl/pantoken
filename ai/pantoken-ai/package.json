{
  "name": "@pantoken/ai",
  "version": "0.1.4",
  "description": "Agent assets for projects that use pantoken: AGENTS.md, llms.txt, Cursor/Copilot/Windsurf rules, and init-pantoken/scaffold-pantoken Claude Code skills, with an installer CLI (init, scaffold <platform>).",
  "homepage": "https://pantoken.iywahl.com",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "ai/pantoken-ai"
  },
  "bin": {
    "pantoken-ai": "bin/pantoken-ai.mjs"
  },
  "files": [
    "dist",
    "bin",
    "assets",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "dev": "vp pack --watch",
    "test": "vp run generate && vp test",
    "check": "vp check",
    "eval": "waza run evals --discover -v"
  },
  "dependencies": {
    "@pantoken/scaffold": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
