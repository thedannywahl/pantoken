{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "5 days",
  "packageRules": [
    {
      "description": "Group non-major bumps into one PR to keep the ~73-package workspace manageable.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Group all GitHub Actions bumps (kept SHA-pinned via helpers:pinGitHubActionDigests).",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  }
}
