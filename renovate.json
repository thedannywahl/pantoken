{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  "schedule": ["* * * * 1"],
  "timezone": "Etc/UTC",
  "labels": ["dependencies"],
  "prConcurrentLimit": 1,
  "minimumReleaseAge": "5 days",
  "draftPR": true,
  "automerge": false,
  "branchTopic": "weekly-maintenance",
  "prHourlyLimit": 0,
  "separateMajorMinor": false,
  "groupSingleUpdates": true,
  "postUpgradeTasks": {
    "commands": ["node scripts/release/capture-maintenance.ts"],
    "dataFileTemplate": "{{{toJSON upgrades}}}",
    "fileFilters": [".renovate/weekly-upgrades.json"],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "description": "Propose all update types together; pantoken validates and partitions candidates before auto-merge.",
      "matchPackageNames": ["*"],
      "groupName": "weekly maintenance",
      "separateMajorMinor": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": false
  }
}
