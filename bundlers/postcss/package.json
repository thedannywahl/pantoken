{
  "name": "@pantoken/postcss",
  "version": "0.1.2",
  "description": "PostCSS plugin for pantoken: expands an @pantoken at-rule into the token stylesheet.",
  "homepage": "https://pantoken.iywahl.com",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "bundlers/postcss"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@pantoken/css": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "postcss": ">=8"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pantoken": {
    "key": "postcss",
    "kind": "subpath"
  }
}
