{
  // fallow codebase-intelligence config. See https://github.com/fallow-rs/fallow.
  // Gate policy (enforced in CI): dead-code = error, health = gated to grade A, dupes = advisory.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  "workspaces": {
    "patterns": [
      "docs",
      "packages/*",
      "formats/*",
      "platforms/*",
      "renderers/*",
      "bundlers/*",
      "design/*",
      "ai/*",
      "plugins/pantoken/*",
      "plugins/postcss/*",
      "plugins/typedoc/*",
      "plugins/vite/*",
      "tools/*"
    ]
  },

  // Real runtime roots that no plugin or package.json declares: scripts invoked via `node`/`vp run`,
  // per-package codegen scripts, tool entry points, test files discovered by vite, and bin shims.
  // Without these, fallow sees the whole scripts/release/* and tools/* graphs as unreachable and
  // reports them (and their exports) as dead.
  "entry": [
    "scripts/**/*.ts",
    "**/scripts/**/*.ts",
    "docs/**/*.{test,spec}.ts",
    "tools/*/index.ts",
    "tools/*/src/index.ts",
    "tools/**/*.{test,spec}.ts",
    "tools/demo/runner/*.ts",
    "**/bin/*.{mjs,cjs,js,ts}",
    "**/vite.config.ts",
    "**/vite.*.config.ts"
  ],

  // The CodSpeed benchmark harness. It is a measurement rig, not part of the shipped graph: it reaches
  // into several packages' internals at once (deliberately, to time them individually), which makes
  // fallow report cross-package name collisions that don't exist for real consumers — no published
  // barrel exposes `formats/scss`'s and `formats/dtcg`'s `Mode` together. `vitest bench` discovers the
  // files, so nothing here needs to be reachable from the module graph.
  "ignorePatterns": ["bench/**"],

  // Consumed by a mechanism the static graph can't see. The component CSS sources feed codegen
  // scripts (they generate ../generated/*.ts) and the pendo CSS sheets are assembled by the pendo
  // build, not imported directly, so static analysis calls them unused. The pendo postcss plugins are
  // loaded by name at build time. The vitepress-vars.css is loaded at runtime via readFileSync()
  // in vitepress-vars.ts, which static analysis cannot trace.
  "dynamicallyLoaded": [
    "formats/components/src/**/*.css",
    "renderers/pendo/src/css/**/*.css",
    "renderers/pendo/src/plugins/*.ts",
    "renderers/vitepress/src/vitepress-vars.css",
    "tools/demo/runner/*.css",
    "plugins/pantoken/custom-components/src/**/*.css",
    "plugins/pantoken/layouts/src/**/*.css"
  ],

  // Runtime-provided or type-only deps fallow can't observe being used: @pantoken/model is imported
  // `import type` everywhere (elided under verbatimModuleSyntax, so zero value usage is visible),
  // vite-plus is the globally-installed toolchain aliased in the catalog, @tokens-studio/sd-transforms
  // is declared in tools/sd-config for the not-yet-wired raw-JSON lineage (see its src/index.ts comment),
  // fast-check is used in Vitest setupFiles which fallow can't trace as a legitimate dev entry, and the
  // platform packages in packages/scaffold/package.json are only imported by
  // generated/preset-ledger.ts — gitignored, regenerated by scripts/scan-presets.ts before each build —
  // so fallow's static graph never sees the import when it runs pre-build.
  "ignoreDependencies": [
    "@pantoken/model",
    "vite-plus",
    "@tokens-studio/sd-transforms",
    "fast-check",
    "@pantoken/angular",
    "@pantoken/components",
    "@pantoken/react",
    "@pantoken/svelte",
    "@pantoken/vue",
    "@pantoken/web-components"
  ],

  // defineDeclaration is part of the authoring API trio (defineComponent/defineRule/defineDeclaration)
  // and is documented as such; it's currently referenced only in prose, so keep it exported.
  "ignoreExports": [
    { "file": "formats/components/src/lib/define.ts", "exports": ["defineDeclaration"] }
  ],

  // Generated specifiers that only exist after `build:all`; some environments analyze pre-build.
  // Workspace @pantoken/* specifiers resolve to each package's built dist, so they're "unresolved"
  // only before a build — ignore them so the regression baseline and the pre-push audit are accurate
  // without a full build (a no-op post-build, where they resolve; TypeScript still catches real breaks).
  // `/src/main.tsx`/`/src/main.ts`: scaffolded starter-project templates reference their OWN sibling
  // file by its post-scaffold name — the scaffold script strips the `.tmpl` suffix the file actually
  // has on disk (`src/main.tsx.tmpl`) when it copies the template into a consumer's project, so these
  // "unresolved" imports in packages/scaffold/templates/**/index.html are correct by design.
  "ignoreUnresolvedImports": [
    "**/generated/**",
    "../generated/**",
    "./generated/**",
    "../dist/**",
    "**/public/**",
    "@pantoken/*",
    "@pantoken/*/**",
    "/src/main.tsx",
    "/src/main.ts"
  ],

  "duplicates": {
    // Duplication is gated (not advisory): `health:fallow` fails when the duplicated-line ratio
    // exceeds `threshold`. The current ratio is ~1.97% (up from ~1.7%) after the `@scope`
    // component/utility selector migration, which structurally repeats small blocks per component
    // (e.g. the toggle-details/toggle-group/tree-browser chevron marker, context-view/popover
    // positioning, pagination page/group borders) — the same kind of "individually importable, can't
    // share code" duplication already accepted elsewhere in this file (see the `css-duplicate-block`
    // ignore comments). The cap sits just above the current ratio to accept today's set while
    // blocking new duplication; tighten it further as the remaining clones are refactored out.
    "enabled": true,
    "minOccurrences": 2,
    "threshold": 2.05
  },

  "rules": {
    // Neither of these is genuine dead weight, so they must not drag the health score:
    // - unused catalog entries below line ~90 of pnpm-workspace.yaml are documented there as mirrors
    //   "kept harmless under catalogMode: prefer" for the linked @cssdoc source (removing them breaks
    //   @cssdoc installs).
    // - the flagged dev-deps are all config/CLI-loaded tools (publint, attw, the typedoc plugins,
    //   @cssdoc/stylelint-plugin) invoked via `vp exec`/config, or the packages/pantoken + docs
    //   meta-aggregation of @pantoken/* sub-packages — used, just never `import`ed.
    "unused-catalog-entries": "off",
    "unused-dev-dependencies": "off"
  },

  "health": {
    // Complexity thresholds. Health is gated to grade A via scripts/quality/fallow-health-gate.ts,
    // which reads `fallow health --format json` and fails CI when the aggregate score drops below A.
    // Vue SFC complexity is noisy in this repo because template-generated functions are analyzer-only
    // artifacts (not author-level abstractions), so we scope complexity checks to non-.vue sources.
    // Build/translation scripts have zero test coverage, so CRAP scores are high by construction.
    "ignore": ["**/*.vue"],
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30
  },

  "overrides": [
    {
      // pfx-* classes are the build-time sentinel (SENTINEL = "pfx-"), replaced at emit with the
      // configured prefix; fallow cannot see the generated output or external consumers.
      "files": [
        "formats/components/src/components/**/*.css",
        "formats/components/src/utilities/**/*.css"
      ],
      "rules": { "css-dead-surface": "off" }
    },
    {
      // VitePress runtime applies VP* / vp-* / is-home / tagline classes via its own Vue components
      // and markdown rendering — none are in the in-project JS/TS/HTML that fallow scans.
      // pantoken-swatch* and pantoken-token-preview are applied from docs markdown content.
      "files": ["docs/.vitepress/theme/pantoken.css"],
      "rules": { "css-dead-surface": "off" }
    },
    {
      // Shadow DOM element classes (trigger, dropdown, layout, handle) are applied from TS template
      // strings inside shadow roots — not external markup fallow can reach.
      "files": ["renderers/web-components/src/elements/**/*.css"],
      "rules": { "css-dead-surface": "off" }
    },
    {
      // runner__* classes are injected by the demo runner's HTML template at runtime.
      "files": ["tools/demo/runner/runner.css"],
      "rules": { "css-dead-surface": "off" }
    }
  ]
}
