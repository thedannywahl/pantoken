{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "pantoken-docs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false },
  "assets": {
    "directory": "../.vitepress/deploy-site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "pantoken-docs-assets"
    }
  ]
}
