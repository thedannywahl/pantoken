    "e98b15fd514833c3cd16d0ea30f5c61f0307e93b111d3a7ba835b920fb05daff": "Talla de samarreta",
    "e9922d317719889204aca6060ff02bad6582d301b43316a75dd7c929aa2dedef": " 80rem. Per a un component que s'adapta a la seva pròpia amplada en lloc de la finestra de visualització,\n      embolcalleu-lo en un element ",
    "ea27700102c8a79007b151eb33053517059a99e5a2c17c4bdd272abe9199bfd3": "KL",
    "ebb79da00867f40648b35943b926255d24207bac8a3f8217dcaa451139f008da": "\n      Estils de components basats en classes, construïts a partir dels tokens d'Instructure, més una capa de prosa.\n    ",
