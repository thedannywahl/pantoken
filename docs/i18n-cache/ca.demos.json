    "e6f103e439e05ef3e40d42f894f71fa040e4a60869a4a96bc75164338490bbc5": "Dj",
    "e7eadfcc3020d564e3bd9c21745566ae50216282f1ce452c0f50ba76939d7b02": " Desmarcat",
    "e81f3756880084dc196722a5b8ce044f88f81e700716919c825631f7d397ceb2": "\n        Aquestes opcions es mostren quan el grup s'expandeix. La fila de la capçalera porta un chevron que\n        gira en obrir-se, i el contingut se situa sota d'un separador.\n      ",
    "e82ceadf264cd35300f5b365089d89df17233d850600eaf3fc7b7526bc40a661": "\n    El posicionament al costat d'un activador utilitza el posicionament d'ancoratge CSS on és compatible; en altres casos, el menú emergent\n    es centra a la capa superior.\n  ",
    "e8e4c2e4ddd1bea4038545c953e72aeece9933107ebdf77f26b1da63a8305ef5": " — una finestra modal més ampla per a contingut més dens.",
    "e91e049eb7ecf52fee552fb90723d365338152a15fde4687444fffcfefc1c0c6": "enllaç base",
    "e9296d3e3f42421c2b205db2a343ca81fd31c80dbbc2d4c43731dd7a30b74246": "Ubicació inferior",
