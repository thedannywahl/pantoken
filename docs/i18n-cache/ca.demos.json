    "e4ff37aace0d0faf31062d91eeeed730c154ba4aabcd76615d8eeb532a64e368": "\n      Un popover és una superfície lleugera ancorada a un activador. Aquest utilitza l'atribut\n      ",
    "e50b0e5af6519b6d074cac570714c3a503ae75abc1a893e318b94c23a4310870": "Quarta pestanya",
