creen-reader-content.css @@ - * <span aria-hidden=\"true\">⚙</span> + * <span aria-hidden=\"true\">+</span> *** End Patch\n[tool rg -> success] args={\"pattern\":\"custom-components|readdirSync\\\\(.*assets\",\"paths\":\"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\",\"output_mode\":\"content\",\"-n\":true,\"-C\":3}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts @@ \"components/fonts.css\", + ...(item.record === \"logo\" ? [\"logos/canvas-horizontal-color.css\"] : []), @@ [\"plugins/pantoken/custom-components/dist\", \"custom-components\"], + [\"plugins/pantoken/logos/dist\", \"logos\"], *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts @@ expect(page).toContain(\"control.checkValidity()\"); + const logoPage = renderPage({ ...cases[0]!, record: \"logo\" }); + expect(logoPage).toContain('href=\"assets/logos/canvas-horizontal-color.css\"'); @@ \"plugins/pantoken/custom-components/dist\", + \"plugins/pantoken/logos/dist\", @@ \"interactions\", + \"logos\", *** End Patch\n[tool bash -> success] args={\"command\":\"vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate plugin fixtures and harness\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --help\",\"description\":\"Check changeset CLI options\",\"initial_wait\":60}\n[tool bash -> success] args={\"command\":\"cd formats/components && node --input-type=module -e 'import {parseCssDocs} from \\\"@cssdoc/core\\\"; import {PLUGIN_AUDIT_RECORDS} from \\\"./scripts/audit-plugin-components.ts\\\"; console.log(JSON.stringify(parseCssDocs(PLUGIN_AUDIT_RECORDS.find(x=>x.name===\\\"banner\\\").rules(\\\"instui-\\\")).find(x=>x.name===\\\"banner\\\").modifiers,null,2))'\",\"description\":\"Inspect parsed modifier alias metadata\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-examples.test.ts @@ - if (modifier.name.includes(\"*\") || modifier.description.includes(\"@alias\")) continue; + if (modifier.pattern || modifier.alias) continue; *** End Patch\n[tool write_agent -> success] args={\"agent_ids\":[\"049c1373-ecc6-4d66-bbea-f19e45c06453\",\"78631379-5bbe-4a0d-a590-18491ff526c0\",\"13128f82-ab9e-41de-a14e-bd6978da289e\"],\"message\":\"Parsed CssDocEntry.modifiers carries modifier.alias.canonical (not description @alias) and modifier.pattern. I'll add metadata-derived guard that requires canonical visual color/size/variant/state modifier classes on matching component roots, skipping aliases/patterns. Flag any intentional exceptions with rationale. Please ensure data-a11y roots/triggers remain where harness needs them; root identifiers should remain unique. Guard tests now normalize pfx before checking IDs/ARIA for plugin records too.\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md @@ member's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it. Use fenced HTML so audience flags remain metadata, not visible page content. +Keep one audit example per record, with distinct visual variants together: canonical colors, sizes, +and supported states. Don't duplicate deprecated aliases or build a Cartesian product of every +modifier. Include meaningful labels, selected and unselected choices, and native `disabled`, +`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface +for inverse/on-color treatments, without overriding the component's tested colors. Keep decorative +content hidden from assistive technology and preserve required parent/member structures. + +Stack independent cases in normal document flow instead of forcing a wide row. Expanded dialog +variants can use `open` so they remain measurable without one modal hiding the others. Static state +markup is not evidence that hover, keyboard interaction, focus movement, or announcements work: +those still need interaction checks and manual testing. Don't remove a supported variant or add a +fixture-only CSS fix to make the audit pass. + Run `vp run audit:components` from the repository root. It builds local styles and behavior bundles, *** End Patch\n[tool bash -> success] args={\"command\":\"vp check --fix formats/components/tests/audit-examples.test.ts formats/components/scripts/audit-accessibility.ts formats/components/tests/audit-accessibility.test.ts formats/components/src/declarations/focus/index.ts formats/components/src/utilities/ai-gradient/index.ts plugins/pantoken/custom-components/src/components docs/conventions/authoring.md && vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate own plugin and utility changes\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --patch @pantoken/components,@pantoken/plugin-custom-components -m \\\"Expand accessibility audit examples to exercise distinct visual variants and native control states, with minimal component-owned markup.\\\"\",\"description\":\"Generate audit-fixture changeset\",\"initial_wait\":60}","copilot_cache_control":{"type":"ephemeral"}},{"content":"ALLOW: Authorized audit-fixture update within the requested component scope.","refusal":null,"role":"assistant","reasoning_opaque":"REDACTED","reasoning_text":"","encrypted_content":"REDACTED","reasoningBlocks":{"provider":"openai-responses","blocks":[{"content":[],"encrypted_content":"REDACTED","id":"","summary":[],"type":"reasoning"}]},"responses_message_status":"completed","phase":"final_answer","serverTools":{"provider":"openai-responses"},"apiCallId":"","outputTokens":168,"providerId":"copilot"}]},"id":"39658b5f-b0a7-49b1-adc2-39941642285a","timestamp":"2026-10-28T21:04:52.788Z","parentId":"74c7346e-584e-472c-8112-1a6bfa7eb41d"}
{"type":"permission.requested","data":{"requestId":"473261a0-d81c-4c6d-ae51-d782c198d4f7","permissionRequest":{"kind":"write","toolCallId":"custom_call_xlWbt2qtOIQCYLa3C9rrczzw","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css\n@@ -39,17 +39,26 @@\n  * @example -automatica11y\n  * ```html\n  * <fieldset class=\"pfx-radio-input-group\">\n- *   <legend>T-shirt size</legend>\n- *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n- *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n- *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n+ *   <legend>Stacked sizes</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"sm\" checked>Small</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"md\">Medium</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"lg\" disabled>Large unavailable</label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-radio-input-group -layout-columns\">\n+ *   <legend>Column sizes</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"sm\" checked>Small</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"md\">Medium</label>\n  * </fieldset>\n- * \n+ * <fieldset class=\"pfx-radio-input-group -layout-inline -required\">\n+ *   <legend>Required inline size</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"sm\" required checked>Small</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"md\" required>Medium</label>\n+ * </fieldset>\n  * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n- *   <legend>Sweatshirt size</legend>\n- *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n- *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n- *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n+ *   <legend>Toggle sizes</legend>\n+ *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"sm\" checked>Small</label>\n+ *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"md\">Medium</label>\n+ *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"lg\" disabled>Large</label>\n  * </fieldset>\n  * ```\n  */\n","newFileContents":"/**\n * @component radio-input-group\n * @selector .pfx-radio-input-group\n * @summary A single-select radio `<fieldset>`, plain or as a connected segmented toggle.\n * @remarks Sets its own `gap` between radios; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -layout-columns — Lay the radios out in columns.\n * @modifier -layout-inline — Lay the radios out inline.\n * @modifier -required — Mark the group as required.\n * @modifier -variant-toggle — Lay the child toggles out as a segmented control (only the selected segment fills).\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Use a native `<fieldset>` with a `<legend>` that names the group. Radios within a group share one `name`; independent groups need distinct names and legends so selecting one group's radio doesn't clear another group's selection.\n * @example -canvas-rce -docs\n  * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>T-shirt size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n * </fieldset>\n * ```\n * ### Toggle variant\n * ```html\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Sweatshirt size</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n * </fieldset>\n * ```\n * @structure\n * .pfx-radio-input-group.-variant-toggle {\n *   legend {}\n *   .pfx-radio.-variant-toggle {\n *     input {}\n *   }\n * }\n * @related radio — The individual control this group collects.\n * @related form-field-group — The general wrapper for grouping and laying out fields.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>Stacked sizes</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"md\">Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"lg\" disabled>Large unavailable</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -layout-columns\">\n *   <legend>Column sizes</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"md\">Medium</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -layout-inline -required\">\n *   <legend>Required inline size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"sm\" required checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"md\" required>Medium</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Toggle sizes</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"md\">Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"lg\" disabled>Large</label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-radio-input-group) {\n  & {\n    display: flex;\n    flex-direction: column;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  /* simple variant: -layout-columns/-inline flow the standard radios into a wrapping row */\n  &.-layout-columns,\n  &.-layout-inline {\n    flex-flow: row wrap;\n    align-items: center;\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-layout-columns > legend,\n  &.-layout-inline > legend {\n    flex-basis: 100%;\n  }\n\n  /* toggle variant: lay the child .instui-radio.-variant-toggle segments out flush in a row — no gap and\n     no borders, matching InstUI's colSpacing=\"none\". The visible spacing between labels is each segment's\n     own inline padding; only the checked segment paints a pill. Lift the focused segment so its focus ring\n     isn't clipped by a neighbour. */\n  &.-variant-toggle {\n    flex-flow: row wrap;\n    align-items: center;\n    gap: 0;\n  }\n\n  &.-variant-toggle > legend {\n    flex-basis: 100%;\n  }\n\n  &.-variant-toggle > .pfx-radio:has(input:focus-visible) {\n    z-index: 1;\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css","content":"/**\n * @component radio-input-group\n * @selector .pfx-radio-input-group\n * @summary A single-select radio `<fieldset>`, plain or as a connected segmented toggle.\n * @remarks Sets its own `gap` between radios; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -layout-columns — Lay the radios out in columns.\n * @modifier -layout-inline — Lay the radios out inline.\n * @modifier -required — Mark the group as required.\n * @modifier -variant-toggle — Lay the child toggles out as a segmented control (only the selected segment fills).\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Use a native `<fieldset>` with a `<legend>` that names the group. Radios within a group share one `name`; independent groups need distinct names and legends so selecting one group's radio doesn't clear another group's selection.\n * @example -canvas-rce -docs\n  * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>T-shirt size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n * </fieldset>\n * ```\n * ### Toggle variant\n * ```html\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Sweatshirt size</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n * </fieldset>\n * ```\n * @structure\n * .pfx-radio-input-group.-variant-toggle {\n *   legend {}\n *   .pfx-radio.-variant-toggle {\n *     input {}\n *   }\n * }\n * @related radio — The individual control this group collects.\n * @related form-field-group — The general wrapper for grouping and laying out fields.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>T-shirt size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n * </fieldset>\n * \n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Sweatshirt size</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-radio-input-group) {\n  & {\n    display: flex;\n    flex-direction: column;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  /* simple variant: -layout-columns/-inline flow the standard radios into a wrapping row */\n  &.-layout-columns,\n  &.-layout-inline {\n    flex-flow: row wrap;\n    align-items: center;\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-layout-columns > legend,\n  &.-layout-inline > legend {\n    flex-basis: 100%;\n  }\n\n  /* toggle variant: lay the child .instui-radio.-variant-toggle segments out flush in a row — no gap and\n     no borders, matching InstUI's colSpacing=\"none\". The visible spacing between labels is each segment's\n     own inline padding; only the checked segment paints a pill. Lift the focused segment so its focus ring\n     isn't clipped by a neighbour. */\n  &.-variant-toggle {\n    flex-flow: row wrap;\n    align-items: center;\n    gap: 0;\n  }\n\n  &.-variant-toggle > legend {\n    flex-basis: 100%;\n  }\n\n  &.-variant-toggle > .pfx-radio:has(input:focus-visible) {\n    z-index: 1;\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css","content":"/**\n * @component radio-input-group\n * @selector .pfx-radio-input-group\n * @summary A single-select radio `<fieldset>`, plain or as a connected segmented toggle.\n * @remarks Sets its own `gap` between radios; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -layout-columns — Lay the radios out in columns.\n * @modifier -layout-inline — Lay the radios out inline.\n * @modifier -required — Mark the group as required.\n * @modifier -variant-toggle — Lay the child toggles out as a segmented control (only the selected segment fills).\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Use a native `<fieldset>` with a `<legend>` that names the group. Radios within a group share one `name`; independent groups need distinct names and legends so selecting one group's radio doesn't clear another group's selection.\n * @example -canvas-rce -docs\n  * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>T-shirt size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n * </fieldset>\n * ```\n * ### Toggle variant\n * ```html\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Sweatshirt size</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n * </fieldset>\n * ```\n * @structure\n * .pfx-radio-input-group.-variant-toggle {\n *   legend {}\n *   .pfx-radio.-variant-toggle {\n *     input {}\n *   }\n * }\n * @related radio — The individual control this group collects.\n * @related form-field-group — The general wrapper for grouping and laying out fields.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>Stacked sizes</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"md\">Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"lg\" disabled>Large unavailable</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -layout-columns\">\n *   <legend>Column sizes</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"md\">Medium</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -layout-inline -required\">\n *   <legend>Required inline size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"sm\" required checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"md\" required>Medium</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Toggle sizes</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"md\">Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"lg\" disabled>Large</label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-radio-input-group) {\n  & {\n    display: flex;\n    flex-direction: column;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  /* simple variant: -layout-columns/-inline flow the standard radios into a wrapping row */\n  &.-layout-columns,\n  &.-layout-inline {\n    flex-flow: row wrap;\n    align-items: center;\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-layout-columns > legend,\n  &.-layout-inline > legend {\n    flex-basis: 100%;\n  }\n\n  /* toggle variant: lay the child .instui-radio.-variant-toggle segments out flush in a row — no gap and\n     no borders, matching InstUI's colSpacing=\"none\". The visible spacing between labels is each segment's\n     own inline padding; only the checked segment paints a pill. Lift the focused segment so its focus ring\n     isn't clipped by a neighbour. */\n  &.-variant-toggle {\n    flex-flow: row wrap;\n    align-items: center;\n    gap: 0;\n  }\n\n  &.-variant-toggle > legend {\n    flex-basis: 100%;\n  }\n\n  &.-variant-toggle > .pfx-radio:has(input:focus-visible) {\n    z-index: 1;\n  }\n}\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_xlWbt2qtOIQCYLa3C9rrczzw","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css\n@@ -39,17 +39,26 @@\n  * @example -automatica11y\n  * ```html\n  * <fieldset class=\"pfx-radio-input-group\">\n- *   <legend>T-shirt size</legend>\n- *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n- *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n- *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n+ *   <legend>Stacked sizes</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"sm\" checked>Small</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"md\">Medium</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"lg\" disabled>Large unavailable</label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-radio-input-group -layout-columns\">\n+ *   <legend>Column sizes</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"sm\" checked>Small</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"md\">Medium</label>\n  * </fieldset>\n- * \n+ * <fieldset class=\"pfx-radio-input-group -layout-inline -required\">\n+ *   <legend>Required inline size</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"sm\" required checked>Small</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"md\" required>Medium</label>\n+ * </fieldset>\n  * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n- *   <legend>Sweatshirt size</legend>\n- *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n- *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n- *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n+ *   <legend>Toggle sizes</legend>\n+ *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"sm\" checked>Small</label>\n+ *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"md\">Medium</label>\n+ *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"lg\" disabled>Large</label>\n  * </fieldset>\n  * ```\n  */\n","newFileContents":"/**\n * @component radio-input-group\n * @selector .pfx-radio-input-group\n * @summary A single-select radio `<fieldset>`, plain or as a connected segmented toggle.\n * @remarks Sets its own `gap` between radios; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -layout-columns — Lay the radios out in columns.\n * @modifier -layout-inline — Lay the radios out inline.\n * @modifier -required — Mark the group as required.\n * @modifier -variant-toggle — Lay the child toggles out as a segmented control (only the selected segment fills).\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Use a native `<fieldset>` with a `<legend>` that names the group. Radios within a group share one `name`; independent groups need distinct names and legends so selecting one group's radio doesn't clear another group's selection.\n * @example -canvas-rce -docs\n  * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>T-shirt size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n * </fieldset>\n * ```\n * ### Toggle variant\n * ```html\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Sweatshirt size</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n * </fieldset>\n * ```\n * @structure\n * .pfx-radio-input-group.-variant-toggle {\n *   legend {}\n *   .pfx-radio.-variant-toggle {\n *     input {}\n *   }\n * }\n * @related radio — The individual control this group collects.\n * @related form-field-group — The general wrapper for grouping and laying out fields.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>Stacked sizes</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"md\">Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"lg\" disabled>Large unavailable</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -layout-columns\">\n *   <legend>Column sizes</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"md\">Medium</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -layout-inline -required\">\n *   <legend>Required inline size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"sm\" required checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"md\" required>Medium</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Toggle sizes</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"md\">Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"lg\" disabled>Large</label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-radio-input-group) {\n  & {\n    display: flex;\n    flex-direction: column;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  /* simple variant: -layout-columns/-inline flow the standard radios into a wrapping row */\n  &.-layout-columns,\n  &.-layout-inline {\n    flex-flow: row wrap;\n    align-items: center;\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-layout-columns > legend,\n  &.-layout-inline > legend {\n    flex-basis: 100%;\n  }\n\n  /* toggle variant: lay the child .instui-radio.-variant-toggle segments out flush in a row — no gap and\n     no borders, matching InstUI's colSpacing=\"none\". The visible spacing between labels is each segment's\n     own inline padding; only the checked segment paints a pill. Lift the focused segment so its focus ring\n     isn't clipped by a neighbour. */\n  &.-variant-toggle {\n    flex-flow: row wrap;\n    align-items: center;\n    gap: 0;\n  }\n\n  &.-variant-toggle > legend {\n    flex-basis: 100%;\n  }\n\n  &.-variant-toggle > .pfx-radio:has(input:focus-visible) {\n    z-index: 1;\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css","content":"/**\n * @component radio-input-group\n * @selector .pfx-radio-input-group\n * @summary A single-select radio `<fieldset>`, plain or as a connected segmented toggle.\n * @remarks Sets its own `gap` between radios; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -layout-columns — Lay the radios out in columns.\n * @modifier -layout-inline — Lay the radios out inline.\n * @modifier -required — Mark the group as required.\n * @modifier -variant-toggle — Lay the child toggles out as a segmented control (only the selected segment fills).\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Use a native `<fieldset>` with a `<legend>` that names the group. Radios within a group share one `name`; independent groups need distinct names and legends so selecting one group's radio doesn't clear another group's selection.\n * @example -canvas-rce -docs\n  * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>T-shirt size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n * </fieldset>\n * ```\n * ### Toggle variant\n * ```html\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Sweatshirt size</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n * </fieldset>\n * ```\n * @structure\n * .pfx-radio-input-group.-variant-toggle {\n *   legend {}\n *   .pfx-radio.-variant-toggle {\n *     input {}\n *   }\n * }\n * @related radio — The individual control this group collects.\n * @related form-field-group — The general wrapper for grouping and laying out fields.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>T-shirt size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n * </fieldset>\n * \n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Sweatshirt size</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-radio-input-group) {\n  & {\n    display: flex;\n    flex-direction: column;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  /* simple variant: -layout-columns/-inline flow the standard radios into a wrapping row */\n  &.-layout-columns,\n  &.-layout-inline {\n    flex-flow: row wrap;\n    align-items: center;\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-layout-columns > legend,\n  &.-layout-inline > legend {\n    flex-basis: 100%;\n  }\n\n  /* toggle variant: lay the child .instui-radio.-variant-toggle segments out flush in a row — no gap and\n     no borders, matching InstUI's colSpacing=\"none\". The visible spacing between labels is each segment's\n     own inline padding; only the checked segment paints a pill. Lift the focused segment so its focus ring\n     isn't clipped by a neighbour. */\n  &.-variant-toggle {\n    flex-flow: row wrap;\n    align-items: center;\n    gap: 0;\n  }\n\n  &.-variant-toggle > legend {\n    flex-basis: 100%;\n  }\n\n  &.-variant-toggle > .pfx-radio:has(input:focus-visible) {\n    z-index: 1;\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css","content":"/**\n * @component radio-input-group\n * @selector .pfx-radio-input-group\n * @summary A single-select radio `<fieldset>`, plain or as a connected segmented toggle.\n * @remarks Sets its own `gap` between radios; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -layout-columns — Lay the radios out in columns.\n * @modifier -layout-inline — Lay the radios out inline.\n * @modifier -required — Mark the group as required.\n * @modifier -variant-toggle — Lay the child toggles out as a segmented control (only the selected segment fills).\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Use a native `<fieldset>` with a `<legend>` that names the group. Radios within a group share one `name`; independent groups need distinct names and legends so selecting one group's radio doesn't clear another group's selection.\n * @example -canvas-rce -docs\n  * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>T-shirt size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n * </fieldset>\n * ```\n * ### Toggle variant\n * ```html\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Sweatshirt size</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n * </fieldset>\n * ```\n * @structure\n * .pfx-radio-input-group.-variant-toggle {\n *   legend {}\n *   .pfx-radio.-variant-toggle {\n *     input {}\n *   }\n * }\n * @related radio — The individual control this group collects.\n * @related form-field-group — The general wrapper for grouping and laying out fields.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-radio-input-group\">\n *   <legend>Stacked sizes</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"md\">Medium</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"lg\" disabled>Large unavailable</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -layout-columns\">\n *   <legend>Column sizes</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"md\">Medium</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -layout-inline -required\">\n *   <legend>Required inline size</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"sm\" required checked>Small</label>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-inline-size\" value=\"md\" required>Medium</label>\n * </fieldset>\n * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n *   <legend>Toggle sizes</legend>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"sm\" checked>Small</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"md\">Medium</label>\n *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-toggle-size\" value=\"lg\" disabled>Large</label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-radio-input-group) {\n  & {\n    display: flex;\n    flex-direction: column;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  /* simple variant: -layout-columns/-inline flow the standard radios into a wrapping row */\n  &.-layout-columns,\n  &.-layout-inline {\n    flex-flow: row wrap;\n    align-items: center;\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-layout-columns > legend,\n  &.-layout-inline > legend {\n    flex-basis: 100%;\n  }\n\n  /* toggle variant: lay the child .instui-radio.-variant-toggle segments out flush in a row — no gap and\n     no borders, matching InstUI's colSpacing=\"none\". The visible spacing between labels is each segment's\n     own inline padding; only the checked segment paints a pill. Lift the focused segment so its focus ring\n     isn't clipped by a neighbour. */\n  &.-variant-toggle {\n    flex-flow: row wrap;\n    align-items: center;\n    gap: 0;\n  }\n\n  &.-variant-toggle > legend {\n    flex-basis: 100%;\n  }\n\n  &.-variant-toggle > .pfx-radio:has(input:focus-visible) {\n    z-index: 1;\n  }\n}\n"}}],"_permissionRequestSessionId":"e0a110b6-b8dd-47be-82d5-cb60da15b229","assistedApproval":{"recommendation":"approve","reason":"Authorized audit-fixture update within the requested component scope.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"e0a110b6-b8dd-47be-82d5-cb60da15b229"},"agentId":"049c1373-ecc6-4d66-bbea-f19e45c06453","id":"aa9aea1b-3560-40cd-a6c5-85c58b39fbc6","timestamp":"2026-10-28T21:04:52.792Z","parentId":"00dcdcf7-5001-46cb-ab5a-0b54b389d84f"}
