{"type":"permission.requested","data":{"requestId":"b6de2480-ce5a-4055-b792-cd811f02616f","permissionRequest":{"kind":"write","toolCallId":"toolu_015Yd9WXi2WKRkXbP68GEmCd","intention":"Edit file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts b/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\n@@ -236,6 +236,7 @@\n       \"components\",\n       \"custom-components\",\n       \"interactions\",\n+      \"tokens\",\n     ]);\n     if (outcome === \"success\")\n       expect(\n","newFileContents":"import { mkdtempSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, expect, test, vi } from \"vite-plus/test\";\nimport { parseCssDocs } from \"@cssdoc/core\";\nimport {\n  auditInvocation,\n  authoredTargets,\n  behaviorNames,\n  collectExamples,\n  completedTargets,\n  collectCoverage,\n  exampleHtml,\n  execute,\n  executeAsync,\n  inspectChecks,\n  expandCases,\n  renderPage,\n  runPageAudits,\n  runNpmAudits,\n  packAuditPackages,\n  renderNpmFixture,\n  writeIndex,\n} from \"../scripts/audit-accessibility.ts\";\nimport type { WorkspacePackages } from \"../../../scripts/release/workspace-packages.ts\";\n\nconst directories: string[] = [];\nconst temp = (): string => {\n  const dir = mkdtempSync(join(tmpdir(), \"pantoken-a11y-\"));\n  directories.push(dir);\n  return dir;\n};\nafterEach(() => {\n  vi.restoreAllMocks();\n  for (const dir of directories.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\nconst entry = (\n  example = '-automatica11y\\n```html\\n<button class=\"pfx-button\">Save</button>\\n```',\n) =>\n  parseCssDocs(\n    `/**\\n * @component button\\n * @example ${example.replaceAll(\"\\n\", \"\\n * \")}\\n */\\n.pfx-button { color: red; }`,\n  );\n\ntest(\"normalizes only prefix class tokens and supports multiple fences and unfenced markup\", () => {\n  expect(\n    exampleHtml(\n      '-automatica11y\\n```html\\n<button class=\"pfx-button\">pfx-text</button>\\n```\\n```html\\n<span>More</span>\\n```',\n    ),\n  ).toBe('<button class=\"instui-button\">pfx-text</button>\\n\\n<span>More</span>');\n  expect(exampleHtml(\"-automatica11y\\n<p>Plain</p>\")).toBe(\"<p>Plain</p>\");\n  expect(() => exampleHtml(\"-automatica11y\\n\")).toThrow(\"Empty audit markup\");\n});\ntest(\"requires unique records, explicit examples, and valid markup\", () => {\n  expect(collectExamples(entry(), [\"button\"])).toEqual([\n    { record: \"button\", index: 0, html: '<button class=\"instui-button\">Save</button>' },\n  ]);\n  expect(() => collectExamples([], [\"button\"])).toThrow(\"found 0\");\n  expect(() => collectExamples([...entry(), ...entry()], [\"button\"])).toThrow(\"found 2\");\n  expect(() => collectExamples(entry(\"<button>Save</button>\"), [\"button\"])).toThrow(\n    \"Missing -automatica11y\",\n  );\n});\ntest(\"expands only four supported theme/scheme cases and loads local production assets\", () => {\n  const cases = expandCases(collectExamples(entry(), [\"button\"]));\n  expect(cases).toHaveLength(4);\n  expect(new Set(cases.map((item) => item.id)).size).toBe(4);\n  expect(cases.map((item) => `${item.theme}:${item.scheme}`)).toEqual([\n    \"rebrand:light\",\n    \"rebrand:dark\",\n    \"canvas:light\",\n    \"canvasHighContrast:light\",\n  ]);\n  const page = renderPage({ ...cases[0]!, html: '<dialog class=\"instui-modal\">Content</dialog>' });\n  expect(page).toContain('data-pantoken-theme=\"rebrand\"');\n  expect(page).toContain('data-pantoken-scheme=\"light\"');\n  for (const asset of [\n    \"scope.css\",\n    \"schemes.css\",\n    \"base.css\",\n    \"components.css\",\n    \"utilities.css\",\n    \"icons.css\",\n    \"fonts.css\",\n    \"modal.iife.js\",\n  ])\n    expect(page).toContain(asset);\n  expect(page).not.toContain(\"https://\");\n  expect(page).not.toContain(\"../assets\");\n  expect(page).toContain('href=\"assets/tokens/scope.css\"');\n  expect(page).toContain('src=\"assets/interactions/modal.iife.js\"');\n  expect(page).toContain(\"dialog.showModal()\");\n  expect(page).toContain(\"popover.showPopover()\");\n  expect(page).toContain(\"details.open = true\");\n  expect(page).toContain('document.querySelector(\".instui-tooltip [data-a11y-trigger]\")?.focus()');\n  expect(page).toContain('[role=\"treeitem\"][aria-expanded=\"false\"]');\n  expect(page).toContain('row.querySelector(\".item\")?.click()');\n  expect(page).toContain(\n    \".instui-form-field[data-native-validation] input[data-a11y-trigger][required]\",\n  );\n  expect(page).toContain(\"control.checkValidity()\");\n  expect(behaviorNames('<div class=\"instui-tabs\"></div>')).toEqual([\"tabs\"]);\n  expect(behaviorNames('<div class=\"instui-tree-browser\" role=\"tree\"></div>')).toEqual([\n    \"tree-browser\",\n  ]);\n  expect(behaviorNames('<label class=\"instui-form-field\" data-native-validation></label>')).toEqual(\n    [\"form-field\"],\n  );\n  expect(behaviorNames('<div class=\"instui-menu\" data-menu-navigation></div>')).toEqual([\"menu\"]);\n  expect(behaviorNames(\"<p>instui-tabs</p>\")).toEqual([]);\n});\ntest(\"checks exact completed coverage without interpreting violations as failures\", () => {\n  expect(\n    completedTargets({ targets: [{ id: \"button\", status: \"ran\", violations: 9 }] }, [\"button\"]),\n  ).toEqual([\"button\"]);\n  for (const invalid of [\n    null,\n    {},\n    { targets: [null] },\n    { targets: [{ id: \"button\", status: \"failed\", reason: \"Missing asset\" }] },\n    { targets: [] },\n    { targets: [{ id: \"extra\", status: \"ran\" }] },\n    {\n      targets: [\n        { id: \"button\", status: \"ran\" },\n        { id: \"button\", status: \"ran\" },\n      ],\n    },\n  ]) {\n    expect(() => completedTargets(invalid, [\"button\"])).toThrow();\n  }\n});\ntest(\"retains original evidence, uses installed CLI, and doesn't add violation fail flags\", async () => {\n  const out = temp();\n  const run = vi.fn((_command: string, args: string[]) => {\n    const dir = args[args.indexOf(\"--out\") + 1]!;\n    mkdirSync(dir, { recursive: true });\n    writeFileSync(join(dir, \"report.md\"), \"Original report\");\n    writeFileSync(\n      join(dir, \"results.json\"),\n      JSON.stringify({ targets: [{ id: \"button\", status: \"ran\" }] }),\n    );\n  });\n  expect(\n    await auditInvocation(out, \"sample\", [\"button=/case.html\"], [\"--tiers\", \"rules\"], run),\n  ).toEqual({\n    directory: \"sample\",\n    expected: [\"button\"],\n    completed: [\"button\"],\n    gaps: 0,\n    coverage: { notices: [\"button: no executable configurations\"], configurations: [] },\n  });\n  expect(run.mock.calls[0]![0]).toBe(process.execPath);\n  expect(run.mock.calls[0]![1]).toContain(\"audit\");\n  expect(run.mock.calls[0]![1].join(\" \")).not.toContain(\"--fail\");\n  expect(readFileSync(join(out, \"sample/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"makes subprocess and missing-report errors visible, including multi-target invocations\", async () => {\n  const out = temp();\n  vi.spyOn(console, \"error\").mockImplementation(() => {});\n  const run = vi.fn(() => {\n    throw new Error(\"Browser unavailable\");\n  });\n  const result = await auditInvocation(out, \"broken\", [\"a=/a.html\", \"b=/b.html\"], [], run);\n  expect(result.error).toBe(\"Browser unavailable\");\n  expect(result.completed).toEqual([]);\n  expect(run.mock.calls[0]).toBeDefined();\n  expect((await auditInvocation(out, \"missing\", [\"a=/a.html\"], [], () => {})).error).toContain(\n    \"ENOENT\",\n  );\n  expect(console.error).toHaveBeenCalled();\n});\ntest(\"executes without a shell and rejects failed or missing subprocesses\", () => {\n  execute(process.execPath, [\"-e\", \"\"], temp());\n  expect(() => execute(process.execPath, [\"-e\", \"process.exit(3)\"], temp())).toThrow(\"exited 3\");\n  expect(() => execute(join(temp(), \"does-not-exist\"), [])).toThrow();\n});\ntest(\"writes a coverage index with separate errors and the automated-coverage caveat\", async () => {\n  const out = temp();\n  writeIndex(\n    out,\n    [{ directory: \"sample\", expected: [\"a\"], completed: [], error: \"missing | target\" }],\n    [],\n  );\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"0 / 1\");\n  expect(markdown).toContain(\"missing \\\\| target\");\n  expect(markdown).toContain(\n    \"These automated results do not establish that the page meets WCAG; manual review is still needed.\",\n  );\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].error).toBe(\n    \"missing | target\",\n  );\n  await expect(runPageAudits(\"not-a-component\")).rejects.toThrow(\"Unknown record\");\n});\n\ntest.each([\"success\", \"setup failure\", \"audit failure\"])(\n  \"orchestrates retained page evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const path of [\n      \"formats/components/dist\",\n      \"formats/components/assets\",\n      \"formats/css/dist\",\n      \"formats/interactions/dist\",\n      \"plugins/pantoken/custom-components/dist\",\n    ]) {\n      mkdirSync(join(root, path), { recursive: true });\n    }\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    vi.spyOn(console, \"log\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (outcome === \"setup failure\" && args.includes(\"doctor\"))\n        throw new Error(\"Missing browser\");\n      const index = args.indexOf(\"--out\");\n      if (index < 0) return;\n      if (outcome === \"audit failure\") throw new Error(\"Target failed\");\n      const directory = args[index + 1]!;\n      const targets = args\n        .slice(2, args.indexOf(\"--wcag\"))\n        .map((target) => ({ id: target.split(\"=\")[0], status: \"ran\" }));\n      mkdirSync(directory, { recursive: true });\n      writeFileSync(join(directory, \"report.md\"), \"Original\");\n      writeFileSync(join(directory, \"results.json\"), JSON.stringify({ targets }));\n    });\n    if (outcome === \"success\")\n      expect(await runPageAudits(\"button\", run, root)).toContain(\"a11y-report\");\n    else\n      await expect(runPageAudits(\"button\", run, root)).rejects.toThrow(\n        \"Incomplete accessibility audit\",\n      );\n    const output = join(root, \"a11y-report\", readdirSync(join(root, \"a11y-report\"))[0]!);\n    const coverage = JSON.parse(readFileSync(join(output, \"coverage.json\"), \"utf8\"));\n    expect(coverage.cases).toHaveLength(4);\n    expect(readdirSync(join(output, \"pages\", \"assets\"))).toEqual([\n      \"assets\",\n      \"components\",\n      \"custom-components\",\n      \"interactions\",\n      \"tokens\",\n    ]);\n    if (outcome === \"success\")\n      expect(\n        coverage.evidence.every((item: { completed: string[] }) => item.completed.length === 1),\n      ).toBe(true);\n    else expect(readFileSync(join(output, \"index.md\"), \"utf8\")).toContain(\"Not run\");\n  },\n);\n\nconst workspace = (root: string): WorkspacePackages => {\n  const packages = [\"components\", \"css\", \"interactions\", \"utils\"].map((name) => ({\n    name: `@pantoken/${name}`,\n    path: `formats/${name}`,\n    version: \"1.0.0\",\n    private: false,\n    workspaceDeps: new Set(name === \"utils\" ? [] : [\"@pantoken/utils\"]),\n  }));\n  return { rootDir: root, packages, byName: new Map(packages.map((pkg) => [pkg.name, pkg])) };\n};\ntest(\"packs every local runtime dependency once through the workspace-aware package manager\", () => {\n  const root = temp();\n  const run = vi.fn((_command: string, args: string[]) =>\n    writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\"),\n  );\n  const options = packAuditPackages(root, workspace(root), run);\n  expect(options.filter((option) => option === \"--local-package\")).toHaveLength(4);\n  expect(run.mock.calls).toHaveLength(4);\n  expect(run.mock.calls[0]![0]).toBe(\"vp\");\n  expect(options.join(\" \")).toContain(\"@pantoken/utils=\");\n  const missing = workspace(root);\n  missing.byName.delete(\"@pantoken/utils\");\n  expect(() => packAuditPackages(root, missing, run)).toThrow(\"Missing local audit dependency\");\n});\n\ntest(\"rejects asynchronous subprocess launch and exit failures\", async () => {\n  await executeAsync(process.execPath, [\"-e\", \"\"], temp());\n  await expect(executeAsync(process.execPath, [\"-e\", \"process.exit(4)\"], temp())).rejects.toThrow(\n    \"exited 4\",\n  );\n  await expect(executeAsync(join(temp(), \"missing\"), [])).rejects.toThrow();\n});\n\ntest(\"reports coverage gaps without merging them with failed checks or violations\", () => {\n  expect(\n    inspectChecks({\n      tiers: [\n        { status: \"not-testable\" },\n        { result: \"undetermined\" },\n        { status: \"gap\" },\n        { status: \"skipped\" },\n      ],\n    }),\n  ).toBe(4);\n  expect(inspectChecks({ result: \"fail\", status: \"ran\", violations: [] })).toBe(0);\n  expect(() =>\n    inspectChecks({ engines: { axe: { status: \"failed\", reason: \"Engine error\" } } }),\n  ).toThrow(\"Engine error\");\n  expect(() => inspectChecks({ result: \"error\" })).toThrow(\"Audit check failed\");\n});\n\nconst requestedTiers = [\"rules\", \"interactions\", \"computed\", \"conditions\", \"vsr\"];\nconst dialogResults = () => {\n  const targets = Array.from({ length: 6 }, (_, index) => ({\n    id: `dialog-${index}`,\n    status: \"ran\",\n    archetypes: {\n      dialog: {\n        status: \"ran\",\n        fixture: { source: \"authored\" },\n        configs: [\n          {\n            state: \"closed\",\n            tiers: Object.fromEntries(requestedTiers.map((tier) => [tier, { status: \"ran\" }])),\n          },\n          { state: \"open\", tiers: { rules: { status: \"ran\" }, vsr: { status: \"ran\" } } },\n        ],\n      },\n    },\n    summary: { gaps: [], notTestable: [] },\n  }));\n  const coverage = targets.flatMap(({ id }) =>\n    [\"interactions\", \"computed\", \"conditions\"].map(\n      (tier) => `${id}/dialog/1/${tier}: missing requested tier`,\n    ),\n  );\n  return { targets, outcome: { status: \"passed\", coverage } };\n};\n\ntest(\"retains 18 original supplemental-state notices without double counting derived gaps\", () => {\n  const results = dialogResults();\n  const coverage = collectCoverage(results, requestedTiers);\n  expect(coverage.notices).toEqual(results.outcome.coverage);\n  expect(coverage.configurations).toHaveLength(12);\n  expect(coverage.configurations[1]).toEqual({\n    target: \"dialog-0\",\n    archetype: \"dialog\",\n    index: 1,\n    state: \"open\",\n    tiers: {\n      rules: \"ran\",\n      interactions: \"missing\",\n      computed: \"missing\",\n      conditions: \"missing\",\n      vsr: \"ran\",\n    },\n  });\n  expect(collectCoverage({ targets: results.targets }, requestedTiers)).toEqual(coverage);\n});\n\ntest(\"preserves summary limitations, original notices, and not-testable tier notes separately\", () => {\n  const coverage = collectCoverage(\n    {\n      outcome: { coverage: [\"example: original notice\"] },\n      targets: [\n        {\n          id: \"example\",\n          summary: { gaps: [\"fixture gap\"], notTestable: [\"closed shadow root\"] },\n          archetypes: {\n            page: {\n              configs: [\n                {\n                  state: \"expanded\",\n                  tiers: {\n                    rules: { status: \"not-testable\", reason: \"no DOM\" },\n                    vsr: { status: \"ran\", notTestable: [\"open shadow root\"] },\n                    computed: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n          },\n        },\n      ],\n    },\n    [\"rules\", \"vsr\", \"computed\"],\n  );\n  expect(coverage.notices).toEqual([\n    \"example: original notice\",\n    \"example: fixture gap\",\n    \"example: closed shadow root\",\n    \"example/page/0/rules: no DOM\",\n    \"example/page/0/vsr: open shadow root\",\n  ]);\n  expect(coverage.configurations[0]!.tiers.computed).toBe(\"not-applicable\");\n});\n\ntest(\"reports missing configurations and rejects malformed coverage data\", () => {\n  expect(\n    collectCoverage({ targets: [{ id: \"empty\", archetypes: {} }] }, requestedTiers).notices,\n  ).toEqual([\"empty: no executable configurations\"]);\n  for (const value of [\n    null,\n    {},\n    { outcome: { coverage: \"invalid\" } },\n    { outcome: { coverage: [42] } },\n    { targets: [{ id: 1 }] },\n    { targets: [{ id: \"x\", summary: { gaps: {} } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { status: \"gap\", reason: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [null] } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [{}] } } }] },\n  ])\n    expect(() => collectCoverage(value, requestedTiers)).toThrow(\"Invalid\");\n});\n\ntest(\"keeps skipped, gap, and unreported statuses explicit without treating inapplicable tiers as gaps\", () => {\n  const coverage = collectCoverage(\n    {\n      targets: [\n        {\n          id: \"sample\",\n          archetypes: {\n            dialog: {\n              status: \"gap\",\n              configs: [\n                {\n                  tiers: {\n                    rules: { status: \"skipped\" },\n                    computed: {},\n                    vsr: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n            menu: { status: \"gap\", reason: \"missing fixture\" },\n          },\n        },\n      ],\n    },\n    [],\n  );\n  expect(coverage.notices).toEqual([\n    \"sample/dialog: fixture gap\",\n    \"sample/dialog/0/rules: skipped\",\n    \"sample/dialog/0/computed: missing status\",\n    \"sample/menu: missing fixture\",\n  ]);\n  expect(coverage.configurations[0]!.state).toBe(\"Not reported\");\n});\n\ntest(\"indexes supplemental-state coverage without changing originals or failing advisory findings\", async () => {\n  const out = temp();\n  const original = JSON.stringify(dialogResults());\n  const result = await auditInvocation(\n    out,\n    \"npm-dialog\",\n    dialogResults().targets.map(({ id }) => `${id}=npm:example`),\n    [\"--tiers\", requestedTiers.join(\",\")],\n    (_command, args) => {\n      const directory = args[args.indexOf(\"--out\") + 1]!;\n      mkdirSync(directory);\n      writeFileSync(join(directory, \"report.md\"), \"Original report\");\n      writeFileSync(join(directory, \"results.json\"), original);\n    },\n    \"dialog\",\n  );\n  expect(result.error).toBeUndefined();\n  expect(result.completed).toHaveLength(6);\n  expect(result.gaps).toBe(0);\n  expect(result.coverage?.notices).toHaveLength(18);\n  writeIndex(out, [result], []);\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"Coverage notices\");\n  expect(markdown).toContain(\"| npm-dialog | 6 / 6 | 0 | 18 |\");\n  expect(markdown).toContain(\"dialog-0/dialog/1/interactions: missing requested tier\");\n  expect(markdown).toContain(\"open\");\n  expect(markdown).toContain(\"interactions: missing\");\n  expect(markdown).toContain(\"not unique defects\");\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].coverage).toEqual(\n    result.coverage,\n  );\n  expect(readFileSync(join(out, \"npm-dialog/results.json\"), \"utf8\")).toBe(original);\n  expect(readFileSync(join(out, \"npm-dialog/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"rejects native templates, generated guesses, and npm archetype gaps\", () => {\n  const target = {\n    id: \"sample\",\n    status: \"ran\",\n    archetypes: { button: { status: \"ran\", fixture: { source: \"authored\" } } },\n  };\n  expect(authoredTargets({ targets: [target] }, [\"sample\"], \"button\")).toEqual([\"sample\"]);\n  for (const source of [\"template\", \"generated\", \"none\"]) {\n    expect(() =>\n      authoredTargets(\n        {\n          targets: [{ ...target, archetypes: { button: { status: \"ran\", fixture: { source } } } }],\n        },\n        [\"sample\"],\n        \"button\",\n      ),\n    ).toThrow(\"authored fixture\");\n  }\n  expect(() => authoredTargets({ targets: [target] }, [\"sample\"], \"dialog\")).toThrow(\n    \"authored fixture\",\n  );\n  expect(() => authoredTargets(null, [], \"button\")).toThrow();\n});\ntest(\"inlines only built supplementary styles, local fonts, and production behavior\", () => {\n  const root = temp();\n  for (const folder of [\"tokens\", \"components\", \"assets\", \"interactions\"])\n    mkdirSync(join(root, folder));\n  for (const file of [\n    \"tokens/schemes.css\",\n    \"components/base.css\",\n    \"components/utilities.css\",\n    \"components/icons.css\",\n  ])\n    writeFileSync(join(root, file), \"/* built */\");\n  writeFileSync(join(root, \"assets/font.woff2\"), \"local-font\");\n  writeFileSync(join(root, \"components/fonts.css\"), '@font-face{src:url(\"../assets/font.woff2\")}');\n  writeFileSync(join(root, \"interactions/modal.iife.js\"), \"window.production = true;\");\n  const html = renderNpmFixture(\n    {\n      ...expandCases([\n        { record: \"modal\", index: 0, html: '<dialog class=\"instui-modal\">Details</dialog>' },\n      ])[0]!,\n      scheme: \"dark\",\n    },\n    root,\n  );\n  expect(html).toContain(\"data:font/woff2;base64,\");\n  expect(html).toContain(\"window.production = true\");\n  expect(html).toContain('style.colorScheme = \"dark\"');\n  expect(html).toContain('dataset.pantokenTheme = \"rebrand\"');\n  expect(html).not.toContain(\"https://\");\n  expect(html).not.toContain(\"dialog.showModal()\");\n  expect(html).not.toContain(\"popover.showPopover()\");\n  expect(html).not.toContain(\"details.open = true\");\n});\ntest.each([\"success\", \"pack failure\", \"fixture gap\", \"no archetype\", \"full inventory\"])(\n  \"appends npm evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const folder of [\n      \"pages/assets/tokens\",\n      \"pages/assets/components\",\n      \"pages/assets/interactions\",\n    ])\n      mkdirSync(join(root, folder), { recursive: true });\n    for (const file of [\n      \"tokens/schemes.css\",\n      \"components/base.css\",\n      \"components/utilities.css\",\n      \"components/icons.css\",\n      \"components/fonts.css\",\n    ])\n      writeFileSync(join(root, \"pages\", \"assets\", file), \"/* built */\");\n    for (const name of [\"modal\", \"tabs\", \"tooltip\", \"close-button\", \"form-field\", \"menu\"])\n      writeFileSync(join(root, \"pages\", \"assets\", \"interactions\", `${name}.iife.js`), \"\");\n    writeIndex(root, [], []);\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (args.includes(\"pack\")) {\n        if (outcome === \"pack failure\") throw new Error(\"Pack failed\");\n        writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\");\n        return;\n      }\n      const destination = args[args.indexOf(\"--out\") + 1]!;\n      const archetype = args[args.indexOf(\"--archetypes\") + 1]!;\n      const targets = args.slice(2, args.indexOf(\"--wcag\")).map((spec) => ({\n        id: spec.split(\"=\")[0],\n        status: \"ran\",\n        archetypes: {\n          [archetype]: {\n            status: outcome === \"fixture gap\" ? \"gap\" : \"ran\",\n            fixture: { source: \"authored\" },\n          },\n        },\n      }));\n      const mapping = JSON.parse(readFileSync(args[args.indexOf(\"--mapping\") + 1]!, \"utf8\"));\n      expect(Object.keys(mapping).sort()).toEqual(targets.map((target) => target.id).sort());\n      mkdirSync(destination, { recursive: true });\n      writeFileSync(join(destination, \"report.md\"), \"Original npm report\");\n      writeFileSync(join(destination, \"results.json\"), JSON.stringify({ targets }));\n    });\n    const action = runNpmAudits(\n      root,\n      outcome === \"full inventory\" ? undefined : outcome === \"no archetype\" ? \"text\" : \"button\",\n      run,\n      workspace(root),\n    );\n    if (outcome === \"success\" || outcome === \"no archetype\" || outcome === \"full inventory\")\n      await action;\n    else await expect(action).rejects.toThrow(\"Incomplete npm accessibility audit\");\n    const coverage = JSON.parse(readFileSync(join(root, \"coverage.json\"), \"utf8\"));\n    if (outcome === \"success\") {\n      expect(coverage.evidence[0].completed).toHaveLength(4);\n      const mapping = JSON.parse(readFileSync(join(root, \"mapping-button.json\"), \"utf8\"));\n      expect(Object.keys(mapping)).toHaveLength(4);\n      expect(run.mock.calls.at(-1)![1]).toContain(\"--no-generate\");\n    } else if (outcome === \"full inventory\") {\n      expect(coverage.evidence).toHaveLength(9);\n      expect(\n        coverage.evidence.flatMap((item: { completed: string[] }) => item.completed),\n      ).toHaveLength(36);\n    } else if (outcome === \"no archetype\") expect(run).not.toHaveBeenCalled();\n    else expect(coverage.evidence.some((item: { error?: string }) => item.error)).toBe(true);\n  },\n);\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts","content":"import { mkdtempSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, expect, test, vi } from \"vite-plus/test\";\nimport { parseCssDocs } from \"@cssdoc/core\";\nimport {\n  auditInvocation,\n  authoredTargets,\n  behaviorNames,\n  collectExamples,\n  completedTargets,\n  collectCoverage,\n  exampleHtml,\n  execute,\n  executeAsync,\n  inspectChecks,\n  expandCases,\n  renderPage,\n  runPageAudits,\n  runNpmAudits,\n  packAuditPackages,\n  renderNpmFixture,\n  writeIndex,\n} from \"../scripts/audit-accessibility.ts\";\nimport type { WorkspacePackages } from \"../../../scripts/release/workspace-packages.ts\";\n\nconst directories: string[] = [];\nconst temp = (): string => {\n  const dir = mkdtempSync(join(tmpdir(), \"pantoken-a11y-\"));\n  directories.push(dir);\n  return dir;\n};\nafterEach(() => {\n  vi.restoreAllMocks();\n  for (const dir of directories.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\nconst entry = (\n  example = '-automatica11y\\n```html\\n<button class=\"pfx-button\">Save</button>\\n```',\n) =>\n  parseCssDocs(\n    `/**\\n * @component button\\n * @example ${example.replaceAll(\"\\n\", \"\\n * \")}\\n */\\n.pfx-button { color: red; }`,\n  );\n\ntest(\"normalizes only prefix class tokens and supports multiple fences and unfenced markup\", () => {\n  expect(\n    exampleHtml(\n      '-automatica11y\\n```html\\n<button class=\"pfx-button\">pfx-text</button>\\n```\\n```html\\n<span>More</span>\\n```',\n    ),\n  ).toBe('<button class=\"instui-button\">pfx-text</button>\\n\\n<span>More</span>');\n  expect(exampleHtml(\"-automatica11y\\n<p>Plain</p>\")).toBe(\"<p>Plain</p>\");\n  expect(() => exampleHtml(\"-automatica11y\\n\")).toThrow(\"Empty audit markup\");\n});\ntest(\"requires unique records, explicit examples, and valid markup\", () => {\n  expect(collectExamples(entry(), [\"button\"])).toEqual([\n    { record: \"button\", index: 0, html: '<button class=\"instui-button\">Save</button>' },\n  ]);\n  expect(() => collectExamples([], [\"button\"])).toThrow(\"found 0\");\n  expect(() => collectExamples([...entry(), ...entry()], [\"button\"])).toThrow(\"found 2\");\n  expect(() => collectExamples(entry(\"<button>Save</button>\"), [\"button\"])).toThrow(\n    \"Missing -automatica11y\",\n  );\n});\ntest(\"expands only four supported theme/scheme cases and loads local production assets\", () => {\n  const cases = expandCases(collectExamples(entry(), [\"button\"]));\n  expect(cases).toHaveLength(4);\n  expect(new Set(cases.map((item) => item.id)).size).toBe(4);\n  expect(cases.map((item) => `${item.theme}:${item.scheme}`)).toEqual([\n    \"rebrand:light\",\n    \"rebrand:dark\",\n    \"canvas:light\",\n    \"canvasHighContrast:light\",\n  ]);\n  const page = renderPage({ ...cases[0]!, html: '<dialog class=\"instui-modal\">Content</dialog>' });\n  expect(page).toContain('data-pantoken-theme=\"rebrand\"');\n  expect(page).toContain('data-pantoken-scheme=\"light\"');\n  for (const asset of [\n    \"scope.css\",\n    \"schemes.css\",\n    \"base.css\",\n    \"components.css\",\n    \"utilities.css\",\n    \"icons.css\",\n    \"fonts.css\",\n    \"modal.iife.js\",\n  ])\n    expect(page).toContain(asset);\n  expect(page).not.toContain(\"https://\");\n  expect(page).not.toContain(\"../assets\");\n  expect(page).toContain('href=\"assets/tokens/scope.css\"');\n  expect(page).toContain('src=\"assets/interactions/modal.iife.js\"');\n  expect(page).toContain(\"dialog.showModal()\");\n  expect(page).toContain(\"popover.showPopover()\");\n  expect(page).toContain(\"details.open = true\");\n  expect(page).toContain('document.querySelector(\".instui-tooltip [data-a11y-trigger]\")?.focus()');\n  expect(page).toContain('[role=\"treeitem\"][aria-expanded=\"false\"]');\n  expect(page).toContain('row.querySelector(\".item\")?.click()');\n  expect(page).toContain(\n    \".instui-form-field[data-native-validation] input[data-a11y-trigger][required]\",\n  );\n  expect(page).toContain(\"control.checkValidity()\");\n  expect(behaviorNames('<div class=\"instui-tabs\"></div>')).toEqual([\"tabs\"]);\n  expect(behaviorNames('<div class=\"instui-tree-browser\" role=\"tree\"></div>')).toEqual([\n    \"tree-browser\",\n  ]);\n  expect(behaviorNames('<label class=\"instui-form-field\" data-native-validation></label>')).toEqual(\n    [\"form-field\"],\n  );\n  expect(behaviorNames('<div class=\"instui-menu\" data-menu-navigation></div>')).toEqual([\"menu\"]);\n  expect(behaviorNames(\"<p>instui-tabs</p>\")).toEqual([]);\n});\ntest(\"checks exact completed coverage without interpreting violations as failures\", () => {\n  expect(\n    completedTargets({ targets: [{ id: \"button\", status: \"ran\", violations: 9 }] }, [\"button\"]),\n  ).toEqual([\"button\"]);\n  for (const invalid of [\n    null,\n    {},\n    { targets: [null] },\n    { targets: [{ id: \"button\", status: \"failed\", reason: \"Missing asset\" }] },\n    { targets: [] },\n    { targets: [{ id: \"extra\", status: \"ran\" }] },\n    {\n      targets: [\n        { id: \"button\", status: \"ran\" },\n        { id: \"button\", status: \"ran\" },\n      ],\n    },\n  ]) {\n    expect(() => completedTargets(invalid, [\"button\"])).toThrow();\n  }\n});\ntest(\"retains original evidence, uses installed CLI, and doesn't add violation fail flags\", async () => {\n  const out = temp();\n  const run = vi.fn((_command: string, args: string[]) => {\n    const dir = args[args.indexOf(\"--out\") + 1]!;\n    mkdirSync(dir, { recursive: true });\n    writeFileSync(join(dir, \"report.md\"), \"Original report\");\n    writeFileSync(\n      join(dir, \"results.json\"),\n      JSON.stringify({ targets: [{ id: \"button\", status: \"ran\" }] }),\n    );\n  });\n  expect(\n    await auditInvocation(out, \"sample\", [\"button=/case.html\"], [\"--tiers\", \"rules\"], run),\n  ).toEqual({\n    directory: \"sample\",\n    expected: [\"button\"],\n    completed: [\"button\"],\n    gaps: 0,\n    coverage: { notices: [\"button: no executable configurations\"], configurations: [] },\n  });\n  expect(run.mock.calls[0]![0]).toBe(process.execPath);\n  expect(run.mock.calls[0]![1]).toContain(\"audit\");\n  expect(run.mock.calls[0]![1].join(\" \")).not.toContain(\"--fail\");\n  expect(readFileSync(join(out, \"sample/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"makes subprocess and missing-report errors visible, including multi-target invocations\", async () => {\n  const out = temp();\n  vi.spyOn(console, \"error\").mockImplementation(() => {});\n  const run = vi.fn(() => {\n    throw new Error(\"Browser unavailable\");\n  });\n  const result = await auditInvocation(out, \"broken\", [\"a=/a.html\", \"b=/b.html\"], [], run);\n  expect(result.error).toBe(\"Browser unavailable\");\n  expect(result.completed).toEqual([]);\n  expect(run.mock.calls[0]).toBeDefined();\n  expect((await auditInvocation(out, \"missing\", [\"a=/a.html\"], [], () => {})).error).toContain(\n    \"ENOENT\",\n  );\n  expect(console.error).toHaveBeenCalled();\n});\ntest(\"executes without a shell and rejects failed or missing subprocesses\", () => {\n  execute(process.execPath, [\"-e\", \"\"], temp());\n  expect(() => execute(process.execPath, [\"-e\", \"process.exit(3)\"], temp())).toThrow(\"exited 3\");\n  expect(() => execute(join(temp(), \"does-not-exist\"), [])).toThrow();\n});\ntest(\"writes a coverage index with separate errors and the automated-coverage caveat\", async () => {\n  const out = temp();\n  writeIndex(\n    out,\n    [{ directory: \"sample\", expected: [\"a\"], completed: [], error: \"missing | target\" }],\n    [],\n  );\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"0 / 1\");\n  expect(markdown).toContain(\"missing \\\\| target\");\n  expect(markdown).toContain(\n    \"These automated results do not establish that the page meets WCAG; manual review is still needed.\",\n  );\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].error).toBe(\n    \"missing | target\",\n  );\n  await expect(runPageAudits(\"not-a-component\")).rejects.toThrow(\"Unknown record\");\n});\n\ntest.each([\"success\", \"setup failure\", \"audit failure\"])(\n  \"orchestrates retained page evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const path of [\n      \"formats/components/dist\",\n      \"formats/components/assets\",\n      \"formats/css/dist\",\n      \"formats/interactions/dist\",\n      \"plugins/pantoken/custom-components/dist\",\n    ]) {\n      mkdirSync(join(root, path), { recursive: true });\n    }\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    vi.spyOn(console, \"log\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (outcome === \"setup failure\" && args.includes(\"doctor\"))\n        throw new Error(\"Missing browser\");\n      const index = args.indexOf(\"--out\");\n      if (index < 0) return;\n      if (outcome === \"audit failure\") throw new Error(\"Target failed\");\n      const directory = args[index + 1]!;\n      const targets = args\n        .slice(2, args.indexOf(\"--wcag\"))\n        .map((target) => ({ id: target.split(\"=\")[0], status: \"ran\" }));\n      mkdirSync(directory, { recursive: true });\n      writeFileSync(join(directory, \"report.md\"), \"Original\");\n      writeFileSync(join(directory, \"results.json\"), JSON.stringify({ targets }));\n    });\n    if (outcome === \"success\")\n      expect(await runPageAudits(\"button\", run, root)).toContain(\"a11y-report\");\n    else\n      await expect(runPageAudits(\"button\", run, root)).rejects.toThrow(\n        \"Incomplete accessibility audit\",\n      );\n    const output = join(root, \"a11y-report\", readdirSync(join(root, \"a11y-report\"))[0]!);\n    const coverage = JSON.parse(readFileSync(join(output, \"coverage.json\"), \"utf8\"));\n    expect(coverage.cases).toHaveLength(4);\n    expect(readdirSync(join(output, \"pages\", \"assets\"))).toEqual([\n      \"assets\",\n      \"components\",\n      \"custom-components\",\n      \"interactions\",\n    ]);\n    if (outcome === \"success\")\n      expect(\n        coverage.evidence.every((item: { completed: string[] }) => item.completed.length === 1),\n      ).toBe(true);\n    else expect(readFileSync(join(output, \"index.md\"), \"utf8\")).toContain(\"Not run\");\n  },\n);\n\nconst workspace = (root: string): WorkspacePackages => {\n  const packages = [\"components\", \"css\", \"interactions\", \"utils\"].map((name) => ({\n    name: `@pantoken/${name}`,\n    path: `formats/${name}`,\n    version: \"1.0.0\",\n    private: false,\n    workspaceDeps: new Set(name === \"utils\" ? [] : [\"@pantoken/utils\"]),\n  }));\n  return { rootDir: root, packages, byName: new Map(packages.map((pkg) => [pkg.name, pkg])) };\n};\ntest(\"packs every local runtime dependency once through the workspace-aware package manager\", () => {\n  const root = temp();\n  const run = vi.fn((_command: string, args: string[]) =>\n    writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\"),\n  );\n  const options = packAuditPackages(root, workspace(root), run);\n  expect(options.filter((option) => option === \"--local-package\")).toHaveLength(4);\n  expect(run.mock.calls).toHaveLength(4);\n  expect(run.mock.calls[0]![0]).toBe(\"vp\");\n  expect(options.join(\" \")).toContain(\"@pantoken/utils=\");\n  const missing = workspace(root);\n  missing.byName.delete(\"@pantoken/utils\");\n  expect(() => packAuditPackages(root, missing, run)).toThrow(\"Missing local audit dependency\");\n});\n\ntest(\"rejects asynchronous subprocess launch and exit failures\", async () => {\n  await executeAsync(process.execPath, [\"-e\", \"\"], temp());\n  await expect(executeAsync(process.execPath, [\"-e\", \"process.exit(4)\"], temp())).rejects.toThrow(\n    \"exited 4\",\n  );\n  await expect(executeAsync(join(temp(), \"missing\"), [])).rejects.toThrow();\n});\n\ntest(\"reports coverage gaps without merging them with failed checks or violations\", () => {\n  expect(\n    inspectChecks({\n      tiers: [\n        { status: \"not-testable\" },\n        { result: \"undetermined\" },\n        { status: \"gap\" },\n        { status: \"skipped\" },\n      ],\n    }),\n  ).toBe(4);\n  expect(inspectChecks({ result: \"fail\", status: \"ran\", violations: [] })).toBe(0);\n  expect(() =>\n    inspectChecks({ engines: { axe: { status: \"failed\", reason: \"Engine error\" } } }),\n  ).toThrow(\"Engine error\");\n  expect(() => inspectChecks({ result: \"error\" })).toThrow(\"Audit check failed\");\n});\n\nconst requestedTiers = [\"rules\", \"interactions\", \"computed\", \"conditions\", \"vsr\"];\nconst dialogResults = () => {\n  const targets = Array.from({ length: 6 }, (_, index) => ({\n    id: `dialog-${index}`,\n    status: \"ran\",\n    archetypes: {\n      dialog: {\n        status: \"ran\",\n        fixture: { source: \"authored\" },\n        configs: [\n          {\n            state: \"closed\",\n            tiers: Object.fromEntries(requestedTiers.map((tier) => [tier, { status: \"ran\" }])),\n          },\n          { state: \"open\", tiers: { rules: { status: \"ran\" }, vsr: { status: \"ran\" } } },\n        ],\n      },\n    },\n    summary: { gaps: [], notTestable: [] },\n  }));\n  const coverage = targets.flatMap(({ id }) =>\n    [\"interactions\", \"computed\", \"conditions\"].map(\n      (tier) => `${id}/dialog/1/${tier}: missing requested tier`,\n    ),\n  );\n  return { targets, outcome: { status: \"passed\", coverage } };\n};\n\ntest(\"retains 18 original supplemental-state notices without double counting derived gaps\", () => {\n  const results = dialogResults();\n  const coverage = collectCoverage(results, requestedTiers);\n  expect(coverage.notices).toEqual(results.outcome.coverage);\n  expect(coverage.configurations).toHaveLength(12);\n  expect(coverage.configurations[1]).toEqual({\n    target: \"dialog-0\",\n    archetype: \"dialog\",\n    index: 1,\n    state: \"open\",\n    tiers: {\n      rules: \"ran\",\n      interactions: \"missing\",\n      computed: \"missing\",\n      conditions: \"missing\",\n      vsr: \"ran\",\n    },\n  });\n  expect(collectCoverage({ targets: results.targets }, requestedTiers)).toEqual(coverage);\n});\n\ntest(\"preserves summary limitations, original notices, and not-testable tier notes separately\", () => {\n  const coverage = collectCoverage(\n    {\n      outcome: { coverage: [\"example: original notice\"] },\n      targets: [\n        {\n          id: \"example\",\n          summary: { gaps: [\"fixture gap\"], notTestable: [\"closed shadow root\"] },\n          archetypes: {\n            page: {\n              configs: [\n                {\n                  state: \"expanded\",\n                  tiers: {\n                    rules: { status: \"not-testable\", reason: \"no DOM\" },\n                    vsr: { status: \"ran\", notTestable: [\"open shadow root\"] },\n                    computed: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n          },\n        },\n      ],\n    },\n    [\"rules\", \"vsr\", \"computed\"],\n  );\n  expect(coverage.notices).toEqual([\n    \"example: original notice\",\n    \"example: fixture gap\",\n    \"example: closed shadow root\",\n    \"example/page/0/rules: no DOM\",\n    \"example/page/0/vsr: open shadow root\",\n  ]);\n  expect(coverage.configurations[0]!.tiers.computed).toBe(\"not-applicable\");\n});\n\ntest(\"reports missing configurations and rejects malformed coverage data\", () => {\n  expect(\n    collectCoverage({ targets: [{ id: \"empty\", archetypes: {} }] }, requestedTiers).notices,\n  ).toEqual([\"empty: no executable configurations\"]);\n  for (const value of [\n    null,\n    {},\n    { outcome: { coverage: \"invalid\" } },\n    { outcome: { coverage: [42] } },\n    { targets: [{ id: 1 }] },\n    { targets: [{ id: \"x\", summary: { gaps: {} } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { status: \"gap\", reason: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [null] } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [{}] } } }] },\n  ])\n    expect(() => collectCoverage(value, requestedTiers)).toThrow(\"Invalid\");\n});\n\ntest(\"keeps skipped, gap, and unreported statuses explicit without treating inapplicable tiers as gaps\", () => {\n  const coverage = collectCoverage(\n    {\n      targets: [\n        {\n          id: \"sample\",\n          archetypes: {\n            dialog: {\n              status: \"gap\",\n              configs: [\n                {\n                  tiers: {\n                    rules: { status: \"skipped\" },\n                    computed: {},\n                    vsr: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n            menu: { status: \"gap\", reason: \"missing fixture\" },\n          },\n        },\n      ],\n    },\n    [],\n  );\n  expect(coverage.notices).toEqual([\n    \"sample/dialog: fixture gap\",\n    \"sample/dialog/0/rules: skipped\",\n    \"sample/dialog/0/computed: missing status\",\n    \"sample/menu: missing fixture\",\n  ]);\n  expect(coverage.configurations[0]!.state).toBe(\"Not reported\");\n});\n\ntest(\"indexes supplemental-state coverage without changing originals or failing advisory findings\", async () => {\n  const out = temp();\n  const original = JSON.stringify(dialogResults());\n  const result = await auditInvocation(\n    out,\n    \"npm-dialog\",\n    dialogResults().targets.map(({ id }) => `${id}=npm:example`),\n    [\"--tiers\", requestedTiers.join(\",\")],\n    (_command, args) => {\n      const directory = args[args.indexOf(\"--out\") + 1]!;\n      mkdirSync(directory);\n      writeFileSync(join(directory, \"report.md\"), \"Original report\");\n      writeFileSync(join(directory, \"results.json\"), original);\n    },\n    \"dialog\",\n  );\n  expect(result.error).toBeUndefined();\n  expect(result.completed).toHaveLength(6);\n  expect(result.gaps).toBe(0);\n  expect(result.coverage?.notices).toHaveLength(18);\n  writeIndex(out, [result], []);\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"Coverage notices\");\n  expect(markdown).toContain(\"| npm-dialog | 6 / 6 | 0 | 18 |\");\n  expect(markdown).toContain(\"dialog-0/dialog/1/interactions: missing requested tier\");\n  expect(markdown).toContain(\"open\");\n  expect(markdown).toContain(\"interactions: missing\");\n  expect(markdown).toContain(\"not unique defects\");\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].coverage).toEqual(\n    result.coverage,\n  );\n  expect(readFileSync(join(out, \"npm-dialog/results.json\"), \"utf8\")).toBe(original);\n  expect(readFileSync(join(out, \"npm-dialog/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"rejects native templates, generated guesses, and npm archetype gaps\", () => {\n  const target = {\n    id: \"sample\",\n    status: \"ran\",\n    archetypes: { button: { status: \"ran\", fixture: { source: \"authored\" } } },\n  };\n  expect(authoredTargets({ targets: [target] }, [\"sample\"], \"button\")).toEqual([\"sample\"]);\n  for (const source of [\"template\", \"generated\", \"none\"]) {\n    expect(() =>\n      authoredTargets(\n        {\n          targets: [{ ...target, archetypes: { button: { status: \"ran\", fixture: { source } } } }],\n        },\n        [\"sample\"],\n        \"button\",\n      ),\n    ).toThrow(\"authored fixture\");\n  }\n  expect(() => authoredTargets({ targets: [target] }, [\"sample\"], \"dialog\")).toThrow(\n    \"authored fixture\",\n  );\n  expect(() => authoredTargets(null, [], \"button\")).toThrow();\n});\ntest(\"inlines only built supplementary styles, local fonts, and production behavior\", () => {\n  const root = temp();\n  for (const folder of [\"tokens\", \"components\", \"assets\", \"interactions\"])\n    mkdirSync(join(root, folder));\n  for (const file of [\n    \"tokens/schemes.css\",\n    \"components/base.css\",\n    \"components/utilities.css\",\n    \"components/icons.css\",\n  ])\n    writeFileSync(join(root, file), \"/* built */\");\n  writeFileSync(join(root, \"assets/font.woff2\"), \"local-font\");\n  writeFileSync(join(root, \"components/fonts.css\"), '@font-face{src:url(\"../assets/font.woff2\")}');\n  writeFileSync(join(root, \"interactions/modal.iife.js\"), \"window.production = true;\");\n  const html = renderNpmFixture(\n    {\n      ...expandCases([\n        { record: \"modal\", index: 0, html: '<dialog class=\"instui-modal\">Details</dialog>' },\n      ])[0]!,\n      scheme: \"dark\",\n    },\n    root,\n  );\n  expect(html).toContain(\"data:font/woff2;base64,\");\n  expect(html).toContain(\"window.production = true\");\n  expect(html).toContain('style.colorScheme = \"dark\"');\n  expect(html).toContain('dataset.pantokenTheme = \"rebrand\"');\n  expect(html).not.toContain(\"https://\");\n  expect(html).not.toContain(\"dialog.showModal()\");\n  expect(html).not.toContain(\"popover.showPopover()\");\n  expect(html).not.toContain(\"details.open = true\");\n});\ntest.each([\"success\", \"pack failure\", \"fixture gap\", \"no archetype\", \"full inventory\"])(\n  \"appends npm evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const folder of [\n      \"pages/assets/tokens\",\n      \"pages/assets/components\",\n      \"pages/assets/interactions\",\n    ])\n      mkdirSync(join(root, folder), { recursive: true });\n    for (const file of [\n      \"tokens/schemes.css\",\n      \"components/base.css\",\n      \"components/utilities.css\",\n      \"components/icons.css\",\n      \"components/fonts.css\",\n    ])\n      writeFileSync(join(root, \"pages\", \"assets\", file), \"/* built */\");\n    for (const name of [\"modal\", \"tabs\", \"tooltip\", \"close-button\", \"form-field\", \"menu\"])\n      writeFileSync(join(root, \"pages\", \"assets\", \"interactions\", `${name}.iife.js`), \"\");\n    writeIndex(root, [], []);\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (args.includes(\"pack\")) {\n        if (outcome === \"pack failure\") throw new Error(\"Pack failed\");\n        writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\");\n        return;\n      }\n      const destination = args[args.indexOf(\"--out\") + 1]!;\n      const archetype = args[args.indexOf(\"--archetypes\") + 1]!;\n      const targets = args.slice(2, args.indexOf(\"--wcag\")).map((spec) => ({\n        id: spec.split(\"=\")[0],\n        status: \"ran\",\n        archetypes: {\n          [archetype]: {\n            status: outcome === \"fixture gap\" ? \"gap\" : \"ran\",\n            fixture: { source: \"authored\" },\n          },\n        },\n      }));\n      const mapping = JSON.parse(readFileSync(args[args.indexOf(\"--mapping\") + 1]!, \"utf8\"));\n      expect(Object.keys(mapping).sort()).toEqual(targets.map((target) => target.id).sort());\n      mkdirSync(destination, { recursive: true });\n      writeFileSync(join(destination, \"report.md\"), \"Original npm report\");\n      writeFileSync(join(destination, \"results.json\"), JSON.stringify({ targets }));\n    });\n    const action = runNpmAudits(\n      root,\n      outcome === \"full inventory\" ? undefined : outcome === \"no archetype\" ? \"text\" : \"button\",\n      run,\n      workspace(root),\n    );\n    if (outcome === \"success\" || outcome === \"no archetype\" || outcome === \"full inventory\")\n      await action;\n    else await expect(action).rejects.toThrow(\"Incomplete npm accessibility audit\");\n    const coverage = JSON.parse(readFileSync(join(root, \"coverage.json\"), \"utf8\"));\n    if (outcome === \"success\") {\n      expect(coverage.evidence[0].completed).toHaveLength(4);\n      const mapping = JSON.parse(readFileSync(join(root, \"mapping-button.json\"), \"utf8\"));\n      expect(Object.keys(mapping)).toHaveLength(4);\n      expect(run.mock.calls.at(-1)![1]).toContain(\"--no-generate\");\n    } else if (outcome === \"full inventory\") {\n      expect(coverage.evidence).toHaveLength(9);\n      expect(\n        coverage.evidence.flatMap((item: { completed: string[] }) => item.completed),\n      ).toHaveLength(36);\n    } else if (outcome === \"no archetype\") expect(run).not.toHaveBeenCalled();\n    else expect(coverage.evidence.some((item: { error?: string }) => item.error)).toBe(true);\n  },\n);\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts","content":"import { mkdtempSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, expect, test, vi } from \"vite-plus/test\";\nimport { parseCssDocs } from \"@cssdoc/core\";\nimport {\n  auditInvocation,\n  authoredTargets,\n  behaviorNames,\n  collectExamples,\n  completedTargets,\n  collectCoverage,\n  exampleHtml,\n  execute,\n  executeAsync,\n  inspectChecks,\n  expandCases,\n  renderPage,\n  runPageAudits,\n  runNpmAudits,\n  packAuditPackages,\n  renderNpmFixture,\n  writeIndex,\n} from \"../scripts/audit-accessibility.ts\";\nimport type { WorkspacePackages } from \"../../../scripts/release/workspace-packages.ts\";\n\nconst directories: string[] = [];\nconst temp = (): string => {\n  const dir = mkdtempSync(join(tmpdir(), \"pantoken-a11y-\"));\n  directories.push(dir);\n  return dir;\n};\nafterEach(() => {\n  vi.restoreAllMocks();\n  for (const dir of directories.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\nconst entry = (\n  example = '-automatica11y\\n```html\\n<button class=\"pfx-button\">Save</button>\\n```',\n) =>\n  parseCssDocs(\n    `/**\\n * @component button\\n * @example ${example.replaceAll(\"\\n\", \"\\n * \")}\\n */\\n.pfx-button { color: red; }`,\n  );\n\ntest(\"normalizes only prefix class tokens and supports multiple fences and unfenced markup\", () => {\n  expect(\n    exampleHtml(\n      '-automatica11y\\n```html\\n<button class=\"pfx-button\">pfx-text</button>\\n```\\n```html\\n<span>More</span>\\n```',\n    ),\n  ).toBe('<button class=\"instui-button\">pfx-text</button>\\n\\n<span>More</span>');\n  expect(exampleHtml(\"-automatica11y\\n<p>Plain</p>\")).toBe(\"<p>Plain</p>\");\n  expect(() => exampleHtml(\"-automatica11y\\n\")).toThrow(\"Empty audit markup\");\n});\ntest(\"requires unique records, explicit examples, and valid markup\", () => {\n  expect(collectExamples(entry(), [\"button\"])).toEqual([\n    { record: \"button\", index: 0, html: '<button class=\"instui-button\">Save</button>' },\n  ]);\n  expect(() => collectExamples([], [\"button\"])).toThrow(\"found 0\");\n  expect(() => collectExamples([...entry(), ...entry()], [\"button\"])).toThrow(\"found 2\");\n  expect(() => collectExamples(entry(\"<button>Save</button>\"), [\"button\"])).toThrow(\n    \"Missing -automatica11y\",\n  );\n});\ntest(\"expands only four supported theme/scheme cases and loads local production assets\", () => {\n  const cases = expandCases(collectExamples(entry(), [\"button\"]));\n  expect(cases).toHaveLength(4);\n  expect(new Set(cases.map((item) => item.id)).size).toBe(4);\n  expect(cases.map((item) => `${item.theme}:${item.scheme}`)).toEqual([\n    \"rebrand:light\",\n    \"rebrand:dark\",\n    \"canvas:light\",\n    \"canvasHighContrast:light\",\n  ]);\n  const page = renderPage({ ...cases[0]!, html: '<dialog class=\"instui-modal\">Content</dialog>' });\n  expect(page).toContain('data-pantoken-theme=\"rebrand\"');\n  expect(page).toContain('data-pantoken-scheme=\"light\"');\n  for (const asset of [\n    \"scope.css\",\n    \"schemes.css\",\n    \"base.css\",\n    \"components.css\",\n    \"utilities.css\",\n    \"icons.css\",\n    \"fonts.css\",\n    \"modal.iife.js\",\n  ])\n    expect(page).toContain(asset);\n  expect(page).not.toContain(\"https://\");\n  expect(page).not.toContain(\"../assets\");\n  expect(page).toContain('href=\"assets/tokens/scope.css\"');\n  expect(page).toContain('src=\"assets/interactions/modal.iife.js\"');\n  expect(page).toContain(\"dialog.showModal()\");\n  expect(page).toContain(\"popover.showPopover()\");\n  expect(page).toContain(\"details.open = true\");\n  expect(page).toContain('document.querySelector(\".instui-tooltip [data-a11y-trigger]\")?.focus()');\n  expect(page).toContain('[role=\"treeitem\"][aria-expanded=\"false\"]');\n  expect(page).toContain('row.querySelector(\".item\")?.click()');\n  expect(page).toContain(\n    \".instui-form-field[data-native-validation] input[data-a11y-trigger][required]\",\n  );\n  expect(page).toContain(\"control.checkValidity()\");\n  expect(behaviorNames('<div class=\"instui-tabs\"></div>')).toEqual([\"tabs\"]);\n  expect(behaviorNames('<div class=\"instui-tree-browser\" role=\"tree\"></div>')).toEqual([\n    \"tree-browser\",\n  ]);\n  expect(behaviorNames('<label class=\"instui-form-field\" data-native-validation></label>')).toEqual(\n    [\"form-field\"],\n  );\n  expect(behaviorNames('<div class=\"instui-menu\" data-menu-navigation></div>')).toEqual([\"menu\"]);\n  expect(behaviorNames(\"<p>instui-tabs</p>\")).toEqual([]);\n});\ntest(\"checks exact completed coverage without interpreting violations as failures\", () => {\n  expect(\n    completedTargets({ targets: [{ id: \"button\", status: \"ran\", violations: 9 }] }, [\"button\"]),\n  ).toEqual([\"button\"]);\n  for (const invalid of [\n    null,\n    {},\n    { targets: [null] },\n    { targets: [{ id: \"button\", status: \"failed\", reason: \"Missing asset\" }] },\n    { targets: [] },\n    { targets: [{ id: \"extra\", status: \"ran\" }] },\n    {\n      targets: [\n        { id: \"button\", status: \"ran\" },\n        { id: \"button\", status: \"ran\" },\n      ],\n    },\n  ]) {\n    expect(() => completedTargets(invalid, [\"button\"])).toThrow();\n  }\n});\ntest(\"retains original evidence, uses installed CLI, and doesn't add violation fail flags\", async () => {\n  const out = temp();\n  const run = vi.fn((_command: string, args: string[]) => {\n    const dir = args[args.indexOf(\"--out\") + 1]!;\n    mkdirSync(dir, { recursive: true });\n    writeFileSync(join(dir, \"report.md\"), \"Original report\");\n    writeFileSync(\n      join(dir, \"results.json\"),\n      JSON.stringify({ targets: [{ id: \"button\", status: \"ran\" }] }),\n    );\n  });\n  expect(\n    await auditInvocation(out, \"sample\", [\"button=/case.html\"], [\"--tiers\", \"rules\"], run),\n  ).toEqual({\n    directory: \"sample\",\n    expected: [\"button\"],\n    completed: [\"button\"],\n    gaps: 0,\n    coverage: { notices: [\"button: no executable configurations\"], configurations: [] },\n  });\n  expect(run.mock.calls[0]![0]).toBe(process.execPath);\n  expect(run.mock.calls[0]![1]).toContain(\"audit\");\n  expect(run.mock.calls[0]![1].join(\" \")).not.toContain(\"--fail\");\n  expect(readFileSync(join(out, \"sample/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"makes subprocess and missing-report errors visible, including multi-target invocations\", async () => {\n  const out = temp();\n  vi.spyOn(console, \"error\").mockImplementation(() => {});\n  const run = vi.fn(() => {\n    throw new Error(\"Browser unavailable\");\n  });\n  const result = await auditInvocation(out, \"broken\", [\"a=/a.html\", \"b=/b.html\"], [], run);\n  expect(result.error).toBe(\"Browser unavailable\");\n  expect(result.completed).toEqual([]);\n  expect(run.mock.calls[0]).toBeDefined();\n  expect((await auditInvocation(out, \"missing\", [\"a=/a.html\"], [], () => {})).error).toContain(\n    \"ENOENT\",\n  );\n  expect(console.error).toHaveBeenCalled();\n});\ntest(\"executes without a shell and rejects failed or missing subprocesses\", () => {\n  execute(process.execPath, [\"-e\", \"\"], temp());\n  expect(() => execute(process.execPath, [\"-e\", \"process.exit(3)\"], temp())).toThrow(\"exited 3\");\n  expect(() => execute(join(temp(), \"does-not-exist\"), [])).toThrow();\n});\ntest(\"writes a coverage index with separate errors and the automated-coverage caveat\", async () => {\n  const out = temp();\n  writeIndex(\n    out,\n    [{ directory: \"sample\", expected: [\"a\"], completed: [], error: \"missing | target\" }],\n    [],\n  );\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"0 / 1\");\n  expect(markdown).toContain(\"missing \\\\| target\");\n  expect(markdown).toContain(\n    \"These automated results do not establish that the page meets WCAG; manual review is still needed.\",\n  );\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].error).toBe(\n    \"missing | target\",\n  );\n  await expect(runPageAudits(\"not-a-component\")).rejects.toThrow(\"Unknown record\");\n});\n\ntest.each([\"success\", \"setup failure\", \"audit failure\"])(\n  \"orchestrates retained page evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const path of [\n      \"formats/components/dist\",\n      \"formats/components/assets\",\n      \"formats/css/dist\",\n      \"formats/interactions/dist\",\n      \"plugins/pantoken/custom-components/dist\",\n    ]) {\n      mkdirSync(join(root, path), { recursive: true });\n    }\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    vi.spyOn(console, \"log\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (outcome === \"setup failure\" && args.includes(\"doctor\"))\n        throw new Error(\"Missing browser\");\n      const index = args.indexOf(\"--out\");\n      if (index < 0) return;\n      if (outcome === \"audit failure\") throw new Error(\"Target failed\");\n      const directory = args[index + 1]!;\n      const targets = args\n        .slice(2, args.indexOf(\"--wcag\"))\n        .map((target) => ({ id: target.split(\"=\")[0], status: \"ran\" }));\n      mkdirSync(directory, { recursive: true });\n      writeFileSync(join(directory, \"report.md\"), \"Original\");\n      writeFileSync(join(directory, \"results.json\"), JSON.stringify({ targets }));\n    });\n    if (outcome === \"success\")\n      expect(await runPageAudits(\"button\", run, root)).toContain(\"a11y-report\");\n    else\n      await expect(runPageAudits(\"button\", run, root)).rejects.toThrow(\n        \"Incomplete accessibility audit\",\n      );\n    const output = join(root, \"a11y-report\", readdirSync(join(root, \"a11y-report\"))[0]!);\n    const coverage = JSON.parse(readFileSync(join(output, \"coverage.json\"), \"utf8\"));\n    expect(coverage.cases).toHaveLength(4);\n    expect(readdirSync(join(output, \"pages\", \"assets\"))).toEqual([\n      \"assets\",\n      \"components\",\n      \"custom-components\",\n      \"interactions\",\n      \"tokens\",\n    ]);\n    if (outcome === \"success\")\n      expect(\n        coverage.evidence.every((item: { completed: string[] }) => item.completed.length === 1),\n      ).toBe(true);\n    else expect(readFileSync(join(output, \"index.md\"), \"utf8\")).toContain(\"Not run\");\n  },\n);\n\nconst workspace = (root: string): WorkspacePackages => {\n  const packages = [\"components\", \"css\", \"interactions\", \"utils\"].map((name) => ({\n    name: `@pantoken/${name}`,\n    path: `formats/${name}`,\n    version: \"1.0.0\",\n    private: false,\n    workspaceDeps: new Set(name === \"utils\" ? [] : [\"@pantoken/utils\"]),\n  }));\n  return { rootDir: root, packages, byName: new Map(packages.map((pkg) => [pkg.name, pkg])) };\n};\ntest(\"packs every local runtime dependency once through the workspace-aware package manager\", () => {\n  const root = temp();\n  const run = vi.fn((_command: string, args: string[]) =>\n    writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\"),\n  );\n  const options = packAuditPackages(root, workspace(root), run);\n  expect(options.filter((option) => option === \"--local-package\")).toHaveLength(4);\n  expect(run.mock.calls).toHaveLength(4);\n  expect(run.mock.calls[0]![0]).toBe(\"vp\");\n  expect(options.join(\" \")).toContain(\"@pantoken/utils=\");\n  const missing = workspace(root);\n  missing.byName.delete(\"@pantoken/utils\");\n  expect(() => packAuditPackages(root, missing, run)).toThrow(\"Missing local audit dependency\");\n});\n\ntest(\"rejects asynchronous subprocess launch and exit failures\", async () => {\n  await executeAsync(process.execPath, [\"-e\", \"\"], temp());\n  await expect(executeAsync(process.execPath, [\"-e\", \"process.exit(4)\"], temp())).rejects.toThrow(\n    \"exited 4\",\n  );\n  await expect(executeAsync(join(temp(), \"missing\"), [])).rejects.toThrow();\n});\n\ntest(\"reports coverage gaps without merging them with failed checks or violations\", () => {\n  expect(\n    inspectChecks({\n      tiers: [\n        { status: \"not-testable\" },\n        { result: \"undetermined\" },\n        { status: \"gap\" },\n        { status: \"skipped\" },\n      ],\n    }),\n  ).toBe(4);\n  expect(inspectChecks({ result: \"fail\", status: \"ran\", violations: [] })).toBe(0);\n  expect(() =>\n    inspectChecks({ engines: { axe: { status: \"failed\", reason: \"Engine error\" } } }),\n  ).toThrow(\"Engine error\");\n  expect(() => inspectChecks({ result: \"error\" })).toThrow(\"Audit check failed\");\n});\n\nconst requestedTiers = [\"rules\", \"interactions\", \"computed\", \"conditions\", \"vsr\"];\nconst dialogResults = () => {\n  const targets = Array.from({ length: 6 }, (_, index) => ({\n    id: `dialog-${index}`,\n    status: \"ran\",\n    archetypes: {\n      dialog: {\n        status: \"ran\",\n        fixture: { source: \"authored\" },\n        configs: [\n          {\n            state: \"closed\",\n            tiers: Object.fromEntries(requestedTiers.map((tier) => [tier, { status: \"ran\" }])),\n          },\n          { state: \"open\", tiers: { rules: { status: \"ran\" }, vsr: { status: \"ran\" } } },\n        ],\n      },\n    },\n    summary: { gaps: [], notTestable: [] },\n  }));\n  const coverage = targets.flatMap(({ id }) =>\n    [\"interactions\", \"computed\", \"conditions\"].map(\n      (tier) => `${id}/dialog/1/${tier}: missing requested tier`,\n    ),\n  );\n  return { targets, outcome: { status: \"passed\", coverage } };\n};\n\ntest(\"retains 18 original supplemental-state notices without double counting derived gaps\", () => {\n  const results = dialogResults();\n  const coverage = collectCoverage(results, requestedTiers);\n  expect(coverage.notices).toEqual(results.outcome.coverage);\n  expect(coverage.configurations).toHaveLength(12);\n  expect(coverage.configurations[1]).toEqual({\n    target: \"dialog-0\",\n    archetype: \"dialog\",\n    index: 1,\n    state: \"open\",\n    tiers: {\n      rules: \"ran\",\n      interactions: \"missing\",\n      computed: \"missing\",\n      conditions: \"missing\",\n      vsr: \"ran\",\n    },\n  });\n  expect(collectCoverage({ targets: results.targets }, requestedTiers)).toEqual(coverage);\n});\n\ntest(\"preserves summary limitations, original notices, and not-testable tier notes separately\", () => {\n  const coverage = collectCoverage(\n    {\n      outcome: { coverage: [\"example: original notice\"] },\n      targets: [\n        {\n          id: \"example\",\n          summary: { gaps: [\"fixture gap\"], notTestable: [\"closed shadow root\"] },\n          archetypes: {\n            page: {\n              configs: [\n                {\n                  state: \"expanded\",\n                  tiers: {\n                    rules: { status: \"not-testable\", reason: \"no DOM\" },\n                    vsr: { status: \"ran\", notTestable: [\"open shadow root\"] },\n                    computed: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n          },\n        },\n      ],\n    },\n    [\"rules\", \"vsr\", \"computed\"],\n  );\n  expect(coverage.notices).toEqual([\n    \"example: original notice\",\n    \"example: fixture gap\",\n    \"example: closed shadow root\",\n    \"example/page/0/rules: no DOM\",\n    \"example/page/0/vsr: open shadow root\",\n  ]);\n  expect(coverage.configurations[0]!.tiers.computed).toBe(\"not-applicable\");\n});\n\ntest(\"reports missing configurations and rejects malformed coverage data\", () => {\n  expect(\n    collectCoverage({ targets: [{ id: \"empty\", archetypes: {} }] }, requestedTiers).notices,\n  ).toEqual([\"empty: no executable configurations\"]);\n  for (const value of [\n    null,\n    {},\n    { outcome: { coverage: \"invalid\" } },\n    { outcome: { coverage: [42] } },\n    { targets: [{ id: 1 }] },\n    { targets: [{ id: \"x\", summary: { gaps: {} } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { status: \"gap\", reason: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [null] } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [{}] } } }] },\n  ])\n    expect(() => collectCoverage(value, requestedTiers)).toThrow(\"Invalid\");\n});\n\ntest(\"keeps skipped, gap, and unreported statuses explicit without treating inapplicable tiers as gaps\", () => {\n  const coverage = collectCoverage(\n    {\n      targets: [\n        {\n          id: \"sample\",\n          archetypes: {\n            dialog: {\n              status: \"gap\",\n              configs: [\n                {\n                  tiers: {\n                    rules: { status: \"skipped\" },\n                    computed: {},\n                    vsr: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n            menu: { status: \"gap\", reason: \"missing fixture\" },\n          },\n        },\n      ],\n    },\n    [],\n  );\n  expect(coverage.notices).toEqual([\n    \"sample/dialog: fixture gap\",\n    \"sample/dialog/0/rules: skipped\",\n    \"sample/dialog/0/computed: missing status\",\n    \"sample/menu: missing fixture\",\n  ]);\n  expect(coverage.configurations[0]!.state).toBe(\"Not reported\");\n});\n\ntest(\"indexes supplemental-state coverage without changing originals or failing advisory findings\", async () => {\n  const out = temp();\n  const original = JSON.stringify(dialogResults());\n  const result = await auditInvocation(\n    out,\n    \"npm-dialog\",\n    dialogResults().targets.map(({ id }) => `${id}=npm:example`),\n    [\"--tiers\", requestedTiers.join(\",\")],\n    (_command, args) => {\n      const directory = args[args.indexOf(\"--out\") + 1]!;\n      mkdirSync(directory);\n      writeFileSync(join(directory, \"report.md\"), \"Original report\");\n      writeFileSync(join(directory, \"results.json\"), original);\n    },\n    \"dialog\",\n  );\n  expect(result.error).toBeUndefined();\n  expect(result.completed).toHaveLength(6);\n  expect(result.gaps).toBe(0);\n  expect(result.coverage?.notices).toHaveLength(18);\n  writeIndex(out, [result], []);\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"Coverage notices\");\n  expect(markdown).toContain(\"| npm-dialog | 6 / 6 | 0 | 18 |\");\n  expect(markdown).toContain(\"dialog-0/dialog/1/interactions: missing requested tier\");\n  expect(markdown).toContain(\"open\");\n  expect(markdown).toContain(\"interactions: missing\");\n  expect(markdown).toContain(\"not unique defects\");\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].coverage).toEqual(\n    result.coverage,\n  );\n  expect(readFileSync(join(out, \"npm-dialog/results.json\"), \"utf8\")).toBe(original);\n  expect(readFileSync(join(out, \"npm-dialog/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"rejects native templates, generated guesses, and npm archetype gaps\", () => {\n  const target = {\n    id: \"sample\",\n    status: \"ran\",\n    archetypes: { button: { status: \"ran\", fixture: { source: \"authored\" } } },\n  };\n  expect(authoredTargets({ targets: [target] }, [\"sample\"], \"button\")).toEqual([\"sample\"]);\n  for (const source of [\"template\", \"generated\", \"none\"]) {\n    expect(() =>\n      authoredTargets(\n        {\n          targets: [{ ...target, archetypes: { button: { status: \"ran\", fixture: { source } } } }],\n        },\n        [\"sample\"],\n        \"button\",\n      ),\n    ).toThrow(\"authored fixture\");\n  }\n  expect(() => authoredTargets({ targets: [target] }, [\"sample\"], \"dialog\")).toThrow(\n    \"authored fixture\",\n  );\n  expect(() => authoredTargets(null, [], \"button\")).toThrow();\n});\ntest(\"inlines only built supplementary styles, local fonts, and production behavior\", () => {\n  const root = temp();\n  for (const folder of [\"tokens\", \"components\", \"assets\", \"interactions\"])\n    mkdirSync(join(root, folder));\n  for (const file of [\n    \"tokens/schemes.css\",\n    \"components/base.css\",\n    \"components/utilities.css\",\n    \"components/icons.css\",\n  ])\n    writeFileSync(join(root, file), \"/* built */\");\n  writeFileSync(join(root, \"assets/font.woff2\"), \"local-font\");\n  writeFileSync(join(root, \"components/fonts.css\"), '@font-face{src:url(\"../assets/font.woff2\")}');\n  writeFileSync(join(root, \"interactions/modal.iife.js\"), \"window.production = true;\");\n  const html = renderNpmFixture(\n    {\n      ...expandCases([\n        { record: \"modal\", index: 0, html: '<dialog class=\"instui-modal\">Details</dialog>' },\n      ])[0]!,\n      scheme: \"dark\",\n    },\n    root,\n  );\n  expect(html).toContain(\"data:font/woff2;base64,\");\n  expect(html).toContain(\"window.production = true\");\n  expect(html).toContain('style.colorScheme = \"dark\"');\n  expect(html).toContain('dataset.pantokenTheme = \"rebrand\"');\n  expect(html).not.toContain(\"https://\");\n  expect(html).not.toContain(\"dialog.showModal()\");\n  expect(html).not.toContain(\"popover.showPopover()\");\n  expect(html).not.toContain(\"details.open = true\");\n});\ntest.each([\"success\", \"pack failure\", \"fixture gap\", \"no archetype\", \"full inventory\"])(\n  \"appends npm evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const folder of [\n      \"pages/assets/tokens\",\n      \"pages/assets/components\",\n      \"pages/assets/interactions\",\n    ])\n      mkdirSync(join(root, folder), { recursive: true });\n    for (const file of [\n      \"tokens/schemes.css\",\n      \"components/base.css\",\n      \"components/utilities.css\",\n      \"components/icons.css\",\n      \"components/fonts.css\",\n    ])\n      writeFileSync(join(root, \"pages\", \"assets\", file), \"/* built */\");\n    for (const name of [\"modal\", \"tabs\", \"tooltip\", \"close-button\", \"form-field\", \"menu\"])\n      writeFileSync(join(root, \"pages\", \"assets\", \"interactions\", `${name}.iife.js`), \"\");\n    writeIndex(root, [], []);\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (args.includes(\"pack\")) {\n        if (outcome === \"pack failure\") throw new Error(\"Pack failed\");\n        writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\");\n        return;\n      }\n      const destination = args[args.indexOf(\"--out\") + 1]!;\n      const archetype = args[args.indexOf(\"--archetypes\") + 1]!;\n      const targets = args.slice(2, args.indexOf(\"--wcag\")).map((spec) => ({\n        id: spec.split(\"=\")[0],\n        status: \"ran\",\n        archetypes: {\n          [archetype]: {\n            status: outcome === \"fixture gap\" ? \"gap\" : \"ran\",\n            fixture: { source: \"authored\" },\n          },\n        },\n      }));\n      const mapping = JSON.parse(readFileSync(args[args.indexOf(\"--mapping\") + 1]!, \"utf8\"));\n      expect(Object.keys(mapping).sort()).toEqual(targets.map((target) => target.id).sort());\n      mkdirSync(destination, { recursive: true });\n      writeFileSync(join(destination, \"report.md\"), \"Original npm report\");\n      writeFileSync(join(destination, \"results.json\"), JSON.stringify({ targets }));\n    });\n    const action = runNpmAudits(\n      root,\n      outcome === \"full inventory\" ? undefined : outcome === \"no archetype\" ? \"text\" : \"button\",\n      run,\n      workspace(root),\n    );\n    if (outcome === \"success\" || outcome === \"no archetype\" || outcome === \"full inventory\")\n      await action;\n    else await expect(action).rejects.toThrow(\"Incomplete npm accessibility audit\");\n    const coverage = JSON.parse(readFileSync(join(root, \"coverage.json\"), \"utf8\"));\n    if (outcome === \"success\") {\n      expect(coverage.evidence[0].completed).toHaveLength(4);\n      const mapping = JSON.parse(readFileSync(join(root, \"mapping-button.json\"), \"utf8\"));\n      expect(Object.keys(mapping)).toHaveLength(4);\n      expect(run.mock.calls.at(-1)![1]).toContain(\"--no-generate\");\n    } else if (outcome === \"full inventory\") {\n      expect(coverage.evidence).toHaveLength(9);\n      expect(\n        coverage.evidence.flatMap((item: { completed: string[] }) => item.completed),\n      ).toHaveLength(36);\n    } else if (outcome === \"no archetype\") expect(run).not.toHaveBeenCalled();\n    else expect(coverage.evidence.some((item: { error?: string }) => item.error)).toBe(true);\n  },\n);\n"}}]},"promptRequest":{"kind":"write","toolCallId":"toolu_015Yd9WXi2WKRkXbP68GEmCd","intention":"Edit file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts b/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\n@@ -236,6 +236,7 @@\n       \"components\",\n       \"custom-components\",\n       \"interactions\",\n+      \"tokens\",\n     ]);\n     if (outcome === \"success\")\n       expect(\n","newFileContents":"import { mkdtempSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, expect, test, vi } from \"vite-plus/test\";\nimport { parseCssDocs } from \"@cssdoc/core\";\nimport {\n  auditInvocation,\n  authoredTargets,\n  behaviorNames,\n  collectExamples,\n  completedTargets,\n  collectCoverage,\n  exampleHtml,\n  execute,\n  executeAsync,\n  inspectChecks,\n  expandCases,\n  renderPage,\n  runPageAudits,\n  runNpmAudits,\n  packAuditPackages,\n  renderNpmFixture,\n  writeIndex,\n} from \"../scripts/audit-accessibility.ts\";\nimport type { WorkspacePackages } from \"../../../scripts/release/workspace-packages.ts\";\n\nconst directories: string[] = [];\nconst temp = (): string => {\n  const dir = mkdtempSync(join(tmpdir(), \"pantoken-a11y-\"));\n  directories.push(dir);\n  return dir;\n};\nafterEach(() => {\n  vi.restoreAllMocks();\n  for (const dir of directories.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\nconst entry = (\n  example = '-automatica11y\\n```html\\n<button class=\"pfx-button\">Save</button>\\n```',\n) =>\n  parseCssDocs(\n    `/**\\n * @component button\\n * @example ${example.replaceAll(\"\\n\", \"\\n * \")}\\n */\\n.pfx-button { color: red; }`,\n  );\n\ntest(\"normalizes only prefix class tokens and supports multiple fences and unfenced markup\", () => {\n  expect(\n    exampleHtml(\n      '-automatica11y\\n```html\\n<button class=\"pfx-button\">pfx-text</button>\\n```\\n```html\\n<span>More</span>\\n```',\n    ),\n  ).toBe('<button class=\"instui-button\">pfx-text</button>\\n\\n<span>More</span>');\n  expect(exampleHtml(\"-automatica11y\\n<p>Plain</p>\")).toBe(\"<p>Plain</p>\");\n  expect(() => exampleHtml(\"-automatica11y\\n\")).toThrow(\"Empty audit markup\");\n});\ntest(\"requires unique records, explicit examples, and valid markup\", () => {\n  expect(collectExamples(entry(), [\"button\"])).toEqual([\n    { record: \"button\", index: 0, html: '<button class=\"instui-button\">Save</button>' },\n  ]);\n  expect(() => collectExamples([], [\"button\"])).toThrow(\"found 0\");\n  expect(() => collectExamples([...entry(), ...entry()], [\"button\"])).toThrow(\"found 2\");\n  expect(() => collectExamples(entry(\"<button>Save</button>\"), [\"button\"])).toThrow(\n    \"Missing -automatica11y\",\n  );\n});\ntest(\"expands only four supported theme/scheme cases and loads local production assets\", () => {\n  const cases = expandCases(collectExamples(entry(), [\"button\"]));\n  expect(cases).toHaveLength(4);\n  expect(new Set(cases.map((item) => item.id)).size).toBe(4);\n  expect(cases.map((item) => `${item.theme}:${item.scheme}`)).toEqual([\n    \"rebrand:light\",\n    \"rebrand:dark\",\n    \"canvas:light\",\n    \"canvasHighContrast:light\",\n  ]);\n  const page = renderPage({ ...cases[0]!, html: '<dialog class=\"instui-modal\">Content</dialog>' });\n  expect(page).toContain('data-pantoken-theme=\"rebrand\"');\n  expect(page).toContain('data-pantoken-scheme=\"light\"');\n  for (const asset of [\n    \"scope.css\",\n    \"schemes.css\",\n    \"base.css\",\n    \"components.css\",\n    \"utilities.css\",\n    \"icons.css\",\n    \"fonts.css\",\n    \"modal.iife.js\",\n  ])\n    expect(page).toContain(asset);\n  expect(page).not.toContain(\"https://\");\n  expect(page).not.toContain(\"../assets\");\n  expect(page).toContain('href=\"assets/tokens/scope.css\"');\n  expect(page).toContain('src=\"assets/interactions/modal.iife.js\"');\n  expect(page).toContain(\"dialog.showModal()\");\n  expect(page).toContain(\"popover.showPopover()\");\n  expect(page).toContain(\"details.open = true\");\n  expect(page).toContain('document.querySelector(\".instui-tooltip [data-a11y-trigger]\")?.focus()');\n  expect(page).toContain('[role=\"treeitem\"][aria-expanded=\"false\"]');\n  expect(page).toContain('row.querySelector(\".item\")?.click()');\n  expect(page).toContain(\n    \".instui-form-field[data-native-validation] input[data-a11y-trigger][required]\",\n  );\n  expect(page).toContain(\"control.checkValidity()\");\n  expect(behaviorNames('<div class=\"instui-tabs\"></div>')).toEqual([\"tabs\"]);\n  expect(behaviorNames('<div class=\"instui-tree-browser\" role=\"tree\"></div>')).toEqual([\n    \"tree-browser\",\n  ]);\n  expect(behaviorNames('<label class=\"instui-form-field\" data-native-validation></label>')).toEqual(\n    [\"form-field\"],\n  );\n  expect(behaviorNames('<div class=\"instui-menu\" data-menu-navigation></div>')).toEqual([\"menu\"]);\n  expect(behaviorNames(\"<p>instui-tabs</p>\")).toEqual([]);\n});\ntest(\"checks exact completed coverage without interpreting violations as failures\", () => {\n  expect(\n    completedTargets({ targets: [{ id: \"button\", status: \"ran\", violations: 9 }] }, [\"button\"]),\n  ).toEqual([\"button\"]);\n  for (const invalid of [\n    null,\n    {},\n    { targets: [null] },\n    { targets: [{ id: \"button\", status: \"failed\", reason: \"Missing asset\" }] },\n    { targets: [] },\n    { targets: [{ id: \"extra\", status: \"ran\" }] },\n    {\n      targets: [\n        { id: \"button\", status: \"ran\" },\n        { id: \"button\", status: \"ran\" },\n      ],\n    },\n  ]) {\n    expect(() => completedTargets(invalid, [\"button\"])).toThrow();\n  }\n});\ntest(\"retains original evidence, uses installed CLI, and doesn't add violation fail flags\", async () => {\n  const out = temp();\n  const run = vi.fn((_command: string, args: string[]) => {\n    const dir = args[args.indexOf(\"--out\") + 1]!;\n    mkdirSync(dir, { recursive: true });\n    writeFileSync(join(dir, \"report.md\"), \"Original report\");\n    writeFileSync(\n      join(dir, \"results.json\"),\n      JSON.stringify({ targets: [{ id: \"button\", status: \"ran\" }] }),\n    );\n  });\n  expect(\n    await auditInvocation(out, \"sample\", [\"button=/case.html\"], [\"--tiers\", \"rules\"], run),\n  ).toEqual({\n    directory: \"sample\",\n    expected: [\"button\"],\n    completed: [\"button\"],\n    gaps: 0,\n    coverage: { notices: [\"button: no executable configurations\"], configurations: [] },\n  });\n  expect(run.mock.calls[0]![0]).toBe(process.execPath);\n  expect(run.mock.calls[0]![1]).toContain(\"audit\");\n  expect(run.mock.calls[0]![1].join(\" \")).not.toContain(\"--fail\");\n  expect(readFileSync(join(out, \"sample/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"makes subprocess and missing-report errors visible, including multi-target invocations\", async () => {\n  const out = temp();\n  vi.spyOn(console, \"error\").mockImplementation(() => {});\n  const run = vi.fn(() => {\n    throw new Error(\"Browser unavailable\");\n  });\n  const result = await auditInvocation(out, \"broken\", [\"a=/a.html\", \"b=/b.html\"], [], run);\n  expect(result.error).toBe(\"Browser unavailable\");\n  expect(result.completed).toEqual([]);\n  expect(run.mock.calls[0]).toBeDefined();\n  expect((await auditInvocation(out, \"missing\", [\"a=/a.html\"], [], () => {})).error).toContain(\n    \"ENOENT\",\n  );\n  expect(console.error).toHaveBeenCalled();\n});\ntest(\"executes without a shell and rejects failed or missing subprocesses\", () => {\n  execute(process.execPath, [\"-e\", \"\"], temp());\n  expect(() => execute(process.execPath, [\"-e\", \"process.exit(3)\"], temp())).toThrow(\"exited 3\");\n  expect(() => execute(join(temp(), \"does-not-exist\"), [])).toThrow();\n});\ntest(\"writes a coverage index with separate errors and the automated-coverage caveat\", async () => {\n  const out = temp();\n  writeIndex(\n    out,\n    [{ directory: \"sample\", expected: [\"a\"], completed: [], error: \"missing | target\" }],\n    [],\n  );\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"0 / 1\");\n  expect(markdown).toContain(\"missing \\\\| target\");\n  expect(markdown).toContain(\n    \"These automated results do not establish that the page meets WCAG; manual review is still needed.\",\n  );\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].error).toBe(\n    \"missing | target\",\n  );\n  await expect(runPageAudits(\"not-a-component\")).rejects.toThrow(\"Unknown record\");\n});\n\ntest.each([\"success\", \"setup failure\", \"audit failure\"])(\n  \"orchestrates retained page evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const path of [\n      \"formats/components/dist\",\n      \"formats/components/assets\",\n      \"formats/css/dist\",\n      \"formats/interactions/dist\",\n      \"plugins/pantoken/custom-components/dist\",\n    ]) {\n      mkdirSync(join(root, path), { recursive: true });\n    }\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    vi.spyOn(console, \"log\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (outcome === \"setup failure\" && args.includes(\"doctor\"))\n        throw new Error(\"Missing browser\");\n      const index = args.indexOf(\"--out\");\n      if (index < 0) return;\n      if (outcome === \"audit failure\") throw new Error(\"Target failed\");\n      const directory = args[index + 1]!;\n      const targets = args\n        .slice(2, args.indexOf(\"--wcag\"))\n        .map((target) => ({ id: target.split(\"=\")[0], status: \"ran\" }));\n      mkdirSync(directory, { recursive: true });\n      writeFileSync(join(directory, \"report.md\"), \"Original\");\n      writeFileSync(join(directory, \"results.json\"), JSON.stringify({ targets }));\n    });\n    if (outcome === \"success\")\n      expect(await runPageAudits(\"button\", run, root)).toContain(\"a11y-report\");\n    else\n      await expect(runPageAudits(\"button\", run, root)).rejects.toThrow(\n        \"Incomplete accessibility audit\",\n      );\n    const output = join(root, \"a11y-report\", readdirSync(join(root, \"a11y-report\"))[0]!);\n    const coverage = JSON.parse(readFileSync(join(output, \"coverage.json\"), \"utf8\"));\n    expect(coverage.cases).toHaveLength(4);\n    expect(readdirSync(join(output, \"pages\", \"assets\"))).toEqual([\n      \"assets\",\n      \"components\",\n      \"custom-components\",\n      \"interactions\",\n      \"tokens\",\n    ]);\n    if (outcome === \"success\")\n      expect(\n        coverage.evidence.every((item: { completed: string[] }) => item.completed.length === 1),\n      ).toBe(true);\n    else expect(readFileSync(join(output, \"index.md\"), \"utf8\")).toContain(\"Not run\");\n  },\n);\n\nconst workspace = (root: string): WorkspacePackages => {\n  const packages = [\"components\", \"css\", \"interactions\", \"utils\"].map((name) => ({\n    name: `@pantoken/${name}`,\n    path: `formats/${name}`,\n    version: \"1.0.0\",\n    private: false,\n    workspaceDeps: new Set(name === \"utils\" ? [] : [\"@pantoken/utils\"]),\n  }));\n  return { rootDir: root, packages, byName: new Map(packages.map((pkg) => [pkg.name, pkg])) };\n};\ntest(\"packs every local runtime dependency once through the workspace-aware package manager\", () => {\n  const root = temp();\n  const run = vi.fn((_command: string, args: string[]) =>\n    writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\"),\n  );\n  const options = packAuditPackages(root, workspace(root), run);\n  expect(options.filter((option) => option === \"--local-package\")).toHaveLength(4);\n  expect(run.mock.calls).toHaveLength(4);\n  expect(run.mock.calls[0]![0]).toBe(\"vp\");\n  expect(options.join(\" \")).toContain(\"@pantoken/utils=\");\n  const missing = workspace(root);\n  missing.byName.delete(\"@pantoken/utils\");\n  expect(() => packAuditPackages(root, missing, run)).toThrow(\"Missing local audit dependency\");\n});\n\ntest(\"rejects asynchronous subprocess launch and exit failures\", async () => {\n  await executeAsync(process.execPath, [\"-e\", \"\"], temp());\n  await expect(executeAsync(process.execPath, [\"-e\", \"process.exit(4)\"], temp())).rejects.toThrow(\n    \"exited 4\",\n  );\n  await expect(executeAsync(join(temp(), \"missing\"), [])).rejects.toThrow();\n});\n\ntest(\"reports coverage gaps without merging them with failed checks or violations\", () => {\n  expect(\n    inspectChecks({\n      tiers: [\n        { status: \"not-testable\" },\n        { result: \"undetermined\" },\n        { status: \"gap\" },\n        { status: \"skipped\" },\n      ],\n    }),\n  ).toBe(4);\n  expect(inspectChecks({ result: \"fail\", status: \"ran\", violations: [] })).toBe(0);\n  expect(() =>\n    inspectChecks({ engines: { axe: { status: \"failed\", reason: \"Engine error\" } } }),\n  ).toThrow(\"Engine error\");\n  expect(() => inspectChecks({ result: \"error\" })).toThrow(\"Audit check failed\");\n});\n\nconst requestedTiers = [\"rules\", \"interactions\", \"computed\", \"conditions\", \"vsr\"];\nconst dialogResults = () => {\n  const targets = Array.from({ length: 6 }, (_, index) => ({\n    id: `dialog-${index}`,\n    status: \"ran\",\n    archetypes: {\n      dialog: {\n        status: \"ran\",\n        fixture: { source: \"authored\" },\n        configs: [\n          {\n            state: \"closed\",\n            tiers: Object.fromEntries(requestedTiers.map((tier) => [tier, { status: \"ran\" }])),\n          },\n          { state: \"open\", tiers: { rules: { status: \"ran\" }, vsr: { status: \"ran\" } } },\n        ],\n      },\n    },\n    summary: { gaps: [], notTestable: [] },\n  }));\n  const coverage = targets.flatMap(({ id }) =>\n    [\"interactions\", \"computed\", \"conditions\"].map(\n      (tier) => `${id}/dialog/1/${tier}: missing requested tier`,\n    ),\n  );\n  return { targets, outcome: { status: \"passed\", coverage } };\n};\n\ntest(\"retains 18 original supplemental-state notices without double counting derived gaps\", () => {\n  const results = dialogResults();\n  const coverage = collectCoverage(results, requestedTiers);\n  expect(coverage.notices).toEqual(results.outcome.coverage);\n  expect(coverage.configurations).toHaveLength(12);\n  expect(coverage.configurations[1]).toEqual({\n    target: \"dialog-0\",\n    archetype: \"dialog\",\n    index: 1,\n    state: \"open\",\n    tiers: {\n      rules: \"ran\",\n      interactions: \"missing\",\n      computed: \"missing\",\n      conditions: \"missing\",\n      vsr: \"ran\",\n    },\n  });\n  expect(collectCoverage({ targets: results.targets }, requestedTiers)).toEqual(coverage);\n});\n\ntest(\"preserves summary limitations, original notices, and not-testable tier notes separately\", () => {\n  const coverage = collectCoverage(\n    {\n      outcome: { coverage: [\"example: original notice\"] },\n      targets: [\n        {\n          id: \"example\",\n          summary: { gaps: [\"fixture gap\"], notTestable: [\"closed shadow root\"] },\n          archetypes: {\n            page: {\n              configs: [\n                {\n                  state: \"expanded\",\n                  tiers: {\n                    rules: { status: \"not-testable\", reason: \"no DOM\" },\n                    vsr: { status: \"ran\", notTestable: [\"open shadow root\"] },\n                    computed: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n          },\n        },\n      ],\n    },\n    [\"rules\", \"vsr\", \"computed\"],\n  );\n  expect(coverage.notices).toEqual([\n    \"example: original notice\",\n    \"example: fixture gap\",\n    \"example: closed shadow root\",\n    \"example/page/0/rules: no DOM\",\n    \"example/page/0/vsr: open shadow root\",\n  ]);\n  expect(coverage.configurations[0]!.tiers.computed).toBe(\"not-applicable\");\n});\n\ntest(\"reports missing configurations and rejects malformed coverage data\", () => {\n  expect(\n    collectCoverage({ targets: [{ id: \"empty\", archetypes: {} }] }, requestedTiers).notices,\n  ).toEqual([\"empty: no executable configurations\"]);\n  for (const value of [\n    null,\n    {},\n    { outcome: { coverage: \"invalid\" } },\n    { outcome: { coverage: [42] } },\n    { targets: [{ id: 1 }] },\n    { targets: [{ id: \"x\", summary: { gaps: {} } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { status: \"gap\", reason: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [null] } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [{}] } } }] },\n  ])\n    expect(() => collectCoverage(value, requestedTiers)).toThrow(\"Invalid\");\n});\n\ntest(\"keeps skipped, gap, and unreported statuses explicit without treating inapplicable tiers as gaps\", () => {\n  const coverage = collectCoverage(\n    {\n      targets: [\n        {\n          id: \"sample\",\n          archetypes: {\n            dialog: {\n              status: \"gap\",\n              configs: [\n                {\n                  tiers: {\n                    rules: { status: \"skipped\" },\n                    computed: {},\n                    vsr: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n            menu: { status: \"gap\", reason: \"missing fixture\" },\n          },\n        },\n      ],\n    },\n    [],\n  );\n  expect(coverage.notices).toEqual([\n    \"sample/dialog: fixture gap\",\n    \"sample/dialog/0/rules: skipped\",\n    \"sample/dialog/0/computed: missing status\",\n    \"sample/menu: missing fixture\",\n  ]);\n  expect(coverage.configurations[0]!.state).toBe(\"Not reported\");\n});\n\ntest(\"indexes supplemental-state coverage without changing originals or failing advisory findings\", async () => {\n  const out = temp();\n  const original = JSON.stringify(dialogResults());\n  const result = await auditInvocation(\n    out,\n    \"npm-dialog\",\n    dialogResults().targets.map(({ id }) => `${id}=npm:example`),\n    [\"--tiers\", requestedTiers.join(\",\")],\n    (_command, args) => {\n      const directory = args[args.indexOf(\"--out\") + 1]!;\n      mkdirSync(directory);\n      writeFileSync(join(directory, \"report.md\"), \"Original report\");\n      writeFileSync(join(directory, \"results.json\"), original);\n    },\n    \"dialog\",\n  );\n  expect(result.error).toBeUndefined();\n  expect(result.completed).toHaveLength(6);\n  expect(result.gaps).toBe(0);\n  expect(result.coverage?.notices).toHaveLength(18);\n  writeIndex(out, [result], []);\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"Coverage notices\");\n  expect(markdown).toContain(\"| npm-dialog | 6 / 6 | 0 | 18 |\");\n  expect(markdown).toContain(\"dialog-0/dialog/1/interactions: missing requested tier\");\n  expect(markdown).toContain(\"open\");\n  expect(markdown).toContain(\"interactions: missing\");\n  expect(markdown).toContain(\"not unique defects\");\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].coverage).toEqual(\n    result.coverage,\n  );\n  expect(readFileSync(join(out, \"npm-dialog/results.json\"), \"utf8\")).toBe(original);\n  expect(readFileSync(join(out, \"npm-dialog/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"rejects native templates, generated guesses, and npm archetype gaps\", () => {\n  const target = {\n    id: \"sample\",\n    status: \"ran\",\n    archetypes: { button: { status: \"ran\", fixture: { source: \"authored\" } } },\n  };\n  expect(authoredTargets({ targets: [target] }, [\"sample\"], \"button\")).toEqual([\"sample\"]);\n  for (const source of [\"template\", \"generated\", \"none\"]) {\n    expect(() =>\n      authoredTargets(\n        {\n          targets: [{ ...target, archetypes: { button: { status: \"ran\", fixture: { source } } } }],\n        },\n        [\"sample\"],\n        \"button\",\n      ),\n    ).toThrow(\"authored fixture\");\n  }\n  expect(() => authoredTargets({ targets: [target] }, [\"sample\"], \"dialog\")).toThrow(\n    \"authored fixture\",\n  );\n  expect(() => authoredTargets(null, [], \"button\")).toThrow();\n});\ntest(\"inlines only built supplementary styles, local fonts, and production behavior\", () => {\n  const root = temp();\n  for (const folder of [\"tokens\", \"components\", \"assets\", \"interactions\"])\n    mkdirSync(join(root, folder));\n  for (const file of [\n    \"tokens/schemes.css\",\n    \"components/base.css\",\n    \"components/utilities.css\",\n    \"components/icons.css\",\n  ])\n    writeFileSync(join(root, file), \"/* built */\");\n  writeFileSync(join(root, \"assets/font.woff2\"), \"local-font\");\n  writeFileSync(join(root, \"components/fonts.css\"), '@font-face{src:url(\"../assets/font.woff2\")}');\n  writeFileSync(join(root, \"interactions/modal.iife.js\"), \"window.production = true;\");\n  const html = renderNpmFixture(\n    {\n      ...expandCases([\n        { record: \"modal\", index: 0, html: '<dialog class=\"instui-modal\">Details</dialog>' },\n      ])[0]!,\n      scheme: \"dark\",\n    },\n    root,\n  );\n  expect(html).toContain(\"data:font/woff2;base64,\");\n  expect(html).toContain(\"window.production = true\");\n  expect(html).toContain('style.colorScheme = \"dark\"');\n  expect(html).toContain('dataset.pantokenTheme = \"rebrand\"');\n  expect(html).not.toContain(\"https://\");\n  expect(html).not.toContain(\"dialog.showModal()\");\n  expect(html).not.toContain(\"popover.showPopover()\");\n  expect(html).not.toContain(\"details.open = true\");\n});\ntest.each([\"success\", \"pack failure\", \"fixture gap\", \"no archetype\", \"full inventory\"])(\n  \"appends npm evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const folder of [\n      \"pages/assets/tokens\",\n      \"pages/assets/components\",\n      \"pages/assets/interactions\",\n    ])\n      mkdirSync(join(root, folder), { recursive: true });\n    for (const file of [\n      \"tokens/schemes.css\",\n      \"components/base.css\",\n      \"components/utilities.css\",\n      \"components/icons.css\",\n      \"components/fonts.css\",\n    ])\n      writeFileSync(join(root, \"pages\", \"assets\", file), \"/* built */\");\n    for (const name of [\"modal\", \"tabs\", \"tooltip\", \"close-button\", \"form-field\", \"menu\"])\n      writeFileSync(join(root, \"pages\", \"assets\", \"interactions\", `${name}.iife.js`), \"\");\n    writeIndex(root, [], []);\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (args.includes(\"pack\")) {\n        if (outcome === \"pack failure\") throw new Error(\"Pack failed\");\n        writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\");\n        return;\n      }\n      const destination = args[args.indexOf(\"--out\") + 1]!;\n      const archetype = args[args.indexOf(\"--archetypes\") + 1]!;\n      const targets = args.slice(2, args.indexOf(\"--wcag\")).map((spec) => ({\n        id: spec.split(\"=\")[0],\n        status: \"ran\",\n        archetypes: {\n          [archetype]: {\n            status: outcome === \"fixture gap\" ? \"gap\" : \"ran\",\n            fixture: { source: \"authored\" },\n          },\n        },\n      }));\n      const mapping = JSON.parse(readFileSync(args[args.indexOf(\"--mapping\") + 1]!, \"utf8\"));\n      expect(Object.keys(mapping).sort()).toEqual(targets.map((target) => target.id).sort());\n      mkdirSync(destination, { recursive: true });\n      writeFileSync(join(destination, \"report.md\"), \"Original npm report\");\n      writeFileSync(join(destination, \"results.json\"), JSON.stringify({ targets }));\n    });\n    const action = runNpmAudits(\n      root,\n      outcome === \"full inventory\" ? undefined : outcome === \"no archetype\" ? \"text\" : \"button\",\n      run,\n      workspace(root),\n    );\n    if (outcome === \"success\" || outcome === \"no archetype\" || outcome === \"full inventory\")\n      await action;\n    else await expect(action).rejects.toThrow(\"Incomplete npm accessibility audit\");\n    const coverage = JSON.parse(readFileSync(join(root, \"coverage.json\"), \"utf8\"));\n    if (outcome === \"success\") {\n      expect(coverage.evidence[0].completed).toHaveLength(4);\n      const mapping = JSON.parse(readFileSync(join(root, \"mapping-button.json\"), \"utf8\"));\n      expect(Object.keys(mapping)).toHaveLength(4);\n      expect(run.mock.calls.at(-1)![1]).toContain(\"--no-generate\");\n    } else if (outcome === \"full inventory\") {\n      expect(coverage.evidence).toHaveLength(9);\n      expect(\n        coverage.evidence.flatMap((item: { completed: string[] }) => item.completed),\n      ).toHaveLength(36);\n    } else if (outcome === \"no archetype\") expect(run).not.toHaveBeenCalled();\n    else expect(coverage.evidence.some((item: { error?: string }) => item.error)).toBe(true);\n  },\n);\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts","content":"import { mkdtempSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, expect, test, vi } from \"vite-plus/test\";\nimport { parseCssDocs } from \"@cssdoc/core\";\nimport {\n  auditInvocation,\n  authoredTargets,\n  behaviorNames,\n  collectExamples,\n  completedTargets,\n  collectCoverage,\n  exampleHtml,\n  execute,\n  executeAsync,\n  inspectChecks,\n  expandCases,\n  renderPage,\n  runPageAudits,\n  runNpmAudits,\n  packAuditPackages,\n  renderNpmFixture,\n  writeIndex,\n} from \"../scripts/audit-accessibility.ts\";\nimport type { WorkspacePackages } from \"../../../scripts/release/workspace-packages.ts\";\n\nconst directories: string[] = [];\nconst temp = (): string => {\n  const dir = mkdtempSync(join(tmpdir(), \"pantoken-a11y-\"));\n  directories.push(dir);\n  return dir;\n};\nafterEach(() => {\n  vi.restoreAllMocks();\n  for (const dir of directories.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\nconst entry = (\n  example = '-automatica11y\\n```html\\n<button class=\"pfx-button\">Save</button>\\n```',\n) =>\n  parseCssDocs(\n    `/**\\n * @component button\\n * @example ${example.replaceAll(\"\\n\", \"\\n * \")}\\n */\\n.pfx-button { color: red; }`,\n  );\n\ntest(\"normalizes only prefix class tokens and supports multiple fences and unfenced markup\", () => {\n  expect(\n    exampleHtml(\n      '-automatica11y\\n```html\\n<button class=\"pfx-button\">pfx-text</button>\\n```\\n```html\\n<span>More</span>\\n```',\n    ),\n  ).toBe('<button class=\"instui-button\">pfx-text</button>\\n\\n<span>More</span>');\n  expect(exampleHtml(\"-automatica11y\\n<p>Plain</p>\")).toBe(\"<p>Plain</p>\");\n  expect(() => exampleHtml(\"-automatica11y\\n\")).toThrow(\"Empty audit markup\");\n});\ntest(\"requires unique records, explicit examples, and valid markup\", () => {\n  expect(collectExamples(entry(), [\"button\"])).toEqual([\n    { record: \"button\", index: 0, html: '<button class=\"instui-button\">Save</button>' },\n  ]);\n  expect(() => collectExamples([], [\"button\"])).toThrow(\"found 0\");\n  expect(() => collectExamples([...entry(), ...entry()], [\"button\"])).toThrow(\"found 2\");\n  expect(() => collectExamples(entry(\"<button>Save</button>\"), [\"button\"])).toThrow(\n    \"Missing -automatica11y\",\n  );\n});\ntest(\"expands only four supported theme/scheme cases and loads local production assets\", () => {\n  const cases = expandCases(collectExamples(entry(), [\"button\"]));\n  expect(cases).toHaveLength(4);\n  expect(new Set(cases.map((item) => item.id)).size).toBe(4);\n  expect(cases.map((item) => `${item.theme}:${item.scheme}`)).toEqual([\n    \"rebrand:light\",\n    \"rebrand:dark\",\n    \"canvas:light\",\n    \"canvasHighContrast:light\",\n  ]);\n  const page = renderPage({ ...cases[0]!, html: '<dialog class=\"instui-modal\">Content</dialog>' });\n  expect(page).toContain('data-pantoken-theme=\"rebrand\"');\n  expect(page).toContain('data-pantoken-scheme=\"light\"');\n  for (const asset of [\n    \"scope.css\",\n    \"schemes.css\",\n    \"base.css\",\n    \"components.css\",\n    \"utilities.css\",\n    \"icons.css\",\n    \"fonts.css\",\n    \"modal.iife.js\",\n  ])\n    expect(page).toContain(asset);\n  expect(page).not.toContain(\"https://\");\n  expect(page).not.toContain(\"../assets\");\n  expect(page).toContain('href=\"assets/tokens/scope.css\"');\n  expect(page).toContain('src=\"assets/interactions/modal.iife.js\"');\n  expect(page).toContain(\"dialog.showModal()\");\n  expect(page).toContain(\"popover.showPopover()\");\n  expect(page).toContain(\"details.open = true\");\n  expect(page).toContain('document.querySelector(\".instui-tooltip [data-a11y-trigger]\")?.focus()');\n  expect(page).toContain('[role=\"treeitem\"][aria-expanded=\"false\"]');\n  expect(page).toContain('row.querySelector(\".item\")?.click()');\n  expect(page).toContain(\n    \".instui-form-field[data-native-validation] input[data-a11y-trigger][required]\",\n  );\n  expect(page).toContain(\"control.checkValidity()\");\n  expect(behaviorNames('<div class=\"instui-tabs\"></div>')).toEqual([\"tabs\"]);\n  expect(behaviorNames('<div class=\"instui-tree-browser\" role=\"tree\"></div>')).toEqual([\n    \"tree-browser\",\n  ]);\n  expect(behaviorNames('<label class=\"instui-form-field\" data-native-validation></label>')).toEqual(\n    [\"form-field\"],\n  );\n  expect(behaviorNames('<div class=\"instui-menu\" data-menu-navigation></div>')).toEqual([\"menu\"]);\n  expect(behaviorNames(\"<p>instui-tabs</p>\")).toEqual([]);\n});\ntest(\"checks exact completed coverage without interpreting violations as failures\", () => {\n  expect(\n    completedTargets({ targets: [{ id: \"button\", status: \"ran\", violations: 9 }] }, [\"button\"]),\n  ).toEqual([\"button\"]);\n  for (const invalid of [\n    null,\n    {},\n    { targets: [null] },\n    { targets: [{ id: \"button\", status: \"failed\", reason: \"Missing asset\" }] },\n    { targets: [] },\n    { targets: [{ id: \"extra\", status: \"ran\" }] },\n    {\n      targets: [\n        { id: \"button\", status: \"ran\" },\n        { id: \"button\", status: \"ran\" },\n      ],\n    },\n  ]) {\n    expect(() => completedTargets(invalid, [\"button\"])).toThrow();\n  }\n});\ntest(\"retains original evidence, uses installed CLI, and doesn't add violation fail flags\", async () => {\n  const out = temp();\n  const run = vi.fn((_command: string, args: string[]) => {\n    const dir = args[args.indexOf(\"--out\") + 1]!;\n    mkdirSync(dir, { recursive: true });\n    writeFileSync(join(dir, \"report.md\"), \"Original report\");\n    writeFileSync(\n      join(dir, \"results.json\"),\n      JSON.stringify({ targets: [{ id: \"button\", status: \"ran\" }] }),\n    );\n  });\n  expect(\n    await auditInvocation(out, \"sample\", [\"button=/case.html\"], [\"--tiers\", \"rules\"], run),\n  ).toEqual({\n    directory: \"sample\",\n    expected: [\"button\"],\n    completed: [\"button\"],\n    gaps: 0,\n    coverage: { notices: [\"button: no executable configurations\"], configurations: [] },\n  });\n  expect(run.mock.calls[0]![0]).toBe(process.execPath);\n  expect(run.mock.calls[0]![1]).toContain(\"audit\");\n  expect(run.mock.calls[0]![1].join(\" \")).not.toContain(\"--fail\");\n  expect(readFileSync(join(out, \"sample/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"makes subprocess and missing-report errors visible, including multi-target invocations\", async () => {\n  const out = temp();\n  vi.spyOn(console, \"error\").mockImplementation(() => {});\n  const run = vi.fn(() => {\n    throw new Error(\"Browser unavailable\");\n  });\n  const result = await auditInvocation(out, \"broken\", [\"a=/a.html\", \"b=/b.html\"], [], run);\n  expect(result.error).toBe(\"Browser unavailable\");\n  expect(result.completed).toEqual([]);\n  expect(run.mock.calls[0]).toBeDefined();\n  expect((await auditInvocation(out, \"missing\", [\"a=/a.html\"], [], () => {})).error).toContain(\n    \"ENOENT\",\n  );\n  expect(console.error).toHaveBeenCalled();\n});\ntest(\"executes without a shell and rejects failed or missing subprocesses\", () => {\n  execute(process.execPath, [\"-e\", \"\"], temp());\n  expect(() => execute(process.execPath, [\"-e\", \"process.exit(3)\"], temp())).toThrow(\"exited 3\");\n  expect(() => execute(join(temp(), \"does-not-exist\"), [])).toThrow();\n});\ntest(\"writes a coverage index with separate errors and the automated-coverage caveat\", async () => {\n  const out = temp();\n  writeIndex(\n    out,\n    [{ directory: \"sample\", expected: [\"a\"], completed: [], error: \"missing | target\" }],\n    [],\n  );\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"0 / 1\");\n  expect(markdown).toContain(\"missing \\\\| target\");\n  expect(markdown).toContain(\n    \"These automated results do not establish that the page meets WCAG; manual review is still needed.\",\n  );\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].error).toBe(\n    \"missing | target\",\n  );\n  await expect(runPageAudits(\"not-a-component\")).rejects.toThrow(\"Unknown record\");\n});\n\ntest.each([\"success\", \"setup failure\", \"audit failure\"])(\n  \"orchestrates retained page evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const path of [\n      \"formats/components/dist\",\n      \"formats/components/assets\",\n      \"formats/css/dist\",\n      \"formats/interactions/dist\",\n      \"plugins/pantoken/custom-components/dist\",\n    ]) {\n      mkdirSync(join(root, path), { recursive: true });\n    }\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    vi.spyOn(console, \"log\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (outcome === \"setup failure\" && args.includes(\"doctor\"))\n        throw new Error(\"Missing browser\");\n      const index = args.indexOf(\"--out\");\n      if (index < 0) return;\n      if (outcome === \"audit failure\") throw new Error(\"Target failed\");\n      const directory = args[index + 1]!;\n      const targets = args\n        .slice(2, args.indexOf(\"--wcag\"))\n        .map((target) => ({ id: target.split(\"=\")[0], status: \"ran\" }));\n      mkdirSync(directory, { recursive: true });\n      writeFileSync(join(directory, \"report.md\"), \"Original\");\n      writeFileSync(join(directory, \"results.json\"), JSON.stringify({ targets }));\n    });\n    if (outcome === \"success\")\n      expect(await runPageAudits(\"button\", run, root)).toContain(\"a11y-report\");\n    else\n      await expect(runPageAudits(\"button\", run, root)).rejects.toThrow(\n        \"Incomplete accessibility audit\",\n      );\n    const output = join(root, \"a11y-report\", readdirSync(join(root, \"a11y-report\"))[0]!);\n    const coverage = JSON.parse(readFileSync(join(output, \"coverage.json\"), \"utf8\"));\n    expect(coverage.cases).toHaveLength(4);\n    expect(readdirSync(join(output, \"pages\", \"assets\"))).toEqual([\n      \"assets\",\n      \"components\",\n      \"custom-components\",\n      \"interactions\",\n    ]);\n    if (outcome === \"success\")\n      expect(\n        coverage.evidence.every((item: { completed: string[] }) => item.completed.length === 1),\n      ).toBe(true);\n    else expect(readFileSync(join(output, \"index.md\"), \"utf8\")).toContain(\"Not run\");\n  },\n);\n\nconst workspace = (root: string): WorkspacePackages => {\n  const packages = [\"components\", \"css\", \"interactions\", \"utils\"].map((name) => ({\n    name: `@pantoken/${name}`,\n    path: `formats/${name}`,\n    version: \"1.0.0\",\n    private: false,\n    workspaceDeps: new Set(name === \"utils\" ? [] : [\"@pantoken/utils\"]),\n  }));\n  return { rootDir: root, packages, byName: new Map(packages.map((pkg) => [pkg.name, pkg])) };\n};\ntest(\"packs every local runtime dependency once through the workspace-aware package manager\", () => {\n  const root = temp();\n  const run = vi.fn((_command: string, args: string[]) =>\n    writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\"),\n  );\n  const options = packAuditPackages(root, workspace(root), run);\n  expect(options.filter((option) => option === \"--local-package\")).toHaveLength(4);\n  expect(run.mock.calls).toHaveLength(4);\n  expect(run.mock.calls[0]![0]).toBe(\"vp\");\n  expect(options.join(\" \")).toContain(\"@pantoken/utils=\");\n  const missing = workspace(root);\n  missing.byName.delete(\"@pantoken/utils\");\n  expect(() => packAuditPackages(root, missing, run)).toThrow(\"Missing local audit dependency\");\n});\n\ntest(\"rejects asynchronous subprocess launch and exit failures\", async () => {\n  await executeAsync(process.execPath, [\"-e\", \"\"], temp());\n  await expect(executeAsync(process.execPath, [\"-e\", \"process.exit(4)\"], temp())).rejects.toThrow(\n    \"exited 4\",\n  );\n  await expect(executeAsync(join(temp(), \"missing\"), [])).rejects.toThrow();\n});\n\ntest(\"reports coverage gaps without merging them with failed checks or violations\", () => {\n  expect(\n    inspectChecks({\n      tiers: [\n        { status: \"not-testable\" },\n        { result: \"undetermined\" },\n        { status: \"gap\" },\n        { status: \"skipped\" },\n      ],\n    }),\n  ).toBe(4);\n  expect(inspectChecks({ result: \"fail\", status: \"ran\", violations: [] })).toBe(0);\n  expect(() =>\n    inspectChecks({ engines: { axe: { status: \"failed\", reason: \"Engine error\" } } }),\n  ).toThrow(\"Engine error\");\n  expect(() => inspectChecks({ result: \"error\" })).toThrow(\"Audit check failed\");\n});\n\nconst requestedTiers = [\"rules\", \"interactions\", \"computed\", \"conditions\", \"vsr\"];\nconst dialogResults = () => {\n  const targets = Array.from({ length: 6 }, (_, index) => ({\n    id: `dialog-${index}`,\n    status: \"ran\",\n    archetypes: {\n      dialog: {\n        status: \"ran\",\n        fixture: { source: \"authored\" },\n        configs: [\n          {\n            state: \"closed\",\n            tiers: Object.fromEntries(requestedTiers.map((tier) => [tier, { status: \"ran\" }])),\n          },\n          { state: \"open\", tiers: { rules: { status: \"ran\" }, vsr: { status: \"ran\" } } },\n        ],\n      },\n    },\n    summary: { gaps: [], notTestable: [] },\n  }));\n  const coverage = targets.flatMap(({ id }) =>\n    [\"interactions\", \"computed\", \"conditions\"].map(\n      (tier) => `${id}/dialog/1/${tier}: missing requested tier`,\n    ),\n  );\n  return { targets, outcome: { status: \"passed\", coverage } };\n};\n\ntest(\"retains 18 original supplemental-state notices without double counting derived gaps\", () => {\n  const results = dialogResults();\n  const coverage = collectCoverage(results, requestedTiers);\n  expect(coverage.notices).toEqual(results.outcome.coverage);\n  expect(coverage.configurations).toHaveLength(12);\n  expect(coverage.configurations[1]).toEqual({\n    target: \"dialog-0\",\n    archetype: \"dialog\",\n    index: 1,\n    state: \"open\",\n    tiers: {\n      rules: \"ran\",\n      interactions: \"missing\",\n      computed: \"missing\",\n      conditions: \"missing\",\n      vsr: \"ran\",\n    },\n  });\n  expect(collectCoverage({ targets: results.targets }, requestedTiers)).toEqual(coverage);\n});\n\ntest(\"preserves summary limitations, original notices, and not-testable tier notes separately\", () => {\n  const coverage = collectCoverage(\n    {\n      outcome: { coverage: [\"example: original notice\"] },\n      targets: [\n        {\n          id: \"example\",\n          summary: { gaps: [\"fixture gap\"], notTestable: [\"closed shadow root\"] },\n          archetypes: {\n            page: {\n              configs: [\n                {\n                  state: \"expanded\",\n                  tiers: {\n                    rules: { status: \"not-testable\", reason: \"no DOM\" },\n                    vsr: { status: \"ran\", notTestable: [\"open shadow root\"] },\n                    computed: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n          },\n        },\n      ],\n    },\n    [\"rules\", \"vsr\", \"computed\"],\n  );\n  expect(coverage.notices).toEqual([\n    \"example: original notice\",\n    \"example: fixture gap\",\n    \"example: closed shadow root\",\n    \"example/page/0/rules: no DOM\",\n    \"example/page/0/vsr: open shadow root\",\n  ]);\n  expect(coverage.configurations[0]!.tiers.computed).toBe(\"not-applicable\");\n});\n\ntest(\"reports missing configurations and rejects malformed coverage data\", () => {\n  expect(\n    collectCoverage({ targets: [{ id: \"empty\", archetypes: {} }] }, requestedTiers).notices,\n  ).toEqual([\"empty: no executable configurations\"]);\n  for (const value of [\n    null,\n    {},\n    { outcome: { coverage: \"invalid\" } },\n    { outcome: { coverage: [42] } },\n    { targets: [{ id: 1 }] },\n    { targets: [{ id: \"x\", summary: { gaps: {} } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { status: \"gap\", reason: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [null] } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [{}] } } }] },\n  ])\n    expect(() => collectCoverage(value, requestedTiers)).toThrow(\"Invalid\");\n});\n\ntest(\"keeps skipped, gap, and unreported statuses explicit without treating inapplicable tiers as gaps\", () => {\n  const coverage = collectCoverage(\n    {\n      targets: [\n        {\n          id: \"sample\",\n          archetypes: {\n            dialog: {\n              status: \"gap\",\n              configs: [\n                {\n                  tiers: {\n                    rules: { status: \"skipped\" },\n                    computed: {},\n                    vsr: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n            menu: { status: \"gap\", reason: \"missing fixture\" },\n          },\n        },\n      ],\n    },\n    [],\n  );\n  expect(coverage.notices).toEqual([\n    \"sample/dialog: fixture gap\",\n    \"sample/dialog/0/rules: skipped\",\n    \"sample/dialog/0/computed: missing status\",\n    \"sample/menu: missing fixture\",\n  ]);\n  expect(coverage.configurations[0]!.state).toBe(\"Not reported\");\n});\n\ntest(\"indexes supplemental-state coverage without changing originals or failing advisory findings\", async () => {\n  const out = temp();\n  const original = JSON.stringify(dialogResults());\n  const result = await auditInvocation(\n    out,\n    \"npm-dialog\",\n    dialogResults().targets.map(({ id }) => `${id}=npm:example`),\n    [\"--tiers\", requestedTiers.join(\",\")],\n    (_command, args) => {\n      const directory = args[args.indexOf(\"--out\") + 1]!;\n      mkdirSync(directory);\n      writeFileSync(join(directory, \"report.md\"), \"Original report\");\n      writeFileSync(join(directory, \"results.json\"), original);\n    },\n    \"dialog\",\n  );\n  expect(result.error).toBeUndefined();\n  expect(result.completed).toHaveLength(6);\n  expect(result.gaps).toBe(0);\n  expect(result.coverage?.notices).toHaveLength(18);\n  writeIndex(out, [result], []);\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"Coverage notices\");\n  expect(markdown).toContain(\"| npm-dialog | 6 / 6 | 0 | 18 |\");\n  expect(markdown).toContain(\"dialog-0/dialog/1/interactions: missing requested tier\");\n  expect(markdown).toContain(\"open\");\n  expect(markdown).toContain(\"interactions: missing\");\n  expect(markdown).toContain(\"not unique defects\");\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].coverage).toEqual(\n    result.coverage,\n  );\n  expect(readFileSync(join(out, \"npm-dialog/results.json\"), \"utf8\")).toBe(original);\n  expect(readFileSync(join(out, \"npm-dialog/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"rejects native templates, generated guesses, and npm archetype gaps\", () => {\n  const target = {\n    id: \"sample\",\n    status: \"ran\",\n    archetypes: { button: { status: \"ran\", fixture: { source: \"authored\" } } },\n  };\n  expect(authoredTargets({ targets: [target] }, [\"sample\"], \"button\")).toEqual([\"sample\"]);\n  for (const source of [\"template\", \"generated\", \"none\"]) {\n    expect(() =>\n      authoredTargets(\n        {\n          targets: [{ ...target, archetypes: { button: { status: \"ran\", fixture: { source } } } }],\n        },\n        [\"sample\"],\n        \"button\",\n      ),\n    ).toThrow(\"authored fixture\");\n  }\n  expect(() => authoredTargets({ targets: [target] }, [\"sample\"], \"dialog\")).toThrow(\n    \"authored fixture\",\n  );\n  expect(() => authoredTargets(null, [], \"button\")).toThrow();\n});\ntest(\"inlines only built supplementary styles, local fonts, and production behavior\", () => {\n  const root = temp();\n  for (const folder of [\"tokens\", \"components\", \"assets\", \"interactions\"])\n    mkdirSync(join(root, folder));\n  for (const file of [\n    \"tokens/schemes.css\",\n    \"components/base.css\",\n    \"components/utilities.css\",\n    \"components/icons.css\",\n  ])\n    writeFileSync(join(root, file), \"/* built */\");\n  writeFileSync(join(root, \"assets/font.woff2\"), \"local-font\");\n  writeFileSync(join(root, \"components/fonts.css\"), '@font-face{src:url(\"../assets/font.woff2\")}');\n  writeFileSync(join(root, \"interactions/modal.iife.js\"), \"window.production = true;\");\n  const html = renderNpmFixture(\n    {\n      ...expandCases([\n        { record: \"modal\", index: 0, html: '<dialog class=\"instui-modal\">Details</dialog>' },\n      ])[0]!,\n      scheme: \"dark\",\n    },\n    root,\n  );\n  expect(html).toContain(\"data:font/woff2;base64,\");\n  expect(html).toContain(\"window.production = true\");\n  expect(html).toContain('style.colorScheme = \"dark\"');\n  expect(html).toContain('dataset.pantokenTheme = \"rebrand\"');\n  expect(html).not.toContain(\"https://\");\n  expect(html).not.toContain(\"dialog.showModal()\");\n  expect(html).not.toContain(\"popover.showPopover()\");\n  expect(html).not.toContain(\"details.open = true\");\n});\ntest.each([\"success\", \"pack failure\", \"fixture gap\", \"no archetype\", \"full inventory\"])(\n  \"appends npm evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const folder of [\n      \"pages/assets/tokens\",\n      \"pages/assets/components\",\n      \"pages/assets/interactions\",\n    ])\n      mkdirSync(join(root, folder), { recursive: true });\n    for (const file of [\n      \"tokens/schemes.css\",\n      \"components/base.css\",\n      \"components/utilities.css\",\n      \"components/icons.css\",\n      \"components/fonts.css\",\n    ])\n      writeFileSync(join(root, \"pages\", \"assets\", file), \"/* built */\");\n    for (const name of [\"modal\", \"tabs\", \"tooltip\", \"close-button\", \"form-field\", \"menu\"])\n      writeFileSync(join(root, \"pages\", \"assets\", \"interactions\", `${name}.iife.js`), \"\");\n    writeIndex(root, [], []);\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (args.includes(\"pack\")) {\n        if (outcome === \"pack failure\") throw new Error(\"Pack failed\");\n        writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\");\n        return;\n      }\n      const destination = args[args.indexOf(\"--out\") + 1]!;\n      const archetype = args[args.indexOf(\"--archetypes\") + 1]!;\n      const targets = args.slice(2, args.indexOf(\"--wcag\")).map((spec) => ({\n        id: spec.split(\"=\")[0],\n        status: \"ran\",\n        archetypes: {\n          [archetype]: {\n            status: outcome === \"fixture gap\" ? \"gap\" : \"ran\",\n            fixture: { source: \"authored\" },\n          },\n        },\n      }));\n      const mapping = JSON.parse(readFileSync(args[args.indexOf(\"--mapping\") + 1]!, \"utf8\"));\n      expect(Object.keys(mapping).sort()).toEqual(targets.map((target) => target.id).sort());\n      mkdirSync(destination, { recursive: true });\n      writeFileSync(join(destination, \"report.md\"), \"Original npm report\");\n      writeFileSync(join(destination, \"results.json\"), JSON.stringify({ targets }));\n    });\n    const action = runNpmAudits(\n      root,\n      outcome === \"full inventory\" ? undefined : outcome === \"no archetype\" ? \"text\" : \"button\",\n      run,\n      workspace(root),\n    );\n    if (outcome === \"success\" || outcome === \"no archetype\" || outcome === \"full inventory\")\n      await action;\n    else await expect(action).rejects.toThrow(\"Incomplete npm accessibility audit\");\n    const coverage = JSON.parse(readFileSync(join(root, \"coverage.json\"), \"utf8\"));\n    if (outcome === \"success\") {\n      expect(coverage.evidence[0].completed).toHaveLength(4);\n      const mapping = JSON.parse(readFileSync(join(root, \"mapping-button.json\"), \"utf8\"));\n      expect(Object.keys(mapping)).toHaveLength(4);\n      expect(run.mock.calls.at(-1)![1]).toContain(\"--no-generate\");\n    } else if (outcome === \"full inventory\") {\n      expect(coverage.evidence).toHaveLength(9);\n      expect(\n        coverage.evidence.flatMap((item: { completed: string[] }) => item.completed),\n      ).toHaveLength(36);\n    } else if (outcome === \"no archetype\") expect(run).not.toHaveBeenCalled();\n    else expect(coverage.evidence.some((item: { error?: string }) => item.error)).toBe(true);\n  },\n);\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts","content":"import { mkdtempSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { afterEach, expect, test, vi } from \"vite-plus/test\";\nimport { parseCssDocs } from \"@cssdoc/core\";\nimport {\n  auditInvocation,\n  authoredTargets,\n  behaviorNames,\n  collectExamples,\n  completedTargets,\n  collectCoverage,\n  exampleHtml,\n  execute,\n  executeAsync,\n  inspectChecks,\n  expandCases,\n  renderPage,\n  runPageAudits,\n  runNpmAudits,\n  packAuditPackages,\n  renderNpmFixture,\n  writeIndex,\n} from \"../scripts/audit-accessibility.ts\";\nimport type { WorkspacePackages } from \"../../../scripts/release/workspace-packages.ts\";\n\nconst directories: string[] = [];\nconst temp = (): string => {\n  const dir = mkdtempSync(join(tmpdir(), \"pantoken-a11y-\"));\n  directories.push(dir);\n  return dir;\n};\nafterEach(() => {\n  vi.restoreAllMocks();\n  for (const dir of directories.splice(0)) rmSync(dir, { recursive: true, force: true });\n});\nconst entry = (\n  example = '-automatica11y\\n```html\\n<button class=\"pfx-button\">Save</button>\\n```',\n) =>\n  parseCssDocs(\n    `/**\\n * @component button\\n * @example ${example.replaceAll(\"\\n\", \"\\n * \")}\\n */\\n.pfx-button { color: red; }`,\n  );\n\ntest(\"normalizes only prefix class tokens and supports multiple fences and unfenced markup\", () => {\n  expect(\n    exampleHtml(\n      '-automatica11y\\n```html\\n<button class=\"pfx-button\">pfx-text</button>\\n```\\n```html\\n<span>More</span>\\n```',\n    ),\n  ).toBe('<button class=\"instui-button\">pfx-text</button>\\n\\n<span>More</span>');\n  expect(exampleHtml(\"-automatica11y\\n<p>Plain</p>\")).toBe(\"<p>Plain</p>\");\n  expect(() => exampleHtml(\"-automatica11y\\n\")).toThrow(\"Empty audit markup\");\n});\ntest(\"requires unique records, explicit examples, and valid markup\", () => {\n  expect(collectExamples(entry(), [\"button\"])).toEqual([\n    { record: \"button\", index: 0, html: '<button class=\"instui-button\">Save</button>' },\n  ]);\n  expect(() => collectExamples([], [\"button\"])).toThrow(\"found 0\");\n  expect(() => collectExamples([...entry(), ...entry()], [\"button\"])).toThrow(\"found 2\");\n  expect(() => collectExamples(entry(\"<button>Save</button>\"), [\"button\"])).toThrow(\n    \"Missing -automatica11y\",\n  );\n});\ntest(\"expands only four supported theme/scheme cases and loads local production assets\", () => {\n  const cases = expandCases(collectExamples(entry(), [\"button\"]));\n  expect(cases).toHaveLength(4);\n  expect(new Set(cases.map((item) => item.id)).size).toBe(4);\n  expect(cases.map((item) => `${item.theme}:${item.scheme}`)).toEqual([\n    \"rebrand:light\",\n    \"rebrand:dark\",\n    \"canvas:light\",\n    \"canvasHighContrast:light\",\n  ]);\n  const page = renderPage({ ...cases[0]!, html: '<dialog class=\"instui-modal\">Content</dialog>' });\n  expect(page).toContain('data-pantoken-theme=\"rebrand\"');\n  expect(page).toContain('data-pantoken-scheme=\"light\"');\n  for (const asset of [\n    \"scope.css\",\n    \"schemes.css\",\n    \"base.css\",\n    \"components.css\",\n    \"utilities.css\",\n    \"icons.css\",\n    \"fonts.css\",\n    \"modal.iife.js\",\n  ])\n    expect(page).toContain(asset);\n  expect(page).not.toContain(\"https://\");\n  expect(page).not.toContain(\"../assets\");\n  expect(page).toContain('href=\"assets/tokens/scope.css\"');\n  expect(page).toContain('src=\"assets/interactions/modal.iife.js\"');\n  expect(page).toContain(\"dialog.showModal()\");\n  expect(page).toContain(\"popover.showPopover()\");\n  expect(page).toContain(\"details.open = true\");\n  expect(page).toContain('document.querySelector(\".instui-tooltip [data-a11y-trigger]\")?.focus()');\n  expect(page).toContain('[role=\"treeitem\"][aria-expanded=\"false\"]');\n  expect(page).toContain('row.querySelector(\".item\")?.click()');\n  expect(page).toContain(\n    \".instui-form-field[data-native-validation] input[data-a11y-trigger][required]\",\n  );\n  expect(page).toContain(\"control.checkValidity()\");\n  expect(behaviorNames('<div class=\"instui-tabs\"></div>')).toEqual([\"tabs\"]);\n  expect(behaviorNames('<div class=\"instui-tree-browser\" role=\"tree\"></div>')).toEqual([\n    \"tree-browser\",\n  ]);\n  expect(behaviorNames('<label class=\"instui-form-field\" data-native-validation></label>')).toEqual(\n    [\"form-field\"],\n  );\n  expect(behaviorNames('<div class=\"instui-menu\" data-menu-navigation></div>')).toEqual([\"menu\"]);\n  expect(behaviorNames(\"<p>instui-tabs</p>\")).toEqual([]);\n});\ntest(\"checks exact completed coverage without interpreting violations as failures\", () => {\n  expect(\n    completedTargets({ targets: [{ id: \"button\", status: \"ran\", violations: 9 }] }, [\"button\"]),\n  ).toEqual([\"button\"]);\n  for (const invalid of [\n    null,\n    {},\n    { targets: [null] },\n    { targets: [{ id: \"button\", status: \"failed\", reason: \"Missing asset\" }] },\n    { targets: [] },\n    { targets: [{ id: \"extra\", status: \"ran\" }] },\n    {\n      targets: [\n        { id: \"button\", status: \"ran\" },\n        { id: \"button\", status: \"ran\" },\n      ],\n    },\n  ]) {\n    expect(() => completedTargets(invalid, [\"button\"])).toThrow();\n  }\n});\ntest(\"retains original evidence, uses installed CLI, and doesn't add violation fail flags\", async () => {\n  const out = temp();\n  const run = vi.fn((_command: string, args: string[]) => {\n    const dir = args[args.indexOf(\"--out\") + 1]!;\n    mkdirSync(dir, { recursive: true });\n    writeFileSync(join(dir, \"report.md\"), \"Original report\");\n    writeFileSync(\n      join(dir, \"results.json\"),\n      JSON.stringify({ targets: [{ id: \"button\", status: \"ran\" }] }),\n    );\n  });\n  expect(\n    await auditInvocation(out, \"sample\", [\"button=/case.html\"], [\"--tiers\", \"rules\"], run),\n  ).toEqual({\n    directory: \"sample\",\n    expected: [\"button\"],\n    completed: [\"button\"],\n    gaps: 0,\n    coverage: { notices: [\"button: no executable configurations\"], configurations: [] },\n  });\n  expect(run.mock.calls[0]![0]).toBe(process.execPath);\n  expect(run.mock.calls[0]![1]).toContain(\"audit\");\n  expect(run.mock.calls[0]![1].join(\" \")).not.toContain(\"--fail\");\n  expect(readFileSync(join(out, \"sample/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"makes subprocess and missing-report errors visible, including multi-target invocations\", async () => {\n  const out = temp();\n  vi.spyOn(console, \"error\").mockImplementation(() => {});\n  const run = vi.fn(() => {\n    throw new Error(\"Browser unavailable\");\n  });\n  const result = await auditInvocation(out, \"broken\", [\"a=/a.html\", \"b=/b.html\"], [], run);\n  expect(result.error).toBe(\"Browser unavailable\");\n  expect(result.completed).toEqual([]);\n  expect(run.mock.calls[0]).toBeDefined();\n  expect((await auditInvocation(out, \"missing\", [\"a=/a.html\"], [], () => {})).error).toContain(\n    \"ENOENT\",\n  );\n  expect(console.error).toHaveBeenCalled();\n});\ntest(\"executes without a shell and rejects failed or missing subprocesses\", () => {\n  execute(process.execPath, [\"-e\", \"\"], temp());\n  expect(() => execute(process.execPath, [\"-e\", \"process.exit(3)\"], temp())).toThrow(\"exited 3\");\n  expect(() => execute(join(temp(), \"does-not-exist\"), [])).toThrow();\n});\ntest(\"writes a coverage index with separate errors and the automated-coverage caveat\", async () => {\n  const out = temp();\n  writeIndex(\n    out,\n    [{ directory: \"sample\", expected: [\"a\"], completed: [], error: \"missing | target\" }],\n    [],\n  );\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"0 / 1\");\n  expect(markdown).toContain(\"missing \\\\| target\");\n  expect(markdown).toContain(\n    \"These automated results do not establish that the page meets WCAG; manual review is still needed.\",\n  );\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].error).toBe(\n    \"missing | target\",\n  );\n  await expect(runPageAudits(\"not-a-component\")).rejects.toThrow(\"Unknown record\");\n});\n\ntest.each([\"success\", \"setup failure\", \"audit failure\"])(\n  \"orchestrates retained page evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const path of [\n      \"formats/components/dist\",\n      \"formats/components/assets\",\n      \"formats/css/dist\",\n      \"formats/interactions/dist\",\n      \"plugins/pantoken/custom-components/dist\",\n    ]) {\n      mkdirSync(join(root, path), { recursive: true });\n    }\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    vi.spyOn(console, \"log\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (outcome === \"setup failure\" && args.includes(\"doctor\"))\n        throw new Error(\"Missing browser\");\n      const index = args.indexOf(\"--out\");\n      if (index < 0) return;\n      if (outcome === \"audit failure\") throw new Error(\"Target failed\");\n      const directory = args[index + 1]!;\n      const targets = args\n        .slice(2, args.indexOf(\"--wcag\"))\n        .map((target) => ({ id: target.split(\"=\")[0], status: \"ran\" }));\n      mkdirSync(directory, { recursive: true });\n      writeFileSync(join(directory, \"report.md\"), \"Original\");\n      writeFileSync(join(directory, \"results.json\"), JSON.stringify({ targets }));\n    });\n    if (outcome === \"success\")\n      expect(await runPageAudits(\"button\", run, root)).toContain(\"a11y-report\");\n    else\n      await expect(runPageAudits(\"button\", run, root)).rejects.toThrow(\n        \"Incomplete accessibility audit\",\n      );\n    const output = join(root, \"a11y-report\", readdirSync(join(root, \"a11y-report\"))[0]!);\n    const coverage = JSON.parse(readFileSync(join(output, \"coverage.json\"), \"utf8\"));\n    expect(coverage.cases).toHaveLength(4);\n    expect(readdirSync(join(output, \"pages\", \"assets\"))).toEqual([\n      \"assets\",\n      \"components\",\n      \"custom-components\",\n      \"interactions\",\n      \"tokens\",\n    ]);\n    if (outcome === \"success\")\n      expect(\n        coverage.evidence.every((item: { completed: string[] }) => item.completed.length === 1),\n      ).toBe(true);\n    else expect(readFileSync(join(output, \"index.md\"), \"utf8\")).toContain(\"Not run\");\n  },\n);\n\nconst workspace = (root: string): WorkspacePackages => {\n  const packages = [\"components\", \"css\", \"interactions\", \"utils\"].map((name) => ({\n    name: `@pantoken/${name}`,\n    path: `formats/${name}`,\n    version: \"1.0.0\",\n    private: false,\n    workspaceDeps: new Set(name === \"utils\" ? [] : [\"@pantoken/utils\"]),\n  }));\n  return { rootDir: root, packages, byName: new Map(packages.map((pkg) => [pkg.name, pkg])) };\n};\ntest(\"packs every local runtime dependency once through the workspace-aware package manager\", () => {\n  const root = temp();\n  const run = vi.fn((_command: string, args: string[]) =>\n    writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\"),\n  );\n  const options = packAuditPackages(root, workspace(root), run);\n  expect(options.filter((option) => option === \"--local-package\")).toHaveLength(4);\n  expect(run.mock.calls).toHaveLength(4);\n  expect(run.mock.calls[0]![0]).toBe(\"vp\");\n  expect(options.join(\" \")).toContain(\"@pantoken/utils=\");\n  const missing = workspace(root);\n  missing.byName.delete(\"@pantoken/utils\");\n  expect(() => packAuditPackages(root, missing, run)).toThrow(\"Missing local audit dependency\");\n});\n\ntest(\"rejects asynchronous subprocess launch and exit failures\", async () => {\n  await executeAsync(process.execPath, [\"-e\", \"\"], temp());\n  await expect(executeAsync(process.execPath, [\"-e\", \"process.exit(4)\"], temp())).rejects.toThrow(\n    \"exited 4\",\n  );\n  await expect(executeAsync(join(temp(), \"missing\"), [])).rejects.toThrow();\n});\n\ntest(\"reports coverage gaps without merging them with failed checks or violations\", () => {\n  expect(\n    inspectChecks({\n      tiers: [\n        { status: \"not-testable\" },\n        { result: \"undetermined\" },\n        { status: \"gap\" },\n        { status: \"skipped\" },\n      ],\n    }),\n  ).toBe(4);\n  expect(inspectChecks({ result: \"fail\", status: \"ran\", violations: [] })).toBe(0);\n  expect(() =>\n    inspectChecks({ engines: { axe: { status: \"failed\", reason: \"Engine error\" } } }),\n  ).toThrow(\"Engine error\");\n  expect(() => inspectChecks({ result: \"error\" })).toThrow(\"Audit check failed\");\n});\n\nconst requestedTiers = [\"rules\", \"interactions\", \"computed\", \"conditions\", \"vsr\"];\nconst dialogResults = () => {\n  const targets = Array.from({ length: 6 }, (_, index) => ({\n    id: `dialog-${index}`,\n    status: \"ran\",\n    archetypes: {\n      dialog: {\n        status: \"ran\",\n        fixture: { source: \"authored\" },\n        configs: [\n          {\n            state: \"closed\",\n            tiers: Object.fromEntries(requestedTiers.map((tier) => [tier, { status: \"ran\" }])),\n          },\n          { state: \"open\", tiers: { rules: { status: \"ran\" }, vsr: { status: \"ran\" } } },\n        ],\n      },\n    },\n    summary: { gaps: [], notTestable: [] },\n  }));\n  const coverage = targets.flatMap(({ id }) =>\n    [\"interactions\", \"computed\", \"conditions\"].map(\n      (tier) => `${id}/dialog/1/${tier}: missing requested tier`,\n    ),\n  );\n  return { targets, outcome: { status: \"passed\", coverage } };\n};\n\ntest(\"retains 18 original supplemental-state notices without double counting derived gaps\", () => {\n  const results = dialogResults();\n  const coverage = collectCoverage(results, requestedTiers);\n  expect(coverage.notices).toEqual(results.outcome.coverage);\n  expect(coverage.configurations).toHaveLength(12);\n  expect(coverage.configurations[1]).toEqual({\n    target: \"dialog-0\",\n    archetype: \"dialog\",\n    index: 1,\n    state: \"open\",\n    tiers: {\n      rules: \"ran\",\n      interactions: \"missing\",\n      computed: \"missing\",\n      conditions: \"missing\",\n      vsr: \"ran\",\n    },\n  });\n  expect(collectCoverage({ targets: results.targets }, requestedTiers)).toEqual(coverage);\n});\n\ntest(\"preserves summary limitations, original notices, and not-testable tier notes separately\", () => {\n  const coverage = collectCoverage(\n    {\n      outcome: { coverage: [\"example: original notice\"] },\n      targets: [\n        {\n          id: \"example\",\n          summary: { gaps: [\"fixture gap\"], notTestable: [\"closed shadow root\"] },\n          archetypes: {\n            page: {\n              configs: [\n                {\n                  state: \"expanded\",\n                  tiers: {\n                    rules: { status: \"not-testable\", reason: \"no DOM\" },\n                    vsr: { status: \"ran\", notTestable: [\"open shadow root\"] },\n                    computed: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n          },\n        },\n      ],\n    },\n    [\"rules\", \"vsr\", \"computed\"],\n  );\n  expect(coverage.notices).toEqual([\n    \"example: original notice\",\n    \"example: fixture gap\",\n    \"example: closed shadow root\",\n    \"example/page/0/rules: no DOM\",\n    \"example/page/0/vsr: open shadow root\",\n  ]);\n  expect(coverage.configurations[0]!.tiers.computed).toBe(\"not-applicable\");\n});\n\ntest(\"reports missing configurations and rejects malformed coverage data\", () => {\n  expect(\n    collectCoverage({ targets: [{ id: \"empty\", archetypes: {} }] }, requestedTiers).notices,\n  ).toEqual([\"empty: no executable configurations\"]);\n  for (const value of [\n    null,\n    {},\n    { outcome: { coverage: \"invalid\" } },\n    { outcome: { coverage: [42] } },\n    { targets: [{ id: 1 }] },\n    { targets: [{ id: \"x\", summary: { gaps: {} } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { status: \"gap\", reason: {} } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [null] } } }] },\n    { targets: [{ id: \"x\", archetypes: { dialog: { configs: [{}] } } }] },\n  ])\n    expect(() => collectCoverage(value, requestedTiers)).toThrow(\"Invalid\");\n});\n\ntest(\"keeps skipped, gap, and unreported statuses explicit without treating inapplicable tiers as gaps\", () => {\n  const coverage = collectCoverage(\n    {\n      targets: [\n        {\n          id: \"sample\",\n          archetypes: {\n            dialog: {\n              status: \"gap\",\n              configs: [\n                {\n                  tiers: {\n                    rules: { status: \"skipped\" },\n                    computed: {},\n                    vsr: { status: \"not-applicable\" },\n                  },\n                },\n              ],\n            },\n            menu: { status: \"gap\", reason: \"missing fixture\" },\n          },\n        },\n      ],\n    },\n    [],\n  );\n  expect(coverage.notices).toEqual([\n    \"sample/dialog: fixture gap\",\n    \"sample/dialog/0/rules: skipped\",\n    \"sample/dialog/0/computed: missing status\",\n    \"sample/menu: missing fixture\",\n  ]);\n  expect(coverage.configurations[0]!.state).toBe(\"Not reported\");\n});\n\ntest(\"indexes supplemental-state coverage without changing originals or failing advisory findings\", async () => {\n  const out = temp();\n  const original = JSON.stringify(dialogResults());\n  const result = await auditInvocation(\n    out,\n    \"npm-dialog\",\n    dialogResults().targets.map(({ id }) => `${id}=npm:example`),\n    [\"--tiers\", requestedTiers.join(\",\")],\n    (_command, args) => {\n      const directory = args[args.indexOf(\"--out\") + 1]!;\n      mkdirSync(directory);\n      writeFileSync(join(directory, \"report.md\"), \"Original report\");\n      writeFileSync(join(directory, \"results.json\"), original);\n    },\n    \"dialog\",\n  );\n  expect(result.error).toBeUndefined();\n  expect(result.completed).toHaveLength(6);\n  expect(result.gaps).toBe(0);\n  expect(result.coverage?.notices).toHaveLength(18);\n  writeIndex(out, [result], []);\n  const markdown = readFileSync(join(out, \"index.md\"), \"utf8\");\n  expect(markdown).toContain(\"Coverage notices\");\n  expect(markdown).toContain(\"| npm-dialog | 6 / 6 | 0 | 18 |\");\n  expect(markdown).toContain(\"dialog-0/dialog/1/interactions: missing requested tier\");\n  expect(markdown).toContain(\"open\");\n  expect(markdown).toContain(\"interactions: missing\");\n  expect(markdown).toContain(\"not unique defects\");\n  expect(JSON.parse(readFileSync(join(out, \"coverage.json\"), \"utf8\")).evidence[0].coverage).toEqual(\n    result.coverage,\n  );\n  expect(readFileSync(join(out, \"npm-dialog/results.json\"), \"utf8\")).toBe(original);\n  expect(readFileSync(join(out, \"npm-dialog/report.md\"), \"utf8\")).toBe(\"Original report\");\n});\ntest(\"rejects native templates, generated guesses, and npm archetype gaps\", () => {\n  const target = {\n    id: \"sample\",\n    status: \"ran\",\n    archetypes: { button: { status: \"ran\", fixture: { source: \"authored\" } } },\n  };\n  expect(authoredTargets({ targets: [target] }, [\"sample\"], \"button\")).toEqual([\"sample\"]);\n  for (const source of [\"template\", \"generated\", \"none\"]) {\n    expect(() =>\n      authoredTargets(\n        {\n          targets: [{ ...target, archetypes: { button: { status: \"ran\", fixture: { source } } } }],\n        },\n        [\"sample\"],\n        \"button\",\n      ),\n    ).toThrow(\"authored fixture\");\n  }\n  expect(() => authoredTargets({ targets: [target] }, [\"sample\"], \"dialog\")).toThrow(\n    \"authored fixture\",\n  );\n  expect(() => authoredTargets(null, [], \"button\")).toThrow();\n});\ntest(\"inlines only built supplementary styles, local fonts, and production behavior\", () => {\n  const root = temp();\n  for (const folder of [\"tokens\", \"components\", \"assets\", \"interactions\"])\n    mkdirSync(join(root, folder));\n  for (const file of [\n    \"tokens/schemes.css\",\n    \"components/base.css\",\n    \"components/utilities.css\",\n    \"components/icons.css\",\n  ])\n    writeFileSync(join(root, file), \"/* built */\");\n  writeFileSync(join(root, \"assets/font.woff2\"), \"local-font\");\n  writeFileSync(join(root, \"components/fonts.css\"), '@font-face{src:url(\"../assets/font.woff2\")}');\n  writeFileSync(join(root, \"interactions/modal.iife.js\"), \"window.production = true;\");\n  const html = renderNpmFixture(\n    {\n      ...expandCases([\n        { record: \"modal\", index: 0, html: '<dialog class=\"instui-modal\">Details</dialog>' },\n      ])[0]!,\n      scheme: \"dark\",\n    },\n    root,\n  );\n  expect(html).toContain(\"data:font/woff2;base64,\");\n  expect(html).toContain(\"window.production = true\");\n  expect(html).toContain('style.colorScheme = \"dark\"');\n  expect(html).toContain('dataset.pantokenTheme = \"rebrand\"');\n  expect(html).not.toContain(\"https://\");\n  expect(html).not.toContain(\"dialog.showModal()\");\n  expect(html).not.toContain(\"popover.showPopover()\");\n  expect(html).not.toContain(\"details.open = true\");\n});\ntest.each([\"success\", \"pack failure\", \"fixture gap\", \"no archetype\", \"full inventory\"])(\n  \"appends npm evidence: %s\",\n  async (outcome) => {\n    const root = temp();\n    for (const folder of [\n      \"pages/assets/tokens\",\n      \"pages/assets/components\",\n      \"pages/assets/interactions\",\n    ])\n      mkdirSync(join(root, folder), { recursive: true });\n    for (const file of [\n      \"tokens/schemes.css\",\n      \"components/base.css\",\n      \"components/utilities.css\",\n      \"components/icons.css\",\n      \"components/fonts.css\",\n    ])\n      writeFileSync(join(root, \"pages\", \"assets\", file), \"/* built */\");\n    for (const name of [\"modal\", \"tabs\", \"tooltip\", \"close-button\", \"form-field\", \"menu\"])\n      writeFileSync(join(root, \"pages\", \"assets\", \"interactions\", `${name}.iife.js`), \"\");\n    writeIndex(root, [], []);\n    vi.spyOn(console, \"error\").mockImplementation(() => {});\n    const run = vi.fn((_command: string, args: string[]) => {\n      if (args.includes(\"pack\")) {\n        if (outcome === \"pack failure\") throw new Error(\"Pack failed\");\n        writeFileSync(args[args.indexOf(\"--out\") + 1]!, \"tarball\");\n        return;\n      }\n      const destination = args[args.indexOf(\"--out\") + 1]!;\n      const archetype = args[args.indexOf(\"--archetypes\") + 1]!;\n      const targets = args.slice(2, args.indexOf(\"--wcag\")).map((spec) => ({\n        id: spec.split(\"=\")[0],\n        status: \"ran\",\n        archetypes: {\n          [archetype]: {\n            status: outcome === \"fixture gap\" ? \"gap\" : \"ran\",\n            fixture: { source: \"authored\" },\n          },\n        },\n      }));\n      const mapping = JSON.parse(readFileSync(args[args.indexOf(\"--mapping\") + 1]!, \"utf8\"));\n      expect(Object.keys(mapping).sort()).toEqual(targets.map((target) => target.id).sort());\n      mkdirSync(destination, { recursive: true });\n      writeFileSync(join(destination, \"report.md\"), \"Original npm report\");\n      writeFileSync(join(destination, \"results.json\"), JSON.stringify({ targets }));\n    });\n    const action = runNpmAudits(\n      root,\n      outcome === \"full inventory\" ? undefined : outcome === \"no archetype\" ? \"text\" : \"button\",\n      run,\n      workspace(root),\n    );\n    if (outcome === \"success\" || outcome === \"no archetype\" || outcome === \"full inventory\")\n      await action;\n    else await expect(action).rejects.toThrow(\"Incomplete npm accessibility audit\");\n    const coverage = JSON.parse(readFileSync(join(root, \"coverage.json\"), \"utf8\"));\n    if (outcome === \"success\") {\n      expect(coverage.evidence[0].completed).toHaveLength(4);\n      const mapping = JSON.parse(readFileSync(join(root, \"mapping-button.json\"), \"utf8\"));\n      expect(Object.keys(mapping)).toHaveLength(4);\n      expect(run.mock.calls.at(-1)![1]).toContain(\"--no-generate\");\n    } else if (outcome === \"full inventory\") {\n      expect(coverage.evidence).toHaveLength(9);\n      expect(\n        coverage.evidence.flatMap((item: { completed: string[] }) => item.completed),\n      ).toHaveLength(36);\n    } else if (outcome === \"no archetype\") expect(run).not.toHaveBeenCalled();\n    else expect(coverage.evidence.some((item: { error?: string }) => item.error)).toBe(true);\n  },\n);\n"}}],"_permissionRequestSessionId":"cf8db52f-0f27-4d51-8f45-3f9af32eb056","assistedApproval":{"recommendation":"approve","reason":"Authorized repository test correction within the delegated accessibility remediation task.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"cf8db52f-0f27-4d51-8f45-3f9af32eb056"},"id":"5ba8d32e-d941-43c3-a49d-1642f988c36d","timestamp":"2026-10-28T18:14:46.518Z","parentId":"b67f486f-ca32-4cda-9bd6-a0d5f8014759"}
