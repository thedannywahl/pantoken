,"codeBlocks":"[{\"fileExt\":\".ts\",\"languageId\":\"typescript\",\"linesAdded\":8,\"linesRemoved\":0}]","languageId":"[\"typescript\"]"},"restrictedProperties":{"filePaths":"[\"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/layout/index.ts\"]"},"metrics":{"resultLength":105,"resultForLlmLength":105,"linesAdded":8,"linesRemoved":0,"context_token_limit":200000.0,"context_current_tokens":135468.0,"large_output_threshold_bytes":8192.0,"result_token_count":28}}},"id":"f98cb939-498e-46a7-874e-4ed9d4f53285","timestamp":"2026-10-28T19:10:17.199Z","parentId":"3986e124-7bae-46ee-825b-824f8e2a9cdc"}
