ripts/_scope.ts <<'E'\\nimport { parseCssDocs } from \\\"@cssdoc/core\\\";\\nimport { resolveExampleTargets } from \\\"@pantoken/utils/example-targets\\\";\\nimport { auditRecords } from \\\"./audit-plugin-components.ts\\\";\\nconst VISUAL = /^-?-?(color|size|variant|state|status|type|tone|level|shape|border|elevation|shadow|disabled|readonly|invalid|error|checked|selected|active|current|loading|indeterminate|inverse|on-color|focus|hover|expanded|open|bordered|ai|primary|secondary|danger|success|warning|info|brand)/;\\nlet totalMiss = 0, totalVis = 0;\\nconst rows: string[] = [];\\nfor (const r of auditRecords()) {\\n const e = parseCssDocs(r.rules(\\\"instui-\\\")).find((c) => c.name === r.name)! as any;\\n const html = resolveExampleTargets(e.examples).automatica11y.map((i: number) => e.examples[i]).join(\\\"\\\\n\\\");\\n const mods: string[] = (e.modifiers ?? []).map((m: any) => String(m.name ?? m.selector ?? m));\\n const vis = mods.filter((m) => VISUAL.test(m.replace(/^\\\\./, \\\"\\\")));\\n const missing = vis.filter((m) => !html.includes(m.replace(/^\\\\./, \\\"\\\")));\\n totalVis += vis.length; totalMiss += missing.length;\\n rows.push(`${r.name}\\\\tvisual=${vis.length}\\\\tmissing=${missing.length}\\\\t${missing.slice(0, 6).join(\\\" \\\")}`);\\n}\\nconsole.log(rows.join(\\\"\\\\n\\\"));\\nconsole.log(`TOTAL visual=${totalVis} missing=${totalMiss}`);\\nE\\nnode scripts/_scope.ts | column -t -s$'\\\\t' | awk 'NR<=200'; rm scripts/_scope.ts\",\"description\":\"Measure missing visual modifiers\",\"initial_wait\":60}\n[assistant] I haven't changed anything yet. This is the scoping you asked for. **What the numbers show** - All 97 audited records have exactly one `-automatica11y` example. Most exercise only a few variants. - Across all records there are 382 color, size, variant and state modifiers. About 340 of them don't appear in any audit example. That count is inflated, because aliases such as `-size-large` and `-size-lg` are counted separately. I'd estimate roughly 200 distinct visual variants. - The gaps are concentrated in a few places: - **Colors:** button (17 variants, none audited), avatar (27 of 28 missing), text (21 of 27), heading (17), progress and progress-circle (about 25), alert (9, plus 3 variants that aren't colors), pill (10), view (15, mostly border colors), banner and button-set. - **States:** text-input, text-area, simple-select, input-group and number-input are each missing `disabled`, `invalid`, `readonly` and every size. The same applies to checkbox, radio and tag. - **Sizes:** list, breadcrumb, tray, toggle-group, tree-browser, skeleton-loader and others. - About 40 records need nothing: - Table, modal, menu and drawer-layout members are covered through their parent, so only the parent needs expanding. - The layout utilities (spacing, gap, layout, position, stacking and the like) and some small components have no color, size or state variants. **Effort and cost** - It's mechanical but large. I'd expand about 55 records, one example each with all variants side by side. - Most of the added risk is contrast, because the failures that matter occur in the color variants. Reflow and sizing issues show up as soon as the large and small sizes are present. - A bigger example means more audit time per record. The fingerprint cache from last round means only the changed records get re-audited, so the full audit isn't repeated. - Some findings will be real defects in the component CSS, as with the agent-shell reflow failure. They'll show up as Fail or Review in the tables rathe… [truncated 1117 chars]\n[human #25] yes, all 5.\n[context] <current_datetime>2026-10-28T15:00:49.878-06:00</current_datetime> yes, all 5. <tagged_files> * /Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/agent-shell/agent-shell.css (41 lines) </tagged_files>\n[tool skill -> success] args={\"skill\":\"using-entire\"}\n[context] <skill-context name=\"using-entire\"> Base directory for this skill: /Users/dwahl/Scripts/pantoken/.agents/skills/using-entire # Using Entire Your default when exploring or understanding code should be: **read the recorded intent, don't guess.** Entire checkpoints capture the prompts, transcripts, and decisions behind every agent-driven change. When you need to understand why code exists or how a module evolved, look up the checkpoint history first. Only fall back to inference from code structure when no history is available — and label that explicitly. ## When This Skill Activates Use this skill whenever the task involves: - Exploring or understanding an unfamiliar module or file - Preparing to refactor, extend, or debug code you didn't write - Answering \"why is this like this?\" or \"what was the intent?\" - Doing pre-work research before making changes - Any codebase exploration where historical context would help Do **not** use this skill for simple, well-understood edits where you already have full context (e.g. \"add a comment to line 5\"). ## First Step: Check Repository Status Before diving into specific lookups, check whether Entire is available and the repository has checkpoint history: ```bash entire status ``` This tells you whether Entire is enabled, which git hooks are installed, whether the metadata branch is initialized, and any active sessions on the current branch. ## Scenario Routing When this skill activates, determine which sub-skill best fits the user's need: | Scenario | Typical user expressions | Delegate to | | ------------------------------- | ------------------------------------------------------------------------------------------------------------ | ------------------------------ | | Code block provenance | \"why is this like this\" / \"wtf is going on\" / \"what happened at src/auth.ts:42\" / \"tell me why this changed\" | `what-happened` | | Find prior work | \"has anyone done X before\" / \"search past work for rate limiting\" / \"find the previous imple… [truncated 4354 chars]\n[tool bash -> success] args={\"command\":\"entire graph search --repo . --profile full --query \\\"component automatica11y examples visual modifiers colors sizes states\\\"; entire status; git status --short\",\"description\":\"Locate audit examples and check worktree\",\"initial_wait\":60}\n[assistant] I’ll work through all five phases, covering distinct colors, sizes, and states without duplicating aliases. I’ll keep required parent markup, leave docs examples alone, and preserve genuine audit failures rather than adjust examples to hide them.\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts\",\"view_range\":[88,132]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md\",\"view_range\":[95,160]}\n[tool bash -> success] args={\"command\":\"git status --short; git --no-pager log -1 --format='%h %s'; ls formats/components/src/components/text-input; ls plugins/pantoken/custom-components/src/components\",\"description\":\"Check current changes and source layout\"}\n[tool task -> success] args={\"description\":\"Expand form audit fixtures\",\"agent_type\":\"general-purpose\",\"mode\":\"background\",\"name\":\"forms-fixtures\",\"prompt\":\"Implement phase 1 only: expand -automatica11y examples for core components text-input,text-area,simple-select,input-group,number-input,checkbox,radio,tag,form-field,form-field-group,radio-input-group,form-field-messages,in-place-edit,file-drop,range-input. Own ONLY their directories under formats/components/src/components. Inspect actual CSS/metadata before edit. Cover all distinct supported colors/sizes/states, dedup aliases; native disabled/readonly/invalid semantics must match classes and required labels/IDs. One audit example per record with all variants together. Keep docs/Canvas examples unchanged and runtime CSS unchanged. No unrelated slotted components: only owned/required markup. Avoid side-by-side layouts that manufacture reflow. Use apply_patch. Read docs/conventions/authoring.md. Repo uses vp. Run focused guard tests if feasible. Do not commit or update snapshot. Return edited paths and explicit coverage decisions. Do not delegate. User approved all five phases; others own other records. Ignore unrelated dirty l10n/docs.api.pot.\"}\n[tool task -> success] args={\"description\":\"Expand color audit fixtures\",\"agent_type\":\"general-purpose\",\"mode\":\"background\",\"name\":\"color-fixtures\",\"prompt\":\"Implement phase 2 only: expand -automatica11y examples for core components button,alert,badge,pill,avatar,text,heading,progress,progress-circle,view,link,close-button,spinner,card,context-view. Own ONLY their source dirs under formats/components/src/components (if record lives elsewhere inspect exact registry and edit only its source). Inspect actual CSS/metadata before edit. Cover all distinct supported colors/sizes/states, dedup aliases; one audit example per record with all variants. Use realistic valid required semantics and minimal owned content, no unrelated components. Inverse/on-color variants require correct contrasting surface, not inline overrides of tested color; inspect tokens/available surface utilities. Keep docs/Canvas examples and runtime CSS unchanged. Don't hide failures or drop difficult variants. Avoid manufacturing reflow from wide fixture layouts. Use apply_patch, follow docs/conventions/authoring.md. Run guard tests if feasible. No commits/snapshot changes. Return paths and coverage decisions. Do not delegate. Other agents own forms/size/plugins; ignore unrelated worktree changes.\"}\n[tool task -> success] args={\"description\":\"Expand structural audit fixtures\",\"agent_type\":\"general-purpose\",\"mode\":\"background\",\"name\":\"structural-fixtures\",\"prompt\":\"Implement phases 3 and core portion of 5: inspect and strengthen all remaining core component audit examples EXCLUDING color agent owned button,alert,badge,pill,avatar,text,heading,progress,progress-circle,view,link,close-button,spinner,card,context-view and forms agent owned text-input,text-area,simple-select,input-group,number-input,checkbox,radio,tag,form-field,form-field-group,radio-input-group,form-field-messages,in-place-edit,file-drop,range-input. Your scope includes list,breadcrumb,byline,img,metric,rating,toggle-group,tree-browser,tray,modal and members,tabs and members,calendar and member,pagination and member,drawer-layout and members,menu and members,table and members,toggle-details,popover,tooltip,side-nav-bar and members,mask. Inspect registries to locate actual sources. Cover distinct supported color/size/state variants dedup aliases, one -automatica11y example per record with all variants. Required parent/member markup stays, unrelated slotted components go; preserve valid names/IDs/semantics and behavior wiring. Do not edit runtime CSS or docs/Canvas examples. No manufactured reflow layouts, don't hide genuine failures. Use apply_patch, follow docs/conventions/authoring.md. No commits or snapshot updates. Run guard tests if feasible. Return edited paths and explicit decisions for records needing no change. Do not delegate. Other agents editing disjoint dirs; ignore their changes.\"}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/banner/banner.css\",\"view_range\":[1,165]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/button-set/button-set.css\",\"view_range\":[1,180]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/segmented-control/segmented-control.css\",\"view_range\":[1,160]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/skeleton-loader/skeleton-loader.css\",\"view_range\":[1,150]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/logo/logo.css\",\"view_range\":[1,75]}\n[tool sql -> success] args={\"description\":\"Track fixture expansion phases\",\"query\":\"INSERT INTO todos(id,title,status) VALUES ('forms-fixtures','Expanding form-control fixtures','in_progress'),('color-fixtures','Expanding color-family fixtures','in_progress'),('structural-fixtures','Expanding structural and size fixtures','in_progress'),('plugin-fixtures','Expanding custom-component fixtures','in_progress'),('fixture-validation','Validating coverage and refreshing evidence','pending'); INSERT INTO todo_deps(todo_id,depends_on) VALUES ('fixture-validation','forms-fixtures'),('fixture-validation','color-fixtures'),('fixture-validation','structural-fixtures'),('fixture-validation','plugin-fixtures');\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/banner/banner.css @@ - * <span class=\"pfx-icon -icon-checkmark\" aria-hidden=\"true\"></span> - * <span>Profile changes saved.</span> + * <h2>Profile changes saved</h2> + * <span>Your changes are available.</span> + * <div class=\"button-group\"> + * <button class=\"pfx-button\">Undo</button> + * <button class=\"pfx-button\">View</button> + * </div> * <button class=\"pfx-close-button\" aria-label=\"Dismiss notification\" data-a11y-trigger></button> * </div> + * <div class=\"pfx-banner -color-violet -size-relaxed\" role=\"status\"> + * <h2>Violet notification</h2> + * <span>Your changes are available.</span> + * <button class=\"pfx-button\">View</button> + * </div> + * <div class=\"pfx-banner -color-violet -size-compact\" role=\"status\"> + * <h2>Compact violet notification</h2> + * <span>Your changes are available.</span> + * <button class=\"pfx-close-button\" aria-label=\"Dismiss compact violet notification\"></button> + * </div> + * <div class=\"pfx-banner -color-sea -size-relaxed\" role=\"status\"> + * <h2>Sea notification</h2> + * <span>Your changes are available.</span> + * <button class=\"pfx-close-button\" aria-label=\"Dismiss sea notification\"></button> + * </div> + * <div class=\"pfx-banner -color-sea -size-compact\" role=\"status\"> + * <h2>Compact sea notification</h2> + * <span>Your changes are available.</span> + * <div class=\"button-group\"> + * <button class=\"pfx-button\">Undo</button> + * <button class=\"pfx-button\">View</button> + * </div> + * </div> *** Update File: /Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/skeleton-loader/skeleton-loader.css @@ - * <div class=\"pfx-skeleton-loader -type-text\" aria-hidden=\"true\"> + * <div class=\"pfx-skeleton-loader -type-text -size-md\" aria-hidden=\"true\"> * <div class=\"skeleton-row\"><div class=\"shape\"></div></div> * <div class=\"skeleton-row\"><div class=\"shape\"></div></div> * </div> + * <div class=\"pfx-skelet… [truncated 6269 chars]\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-examples.test.ts\",\"view_range\":[1,110]}\n[tool view -> failure] args={\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/src/declarations/focus/focus.css\",\"view_range\":[1,110]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-fingerprints.ts\",\"view_range\":[1,140]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts\",\"view_range\":[159,210]}\n[tool bash -> success] args={\"command\":\"ls plugins/pantoken/custom-components/tests; cat plugins/pantoken/custom-components/package.json | head -40; ls formats/components/src/utilities/{icon,screen-reader-content}\",\"description\":\"Find plugin tests and utility records\"}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/src/declarations/focus/index.ts\",\"view_range\":[1,145]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/icon/icon.css\",\"view_range\":[1,70]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/screen-reader-content/screen-reader-content.css\",\"view_range\":[1,80]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/tests/index.test.ts\",\"view_range\":[1,110]}\n[tool bash -> success] args={\"command\":\"ls plugins/pantoken/logos/dist | head; cat plugins/pantoken/custom-components/vite.config.ts | head -90\",\"description\":\"Check logo assets and plugin build\"}\n[tool view -> failure] args={\"path\":\"/Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/card/card.css\",\"view_range\":[1,100]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/plugins/pantoken/custom-components/src/components/ai-gradient/ai-gradient.css\",\"view_range\":[1,100]}\n[tool view -> success] args={\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/ai-gradient/index.ts\",\"view_range\":[1,100]}","copilot_cache_control":{"type":"ephemeral"}},{"content":"ALLOW: Authorized audit-fixture guidance update; no mandatory exclusion applies.","refusal":null,"role":"assistant","reasoning_opaque":"REDACTED","reasoning_text":"","encrypted_content":"REDACTED","reasoningBlocks":{"provider":"openai-responses","blocks":[{"content":[],"encrypted_content":"REDACTED","id":"","summary":[],"type":"reasoning"}]},"responses_message_status":"completed","phase":"final_answer","serverTools":{"provider":"openai-responses"},"apiCallId":"","outputTokens":119,"providerId":"copilot"}]},"id":"010ee9b1-7011-4e3e-bfcc-ed5a09d6256a","timestamp":"2026-10-28T21:04:28.623Z","parentId":"d1fa11d6-90de-4315-9be2-94f51955f8fc"}
{"type":"permission.requested","data":{"requestId":"287cb13e-3575-4bc6-93ef-facfbbf0c89f","permissionRequest":{"kind":"write","toolCallId":"custom_call_1X4OgnjD2SeQEXQb3KKgxPYH","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md b/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md\n+++ b/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md\n@@ -139,6 +139,19 @@\n member's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it.\n Use fenced HTML so audience flags remain metadata, not visible page content.\n \n+Keep one audit example per record, with distinct visual variants together: canonical colors, sizes,\n+and supported states. Don't duplicate deprecated aliases or build a Cartesian product of every\n+modifier. Include meaningful labels, selected and unselected choices, and native `disabled`,\n+`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface\n+for inverse/on-color treatments, without overriding the component's tested colors. Keep decorative\n+content hidden from assistive technology and preserve required parent/member structures.\n+\n+Stack independent cases in normal document flow instead of forcing a wide row. Expanded dialog\n+variants can use `open` so they remain measurable without one modal hiding the others. Static state\n+markup is not evidence that hover, keyboard interaction, focus movement, or announcements work:\n+those still need interaction checks and manual testing. Don't remove a supported variant or add a\n+fixture-only CSS fix to make the audit pass.\n+\n Run `vp run audit:components` from the repository root. It builds local styles and behavior bundles,\n then tests each example separately in all three themes, light and dark. Reports and the coverage\n inventory live under the gitignored `a11y-report/<run>/` directory; open `index.md` first.\n","newFileContents":"# Authoring `@pantoken/components`\n\n`@pantoken/components` is the semantic RSCSS CSS API — a parameterized generator, not hand-written\nCSS. Each documented record is one file; the bucket `index.ts` is a barrel + registry, not a monolith.\n\n## Automatic user preferences\n\nUser preferences are intrinsic behavior, not modifiers. Gate decorative transitions and animations\nwith `prefers-reduced-motion: no-preference` in each record so standalone sheets and shadow styles\nfollow the same policy. Keep loading and progress indicators visible when animation stops, and\napply state changes immediately. Interaction behaviors must also respect the live preference:\ndon't smooth-scroll, delay removal for a skipped fade, or hide progress behind a mount animation.\nDo not shorten loading timeouts or cancel announcements in the name of reducing motion.\n\nToken sheets handle color preferences in the active theme's scope. `prefers-contrast: more`\nstrengthens nonzero border widths and focus rings; `less` removes decorative elevation color without\nreducing text contrast. Keep semantic text/status colors and explicit light/dark pins intact.\nLinks gain an underline in more-contrast mode, including normally unstyled links.\n\nReduced transparency composites translucent surface tokens over an opaque semantic background.\nRemove backdrop blur in that mode, and use opaque muted colors rather than whole-control opacity for\ndisabled states. Keep intentionally empty backgrounds, image effects, and visibility transitions:\nthey aren't interchangeable with translucent component chrome. New surface expressions need coverage\nin the token preference generator and a real-browser check.\n\nIn forced colors, keep browser adjustment on surrounding components and text. Masked glyphs can use\n`forced-color-adjust: preserve-parent-color` on the painter itself, with system-color fills. Give\ngradient text a solid system-color fallback, and keep selected states visible without shadows.\nNative progress needs authored value parts and a CSS-owned indeterminate segment: suppressing CSS\nanimations alone doesn't stop the browser's built-in loading animation. Check actual rendered pixels,\nnative range semantics, and live preference changes, including RTL.\n\n## Source layout\n\n- `src/components/<name>/index.ts` + `<name>.css` (`COMPONENTS` registry).\n- `src/components/<name>/members/<member>/index.ts` + `<member>.css` — a promoted sub-component (see\n  \"Sub-components (`@memberOf`)\" below).\n- `src/utilities/<name>/index.ts` + `<name>.css` (`UTILITIES`).\n- `src/rules/{base,prose}/index.ts` + `<name>.css` (`RULES`).\n- `src/declarations/<name>/index.ts` + `<name>.css` (`DECLARATIONS`).\n- `src/lib/`: `helpers.ts` (ns/scope/glyph consts/spacing scales/`ComponentOptions`/`DEFAULT_PREFIX`),\n  `define.ts` (`defineComponent`/`defineUtility`/`defineRule`/`defineDeclaration`), `aliases.ts`\n  (`withSizeAliases`/`withAliases`), `css.ts` (the identity `css` tag), `headings.ts`,\n  `field-controls.ts`.\n\n## Sub-components (`@memberOf`)\n\nWhen a component maps to a real, separately-named instui sub-component export (`Tabs.Panel`,\n`Table.Row`, `Menu.Item`, …), promote it to its own record instead of documenting it as a `@part`\nbullet on the parent:\n\n- New files: `src/components/<parent>/members/<member>/<member>.css` + `index.ts`, same shape as any\n  other record (`defineComponent`, registered in `COMPONENTS`, exported from `src/index.ts`).\n- The record's cssdoc name is **dotted**: `@component <parent>.<member>` (e.g. `@component menu.item`)\n  — this keeps member names globally unique across the whole registry even when two different parents\n  have a same-named part (`menu.item` vs `side-nav-bar.item`), which a bare `item`/`item` collision\n  would break for the `providers`-indexed cross-file `@memberOf`/`@structure` resolution. The TS\n  identifier stays camelCase (`menuItem`/`menuItemCss`), since a dot isn't legal there anyway.\n- Add `@memberOf <parent>` on the member's own record.\n- **Always author an explicit `@class .<member>`** (or `@selector`) rather than relying on inference —\n  a member's CSS typically keeps the parent's `@scope (.pfx-<parent>) { … }` wrapper (real cascade\n  scoping, not just documentation), and inference across that boundary is unreliable; the fallback\n  className for a dotted name (`.menu.item`) would also be misleading.\n- **Physically move the CSS** into the member's own file — don't leave a doc-only record pointing at\n  rules that still live in the parent. The aggregator just concatenates raw CSS text regardless of\n  which file it came from, so this is safe even for native-element selectors with no `@scope` (e.g.\n  `table.row`'s `tr`) or where a shared declaration has to be duplicated across a couple of sibling\n  members (e.g. `table.-layout-stacked`'s box-reset, split per part rather than kept as one\n  five-selector compound rule) — cssdoc requires each record's own file to own its own selectors.\n- Remove the promoted `@part` line — a `@memberOf` record documents its own structure on its own page,\n  and `@memberOf` alone (independent of nesting in the parent's own `@structure`) already feeds the\n  parent's generated \"Subcomponents\" section.\n- Give the member's own `@structure` an `@component <parent> { … }` node instead of a bare\n  `@scope (.pfx-<parent>) { … }` wrapper — this embeds the member's real ancestor path (down to the\n  member's own selector, with any of its own nested parts) as a cross-linked record reference, e.g.\n  `@component table { tbody { tr { td {} } } }` for `table.cell`. See the `table.*` members for the\n  full pattern, including a sibling-alternation node like `table.body`'s `tbody`.\n- If a parent-level modifier restyles a promoted member (e.g. `tabs`'s `-variant-secondary` restyling\n  `tabs.tab`, or `table`'s `-layout-stacked` restyling all six of its members), mark it inline:\n  `@modifier -variant-secondary — … @affects tabs.tab — …`. Multiple `@affects <parent>.<member>`\n  markers can follow one another on the same `@modifier` line.\n- Register the member in `COMPONENTS` right after its parent, export `<member>Css` from `src/index.ts`\n  next to the parent's export, and add it to `tests/public-surface.test.ts`'s `EXPECTED` list (that\n  array is sorted before comparison, so insertion position doesn't matter). Fix any existing test that\n  asserted on the parent's `xxxCss` for content that moved to the member.\n- Don't promote a `@part` just because it's stylistically distinct — the bar is a **real, separately\n  exported instui component** (`List.Item` yes; a passive style hook like byline's `.title`/`.description`\n  or tabs' `.list`, which has no corresponding `Tabs.List` export, no).\n\n## Alternate DOM shapes (`@variant`)\n\n`@structure` supports `@variant <name>? { … }` blocks for a component that genuinely renders one of\nseveral alternative DOM shapes (e.g. a `<label>` wrapping a control vs. a `<label for>` plus a sibling\ncontrol). Only add one when a second shape is **already real and CSS-supported** — check the record's\nexisting `@example`s and rules first; don't invent a shape the component doesn't actually render. As of\nthis pass, no component in this package authors a genuine second DOM shape (things like a checkbox's\n`-label-placement-*` only reorder the same markup via CSS, which isn't a `@variant`), so none carry one.\n\n## Authoring a record\n\n```ts\nexport const foo = defineComponent({\n  name,\n  summary,\n  modifiers,\n  parts,\n  cssProperties,\n  examples,\n  structure,\n  demo,\n  css: (p) => // prettier-ignore\n  css`…css body…`,\n});\nexport const fooCss = foo.css;\n```\n\n- The doc comment is **metadata** — plain strings, no backtick/`${` escaping.\n- Only the `css` body stays a template literal. **Tag it with `css` and put a `// prettier-ignore`\n  line right before it** (before the template for a direct arrow body, before `return` for a block).\n  oxfmt treats `css` and `styled` tagged templates as embedded CSS and corrupts interpolated\n  selectors (`${p}foo.-mod` → `${p}foo .-mod`, a different meaning) otherwise. Setting\n  `embeddedLanguageFormatting` to off does **not** stop it. See the engineering log.\n- Add the record to its bucket `index.ts`. For `COMPONENTS` the order is **load-bearing** — it matches\n  the `componentsCss()` concat order, not alphabetical.\n\n## Example Audiences\n\nUse `-canvas-rce` for the HTML inserted when Include interactions is enabled, and\n`-canvas-rce-no-interactions` for its static counterpart when interactions are disabled. For\nexample, a banner or alert can include a close button in the first example and omit it in the\nsecond. The selector reads the current setting at insertion time and leaves existing content alone.\nComponents without the new flag retain their previous example fallback. Add `-docs` to examples\nthat should also render in documentation; `-automatica11y` remains independent.\n\n### Accessibility audit examples\n\nEvery record in the component registry, including member records, has an explicit\n`@example -automatica11y` block. The audit never falls back to Canvas or docs examples. Keep a\nmember's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it.\nUse fenced HTML so audience flags remain metadata, not visible page content.\n\nKeep one audit example per record, with distinct visual variants together: canonical colors, sizes,\nand supported states. Don't duplicate deprecated aliases or build a Cartesian product of every\nmodifier. Include meaningful labels, selected and unselected choices, and native `disabled`,\n`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface\nfor inverse/on-color treatments, without overriding the component's tested colors. Keep decorative\ncontent hidden from assistive technology and preserve required parent/member structures.\n\nStack independent cases in normal document flow instead of forcing a wide row. Expanded dialog\nvariants can use `open` so they remain measurable without one modal hiding the others. Static state\nmarkup is not evidence that hover, keyboard interaction, focus movement, or announcements work:\nthose still need interaction checks and manual testing. Don't remove a supported variant or add a\nfixture-only CSS fix to make the audit pass.\n\nRun `vp run audit:components` from the repository root. It builds local styles and behavior bundles,\nthen tests each example separately in all three themes, light and dark. Reports and the coverage\ninventory live under the gitignored `a11y-report/<run>/` directory; open `index.md` first.\nUse `vp run audit:components --record button` for a focused reproduction.\n\nThe page suite runs both axe-core and IBM Equal Access against WCAG 2.2 AA, conditions checks, and\n**simulated** screen-reader checks. Page audits don't exercise archetype-specific interactions or\ncomputed checks. Page fixtures expand dialogs, native popovers, and disclosures and focus tooltip\ntriggers so their expanded surfaces are measured; npm fixtures preserve authored initial states\nfor interaction checks.\nAudit-only fixture text stays verbatim in generated API sources and doesn't enter translation\ncatalogs; add `-docs` only when the example should also appear in documentation.\nClosed surfaces aren't evidence that their hidden contents passed. Findings are\nadvisory; failed targets, missing fixtures/assets, and incomplete execution are errors.\n\nThe same command also runs authored npm fixtures for button, link, dialog (modal), menu, tabs,\nform-field, accordion (toggle-details), tooltip, and live-region (alert). These fixtures reuse the\ntagged examples and actual production interactions, with all five audit tiers enabled. There is no\nclaimed combobox or chart coverage. A native template or generated guess never counts as a tested\nPantoken component. Read gaps and undetermined computed results separately from violations.\n\nThe npm suite packs the current workspace dependency closure locally with `vp pm pack`; it doesn't\ntest the last published version instead. Its fixture wrappers inline supplementary built styles,\nfonts, and behavior bundles only to reproduce the production cascade in the tool's HTML harness.\nThey don't implement replacement widget behavior.\n\nThese automated results do not establish that the page meets WCAG; manual review is still needed.\n\n## The modifier convention (key-value RSCSS compound)\n\n- Modifiers are `.${p}<comp>.-<prop>-<val>`, aligned to InstUI prop names\n  (`-color-secondary`, `-size-sm`, `-shape-circle`, `-variant-title-page`).\n- Booleans are the prop name alone, presence = true (`-clickable`, `-condensed`). A default-on boolean\n  toggled off **inverts**: `-without-background`, `-without-border`.\n- Sizes use one scale `-size-{xs,sm,md,lg,xl}`, emitted with both short and long spellings as\n  first-class aliases via `withSizeAliases()`.\n- Nested elements are **unprefixed short classes scoped as descendants** (`.instui-menu .item`), not\n  BEM `__`. Non-nested structural parts that can't be descendant-scoped are **flat prefixed**\n  (`.instui-badge-wrapper`). A guard test rejects `__` and `--`.\n- Avoid hyphen-then-digit tokens (`-2xs` needs escaping); keep tokens letter-leading.\n\n## Reuse an existing global utility — don't invent a parallel one\n\n`view`'s and `text`'s own key-value modifiers (background, border, shadow, display, position,\noverflow, cursor, colour, weight, size, transform, variants) are **copied** into global utilities —\nusable bare (`<div class=\"--bg-secondary\">`) or chained onto any component, core or\nplugin-authored (`<button class=\"instui-button --bg-danger\">`) — without touching the component's own\nchained modifiers, which stay exactly as authored.\n\n- **Never invent a new class word for something a global utility already covers.** If a generic\n  `bg`/`text`/`border`/`border-radius`/`border-width`/`box-shadow`/`display` utility already exists,\n  extend it (add a name, or an explicit `[name, token]` pair for a value outside its usual token\n  family) — don't author a parallel word like `-stroke-*` or a word-spelled duplicate like\n  `-border-radius-small` next to the existing `-border-radius-sm`.\n- Only a genuinely new concept (no existing global analogue) gets its own utility file — see\n  `utilities/position/`, `utilities/overflow/`, `utilities/cursor/`.\n- A global utility modifier is spelled with a **double dash** (`--bg-secondary`), never a single dash\n  (single-dash `-mod` is reserved for a component's own modifiers) — this is a deliberate,\n  non-colliding namespace split, not a stylistic choice.\n- The selector mechanism is `globalModifierSelector(p, name)` (`@pantoken/utils`):\n  `:where(*).--name.--name.--name`. A plain repeated class selector already matches _any_ element\n  carrying it — standalone, or chained onto a component, core or plugin-authored (`.instui-card`,\n  `.instui-agent-shell`) — no per-component enumeration needed; the `:where(*)` wrapper contributes\n  zero specificity of its own (documentation that this is a global modifier, not a scoping condition),\n  while the modifier class repeated 3x gives the rule (0,3,0) specificity, which deterministically\n  outranks any real 2-class component-modifier compound (`.instui-view.-mod`, 0,2,0) **regardless of\n  source/import order**. `packages/utils`'s `colorUtilitiesCss`/`tokenUtilitiesCss` build on the same\n  helper.\n- This replaced an older per-component compound-selector fan-out (`GLOBAL_ALIAS_TARGETS`/\n  `globalSelectors()`/`chainTargets`, one `.instui-<component>.-mod` selector per real core\n  component) that: couldn't reach plugin-authored components at all (the core package can't know a\n  plugin's class names at its own build time); relied on `cssdoc.jsonc`'s `globalPrecedence: \"base\"`\n  and import order for override behavior, which only ever affected generated _documentation_ merge\n  order, not real browser cascade; and didn't scale to a utility with a large modifier surface (see\n  spacing below).\n\n## Universal spacing/gap modifiers\n\n- `margin`/`padding`/`gap` utility classes (`utilities/spacing/`, `utilities/gap/`) are **universal**:\n  every registered component (core or plugin) gets the modifier for free via `globalModifierSelector`,\n  with no per-record authoring — see the mechanism above.\n- Each value ships in exactly two spellings: **short** (`--mb-sm`) and fully **long**, word-spelled\n  (`--margin-bottom-small`) — never a mixed-segment form (no `-margin-e-small`, no `-me-small`).\n- Because these modifiers are documented on the separate `spacing`/`gap` utility records, not on the\n  component they're chained onto, resolving `.instui-card.--mb-sm` requires cssdoc to fall back from\n  the base record to any record tagged `@global` — every utility record here carries that tag for\n  exactly this reason. `@cssdoc/eslint-plugin`'s `valid-class-usage` (and the shared `isModifier`/\n  `deprecationOf` lookups behind it) already do this fallback automatically; no `cssdoc.jsonc` option\n  is involved. The one real prerequisite is that whatever CSS is passed to `valid-class-usage`'s `css`\n  option still carries the doc comments (an unminified build) — the published `dist/*.css` bundles are\n  minified and strip all comments, so pointing consumer-side lint at them would flag everything, not\n  just globals.\n- If a component already sets its own `margin`/`padding`/`gap` from a component-specific token (e.g.\n  card's responsive padding, breadcrumb's `gap`), document that in `@remarks` and warn that chaining a\n  spacing/gap utility modifier overrides it — see breadcrumb, button, byline, checkbox, form-field,\n  form-field-group, form-field-messages, link, list, metric, pagination, radio, radio-input-group,\n  rating, side-nav-bar, and tag for the pattern.\n\n## Deprecated and alias modifiers (auto-discovered, always functional)\n\n- Author a modifier's metadata with `alias: \"{@link -canonical}\"` for a **pure rename** (no behavior\n  change, e.g. `-toggle` → `-variant-toggle`), or `deprecated: \"{@link -canonical}\"` for a **true\n  deprecation** (behavior changed, e.g. the color/spacing normalization renames like avatar's\n  `-color-accent*` or alert's `-variant-*`). `withAliases` reads either tag and clones each canonical\n  rule under the alias name — there is no hardcoded pairs list, and both tags render a functional twin.\n- **A deprecated or aliased modifier must be a functional alias — never a doc-only noop** (user's\n  absolute rule).\n- The docs render `@alias` as a blue \"Alias\" pill (informational rename) and `@deprecated` as a red\n  \"Deprecated\" pill (a real behavior change) — see `docs/scripts/api-badge-classes.ts`.\n- The alias post-processors run on the CSS **body only**, before the doc block is prepended, because\n  the doc block's `{@link}` braces confuse the brace-based scanners. They anchor on the base class\n  (`.instui-radio.-variant-toggle`), not the bare token, so a bare `.-canonical` match doesn't wrongly\n  clone `:not(.-canonical)` or compound rules.\n\n## `@scope`, nesting, and root targeting\n\nThe default authoring system is the `alert.css` pattern:\n\n- Use a single scoped root block: `@scope (.instui-foo) { :scope { … } }`.\n- Keep root-owned behavior nested under that root with `&` (`&::before`, `&.-variant-x`,\n  `&[class*=\"-icon-\"]`, `&:has(> .part)`).\n- Keep child-only selectors as structural descendants inside the root (`> .part`, `.part`,\n  `.part::before`) instead of restating independent top-level `:scope > ...` rules.\n- Never use functional `:scope(...)`; use standard combinators (`:scope > .part`) or nested child\n  selectors inside `:scope`.\n\nThis keeps ownership explicit (root vs descendant), reduces duplicated selector prefixes, and produces\nmore stable diffs when modifier/state branches are added.\n\nWhen you must support legacy generator behavior (`scope(root, body, children?)` in `helpers.ts`) during\nmigration, preserve semantic parity first, then normalize toward the scoped-root nested form above.\n\n`@scope`/`:is`/`:has`/`:where` are **not** namespacing tools — only a unique or prefixed name prevents\na collision. Scoping narrows intent and deep-nesting collisions; it isn't collision-proof.\n\n## Local utility `@property` values\n\nFor repeated record-local dimensions or timings (for example rail/glyph sizes), define short local custom\nproperties and register them with `@property` near the top of the file:\n\n- Use local names without global namespace prefixes when the property is record-scoped\n  (`--rail-size`, `--glyph-size`, `--duration`).\n- Keep global prefixes (`--instui-*`, `--pantoken-*`) only for truly shared cross-record/token surfaces.\n- Document internal-only utility properties with valid `@cssproperty` prose and `@readonly` markers when\n  they are not public customization API.\n\n## Icons\n\nGlyphs render via a shared `::before` mask painter (currentColor, 1em box) that matches class tokens\nstarting with `-icon-`, not arbitrary class names containing `-icon-`. A glyph class rides a host\ndirectly because `--pantoken-glyph` is a plain (non-`@property`)\ncustom prop that inherits into `::before`. So `<button class=\"instui-button -shape-square\n-icon-arrow-right\">` needs no nested icon span. Built-in component glyphs source from the shared\n`--instui-icon-<name>` tokens via an `iconMask(name)` helper.\n\n## Per-component checklist\n\nExtend the record, update the drift-checked test, update the guide (`docs/guide/components.md`), and\nadd or update a demo. Then run `vp check --fix`, the component + demo tests, `check:publish`, and\n`lint:markdown`. Browser-verify anything visual. Skip upstream tokens that are `@property`-registered\nbut value-less (being removed upstream) — don't invent them.\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md","content":"# Authoring `@pantoken/components`\n\n`@pantoken/components` is the semantic RSCSS CSS API — a parameterized generator, not hand-written\nCSS. Each documented record is one file; the bucket `index.ts` is a barrel + registry, not a monolith.\n\n## Automatic user preferences\n\nUser preferences are intrinsic behavior, not modifiers. Gate decorative transitions and animations\nwith `prefers-reduced-motion: no-preference` in each record so standalone sheets and shadow styles\nfollow the same policy. Keep loading and progress indicators visible when animation stops, and\napply state changes immediately. Interaction behaviors must also respect the live preference:\ndon't smooth-scroll, delay removal for a skipped fade, or hide progress behind a mount animation.\nDo not shorten loading timeouts or cancel announcements in the name of reducing motion.\n\nToken sheets handle color preferences in the active theme's scope. `prefers-contrast: more`\nstrengthens nonzero border widths and focus rings; `less` removes decorative elevation color without\nreducing text contrast. Keep semantic text/status colors and explicit light/dark pins intact.\nLinks gain an underline in more-contrast mode, including normally unstyled links.\n\nReduced transparency composites translucent surface tokens over an opaque semantic background.\nRemove backdrop blur in that mode, and use opaque muted colors rather than whole-control opacity for\ndisabled states. Keep intentionally empty backgrounds, image effects, and visibility transitions:\nthey aren't interchangeable with translucent component chrome. New surface expressions need coverage\nin the token preference generator and a real-browser check.\n\nIn forced colors, keep browser adjustment on surrounding components and text. Masked glyphs can use\n`forced-color-adjust: preserve-parent-color` on the painter itself, with system-color fills. Give\ngradient text a solid system-color fallback, and keep selected states visible without shadows.\nNative progress needs authored value parts and a CSS-owned indeterminate segment: suppressing CSS\nanimations alone doesn't stop the browser's built-in loading animation. Check actual rendered pixels,\nnative range semantics, and live preference changes, including RTL.\n\n## Source layout\n\n- `src/components/<name>/index.ts` + `<name>.css` (`COMPONENTS` registry).\n- `src/components/<name>/members/<member>/index.ts` + `<member>.css` — a promoted sub-component (see\n  \"Sub-components (`@memberOf`)\" below).\n- `src/utilities/<name>/index.ts` + `<name>.css` (`UTILITIES`).\n- `src/rules/{base,prose}/index.ts` + `<name>.css` (`RULES`).\n- `src/declarations/<name>/index.ts` + `<name>.css` (`DECLARATIONS`).\n- `src/lib/`: `helpers.ts` (ns/scope/glyph consts/spacing scales/`ComponentOptions`/`DEFAULT_PREFIX`),\n  `define.ts` (`defineComponent`/`defineUtility`/`defineRule`/`defineDeclaration`), `aliases.ts`\n  (`withSizeAliases`/`withAliases`), `css.ts` (the identity `css` tag), `headings.ts`,\n  `field-controls.ts`.\n\n## Sub-components (`@memberOf`)\n\nWhen a component maps to a real, separately-named instui sub-component export (`Tabs.Panel`,\n`Table.Row`, `Menu.Item`, …), promote it to its own record instead of documenting it as a `@part`\nbullet on the parent:\n\n- New files: `src/components/<parent>/members/<member>/<member>.css` + `index.ts`, same shape as any\n  other record (`defineComponent`, registered in `COMPONENTS`, exported from `src/index.ts`).\n- The record's cssdoc name is **dotted**: `@component <parent>.<member>` (e.g. `@component menu.item`)\n  — this keeps member names globally unique across the whole registry even when two different parents\n  have a same-named part (`menu.item` vs `side-nav-bar.item`), which a bare `item`/`item` collision\n  would break for the `providers`-indexed cross-file `@memberOf`/`@structure` resolution. The TS\n  identifier stays camelCase (`menuItem`/`menuItemCss`), since a dot isn't legal there anyway.\n- Add `@memberOf <parent>` on the member's own record.\n- **Always author an explicit `@class .<member>`** (or `@selector`) rather than relying on inference —\n  a member's CSS typically keeps the parent's `@scope (.pfx-<parent>) { … }` wrapper (real cascade\n  scoping, not just documentation), and inference across that boundary is unreliable; the fallback\n  className for a dotted name (`.menu.item`) would also be misleading.\n- **Physically move the CSS** into the member's own file — don't leave a doc-only record pointing at\n  rules that still live in the parent. The aggregator just concatenates raw CSS text regardless of\n  which file it came from, so this is safe even for native-element selectors with no `@scope` (e.g.\n  `table.row`'s `tr`) or where a shared declaration has to be duplicated across a couple of sibling\n  members (e.g. `table.-layout-stacked`'s box-reset, split per part rather than kept as one\n  five-selector compound rule) — cssdoc requires each record's own file to own its own selectors.\n- Remove the promoted `@part` line — a `@memberOf` record documents its own structure on its own page,\n  and `@memberOf` alone (independent of nesting in the parent's own `@structure`) already feeds the\n  parent's generated \"Subcomponents\" section.\n- Give the member's own `@structure` an `@component <parent> { … }` node instead of a bare\n  `@scope (.pfx-<parent>) { … }` wrapper — this embeds the member's real ancestor path (down to the\n  member's own selector, with any of its own nested parts) as a cross-linked record reference, e.g.\n  `@component table { tbody { tr { td {} } } }` for `table.cell`. See the `table.*` members for the\n  full pattern, including a sibling-alternation node like `table.body`'s `tbody`.\n- If a parent-level modifier restyles a promoted member (e.g. `tabs`'s `-variant-secondary` restyling\n  `tabs.tab`, or `table`'s `-layout-stacked` restyling all six of its members), mark it inline:\n  `@modifier -variant-secondary — … @affects tabs.tab — …`. Multiple `@affects <parent>.<member>`\n  markers can follow one another on the same `@modifier` line.\n- Register the member in `COMPONENTS` right after its parent, export `<member>Css` from `src/index.ts`\n  next to the parent's export, and add it to `tests/public-surface.test.ts`'s `EXPECTED` list (that\n  array is sorted before comparison, so insertion position doesn't matter). Fix any existing test that\n  asserted on the parent's `xxxCss` for content that moved to the member.\n- Don't promote a `@part` just because it's stylistically distinct — the bar is a **real, separately\n  exported instui component** (`List.Item` yes; a passive style hook like byline's `.title`/`.description`\n  or tabs' `.list`, which has no corresponding `Tabs.List` export, no).\n\n## Alternate DOM shapes (`@variant`)\n\n`@structure` supports `@variant <name>? { … }` blocks for a component that genuinely renders one of\nseveral alternative DOM shapes (e.g. a `<label>` wrapping a control vs. a `<label for>` plus a sibling\ncontrol). Only add one when a second shape is **already real and CSS-supported** — check the record's\nexisting `@example`s and rules first; don't invent a shape the component doesn't actually render. As of\nthis pass, no component in this package authors a genuine second DOM shape (things like a checkbox's\n`-label-placement-*` only reorder the same markup via CSS, which isn't a `@variant`), so none carry one.\n\n## Authoring a record\n\n```ts\nexport const foo = defineComponent({\n  name,\n  summary,\n  modifiers,\n  parts,\n  cssProperties,\n  examples,\n  structure,\n  demo,\n  css: (p) => // prettier-ignore\n  css`…css body…`,\n});\nexport const fooCss = foo.css;\n```\n\n- The doc comment is **metadata** — plain strings, no backtick/`${` escaping.\n- Only the `css` body stays a template literal. **Tag it with `css` and put a `// prettier-ignore`\n  line right before it** (before the template for a direct arrow body, before `return` for a block).\n  oxfmt treats `css` and `styled` tagged templates as embedded CSS and corrupts interpolated\n  selectors (`${p}foo.-mod` → `${p}foo .-mod`, a different meaning) otherwise. Setting\n  `embeddedLanguageFormatting` to off does **not** stop it. See the engineering log.\n- Add the record to its bucket `index.ts`. For `COMPONENTS` the order is **load-bearing** — it matches\n  the `componentsCss()` concat order, not alphabetical.\n\n## Example Audiences\n\nUse `-canvas-rce` for the HTML inserted when Include interactions is enabled, and\n`-canvas-rce-no-interactions` for its static counterpart when interactions are disabled. For\nexample, a banner or alert can include a close button in the first example and omit it in the\nsecond. The selector reads the current setting at insertion time and leaves existing content alone.\nComponents without the new flag retain their previous example fallback. Add `-docs` to examples\nthat should also render in documentation; `-automatica11y` remains independent.\n\n### Accessibility audit examples\n\nEvery record in the component registry, including member records, has an explicit\n`@example -automatica11y` block. The audit never falls back to Canvas or docs examples. Keep a\nmember's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it.\nUse fenced HTML so audience flags remain metadata, not visible page content.\n\nRun `vp run audit:components` from the repository root. It builds local styles and behavior bundles,\nthen tests each example separately in all three themes, light and dark. Reports and the coverage\ninventory live under the gitignored `a11y-report/<run>/` directory; open `index.md` first.\nUse `vp run audit:components --record button` for a focused reproduction.\n\nThe page suite runs both axe-core and IBM Equal Access against WCAG 2.2 AA, conditions checks, and\n**simulated** screen-reader checks. Page audits don't exercise archetype-specific interactions or\ncomputed checks. Page fixtures expand dialogs, native popovers, and disclosures and focus tooltip\ntriggers so their expanded surfaces are measured; npm fixtures preserve authored initial states\nfor interaction checks.\nAudit-only fixture text stays verbatim in generated API sources and doesn't enter translation\ncatalogs; add `-docs` only when the example should also appear in documentation.\nClosed surfaces aren't evidence that their hidden contents passed. Findings are\nadvisory; failed targets, missing fixtures/assets, and incomplete execution are errors.\n\nThe same command also runs authored npm fixtures for button, link, dialog (modal), menu, tabs,\nform-field, accordion (toggle-details), tooltip, and live-region (alert). These fixtures reuse the\ntagged examples and actual production interactions, with all five audit tiers enabled. There is no\nclaimed combobox or chart coverage. A native template or generated guess never counts as a tested\nPantoken component. Read gaps and undetermined computed results separately from violations.\n\nThe npm suite packs the current workspace dependency closure locally with `vp pm pack`; it doesn't\ntest the last published version instead. Its fixture wrappers inline supplementary built styles,\nfonts, and behavior bundles only to reproduce the production cascade in the tool's HTML harness.\nThey don't implement replacement widget behavior.\n\nThese automated results do not establish that the page meets WCAG; manual review is still needed.\n\n## The modifier convention (key-value RSCSS compound)\n\n- Modifiers are `.${p}<comp>.-<prop>-<val>`, aligned to InstUI prop names\n  (`-color-secondary`, `-size-sm`, `-shape-circle`, `-variant-title-page`).\n- Booleans are the prop name alone, presence = true (`-clickable`, `-condensed`). A default-on boolean\n  toggled off **inverts**: `-without-background`, `-without-border`.\n- Sizes use one scale `-size-{xs,sm,md,lg,xl}`, emitted with both short and long spellings as\n  first-class aliases via `withSizeAliases()`.\n- Nested elements are **unprefixed short classes scoped as descendants** (`.instui-menu .item`), not\n  BEM `__`. Non-nested structural parts that can't be descendant-scoped are **flat prefixed**\n  (`.instui-badge-wrapper`). A guard test rejects `__` and `--`.\n- Avoid hyphen-then-digit tokens (`-2xs` needs escaping); keep tokens letter-leading.\n\n## Reuse an existing global utility — don't invent a parallel one\n\n`view`'s and `text`'s own key-value modifiers (background, border, shadow, display, position,\noverflow, cursor, colour, weight, size, transform, variants) are **copied** into global utilities —\nusable bare (`<div class=\"--bg-secondary\">`) or chained onto any component, core or\nplugin-authored (`<button class=\"instui-button --bg-danger\">`) — without touching the component's own\nchained modifiers, which stay exactly as authored.\n\n- **Never invent a new class word for something a global utility already covers.** If a generic\n  `bg`/`text`/`border`/`border-radius`/`border-width`/`box-shadow`/`display` utility already exists,\n  extend it (add a name, or an explicit `[name, token]` pair for a value outside its usual token\n  family) — don't author a parallel word like `-stroke-*` or a word-spelled duplicate like\n  `-border-radius-small` next to the existing `-border-radius-sm`.\n- Only a genuinely new concept (no existing global analogue) gets its own utility file — see\n  `utilities/position/`, `utilities/overflow/`, `utilities/cursor/`.\n- A global utility modifier is spelled with a **double dash** (`--bg-secondary`), never a single dash\n  (single-dash `-mod` is reserved for a component's own modifiers) — this is a deliberate,\n  non-colliding namespace split, not a stylistic choice.\n- The selector mechanism is `globalModifierSelector(p, name)` (`@pantoken/utils`):\n  `:where(*).--name.--name.--name`. A plain repeated class selector already matches _any_ element\n  carrying it — standalone, or chained onto a component, core or plugin-authored (`.instui-card`,\n  `.instui-agent-shell`) — no per-component enumeration needed; the `:where(*)` wrapper contributes\n  zero specificity of its own (documentation that this is a global modifier, not a scoping condition),\n  while the modifier class repeated 3x gives the rule (0,3,0) specificity, which deterministically\n  outranks any real 2-class component-modifier compound (`.instui-view.-mod`, 0,2,0) **regardless of\n  source/import order**. `packages/utils`'s `colorUtilitiesCss`/`tokenUtilitiesCss` build on the same\n  helper.\n- This replaced an older per-component compound-selector fan-out (`GLOBAL_ALIAS_TARGETS`/\n  `globalSelectors()`/`chainTargets`, one `.instui-<component>.-mod` selector per real core\n  component) that: couldn't reach plugin-authored components at all (the core package can't know a\n  plugin's class names at its own build time); relied on `cssdoc.jsonc`'s `globalPrecedence: \"base\"`\n  and import order for override behavior, which only ever affected generated _documentation_ merge\n  order, not real browser cascade; and didn't scale to a utility with a large modifier surface (see\n  spacing below).\n\n## Universal spacing/gap modifiers\n\n- `margin`/`padding`/`gap` utility classes (`utilities/spacing/`, `utilities/gap/`) are **universal**:\n  every registered component (core or plugin) gets the modifier for free via `globalModifierSelector`,\n  with no per-record authoring — see the mechanism above.\n- Each value ships in exactly two spellings: **short** (`--mb-sm`) and fully **long**, word-spelled\n  (`--margin-bottom-small`) — never a mixed-segment form (no `-margin-e-small`, no `-me-small`).\n- Because these modifiers are documented on the separate `spacing`/`gap` utility records, not on the\n  component they're chained onto, resolving `.instui-card.--mb-sm` requires cssdoc to fall back from\n  the base record to any record tagged `@global` — every utility record here carries that tag for\n  exactly this reason. `@cssdoc/eslint-plugin`'s `valid-class-usage` (and the shared `isModifier`/\n  `deprecationOf` lookups behind it) already do this fallback automatically; no `cssdoc.jsonc` option\n  is involved. The one real prerequisite is that whatever CSS is passed to `valid-class-usage`'s `css`\n  option still carries the doc comments (an unminified build) — the published `dist/*.css` bundles are\n  minified and strip all comments, so pointing consumer-side lint at them would flag everything, not\n  just globals.\n- If a component already sets its own `margin`/`padding`/`gap` from a component-specific token (e.g.\n  card's responsive padding, breadcrumb's `gap`), document that in `@remarks` and warn that chaining a\n  spacing/gap utility modifier overrides it — see breadcrumb, button, byline, checkbox, form-field,\n  form-field-group, form-field-messages, link, list, metric, pagination, radio, radio-input-group,\n  rating, side-nav-bar, and tag for the pattern.\n\n## Deprecated and alias modifiers (auto-discovered, always functional)\n\n- Author a modifier's metadata with `alias: \"{@link -canonical}\"` for a **pure rename** (no behavior\n  change, e.g. `-toggle` → `-variant-toggle`), or `deprecated: \"{@link -canonical}\"` for a **true\n  deprecation** (behavior changed, e.g. the color/spacing normalization renames like avatar's\n  `-color-accent*` or alert's `-variant-*`). `withAliases` reads either tag and clones each canonical\n  rule under the alias name — there is no hardcoded pairs list, and both tags render a functional twin.\n- **A deprecated or aliased modifier must be a functional alias — never a doc-only noop** (user's\n  absolute rule).\n- The docs render `@alias` as a blue \"Alias\" pill (informational rename) and `@deprecated` as a red\n  \"Deprecated\" pill (a real behavior change) — see `docs/scripts/api-badge-classes.ts`.\n- The alias post-processors run on the CSS **body only**, before the doc block is prepended, because\n  the doc block's `{@link}` braces confuse the brace-based scanners. They anchor on the base class\n  (`.instui-radio.-variant-toggle`), not the bare token, so a bare `.-canonical` match doesn't wrongly\n  clone `:not(.-canonical)` or compound rules.\n\n## `@scope`, nesting, and root targeting\n\nThe default authoring system is the `alert.css` pattern:\n\n- Use a single scoped root block: `@scope (.instui-foo) { :scope { … } }`.\n- Keep root-owned behavior nested under that root with `&` (`&::before`, `&.-variant-x`,\n  `&[class*=\"-icon-\"]`, `&:has(> .part)`).\n- Keep child-only selectors as structural descendants inside the root (`> .part`, `.part`,\n  `.part::before`) instead of restating independent top-level `:scope > ...` rules.\n- Never use functional `:scope(...)`; use standard combinators (`:scope > .part`) or nested child\n  selectors inside `:scope`.\n\nThis keeps ownership explicit (root vs descendant), reduces duplicated selector prefixes, and produces\nmore stable diffs when modifier/state branches are added.\n\nWhen you must support legacy generator behavior (`scope(root, body, children?)` in `helpers.ts`) during\nmigration, preserve semantic parity first, then normalize toward the scoped-root nested form above.\n\n`@scope`/`:is`/`:has`/`:where` are **not** namespacing tools — only a unique or prefixed name prevents\na collision. Scoping narrows intent and deep-nesting collisions; it isn't collision-proof.\n\n## Local utility `@property` values\n\nFor repeated record-local dimensions or timings (for example rail/glyph sizes), define short local custom\nproperties and register them with `@property` near the top of the file:\n\n- Use local names without global namespace prefixes when the property is record-scoped\n  (`--rail-size`, `--glyph-size`, `--duration`).\n- Keep global prefixes (`--instui-*`, `--pantoken-*`) only for truly shared cross-record/token surfaces.\n- Document internal-only utility properties with valid `@cssproperty` prose and `@readonly` markers when\n  they are not public customization API.\n\n## Icons\n\nGlyphs render via a shared `::before` mask painter (currentColor, 1em box) that matches class tokens\nstarting with `-icon-`, not arbitrary class names containing `-icon-`. A glyph class rides a host\ndirectly because `--pantoken-glyph` is a plain (non-`@property`)\ncustom prop that inherits into `::before`. So `<button class=\"instui-button -shape-square\n-icon-arrow-right\">` needs no nested icon span. Built-in component glyphs source from the shared\n`--instui-icon-<name>` tokens via an `iconMask(name)` helper.\n\n## Per-component checklist\n\nExtend the record, update the drift-checked test, update the guide (`docs/guide/components.md`), and\nadd or update a demo. Then run `vp check --fix`, the component + demo tests, `check:publish`, and\n`lint:markdown`. Browser-verify anything visual. Skip upstream tokens that are `@property`-registered\nbut value-less (being removed upstream) — don't invent them.\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md","content":"# Authoring `@pantoken/components`\n\n`@pantoken/components` is the semantic RSCSS CSS API — a parameterized generator, not hand-written\nCSS. Each documented record is one file; the bucket `index.ts` is a barrel + registry, not a monolith.\n\n## Automatic user preferences\n\nUser preferences are intrinsic behavior, not modifiers. Gate decorative transitions and animations\nwith `prefers-reduced-motion: no-preference` in each record so standalone sheets and shadow styles\nfollow the same policy. Keep loading and progress indicators visible when animation stops, and\napply state changes immediately. Interaction behaviors must also respect the live preference:\ndon't smooth-scroll, delay removal for a skipped fade, or hide progress behind a mount animation.\nDo not shorten loading timeouts or cancel announcements in the name of reducing motion.\n\nToken sheets handle color preferences in the active theme's scope. `prefers-contrast: more`\nstrengthens nonzero border widths and focus rings; `less` removes decorative elevation color without\nreducing text contrast. Keep semantic text/status colors and explicit light/dark pins intact.\nLinks gain an underline in more-contrast mode, including normally unstyled links.\n\nReduced transparency composites translucent surface tokens over an opaque semantic background.\nRemove backdrop blur in that mode, and use opaque muted colors rather than whole-control opacity for\ndisabled states. Keep intentionally empty backgrounds, image effects, and visibility transitions:\nthey aren't interchangeable with translucent component chrome. New surface expressions need coverage\nin the token preference generator and a real-browser check.\n\nIn forced colors, keep browser adjustment on surrounding components and text. Masked glyphs can use\n`forced-color-adjust: preserve-parent-color` on the painter itself, with system-color fills. Give\ngradient text a solid system-color fallback, and keep selected states visible without shadows.\nNative progress needs authored value parts and a CSS-owned indeterminate segment: suppressing CSS\nanimations alone doesn't stop the browser's built-in loading animation. Check actual rendered pixels,\nnative range semantics, and live preference changes, including RTL.\n\n## Source layout\n\n- `src/components/<name>/index.ts` + `<name>.css` (`COMPONENTS` registry).\n- `src/components/<name>/members/<member>/index.ts` + `<member>.css` — a promoted sub-component (see\n  \"Sub-components (`@memberOf`)\" below).\n- `src/utilities/<name>/index.ts` + `<name>.css` (`UTILITIES`).\n- `src/rules/{base,prose}/index.ts` + `<name>.css` (`RULES`).\n- `src/declarations/<name>/index.ts` + `<name>.css` (`DECLARATIONS`).\n- `src/lib/`: `helpers.ts` (ns/scope/glyph consts/spacing scales/`ComponentOptions`/`DEFAULT_PREFIX`),\n  `define.ts` (`defineComponent`/`defineUtility`/`defineRule`/`defineDeclaration`), `aliases.ts`\n  (`withSizeAliases`/`withAliases`), `css.ts` (the identity `css` tag), `headings.ts`,\n  `field-controls.ts`.\n\n## Sub-components (`@memberOf`)\n\nWhen a component maps to a real, separately-named instui sub-component export (`Tabs.Panel`,\n`Table.Row`, `Menu.Item`, …), promote it to its own record instead of documenting it as a `@part`\nbullet on the parent:\n\n- New files: `src/components/<parent>/members/<member>/<member>.css` + `index.ts`, same shape as any\n  other record (`defineComponent`, registered in `COMPONENTS`, exported from `src/index.ts`).\n- The record's cssdoc name is **dotted**: `@component <parent>.<member>` (e.g. `@component menu.item`)\n  — this keeps member names globally unique across the whole registry even when two different parents\n  have a same-named part (`menu.item` vs `side-nav-bar.item`), which a bare `item`/`item` collision\n  would break for the `providers`-indexed cross-file `@memberOf`/`@structure` resolution. The TS\n  identifier stays camelCase (`menuItem`/`menuItemCss`), since a dot isn't legal there anyway.\n- Add `@memberOf <parent>` on the member's own record.\n- **Always author an explicit `@class .<member>`** (or `@selector`) rather than relying on inference —\n  a member's CSS typically keeps the parent's `@scope (.pfx-<parent>) { … }` wrapper (real cascade\n  scoping, not just documentation), and inference across that boundary is unreliable; the fallback\n  className for a dotted name (`.menu.item`) would also be misleading.\n- **Physically move the CSS** into the member's own file — don't leave a doc-only record pointing at\n  rules that still live in the parent. The aggregator just concatenates raw CSS text regardless of\n  which file it came from, so this is safe even for native-element selectors with no `@scope` (e.g.\n  `table.row`'s `tr`) or where a shared declaration has to be duplicated across a couple of sibling\n  members (e.g. `table.-layout-stacked`'s box-reset, split per part rather than kept as one\n  five-selector compound rule) — cssdoc requires each record's own file to own its own selectors.\n- Remove the promoted `@part` line — a `@memberOf` record documents its own structure on its own page,\n  and `@memberOf` alone (independent of nesting in the parent's own `@structure`) already feeds the\n  parent's generated \"Subcomponents\" section.\n- Give the member's own `@structure` an `@component <parent> { … }` node instead of a bare\n  `@scope (.pfx-<parent>) { … }` wrapper — this embeds the member's real ancestor path (down to the\n  member's own selector, with any of its own nested parts) as a cross-linked record reference, e.g.\n  `@component table { tbody { tr { td {} } } }` for `table.cell`. See the `table.*` members for the\n  full pattern, including a sibling-alternation node like `table.body`'s `tbody`.\n- If a parent-level modifier restyles a promoted member (e.g. `tabs`'s `-variant-secondary` restyling\n  `tabs.tab`, or `table`'s `-layout-stacked` restyling all six of its members), mark it inline:\n  `@modifier -variant-secondary — … @affects tabs.tab — …`. Multiple `@affects <parent>.<member>`\n  markers can follow one another on the same `@modifier` line.\n- Register the member in `COMPONENTS` right after its parent, export `<member>Css` from `src/index.ts`\n  next to the parent's export, and add it to `tests/public-surface.test.ts`'s `EXPECTED` list (that\n  array is sorted before comparison, so insertion position doesn't matter). Fix any existing test that\n  asserted on the parent's `xxxCss` for content that moved to the member.\n- Don't promote a `@part` just because it's stylistically distinct — the bar is a **real, separately\n  exported instui component** (`List.Item` yes; a passive style hook like byline's `.title`/`.description`\n  or tabs' `.list`, which has no corresponding `Tabs.List` export, no).\n\n## Alternate DOM shapes (`@variant`)\n\n`@structure` supports `@variant <name>? { … }` blocks for a component that genuinely renders one of\nseveral alternative DOM shapes (e.g. a `<label>` wrapping a control vs. a `<label for>` plus a sibling\ncontrol). Only add one when a second shape is **already real and CSS-supported** — check the record's\nexisting `@example`s and rules first; don't invent a shape the component doesn't actually render. As of\nthis pass, no component in this package authors a genuine second DOM shape (things like a checkbox's\n`-label-placement-*` only reorder the same markup via CSS, which isn't a `@variant`), so none carry one.\n\n## Authoring a record\n\n```ts\nexport const foo = defineComponent({\n  name,\n  summary,\n  modifiers,\n  parts,\n  cssProperties,\n  examples,\n  structure,\n  demo,\n  css: (p) => // prettier-ignore\n  css`…css body…`,\n});\nexport const fooCss = foo.css;\n```\n\n- The doc comment is **metadata** — plain strings, no backtick/`${` escaping.\n- Only the `css` body stays a template literal. **Tag it with `css` and put a `// prettier-ignore`\n  line right before it** (before the template for a direct arrow body, before `return` for a block).\n  oxfmt treats `css` and `styled` tagged templates as embedded CSS and corrupts interpolated\n  selectors (`${p}foo.-mod` → `${p}foo .-mod`, a different meaning) otherwise. Setting\n  `embeddedLanguageFormatting` to off does **not** stop it. See the engineering log.\n- Add the record to its bucket `index.ts`. For `COMPONENTS` the order is **load-bearing** — it matches\n  the `componentsCss()` concat order, not alphabetical.\n\n## Example Audiences\n\nUse `-canvas-rce` for the HTML inserted when Include interactions is enabled, and\n`-canvas-rce-no-interactions` for its static counterpart when interactions are disabled. For\nexample, a banner or alert can include a close button in the first example and omit it in the\nsecond. The selector reads the current setting at insertion time and leaves existing content alone.\nComponents without the new flag retain their previous example fallback. Add `-docs` to examples\nthat should also render in documentation; `-automatica11y` remains independent.\n\n### Accessibility audit examples\n\nEvery record in the component registry, including member records, has an explicit\n`@example -automatica11y` block. The audit never falls back to Canvas or docs examples. Keep a\nmember's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it.\nUse fenced HTML so audience flags remain metadata, not visible page content.\n\nKeep one audit example per record, with distinct visual variants together: canonical colors, sizes,\nand supported states. Don't duplicate deprecated aliases or build a Cartesian product of every\nmodifier. Include meaningful labels, selected and unselected choices, and native `disabled`,\n`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface\nfor inverse/on-color treatments, without overriding the component's tested colors. Keep decorative\ncontent hidden from assistive technology and preserve required parent/member structures.\n\nStack independent cases in normal document flow instead of forcing a wide row. Expanded dialog\nvariants can use `open` so they remain measurable without one modal hiding the others. Static state\nmarkup is not evidence that hover, keyboard interaction, focus movement, or announcements work:\nthose still need interaction checks and manual testing. Don't remove a supported variant or add a\nfixture-only CSS fix to make the audit pass.\n\nRun `vp run audit:components` from the repository root. It builds local styles and behavior bundles,\nthen tests each example separately in all three themes, light and dark. Reports and the coverage\ninventory live under the gitignored `a11y-report/<run>/` directory; open `index.md` first.\nUse `vp run audit:components --record button` for a focused reproduction.\n\nThe page suite runs both axe-core and IBM Equal Access against WCAG 2.2 AA, conditions checks, and\n**simulated** screen-reader checks. Page audits don't exercise archetype-specific interactions or\ncomputed checks. Page fixtures expand dialogs, native popovers, and disclosures and focus tooltip\ntriggers so their expanded surfaces are measured; npm fixtures preserve authored initial states\nfor interaction checks.\nAudit-only fixture text stays verbatim in generated API sources and doesn't enter translation\ncatalogs; add `-docs` only when the example should also appear in documentation.\nClosed surfaces aren't evidence that their hidden contents passed. Findings are\nadvisory; failed targets, missing fixtures/assets, and incomplete execution are errors.\n\nThe same command also runs authored npm fixtures for button, link, dialog (modal), menu, tabs,\nform-field, accordion (toggle-details), tooltip, and live-region (alert). These fixtures reuse the\ntagged examples and actual production interactions, with all five audit tiers enabled. There is no\nclaimed combobox or chart coverage. A native template or generated guess never counts as a tested\nPantoken component. Read gaps and undetermined computed results separately from violations.\n\nThe npm suite packs the current workspace dependency closure locally with `vp pm pack`; it doesn't\ntest the last published version instead. Its fixture wrappers inline supplementary built styles,\nfonts, and behavior bundles only to reproduce the production cascade in the tool's HTML harness.\nThey don't implement replacement widget behavior.\n\nThese automated results do not establish that the page meets WCAG; manual review is still needed.\n\n## The modifier convention (key-value RSCSS compound)\n\n- Modifiers are `.${p}<comp>.-<prop>-<val>`, aligned to InstUI prop names\n  (`-color-secondary`, `-size-sm`, `-shape-circle`, `-variant-title-page`).\n- Booleans are the prop name alone, presence = true (`-clickable`, `-condensed`). A default-on boolean\n  toggled off **inverts**: `-without-background`, `-without-border`.\n- Sizes use one scale `-size-{xs,sm,md,lg,xl}`, emitted with both short and long spellings as\n  first-class aliases via `withSizeAliases()`.\n- Nested elements are **unprefixed short classes scoped as descendants** (`.instui-menu .item`), not\n  BEM `__`. Non-nested structural parts that can't be descendant-scoped are **flat prefixed**\n  (`.instui-badge-wrapper`). A guard test rejects `__` and `--`.\n- Avoid hyphen-then-digit tokens (`-2xs` needs escaping); keep tokens letter-leading.\n\n## Reuse an existing global utility — don't invent a parallel one\n\n`view`'s and `text`'s own key-value modifiers (background, border, shadow, display, position,\noverflow, cursor, colour, weight, size, transform, variants) are **copied** into global utilities —\nusable bare (`<div class=\"--bg-secondary\">`) or chained onto any component, core or\nplugin-authored (`<button class=\"instui-button --bg-danger\">`) — without touching the component's own\nchained modifiers, which stay exactly as authored.\n\n- **Never invent a new class word for something a global utility already covers.** If a generic\n  `bg`/`text`/`border`/`border-radius`/`border-width`/`box-shadow`/`display` utility already exists,\n  extend it (add a name, or an explicit `[name, token]` pair for a value outside its usual token\n  family) — don't author a parallel word like `-stroke-*` or a word-spelled duplicate like\n  `-border-radius-small` next to the existing `-border-radius-sm`.\n- Only a genuinely new concept (no existing global analogue) gets its own utility file — see\n  `utilities/position/`, `utilities/overflow/`, `utilities/cursor/`.\n- A global utility modifier is spelled with a **double dash** (`--bg-secondary`), never a single dash\n  (single-dash `-mod` is reserved for a component's own modifiers) — this is a deliberate,\n  non-colliding namespace split, not a stylistic choice.\n- The selector mechanism is `globalModifierSelector(p, name)` (`@pantoken/utils`):\n  `:where(*).--name.--name.--name`. A plain repeated class selector already matches _any_ element\n  carrying it — standalone, or chained onto a component, core or plugin-authored (`.instui-card`,\n  `.instui-agent-shell`) — no per-component enumeration needed; the `:where(*)` wrapper contributes\n  zero specificity of its own (documentation that this is a global modifier, not a scoping condition),\n  while the modifier class repeated 3x gives the rule (0,3,0) specificity, which deterministically\n  outranks any real 2-class component-modifier compound (`.instui-view.-mod`, 0,2,0) **regardless of\n  source/import order**. `packages/utils`'s `colorUtilitiesCss`/`tokenUtilitiesCss` build on the same\n  helper.\n- This replaced an older per-component compound-selector fan-out (`GLOBAL_ALIAS_TARGETS`/\n  `globalSelectors()`/`chainTargets`, one `.instui-<component>.-mod` selector per real core\n  component) that: couldn't reach plugin-authored components at all (the core package can't know a\n  plugin's class names at its own build time); relied on `cssdoc.jsonc`'s `globalPrecedence: \"base\"`\n  and import order for override behavior, which only ever affected generated _documentation_ merge\n  order, not real browser cascade; and didn't scale to a utility with a large modifier surface (see\n  spacing below).\n\n## Universal spacing/gap modifiers\n\n- `margin`/`padding`/`gap` utility classes (`utilities/spacing/`, `utilities/gap/`) are **universal**:\n  every registered component (core or plugin) gets the modifier for free via `globalModifierSelector`,\n  with no per-record authoring — see the mechanism above.\n- Each value ships in exactly two spellings: **short** (`--mb-sm`) and fully **long**, word-spelled\n  (`--margin-bottom-small`) — never a mixed-segment form (no `-margin-e-small`, no `-me-small`).\n- Because these modifiers are documented on the separate `spacing`/`gap` utility records, not on the\n  component they're chained onto, resolving `.instui-card.--mb-sm` requires cssdoc to fall back from\n  the base record to any record tagged `@global` — every utility record here carries that tag for\n  exactly this reason. `@cssdoc/eslint-plugin`'s `valid-class-usage` (and the shared `isModifier`/\n  `deprecationOf` lookups behind it) already do this fallback automatically; no `cssdoc.jsonc` option\n  is involved. The one real prerequisite is that whatever CSS is passed to `valid-class-usage`'s `css`\n  option still carries the doc comments (an unminified build) — the published `dist/*.css` bundles are\n  minified and strip all comments, so pointing consumer-side lint at them would flag everything, not\n  just globals.\n- If a component already sets its own `margin`/`padding`/`gap` from a component-specific token (e.g.\n  card's responsive padding, breadcrumb's `gap`), document that in `@remarks` and warn that chaining a\n  spacing/gap utility modifier overrides it — see breadcrumb, button, byline, checkbox, form-field,\n  form-field-group, form-field-messages, link, list, metric, pagination, radio, radio-input-group,\n  rating, side-nav-bar, and tag for the pattern.\n\n## Deprecated and alias modifiers (auto-discovered, always functional)\n\n- Author a modifier's metadata with `alias: \"{@link -canonical}\"` for a **pure rename** (no behavior\n  change, e.g. `-toggle` → `-variant-toggle`), or `deprecated: \"{@link -canonical}\"` for a **true\n  deprecation** (behavior changed, e.g. the color/spacing normalization renames like avatar's\n  `-color-accent*` or alert's `-variant-*`). `withAliases` reads either tag and clones each canonical\n  rule under the alias name — there is no hardcoded pairs list, and both tags render a functional twin.\n- **A deprecated or aliased modifier must be a functional alias — never a doc-only noop** (user's\n  absolute rule).\n- The docs render `@alias` as a blue \"Alias\" pill (informational rename) and `@deprecated` as a red\n  \"Deprecated\" pill (a real behavior change) — see `docs/scripts/api-badge-classes.ts`.\n- The alias post-processors run on the CSS **body only**, before the doc block is prepended, because\n  the doc block's `{@link}` braces confuse the brace-based scanners. They anchor on the base class\n  (`.instui-radio.-variant-toggle`), not the bare token, so a bare `.-canonical` match doesn't wrongly\n  clone `:not(.-canonical)` or compound rules.\n\n## `@scope`, nesting, and root targeting\n\nThe default authoring system is the `alert.css` pattern:\n\n- Use a single scoped root block: `@scope (.instui-foo) { :scope { … } }`.\n- Keep root-owned behavior nested under that root with `&` (`&::before`, `&.-variant-x`,\n  `&[class*=\"-icon-\"]`, `&:has(> .part)`).\n- Keep child-only selectors as structural descendants inside the root (`> .part`, `.part`,\n  `.part::before`) instead of restating independent top-level `:scope > ...` rules.\n- Never use functional `:scope(...)`; use standard combinators (`:scope > .part`) or nested child\n  selectors inside `:scope`.\n\nThis keeps ownership explicit (root vs descendant), reduces duplicated selector prefixes, and produces\nmore stable diffs when modifier/state branches are added.\n\nWhen you must support legacy generator behavior (`scope(root, body, children?)` in `helpers.ts`) during\nmigration, preserve semantic parity first, then normalize toward the scoped-root nested form above.\n\n`@scope`/`:is`/`:has`/`:where` are **not** namespacing tools — only a unique or prefixed name prevents\na collision. Scoping narrows intent and deep-nesting collisions; it isn't collision-proof.\n\n## Local utility `@property` values\n\nFor repeated record-local dimensions or timings (for example rail/glyph sizes), define short local custom\nproperties and register them with `@property` near the top of the file:\n\n- Use local names without global namespace prefixes when the property is record-scoped\n  (`--rail-size`, `--glyph-size`, `--duration`).\n- Keep global prefixes (`--instui-*`, `--pantoken-*`) only for truly shared cross-record/token surfaces.\n- Document internal-only utility properties with valid `@cssproperty` prose and `@readonly` markers when\n  they are not public customization API.\n\n## Icons\n\nGlyphs render via a shared `::before` mask painter (currentColor, 1em box) that matches class tokens\nstarting with `-icon-`, not arbitrary class names containing `-icon-`. A glyph class rides a host\ndirectly because `--pantoken-glyph` is a plain (non-`@property`)\ncustom prop that inherits into `::before`. So `<button class=\"instui-button -shape-square\n-icon-arrow-right\">` needs no nested icon span. Built-in component glyphs source from the shared\n`--instui-icon-<name>` tokens via an `iconMask(name)` helper.\n\n## Per-component checklist\n\nExtend the record, update the drift-checked test, update the guide (`docs/guide/components.md`), and\nadd or update a demo. Then run `vp check --fix`, the component + demo tests, `check:publish`, and\n`lint:markdown`. Browser-verify anything visual. Skip upstream tokens that are `@property`-registered\nbut value-less (being removed upstream) — don't invent them.\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_1X4OgnjD2SeQEXQb3KKgxPYH","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md b/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md\n+++ b/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md\n@@ -139,6 +139,19 @@\n member's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it.\n Use fenced HTML so audience flags remain metadata, not visible page content.\n \n+Keep one audit example per record, with distinct visual variants together: canonical colors, sizes,\n+and supported states. Don't duplicate deprecated aliases or build a Cartesian product of every\n+modifier. Include meaningful labels, selected and unselected choices, and native `disabled`,\n+`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface\n+for inverse/on-color treatments, without overriding the component's tested colors. Keep decorative\n+content hidden from assistive technology and preserve required parent/member structures.\n+\n+Stack independent cases in normal document flow instead of forcing a wide row. Expanded dialog\n+variants can use `open` so they remain measurable without one modal hiding the others. Static state\n+markup is not evidence that hover, keyboard interaction, focus movement, or announcements work:\n+those still need interaction checks and manual testing. Don't remove a supported variant or add a\n+fixture-only CSS fix to make the audit pass.\n+\n Run `vp run audit:components` from the repository root. It builds local styles and behavior bundles,\n then tests each example separately in all three themes, light and dark. Reports and the coverage\n inventory live under the gitignored `a11y-report/<run>/` directory; open `index.md` first.\n","newFileContents":"# Authoring `@pantoken/components`\n\n`@pantoken/components` is the semantic RSCSS CSS API — a parameterized generator, not hand-written\nCSS. Each documented record is one file; the bucket `index.ts` is a barrel + registry, not a monolith.\n\n## Automatic user preferences\n\nUser preferences are intrinsic behavior, not modifiers. Gate decorative transitions and animations\nwith `prefers-reduced-motion: no-preference` in each record so standalone sheets and shadow styles\nfollow the same policy. Keep loading and progress indicators visible when animation stops, and\napply state changes immediately. Interaction behaviors must also respect the live preference:\ndon't smooth-scroll, delay removal for a skipped fade, or hide progress behind a mount animation.\nDo not shorten loading timeouts or cancel announcements in the name of reducing motion.\n\nToken sheets handle color preferences in the active theme's scope. `prefers-contrast: more`\nstrengthens nonzero border widths and focus rings; `less` removes decorative elevation color without\nreducing text contrast. Keep semantic text/status colors and explicit light/dark pins intact.\nLinks gain an underline in more-contrast mode, including normally unstyled links.\n\nReduced transparency composites translucent surface tokens over an opaque semantic background.\nRemove backdrop blur in that mode, and use opaque muted colors rather than whole-control opacity for\ndisabled states. Keep intentionally empty backgrounds, image effects, and visibility transitions:\nthey aren't interchangeable with translucent component chrome. New surface expressions need coverage\nin the token preference generator and a real-browser check.\n\nIn forced colors, keep browser adjustment on surrounding components and text. Masked glyphs can use\n`forced-color-adjust: preserve-parent-color` on the painter itself, with system-color fills. Give\ngradient text a solid system-color fallback, and keep selected states visible without shadows.\nNative progress needs authored value parts and a CSS-owned indeterminate segment: suppressing CSS\nanimations alone doesn't stop the browser's built-in loading animation. Check actual rendered pixels,\nnative range semantics, and live preference changes, including RTL.\n\n## Source layout\n\n- `src/components/<name>/index.ts` + `<name>.css` (`COMPONENTS` registry).\n- `src/components/<name>/members/<member>/index.ts` + `<member>.css` — a promoted sub-component (see\n  \"Sub-components (`@memberOf`)\" below).\n- `src/utilities/<name>/index.ts` + `<name>.css` (`UTILITIES`).\n- `src/rules/{base,prose}/index.ts` + `<name>.css` (`RULES`).\n- `src/declarations/<name>/index.ts` + `<name>.css` (`DECLARATIONS`).\n- `src/lib/`: `helpers.ts` (ns/scope/glyph consts/spacing scales/`ComponentOptions`/`DEFAULT_PREFIX`),\n  `define.ts` (`defineComponent`/`defineUtility`/`defineRule`/`defineDeclaration`), `aliases.ts`\n  (`withSizeAliases`/`withAliases`), `css.ts` (the identity `css` tag), `headings.ts`,\n  `field-controls.ts`.\n\n## Sub-components (`@memberOf`)\n\nWhen a component maps to a real, separately-named instui sub-component export (`Tabs.Panel`,\n`Table.Row`, `Menu.Item`, …), promote it to its own record instead of documenting it as a `@part`\nbullet on the parent:\n\n- New files: `src/components/<parent>/members/<member>/<member>.css` + `index.ts`, same shape as any\n  other record (`defineComponent`, registered in `COMPONENTS`, exported from `src/index.ts`).\n- The record's cssdoc name is **dotted**: `@component <parent>.<member>` (e.g. `@component menu.item`)\n  — this keeps member names globally unique across the whole registry even when two different parents\n  have a same-named part (`menu.item` vs `side-nav-bar.item`), which a bare `item`/`item` collision\n  would break for the `providers`-indexed cross-file `@memberOf`/`@structure` resolution. The TS\n  identifier stays camelCase (`menuItem`/`menuItemCss`), since a dot isn't legal there anyway.\n- Add `@memberOf <parent>` on the member's own record.\n- **Always author an explicit `@class .<member>`** (or `@selector`) rather than relying on inference —\n  a member's CSS typically keeps the parent's `@scope (.pfx-<parent>) { … }` wrapper (real cascade\n  scoping, not just documentation), and inference across that boundary is unreliable; the fallback\n  className for a dotted name (`.menu.item`) would also be misleading.\n- **Physically move the CSS** into the member's own file — don't leave a doc-only record pointing at\n  rules that still live in the parent. The aggregator just concatenates raw CSS text regardless of\n  which file it came from, so this is safe even for native-element selectors with no `@scope` (e.g.\n  `table.row`'s `tr`) or where a shared declaration has to be duplicated across a couple of sibling\n  members (e.g. `table.-layout-stacked`'s box-reset, split per part rather than kept as one\n  five-selector compound rule) — cssdoc requires each record's own file to own its own selectors.\n- Remove the promoted `@part` line — a `@memberOf` record documents its own structure on its own page,\n  and `@memberOf` alone (independent of nesting in the parent's own `@structure`) already feeds the\n  parent's generated \"Subcomponents\" section.\n- Give the member's own `@structure` an `@component <parent> { … }` node instead of a bare\n  `@scope (.pfx-<parent>) { … }` wrapper — this embeds the member's real ancestor path (down to the\n  member's own selector, with any of its own nested parts) as a cross-linked record reference, e.g.\n  `@component table { tbody { tr { td {} } } }` for `table.cell`. See the `table.*` members for the\n  full pattern, including a sibling-alternation node like `table.body`'s `tbody`.\n- If a parent-level modifier restyles a promoted member (e.g. `tabs`'s `-variant-secondary` restyling\n  `tabs.tab`, or `table`'s `-layout-stacked` restyling all six of its members), mark it inline:\n  `@modifier -variant-secondary — … @affects tabs.tab — …`. Multiple `@affects <parent>.<member>`\n  markers can follow one another on the same `@modifier` line.\n- Register the member in `COMPONENTS` right after its parent, export `<member>Css` from `src/index.ts`\n  next to the parent's export, and add it to `tests/public-surface.test.ts`'s `EXPECTED` list (that\n  array is sorted before comparison, so insertion position doesn't matter). Fix any existing test that\n  asserted on the parent's `xxxCss` for content that moved to the member.\n- Don't promote a `@part` just because it's stylistically distinct — the bar is a **real, separately\n  exported instui component** (`List.Item` yes; a passive style hook like byline's `.title`/`.description`\n  or tabs' `.list`, which has no corresponding `Tabs.List` export, no).\n\n## Alternate DOM shapes (`@variant`)\n\n`@structure` supports `@variant <name>? { … }` blocks for a component that genuinely renders one of\nseveral alternative DOM shapes (e.g. a `<label>` wrapping a control vs. a `<label for>` plus a sibling\ncontrol). Only add one when a second shape is **already real and CSS-supported** — check the record's\nexisting `@example`s and rules first; don't invent a shape the component doesn't actually render. As of\nthis pass, no component in this package authors a genuine second DOM shape (things like a checkbox's\n`-label-placement-*` only reorder the same markup via CSS, which isn't a `@variant`), so none carry one.\n\n## Authoring a record\n\n```ts\nexport const foo = defineComponent({\n  name,\n  summary,\n  modifiers,\n  parts,\n  cssProperties,\n  examples,\n  structure,\n  demo,\n  css: (p) => // prettier-ignore\n  css`…css body…`,\n});\nexport const fooCss = foo.css;\n```\n\n- The doc comment is **metadata** — plain strings, no backtick/`${` escaping.\n- Only the `css` body stays a template literal. **Tag it with `css` and put a `// prettier-ignore`\n  line right before it** (before the template for a direct arrow body, before `return` for a block).\n  oxfmt treats `css` and `styled` tagged templates as embedded CSS and corrupts interpolated\n  selectors (`${p}foo.-mod` → `${p}foo .-mod`, a different meaning) otherwise. Setting\n  `embeddedLanguageFormatting` to off does **not** stop it. See the engineering log.\n- Add the record to its bucket `index.ts`. For `COMPONENTS` the order is **load-bearing** — it matches\n  the `componentsCss()` concat order, not alphabetical.\n\n## Example Audiences\n\nUse `-canvas-rce` for the HTML inserted when Include interactions is enabled, and\n`-canvas-rce-no-interactions` for its static counterpart when interactions are disabled. For\nexample, a banner or alert can include a close button in the first example and omit it in the\nsecond. The selector reads the current setting at insertion time and leaves existing content alone.\nComponents without the new flag retain their previous example fallback. Add `-docs` to examples\nthat should also render in documentation; `-automatica11y` remains independent.\n\n### Accessibility audit examples\n\nEvery record in the component registry, including member records, has an explicit\n`@example -automatica11y` block. The audit never falls back to Canvas or docs examples. Keep a\nmember's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it.\nUse fenced HTML so audience flags remain metadata, not visible page content.\n\nKeep one audit example per record, with distinct visual variants together: canonical colors, sizes,\nand supported states. Don't duplicate deprecated aliases or build a Cartesian product of every\nmodifier. Include meaningful labels, selected and unselected choices, and native `disabled`,\n`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface\nfor inverse/on-color treatments, without overriding the component's tested colors. Keep decorative\ncontent hidden from assistive technology and preserve required parent/member structures.\n\nStack independent cases in normal document flow instead of forcing a wide row. Expanded dialog\nvariants can use `open` so they remain measurable without one modal hiding the others. Static state\nmarkup is not evidence that hover, keyboard interaction, focus movement, or announcements work:\nthose still need interaction checks and manual testing. Don't remove a supported variant or add a\nfixture-only CSS fix to make the audit pass.\n\nRun `vp run audit:components` from the repository root. It builds local styles and behavior bundles,\nthen tests each example separately in all three themes, light and dark. Reports and the coverage\ninventory live under the gitignored `a11y-report/<run>/` directory; open `index.md` first.\nUse `vp run audit:components --record button` for a focused reproduction.\n\nThe page suite runs both axe-core and IBM Equal Access against WCAG 2.2 AA, conditions checks, and\n**simulated** screen-reader checks. Page audits don't exercise archetype-specific interactions or\ncomputed checks. Page fixtures expand dialogs, native popovers, and disclosures and focus tooltip\ntriggers so their expanded surfaces are measured; npm fixtures preserve authored initial states\nfor interaction checks.\nAudit-only fixture text stays verbatim in generated API sources and doesn't enter translation\ncatalogs; add `-docs` only when the example should also appear in documentation.\nClosed surfaces aren't evidence that their hidden contents passed. Findings are\nadvisory; failed targets, missing fixtures/assets, and incomplete execution are errors.\n\nThe same command also runs authored npm fixtures for button, link, dialog (modal), menu, tabs,\nform-field, accordion (toggle-details), tooltip, and live-region (alert). These fixtures reuse the\ntagged examples and actual production interactions, with all five audit tiers enabled. There is no\nclaimed combobox or chart coverage. A native template or generated guess never counts as a tested\nPantoken component. Read gaps and undetermined computed results separately from violations.\n\nThe npm suite packs the current workspace dependency closure locally with `vp pm pack`; it doesn't\ntest the last published version instead. Its fixture wrappers inline supplementary built styles,\nfonts, and behavior bundles only to reproduce the production cascade in the tool's HTML harness.\nThey don't implement replacement widget behavior.\n\nThese automated results do not establish that the page meets WCAG; manual review is still needed.\n\n## The modifier convention (key-value RSCSS compound)\n\n- Modifiers are `.${p}<comp>.-<prop>-<val>`, aligned to InstUI prop names\n  (`-color-secondary`, `-size-sm`, `-shape-circle`, `-variant-title-page`).\n- Booleans are the prop name alone, presence = true (`-clickable`, `-condensed`). A default-on boolean\n  toggled off **inverts**: `-without-background`, `-without-border`.\n- Sizes use one scale `-size-{xs,sm,md,lg,xl}`, emitted with both short and long spellings as\n  first-class aliases via `withSizeAliases()`.\n- Nested elements are **unprefixed short classes scoped as descendants** (`.instui-menu .item`), not\n  BEM `__`. Non-nested structural parts that can't be descendant-scoped are **flat prefixed**\n  (`.instui-badge-wrapper`). A guard test rejects `__` and `--`.\n- Avoid hyphen-then-digit tokens (`-2xs` needs escaping); keep tokens letter-leading.\n\n## Reuse an existing global utility — don't invent a parallel one\n\n`view`'s and `text`'s own key-value modifiers (background, border, shadow, display, position,\noverflow, cursor, colour, weight, size, transform, variants) are **copied** into global utilities —\nusable bare (`<div class=\"--bg-secondary\">`) or chained onto any component, core or\nplugin-authored (`<button class=\"instui-button --bg-danger\">`) — without touching the component's own\nchained modifiers, which stay exactly as authored.\n\n- **Never invent a new class word for something a global utility already covers.** If a generic\n  `bg`/`text`/`border`/`border-radius`/`border-width`/`box-shadow`/`display` utility already exists,\n  extend it (add a name, or an explicit `[name, token]` pair for a value outside its usual token\n  family) — don't author a parallel word like `-stroke-*` or a word-spelled duplicate like\n  `-border-radius-small` next to the existing `-border-radius-sm`.\n- Only a genuinely new concept (no existing global analogue) gets its own utility file — see\n  `utilities/position/`, `utilities/overflow/`, `utilities/cursor/`.\n- A global utility modifier is spelled with a **double dash** (`--bg-secondary`), never a single dash\n  (single-dash `-mod` is reserved for a component's own modifiers) — this is a deliberate,\n  non-colliding namespace split, not a stylistic choice.\n- The selector mechanism is `globalModifierSelector(p, name)` (`@pantoken/utils`):\n  `:where(*).--name.--name.--name`. A plain repeated class selector already matches _any_ element\n  carrying it — standalone, or chained onto a component, core or plugin-authored (`.instui-card`,\n  `.instui-agent-shell`) — no per-component enumeration needed; the `:where(*)` wrapper contributes\n  zero specificity of its own (documentation that this is a global modifier, not a scoping condition),\n  while the modifier class repeated 3x gives the rule (0,3,0) specificity, which deterministically\n  outranks any real 2-class component-modifier compound (`.instui-view.-mod`, 0,2,0) **regardless of\n  source/import order**. `packages/utils`'s `colorUtilitiesCss`/`tokenUtilitiesCss` build on the same\n  helper.\n- This replaced an older per-component compound-selector fan-out (`GLOBAL_ALIAS_TARGETS`/\n  `globalSelectors()`/`chainTargets`, one `.instui-<component>.-mod` selector per real core\n  component) that: couldn't reach plugin-authored components at all (the core package can't know a\n  plugin's class names at its own build time); relied on `cssdoc.jsonc`'s `globalPrecedence: \"base\"`\n  and import order for override behavior, which only ever affected generated _documentation_ merge\n  order, not real browser cascade; and didn't scale to a utility with a large modifier surface (see\n  spacing below).\n\n## Universal spacing/gap modifiers\n\n- `margin`/`padding`/`gap` utility classes (`utilities/spacing/`, `utilities/gap/`) are **universal**:\n  every registered component (core or plugin) gets the modifier for free via `globalModifierSelector`,\n  with no per-record authoring — see the mechanism above.\n- Each value ships in exactly two spellings: **short** (`--mb-sm`) and fully **long**, word-spelled\n  (`--margin-bottom-small`) — never a mixed-segment form (no `-margin-e-small`, no `-me-small`).\n- Because these modifiers are documented on the separate `spacing`/`gap` utility records, not on the\n  component they're chained onto, resolving `.instui-card.--mb-sm` requires cssdoc to fall back from\n  the base record to any record tagged `@global` — every utility record here carries that tag for\n  exactly this reason. `@cssdoc/eslint-plugin`'s `valid-class-usage` (and the shared `isModifier`/\n  `deprecationOf` lookups behind it) already do this fallback automatically; no `cssdoc.jsonc` option\n  is involved. The one real prerequisite is that whatever CSS is passed to `valid-class-usage`'s `css`\n  option still carries the doc comments (an unminified build) — the published `dist/*.css` bundles are\n  minified and strip all comments, so pointing consumer-side lint at them would flag everything, not\n  just globals.\n- If a component already sets its own `margin`/`padding`/`gap` from a component-specific token (e.g.\n  card's responsive padding, breadcrumb's `gap`), document that in `@remarks` and warn that chaining a\n  spacing/gap utility modifier overrides it — see breadcrumb, button, byline, checkbox, form-field,\n  form-field-group, form-field-messages, link, list, metric, pagination, radio, radio-input-group,\n  rating, side-nav-bar, and tag for the pattern.\n\n## Deprecated and alias modifiers (auto-discovered, always functional)\n\n- Author a modifier's metadata with `alias: \"{@link -canonical}\"` for a **pure rename** (no behavior\n  change, e.g. `-toggle` → `-variant-toggle`), or `deprecated: \"{@link -canonical}\"` for a **true\n  deprecation** (behavior changed, e.g. the color/spacing normalization renames like avatar's\n  `-color-accent*` or alert's `-variant-*`). `withAliases` reads either tag and clones each canonical\n  rule under the alias name — there is no hardcoded pairs list, and both tags render a functional twin.\n- **A deprecated or aliased modifier must be a functional alias — never a doc-only noop** (user's\n  absolute rule).\n- The docs render `@alias` as a blue \"Alias\" pill (informational rename) and `@deprecated` as a red\n  \"Deprecated\" pill (a real behavior change) — see `docs/scripts/api-badge-classes.ts`.\n- The alias post-processors run on the CSS **body only**, before the doc block is prepended, because\n  the doc block's `{@link}` braces confuse the brace-based scanners. They anchor on the base class\n  (`.instui-radio.-variant-toggle`), not the bare token, so a bare `.-canonical` match doesn't wrongly\n  clone `:not(.-canonical)` or compound rules.\n\n## `@scope`, nesting, and root targeting\n\nThe default authoring system is the `alert.css` pattern:\n\n- Use a single scoped root block: `@scope (.instui-foo) { :scope { … } }`.\n- Keep root-owned behavior nested under that root with `&` (`&::before`, `&.-variant-x`,\n  `&[class*=\"-icon-\"]`, `&:has(> .part)`).\n- Keep child-only selectors as structural descendants inside the root (`> .part`, `.part`,\n  `.part::before`) instead of restating independent top-level `:scope > ...` rules.\n- Never use functional `:scope(...)`; use standard combinators (`:scope > .part`) or nested child\n  selectors inside `:scope`.\n\nThis keeps ownership explicit (root vs descendant), reduces duplicated selector prefixes, and produces\nmore stable diffs when modifier/state branches are added.\n\nWhen you must support legacy generator behavior (`scope(root, body, children?)` in `helpers.ts`) during\nmigration, preserve semantic parity first, then normalize toward the scoped-root nested form above.\n\n`@scope`/`:is`/`:has`/`:where` are **not** namespacing tools — only a unique or prefixed name prevents\na collision. Scoping narrows intent and deep-nesting collisions; it isn't collision-proof.\n\n## Local utility `@property` values\n\nFor repeated record-local dimensions or timings (for example rail/glyph sizes), define short local custom\nproperties and register them with `@property` near the top of the file:\n\n- Use local names without global namespace prefixes when the property is record-scoped\n  (`--rail-size`, `--glyph-size`, `--duration`).\n- Keep global prefixes (`--instui-*`, `--pantoken-*`) only for truly shared cross-record/token surfaces.\n- Document internal-only utility properties with valid `@cssproperty` prose and `@readonly` markers when\n  they are not public customization API.\n\n## Icons\n\nGlyphs render via a shared `::before` mask painter (currentColor, 1em box) that matches class tokens\nstarting with `-icon-`, not arbitrary class names containing `-icon-`. A glyph class rides a host\ndirectly because `--pantoken-glyph` is a plain (non-`@property`)\ncustom prop that inherits into `::before`. So `<button class=\"instui-button -shape-square\n-icon-arrow-right\">` needs no nested icon span. Built-in component glyphs source from the shared\n`--instui-icon-<name>` tokens via an `iconMask(name)` helper.\n\n## Per-component checklist\n\nExtend the record, update the drift-checked test, update the guide (`docs/guide/components.md`), and\nadd or update a demo. Then run `vp check --fix`, the component + demo tests, `check:publish`, and\n`lint:markdown`. Browser-verify anything visual. Skip upstream tokens that are `@property`-registered\nbut value-less (being removed upstream) — don't invent them.\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md","content":"# Authoring `@pantoken/components`\n\n`@pantoken/components` is the semantic RSCSS CSS API — a parameterized generator, not hand-written\nCSS. Each documented record is one file; the bucket `index.ts` is a barrel + registry, not a monolith.\n\n## Automatic user preferences\n\nUser preferences are intrinsic behavior, not modifiers. Gate decorative transitions and animations\nwith `prefers-reduced-motion: no-preference` in each record so standalone sheets and shadow styles\nfollow the same policy. Keep loading and progress indicators visible when animation stops, and\napply state changes immediately. Interaction behaviors must also respect the live preference:\ndon't smooth-scroll, delay removal for a skipped fade, or hide progress behind a mount animation.\nDo not shorten loading timeouts or cancel announcements in the name of reducing motion.\n\nToken sheets handle color preferences in the active theme's scope. `prefers-contrast: more`\nstrengthens nonzero border widths and focus rings; `less` removes decorative elevation color without\nreducing text contrast. Keep semantic text/status colors and explicit light/dark pins intact.\nLinks gain an underline in more-contrast mode, including normally unstyled links.\n\nReduced transparency composites translucent surface tokens over an opaque semantic background.\nRemove backdrop blur in that mode, and use opaque muted colors rather than whole-control opacity for\ndisabled states. Keep intentionally empty backgrounds, image effects, and visibility transitions:\nthey aren't interchangeable with translucent component chrome. New surface expressions need coverage\nin the token preference generator and a real-browser check.\n\nIn forced colors, keep browser adjustment on surrounding components and text. Masked glyphs can use\n`forced-color-adjust: preserve-parent-color` on the painter itself, with system-color fills. Give\ngradient text a solid system-color fallback, and keep selected states visible without shadows.\nNative progress needs authored value parts and a CSS-owned indeterminate segment: suppressing CSS\nanimations alone doesn't stop the browser's built-in loading animation. Check actual rendered pixels,\nnative range semantics, and live preference changes, including RTL.\n\n## Source layout\n\n- `src/components/<name>/index.ts` + `<name>.css` (`COMPONENTS` registry).\n- `src/components/<name>/members/<member>/index.ts` + `<member>.css` — a promoted sub-component (see\n  \"Sub-components (`@memberOf`)\" below).\n- `src/utilities/<name>/index.ts` + `<name>.css` (`UTILITIES`).\n- `src/rules/{base,prose}/index.ts` + `<name>.css` (`RULES`).\n- `src/declarations/<name>/index.ts` + `<name>.css` (`DECLARATIONS`).\n- `src/lib/`: `helpers.ts` (ns/scope/glyph consts/spacing scales/`ComponentOptions`/`DEFAULT_PREFIX`),\n  `define.ts` (`defineComponent`/`defineUtility`/`defineRule`/`defineDeclaration`), `aliases.ts`\n  (`withSizeAliases`/`withAliases`), `css.ts` (the identity `css` tag), `headings.ts`,\n  `field-controls.ts`.\n\n## Sub-components (`@memberOf`)\n\nWhen a component maps to a real, separately-named instui sub-component export (`Tabs.Panel`,\n`Table.Row`, `Menu.Item`, …), promote it to its own record instead of documenting it as a `@part`\nbullet on the parent:\n\n- New files: `src/components/<parent>/members/<member>/<member>.css` + `index.ts`, same shape as any\n  other record (`defineComponent`, registered in `COMPONENTS`, exported from `src/index.ts`).\n- The record's cssdoc name is **dotted**: `@component <parent>.<member>` (e.g. `@component menu.item`)\n  — this keeps member names globally unique across the whole registry even when two different parents\n  have a same-named part (`menu.item` vs `side-nav-bar.item`), which a bare `item`/`item` collision\n  would break for the `providers`-indexed cross-file `@memberOf`/`@structure` resolution. The TS\n  identifier stays camelCase (`menuItem`/`menuItemCss`), since a dot isn't legal there anyway.\n- Add `@memberOf <parent>` on the member's own record.\n- **Always author an explicit `@class .<member>`** (or `@selector`) rather than relying on inference —\n  a member's CSS typically keeps the parent's `@scope (.pfx-<parent>) { … }` wrapper (real cascade\n  scoping, not just documentation), and inference across that boundary is unreliable; the fallback\n  className for a dotted name (`.menu.item`) would also be misleading.\n- **Physically move the CSS** into the member's own file — don't leave a doc-only record pointing at\n  rules that still live in the parent. The aggregator just concatenates raw CSS text regardless of\n  which file it came from, so this is safe even for native-element selectors with no `@scope` (e.g.\n  `table.row`'s `tr`) or where a shared declaration has to be duplicated across a couple of sibling\n  members (e.g. `table.-layout-stacked`'s box-reset, split per part rather than kept as one\n  five-selector compound rule) — cssdoc requires each record's own file to own its own selectors.\n- Remove the promoted `@part` line — a `@memberOf` record documents its own structure on its own page,\n  and `@memberOf` alone (independent of nesting in the parent's own `@structure`) already feeds the\n  parent's generated \"Subcomponents\" section.\n- Give the member's own `@structure` an `@component <parent> { … }` node instead of a bare\n  `@scope (.pfx-<parent>) { … }` wrapper — this embeds the member's real ancestor path (down to the\n  member's own selector, with any of its own nested parts) as a cross-linked record reference, e.g.\n  `@component table { tbody { tr { td {} } } }` for `table.cell`. See the `table.*` members for the\n  full pattern, including a sibling-alternation node like `table.body`'s `tbody`.\n- If a parent-level modifier restyles a promoted member (e.g. `tabs`'s `-variant-secondary` restyling\n  `tabs.tab`, or `table`'s `-layout-stacked` restyling all six of its members), mark it inline:\n  `@modifier -variant-secondary — … @affects tabs.tab — …`. Multiple `@affects <parent>.<member>`\n  markers can follow one another on the same `@modifier` line.\n- Register the member in `COMPONENTS` right after its parent, export `<member>Css` from `src/index.ts`\n  next to the parent's export, and add it to `tests/public-surface.test.ts`'s `EXPECTED` list (that\n  array is sorted before comparison, so insertion position doesn't matter). Fix any existing test that\n  asserted on the parent's `xxxCss` for content that moved to the member.\n- Don't promote a `@part` just because it's stylistically distinct — the bar is a **real, separately\n  exported instui component** (`List.Item` yes; a passive style hook like byline's `.title`/`.description`\n  or tabs' `.list`, which has no corresponding `Tabs.List` export, no).\n\n## Alternate DOM shapes (`@variant`)\n\n`@structure` supports `@variant <name>? { … }` blocks for a component that genuinely renders one of\nseveral alternative DOM shapes (e.g. a `<label>` wrapping a control vs. a `<label for>` plus a sibling\ncontrol). Only add one when a second shape is **already real and CSS-supported** — check the record's\nexisting `@example`s and rules first; don't invent a shape the component doesn't actually render. As of\nthis pass, no component in this package authors a genuine second DOM shape (things like a checkbox's\n`-label-placement-*` only reorder the same markup via CSS, which isn't a `@variant`), so none carry one.\n\n## Authoring a record\n\n```ts\nexport const foo = defineComponent({\n  name,\n  summary,\n  modifiers,\n  parts,\n  cssProperties,\n  examples,\n  structure,\n  demo,\n  css: (p) => // prettier-ignore\n  css`…css body…`,\n});\nexport const fooCss = foo.css;\n```\n\n- The doc comment is **metadata** — plain strings, no backtick/`${` escaping.\n- Only the `css` body stays a template literal. **Tag it with `css` and put a `// prettier-ignore`\n  line right before it** (before the template for a direct arrow body, before `return` for a block).\n  oxfmt treats `css` and `styled` tagged templates as embedded CSS and corrupts interpolated\n  selectors (`${p}foo.-mod` → `${p}foo .-mod`, a different meaning) otherwise. Setting\n  `embeddedLanguageFormatting` to off does **not** stop it. See the engineering log.\n- Add the record to its bucket `index.ts`. For `COMPONENTS` the order is **load-bearing** — it matches\n  the `componentsCss()` concat order, not alphabetical.\n\n## Example Audiences\n\nUse `-canvas-rce` for the HTML inserted when Include interactions is enabled, and\n`-canvas-rce-no-interactions` for its static counterpart when interactions are disabled. For\nexample, a banner or alert can include a close button in the first example and omit it in the\nsecond. The selector reads the current setting at insertion time and leaves existing content alone.\nComponents without the new flag retain their previous example fallback. Add `-docs` to examples\nthat should also render in documentation; `-automatica11y` remains independent.\n\n### Accessibility audit examples\n\nEvery record in the component registry, including member records, has an explicit\n`@example -automatica11y` block. The audit never falls back to Canvas or docs examples. Keep a\nmember's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it.\nUse fenced HTML so audience flags remain metadata, not visible page content.\n\nRun `vp run audit:components` from the repository root. It builds local styles and behavior bundles,\nthen tests each example separately in all three themes, light and dark. Reports and the coverage\ninventory live under the gitignored `a11y-report/<run>/` directory; open `index.md` first.\nUse `vp run audit:components --record button` for a focused reproduction.\n\nThe page suite runs both axe-core and IBM Equal Access against WCAG 2.2 AA, conditions checks, and\n**simulated** screen-reader checks. Page audits don't exercise archetype-specific interactions or\ncomputed checks. Page fixtures expand dialogs, native popovers, and disclosures and focus tooltip\ntriggers so their expanded surfaces are measured; npm fixtures preserve authored initial states\nfor interaction checks.\nAudit-only fixture text stays verbatim in generated API sources and doesn't enter translation\ncatalogs; add `-docs` only when the example should also appear in documentation.\nClosed surfaces aren't evidence that their hidden contents passed. Findings are\nadvisory; failed targets, missing fixtures/assets, and incomplete execution are errors.\n\nThe same command also runs authored npm fixtures for button, link, dialog (modal), menu, tabs,\nform-field, accordion (toggle-details), tooltip, and live-region (alert). These fixtures reuse the\ntagged examples and actual production interactions, with all five audit tiers enabled. There is no\nclaimed combobox or chart coverage. A native template or generated guess never counts as a tested\nPantoken component. Read gaps and undetermined computed results separately from violations.\n\nThe npm suite packs the current workspace dependency closure locally with `vp pm pack`; it doesn't\ntest the last published version instead. Its fixture wrappers inline supplementary built styles,\nfonts, and behavior bundles only to reproduce the production cascade in the tool's HTML harness.\nThey don't implement replacement widget behavior.\n\nThese automated results do not establish that the page meets WCAG; manual review is still needed.\n\n## The modifier convention (key-value RSCSS compound)\n\n- Modifiers are `.${p}<comp>.-<prop>-<val>`, aligned to InstUI prop names\n  (`-color-secondary`, `-size-sm`, `-shape-circle`, `-variant-title-page`).\n- Booleans are the prop name alone, presence = true (`-clickable`, `-condensed`). A default-on boolean\n  toggled off **inverts**: `-without-background`, `-without-border`.\n- Sizes use one scale `-size-{xs,sm,md,lg,xl}`, emitted with both short and long spellings as\n  first-class aliases via `withSizeAliases()`.\n- Nested elements are **unprefixed short classes scoped as descendants** (`.instui-menu .item`), not\n  BEM `__`. Non-nested structural parts that can't be descendant-scoped are **flat prefixed**\n  (`.instui-badge-wrapper`). A guard test rejects `__` and `--`.\n- Avoid hyphen-then-digit tokens (`-2xs` needs escaping); keep tokens letter-leading.\n\n## Reuse an existing global utility — don't invent a parallel one\n\n`view`'s and `text`'s own key-value modifiers (background, border, shadow, display, position,\noverflow, cursor, colour, weight, size, transform, variants) are **copied** into global utilities —\nusable bare (`<div class=\"--bg-secondary\">`) or chained onto any component, core or\nplugin-authored (`<button class=\"instui-button --bg-danger\">`) — without touching the component's own\nchained modifiers, which stay exactly as authored.\n\n- **Never invent a new class word for something a global utility already covers.** If a generic\n  `bg`/`text`/`border`/`border-radius`/`border-width`/`box-shadow`/`display` utility already exists,\n  extend it (add a name, or an explicit `[name, token]` pair for a value outside its usual token\n  family) — don't author a parallel word like `-stroke-*` or a word-spelled duplicate like\n  `-border-radius-small` next to the existing `-border-radius-sm`.\n- Only a genuinely new concept (no existing global analogue) gets its own utility file — see\n  `utilities/position/`, `utilities/overflow/`, `utilities/cursor/`.\n- A global utility modifier is spelled with a **double dash** (`--bg-secondary`), never a single dash\n  (single-dash `-mod` is reserved for a component's own modifiers) — this is a deliberate,\n  non-colliding namespace split, not a stylistic choice.\n- The selector mechanism is `globalModifierSelector(p, name)` (`@pantoken/utils`):\n  `:where(*).--name.--name.--name`. A plain repeated class selector already matches _any_ element\n  carrying it — standalone, or chained onto a component, core or plugin-authored (`.instui-card`,\n  `.instui-agent-shell`) — no per-component enumeration needed; the `:where(*)` wrapper contributes\n  zero specificity of its own (documentation that this is a global modifier, not a scoping condition),\n  while the modifier class repeated 3x gives the rule (0,3,0) specificity, which deterministically\n  outranks any real 2-class component-modifier compound (`.instui-view.-mod`, 0,2,0) **regardless of\n  source/import order**. `packages/utils`'s `colorUtilitiesCss`/`tokenUtilitiesCss` build on the same\n  helper.\n- This replaced an older per-component compound-selector fan-out (`GLOBAL_ALIAS_TARGETS`/\n  `globalSelectors()`/`chainTargets`, one `.instui-<component>.-mod` selector per real core\n  component) that: couldn't reach plugin-authored components at all (the core package can't know a\n  plugin's class names at its own build time); relied on `cssdoc.jsonc`'s `globalPrecedence: \"base\"`\n  and import order for override behavior, which only ever affected generated _documentation_ merge\n  order, not real browser cascade; and didn't scale to a utility with a large modifier surface (see\n  spacing below).\n\n## Universal spacing/gap modifiers\n\n- `margin`/`padding`/`gap` utility classes (`utilities/spacing/`, `utilities/gap/`) are **universal**:\n  every registered component (core or plugin) gets the modifier for free via `globalModifierSelector`,\n  with no per-record authoring — see the mechanism above.\n- Each value ships in exactly two spellings: **short** (`--mb-sm`) and fully **long**, word-spelled\n  (`--margin-bottom-small`) — never a mixed-segment form (no `-margin-e-small`, no `-me-small`).\n- Because these modifiers are documented on the separate `spacing`/`gap` utility records, not on the\n  component they're chained onto, resolving `.instui-card.--mb-sm` requires cssdoc to fall back from\n  the base record to any record tagged `@global` — every utility record here carries that tag for\n  exactly this reason. `@cssdoc/eslint-plugin`'s `valid-class-usage` (and the shared `isModifier`/\n  `deprecationOf` lookups behind it) already do this fallback automatically; no `cssdoc.jsonc` option\n  is involved. The one real prerequisite is that whatever CSS is passed to `valid-class-usage`'s `css`\n  option still carries the doc comments (an unminified build) — the published `dist/*.css` bundles are\n  minified and strip all comments, so pointing consumer-side lint at them would flag everything, not\n  just globals.\n- If a component already sets its own `margin`/`padding`/`gap` from a component-specific token (e.g.\n  card's responsive padding, breadcrumb's `gap`), document that in `@remarks` and warn that chaining a\n  spacing/gap utility modifier overrides it — see breadcrumb, button, byline, checkbox, form-field,\n  form-field-group, form-field-messages, link, list, metric, pagination, radio, radio-input-group,\n  rating, side-nav-bar, and tag for the pattern.\n\n## Deprecated and alias modifiers (auto-discovered, always functional)\n\n- Author a modifier's metadata with `alias: \"{@link -canonical}\"` for a **pure rename** (no behavior\n  change, e.g. `-toggle` → `-variant-toggle`), or `deprecated: \"{@link -canonical}\"` for a **true\n  deprecation** (behavior changed, e.g. the color/spacing normalization renames like avatar's\n  `-color-accent*` or alert's `-variant-*`). `withAliases` reads either tag and clones each canonical\n  rule under the alias name — there is no hardcoded pairs list, and both tags render a functional twin.\n- **A deprecated or aliased modifier must be a functional alias — never a doc-only noop** (user's\n  absolute rule).\n- The docs render `@alias` as a blue \"Alias\" pill (informational rename) and `@deprecated` as a red\n  \"Deprecated\" pill (a real behavior change) — see `docs/scripts/api-badge-classes.ts`.\n- The alias post-processors run on the CSS **body only**, before the doc block is prepended, because\n  the doc block's `{@link}` braces confuse the brace-based scanners. They anchor on the base class\n  (`.instui-radio.-variant-toggle`), not the bare token, so a bare `.-canonical` match doesn't wrongly\n  clone `:not(.-canonical)` or compound rules.\n\n## `@scope`, nesting, and root targeting\n\nThe default authoring system is the `alert.css` pattern:\n\n- Use a single scoped root block: `@scope (.instui-foo) { :scope { … } }`.\n- Keep root-owned behavior nested under that root with `&` (`&::before`, `&.-variant-x`,\n  `&[class*=\"-icon-\"]`, `&:has(> .part)`).\n- Keep child-only selectors as structural descendants inside the root (`> .part`, `.part`,\n  `.part::before`) instead of restating independent top-level `:scope > ...` rules.\n- Never use functional `:scope(...)`; use standard combinators (`:scope > .part`) or nested child\n  selectors inside `:scope`.\n\nThis keeps ownership explicit (root vs descendant), reduces duplicated selector prefixes, and produces\nmore stable diffs when modifier/state branches are added.\n\nWhen you must support legacy generator behavior (`scope(root, body, children?)` in `helpers.ts`) during\nmigration, preserve semantic parity first, then normalize toward the scoped-root nested form above.\n\n`@scope`/`:is`/`:has`/`:where` are **not** namespacing tools — only a unique or prefixed name prevents\na collision. Scoping narrows intent and deep-nesting collisions; it isn't collision-proof.\n\n## Local utility `@property` values\n\nFor repeated record-local dimensions or timings (for example rail/glyph sizes), define short local custom\nproperties and register them with `@property` near the top of the file:\n\n- Use local names without global namespace prefixes when the property is record-scoped\n  (`--rail-size`, `--glyph-size`, `--duration`).\n- Keep global prefixes (`--instui-*`, `--pantoken-*`) only for truly shared cross-record/token surfaces.\n- Document internal-only utility properties with valid `@cssproperty` prose and `@readonly` markers when\n  they are not public customization API.\n\n## Icons\n\nGlyphs render via a shared `::before` mask painter (currentColor, 1em box) that matches class tokens\nstarting with `-icon-`, not arbitrary class names containing `-icon-`. A glyph class rides a host\ndirectly because `--pantoken-glyph` is a plain (non-`@property`)\ncustom prop that inherits into `::before`. So `<button class=\"instui-button -shape-square\n-icon-arrow-right\">` needs no nested icon span. Built-in component glyphs source from the shared\n`--instui-icon-<name>` tokens via an `iconMask(name)` helper.\n\n## Per-component checklist\n\nExtend the record, update the drift-checked test, update the guide (`docs/guide/components.md`), and\nadd or update a demo. Then run `vp check --fix`, the component + demo tests, `check:publish`, and\n`lint:markdown`. Browser-verify anything visual. Skip upstream tokens that are `@property`-registered\nbut value-less (being removed upstream) — don't invent them.\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md","content":"# Authoring `@pantoken/components`\n\n`@pantoken/components` is the semantic RSCSS CSS API — a parameterized generator, not hand-written\nCSS. Each documented record is one file; the bucket `index.ts` is a barrel + registry, not a monolith.\n\n## Automatic user preferences\n\nUser preferences are intrinsic behavior, not modifiers. Gate decorative transitions and animations\nwith `prefers-reduced-motion: no-preference` in each record so standalone sheets and shadow styles\nfollow the same policy. Keep loading and progress indicators visible when animation stops, and\napply state changes immediately. Interaction behaviors must also respect the live preference:\ndon't smooth-scroll, delay removal for a skipped fade, or hide progress behind a mount animation.\nDo not shorten loading timeouts or cancel announcements in the name of reducing motion.\n\nToken sheets handle color preferences in the active theme's scope. `prefers-contrast: more`\nstrengthens nonzero border widths and focus rings; `less` removes decorative elevation color without\nreducing text contrast. Keep semantic text/status colors and explicit light/dark pins intact.\nLinks gain an underline in more-contrast mode, including normally unstyled links.\n\nReduced transparency composites translucent surface tokens over an opaque semantic background.\nRemove backdrop blur in that mode, and use opaque muted colors rather than whole-control opacity for\ndisabled states. Keep intentionally empty backgrounds, image effects, and visibility transitions:\nthey aren't interchangeable with translucent component chrome. New surface expressions need coverage\nin the token preference generator and a real-browser check.\n\nIn forced colors, keep browser adjustment on surrounding components and text. Masked glyphs can use\n`forced-color-adjust: preserve-parent-color` on the painter itself, with system-color fills. Give\ngradient text a solid system-color fallback, and keep selected states visible without shadows.\nNative progress needs authored value parts and a CSS-owned indeterminate segment: suppressing CSS\nanimations alone doesn't stop the browser's built-in loading animation. Check actual rendered pixels,\nnative range semantics, and live preference changes, including RTL.\n\n## Source layout\n\n- `src/components/<name>/index.ts` + `<name>.css` (`COMPONENTS` registry).\n- `src/components/<name>/members/<member>/index.ts` + `<member>.css` — a promoted sub-component (see\n  \"Sub-components (`@memberOf`)\" below).\n- `src/utilities/<name>/index.ts` + `<name>.css` (`UTILITIES`).\n- `src/rules/{base,prose}/index.ts` + `<name>.css` (`RULES`).\n- `src/declarations/<name>/index.ts` + `<name>.css` (`DECLARATIONS`).\n- `src/lib/`: `helpers.ts` (ns/scope/glyph consts/spacing scales/`ComponentOptions`/`DEFAULT_PREFIX`),\n  `define.ts` (`defineComponent`/`defineUtility`/`defineRule`/`defineDeclaration`), `aliases.ts`\n  (`withSizeAliases`/`withAliases`), `css.ts` (the identity `css` tag), `headings.ts`,\n  `field-controls.ts`.\n\n## Sub-components (`@memberOf`)\n\nWhen a component maps to a real, separately-named instui sub-component export (`Tabs.Panel`,\n`Table.Row`, `Menu.Item`, …), promote it to its own record instead of documenting it as a `@part`\nbullet on the parent:\n\n- New files: `src/components/<parent>/members/<member>/<member>.css` + `index.ts`, same shape as any\n  other record (`defineComponent`, registered in `COMPONENTS`, exported from `src/index.ts`).\n- The record's cssdoc name is **dotted**: `@component <parent>.<member>` (e.g. `@component menu.item`)\n  — this keeps member names globally unique across the whole registry even when two different parents\n  have a same-named part (`menu.item` vs `side-nav-bar.item`), which a bare `item`/`item` collision\n  would break for the `providers`-indexed cross-file `@memberOf`/`@structure` resolution. The TS\n  identifier stays camelCase (`menuItem`/`menuItemCss`), since a dot isn't legal there anyway.\n- Add `@memberOf <parent>` on the member's own record.\n- **Always author an explicit `@class .<member>`** (or `@selector`) rather than relying on inference —\n  a member's CSS typically keeps the parent's `@scope (.pfx-<parent>) { … }` wrapper (real cascade\n  scoping, not just documentation), and inference across that boundary is unreliable; the fallback\n  className for a dotted name (`.menu.item`) would also be misleading.\n- **Physically move the CSS** into the member's own file — don't leave a doc-only record pointing at\n  rules that still live in the parent. The aggregator just concatenates raw CSS text regardless of\n  which file it came from, so this is safe even for native-element selectors with no `@scope` (e.g.\n  `table.row`'s `tr`) or where a shared declaration has to be duplicated across a couple of sibling\n  members (e.g. `table.-layout-stacked`'s box-reset, split per part rather than kept as one\n  five-selector compound rule) — cssdoc requires each record's own file to own its own selectors.\n- Remove the promoted `@part` line — a `@memberOf` record documents its own structure on its own page,\n  and `@memberOf` alone (independent of nesting in the parent's own `@structure`) already feeds the\n  parent's generated \"Subcomponents\" section.\n- Give the member's own `@structure` an `@component <parent> { … }` node instead of a bare\n  `@scope (.pfx-<parent>) { … }` wrapper — this embeds the member's real ancestor path (down to the\n  member's own selector, with any of its own nested parts) as a cross-linked record reference, e.g.\n  `@component table { tbody { tr { td {} } } }` for `table.cell`. See the `table.*` members for the\n  full pattern, including a sibling-alternation node like `table.body`'s `tbody`.\n- If a parent-level modifier restyles a promoted member (e.g. `tabs`'s `-variant-secondary` restyling\n  `tabs.tab`, or `table`'s `-layout-stacked` restyling all six of its members), mark it inline:\n  `@modifier -variant-secondary — … @affects tabs.tab — …`. Multiple `@affects <parent>.<member>`\n  markers can follow one another on the same `@modifier` line.\n- Register the member in `COMPONENTS` right after its parent, export `<member>Css` from `src/index.ts`\n  next to the parent's export, and add it to `tests/public-surface.test.ts`'s `EXPECTED` list (that\n  array is sorted before comparison, so insertion position doesn't matter). Fix any existing test that\n  asserted on the parent's `xxxCss` for content that moved to the member.\n- Don't promote a `@part` just because it's stylistically distinct — the bar is a **real, separately\n  exported instui component** (`List.Item` yes; a passive style hook like byline's `.title`/`.description`\n  or tabs' `.list`, which has no corresponding `Tabs.List` export, no).\n\n## Alternate DOM shapes (`@variant`)\n\n`@structure` supports `@variant <name>? { … }` blocks for a component that genuinely renders one of\nseveral alternative DOM shapes (e.g. a `<label>` wrapping a control vs. a `<label for>` plus a sibling\ncontrol). Only add one when a second shape is **already real and CSS-supported** — check the record's\nexisting `@example`s and rules first; don't invent a shape the component doesn't actually render. As of\nthis pass, no component in this package authors a genuine second DOM shape (things like a checkbox's\n`-label-placement-*` only reorder the same markup via CSS, which isn't a `@variant`), so none carry one.\n\n## Authoring a record\n\n```ts\nexport const foo = defineComponent({\n  name,\n  summary,\n  modifiers,\n  parts,\n  cssProperties,\n  examples,\n  structure,\n  demo,\n  css: (p) => // prettier-ignore\n  css`…css body…`,\n});\nexport const fooCss = foo.css;\n```\n\n- The doc comment is **metadata** — plain strings, no backtick/`${` escaping.\n- Only the `css` body stays a template literal. **Tag it with `css` and put a `// prettier-ignore`\n  line right before it** (before the template for a direct arrow body, before `return` for a block).\n  oxfmt treats `css` and `styled` tagged templates as embedded CSS and corrupts interpolated\n  selectors (`${p}foo.-mod` → `${p}foo .-mod`, a different meaning) otherwise. Setting\n  `embeddedLanguageFormatting` to off does **not** stop it. See the engineering log.\n- Add the record to its bucket `index.ts`. For `COMPONENTS` the order is **load-bearing** — it matches\n  the `componentsCss()` concat order, not alphabetical.\n\n## Example Audiences\n\nUse `-canvas-rce` for the HTML inserted when Include interactions is enabled, and\n`-canvas-rce-no-interactions` for its static counterpart when interactions are disabled. For\nexample, a banner or alert can include a close button in the first example and omit it in the\nsecond. The selector reads the current setting at insertion time and leaves existing content alone.\nComponents without the new flag retain their previous example fallback. Add `-docs` to examples\nthat should also render in documentation; `-automatica11y` remains independent.\n\n### Accessibility audit examples\n\nEvery record in the component registry, including member records, has an explicit\n`@example -automatica11y` block. The audit never falls back to Canvas or docs examples. Keep a\nmember's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it.\nUse fenced HTML so audience flags remain metadata, not visible page content.\n\nKeep one audit example per record, with distinct visual variants together: canonical colors, sizes,\nand supported states. Don't duplicate deprecated aliases or build a Cartesian product of every\nmodifier. Include meaningful labels, selected and unselected choices, and native `disabled`,\n`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface\nfor inverse/on-color treatments, without overriding the component's tested colors. Keep decorative\ncontent hidden from assistive technology and preserve required parent/member structures.\n\nStack independent cases in normal document flow instead of forcing a wide row. Expanded dialog\nvariants can use `open` so they remain measurable without one modal hiding the others. Static state\nmarkup is not evidence that hover, keyboard interaction, focus movement, or announcements work:\nthose still need interaction checks and manual testing. Don't remove a supported variant or add a\nfixture-only CSS fix to make the audit pass.\n\nRun `vp run audit:components` from the repository root. It builds local styles and behavior bundles,\nthen tests each example separately in all three themes, light and dark. Reports and the coverage\ninventory live under the gitignored `a11y-report/<run>/` directory; open `index.md` first.\nUse `vp run audit:components --record button` for a focused reproduction.\n\nThe page suite runs both axe-core and IBM Equal Access against WCAG 2.2 AA, conditions checks, and\n**simulated** screen-reader checks. Page audits don't exercise archetype-specific interactions or\ncomputed checks. Page fixtures expand dialogs, native popovers, and disclosures and focus tooltip\ntriggers so their expanded surfaces are measured; npm fixtures preserve authored initial states\nfor interaction checks.\nAudit-only fixture text stays verbatim in generated API sources and doesn't enter translation\ncatalogs; add `-docs` only when the example should also appear in documentation.\nClosed surfaces aren't evidence that their hidden contents passed. Findings are\nadvisory; failed targets, missing fixtures/assets, and incomplete execution are errors.\n\nThe same command also runs authored npm fixtures for button, link, dialog (modal), menu, tabs,\nform-field, accordion (toggle-details), tooltip, and live-region (alert). These fixtures reuse the\ntagged examples and actual production interactions, with all five audit tiers enabled. There is no\nclaimed combobox or chart coverage. A native template or generated guess never counts as a tested\nPantoken component. Read gaps and undetermined computed results separately from violations.\n\nThe npm suite packs the current workspace dependency closure locally with `vp pm pack`; it doesn't\ntest the last published version instead. Its fixture wrappers inline supplementary built styles,\nfonts, and behavior bundles only to reproduce the production cascade in the tool's HTML harness.\nThey don't implement replacement widget behavior.\n\nThese automated results do not establish that the page meets WCAG; manual review is still needed.\n\n## The modifier convention (key-value RSCSS compound)\n\n- Modifiers are `.${p}<comp>.-<prop>-<val>`, aligned to InstUI prop names\n  (`-color-secondary`, `-size-sm`, `-shape-circle`, `-variant-title-page`).\n- Booleans are the prop name alone, presence = true (`-clickable`, `-condensed`). A default-on boolean\n  toggled off **inverts**: `-without-background`, `-without-border`.\n- Sizes use one scale `-size-{xs,sm,md,lg,xl}`, emitted with both short and long spellings as\n  first-class aliases via `withSizeAliases()`.\n- Nested elements are **unprefixed short classes scoped as descendants** (`.instui-menu .item`), not\n  BEM `__`. Non-nested structural parts that can't be descendant-scoped are **flat prefixed**\n  (`.instui-badge-wrapper`). A guard test rejects `__` and `--`.\n- Avoid hyphen-then-digit tokens (`-2xs` needs escaping); keep tokens letter-leading.\n\n## Reuse an existing global utility — don't invent a parallel one\n\n`view`'s and `text`'s own key-value modifiers (background, border, shadow, display, position,\noverflow, cursor, colour, weight, size, transform, variants) are **copied** into global utilities —\nusable bare (`<div class=\"--bg-secondary\">`) or chained onto any component, core or\nplugin-authored (`<button class=\"instui-button --bg-danger\">`) — without touching the component's own\nchained modifiers, which stay exactly as authored.\n\n- **Never invent a new class word for something a global utility already covers.** If a generic\n  `bg`/`text`/`border`/`border-radius`/`border-width`/`box-shadow`/`display` utility already exists,\n  extend it (add a name, or an explicit `[name, token]` pair for a value outside its usual token\n  family) — don't author a parallel word like `-stroke-*` or a word-spelled duplicate like\n  `-border-radius-small` next to the existing `-border-radius-sm`.\n- Only a genuinely new concept (no existing global analogue) gets its own utility file — see\n  `utilities/position/`, `utilities/overflow/`, `utilities/cursor/`.\n- A global utility modifier is spelled with a **double dash** (`--bg-secondary`), never a single dash\n  (single-dash `-mod` is reserved for a component's own modifiers) — this is a deliberate,\n  non-colliding namespace split, not a stylistic choice.\n- The selector mechanism is `globalModifierSelector(p, name)` (`@pantoken/utils`):\n  `:where(*).--name.--name.--name`. A plain repeated class selector already matches _any_ element\n  carrying it — standalone, or chained onto a component, core or plugin-authored (`.instui-card`,\n  `.instui-agent-shell`) — no per-component enumeration needed; the `:where(*)` wrapper contributes\n  zero specificity of its own (documentation that this is a global modifier, not a scoping condition),\n  while the modifier class repeated 3x gives the rule (0,3,0) specificity, which deterministically\n  outranks any real 2-class component-modifier compound (`.instui-view.-mod`, 0,2,0) **regardless of\n  source/import order**. `packages/utils`'s `colorUtilitiesCss`/`tokenUtilitiesCss` build on the same\n  helper.\n- This replaced an older per-component compound-selector fan-out (`GLOBAL_ALIAS_TARGETS`/\n  `globalSelectors()`/`chainTargets`, one `.instui-<component>.-mod` selector per real core\n  component) that: couldn't reach plugin-authored components at all (the core package can't know a\n  plugin's class names at its own build time); relied on `cssdoc.jsonc`'s `globalPrecedence: \"base\"`\n  and import order for override behavior, which only ever affected generated _documentation_ merge\n  order, not real browser cascade; and didn't scale to a utility with a large modifier surface (see\n  spacing below).\n\n## Universal spacing/gap modifiers\n\n- `margin`/`padding`/`gap` utility classes (`utilities/spacing/`, `utilities/gap/`) are **universal**:\n  every registered component (core or plugin) gets the modifier for free via `globalModifierSelector`,\n  with no per-record authoring — see the mechanism above.\n- Each value ships in exactly two spellings: **short** (`--mb-sm`) and fully **long**, word-spelled\n  (`--margin-bottom-small`) — never a mixed-segment form (no `-margin-e-small`, no `-me-small`).\n- Because these modifiers are documented on the separate `spacing`/`gap` utility records, not on the\n  component they're chained onto, resolving `.instui-card.--mb-sm` requires cssdoc to fall back from\n  the base record to any record tagged `@global` — every utility record here carries that tag for\n  exactly this reason. `@cssdoc/eslint-plugin`'s `valid-class-usage` (and the shared `isModifier`/\n  `deprecationOf` lookups behind it) already do this fallback automatically; no `cssdoc.jsonc` option\n  is involved. The one real prerequisite is that whatever CSS is passed to `valid-class-usage`'s `css`\n  option still carries the doc comments (an unminified build) — the published `dist/*.css` bundles are\n  minified and strip all comments, so pointing consumer-side lint at them would flag everything, not\n  just globals.\n- If a component already sets its own `margin`/`padding`/`gap` from a component-specific token (e.g.\n  card's responsive padding, breadcrumb's `gap`), document that in `@remarks` and warn that chaining a\n  spacing/gap utility modifier overrides it — see breadcrumb, button, byline, checkbox, form-field,\n  form-field-group, form-field-messages, link, list, metric, pagination, radio, radio-input-group,\n  rating, side-nav-bar, and tag for the pattern.\n\n## Deprecated and alias modifiers (auto-discovered, always functional)\n\n- Author a modifier's metadata with `alias: \"{@link -canonical}\"` for a **pure rename** (no behavior\n  change, e.g. `-toggle` → `-variant-toggle`), or `deprecated: \"{@link -canonical}\"` for a **true\n  deprecation** (behavior changed, e.g. the color/spacing normalization renames like avatar's\n  `-color-accent*` or alert's `-variant-*`). `withAliases` reads either tag and clones each canonical\n  rule under the alias name — there is no hardcoded pairs list, and both tags render a functional twin.\n- **A deprecated or aliased modifier must be a functional alias — never a doc-only noop** (user's\n  absolute rule).\n- The docs render `@alias` as a blue \"Alias\" pill (informational rename) and `@deprecated` as a red\n  \"Deprecated\" pill (a real behavior change) — see `docs/scripts/api-badge-classes.ts`.\n- The alias post-processors run on the CSS **body only**, before the doc block is prepended, because\n  the doc block's `{@link}` braces confuse the brace-based scanners. They anchor on the base class\n  (`.instui-radio.-variant-toggle`), not the bare token, so a bare `.-canonical` match doesn't wrongly\n  clone `:not(.-canonical)` or compound rules.\n\n## `@scope`, nesting, and root targeting\n\nThe default authoring system is the `alert.css` pattern:\n\n- Use a single scoped root block: `@scope (.instui-foo) { :scope { … } }`.\n- Keep root-owned behavior nested under that root with `&` (`&::before`, `&.-variant-x`,\n  `&[class*=\"-icon-\"]`, `&:has(> .part)`).\n- Keep child-only selectors as structural descendants inside the root (`> .part`, `.part`,\n  `.part::before`) instead of restating independent top-level `:scope > ...` rules.\n- Never use functional `:scope(...)`; use standard combinators (`:scope > .part`) or nested child\n  selectors inside `:scope`.\n\nThis keeps ownership explicit (root vs descendant), reduces duplicated selector prefixes, and produces\nmore stable diffs when modifier/state branches are added.\n\nWhen you must support legacy generator behavior (`scope(root, body, children?)` in `helpers.ts`) during\nmigration, preserve semantic parity first, then normalize toward the scoped-root nested form above.\n\n`@scope`/`:is`/`:has`/`:where` are **not** namespacing tools — only a unique or prefixed name prevents\na collision. Scoping narrows intent and deep-nesting collisions; it isn't collision-proof.\n\n## Local utility `@property` values\n\nFor repeated record-local dimensions or timings (for example rail/glyph sizes), define short local custom\nproperties and register them with `@property` near the top of the file:\n\n- Use local names without global namespace prefixes when the property is record-scoped\n  (`--rail-size`, `--glyph-size`, `--duration`).\n- Keep global prefixes (`--instui-*`, `--pantoken-*`) only for truly shared cross-record/token surfaces.\n- Document internal-only utility properties with valid `@cssproperty` prose and `@readonly` markers when\n  they are not public customization API.\n\n## Icons\n\nGlyphs render via a shared `::before` mask painter (currentColor, 1em box) that matches class tokens\nstarting with `-icon-`, not arbitrary class names containing `-icon-`. A glyph class rides a host\ndirectly because `--pantoken-glyph` is a plain (non-`@property`)\ncustom prop that inherits into `::before`. So `<button class=\"instui-button -shape-square\n-icon-arrow-right\">` needs no nested icon span. Built-in component glyphs source from the shared\n`--instui-icon-<name>` tokens via an `iconMask(name)` helper.\n\n## Per-component checklist\n\nExtend the record, update the drift-checked test, update the guide (`docs/guide/components.md`), and\nadd or update a demo. Then run `vp check --fix`, the component + demo tests, `check:publish`, and\n`lint:markdown`. Browser-verify anything visual. Skip upstream tokens that are `@property`-registered\nbut value-less (being removed upstream) — don't invent them.\n"}}],"_permissionRequestSessionId":"cf8db52f-0f27-4d51-8f45-3f9af32eb056","assistedApproval":{"recommendation":"approve","reason":"Authorized audit-fixture guidance update; no mandatory exclusion applies.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"cf8db52f-0f27-4d51-8f45-3f9af32eb056"},"id":"d376245a-d75d-4c05-b1a4-9440c578adf7","timestamp":"2026-10-28T21:04:28.631Z","parentId":"b58500d5-1aa9-404c-b2ce-65c5881b37e8"}
