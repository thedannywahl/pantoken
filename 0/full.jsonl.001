   \\\"utilities/transition/transition.css\\\"\\n      ],\\n      \\\"hasUnboundExecutableContent\\\": false,\\n      \\\"workingDirectory\\\": null\\n    },\\n    {\\n      \\\"identifier\\\": \\\"grep\\\",\\n      \\\"fullCommandText\\\": \\\"grep -n \\\\\\\"color\\\\\\\" ../scripts/generate.ts\\\",\\n      \\\"allowMatchIdentifier\\\": null,\\n      \\\"staticTokens\\\": [\\n        \\\"grep\\\",\\n        \\\"-n\\\",\\n        \\\"color\\\",\\n        \\\"../scripts/generate.ts\\\"\\n      ],\\n      \\\"hasUnboundExecutableContent\\\": false,\\n      \\\"workingDirectory\\\": null\\n    },\\n    {\\n      \\\"identifier\\\": \\\"head\\\",\\n      \\\"fullCommandText\\\": \\\"head -20\\\",\\n      \\\"allowMatchIdentifier\\\": null,\\n      \\\"staticTokens\\\": null,\\n      \\\"hasUnboundExecutableContent\\\": false,\\n      \\\"workingDirectory\\\": null\\n    },\\n    {\\n      \\\"identifier\\\": \\\"sed\\\",\\n      \\\"fullCommandText\\\": \\\"sed -n 1,80p lib/define.ts\\\",\\n      \\\"allowMatchIdentifier\\\": null,\\n      \\\"staticTokens\\\": [\\n        \\\"sed\\\",\\n        \\\"-n\\\",\\n        \\\"1,80p\\\",\\n        \\\"lib/define.ts\\\"\\n      ],\\n      \\\"hasUnboundExecutableContent\\\": false,\\n      \\\"workingDirectory\\\": null\\n    },\\n    {\\n      \\\"identifier\\\": \\\"head\\\",\\n      \\\"fullCommandText\\\": \\\"head -90\\\",\\n      \\\"allowMatchIdentifier\\\": null,\\n      \\\"staticTokens\\\": null,\\n      \\\"hasUnboundExecutableContent\\\": false,\\n      \\\"workingDirectory\\\": null\\n    }\\n  ],\\n  \\\"possiblePaths\\\": [\\n    \\\"/Users/dwahl/Scripts/pantoken/formats/components/src\\\",\\n    \\\"utilities/spacing\\\",\\n    \\\"utilities/transition\\\",\\n    \\\"utilities/truncate\\\",\\n    \\\"utilities/truncate/index.ts\\\",\\n    \\\"utilities/transition/transition.css\\\",\\n    \\\"../scripts/generate.ts\\\",\\n    \\\"lib/define.ts\\\"\\n  ],\\n  \\\"_permissionRequestSessionId\\\": \\\"cf8db52f-0f