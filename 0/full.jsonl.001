{"type":"hook.start","data":{"hookInvocationId":"ef42c94d-3e27-4f43-a063-2ff07aafe1f3","hookType":"postToolUse","input":{"sessionId":"cf8db52f-0f27-4d51-8f45-3f9af32eb056","timestamp":1793214632838,"cwd":"/Users/dwahl/Scripts/pantoken","toolName":"edit","toolArgs":{"new_str":" * @example -automatica11y\n * ```html\n * <div class=\"instui-view -with-visual-debug\">\n *   <span>Outlined child.</span>\n * </div>\n * ```\n * @example\n * <div class=\"instui-view -with-visual-debug\">","old_str":" * @example\n * <div class=\"instui-view -with-visual-debug\">","path":"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/visual-debug/visual-debug.css"},"toolResult":{"resultType":"success","textResultForLlm":"File /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/visual-debug/visual-debug.css updated with changes.","toolTelemetry":{"properties":{"command":"edit","options":"{\"truncateBasedOn\":\"tokenCount\",\"truncateStyle\":\"middle\"}","inputs":"[\"path\",\"old_str\",\"new_str\",\"command\"]","resolvedPathAgainstCwd":"false","fileExtension":"[\".css\"]","codeBlocks":"[{\"fileExt\":\".css\",\"languageId\":\"css\",\"linesAdded\":6,\"linesRemoved\":0}]","languageId":"[\"css\"]"},"metrics":{"resultLength":119,"resultForLlmLength":119,"linesAdded":6,"linesRemoved":0,"context_token_limit":200000.0,"context_current_tokens":139235.0,"large_output_threshold_bytes":8192.0},"restrictedProperties":{"filePaths":"[\"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/visual-debug/visual-debug.css\"]"}},"sessionLog":"[copilot:elided sessionLog (1151 bytes) - duplicated pre-hook tool-result field; canonical data remains in adjacent tool and skill events]"}}},"id":"5aa4b68e-dc8b-445c-9b33-025bbd3229ef","timestamp":"2026-10-28T19:10:32.838Z","parentId":"0eb8bd62-b4ea-4bcf-adb5-c6a6457f2497"}
