creen-reader-content.css @@ - * <span aria-hidden=\"true\">⚙</span> + * <span aria-hidden=\"true\">+</span> *** End Patch\n[tool rg -> success] args={\"pattern\":\"custom-components|readdirSync\\\\(.*assets\",\"paths\":\"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\",\"output_mode\":\"content\",\"-n\":true,\"-C\":3}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts @@ \"components/fonts.css\", + ...(item.record === \"logo\" ? [\"logos/canvas-horizontal-color.css\"] : []), @@ [\"plugins/pantoken/custom-components/dist\", \"custom-components\"], + [\"plugins/pantoken/logos/dist\", \"logos\"], *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts @@ expect(page).toContain(\"control.checkValidity()\"); + const logoPage = renderPage({ ...cases[0]!, record: \"logo\" }); + expect(logoPage).toContain('href=\"assets/logos/canvas-horizontal-color.css\"'); @@ \"plugins/pantoken/custom-components/dist\", + \"plugins/pantoken/logos/dist\", @@ \"interactions\", + \"logos\", *** End Patch\n[tool bash -> success] args={\"command\":\"vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate plugin fixtures and harness\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --help\",\"description\":\"Check changeset CLI options\",\"initial_wait\":60}\n[tool bash -> success] args={\"command\":\"cd formats/components && node --input-type=module -e 'import {parseCssDocs} from \\\"@cssdoc/core\\\"; import {PLUGIN_AUDIT_RECORDS} from \\\"./scripts/audit-plugin-components.ts\\\"; console.log(JSON.stringify(parseCssDocs(PLUGIN_AUDIT_RECORDS.find(x=>x.name===\\\"banner\\\").rules(\\\"instui-\\\")).find(x=>x.name===\\\"banner\\\").modifiers,null,2))'\",\"description\":\"Inspect parsed modifier alias metadata\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-examples.test.ts @@ - if (modifier.name.includes(\"*\") || modifier.description.includes(\"@alias\")) continue; + if (modifier.pattern || modifier.alias) continue; *** End Patch\n[tool write_agent -> success] args={\"agent_ids\":[\"049c1373-ecc6-4d66-bbea-f19e45c06453\",\"78631379-5bbe-4a0d-a590-18491ff526c0\",\"13128f82-ab9e-41de-a14e-bd6978da289e\"],\"message\":\"Parsed CssDocEntry.modifiers carries modifier.alias.canonical (not description @alias) and modifier.pattern. I'll add metadata-derived guard that requires canonical visual color/size/variant/state modifier classes on matching component roots, skipping aliases/patterns. Flag any intentional exceptions with rationale. Please ensure data-a11y roots/triggers remain where harness needs them; root identifiers should remain unique. Guard tests now normalize pfx before checking IDs/ARIA for plugin records too.\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md @@ member's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it. Use fenced HTML so audience flags remain metadata, not visible page content. +Keep one audit example per record, with distinct visual variants together: canonical colors, sizes, +and supported states. Don't duplicate deprecated aliases or build a Cartesian product of every +modifier. Include meaningful labels, selected and unselected choices, and native `disabled`, +`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface +for inverse/on-color treatments, without overriding the component's tested colors. Keep decorative +content hidden from assistive technology and preserve required parent/member structures. + +Stack independent cases in normal document flow instead of forcing a wide row. Expanded dialog +variants can use `open` so they remain measurable without one modal hiding the others. Static state +markup is not evidence that hover, keyboard interaction, focus movement, or announcements work: +those still need interaction checks and manual testing. Don't remove a supported variant or add a +fixture-only CSS fix to make the audit pass. + Run `vp run audit:components` from the repository root. It builds local styles and behavior bundles, *** End Patch\n[tool bash -> success] args={\"command\":\"vp check --fix formats/components/tests/audit-examples.test.ts formats/components/scripts/audit-accessibility.ts formats/components/tests/audit-accessibility.test.ts formats/components/src/declarations/focus/index.ts formats/components/src/utilities/ai-gradient/index.ts plugins/pantoken/custom-components/src/components docs/conventions/authoring.md && vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate own plugin and utility changes\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --patch @pantoken/components,@pantoken/plugin-custom-components -m \\\"Expand accessibility audit examples to exercise distinct visual variants and native control states, with minimal component-owned markup.\\\"\",\"description\":\"Generate audit-fixture changeset\",\"initial_wait\":60}","copilot_cache_control":{"type":"ephemeral"}},{"content":"ALLOW: Explicitly delegated audit-fixture work covers this component file.","refusal":null,"role":"assistant","reasoning_opaque":"REDACTED","reasoning_text":"","encrypted_content":"REDACTED","reasoningBlocks":{"provider":"openai-responses","blocks":[{"content":[],"encrypted_content":"REDACTED","id":"","summary":[],"type":"reasoning"}]},"responses_message_status":"completed","phase":"final_answer","serverTools":{"provider":"openai-responses"},"apiCallId":"","outputTokens":182,"providerId":"copilot"}]},"id":"98c36690-ccf2-4038-8288-3572170983a9","timestamp":"2026-10-28T21:04:46.679Z","parentId":"589d98ba-6bec-4cf6-8a46-6d546e898a7c"}
{"type":"permission.requested","data":{"requestId":"16308c25-3fd2-4331-8bdd-cf50da899137","permissionRequest":{"kind":"write","toolCallId":"custom_call_xlWbt2qtOIQCYLa3C9rrczzw","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css\n@@ -36,6 +36,35 @@\n  *     <span class=\"pfx-form-field-message -type-error\" id=\"audit-email-error\" hidden>Enter a valid email address.</span>\n  *   </span>\n  * </label>\n+ * <label class=\"pfx-form-field -layout-stacked\">\n+ *   <span class=\"label\" id=\"audit-field-stacked-label\">Stacked name</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-stacked-label\"></span>\n+ * </label>\n+ * <label class=\"pfx-form-field -layout-inline -label-align-start -v-align-top\">\n+ *   <span class=\"label\" id=\"audit-field-top-label\">Top label</span>\n+ *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-top-label\">An inline field with a taller control.</textarea></span>\n+ * </label>\n+ * <label class=\"pfx-form-field -layout-inline -label-align-end -v-align-bottom\">\n+ *   <span class=\"label\" id=\"audit-field-bottom-label\">End label</span>\n+ *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-bottom-label\">Bottom-aligned control.</textarea></span>\n+ * </label>\n+ * <label class=\"pfx-form-field -layout-inline\">\n+ *   <span class=\"label\" id=\"audit-field-middle-label\">Center label</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-middle-label\"></span>\n+ * </label>\n+ * <p><label class=\"pfx-form-field -inline\">\n+ *   <span class=\"label\" id=\"audit-field-inline-label\">Intrinsic field</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-inline-label\"></span>\n+ * </label></p>\n+ * <label class=\"pfx-form-field -invalid\">\n+ *   <span class=\"label\" id=\"audit-field-invalid-label\">Required name</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input -invalid\" required aria-invalid=\"true\" aria-labelledby=\"audit-field-invalid-label\" aria-describedby=\"audit-field-error\"></span>\n+ *   <span class=\"pfx-form-field-messages\"><span class=\"pfx-form-field-message -type-error\" id=\"audit-field-error\">Enter a name.</span></span>\n+ * </label>\n+ * <label class=\"pfx-form-field -readonly\">\n+ *   <span class=\"label\" id=\"audit-field-readonly-label\">Read-only name</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input -readonly\" readonly value=\"Alex\" aria-labelledby=\"audit-field-readonly-label\"></span>\n+ * </label>\n  * ```\n  * @example -docs\n  * ```html\n","newFileContents":"/**\n * @component form-field\n * @summary A form-field wrapper: a label, its controls, and inline, required, or readonly layouts.\n * @remarks An error message stays hidden until the field's control is `:user-invalid` (after the user interacts) or you add the `-invalid` class. Use `-layout-inline` to put the label beside the controls and `-layout-stacked` to put it above. Also sets its own `gap` between the label, controls, and messages; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @remarks Native validation is opt-in: add `data-native-validation` and load `@pantoken/interactions/form-field.iife.js`, or call `initFormField(host, control, error)`. Supply exactly one native control and one error message with a stable, unique ID. The behavior associates the error after blur or a native validation attempt and removes it when corrected; CSS alone doesn't synchronize ARIA.\n * @modifier -inline — Inline layout (shorthand for `-layout-inline`).\n * @modifier -layout-inline — Inline layout: label beside the controls.\n * @modifier -layout-stacked — Stacked layout: label above the controls.\n * @modifier -label-align-start — Start-align the label text.\n * @modifier -label-align-end — End-align the label text.\n * @modifier -invalid — Invalid (error) state.\n * @modifier -readonly — Read-only state.\n * @modifier -v-align-top — Top-align the label with the controls.\n * @modifier -v-align-bottom — Bottom-align the label with the controls.\n * @part .label — The field label.\n * @part .controls — The control area beside or below the label.\n * @pseudo ::after — Renders the decorative required-field asterisk after the label text when the field is required.\n * @accessibility A wrapping `<label>` names the control. When it also contains messages, use `aria-labelledby` to identify just the visible label text and `aria-describedby` for hints. Associate visible validation errors and synchronize `aria-invalid` in application code or with the opt-in native validation behavior; the decorative required asterisk isn't an accessible-name substitute.\n * @compat Contains its element styles with the CSS `@scope` at-rule; needs a recent Chromium, Firefox, or Safari.\n * @example -canvas-rce\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\" id=\"email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" placeholder=\"[REDACTED_EMAIL]\" aria-labelledby=\"email-label\" aria-describedby=\"email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"email-hint\">We'll never share it.</span>\n *     <span class=\"pfx-form-field-message -type-error\">Enter a valid email address.</span>\n *   </span>\n * </label>\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation data-a11y-root>\n *   <span class=\"label\" id=\"audit-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"audit-email-label\" aria-describedby=\"audit-email-hint\" data-a11y-trigger></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"audit-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"audit-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * <label class=\"pfx-form-field -layout-stacked\">\n *   <span class=\"label\" id=\"audit-field-stacked-label\">Stacked name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-stacked-label\"></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline -label-align-start -v-align-top\">\n *   <span class=\"label\" id=\"audit-field-top-label\">Top label</span>\n *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-top-label\">An inline field with a taller control.</textarea></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline -label-align-end -v-align-bottom\">\n *   <span class=\"label\" id=\"audit-field-bottom-label\">End label</span>\n *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-bottom-label\">Bottom-aligned control.</textarea></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline\">\n *   <span class=\"label\" id=\"audit-field-middle-label\">Center label</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-middle-label\"></span>\n * </label>\n * <p><label class=\"pfx-form-field -inline\">\n *   <span class=\"label\" id=\"audit-field-inline-label\">Intrinsic field</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-inline-label\"></span>\n * </label></p>\n * <label class=\"pfx-form-field -invalid\">\n *   <span class=\"label\" id=\"audit-field-invalid-label\">Required name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input -invalid\" required aria-invalid=\"true\" aria-labelledby=\"audit-field-invalid-label\" aria-describedby=\"audit-field-error\"></span>\n *   <span class=\"pfx-form-field-messages\"><span class=\"pfx-form-field-message -type-error\" id=\"audit-field-error\">Enter a name.</span></span>\n * </label>\n * <label class=\"pfx-form-field -readonly\">\n *   <span class=\"label\" id=\"audit-field-readonly-label\">Read-only name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input -readonly\" readonly value=\"Alex\" aria-labelledby=\"audit-field-readonly-label\"></span>\n * </label>\n * ```\n * @example -docs\n * ```html\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\">Display name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"text\" autocomplete=\"nickname\"></span>\n * </label>\n * ```\n * ### Native validation (opt-in)\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation>\n *   <span class=\"label\" id=\"native-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"native-email-label\" aria-describedby=\"native-email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"native-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"native-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * ```\n * @structure\n * .pfx-form-field {\n *   .label {}\n *   .controls {\n *     .pfx-text-input {}\n *   }\n *   .pfx-form-field-messages {}\n * }\n * @related form-field-messages — Renders the field's hint, error, and success messages.\n * @related form-field-group — Groups related fields under a shared legend.\n */\n.pfx-form-field {\n  display: grid;\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n  gap: var(--instui-component-form-field-layout-gap-inputs);\n  color: var(--instui-component-form-field-layout-text-color);\n  font-family: var(--instui-component-form-field-layout-font-family);\n}\n\n@scope (.pfx-form-field) {\n  :scope {\n    > .label {\n      grid-area: label;\n      color: var(--instui-component-form-field-layout-text-color);\n      font-family: var(--instui-component-form-field-layout-font-family);\n      font-weight: var(--instui-component-form-field-layout-font-weight);\n      font-size: var(--instui-component-form-field-layout-font-size);\n      line-height: var(--instui-component-form-field-layout-line-height);\n    }\n\n    > .controls {\n      grid-area: controls;\n    }\n  }\n}\n\n/* Messages region — kept OUTSIDE @scope: the messages class shares the form-field prefix. */\n.pfx-form-field > .pfx-form-field-messages {\n  grid-area: messages;\n}\n\n/* Client-side validation: an error message stays hidden until the field's control is :user-invalid\n   (after the user has interacted), per MDN guidance; then it shows. The explicit -invalid class on the\n   control (and a standalone .instui-form-field-messages outside a field) are unaffected. */\n.pfx-form-field .pfx-form-field-message.-type-error,\n.pfx-form-field .pfx-form-field-message.-type-new-error {\n  display: none;\n}\n\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-new-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-new-error:not([hidden]) {\n  display: inline-flex;\n}\n\n/* Required indicator: native [required] control OR the -required class; decorative (aria-hidden). */\n.pfx-form-field:is(.-required, :has(:required)) .label::after {\n  content: \"*\";\n  margin-inline-start: 0.25rem;\n  color: var(--instui-component-form-field-layout-asterisk-color);\n}\n\n.pfx-form-field.-readonly .label {\n  color: var(--instui-component-form-field-layout-readonly-text-color);\n}\n\n.pfx-form-field.-layout-stacked {\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n}\n\n.pfx-form-field.-layout-inline {\n  grid-template-columns: auto 1fr;\n  grid-template-areas: \"label controls\" \". messages\";\n  align-items: center;\n  column-gap: var(--instui-component-form-field-layout-gap-primitives);\n}\n\n.pfx-form-field.-layout-inline.-v-align-top {\n  align-items: start;\n}\n\n.pfx-form-field.-layout-inline.-v-align-bottom {\n  align-items: end;\n}\n\n.pfx-form-field.-layout-inline.-label-align-start .label {\n  text-align: start;\n}\n\n.pfx-form-field.-layout-inline.-label-align-end .label {\n  text-align: end;\n}\n\n.pfx-form-field.-inline {\n  display: inline-grid;\n  inline-size: auto;\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css","content":"/**\n * @component form-field\n * @summary A form-field wrapper: a label, its controls, and inline, required, or readonly layouts.\n * @remarks An error message stays hidden until the field's control is `:user-invalid` (after the user interacts) or you add the `-invalid` class. Use `-layout-inline` to put the label beside the controls and `-layout-stacked` to put it above. Also sets its own `gap` between the label, controls, and messages; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @remarks Native validation is opt-in: add `data-native-validation` and load `@pantoken/interactions/form-field.iife.js`, or call `initFormField(host, control, error)`. Supply exactly one native control and one error message with a stable, unique ID. The behavior associates the error after blur or a native validation attempt and removes it when corrected; CSS alone doesn't synchronize ARIA.\n * @modifier -inline — Inline layout (shorthand for `-layout-inline`).\n * @modifier -layout-inline — Inline layout: label beside the controls.\n * @modifier -layout-stacked — Stacked layout: label above the controls.\n * @modifier -label-align-start — Start-align the label text.\n * @modifier -label-align-end — End-align the label text.\n * @modifier -invalid — Invalid (error) state.\n * @modifier -readonly — Read-only state.\n * @modifier -v-align-top — Top-align the label with the controls.\n * @modifier -v-align-bottom — Bottom-align the label with the controls.\n * @part .label — The field label.\n * @part .controls — The control area beside or below the label.\n * @pseudo ::after — Renders the decorative required-field asterisk after the label text when the field is required.\n * @accessibility A wrapping `<label>` names the control. When it also contains messages, use `aria-labelledby` to identify just the visible label text and `aria-describedby` for hints. Associate visible validation errors and synchronize `aria-invalid` in application code or with the opt-in native validation behavior; the decorative required asterisk isn't an accessible-name substitute.\n * @compat Contains its element styles with the CSS `@scope` at-rule; needs a recent Chromium, Firefox, or Safari.\n * @example -canvas-rce\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\" id=\"email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" placeholder=\"[REDACTED_EMAIL]\" aria-labelledby=\"email-label\" aria-describedby=\"email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"email-hint\">We'll never share it.</span>\n *     <span class=\"pfx-form-field-message -type-error\">Enter a valid email address.</span>\n *   </span>\n * </label>\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation data-a11y-root>\n *   <span class=\"label\" id=\"audit-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"audit-email-label\" aria-describedby=\"audit-email-hint\" data-a11y-trigger></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"audit-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"audit-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * ```\n * @example -docs\n * ```html\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\">Display name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"text\" autocomplete=\"nickname\"></span>\n * </label>\n * ```\n * ### Native validation (opt-in)\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation>\n *   <span class=\"label\" id=\"native-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"native-email-label\" aria-describedby=\"native-email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"native-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"native-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * ```\n * @structure\n * .pfx-form-field {\n *   .label {}\n *   .controls {\n *     .pfx-text-input {}\n *   }\n *   .pfx-form-field-messages {}\n * }\n * @related form-field-messages — Renders the field's hint, error, and success messages.\n * @related form-field-group — Groups related fields under a shared legend.\n */\n.pfx-form-field {\n  display: grid;\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n  gap: var(--instui-component-form-field-layout-gap-inputs);\n  color: var(--instui-component-form-field-layout-text-color);\n  font-family: var(--instui-component-form-field-layout-font-family);\n}\n\n@scope (.pfx-form-field) {\n  :scope {\n    > .label {\n      grid-area: label;\n      color: var(--instui-component-form-field-layout-text-color);\n      font-family: var(--instui-component-form-field-layout-font-family);\n      font-weight: var(--instui-component-form-field-layout-font-weight);\n      font-size: var(--instui-component-form-field-layout-font-size);\n      line-height: var(--instui-component-form-field-layout-line-height);\n    }\n\n    > .controls {\n      grid-area: controls;\n    }\n  }\n}\n\n/* Messages region — kept OUTSIDE @scope: the messages class shares the form-field prefix. */\n.pfx-form-field > .pfx-form-field-messages {\n  grid-area: messages;\n}\n\n/* Client-side validation: an error message stays hidden until the field's control is :user-invalid\n   (after the user has interacted), per MDN guidance; then it shows. The explicit -invalid class on the\n   control (and a standalone .instui-form-field-messages outside a field) are unaffected. */\n.pfx-form-field .pfx-form-field-message.-type-error,\n.pfx-form-field .pfx-form-field-message.-type-new-error {\n  display: none;\n}\n\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-new-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-new-error:not([hidden]) {\n  display: inline-flex;\n}\n\n/* Required indicator: native [required] control OR the -required class; decorative (aria-hidden). */\n.pfx-form-field:is(.-required, :has(:required)) .label::after {\n  content: \"*\";\n  margin-inline-start: 0.25rem;\n  color: var(--instui-component-form-field-layout-asterisk-color);\n}\n\n.pfx-form-field.-readonly .label {\n  color: var(--instui-component-form-field-layout-readonly-text-color);\n}\n\n.pfx-form-field.-layout-stacked {\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n}\n\n.pfx-form-field.-layout-inline {\n  grid-template-columns: auto 1fr;\n  grid-template-areas: \"label controls\" \". messages\";\n  align-items: center;\n  column-gap: var(--instui-component-form-field-layout-gap-primitives);\n}\n\n.pfx-form-field.-layout-inline.-v-align-top {\n  align-items: start;\n}\n\n.pfx-form-field.-layout-inline.-v-align-bottom {\n  align-items: end;\n}\n\n.pfx-form-field.-layout-inline.-label-align-start .label {\n  text-align: start;\n}\n\n.pfx-form-field.-layout-inline.-label-align-end .label {\n  text-align: end;\n}\n\n.pfx-form-field.-inline {\n  display: inline-grid;\n  inline-size: auto;\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css","content":"/**\n * @component form-field\n * @summary A form-field wrapper: a label, its controls, and inline, required, or readonly layouts.\n * @remarks An error message stays hidden until the field's control is `:user-invalid` (after the user interacts) or you add the `-invalid` class. Use `-layout-inline` to put the label beside the controls and `-layout-stacked` to put it above. Also sets its own `gap` between the label, controls, and messages; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @remarks Native validation is opt-in: add `data-native-validation` and load `@pantoken/interactions/form-field.iife.js`, or call `initFormField(host, control, error)`. Supply exactly one native control and one error message with a stable, unique ID. The behavior associates the error after blur or a native validation attempt and removes it when corrected; CSS alone doesn't synchronize ARIA.\n * @modifier -inline — Inline layout (shorthand for `-layout-inline`).\n * @modifier -layout-inline — Inline layout: label beside the controls.\n * @modifier -layout-stacked — Stacked layout: label above the controls.\n * @modifier -label-align-start — Start-align the label text.\n * @modifier -label-align-end — End-align the label text.\n * @modifier -invalid — Invalid (error) state.\n * @modifier -readonly — Read-only state.\n * @modifier -v-align-top — Top-align the label with the controls.\n * @modifier -v-align-bottom — Bottom-align the label with the controls.\n * @part .label — The field label.\n * @part .controls — The control area beside or below the label.\n * @pseudo ::after — Renders the decorative required-field asterisk after the label text when the field is required.\n * @accessibility A wrapping `<label>` names the control. When it also contains messages, use `aria-labelledby` to identify just the visible label text and `aria-describedby` for hints. Associate visible validation errors and synchronize `aria-invalid` in application code or with the opt-in native validation behavior; the decorative required asterisk isn't an accessible-name substitute.\n * @compat Contains its element styles with the CSS `@scope` at-rule; needs a recent Chromium, Firefox, or Safari.\n * @example -canvas-rce\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\" id=\"email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" placeholder=\"[REDACTED_EMAIL]\" aria-labelledby=\"email-label\" aria-describedby=\"email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"email-hint\">We'll never share it.</span>\n *     <span class=\"pfx-form-field-message -type-error\">Enter a valid email address.</span>\n *   </span>\n * </label>\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation data-a11y-root>\n *   <span class=\"label\" id=\"audit-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"audit-email-label\" aria-describedby=\"audit-email-hint\" data-a11y-trigger></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"audit-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"audit-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * <label class=\"pfx-form-field -layout-stacked\">\n *   <span class=\"label\" id=\"audit-field-stacked-label\">Stacked name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-stacked-label\"></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline -label-align-start -v-align-top\">\n *   <span class=\"label\" id=\"audit-field-top-label\">Top label</span>\n *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-top-label\">An inline field with a taller control.</textarea></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline -label-align-end -v-align-bottom\">\n *   <span class=\"label\" id=\"audit-field-bottom-label\">End label</span>\n *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-bottom-label\">Bottom-aligned control.</textarea></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline\">\n *   <span class=\"label\" id=\"audit-field-middle-label\">Center label</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-middle-label\"></span>\n * </label>\n * <p><label class=\"pfx-form-field -inline\">\n *   <span class=\"label\" id=\"audit-field-inline-label\">Intrinsic field</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-inline-label\"></span>\n * </label></p>\n * <label class=\"pfx-form-field -invalid\">\n *   <span class=\"label\" id=\"audit-field-invalid-label\">Required name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input -invalid\" required aria-invalid=\"true\" aria-labelledby=\"audit-field-invalid-label\" aria-describedby=\"audit-field-error\"></span>\n *   <span class=\"pfx-form-field-messages\"><span class=\"pfx-form-field-message -type-error\" id=\"audit-field-error\">Enter a name.</span></span>\n * </label>\n * <label class=\"pfx-form-field -readonly\">\n *   <span class=\"label\" id=\"audit-field-readonly-label\">Read-only name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input -readonly\" readonly value=\"Alex\" aria-labelledby=\"audit-field-readonly-label\"></span>\n * </label>\n * ```\n * @example -docs\n * ```html\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\">Display name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"text\" autocomplete=\"nickname\"></span>\n * </label>\n * ```\n * ### Native validation (opt-in)\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation>\n *   <span class=\"label\" id=\"native-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"native-email-label\" aria-describedby=\"native-email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"native-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"native-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * ```\n * @structure\n * .pfx-form-field {\n *   .label {}\n *   .controls {\n *     .pfx-text-input {}\n *   }\n *   .pfx-form-field-messages {}\n * }\n * @related form-field-messages — Renders the field's hint, error, and success messages.\n * @related form-field-group — Groups related fields under a shared legend.\n */\n.pfx-form-field {\n  display: grid;\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n  gap: var(--instui-component-form-field-layout-gap-inputs);\n  color: var(--instui-component-form-field-layout-text-color);\n  font-family: var(--instui-component-form-field-layout-font-family);\n}\n\n@scope (.pfx-form-field) {\n  :scope {\n    > .label {\n      grid-area: label;\n      color: var(--instui-component-form-field-layout-text-color);\n      font-family: var(--instui-component-form-field-layout-font-family);\n      font-weight: var(--instui-component-form-field-layout-font-weight);\n      font-size: var(--instui-component-form-field-layout-font-size);\n      line-height: var(--instui-component-form-field-layout-line-height);\n    }\n\n    > .controls {\n      grid-area: controls;\n    }\n  }\n}\n\n/* Messages region — kept OUTSIDE @scope: the messages class shares the form-field prefix. */\n.pfx-form-field > .pfx-form-field-messages {\n  grid-area: messages;\n}\n\n/* Client-side validation: an error message stays hidden until the field's control is :user-invalid\n   (after the user has interacted), per MDN guidance; then it shows. The explicit -invalid class on the\n   control (and a standalone .instui-form-field-messages outside a field) are unaffected. */\n.pfx-form-field .pfx-form-field-message.-type-error,\n.pfx-form-field .pfx-form-field-message.-type-new-error {\n  display: none;\n}\n\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-new-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-new-error:not([hidden]) {\n  display: inline-flex;\n}\n\n/* Required indicator: native [required] control OR the -required class; decorative (aria-hidden). */\n.pfx-form-field:is(.-required, :has(:required)) .label::after {\n  content: \"*\";\n  margin-inline-start: 0.25rem;\n  color: var(--instui-component-form-field-layout-asterisk-color);\n}\n\n.pfx-form-field.-readonly .label {\n  color: var(--instui-component-form-field-layout-readonly-text-color);\n}\n\n.pfx-form-field.-layout-stacked {\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n}\n\n.pfx-form-field.-layout-inline {\n  grid-template-columns: auto 1fr;\n  grid-template-areas: \"label controls\" \". messages\";\n  align-items: center;\n  column-gap: var(--instui-component-form-field-layout-gap-primitives);\n}\n\n.pfx-form-field.-layout-inline.-v-align-top {\n  align-items: start;\n}\n\n.pfx-form-field.-layout-inline.-v-align-bottom {\n  align-items: end;\n}\n\n.pfx-form-field.-layout-inline.-label-align-start .label {\n  text-align: start;\n}\n\n.pfx-form-field.-layout-inline.-label-align-end .label {\n  text-align: end;\n}\n\n.pfx-form-field.-inline {\n  display: inline-grid;\n  inline-size: auto;\n}\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_xlWbt2qtOIQCYLa3C9rrczzw","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css\n@@ -36,6 +36,35 @@\n  *     <span class=\"pfx-form-field-message -type-error\" id=\"audit-email-error\" hidden>Enter a valid email address.</span>\n  *   </span>\n  * </label>\n+ * <label class=\"pfx-form-field -layout-stacked\">\n+ *   <span class=\"label\" id=\"audit-field-stacked-label\">Stacked name</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-stacked-label\"></span>\n+ * </label>\n+ * <label class=\"pfx-form-field -layout-inline -label-align-start -v-align-top\">\n+ *   <span class=\"label\" id=\"audit-field-top-label\">Top label</span>\n+ *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-top-label\">An inline field with a taller control.</textarea></span>\n+ * </label>\n+ * <label class=\"pfx-form-field -layout-inline -label-align-end -v-align-bottom\">\n+ *   <span class=\"label\" id=\"audit-field-bottom-label\">End label</span>\n+ *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-bottom-label\">Bottom-aligned control.</textarea></span>\n+ * </label>\n+ * <label class=\"pfx-form-field -layout-inline\">\n+ *   <span class=\"label\" id=\"audit-field-middle-label\">Center label</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-middle-label\"></span>\n+ * </label>\n+ * <p><label class=\"pfx-form-field -inline\">\n+ *   <span class=\"label\" id=\"audit-field-inline-label\">Intrinsic field</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-inline-label\"></span>\n+ * </label></p>\n+ * <label class=\"pfx-form-field -invalid\">\n+ *   <span class=\"label\" id=\"audit-field-invalid-label\">Required name</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input -invalid\" required aria-invalid=\"true\" aria-labelledby=\"audit-field-invalid-label\" aria-describedby=\"audit-field-error\"></span>\n+ *   <span class=\"pfx-form-field-messages\"><span class=\"pfx-form-field-message -type-error\" id=\"audit-field-error\">Enter a name.</span></span>\n+ * </label>\n+ * <label class=\"pfx-form-field -readonly\">\n+ *   <span class=\"label\" id=\"audit-field-readonly-label\">Read-only name</span>\n+ *   <span class=\"controls\"><input class=\"pfx-text-input -readonly\" readonly value=\"Alex\" aria-labelledby=\"audit-field-readonly-label\"></span>\n+ * </label>\n  * ```\n  * @example -docs\n  * ```html\n","newFileContents":"/**\n * @component form-field\n * @summary A form-field wrapper: a label, its controls, and inline, required, or readonly layouts.\n * @remarks An error message stays hidden until the field's control is `:user-invalid` (after the user interacts) or you add the `-invalid` class. Use `-layout-inline` to put the label beside the controls and `-layout-stacked` to put it above. Also sets its own `gap` between the label, controls, and messages; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @remarks Native validation is opt-in: add `data-native-validation` and load `@pantoken/interactions/form-field.iife.js`, or call `initFormField(host, control, error)`. Supply exactly one native control and one error message with a stable, unique ID. The behavior associates the error after blur or a native validation attempt and removes it when corrected; CSS alone doesn't synchronize ARIA.\n * @modifier -inline — Inline layout (shorthand for `-layout-inline`).\n * @modifier -layout-inline — Inline layout: label beside the controls.\n * @modifier -layout-stacked — Stacked layout: label above the controls.\n * @modifier -label-align-start — Start-align the label text.\n * @modifier -label-align-end — End-align the label text.\n * @modifier -invalid — Invalid (error) state.\n * @modifier -readonly — Read-only state.\n * @modifier -v-align-top — Top-align the label with the controls.\n * @modifier -v-align-bottom — Bottom-align the label with the controls.\n * @part .label — The field label.\n * @part .controls — The control area beside or below the label.\n * @pseudo ::after — Renders the decorative required-field asterisk after the label text when the field is required.\n * @accessibility A wrapping `<label>` names the control. When it also contains messages, use `aria-labelledby` to identify just the visible label text and `aria-describedby` for hints. Associate visible validation errors and synchronize `aria-invalid` in application code or with the opt-in native validation behavior; the decorative required asterisk isn't an accessible-name substitute.\n * @compat Contains its element styles with the CSS `@scope` at-rule; needs a recent Chromium, Firefox, or Safari.\n * @example -canvas-rce\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\" id=\"email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" placeholder=\"[REDACTED_EMAIL]\" aria-labelledby=\"email-label\" aria-describedby=\"email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"email-hint\">We'll never share it.</span>\n *     <span class=\"pfx-form-field-message -type-error\">Enter a valid email address.</span>\n *   </span>\n * </label>\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation data-a11y-root>\n *   <span class=\"label\" id=\"audit-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"audit-email-label\" aria-describedby=\"audit-email-hint\" data-a11y-trigger></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"audit-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"audit-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * <label class=\"pfx-form-field -layout-stacked\">\n *   <span class=\"label\" id=\"audit-field-stacked-label\">Stacked name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-stacked-label\"></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline -label-align-start -v-align-top\">\n *   <span class=\"label\" id=\"audit-field-top-label\">Top label</span>\n *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-top-label\">An inline field with a taller control.</textarea></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline -label-align-end -v-align-bottom\">\n *   <span class=\"label\" id=\"audit-field-bottom-label\">End label</span>\n *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-bottom-label\">Bottom-aligned control.</textarea></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline\">\n *   <span class=\"label\" id=\"audit-field-middle-label\">Center label</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-middle-label\"></span>\n * </label>\n * <p><label class=\"pfx-form-field -inline\">\n *   <span class=\"label\" id=\"audit-field-inline-label\">Intrinsic field</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-inline-label\"></span>\n * </label></p>\n * <label class=\"pfx-form-field -invalid\">\n *   <span class=\"label\" id=\"audit-field-invalid-label\">Required name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input -invalid\" required aria-invalid=\"true\" aria-labelledby=\"audit-field-invalid-label\" aria-describedby=\"audit-field-error\"></span>\n *   <span class=\"pfx-form-field-messages\"><span class=\"pfx-form-field-message -type-error\" id=\"audit-field-error\">Enter a name.</span></span>\n * </label>\n * <label class=\"pfx-form-field -readonly\">\n *   <span class=\"label\" id=\"audit-field-readonly-label\">Read-only name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input -readonly\" readonly value=\"Alex\" aria-labelledby=\"audit-field-readonly-label\"></span>\n * </label>\n * ```\n * @example -docs\n * ```html\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\">Display name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"text\" autocomplete=\"nickname\"></span>\n * </label>\n * ```\n * ### Native validation (opt-in)\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation>\n *   <span class=\"label\" id=\"native-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"native-email-label\" aria-describedby=\"native-email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"native-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"native-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * ```\n * @structure\n * .pfx-form-field {\n *   .label {}\n *   .controls {\n *     .pfx-text-input {}\n *   }\n *   .pfx-form-field-messages {}\n * }\n * @related form-field-messages — Renders the field's hint, error, and success messages.\n * @related form-field-group — Groups related fields under a shared legend.\n */\n.pfx-form-field {\n  display: grid;\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n  gap: var(--instui-component-form-field-layout-gap-inputs);\n  color: var(--instui-component-form-field-layout-text-color);\n  font-family: var(--instui-component-form-field-layout-font-family);\n}\n\n@scope (.pfx-form-field) {\n  :scope {\n    > .label {\n      grid-area: label;\n      color: var(--instui-component-form-field-layout-text-color);\n      font-family: var(--instui-component-form-field-layout-font-family);\n      font-weight: var(--instui-component-form-field-layout-font-weight);\n      font-size: var(--instui-component-form-field-layout-font-size);\n      line-height: var(--instui-component-form-field-layout-line-height);\n    }\n\n    > .controls {\n      grid-area: controls;\n    }\n  }\n}\n\n/* Messages region — kept OUTSIDE @scope: the messages class shares the form-field prefix. */\n.pfx-form-field > .pfx-form-field-messages {\n  grid-area: messages;\n}\n\n/* Client-side validation: an error message stays hidden until the field's control is :user-invalid\n   (after the user has interacted), per MDN guidance; then it shows. The explicit -invalid class on the\n   control (and a standalone .instui-form-field-messages outside a field) are unaffected. */\n.pfx-form-field .pfx-form-field-message.-type-error,\n.pfx-form-field .pfx-form-field-message.-type-new-error {\n  display: none;\n}\n\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-new-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-new-error:not([hidden]) {\n  display: inline-flex;\n}\n\n/* Required indicator: native [required] control OR the -required class; decorative (aria-hidden). */\n.pfx-form-field:is(.-required, :has(:required)) .label::after {\n  content: \"*\";\n  margin-inline-start: 0.25rem;\n  color: var(--instui-component-form-field-layout-asterisk-color);\n}\n\n.pfx-form-field.-readonly .label {\n  color: var(--instui-component-form-field-layout-readonly-text-color);\n}\n\n.pfx-form-field.-layout-stacked {\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n}\n\n.pfx-form-field.-layout-inline {\n  grid-template-columns: auto 1fr;\n  grid-template-areas: \"label controls\" \". messages\";\n  align-items: center;\n  column-gap: var(--instui-component-form-field-layout-gap-primitives);\n}\n\n.pfx-form-field.-layout-inline.-v-align-top {\n  align-items: start;\n}\n\n.pfx-form-field.-layout-inline.-v-align-bottom {\n  align-items: end;\n}\n\n.pfx-form-field.-layout-inline.-label-align-start .label {\n  text-align: start;\n}\n\n.pfx-form-field.-layout-inline.-label-align-end .label {\n  text-align: end;\n}\n\n.pfx-form-field.-inline {\n  display: inline-grid;\n  inline-size: auto;\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css","content":"/**\n * @component form-field\n * @summary A form-field wrapper: a label, its controls, and inline, required, or readonly layouts.\n * @remarks An error message stays hidden until the field's control is `:user-invalid` (after the user interacts) or you add the `-invalid` class. Use `-layout-inline` to put the label beside the controls and `-layout-stacked` to put it above. Also sets its own `gap` between the label, controls, and messages; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @remarks Native validation is opt-in: add `data-native-validation` and load `@pantoken/interactions/form-field.iife.js`, or call `initFormField(host, control, error)`. Supply exactly one native control and one error message with a stable, unique ID. The behavior associates the error after blur or a native validation attempt and removes it when corrected; CSS alone doesn't synchronize ARIA.\n * @modifier -inline — Inline layout (shorthand for `-layout-inline`).\n * @modifier -layout-inline — Inline layout: label beside the controls.\n * @modifier -layout-stacked — Stacked layout: label above the controls.\n * @modifier -label-align-start — Start-align the label text.\n * @modifier -label-align-end — End-align the label text.\n * @modifier -invalid — Invalid (error) state.\n * @modifier -readonly — Read-only state.\n * @modifier -v-align-top — Top-align the label with the controls.\n * @modifier -v-align-bottom — Bottom-align the label with the controls.\n * @part .label — The field label.\n * @part .controls — The control area beside or below the label.\n * @pseudo ::after — Renders the decorative required-field asterisk after the label text when the field is required.\n * @accessibility A wrapping `<label>` names the control. When it also contains messages, use `aria-labelledby` to identify just the visible label text and `aria-describedby` for hints. Associate visible validation errors and synchronize `aria-invalid` in application code or with the opt-in native validation behavior; the decorative required asterisk isn't an accessible-name substitute.\n * @compat Contains its element styles with the CSS `@scope` at-rule; needs a recent Chromium, Firefox, or Safari.\n * @example -canvas-rce\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\" id=\"email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" placeholder=\"[REDACTED_EMAIL]\" aria-labelledby=\"email-label\" aria-describedby=\"email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"email-hint\">We'll never share it.</span>\n *     <span class=\"pfx-form-field-message -type-error\">Enter a valid email address.</span>\n *   </span>\n * </label>\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation data-a11y-root>\n *   <span class=\"label\" id=\"audit-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"audit-email-label\" aria-describedby=\"audit-email-hint\" data-a11y-trigger></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"audit-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"audit-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * ```\n * @example -docs\n * ```html\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\">Display name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"text\" autocomplete=\"nickname\"></span>\n * </label>\n * ```\n * ### Native validation (opt-in)\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation>\n *   <span class=\"label\" id=\"native-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"native-email-label\" aria-describedby=\"native-email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"native-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"native-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * ```\n * @structure\n * .pfx-form-field {\n *   .label {}\n *   .controls {\n *     .pfx-text-input {}\n *   }\n *   .pfx-form-field-messages {}\n * }\n * @related form-field-messages — Renders the field's hint, error, and success messages.\n * @related form-field-group — Groups related fields under a shared legend.\n */\n.pfx-form-field {\n  display: grid;\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n  gap: var(--instui-component-form-field-layout-gap-inputs);\n  color: var(--instui-component-form-field-layout-text-color);\n  font-family: var(--instui-component-form-field-layout-font-family);\n}\n\n@scope (.pfx-form-field) {\n  :scope {\n    > .label {\n      grid-area: label;\n      color: var(--instui-component-form-field-layout-text-color);\n      font-family: var(--instui-component-form-field-layout-font-family);\n      font-weight: var(--instui-component-form-field-layout-font-weight);\n      font-size: var(--instui-component-form-field-layout-font-size);\n      line-height: var(--instui-component-form-field-layout-line-height);\n    }\n\n    > .controls {\n      grid-area: controls;\n    }\n  }\n}\n\n/* Messages region — kept OUTSIDE @scope: the messages class shares the form-field prefix. */\n.pfx-form-field > .pfx-form-field-messages {\n  grid-area: messages;\n}\n\n/* Client-side validation: an error message stays hidden until the field's control is :user-invalid\n   (after the user has interacted), per MDN guidance; then it shows. The explicit -invalid class on the\n   control (and a standalone .instui-form-field-messages outside a field) are unaffected. */\n.pfx-form-field .pfx-form-field-message.-type-error,\n.pfx-form-field .pfx-form-field-message.-type-new-error {\n  display: none;\n}\n\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field:has(:user-invalid) .pfx-form-field-message.-type-new-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-error:not([hidden]),\n.pfx-form-field.-invalid .pfx-form-field-message.-type-new-error:not([hidden]) {\n  display: inline-flex;\n}\n\n/* Required indicator: native [required] control OR the -required class; decorative (aria-hidden). */\n.pfx-form-field:is(.-required, :has(:required)) .label::after {\n  content: \"*\";\n  margin-inline-start: 0.25rem;\n  color: var(--instui-component-form-field-layout-asterisk-color);\n}\n\n.pfx-form-field.-readonly .label {\n  color: var(--instui-component-form-field-layout-readonly-text-color);\n}\n\n.pfx-form-field.-layout-stacked {\n  grid-template-columns: 1fr;\n  grid-template-areas: \"label\" \"controls\" \"messages\";\n}\n\n.pfx-form-field.-layout-inline {\n  grid-template-columns: auto 1fr;\n  grid-template-areas: \"label controls\" \". messages\";\n  align-items: center;\n  column-gap: var(--instui-component-form-field-layout-gap-primitives);\n}\n\n.pfx-form-field.-layout-inline.-v-align-top {\n  align-items: start;\n}\n\n.pfx-form-field.-layout-inline.-v-align-bottom {\n  align-items: end;\n}\n\n.pfx-form-field.-layout-inline.-label-align-start .label {\n  text-align: start;\n}\n\n.pfx-form-field.-layout-inline.-label-align-end .label {\n  text-align: end;\n}\n\n.pfx-form-field.-inline {\n  display: inline-grid;\n  inline-size: auto;\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field/form-field.css","content":"/**\n * @component form-field\n * @summary A form-field wrapper: a label, its controls, and inline, required, or readonly layouts.\n * @remarks An error message stays hidden until the field's control is `:user-invalid` (after the user interacts) or you add the `-invalid` class. Use `-layout-inline` to put the label beside the controls and `-layout-stacked` to put it above. Also sets its own `gap` between the label, controls, and messages; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @remarks Native validation is opt-in: add `data-native-validation` and load `@pantoken/interactions/form-field.iife.js`, or call `initFormField(host, control, error)`. Supply exactly one native control and one error message with a stable, unique ID. The behavior associates the error after blur or a native validation attempt and removes it when corrected; CSS alone doesn't synchronize ARIA.\n * @modifier -inline — Inline layout (shorthand for `-layout-inline`).\n * @modifier -layout-inline — Inline layout: label beside the controls.\n * @modifier -layout-stacked — Stacked layout: label above the controls.\n * @modifier -label-align-start — Start-align the label text.\n * @modifier -label-align-end — End-align the label text.\n * @modifier -invalid — Invalid (error) state.\n * @modifier -readonly — Read-only state.\n * @modifier -v-align-top — Top-align the label with the controls.\n * @modifier -v-align-bottom — Bottom-align the label with the controls.\n * @part .label — The field label.\n * @part .controls — The control area beside or below the label.\n * @pseudo ::after — Renders the decorative required-field asterisk after the label text when the field is required.\n * @accessibility A wrapping `<label>` names the control. When it also contains messages, use `aria-labelledby` to identify just the visible label text and `aria-describedby` for hints. Associate visible validation errors and synchronize `aria-invalid` in application code or with the opt-in native validation behavior; the decorative required asterisk isn't an accessible-name substitute.\n * @compat Contains its element styles with the CSS `@scope` at-rule; needs a recent Chromium, Firefox, or Safari.\n * @example -canvas-rce\n * <label class=\"pfx-form-field\">\n *   <span class=\"label\" id=\"email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" placeholder=\"[REDACTED_EMAIL]\" aria-labelledby=\"email-label\" aria-describedby=\"email-hint\"></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"email-hint\">We'll never share it.</span>\n *     <span class=\"pfx-form-field-message -type-error\">Enter a valid email address.</span>\n *   </span>\n * </label>\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-form-field\" data-native-validation data-a11y-root>\n *   <span class=\"label\" id=\"audit-email-label\">Email address</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" type=\"email\" autocomplete=\"email\" required value=\"[REDACTED_EMAIL]\" aria-labelledby=\"audit-email-label\" aria-describedby=\"audit-email-hint\" data-a11y-trigger></span>\n *   <span class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\" id=\"audit-email-hint\">Use your work email.</span>\n *     <span class=\"pfx-form-field-message -type-error\" id=\"audit-email-error\" hidden>Enter a valid email address.</span>\n *   </span>\n * </label>\n * <label class=\"pfx-form-field -layout-stacked\">\n *   <span class=\"label\" id=\"audit-field-stacked-label\">Stacked name</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-stacked-label\"></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline -label-align-start -v-align-top\">\n *   <span class=\"label\" id=\"audit-field-top-label\">Top label</span>\n *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-top-label\">An inline field with a taller control.</textarea></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline -label-align-end -v-align-bottom\">\n *   <span class=\"label\" id=\"audit-field-bottom-label\">End label</span>\n *   <span class=\"controls\"><textarea class=\"pfx-text-area\" aria-labelledby=\"audit-field-bottom-label\">Bottom-aligned control.</textarea></span>\n * </label>\n * <label class=\"pfx-form-field -layout-inline\">\n *   <span class=\"label\" id=\"audit-field-middle-label\">Center label</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-middle-label\"></span>\n * </label>\n * <p><label class=\"pfx-form-field -inline\">\n *   <span class=\"label\" id=\"audit-field-inline-label\">Intrinsic field</span>\n *   <span class=\"controls\"><input class=\"pfx-text-input\" aria-labelledby=\"audit-field-inline-label\"></span>\n * </label></p>\n * <label class=\"pfx-form-field -invalid\">\n *   <span class=\"label\" id=\"audit-field-invalid-label\">Required name</span>\n *   <span class=\"controls\"><input clas