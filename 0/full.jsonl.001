), +))(\\\"covers every canonical visual modifier for the plugin $name\\\", (record) => { + const entry = parseCssDocs(record.rules(\\\"instui-\\\")).find((item) => item.name === record.name)!; + const markup = resolveExampleTargets(entry.examples).automatica11y + .map((index) => exampleHtml(entry.examples[index]!)) + .join(\\\"\\\\n\\\"); + const window = new Window(); + window.document.body.innerHTML = markup; + const classes = new Set( + [...window.document.querySelectorAll(\\\"[class]\\\")].flatMap((element) => [...element.classList]), + ); + for (const modifier of entry.modifiers) { + if (modifier.name.includes(\\\"*\\\") || modifier.description.includes(\\\"@alias\\\")) continue; + expect(classes.has(modifier.name), `${record.name}: ${modifier.name}`).toBe(true); + } + void window.happyDOM.abort(); +}); *** End Patch\\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/declarations/focus/index.ts @@ - * <button class=\\\"instui-button -focus-color-danger\\\" data-a11y-root data-a11y-trigger>Delete</button> + * <button data-a11y-root data-a11y-trigger>Default focus</button> + * <button class=\\\"-focus-color-danger\\\">Danger focus</button> + * <button class=\\\"-focus-color-success\\\">Success focus</button> + * <div style=\\\"background: var(--instui-color-background-brand)\\\"> + * <button class=\\\"-focus-color-inverse\\\">Inverse focus</button> + * </div> + * <button class=\\\"-focus-position-inset\\\">Inset focus</button> + * <div class=\\\"-focus-within\\\"><button>Focus within</button></div> + * <button class=\\\"-without-focus-animation\\\">Focus without animation</button> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/ai-gradient/index.ts @@ - * <div class=\\\"--border-color-ai --border-radius-md --border-width-sm --p-md\\\"> - * AI-generated summary - * </div> + * <div class=\\\"--border-color-ai\\\">AI border</div> + * <div class=\\\"--border-color