creen-reader-content.css @@ - * <span aria-hidden=\"true\">⚙</span> + * <span aria-hidden=\"true\">+</span> *** End Patch\n[tool rg -> success] args={\"pattern\":\"custom-components|readdirSync\\\\(.*assets\",\"paths\":\"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\",\"output_mode\":\"content\",\"-n\":true,\"-C\":3}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts @@ \"components/fonts.css\", + ...(item.record === \"logo\" ? [\"logos/canvas-horizontal-color.css\"] : []), @@ [\"plugins/pantoken/custom-components/dist\", \"custom-components\"], + [\"plugins/pantoken/logos/dist\", \"logos\"], *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts @@ expect(page).toContain(\"control.checkValidity()\"); + const logoPage = renderPage({ ...cases[0]!, record: \"logo\" }); + expect(logoPage).toContain('href=\"assets/logos/canvas-horizontal-color.css\"'); @@ \"plugins/pantoken/custom-components/dist\", + \"plugins/pantoken/logos/dist\", @@ \"interactions\", + \"logos\", *** End Patch\n[tool bash -> success] args={\"command\":\"vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate plugin fixtures and harness\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --help\",\"description\":\"Check changeset CLI options\",\"initial_wait\":60}\n[tool bash -> success] args={\"command\":\"cd formats/components && node --input-type=module -e 'import {parseCssDocs} from \\\"@cssdoc/core\\\"; import {PLUGIN_AUDIT_RECORDS} from \\\"./scripts/audit-plugin-components.ts\\\"; console.log(JSON.stringify(parseCssDocs(PLUGIN_AUDIT_RECORDS.find(x=>x.name===\\\"banner\\\").rules(\\\"instui-\\\")).find(x=>x.name===\\\"banner\\\").modifiers,null,2))'\",\"description\":\"Inspect parsed modifier alias metadata\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-examples.test.ts @@ - if (modifier.name.includes(\"*\") || modifier.description.includes(\"@alias\")) continue; + if (modifier.pattern || modifier.alias) continue; *** End Patch\n[tool write_agent -> success] args={\"agent_ids\":[\"049c1373-ecc6-4d66-bbea-f19e45c06453\",\"78631379-5bbe-4a0d-a590-18491ff526c0\",\"13128f82-ab9e-41de-a14e-bd6978da289e\"],\"message\":\"Parsed CssDocEntry.modifiers carries modifier.alias.canonical (not description @alias) and modifier.pattern. I'll add metadata-derived guard that requires canonical visual color/size/variant/state modifier classes on matching component roots, skipping aliases/patterns. Flag any intentional exceptions with rationale. Please ensure data-a11y roots/triggers remain where harness needs them; root identifiers should remain unique. Guard tests now normalize pfx before checking IDs/ARIA for plugin records too.\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md @@ member's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it. Use fenced HTML so audience flags remain metadata, not visible page content. +Keep one audit example per record, with distinct visual variants together: canonical colors, sizes, +and supported states. Don't duplicate deprecated aliases or build a Cartesian product of every +modifier. Include meaningful labels, selected and unselected choices, and native `disabled`, +`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface +for inverse/on-color treatments, without overriding the component's tested colors. Keep decorative +content hidden from assistive technology and preserve required parent/member structures. + +Stack independent cases in normal document flow instead of forcing a wide row. Expanded dialog +variants can use `open` so they remain measurable without one modal hiding the others. Static state +markup is not evidence that hover, keyboard interaction, focus movement, or announcements work: +those still need interaction checks and manual testing. Don't remove a supported variant or add a +fixture-only CSS fix to make the audit pass. + Run `vp run audit:components` from the repository root. It builds local styles and behavior bundles, *** End Patch\n[tool bash -> success] args={\"command\":\"vp check --fix formats/components/tests/audit-examples.test.ts formats/components/scripts/audit-accessibility.ts formats/components/tests/audit-accessibility.test.ts formats/components/src/declarations/focus/index.ts formats/components/src/utilities/ai-gradient/index.ts plugins/pantoken/custom-components/src/components docs/conventions/authoring.md && vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate own plugin and utility changes\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --patch @pantoken/components,@pantoken/plugin-custom-components -m \\\"Expand accessibility audit examples to exercise distinct visual variants and native control states, with minimal component-owned markup.\\\"\",\"description\":\"Generate audit-fixture changeset\",\"initial_wait\":60}","copilot_cache_control":{"type":"ephemeral"}},{"content":"ALLOW: Authorized audit-fixture update within the requested project scope.","refusal":null,"role":"assistant","reasoning_opaque":"REDACTED","reasoning_text":"","encrypted_content":"REDACTED","reasoningBlocks":{"provider":"openai-responses","blocks":[{"content":[],"encrypted_content":"REDACTED","id":"","summary":[],"type":"reasoning"}]},"responses_message_status":"completed","phase":"final_answer","serverTools":{"provider":"openai-responses"},"apiCallId":"","outputTokens":133,"providerId":"copilot"}]},"id":"bf088356-55cb-4551-9485-440a8ceb92b5","timestamp":"2026-10-28T21:04:49.816Z","parentId":"85cc94b9-e75e-47f6-b80e-6fead1a72967"}
{"type":"permission.requested","data":{"requestId":"4f15d972-211c-4fa0-8747-793c38596bcc","permissionRequest":{"kind":"write","toolCallId":"custom_call_xlWbt2qtOIQCYLa3C9rrczzw","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css\n@@ -62,33 +62,38 @@\n  * @related radio-input-group — Groups radio inputs under a legend.\n  * @example -automatica11y\n  * ```html\n- * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n- *   <legend>Shipping address</legend>\n+ * <fieldset class=\"pfx-form-field-group\">\n+ *   <legend>Stacked fields</legend>\n  *   <label class=\"pfx-form-field\">\n- *     <span class=\"label\">First name</span>\n+ *     <span class=\"label\">Name</span>\n  *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n  *   </label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-none -row-spacing-none -v-align-top\">\n+ *   <legend>Columns without gaps</legend>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Region</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-inline -col-spacing-small -row-spacing-small -v-align-middle\">\n+ *   <legend>Inline fields with small gaps</legend>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Town</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium -row-spacing-medium -v-align-bottom\">\n+ *   <legend>Columns with medium gaps</legend>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-aligned -col-spacing-large -row-spacing-large -required\">\n+ *   <legend>Aligned required fields</legend>\n  *   <label class=\"pfx-form-field\">\n- *     <span class=\"label\">Last name</span>\n- *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n+ *     <span class=\"label\">Name</span>\n+ *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Alex\"></span>\n  *   </label>\n  *   <label class=\"pfx-form-field\">\n  *     <span class=\"label\">City</span>\n- *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n- *   </label>\n- *   <label class=\"pfx-form-field\">\n- *     <span class=\"label\">State</span>\n- *     <span class=\"controls\">\n- *       <select class=\"pfx-simple-select\">\n- *         <option>CA</option>\n- *         <option>NY</option>\n- *         <option>TX</option>\n- *       </select>\n- *     </span>\n+ *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Denver\"></span>\n  *   </label>\n- *   <div class=\"pfx-form-field-messages\">\n- *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n- *   </div>\n  * </fieldset>\n  * ```\n  */\n","newFileContents":"/**\n * @component form-field-group\n * @selector .pfx-form-field-group\n * @summary A `<fieldset>` group with a legend, a column or inline layout, and configurable spacing.\n * @remarks Sets its own `gap` between fields, tunable with the `-col-spacing-*`/`-row-spacing-*` modifiers below — prefer those over chaining a generic `-gap-*` spacing utility modifier, which overrides the built-in value outright.\n * @modifier -col-spacing-none — No column gap.\n * @modifier -col-spacing-small — Small column gap.\n * @modifier -col-spacing-medium — Medium column gap.\n * @modifier -col-spacing-large — Large column gap.\n * @modifier -row-spacing-none — No row gap.\n * @modifier -row-spacing-small — Small row gap.\n * @modifier -row-spacing-medium — Medium row gap.\n * @modifier -row-spacing-large — Large row gap.\n * @modifier -layout-aligned — Align child fields to a shared grid.\n * @modifier -layout-columns — Lay child fields out in columns.\n * @modifier -layout-inline — Lay child fields inline, in a row.\n * @modifier -required — Mark the group as required.\n * @modifier -v-align-top — Top-align the fields.\n * @modifier -v-align-middle — Middle-align the fields.\n * @modifier -v-align-bottom — Bottom-align the fields.\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Renders a native `<fieldset>` with a `<legend>`, so the legend text names the whole group for assistive tech.\n * @compat The `-layout-aligned` mode uses CSS subgrid behind an `@supports` guard; where subgrid is unsupported, the fields fall back to their own stacked layout.\n * @example -canvas-rce -docs\n * ```html\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n *   <legend>Shipping address</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">First name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Last name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">State</span>\n *     <span class=\"controls\">\n *       <select class=\"pfx-simple-select\">\n *         <option>CA</option>\n *         <option>NY</option>\n *         <option>TX</option>\n *       </select>\n *     </span>\n *   </label>\n *   <div class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n *   </div>\n * </fieldset>\n * ```\n * @structure\n * .pfx-form-field-group.-layout-columns.-col-spacing-medium {\n *   legend {}\n *   .pfx-form-field {}\n *   .pfx-form-field-messages {}\n * }\n * @related form-field — The single field this group repeats.\n * @related radio-input-group — Groups radio inputs under a legend.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-form-field-group\">\n *   <legend>Stacked fields</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-none -row-spacing-none -v-align-top\">\n *   <legend>Columns without gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Region</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-inline -col-spacing-small -row-spacing-small -v-align-middle\">\n *   <legend>Inline fields with small gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Town</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium -row-spacing-medium -v-align-bottom\">\n *   <legend>Columns with medium gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-aligned -col-spacing-large -row-spacing-large -required\">\n *   <legend>Aligned required fields</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Alex\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Denver\"></span>\n *   </label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-form-field-group) {\n  & {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    grid-column: 1 / -1;\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  &.-layout-columns,\n  &.-layout-inline {\n    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));\n  }\n\n  &.-row-spacing-none {\n    row-gap: 0;\n  }\n\n  &.-row-spacing-small {\n    row-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-row-spacing-medium {\n    row-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-row-spacing-large {\n    row-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-col-spacing-none {\n    column-gap: 0;\n  }\n\n  &.-col-spacing-small {\n    column-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-col-spacing-medium {\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-col-spacing-large {\n    column-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-v-align-top {\n    align-items: start;\n  }\n\n  &.-v-align-middle {\n    align-items: center;\n  }\n\n  &.-v-align-bottom {\n    align-items: end;\n  }\n\n  /* -layout-aligned: the group's inline fields share one [label | controls] grid via subgrid, so every\n     label lines up in a single column (Chromium/Firefox). Inert where subgrid is unsupported — the fields\n     just fall back to their own stacked layout. */\n  @supports (grid-template-columns: subgrid) {\n    &.-layout-aligned {\n      grid-template-columns: auto 1fr;\n      align-items: center;\n    }\n\n    &.-layout-aligned > .pfx-form-field {\n      display: grid;\n      grid-column: 1 / -1;\n      grid-template-columns: subgrid;\n      grid-template-areas: \"label controls\" \". messages\";\n      align-items: center;\n    }\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css","content":"/**\n * @component form-field-group\n * @selector .pfx-form-field-group\n * @summary A `<fieldset>` group with a legend, a column or inline layout, and configurable spacing.\n * @remarks Sets its own `gap` between fields, tunable with the `-col-spacing-*`/`-row-spacing-*` modifiers below — prefer those over chaining a generic `-gap-*` spacing utility modifier, which overrides the built-in value outright.\n * @modifier -col-spacing-none — No column gap.\n * @modifier -col-spacing-small — Small column gap.\n * @modifier -col-spacing-medium — Medium column gap.\n * @modifier -col-spacing-large — Large column gap.\n * @modifier -row-spacing-none — No row gap.\n * @modifier -row-spacing-small — Small row gap.\n * @modifier -row-spacing-medium — Medium row gap.\n * @modifier -row-spacing-large — Large row gap.\n * @modifier -layout-aligned — Align child fields to a shared grid.\n * @modifier -layout-columns — Lay child fields out in columns.\n * @modifier -layout-inline — Lay child fields inline, in a row.\n * @modifier -required — Mark the group as required.\n * @modifier -v-align-top — Top-align the fields.\n * @modifier -v-align-middle — Middle-align the fields.\n * @modifier -v-align-bottom — Bottom-align the fields.\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Renders a native `<fieldset>` with a `<legend>`, so the legend text names the whole group for assistive tech.\n * @compat The `-layout-aligned` mode uses CSS subgrid behind an `@supports` guard; where subgrid is unsupported, the fields fall back to their own stacked layout.\n * @example -canvas-rce -docs\n * ```html\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n *   <legend>Shipping address</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">First name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Last name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">State</span>\n *     <span class=\"controls\">\n *       <select class=\"pfx-simple-select\">\n *         <option>CA</option>\n *         <option>NY</option>\n *         <option>TX</option>\n *       </select>\n *     </span>\n *   </label>\n *   <div class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n *   </div>\n * </fieldset>\n * ```\n * @structure\n * .pfx-form-field-group.-layout-columns.-col-spacing-medium {\n *   legend {}\n *   .pfx-form-field {}\n *   .pfx-form-field-messages {}\n * }\n * @related form-field — The single field this group repeats.\n * @related radio-input-group — Groups radio inputs under a legend.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n *   <legend>Shipping address</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">First name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Last name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">State</span>\n *     <span class=\"controls\">\n *       <select class=\"pfx-simple-select\">\n *         <option>CA</option>\n *         <option>NY</option>\n *         <option>TX</option>\n *       </select>\n *     </span>\n *   </label>\n *   <div class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n *   </div>\n * </fieldset>\n * ```\n */\n@scope (.pfx-form-field-group) {\n  & {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    grid-column: 1 / -1;\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  &.-layout-columns,\n  &.-layout-inline {\n    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));\n  }\n\n  &.-row-spacing-none {\n    row-gap: 0;\n  }\n\n  &.-row-spacing-small {\n    row-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-row-spacing-medium {\n    row-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-row-spacing-large {\n    row-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-col-spacing-none {\n    column-gap: 0;\n  }\n\n  &.-col-spacing-small {\n    column-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-col-spacing-medium {\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-col-spacing-large {\n    column-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-v-align-top {\n    align-items: start;\n  }\n\n  &.-v-align-middle {\n    align-items: center;\n  }\n\n  &.-v-align-bottom {\n    align-items: end;\n  }\n\n  /* -layout-aligned: the group's inline fields share one [label | controls] grid via subgrid, so every\n     label lines up in a single column (Chromium/Firefox). Inert where subgrid is unsupported — the fields\n     just fall back to their own stacked layout. */\n  @supports (grid-template-columns: subgrid) {\n    &.-layout-aligned {\n      grid-template-columns: auto 1fr;\n      align-items: center;\n    }\n\n    &.-layout-aligned > .pfx-form-field {\n      display: grid;\n      grid-column: 1 / -1;\n      grid-template-columns: subgrid;\n      grid-template-areas: \"label controls\" \". messages\";\n      align-items: center;\n    }\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css","content":"/**\n * @component form-field-group\n * @selector .pfx-form-field-group\n * @summary A `<fieldset>` group with a legend, a column or inline layout, and configurable spacing.\n * @remarks Sets its own `gap` between fields, tunable with the `-col-spacing-*`/`-row-spacing-*` modifiers below — prefer those over chaining a generic `-gap-*` spacing utility modifier, which overrides the built-in value outright.\n * @modifier -col-spacing-none — No column gap.\n * @modifier -col-spacing-small — Small column gap.\n * @modifier -col-spacing-medium — Medium column gap.\n * @modifier -col-spacing-large — Large column gap.\n * @modifier -row-spacing-none — No row gap.\n * @modifier -row-spacing-small — Small row gap.\n * @modifier -row-spacing-medium — Medium row gap.\n * @modifier -row-spacing-large — Large row gap.\n * @modifier -layout-aligned — Align child fields to a shared grid.\n * @modifier -layout-columns — Lay child fields out in columns.\n * @modifier -layout-inline — Lay child fields inline, in a row.\n * @modifier -required — Mark the group as required.\n * @modifier -v-align-top — Top-align the fields.\n * @modifier -v-align-middle — Middle-align the fields.\n * @modifier -v-align-bottom — Bottom-align the fields.\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Renders a native `<fieldset>` with a `<legend>`, so the legend text names the whole group for assistive tech.\n * @compat The `-layout-aligned` mode uses CSS subgrid behind an `@supports` guard; where subgrid is unsupported, the fields fall back to their own stacked layout.\n * @example -canvas-rce -docs\n * ```html\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n *   <legend>Shipping address</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">First name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Last name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">State</span>\n *     <span class=\"controls\">\n *       <select class=\"pfx-simple-select\">\n *         <option>CA</option>\n *         <option>NY</option>\n *         <option>TX</option>\n *       </select>\n *     </span>\n *   </label>\n *   <div class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n *   </div>\n * </fieldset>\n * ```\n * @structure\n * .pfx-form-field-group.-layout-columns.-col-spacing-medium {\n *   legend {}\n *   .pfx-form-field {}\n *   .pfx-form-field-messages {}\n * }\n * @related form-field — The single field this group repeats.\n * @related radio-input-group — Groups radio inputs under a legend.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-form-field-group\">\n *   <legend>Stacked fields</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-none -row-spacing-none -v-align-top\">\n *   <legend>Columns without gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Region</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-inline -col-spacing-small -row-spacing-small -v-align-middle\">\n *   <legend>Inline fields with small gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Town</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium -row-spacing-medium -v-align-bottom\">\n *   <legend>Columns with medium gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-aligned -col-spacing-large -row-spacing-large -required\">\n *   <legend>Aligned required fields</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Alex\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Denver\"></span>\n *   </label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-form-field-group) {\n  & {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    grid-column: 1 / -1;\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  &.-layout-columns,\n  &.-layout-inline {\n    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));\n  }\n\n  &.-row-spacing-none {\n    row-gap: 0;\n  }\n\n  &.-row-spacing-small {\n    row-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-row-spacing-medium {\n    row-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-row-spacing-large {\n    row-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-col-spacing-none {\n    column-gap: 0;\n  }\n\n  &.-col-spacing-small {\n    column-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-col-spacing-medium {\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-col-spacing-large {\n    column-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-v-align-top {\n    align-items: start;\n  }\n\n  &.-v-align-middle {\n    align-items: center;\n  }\n\n  &.-v-align-bottom {\n    align-items: end;\n  }\n\n  /* -layout-aligned: the group's inline fields share one [label | controls] grid via subgrid, so every\n     label lines up in a single column (Chromium/Firefox). Inert where subgrid is unsupported — the fields\n     just fall back to their own stacked layout. */\n  @supports (grid-template-columns: subgrid) {\n    &.-layout-aligned {\n      grid-template-columns: auto 1fr;\n      align-items: center;\n    }\n\n    &.-layout-aligned > .pfx-form-field {\n      display: grid;\n      grid-column: 1 / -1;\n      grid-template-columns: subgrid;\n      grid-template-areas: \"label controls\" \". messages\";\n      align-items: center;\n    }\n  }\n}\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_xlWbt2qtOIQCYLa3C9rrczzw","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css\n@@ -62,33 +62,38 @@\n  * @related radio-input-group — Groups radio inputs under a legend.\n  * @example -automatica11y\n  * ```html\n- * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n- *   <legend>Shipping address</legend>\n+ * <fieldset class=\"pfx-form-field-group\">\n+ *   <legend>Stacked fields</legend>\n  *   <label class=\"pfx-form-field\">\n- *     <span class=\"label\">First name</span>\n+ *     <span class=\"label\">Name</span>\n  *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n  *   </label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-none -row-spacing-none -v-align-top\">\n+ *   <legend>Columns without gaps</legend>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Region</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-inline -col-spacing-small -row-spacing-small -v-align-middle\">\n+ *   <legend>Inline fields with small gaps</legend>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Town</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium -row-spacing-medium -v-align-bottom\">\n+ *   <legend>Columns with medium gaps</legend>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-aligned -col-spacing-large -row-spacing-large -required\">\n+ *   <legend>Aligned required fields</legend>\n  *   <label class=\"pfx-form-field\">\n- *     <span class=\"label\">Last name</span>\n- *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n+ *     <span class=\"label\">Name</span>\n+ *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Alex\"></span>\n  *   </label>\n  *   <label class=\"pfx-form-field\">\n  *     <span class=\"label\">City</span>\n- *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n- *   </label>\n- *   <label class=\"pfx-form-field\">\n- *     <span class=\"label\">State</span>\n- *     <span class=\"controls\">\n- *       <select class=\"pfx-simple-select\">\n- *         <option>CA</option>\n- *         <option>NY</option>\n- *         <option>TX</option>\n- *       </select>\n- *     </span>\n+ *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Denver\"></span>\n  *   </label>\n- *   <div class=\"pfx-form-field-messages\">\n- *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n- *   </div>\n  * </fieldset>\n  * ```\n  */\n","newFileContents":"/**\n * @component form-field-group\n * @selector .pfx-form-field-group\n * @summary A `<fieldset>` group with a legend, a column or inline layout, and configurable spacing.\n * @remarks Sets its own `gap` between fields, tunable with the `-col-spacing-*`/`-row-spacing-*` modifiers below — prefer those over chaining a generic `-gap-*` spacing utility modifier, which overrides the built-in value outright.\n * @modifier -col-spacing-none — No column gap.\n * @modifier -col-spacing-small — Small column gap.\n * @modifier -col-spacing-medium — Medium column gap.\n * @modifier -col-spacing-large — Large column gap.\n * @modifier -row-spacing-none — No row gap.\n * @modifier -row-spacing-small — Small row gap.\n * @modifier -row-spacing-medium — Medium row gap.\n * @modifier -row-spacing-large — Large row gap.\n * @modifier -layout-aligned — Align child fields to a shared grid.\n * @modifier -layout-columns — Lay child fields out in columns.\n * @modifier -layout-inline — Lay child fields inline, in a row.\n * @modifier -required — Mark the group as required.\n * @modifier -v-align-top — Top-align the fields.\n * @modifier -v-align-middle — Middle-align the fields.\n * @modifier -v-align-bottom — Bottom-align the fields.\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Renders a native `<fieldset>` with a `<legend>`, so the legend text names the whole group for assistive tech.\n * @compat The `-layout-aligned` mode uses CSS subgrid behind an `@supports` guard; where subgrid is unsupported, the fields fall back to their own stacked layout.\n * @example -canvas-rce -docs\n * ```html\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n *   <legend>Shipping address</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">First name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Last name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">State</span>\n *     <span class=\"controls\">\n *       <select class=\"pfx-simple-select\">\n *         <option>CA</option>\n *         <option>NY</option>\n *         <option>TX</option>\n *       </select>\n *     </span>\n *   </label>\n *   <div class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n *   </div>\n * </fieldset>\n * ```\n * @structure\n * .pfx-form-field-group.-layout-columns.-col-spacing-medium {\n *   legend {}\n *   .pfx-form-field {}\n *   .pfx-form-field-messages {}\n * }\n * @related form-field — The single field this group repeats.\n * @related radio-input-group — Groups radio inputs under a legend.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-form-field-group\">\n *   <legend>Stacked fields</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-none -row-spacing-none -v-align-top\">\n *   <legend>Columns without gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Region</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-inline -col-spacing-small -row-spacing-small -v-align-middle\">\n *   <legend>Inline fields with small gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Town</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium -row-spacing-medium -v-align-bottom\">\n *   <legend>Columns with medium gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-aligned -col-spacing-large -row-spacing-large -required\">\n *   <legend>Aligned required fields</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Alex\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Denver\"></span>\n *   </label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-form-field-group) {\n  & {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    grid-column: 1 / -1;\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  &.-layout-columns,\n  &.-layout-inline {\n    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));\n  }\n\n  &.-row-spacing-none {\n    row-gap: 0;\n  }\n\n  &.-row-spacing-small {\n    row-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-row-spacing-medium {\n    row-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-row-spacing-large {\n    row-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-col-spacing-none {\n    column-gap: 0;\n  }\n\n  &.-col-spacing-small {\n    column-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-col-spacing-medium {\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-col-spacing-large {\n    column-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-v-align-top {\n    align-items: start;\n  }\n\n  &.-v-align-middle {\n    align-items: center;\n  }\n\n  &.-v-align-bottom {\n    align-items: end;\n  }\n\n  /* -layout-aligned: the group's inline fields share one [label | controls] grid via subgrid, so every\n     label lines up in a single column (Chromium/Firefox). Inert where subgrid is unsupported — the fields\n     just fall back to their own stacked layout. */\n  @supports (grid-template-columns: subgrid) {\n    &.-layout-aligned {\n      grid-template-columns: auto 1fr;\n      align-items: center;\n    }\n\n    &.-layout-aligned > .pfx-form-field {\n      display: grid;\n      grid-column: 1 / -1;\n      grid-template-columns: subgrid;\n      grid-template-areas: \"label controls\" \". messages\";\n      align-items: center;\n    }\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css","content":"/**\n * @component form-field-group\n * @selector .pfx-form-field-group\n * @summary A `<fieldset>` group with a legend, a column or inline layout, and configurable spacing.\n * @remarks Sets its own `gap` between fields, tunable with the `-col-spacing-*`/`-row-spacing-*` modifiers below — prefer those over chaining a generic `-gap-*` spacing utility modifier, which overrides the built-in value outright.\n * @modifier -col-spacing-none — No column gap.\n * @modifier -col-spacing-small — Small column gap.\n * @modifier -col-spacing-medium — Medium column gap.\n * @modifier -col-spacing-large — Large column gap.\n * @modifier -row-spacing-none — No row gap.\n * @modifier -row-spacing-small — Small row gap.\n * @modifier -row-spacing-medium — Medium row gap.\n * @modifier -row-spacing-large — Large row gap.\n * @modifier -layout-aligned — Align child fields to a shared grid.\n * @modifier -layout-columns — Lay child fields out in columns.\n * @modifier -layout-inline — Lay child fields inline, in a row.\n * @modifier -required — Mark the group as required.\n * @modifier -v-align-top — Top-align the fields.\n * @modifier -v-align-middle — Middle-align the fields.\n * @modifier -v-align-bottom — Bottom-align the fields.\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Renders a native `<fieldset>` with a `<legend>`, so the legend text names the whole group for assistive tech.\n * @compat The `-layout-aligned` mode uses CSS subgrid behind an `@supports` guard; where subgrid is unsupported, the fields fall back to their own stacked layout.\n * @example -canvas-rce -docs\n * ```html\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n *   <legend>Shipping address</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">First name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Last name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">State</span>\n *     <span class=\"controls\">\n *       <select class=\"pfx-simple-select\">\n *         <option>CA</option>\n *         <option>NY</option>\n *         <option>TX</option>\n *       </select>\n *     </span>\n *   </label>\n *   <div class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n *   </div>\n * </fieldset>\n * ```\n * @structure\n * .pfx-form-field-group.-layout-columns.-col-spacing-medium {\n *   legend {}\n *   .pfx-form-field {}\n *   .pfx-form-field-messages {}\n * }\n * @related form-field — The single field this group repeats.\n * @related radio-input-group — Groups radio inputs under a legend.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n *   <legend>Shipping address</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">First name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Last name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">State</span>\n *     <span class=\"controls\">\n *       <select class=\"pfx-simple-select\">\n *         <option>CA</option>\n *         <option>NY</option>\n *         <option>TX</option>\n *       </select>\n *     </span>\n *   </label>\n *   <div class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n *   </div>\n * </fieldset>\n * ```\n */\n@scope (.pfx-form-field-group) {\n  & {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    grid-column: 1 / -1;\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  &.-layout-columns,\n  &.-layout-inline {\n    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));\n  }\n\n  &.-row-spacing-none {\n    row-gap: 0;\n  }\n\n  &.-row-spacing-small {\n    row-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-row-spacing-medium {\n    row-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-row-spacing-large {\n    row-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-col-spacing-none {\n    column-gap: 0;\n  }\n\n  &.-col-spacing-small {\n    column-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-col-spacing-medium {\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-col-spacing-large {\n    column-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-v-align-top {\n    align-items: start;\n  }\n\n  &.-v-align-middle {\n    align-items: center;\n  }\n\n  &.-v-align-bottom {\n    align-items: end;\n  }\n\n  /* -layout-aligned: the group's inline fields share one [label | controls] grid via subgrid, so every\n     label lines up in a single column (Chromium/Firefox). Inert where subgrid is unsupported — the fields\n     just fall back to their own stacked layout. */\n  @supports (grid-template-columns: subgrid) {\n    &.-layout-aligned {\n      grid-template-columns: auto 1fr;\n      align-items: center;\n    }\n\n    &.-layout-aligned > .pfx-form-field {\n      display: grid;\n      grid-column: 1 / -1;\n      grid-template-columns: subgrid;\n      grid-template-areas: \"label controls\" \". messages\";\n      align-items: center;\n    }\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/form-field-group/form-field-group.css","content":"/**\n * @component form-field-group\n * @selector .pfx-form-field-group\n * @summary A `<fieldset>` group with a legend, a column or inline layout, and configurable spacing.\n * @remarks Sets its own `gap` between fields, tunable with the `-col-spacing-*`/`-row-spacing-*` modifiers below — prefer those over chaining a generic `-gap-*` spacing utility modifier, which overrides the built-in value outright.\n * @modifier -col-spacing-none — No column gap.\n * @modifier -col-spacing-small — Small column gap.\n * @modifier -col-spacing-medium — Medium column gap.\n * @modifier -col-spacing-large — Large column gap.\n * @modifier -row-spacing-none — No row gap.\n * @modifier -row-spacing-small — Small row gap.\n * @modifier -row-spacing-medium — Medium row gap.\n * @modifier -row-spacing-large — Large row gap.\n * @modifier -layout-aligned — Align child fields to a shared grid.\n * @modifier -layout-columns — Lay child fields out in columns.\n * @modifier -layout-inline — Lay child fields inline, in a row.\n * @modifier -required — Mark the group as required.\n * @modifier -v-align-top — Top-align the fields.\n * @modifier -v-align-middle — Middle-align the fields.\n * @modifier -v-align-bottom — Bottom-align the fields.\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\n * @accessibility Renders a native `<fieldset>` with a `<legend>`, so the legend text names the whole group for assistive tech.\n * @compat The `-layout-aligned` mode uses CSS subgrid behind an `@supports` guard; where subgrid is unsupported, the fields fall back to their own stacked layout.\n * @example -canvas-rce -docs\n * ```html\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium\">\n *   <legend>Shipping address</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">First name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Last name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">State</span>\n *     <span class=\"controls\">\n *       <select class=\"pfx-simple-select\">\n *         <option>CA</option>\n *         <option>NY</option>\n *         <option>TX</option>\n *       </select>\n *     </span>\n *   </label>\n *   <div class=\"pfx-form-field-messages\">\n *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n *   </div>\n * </fieldset>\n * ```\n * @structure\n * .pfx-form-field-group.-layout-columns.-col-spacing-medium {\n *   legend {}\n *   .pfx-form-field {}\n *   .pfx-form-field-messages {}\n * }\n * @related form-field — The single field this group repeats.\n * @related radio-input-group — Groups radio inputs under a legend.\n * @example -automatica11y\n * ```html\n * <fieldset class=\"pfx-form-field-group\">\n *   <legend>Stacked fields</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n *   </label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-none -row-spacing-none -v-align-top\">\n *   <legend>Columns without gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Region</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-inline -col-spacing-small -row-spacing-small -v-align-middle\">\n *   <legend>Inline fields with small gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Town</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium -row-spacing-medium -v-align-bottom\">\n *   <legend>Columns with medium gaps</legend>\n *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n * </fieldset>\n * <fieldset class=\"pfx-form-field-group -layout-aligned -col-spacing-large -row-spacing-large -required\">\n *   <legend>Aligned required fields</legend>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">Name</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Alex\"></span>\n *   </label>\n *   <label class=\"pfx-form-field\">\n *     <span class=\"label\">City</span>\n *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Denver\"></span>\n *   </label>\n * </fieldset>\n * ```\n */\n@scope (.pfx-form-field-group) {\n  & {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: var(--instui-component-form-field-layout-gap-inputs);\n    min-inline-size: 0;\n    margin: 0;\n    padding: 0;\n    border: 0;\n  }\n\n  & > legend {\n    grid-column: 1 / -1;\n    padding: 0;\n    margin-block-end: var(--instui-component-form-field-layout-gap-primitives);\n    color: var(--instui-component-form-field-layout-text-color);\n    font-family: var(--instui-component-form-field-layout-font-family);\n    font-weight: var(--instui-component-form-field-layout-font-weight);\n    font-size: var(--instui-component-form-field-layout-font-size);\n    line-height: var(--instui-component-form-field-layout-line-height);\n  }\n\n  &.-required > legend::after {\n    content: \"*\";\n    margin-inline-start: 0.25rem;\n    color: var(--instui-component-form-field-layout-asterisk-color);\n  }\n\n  &.-layout-columns,\n  &.-layout-inline {\n    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));\n  }\n\n  &.-row-spacing-none {\n    row-gap: 0;\n  }\n\n  &.-row-spacing-small {\n    row-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-row-spacing-medium {\n    row-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-row-spacing-large {\n    row-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-col-spacing-none {\n    column-gap: 0;\n  }\n\n  &.-col-spacing-small {\n    column-gap: var(--instui-spacing-space-sm);\n  }\n\n  &.-col-spacing-medium {\n    column-gap: var(--instui-spacing-space-md);\n  }\n\n  &.-col-spacing-large {\n    column-gap: var(--instui-spacing-space-lg);\n  }\n\n  &.-v-align-top {\n    align-items: start;\n  }\n\n  &.-v-align-middle {\n    align-items: center;\n  }\n\n  &.-v-align-bottom {\n    align-items: end;\n  }\n\n  /* -layout-aligned: the group's inline fields share one [label | controls] grid via subgrid, so every\n     label lines up in a single column (Chromium/Firefox). Inert where subgrid is unsupported — the fields\n     just fall back to their own stacked layout. */\n  @supports (grid-template-columns: subgrid) {\n    &.-layout-aligned {\n      grid-template-columns: auto 1fr;\n      align-items: center;\n    }\n\n    &.-layout-aligned > .pfx-form-field {\n      display: grid;\n      grid-column: 1 / -1;\n      grid-template-columns: subgrid;\n      grid-template-areas: \"label controls\" \". messages\";\n      align-items: center;\n    }\n  }\n}\n"}}],"_permissionRequestSessionId":"e0a110b6-b8dd-47be-82d5-cb60da15b229","assistedApproval":{"recommendation":"approve","reason":"Authorized audit-fixture update within the requested project scope.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"intera