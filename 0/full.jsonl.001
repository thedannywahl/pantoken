{"type":"tool.execution_complete","data":{"toolCallId":"toolu_016Ee73s1dJJPgoGSJHUJhEe","model":"claude-sonnet-5.5","interactionId":"13d1d66b-1a27-42a1-a76c-b2ac94a56693","turnId":"44","rte":true,"shellExecution":{"exitCode":0},"success":true,"result":{"content":"const item = object(value);\n      return [\n        string(item.id),\n        {\n          record: string(item.record),\n          theme: string(item.theme),\n          scheme: string(item.scheme),\n        },\n      ] as const;\n    }),\n  );\n  const records: AccessibilitySnapshot[\"records\"] = {};\n  const seenSuites = new Set<string>();\n  const seenTargets = new Set<string>();\n  for (const rawSuite of array(coverage.evidence)) {\n    const suite = object(rawSuite);\n    const name = string(suite.directory);\n    if (!/^(?:pages|npm)-[a-zA-Z0-9-]+$/u.test(name))\n      throw new Error(`Invalid evidence directory: ${name}`);\n    if (seenSuites.has(name)) throw new Error(`Duplicate evidence directory: ${name}`);\n    seenSuites.add(name);\n    if (suite.error) throw new Error(`Incomplete audit: ${name}`);\n    const raw = readFileSync(join(directory, name, \"results.json\"), \"utf8\");\n    readFileSync(join(directory, name, \"report.md\"), \"utf8\");\n    const results = object(JSON.parse(raw));\n    const tools = Object.fromEntries(\n      Object.entries(object(results.tools)).map(([key, value]) => [key, string(value)]),\n    );\n    const targets = array(results.targets);\n    const expected = array(suite.expected).map(string).sort();\n    const actual = targets.map((target) => string(object(target).id)).sort();\n628-}\n629-\n630:if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n631:  if (process.argv.length !== 3)\n632-    throw new Error(\"Usage: node docs/scripts/accessibility-evidence.ts <audit-run-directory>\");\n633:  const snapshot = importAccessibilityRun(resolve(process.argv[2]!));\n634-  const destination = join(import.meta.dirname, \"../public/accessibility/results.json\");\n635-  writeFileSync(destination, JSON.stringify(snapshot, null, 2) + \"\\n\");\n636-  console.log(\n637-    `Wrote accessibility evidence for ${Object.keys(snapshot.records).length} records: ${destination}`,\n638-  );\n639-}\n<shellId: 188 completed with exit code 0>"},"toolTelemetry":{"properties":{"customTimeout":"false","executionMode":"sync","detached":"false","sandboxApplied":"false","sandboxOptOutRequested":"false"},"metrics":{"commandTimeout":30000.0,"context_token_limit":200000.0,"context_current_tokens":107811.0,"large_output_threshold_bytes":8192.0,"result_token_count":569}}},"id":"5f465c64-7dcb-401b-8266-52315bae9f37","timestamp":"2026-10-28T18:15:04.695Z","parentId":"637dba4c-d5da-49e1-b95b-6f60e30f0e01"}
