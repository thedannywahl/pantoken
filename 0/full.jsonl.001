(dialog open non-modal works since harness skips open). Don't alter harness (I own it if needed); flag popover variants issues. Also plugin card shares core card name and is always loaded; inspect plugin card source if necessary for required core card variants through color agent rather than editing card yourself.\\\"}\\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-examples.test.ts @@ import { CORE_AUDIT_EXTRAS, PLUGIN_AUDIT_RECORDS } from \\\"../scripts/audit-plugin-components.ts\\\"; +import { exampleHtml } from \\\"../scripts/audit-accessibility.ts\\\"; @@ -test.each(records)(\\\"authors an explicit audit example for $name\\\", (record) => { +test.each([...records, ...PLUGIN_AUDIT_RECORDS])(\\\"authors an explicit audit example for $name\\\", (record) => { @@ - window.document.body.innerHTML = fences.map((match) => match[1]).join(\\\"\\\\n\\\"); + window.document.body.innerHTML = exampleHtml(example); @@ }); + +test.each(PLUGIN_AUDIT_RECORDS.filter((record) => + [\\\"banner\\\", \\\"button-set\\\", \\\"segmented-control\\\", \\\"skeleton-loader\\\"].includes(record.name), +))(\\\"covers every canonical visual modifier for the plugin $name\\\", (record) => { + const entry = parseCssDocs(record.rules(\\\"instui-\\\")).find((item) => item.name === record.name)!; + const markup = resolveExampleTargets(entry.examples).automatica11y + .map((index) => exampleHtml(entry.examples[index]!)) + .join(\\\"\\\\n\\\"); + const window = new Window(); + window.document.body.innerHTML = markup; + const classes = new Set( + [...window.document.querySelectorAll(\\\"[class]\\\")].flatMap((element) => [...element.classList]), + ); + for (const modifier of entry.modifiers) { + if (modifier.name.includes(\\\"*\\\") || modifier.description.includes(\\\"@alias\\\")) continue; + expect(classes.has(modifier.name), `${record.name}: ${modifier.name}`).toBe(true); + } + void window.happyDOM.abort(); +}); *** En