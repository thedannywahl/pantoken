in record, shaped like a core record for the audit's cssdoc parsing. */\\nexport interface PluginAuditRecord {\\n name: string;\\n rules(prefix: string): string;\\n}\\n\\nexport const PLUGIN_AUDIT_RECORDS: readonly PluginAuditRecord[] = [\\n { name: \\\"agent-shell\\\", rules: agentShellRules },\\n { name: \\\"banner\\\", rules: bannerRules },\\n { name: \\\"button-set\\\", rules: buttonSetRules },\\n { name: \\\"logo\\\", rules: logoRules },\\n { name: \\\"segmented-control\\\", rules: segmentedControlRules },\\n { name: \\\"skeleton-loader\\\", rules: skeletonLoaderRules },\\n];\\n\\n/** Plugin stylesheet copied next to the core assets for the page audit. */\\nexport const PLUGIN_STYLESHEET = \\\"custom-components/custom-components.css\\\";\\n\"}\n[tool edit -> success] args={\"new_str\":\"import { AUDIT_MATRIX } from \\\"./audit-matrix.ts\\\";\\nimport { PLUGIN_AUDIT_RECORDS, PLUGIN_STYLESHEET } from \\\"./audit-plugin-components.ts\\\";\",\"old_str\":\"import { AUDIT_MATRIX } from \\\"./audit-matrix.ts\\\";\",\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts\"}\n[tool edit -> success] args={\"new_str\":\" \\\"components/components.css\\\",\\n PLUGIN_STYLESHEET,\",\"old_str\":\" \\\"components/components.css\\\",\\n \\\"components/utilities.css\\\",\\n \\\"components/icons.css\\\",\\n \\\"components/fonts.css\\\",\\n ];\\n return `<!doctype\",\"path\":\"/Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts\"}\n[assistant] Oops — my second edit's old_str was wrong; let me inspect the damage.\n[tool bash -> success] args={\"command\":\"cd /Users/dwahl/Scripts/pantoken && git diff formats/components/scripts/audit-accessibility.ts\",\"description\":\"Check diff\"}\n[tool edit -> success] args={\"new_str\":\" \\\"components/components.css\\\",\\n PLUGIN_STYLESHEET,\\n \\\"components/utilities.css\\\",\\n \\\"components/icons.css\\\",\\n \\\"components/fonts.css\\\",\\n ];\\n return `<!doctype html>\",\