ss\\\\nindex 0000000..0000000 100644\\\\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css\\\\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css\\\\n@@ -39,17 +39,26 @@\\\\n  * @example -automatica11y\\\\n  * ```html\\\\n  * <fieldset class=\\\\\\\"pfx-radio-input-group\\\\\\\">\\\\n- *   <legend>T-shirt size</legend>\\\\n- *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"shirt-size\\\\\\\" checked> Small</label>\\\\n- *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"shirt-size\\\\\\\"> Medium</label>\\\\n- *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"shirt-size\\\\\\\"> Large</label>\\\\n+ *   <legend>Stacked sizes</legend>\\\\n+ *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"audit-shirt-size\\\\\\\" value=\\\\\\\"sm\\\\\\\" checked>Small</label>\\\\n+ *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"audit-shirt-size\\\\\\\" value=\\\\\\\"md\\\\\\\">Medium</label>\\\\n+ *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"audit-shirt-size\\\\\\\" value=\\\\\\\"lg\\\\\\\" disabled>Large unavailable</label>\\\\n+ * </fieldset>\\\\n+ * <fieldset class=\\\\\\\"pfx-radio-input-group -layout-columns\\\\\\\">\\\\n+ *   <legend>Column sizes</legend>\\\\n+ *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"audit-column-size\\\\\\\" value=\\\\\\\"sm\\\\\\\" checked>Small</label>\\\\n+ *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"audit-column-size\\\\\\\" value=\\\\\\\"md\\\\\\\">Medium</label>\\\\n  * </fieldset>\\\\n- * \\\\n+ * <fieldset class=\\\\\\\"pfx-radio-input-group -layout-inline -required\\\\\\\">\\\\n+ *   <legend>Required inline size</legend>\\\\n+ *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"audit-inline-size\\\\\\\" value=\\\\\\\"sm\\\\\\\" required checked>Small</label>\\\\n+ *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"audit-inline-size\\\\\\\" value=\\\\\\\"md\\\\\\\" required>Medium</label>\\\\n+ * </fieldset>\\\\n  * <fieldset class=\\\\\\\"pfx-radio-input-group -variant-toggl… [truncated 801 chars]\\\",\\n  \\\"newFileContents\\\": \\\"/**\\\\n * @component radio-input-group\\\\n * @selector .pfx-radio-input-group\\\\n * @summary A single-select radio `<fieldset>`, plain or as a connected segmented toggle.\\\\n * @remarks Sets its own `gap` between radios; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\\\\n * @modifier -layout-columns — Lay the radios out in columns.\\\\n * @modifier -layout-inline — Lay the radios out inline.\\\\n * @modifier -required — Mark the group as required.\\\\n * @modifier -variant-toggle — Lay the child toggles out as a segmented control (only the selected segment fills).\\\\n * @pseudo ::after — Renders the decorative required-field asterisk after the legend text when the group is required.\\\\n * @accessibility Use a native `<fieldset>` with a `<legend>` that names the group. Radios within a group share one `name`; independent groups need distinct names and legends so selecting one group's radio doesn't clear another group's selection.\\\\n * @example -canvas-rce -docs\\\\n  * ```html\\\\n * <fieldset class=\\\\\\\"pfx-radio-input-group\\\\\\\">\\\\n *   <legend>T-shirt size</legend>\\\\n *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"shirt-size\\\\\\\" checked> Small</label>\\\\n *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"shirt-size\\\\\\\"> Medium</label>\\\\n *   <label class=\\\\\\\"pfx-radio\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"shirt-size\\\\\\\"> Large</label>\\\\n * </fieldset>\\\\n * ```\\\\n * ### Toggle variant\\\\n * ```html\\\\n * <fieldset class=\\\\\\\"pfx-radio-input-group -variant-toggle\\\\\\\">\\\\n *   <legend>Sweatshirt size</legend>\\\\n *   <label class=\\\\\\\"pfx-radio -variant-toggle\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"sweatshirt-size\\\\\\\" checked> Small</label>\\\\n *   <label class=\\\\\\\"pfx-radio -variant-toggle\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"sweatshirt-size\\\\\\\"> Medium</label>\\\\n *   <label class=\\\\\\\"pfx-radio -variant-toggle\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"sweatshirt-size\\\\\\\"> Large</label>\\\\n * </fieldset>\\\\n * ```\\\\n * @structure\\\\n * .pfx-radio-input-group.-variant-toggle {\\\\n *   legend {}\\\\n *   .pfx-radio.-variant-toggle {\\\\n *     input {}\\\\n *   }\\\\n * }\\\\n * @related radio — The individual control this group… [truncated 3479 chars]\\\",\\n  \\\"canOfferSessionApproval\\\": true,\\n  \\\"_permissionRequestSessionId\\\": \\\"e0a110b6-b8dd-47be-82d5-cb60da15b229\\\",\\n  \\\"_subagentAgentId\\\": \\\"049c1373-ecc6-4d66-bbea-f19e45c06453\\\"\\n}\\n```\\n\\n\"},{\"role\":\"user\",\"content\":\"Apply the policy to the concrete mechanics, not only the requested goal.\\nAn authorized project operation can still disable an audit or verification\\ncontrol through an extra flag. Suppressing that control for just one invocation\\nis a bypass. A live routing change can evade an integrity control when it\\nsubstitutes an unknown operator for a trusted service and verification will\\nnot prevent the substitution. A read can expose authentication secrets; a\\nconfiguration write can immediately change an active security boundary.\\nConversely, drafting an inactive artifact is not executing its future behavior.\\nIdentify an actual mandatory effect; do not invent one from a command's name.\\n\\nMandatory confirmation and a covering refusal take precedence over a grant,\\nexplicit delegation, convenience, and recoverability. Specific human approval\\ncannot override a mandatory class. Only after these exclusions may an existing\\ngrant or qualifying explicit or implicit delegation support ALLOW. Otherwise\\nDENY. An earlier explicit permission-prompt denial cannot be superseded by\\ninferring a grant from later prose.\\n\\nReply with exactly one line: ALLOW: <reason> or DENY: <reason>.\\nKeep the reason to at most 12 words.\\n\"}]","requestSettings":{"enabledFeatureFlags":["CATALOG_SEARCH","AGENT_FINDER_SKILL_INSTALL","copilot-feature-agentic-memory","copilot_feature_agentic_memory_user_scoped","QUEUED_COMMANDS","HYDRAFUSION","HYDRAFUSION_ROLLOUT","HYDRAFUSION_PLAN_V2","AUTO_APPROVAL","CONTENT_EXCLUSION","VIM_MODE","CLOUD_SESSION_STORE","COPILOT_GITHUB_TABS","COPILOT_GITHUB_THEME","COLLECT_DEBUG_LOGS","TOOL_SEARCH_ANTHROPIC","TOOL_SEARCH_OPENAI","BACKGROUND_SESSIONS","SANDBOX","VOICE","RUBBER_DUCK_AGENT","MCP_REGISTRY_INSTALL","SESSION_INDEXING","CLI_WORKTREE","REMOTE_JSON_RPC","PROMPT_FRAME","INLINE_IMAGES","DETACH_LONG_LIVED_SERVICES","WORKTREE","SESSIONS_SIDEBAR_TAB","MANAGED_REMOTE_CONTROL_SETTING","FAILBOT_ERROR_REPORTING","TIMELINE_TOUCHUP","BLACKBIRD_AUTO_INDEX","TGREP"]},"quotaSnapshots":{"chat":{"isUnlimitedEntitlement":true,"entitlementRequests":-1,"usedRequests":0,"usageAllowedWithExhaustedQuota":false,"overage":0,"overageAllowedWithExhaustedQuota":false,"remainingPercentage":100,"resetDate":"2026-11-01T00:00:00Z"},"completions":{"isUnlimitedEntitlement":true,"entitlementRequests":-1,"usedRequests":0,"usageAllowedWithExhaustedQuota":false,"overage":0,"overageAllowedWithExhaustedQuota":false,"remainingPercentage":100,"resetDate":"2026-11-01T00:00:00Z"},"premium_interactions":{"isUnlimitedEntitlement":true,"entitlementRequests":-1,"usedRequests":0,"usageAllowedWithExhaustedQuota":true,"overage":0,"overageAllowedWithExhaustedQuota":true,"remainingPercentage":100,"resetDate":"2026-11-01T00:00:00Z"}},"requestId":"