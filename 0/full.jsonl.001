{"type":"permission.requested","data":{"requestId":"9074defa-9676-4153-9a37-e7ee67896560","permissionRequest":{"kind":"write","toolCallId":"custom_call_vwFQwv2RaBOfkTL8HzNp5qrH","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css\n@@ -25,7 +25,34 @@\n  * @related radio-input-group — Collects radios into one single-select fieldset.\n  * @example -automatica11y\n  * ```html\n- * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n+ * <fieldset>\n+ *   <legend>Standard radio sizes and states</legend>\n+ *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"medium\" checked>Medium selected</label></p>\n+ *   <p><label class=\"pfx-radio -size-sm\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"small\">Small unselected</label></p>\n+ *   <p><label class=\"pfx-radio -size-lg\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"large\">Large unselected</label></p>\n+ *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"disabled\" disabled>Disabled unselected</label></p>\n+ * </fieldset>\n+ * <fieldset>\n+ *   <legend>Locked radio selection (disabled because native radios have no readonly state)</legend>\n+ *   <p><label class=\"pfx-radio -readonly\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"locked\" checked disabled>Read-only selected</label></p>\n+ *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"other\" disabled>Disabled unselected</label></p>\n+ * </fieldset>\n+ * <fieldset>\n+ *   <legend>Disabled selected radio</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-disabled\" checked disabled>Disabled selected</label>\n+ * </fieldset>\n+ * <fieldset>\n+ *   <legend>Default toggle sizes and states</legend>\n+ *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"medium\" checked>Medium selected</label></p>\n+ *   <p><label class=\"pfx-radio -variant-toggle -size-sm\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"small\">Small unselected</label></p>\n+ *   <p><label class=\"pfx-radio -variant-toggle -size-lg\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"large\">Large unselected</label></p>\n+ *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"disabled\" disabled>Disabled unselected</label></p>\n+ * </fieldset>\n+ * <fieldset><legend>Neutral toggle</legend><label class=\"pfx-radio -variant-toggle -context-off\"><input type=\"radio\" name=\"audit-radio-off\" checked>Neutral selected</label></fieldset>\n+ * <fieldset><legend>Success toggle</legend><label class=\"pfx-radio -variant-toggle -context-success\"><input type=\"radio\" name=\"audit-radio-success\" checked>Success selected</label></fieldset>\n+ * <fieldset><legend>Warning toggle</legend><label class=\"pfx-radio -variant-toggle -context-warning\"><input type=\"radio\" name=\"audit-radio-warning\" checked>Warning selected</label></fieldset>\n+ * <fieldset><legend>Danger toggle</legend><label class=\"pfx-radio -variant-toggle -context-danger\"><input type=\"radio\" name=\"audit-radio-danger\" checked>Danger selected</label></fieldset>\n+ * <fieldset><legend>Disabled toggle selection</legend><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle-disabled\" checked disabled>Disabled selected</label></fieldset>\n  * ```\n  */\n @scope (.pfx-radio) {\n","newFileContents":"/**\n * @component radio\n * @selector .pfx-radio\n * @summary A native radio button and its label.\n * @remarks Sets its own `gap` between the control and its label; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -context-off — Off/neutral context colour (toggle variant).\n * @modifier -context-success — Success context colour (toggle variant).\n * @modifier -context-warning — Warning context colour (toggle variant).\n * @modifier -context-danger — Danger context colour (toggle variant).\n * @modifier -readonly — Read-only state.\n * @modifier -variant-toggle — Render as a segmented toggle button.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -toggle — @alias {@link -variant-toggle}\n * @pseudo ::before — The filled inner dot shown when checked; on `-variant-toggle` it is the focus ring drawn just outside the pill.\n * @cssproperty --pantoken-rt-fill <color> — The toggle's selected fill colour; the -context-* modifiers set it.\n * @cssstate checked\n * @cssstate disabled\n * @accessibility A native `<input type=\"radio\">` drives `:checked` and `:disabled`; `-readonly` is styling only, since radios have no native readonly attribute.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n * ```\n * @related checkbox — The multi-select counterpart to a single-select radio.\n * @related radio-input-group — Collects radios into one single-select fieldset.\n * @example -automatica11y\n * ```html\n * <fieldset>\n *   <legend>Standard radio sizes and states</legend>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"medium\" checked>Medium selected</label></p>\n *   <p><label class=\"pfx-radio -size-sm\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"small\">Small unselected</label></p>\n *   <p><label class=\"pfx-radio -size-lg\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"large\">Large unselected</label></p>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"disabled\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset>\n *   <legend>Locked radio selection (disabled because native radios have no readonly state)</legend>\n *   <p><label class=\"pfx-radio -readonly\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"locked\" checked disabled>Read-only selected</label></p>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"other\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset>\n *   <legend>Disabled selected radio</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-disabled\" checked disabled>Disabled selected</label>\n * </fieldset>\n * <fieldset>\n *   <legend>Default toggle sizes and states</legend>\n *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"medium\" checked>Medium selected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle -size-sm\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"small\">Small unselected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle -size-lg\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"large\">Large unselected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"disabled\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset><legend>Neutral toggle</legend><label class=\"pfx-radio -variant-toggle -context-off\"><input type=\"radio\" name=\"audit-radio-off\" checked>Neutral selected</label></fieldset>\n * <fieldset><legend>Success toggle</legend><label class=\"pfx-radio -variant-toggle -context-success\"><input type=\"radio\" name=\"audit-radio-success\" checked>Success selected</label></fieldset>\n * <fieldset><legend>Warning toggle</legend><label class=\"pfx-radio -variant-toggle -context-warning\"><input type=\"radio\" name=\"audit-radio-warning\" checked>Warning selected</label></fieldset>\n * <fieldset><legend>Danger toggle</legend><label class=\"pfx-radio -variant-toggle -context-danger\"><input type=\"radio\" name=\"audit-radio-danger\" checked>Danger selected</label></fieldset>\n * <fieldset><legend>Disabled toggle selection</legend><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle-disabled\" checked disabled>Disabled selected</label></fieldset>\n * ```\n */\n@scope (.pfx-radio) {\n  & {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--instui-component-radio-input-gap);\n    color: var(--instui-component-radio-input-label-base-color);\n    font-family: var(--instui-component-radio-input-font-family);\n    font-size: var(--instui-component-radio-input-font-size-md);\n    font-weight: var(--instui-component-radio-input-font-weight);\n    line-height: var(--instui-component-radio-input-line-height-md);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"] {\n    appearance: none;\n    -webkit-appearance: none;\n    display: inline-grid;\n    place-content: center;\n    flex: none;\n    width: var(--instui-component-radio-input-control-size-md);\n    height: var(--instui-component-radio-input-control-size-md);\n    margin-block: var(--instui-component-radio-input-control-vertical-margin);\n    border: var(--instui-component-radio-input-border-width) solid\n      var(--instui-component-radio-input-border-color);\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-background-color);\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        border-color 0.15s ease,\n        background-color 0.15s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]::before {\n    content: \"\";\n    width: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-border-selected-color);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: currentColor;\n    }\n    transform: scale(0);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: transform 0.1s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:hover {\n    border-color: var(--instui-component-radio-input-border-hover-color);\n    background: var(--instui-component-radio-input-background-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked {\n    border-color: var(--instui-component-radio-input-border-selected-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked::before {\n    transform: scale(1);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:disabled {\n    border-color: var(--instui-component-radio-input-border-disabled-color);\n    background: var(--instui-component-radio-input-background-disabled-color);\n    cursor: not-allowed;\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):has(input:disabled) {\n    color: var(--instui-component-radio-input-label-disabled-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):hover {\n    color: var(--instui-component-radio-input-label-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm {\n    font-size: var(--instui-component-radio-input-font-size-sm);\n    line-height: var(--instui-component-radio-input-line-height-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-sm);\n    height: var(--instui-component-radio-input-control-size-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg {\n    font-size: var(--instui-component-radio-input-font-size-lg);\n    line-height: var(--instui-component-radio-input-line-height-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-lg);\n    height: var(--instui-component-radio-input-control-size-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly {\n    color: var(--instui-component-radio-input-label-readonly-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly input[type=\"radio\"] {\n    border-color: var(--instui-component-radio-input-border-readonly-color);\n    background: var(--instui-component-radio-input-background-readonly-color);\n  }\n\n  /* variant=toggle — a segmented control (InstUI RadioInput toggle facade). Each segment is plain\n     uppercase label text; the facade is hidden until checked, so unselected segments have NO border and\n     NO background. Only the SELECTED segment shows a pill: the context fill, the resting (depth1) shadow,\n     rounded corners, and white text. The fill is indirected through --pantoken-rt-fill so -context-* is a\n     one-line override (default success/green). */\n  &.-variant-toggle {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n    position: relative;\n    justify-content: center;\n    gap: 0;\n    height: var(--instui-component-radio-input-toggle-medium-height);\n    padding-inline: 0.875rem;\n    border-radius: var(--instui-component-radio-input-toggle-border-radius);\n    background: transparent;\n    color: var(--instui-component-radio-input-label-base-color);\n    font-size: var(--instui-component-radio-input-toggle-medium-font-size);\n    line-height: 1;\n    text-transform: uppercase;\n    white-space: nowrap;\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        background-color 0.15s ease,\n        color 0.15s ease;\n    }\n  }\n\n  /* Clip the native control (still focusable + in the a11y tree); the label is the button. */\n  &.-variant-toggle input[type=\"radio\"] {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    margin: -1px;\n    padding: 0;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  &.-variant-toggle.-context-off {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-off);\n  }\n\n  &.-variant-toggle.-context-success {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n  }\n\n  &.-variant-toggle.-context-danger {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-danger);\n  }\n\n  &.-variant-toggle.-context-warning {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-warning);\n  }\n\n  /* Selected: the pill appears — the context fill, white label, and the resting elevation shadow. */\n  &.-variant-toggle:has(input:checked) {\n    background: var(--pantoken-rt-fill);\n    color: var(--instui-component-radio-input-toggle-handle-text);\n    box-shadow: var(--instui-elevation-depth1);\n    @media (forced-colors: active) {\n      outline: 2px solid Highlight;\n    }\n  }\n\n  /* Focus: underline the label and draw a ring offset just outside the pill (the InstUI focus facade). */\n  &.-variant-toggle:has(input:focus-visible) {\n    text-decoration: underline;\n  }\n\n  &.-variant-toggle:has(input:focus-visible)::before {\n    content: \"\";\n    position: absolute;\n    inset: -0.25rem;\n    border: var(--instui-focus-outline-width) var(--instui-focus-outline-style)\n      var(--instui-focus-outline-color);\n    border-radius: calc(var(--instui-component-radio-input-toggle-border-radius) + 0.0625rem);\n    pointer-events: none;\n  }\n\n  &.-variant-toggle:has(input:disabled) {\n    opacity: 0.5;\n    cursor: not-allowed;\n\n    @media (prefers-reduced-transparency: reduce) {\n      opacity: 1;\n      color: var(--instui-component-radio-input-label-disabled-color);\n    }\n  }\n\n  &.-variant-toggle.-size-sm {\n    height: var(--instui-component-radio-input-toggle-small-height);\n    font-size: var(--instui-component-radio-input-toggle-small-font-size);\n    padding-inline: 0.5rem;\n  }\n\n  &.-variant-toggle.-size-lg {\n    height: var(--instui-component-radio-input-toggle-large-height);\n    font-size: var(--instui-component-radio-input-toggle-large-font-size);\n    padding-inline: 1rem;\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css","content":"/**\n * @component radio\n * @selector .pfx-radio\n * @summary A native radio button and its label.\n * @remarks Sets its own `gap` between the control and its label; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -context-off — Off/neutral context colour (toggle variant).\n * @modifier -context-success — Success context colour (toggle variant).\n * @modifier -context-warning — Warning context colour (toggle variant).\n * @modifier -context-danger — Danger context colour (toggle variant).\n * @modifier -readonly — Read-only state.\n * @modifier -variant-toggle — Render as a segmented toggle button.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -toggle — @alias {@link -variant-toggle}\n * @pseudo ::before — The filled inner dot shown when checked; on `-variant-toggle` it is the focus ring drawn just outside the pill.\n * @cssproperty --pantoken-rt-fill <color> — The toggle's selected fill colour; the -context-* modifiers set it.\n * @cssstate checked\n * @cssstate disabled\n * @accessibility A native `<input type=\"radio\">` drives `:checked` and `:disabled`; `-readonly` is styling only, since radios have no native readonly attribute.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n * ```\n * @related checkbox — The multi-select counterpart to a single-select radio.\n * @related radio-input-group — Collects radios into one single-select fieldset.\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n * ```\n */\n@scope (.pfx-radio) {\n  & {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--instui-component-radio-input-gap);\n    color: var(--instui-component-radio-input-label-base-color);\n    font-family: var(--instui-component-radio-input-font-family);\n    font-size: var(--instui-component-radio-input-font-size-md);\n    font-weight: var(--instui-component-radio-input-font-weight);\n    line-height: var(--instui-component-radio-input-line-height-md);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"] {\n    appearance: none;\n    -webkit-appearance: none;\n    display: inline-grid;\n    place-content: center;\n    flex: none;\n    width: var(--instui-component-radio-input-control-size-md);\n    height: var(--instui-component-radio-input-control-size-md);\n    margin-block: var(--instui-component-radio-input-control-vertical-margin);\n    border: var(--instui-component-radio-input-border-width) solid\n      var(--instui-component-radio-input-border-color);\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-background-color);\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        border-color 0.15s ease,\n        background-color 0.15s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]::before {\n    content: \"\";\n    width: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-border-selected-color);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: currentColor;\n    }\n    transform: scale(0);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: transform 0.1s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:hover {\n    border-color: var(--instui-component-radio-input-border-hover-color);\n    background: var(--instui-component-radio-input-background-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked {\n    border-color: var(--instui-component-radio-input-border-selected-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked::before {\n    transform: scale(1);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:disabled {\n    border-color: var(--instui-component-radio-input-border-disabled-color);\n    background: var(--instui-component-radio-input-background-disabled-color);\n    cursor: not-allowed;\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):has(input:disabled) {\n    color: var(--instui-component-radio-input-label-disabled-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):hover {\n    color: var(--instui-component-radio-input-label-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm {\n    font-size: var(--instui-component-radio-input-font-size-sm);\n    line-height: var(--instui-component-radio-input-line-height-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-sm);\n    height: var(--instui-component-radio-input-control-size-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg {\n    font-size: var(--instui-component-radio-input-font-size-lg);\n    line-height: var(--instui-component-radio-input-line-height-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-lg);\n    height: var(--instui-component-radio-input-control-size-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly {\n    color: var(--instui-component-radio-input-label-readonly-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly input[type=\"radio\"] {\n    border-color: var(--instui-component-radio-input-border-readonly-color);\n    background: var(--instui-component-radio-input-background-readonly-color);\n  }\n\n  /* variant=toggle — a segmented control (InstUI RadioInput toggle facade). Each segment is plain\n     uppercase label text; the facade is hidden until checked, so unselected segments have NO border and\n     NO background. Only the SELECTED segment shows a pill: the context fill, the resting (depth1) shadow,\n     rounded corners, and white text. The fill is indirected through --pantoken-rt-fill so -context-* is a\n     one-line override (default success/green). */\n  &.-variant-toggle {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n    position: relative;\n    justify-content: center;\n    gap: 0;\n    height: var(--instui-component-radio-input-toggle-medium-height);\n    padding-inline: 0.875rem;\n    border-radius: var(--instui-component-radio-input-toggle-border-radius);\n    background: transparent;\n    color: var(--instui-component-radio-input-label-base-color);\n    font-size: var(--instui-component-radio-input-toggle-medium-font-size);\n    line-height: 1;\n    text-transform: uppercase;\n    white-space: nowrap;\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        background-color 0.15s ease,\n        color 0.15s ease;\n    }\n  }\n\n  /* Clip the native control (still focusable + in the a11y tree); the label is the button. */\n  &.-variant-toggle input[type=\"radio\"] {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    margin: -1px;\n    padding: 0;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  &.-variant-toggle.-context-off {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-off);\n  }\n\n  &.-variant-toggle.-context-success {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n  }\n\n  &.-variant-toggle.-context-danger {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-danger);\n  }\n\n  &.-variant-toggle.-context-warning {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-warning);\n  }\n\n  /* Selected: the pill appears — the context fill, white label, and the resting elevation shadow. */\n  &.-variant-toggle:has(input:checked) {\n    background: var(--pantoken-rt-fill);\n    color: var(--instui-component-radio-input-toggle-handle-text);\n    box-shadow: var(--instui-elevation-depth1);\n    @media (forced-colors: active) {\n      outline: 2px solid Highlight;\n    }\n  }\n\n  /* Focus: underline the label and draw a ring offset just outside the pill (the InstUI focus facade). */\n  &.-variant-toggle:has(input:focus-visible) {\n    text-decoration: underline;\n  }\n\n  &.-variant-toggle:has(input:focus-visible)::before {\n    content: \"\";\n    position: absolute;\n    inset: -0.25rem;\n    border: var(--instui-focus-outline-width) var(--instui-focus-outline-style)\n      var(--instui-focus-outline-color);\n    border-radius: calc(var(--instui-component-radio-input-toggle-border-radius) + 0.0625rem);\n    pointer-events: none;\n  }\n\n  &.-variant-toggle:has(input:disabled) {\n    opacity: 0.5;\n    cursor: not-allowed;\n\n    @media (prefers-reduced-transparency: reduce) {\n      opacity: 1;\n      color: var(--instui-component-radio-input-label-disabled-color);\n    }\n  }\n\n  &.-variant-toggle.-size-sm {\n    height: var(--instui-component-radio-input-toggle-small-height);\n    font-size: var(--instui-component-radio-input-toggle-small-font-size);\n    padding-inline: 0.5rem;\n  }\n\n  &.-variant-toggle.-size-lg {\n    height: var(--instui-component-radio-input-toggle-large-height);\n    font-size: var(--instui-component-radio-input-toggle-large-font-size);\n    padding-inline: 1rem;\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css","content":"/**\n * @component radio\n * @selector .pfx-radio\n * @summary A native radio button and its label.\n * @remarks Sets its own `gap` between the control and its label; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -context-off — Off/neutral context colour (toggle variant).\n * @modifier -context-success — Success context colour (toggle variant).\n * @modifier -context-warning — Warning context colour (toggle variant).\n * @modifier -context-danger — Danger context colour (toggle variant).\n * @modifier -readonly — Read-only state.\n * @modifier -variant-toggle — Render as a segmented toggle button.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -toggle — @alias {@link -variant-toggle}\n * @pseudo ::before — The filled inner dot shown when checked; on `-variant-toggle` it is the focus ring drawn just outside the pill.\n * @cssproperty --pantoken-rt-fill <color> — The toggle's selected fill colour; the -context-* modifiers set it.\n * @cssstate checked\n * @cssstate disabled\n * @accessibility A native `<input type=\"radio\">` drives `:checked` and `:disabled`; `-readonly` is styling only, since radios have no native readonly attribute.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n * ```\n * @related checkbox — The multi-select counterpart to a single-select radio.\n * @related radio-input-group — Collects radios into one single-select fieldset.\n * @example -automatica11y\n * ```html\n * <fieldset>\n *   <legend>Standard radio sizes and states</legend>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"medium\" checked>Medium selected</label></p>\n *   <p><label class=\"pfx-radio -size-sm\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"small\">Small unselected</label></p>\n *   <p><label class=\"pfx-radio -size-lg\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"large\">Large unselected</label></p>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"disabled\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset>\n *   <legend>Locked radio selection (disabled because native radios have no readonly state)</legend>\n *   <p><label class=\"pfx-radio -readonly\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"locked\" checked disabled>Read-only selected</label></p>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"other\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset>\n *   <legend>Disabled selected radio</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-disabled\" checked disabled>Disabled selected</label>\n * </fieldset>\n * <fieldset>\n *   <legend>Default toggle sizes and states</legend>\n *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"medium\" checked>Medium selected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle -size-sm\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"small\">Small unselected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle -size-lg\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"large\">Large unselected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"disabled\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset><legend>Neutral toggle</legend><label class=\"pfx-radio -variant-toggle -context-off\"><input type=\"radio\" name=\"audit-radio-off\" checked>Neutral selected</label></fieldset>\n * <fieldset><legend>Success toggle</legend><label class=\"pfx-radio -variant-toggle -context-success\"><input type=\"radio\" name=\"audit-radio-success\" checked>Success selected</label></fieldset>\n * <fieldset><legend>Warning toggle</legend><label class=\"pfx-radio -variant-toggle -context-warning\"><input type=\"radio\" name=\"audit-radio-warning\" checked>Warning selected</label></fieldset>\n * <fieldset><legend>Danger toggle</legend><label class=\"pfx-radio -variant-toggle -context-danger\"><input type=\"radio\" name=\"audit-radio-danger\" checked>Danger selected</label></fieldset>\n * <fieldset><legend>Disabled toggle selection</legend><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle-disabled\" checked disabled>Disabled selected</label></fieldset>\n * ```\n */\n@scope (.pfx-radio) {\n  & {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--instui-component-radio-input-gap);\n    color: var(--instui-component-radio-input-label-base-color);\n    font-family: var(--instui-component-radio-input-font-family);\n    font-size: var(--instui-component-radio-input-font-size-md);\n    font-weight: var(--instui-component-radio-input-font-weight);\n    line-height: var(--instui-component-radio-input-line-height-md);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"] {\n    appearance: none;\n    -webkit-appearance: none;\n    display: inline-grid;\n    place-content: center;\n    flex: none;\n    width: var(--instui-component-radio-input-control-size-md);\n    height: var(--instui-component-radio-input-control-size-md);\n    margin-block: var(--instui-component-radio-input-control-vertical-margin);\n    border: var(--instui-component-radio-input-border-width) solid\n      var(--instui-component-radio-input-border-color);\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-background-color);\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        border-color 0.15s ease,\n        background-color 0.15s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]::before {\n    content: \"\";\n    width: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-border-selected-color);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: currentColor;\n    }\n    transform: scale(0);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: transform 0.1s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:hover {\n    border-color: var(--instui-component-radio-input-border-hover-color);\n    background: var(--instui-component-radio-input-background-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked {\n    border-color: var(--instui-component-radio-input-border-selected-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked::before {\n    transform: scale(1);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:disabled {\n    border-color: var(--instui-component-radio-input-border-disabled-color);\n    background: var(--instui-component-radio-input-background-disabled-color);\n    cursor: not-allowed;\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):has(input:disabled) {\n    color: var(--instui-component-radio-input-label-disabled-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):hover {\n    color: var(--instui-component-radio-input-label-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm {\n    font-size: var(--instui-component-radio-input-font-size-sm);\n    line-height: var(--instui-component-radio-input-line-height-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-sm);\n    height: var(--instui-component-radio-input-control-size-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg {\n    font-size: var(--instui-component-radio-input-font-size-lg);\n    line-height: var(--instui-component-radio-input-line-height-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-lg);\n    height: var(--instui-component-radio-input-control-size-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly {\n    color: var(--instui-component-radio-input-label-readonly-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly input[type=\"radio\"] {\n    border-color: var(--instui-component-radio-input-border-readonly-color);\n    background: var(--instui-component-radio-input-background-readonly-color);\n  }\n\n  /* variant=toggle — a segmented control (InstUI RadioInput toggle facade). Each segment is plain\n     uppercase label text; the facade is hidden until checked, so unselected segments have NO border and\n     NO background. Only the SELECTED segment shows a pill: the context fill, the resting (depth1) shadow,\n     rounded corners, and white text. The fill is indirected through --pantoken-rt-fill so -context-* is a\n     one-line override (default success/green). */\n  &.-variant-toggle {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n    position: relative;\n    justify-content: center;\n    gap: 0;\n    height: var(--instui-component-radio-input-toggle-medium-height);\n    padding-inline: 0.875rem;\n    border-radius: var(--instui-component-radio-input-toggle-border-radius);\n    background: transparent;\n    color: var(--instui-component-radio-input-label-base-color);\n    font-size: var(--instui-component-radio-input-toggle-medium-font-size);\n    line-height: 1;\n    text-transform: uppercase;\n    white-space: nowrap;\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        background-color 0.15s ease,\n        color 0.15s ease;\n    }\n  }\n\n  /* Clip the native control (still focusable + in the a11y tree); the label is the button. */\n  &.-variant-toggle input[type=\"radio\"] {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    margin: -1px;\n    padding: 0;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  &.-variant-toggle.-context-off {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-off);\n  }\n\n  &.-variant-toggle.-context-success {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n  }\n\n  &.-variant-toggle.-context-danger {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-danger);\n  }\n\n  &.-variant-toggle.-context-warning {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-warning);\n  }\n\n  /* Selected: the pill appears — the context fill, white label, and the resting elevation shadow. */\n  &.-variant-toggle:has(input:checked) {\n    background: var(--pantoken-rt-fill);\n    color: var(--instui-component-radio-input-toggle-handle-text);\n    box-shadow: var(--instui-elevation-depth1);\n    @media (forced-colors: active) {\n      outline: 2px solid Highlight;\n    }\n  }\n\n  /* Focus: underline the label and draw a ring offset just outside the pill (the InstUI focus facade). */\n  &.-variant-toggle:has(input:focus-visible) {\n    text-decoration: underline;\n  }\n\n  &.-variant-toggle:has(input:focus-visible)::before {\n    content: \"\";\n    position: absolute;\n    inset: -0.25rem;\n    border: var(--instui-focus-outline-width) var(--instui-focus-outline-style)\n      var(--instui-focus-outline-color);\n    border-radius: calc(var(--instui-component-radio-input-toggle-border-radius) + 0.0625rem);\n    pointer-events: none;\n  }\n\n  &.-variant-toggle:has(input:disabled) {\n    opacity: 0.5;\n    cursor: not-allowed;\n\n    @media (prefers-reduced-transparency: reduce) {\n      opacity: 1;\n      color: var(--instui-component-radio-input-label-disabled-color);\n    }\n  }\n\n  &.-variant-toggle.-size-sm {\n    height: var(--instui-component-radio-input-toggle-small-height);\n    font-size: var(--instui-component-radio-input-toggle-small-font-size);\n    padding-inline: 0.5rem;\n  }\n\n  &.-variant-toggle.-size-lg {\n    height: var(--instui-component-radio-input-toggle-large-height);\n    font-size: var(--instui-component-radio-input-toggle-large-font-size);\n    padding-inline: 1rem;\n  }\n}\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_vwFQwv2RaBOfkTL8HzNp5qrH","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css\n@@ -25,7 +25,34 @@\n  * @related radio-input-group — Collects radios into one single-select fieldset.\n  * @example -automatica11y\n  * ```html\n- * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n+ * <fieldset>\n+ *   <legend>Standard radio sizes and states</legend>\n+ *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"medium\" checked>Medium selected</label></p>\n+ *   <p><label class=\"pfx-radio -size-sm\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"small\">Small unselected</label></p>\n+ *   <p><label class=\"pfx-radio -size-lg\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"large\">Large unselected</label></p>\n+ *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"disabled\" disabled>Disabled unselected</label></p>\n+ * </fieldset>\n+ * <fieldset>\n+ *   <legend>Locked radio selection (disabled because native radios have no readonly state)</legend>\n+ *   <p><label class=\"pfx-radio -readonly\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"locked\" checked disabled>Read-only selected</label></p>\n+ *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"other\" disabled>Disabled unselected</label></p>\n+ * </fieldset>\n+ * <fieldset>\n+ *   <legend>Disabled selected radio</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-disabled\" checked disabled>Disabled selected</label>\n+ * </fieldset>\n+ * <fieldset>\n+ *   <legend>Default toggle sizes and states</legend>\n+ *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"medium\" checked>Medium selected</label></p>\n+ *   <p><label class=\"pfx-radio -variant-toggle -size-sm\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"small\">Small unselected</label></p>\n+ *   <p><label class=\"pfx-radio -variant-toggle -size-lg\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"large\">Large unselected</label></p>\n+ *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"disabled\" disabled>Disabled unselected</label></p>\n+ * </fieldset>\n+ * <fieldset><legend>Neutral toggle</legend><label class=\"pfx-radio -variant-toggle -context-off\"><input type=\"radio\" name=\"audit-radio-off\" checked>Neutral selected</label></fieldset>\n+ * <fieldset><legend>Success toggle</legend><label class=\"pfx-radio -variant-toggle -context-success\"><input type=\"radio\" name=\"audit-radio-success\" checked>Success selected</label></fieldset>\n+ * <fieldset><legend>Warning toggle</legend><label class=\"pfx-radio -variant-toggle -context-warning\"><input type=\"radio\" name=\"audit-radio-warning\" checked>Warning selected</label></fieldset>\n+ * <fieldset><legend>Danger toggle</legend><label class=\"pfx-radio -variant-toggle -context-danger\"><input type=\"radio\" name=\"audit-radio-danger\" checked>Danger selected</label></fieldset>\n+ * <fieldset><legend>Disabled toggle selection</legend><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle-disabled\" checked disabled>Disabled selected</label></fieldset>\n  * ```\n  */\n @scope (.pfx-radio) {\n","newFileContents":"/**\n * @component radio\n * @selector .pfx-radio\n * @summary A native radio button and its label.\n * @remarks Sets its own `gap` between the control and its label; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -context-off — Off/neutral context colour (toggle variant).\n * @modifier -context-success — Success context colour (toggle variant).\n * @modifier -context-warning — Warning context colour (toggle variant).\n * @modifier -context-danger — Danger context colour (toggle variant).\n * @modifier -readonly — Read-only state.\n * @modifier -variant-toggle — Render as a segmented toggle button.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -toggle — @alias {@link -variant-toggle}\n * @pseudo ::before — The filled inner dot shown when checked; on `-variant-toggle` it is the focus ring drawn just outside the pill.\n * @cssproperty --pantoken-rt-fill <color> — The toggle's selected fill colour; the -context-* modifiers set it.\n * @cssstate checked\n * @cssstate disabled\n * @accessibility A native `<input type=\"radio\">` drives `:checked` and `:disabled`; `-readonly` is styling only, since radios have no native readonly attribute.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n * ```\n * @related checkbox — The multi-select counterpart to a single-select radio.\n * @related radio-input-group — Collects radios into one single-select fieldset.\n * @example -automatica11y\n * ```html\n * <fieldset>\n *   <legend>Standard radio sizes and states</legend>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"medium\" checked>Medium selected</label></p>\n *   <p><label class=\"pfx-radio -size-sm\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"small\">Small unselected</label></p>\n *   <p><label class=\"pfx-radio -size-lg\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"large\">Large unselected</label></p>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"disabled\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset>\n *   <legend>Locked radio selection (disabled because native radios have no readonly state)</legend>\n *   <p><label class=\"pfx-radio -readonly\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"locked\" checked disabled>Read-only selected</label></p>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"other\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset>\n *   <legend>Disabled selected radio</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-disabled\" checked disabled>Disabled selected</label>\n * </fieldset>\n * <fieldset>\n *   <legend>Default toggle sizes and states</legend>\n *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"medium\" checked>Medium selected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle -size-sm\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"small\">Small unselected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle -size-lg\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"large\">Large unselected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"disabled\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset><legend>Neutral toggle</legend><label class=\"pfx-radio -variant-toggle -context-off\"><input type=\"radio\" name=\"audit-radio-off\" checked>Neutral selected</label></fieldset>\n * <fieldset><legend>Success toggle</legend><label class=\"pfx-radio -variant-toggle -context-success\"><input type=\"radio\" name=\"audit-radio-success\" checked>Success selected</label></fieldset>\n * <fieldset><legend>Warning toggle</legend><label class=\"pfx-radio -variant-toggle -context-warning\"><input type=\"radio\" name=\"audit-radio-warning\" checked>Warning selected</label></fieldset>\n * <fieldset><legend>Danger toggle</legend><label class=\"pfx-radio -variant-toggle -context-danger\"><input type=\"radio\" name=\"audit-radio-danger\" checked>Danger selected</label></fieldset>\n * <fieldset><legend>Disabled toggle selection</legend><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle-disabled\" checked disabled>Disabled selected</label></fieldset>\n * ```\n */\n@scope (.pfx-radio) {\n  & {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--instui-component-radio-input-gap);\n    color: var(--instui-component-radio-input-label-base-color);\n    font-family: var(--instui-component-radio-input-font-family);\n    font-size: var(--instui-component-radio-input-font-size-md);\n    font-weight: var(--instui-component-radio-input-font-weight);\n    line-height: var(--instui-component-radio-input-line-height-md);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"] {\n    appearance: none;\n    -webkit-appearance: none;\n    display: inline-grid;\n    place-content: center;\n    flex: none;\n    width: var(--instui-component-radio-input-control-size-md);\n    height: var(--instui-component-radio-input-control-size-md);\n    margin-block: var(--instui-component-radio-input-control-vertical-margin);\n    border: var(--instui-component-radio-input-border-width) solid\n      var(--instui-component-radio-input-border-color);\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-background-color);\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        border-color 0.15s ease,\n        background-color 0.15s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]::before {\n    content: \"\";\n    width: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-border-selected-color);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: currentColor;\n    }\n    transform: scale(0);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: transform 0.1s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:hover {\n    border-color: var(--instui-component-radio-input-border-hover-color);\n    background: var(--instui-component-radio-input-background-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked {\n    border-color: var(--instui-component-radio-input-border-selected-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked::before {\n    transform: scale(1);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:disabled {\n    border-color: var(--instui-component-radio-input-border-disabled-color);\n    background: var(--instui-component-radio-input-background-disabled-color);\n    cursor: not-allowed;\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):has(input:disabled) {\n    color: var(--instui-component-radio-input-label-disabled-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):hover {\n    color: var(--instui-component-radio-input-label-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm {\n    font-size: var(--instui-component-radio-input-font-size-sm);\n    line-height: var(--instui-component-radio-input-line-height-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-sm);\n    height: var(--instui-component-radio-input-control-size-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg {\n    font-size: var(--instui-component-radio-input-font-size-lg);\n    line-height: var(--instui-component-radio-input-line-height-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-lg);\n    height: var(--instui-component-radio-input-control-size-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly {\n    color: var(--instui-component-radio-input-label-readonly-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly input[type=\"radio\"] {\n    border-color: var(--instui-component-radio-input-border-readonly-color);\n    background: var(--instui-component-radio-input-background-readonly-color);\n  }\n\n  /* variant=toggle — a segmented control (InstUI RadioInput toggle facade). Each segment is plain\n     uppercase label text; the facade is hidden until checked, so unselected segments have NO border and\n     NO background. Only the SELECTED segment shows a pill: the context fill, the resting (depth1) shadow,\n     rounded corners, and white text. The fill is indirected through --pantoken-rt-fill so -context-* is a\n     one-line override (default success/green). */\n  &.-variant-toggle {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n    position: relative;\n    justify-content: center;\n    gap: 0;\n    height: var(--instui-component-radio-input-toggle-medium-height);\n    padding-inline: 0.875rem;\n    border-radius: var(--instui-component-radio-input-toggle-border-radius);\n    background: transparent;\n    color: var(--instui-component-radio-input-label-base-color);\n    font-size: var(--instui-component-radio-input-toggle-medium-font-size);\n    line-height: 1;\n    text-transform: uppercase;\n    white-space: nowrap;\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        background-color 0.15s ease,\n        color 0.15s ease;\n    }\n  }\n\n  /* Clip the native control (still focusable + in the a11y tree); the label is the button. */\n  &.-variant-toggle input[type=\"radio\"] {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    margin: -1px;\n    padding: 0;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  &.-variant-toggle.-context-off {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-off);\n  }\n\n  &.-variant-toggle.-context-success {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n  }\n\n  &.-variant-toggle.-context-danger {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-danger);\n  }\n\n  &.-variant-toggle.-context-warning {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-warning);\n  }\n\n  /* Selected: the pill appears — the context fill, white label, and the resting elevation shadow. */\n  &.-variant-toggle:has(input:checked) {\n    background: var(--pantoken-rt-fill);\n    color: var(--instui-component-radio-input-toggle-handle-text);\n    box-shadow: var(--instui-elevation-depth1);\n    @media (forced-colors: active) {\n      outline: 2px solid Highlight;\n    }\n  }\n\n  /* Focus: underline the label and draw a ring offset just outside the pill (the InstUI focus facade). */\n  &.-variant-toggle:has(input:focus-visible) {\n    text-decoration: underline;\n  }\n\n  &.-variant-toggle:has(input:focus-visible)::before {\n    content: \"\";\n    position: absolute;\n    inset: -0.25rem;\n    border: var(--instui-focus-outline-width) var(--instui-focus-outline-style)\n      var(--instui-focus-outline-color);\n    border-radius: calc(var(--instui-component-radio-input-toggle-border-radius) + 0.0625rem);\n    pointer-events: none;\n  }\n\n  &.-variant-toggle:has(input:disabled) {\n    opacity: 0.5;\n    cursor: not-allowed;\n\n    @media (prefers-reduced-transparency: reduce) {\n      opacity: 1;\n      color: var(--instui-component-radio-input-label-disabled-color);\n    }\n  }\n\n  &.-variant-toggle.-size-sm {\n    height: var(--instui-component-radio-input-toggle-small-height);\n    font-size: var(--instui-component-radio-input-toggle-small-font-size);\n    padding-inline: 0.5rem;\n  }\n\n  &.-variant-toggle.-size-lg {\n    height: var(--instui-component-radio-input-toggle-large-height);\n    font-size: var(--instui-component-radio-input-toggle-large-font-size);\n    padding-inline: 1rem;\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css","content":"/**\n * @component radio\n * @selector .pfx-radio\n * @summary A native radio button and its label.\n * @remarks Sets its own `gap` between the control and its label; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -context-off — Off/neutral context colour (toggle variant).\n * @modifier -context-success — Success context colour (toggle variant).\n * @modifier -context-warning — Warning context colour (toggle variant).\n * @modifier -context-danger — Danger context colour (toggle variant).\n * @modifier -readonly — Read-only state.\n * @modifier -variant-toggle — Render as a segmented toggle button.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -toggle — @alias {@link -variant-toggle}\n * @pseudo ::before — The filled inner dot shown when checked; on `-variant-toggle` it is the focus ring drawn just outside the pill.\n * @cssproperty --pantoken-rt-fill <color> — The toggle's selected fill colour; the -context-* modifiers set it.\n * @cssstate checked\n * @cssstate disabled\n * @accessibility A native `<input type=\"radio\">` drives `:checked` and `:disabled`; `-readonly` is styling only, since radios have no native readonly attribute.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n * ```\n * @related checkbox — The multi-select counterpart to a single-select radio.\n * @related radio-input-group — Collects radios into one single-select fieldset.\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n * ```\n */\n@scope (.pfx-radio) {\n  & {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--instui-component-radio-input-gap);\n    color: var(--instui-component-radio-input-label-base-color);\n    font-family: var(--instui-component-radio-input-font-family);\n    font-size: var(--instui-component-radio-input-font-size-md);\n    font-weight: var(--instui-component-radio-input-font-weight);\n    line-height: var(--instui-component-radio-input-line-height-md);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"] {\n    appearance: none;\n    -webkit-appearance: none;\n    display: inline-grid;\n    place-content: center;\n    flex: none;\n    width: var(--instui-component-radio-input-control-size-md);\n    height: var(--instui-component-radio-input-control-size-md);\n    margin-block: var(--instui-component-radio-input-control-vertical-margin);\n    border: var(--instui-component-radio-input-border-width) solid\n      var(--instui-component-radio-input-border-color);\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-background-color);\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        border-color 0.15s ease,\n        background-color 0.15s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]::before {\n    content: \"\";\n    width: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-border-selected-color);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: currentColor;\n    }\n    transform: scale(0);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: transform 0.1s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:hover {\n    border-color: var(--instui-component-radio-input-border-hover-color);\n    background: var(--instui-component-radio-input-background-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked {\n    border-color: var(--instui-component-radio-input-border-selected-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked::before {\n    transform: scale(1);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:disabled {\n    border-color: var(--instui-component-radio-input-border-disabled-color);\n    background: var(--instui-component-radio-input-background-disabled-color);\n    cursor: not-allowed;\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):has(input:disabled) {\n    color: var(--instui-component-radio-input-label-disabled-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):hover {\n    color: var(--instui-component-radio-input-label-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm {\n    font-size: var(--instui-component-radio-input-font-size-sm);\n    line-height: var(--instui-component-radio-input-line-height-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-sm);\n    height: var(--instui-component-radio-input-control-size-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg {\n    font-size: var(--instui-component-radio-input-font-size-lg);\n    line-height: var(--instui-component-radio-input-line-height-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-lg);\n    height: var(--instui-component-radio-input-control-size-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly {\n    color: var(--instui-component-radio-input-label-readonly-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly input[type=\"radio\"] {\n    border-color: var(--instui-component-radio-input-border-readonly-color);\n    background: var(--instui-component-radio-input-background-readonly-color);\n  }\n\n  /* variant=toggle — a segmented control (InstUI RadioInput toggle facade). Each segment is plain\n     uppercase label text; the facade is hidden until checked, so unselected segments have NO border and\n     NO background. Only the SELECTED segment shows a pill: the context fill, the resting (depth1) shadow,\n     rounded corners, and white text. The fill is indirected through --pantoken-rt-fill so -context-* is a\n     one-line override (default success/green). */\n  &.-variant-toggle {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n    position: relative;\n    justify-content: center;\n    gap: 0;\n    height: var(--instui-component-radio-input-toggle-medium-height);\n    padding-inline: 0.875rem;\n    border-radius: var(--instui-component-radio-input-toggle-border-radius);\n    background: transparent;\n    color: var(--instui-component-radio-input-label-base-color);\n    font-size: var(--instui-component-radio-input-toggle-medium-font-size);\n    line-height: 1;\n    text-transform: uppercase;\n    white-space: nowrap;\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        background-color 0.15s ease,\n        color 0.15s ease;\n    }\n  }\n\n  /* Clip the native control (still focusable + in the a11y tree); the label is the button. */\n  &.-variant-toggle input[type=\"radio\"] {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    margin: -1px;\n    padding: 0;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  &.-variant-toggle.-context-off {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-off);\n  }\n\n  &.-variant-toggle.-context-success {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n  }\n\n  &.-variant-toggle.-context-danger {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-danger);\n  }\n\n  &.-variant-toggle.-context-warning {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-warning);\n  }\n\n  /* Selected: the pill appears — the context fill, white label, and the resting elevation shadow. */\n  &.-variant-toggle:has(input:checked) {\n    background: var(--pantoken-rt-fill);\n    color: var(--instui-component-radio-input-toggle-handle-text);\n    box-shadow: var(--instui-elevation-depth1);\n    @media (forced-colors: active) {\n      outline: 2px solid Highlight;\n    }\n  }\n\n  /* Focus: underline the label and draw a ring offset just outside the pill (the InstUI focus facade). */\n  &.-variant-toggle:has(input:focus-visible) {\n    text-decoration: underline;\n  }\n\n  &.-variant-toggle:has(input:focus-visible)::before {\n    content: \"\";\n    position: absolute;\n    inset: -0.25rem;\n    border: var(--instui-focus-outline-width) var(--instui-focus-outline-style)\n      var(--instui-focus-outline-color);\n    border-radius: calc(var(--instui-component-radio-input-toggle-border-radius) + 0.0625rem);\n    pointer-events: none;\n  }\n\n  &.-variant-toggle:has(input:disabled) {\n    opacity: 0.5;\n    cursor: not-allowed;\n\n    @media (prefers-reduced-transparency: reduce) {\n      opacity: 1;\n      color: var(--instui-component-radio-input-label-disabled-color);\n    }\n  }\n\n  &.-variant-toggle.-size-sm {\n    height: var(--instui-component-radio-input-toggle-small-height);\n    font-size: var(--instui-component-radio-input-toggle-small-font-size);\n    padding-inline: 0.5rem;\n  }\n\n  &.-variant-toggle.-size-lg {\n    height: var(--instui-component-radio-input-toggle-large-height);\n    font-size: var(--instui-component-radio-input-toggle-large-font-size);\n    padding-inline: 1rem;\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/radio/radio.css","content":"/**\n * @component radio\n * @selector .pfx-radio\n * @summary A native radio button and its label.\n * @remarks Sets its own `gap` between the control and its label; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\n * @modifier -context-off — Off/neutral context colour (toggle variant).\n * @modifier -context-success — Success context colour (toggle variant).\n * @modifier -context-warning — Warning context colour (toggle variant).\n * @modifier -context-danger — Danger context colour (toggle variant).\n * @modifier -readonly — Read-only state.\n * @modifier -variant-toggle — Render as a segmented toggle button.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -toggle — @alias {@link -variant-toggle}\n * @pseudo ::before — The filled inner dot shown when checked; on `-variant-toggle` it is the focus ring drawn just outside the pill.\n * @cssproperty --pantoken-rt-fill <color> — The toggle's selected fill colour; the -context-* modifiers set it.\n * @cssstate checked\n * @cssstate disabled\n * @accessibility A native `<input type=\"radio\">` drives `:checked` and `:disabled`; `-readonly` is styling only, since radios have no native readonly attribute.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-radio\"><input type=\"radio\" name=\"r\" checked> Option A</label>\n * ```\n * @related checkbox — The multi-select counterpart to a single-select radio.\n * @related radio-input-group — Collects radios into one single-select fieldset.\n * @example -automatica11y\n * ```html\n * <fieldset>\n *   <legend>Standard radio sizes and states</legend>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"medium\" checked>Medium selected</label></p>\n *   <p><label class=\"pfx-radio -size-sm\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"small\">Small unselected</label></p>\n *   <p><label class=\"pfx-radio -size-lg\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"large\">Large unselected</label></p>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-standard\" value=\"disabled\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset>\n *   <legend>Locked radio selection (disabled because native radios have no readonly state)</legend>\n *   <p><label class=\"pfx-radio -readonly\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"locked\" checked disabled>Read-only selected</label></p>\n *   <p><label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-locked\" value=\"other\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset>\n *   <legend>Disabled selected radio</legend>\n *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-radio-disabled\" checked disabled>Disabled selected</label>\n * </fieldset>\n * <fieldset>\n *   <legend>Default toggle sizes and states</legend>\n *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"medium\" checked>Medium selected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle -size-sm\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"small\">Small unselected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle -size-lg\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"large\">Large unselected</label></p>\n *   <p><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle\" value=\"disabled\" disabled>Disabled unselected</label></p>\n * </fieldset>\n * <fieldset><legend>Neutral toggle</legend><label class=\"pfx-radio -variant-toggle -context-off\"><input type=\"radio\" name=\"audit-radio-off\" checked>Neutral selected</label></fieldset>\n * <fieldset><legend>Success toggle</legend><label class=\"pfx-radio -variant-toggle -context-success\"><input type=\"radio\" name=\"audit-radio-success\" checked>Success selected</label></fieldset>\n * <fieldset><legend>Warning toggle</legend><label class=\"pfx-radio -variant-toggle -context-warning\"><input type=\"radio\" name=\"audit-radio-warning\" checked>Warning selected</label></fieldset>\n * <fieldset><legend>Danger toggle</legend><label class=\"pfx-radio -variant-toggle -context-danger\"><input type=\"radio\" name=\"audit-radio-danger\" checked>Danger selected</label></fieldset>\n * <fieldset><legend>Disabled toggle selection</legend><label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"audit-radio-toggle-disabled\" checked disabled>Disabled selected</label></fieldset>\n * ```\n */\n@scope (.pfx-radio) {\n  & {\n    display: inline-flex;\n    align-items: center;\n    gap: var(--instui-component-radio-input-gap);\n    color: var(--instui-component-radio-input-label-base-color);\n    font-family: var(--instui-component-radio-input-font-family);\n    font-size: var(--instui-component-radio-input-font-size-md);\n    font-weight: var(--instui-component-radio-input-font-weight);\n    line-height: var(--instui-component-radio-input-line-height-md);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"] {\n    appearance: none;\n    -webkit-appearance: none;\n    display: inline-grid;\n    place-content: center;\n    flex: none;\n    width: var(--instui-component-radio-input-control-size-md);\n    height: var(--instui-component-radio-input-control-size-md);\n    margin-block: var(--instui-component-radio-input-control-vertical-margin);\n    border: var(--instui-component-radio-input-border-width) solid\n      var(--instui-component-radio-input-border-color);\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-background-color);\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        border-color 0.15s ease,\n        background-color 0.15s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]::before {\n    content: \"\";\n    width: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-md) - 2 *\n        var(--instui-component-radio-input-checked-inset-md)\n    );\n    border-radius: 50%;\n    background: var(--instui-component-radio-input-border-selected-color);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: currentColor;\n    }\n    transform: scale(0);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: transform 0.1s ease;\n    }\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:hover {\n    border-color: var(--instui-component-radio-input-border-hover-color);\n    background: var(--instui-component-radio-input-background-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked {\n    border-color: var(--instui-component-radio-input-border-selected-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:checked::before {\n    transform: scale(1);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle) input[type=\"radio\"]:disabled {\n    border-color: var(--instui-component-radio-input-border-disabled-color);\n    background: var(--instui-component-radio-input-background-disabled-color);\n    cursor: not-allowed;\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):has(input:disabled) {\n    color: var(--instui-component-radio-input-label-disabled-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle):hover {\n    color: var(--instui-component-radio-input-label-hover-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm {\n    font-size: var(--instui-component-radio-input-font-size-sm);\n    line-height: var(--instui-component-radio-input-line-height-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-sm);\n    height: var(--instui-component-radio-input-control-size-sm);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-sm input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-sm) - 2 *\n        var(--instui-component-radio-input-checked-inset-sm)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg {\n    font-size: var(--instui-component-radio-input-font-size-lg);\n    line-height: var(--instui-component-radio-input-line-height-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"] {\n    width: var(--instui-component-radio-input-control-size-lg);\n    height: var(--instui-component-radio-input-control-size-lg);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-size-lg input[type=\"radio\"]::before {\n    width: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n    height: calc(\n      var(--instui-component-radio-input-control-size-lg) - 2 *\n        var(--instui-component-radio-input-checked-inset-lg)\n    );\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly {\n    color: var(--instui-component-radio-input-label-readonly-color);\n  }\n\n  &:not(.-variant-toggle):not(.-toggle).-readonly input[type=\"radio\"] {\n    border-color: var(--instui-component-radio-input-border-readonly-color);\n    background: var(--instui-component-radio-input-background-readonly-color);\n  }\n\n  /* variant=toggle — a segmented control (InstUI RadioInput toggle facade). Each segment is plain\n     uppercase label text; the facade is hidden until checked, so unselected segments have NO border and\n     NO background. Only the SELECTED segment shows a pill: the context fill, the resting (depth1) shadow,\n     rounded corners, and white text. The fill is indirected through --pantoken-rt-fill so -context-* is a\n     one-line override (default success/green). */\n  &.-variant-toggle {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n    position: relative;\n    justify-content: center;\n    gap: 0;\n    height: var(--instui-component-radio-input-toggle-medium-height);\n    padding-inline: 0.875rem;\n    border-radius: var(--instui-component-radio-input-toggle-border-radius);\n    background: transparent;\n    color: var(--instui-component-radio-input-label-base-color);\n    font-size: var(--instui-component-radio-input-toggle-medium-font-size);\n    line-height: 1;\n    text-transform: uppercase;\n    white-space: nowrap;\n    cursor: pointer;\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        background-color 0.15s ease,\n        color 0.15s ease;\n    }\n  }\n\n  /* Clip the native control (still focusable + in the a11y tree); the label is the button. */\n  &.-variant-toggle input[type=\"radio\"] {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    margin: -1px;\n    padding: 0;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  &.-variant-toggle.-context-off {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-off);\n  }\n\n  &.-variant-toggle.-context-success {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-success);\n  }\n\n  &.-variant-toggle.-context-danger {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-danger);\n  }\n\n  &.-variant-toggle.-context-warning {\n    --pantoken-rt-fill: var(--instui-component-radio-input-toggle-background-warning);\n  }\n\n  /* Selected: the pill appears — the context fill, white label, and the resting elevation shadow. */\n  &.-variant-toggle:has(input:checked) {\n    background: var(--pantoken-rt-fill);\n    color: var(--instui-component-radio-input-toggle-handle-text);\n    box-shadow: var(--instui-elevation-depth1);\n    @media (forced-colors: active) {\n      outline: 2px solid Highlight;\n    }\n  }\n\n  /* Focus: underline the label and draw a ring offset just outside the pill (the InstUI focus facade). */\n  &.-variant-toggle:has(input:focus-visible) {\n    text-decoration: underline;\n  }\n\n  &.-variant-toggle:has(input:focus-visible)::before {\n    content: \"\";\n    position: absolute;\n    inset: -0.25rem;\n    border: var(--instui-focus-outline-width) var(--instui-focus-outline-style)\n      var(--instui-focus-outline-color);\n    border-radius: calc(var(--instui-component-radio-input-toggle-border-radius) + 0.0625rem);\n    pointer-events: none;\n  }\n\n  &.-variant-toggle:has(input:disabled) {\n    opacity: 0.5;\n    cursor: not-allowed;\n\n    @media (prefers-reduced-transparency: reduce) {\n      opacity: 1;\n      color: var(--instui-component-radio-input-label-disabled-color);\n    }\n  }\n\n  &.-variant-toggle.-size-sm {\n    height: var(--instui-component-radio-input-toggle-small-height);\n    font-size: var(--instui-component-radio-input-toggle-small-font-size);\n    padding-inline: 0.5rem;\n  }\n\n  &.-variant-toggle.-size-lg {\n    height: var(--instui-component-radio-input-toggle-large-height);\n    font-size: var(--instui-component-radio-input-toggle-large-font-size);\n    padding-inline: 1rem;\n  }\n}\n"}}],"_permissionRequestSessionId":"e0a110b6-b8dd-47be-82d5-cb60da15b229","assistedApproval":{"recommendation":"approve","reason":"Explicitly authorized fixture expansion; this adds radio audit coverage without disabling controls.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"e0a110b6-b8dd-47be-82d5-cb60da15b229"},"agentId":"049c1373-ecc6-4d66-bbea-f19e45c06453","id":"67784627-3ea9-4229-a7db-d4d0e4c76d41","timestamp":"2026-10-28T21:04:11.973Z","parentId":"08e0baeb-d59f-42e7-9ce0-83c6df12eeaf"}
