{ z-index: var(--instui-component-view-stacking-${level}); }`;\n    });\n    // prettier-ignore\n    return css`/**\n * @utility stacking\n * @selector .--stack-topmost\n * @global\n * @summary z-index depth utilities — \\`.--stack-<level>\\` (\\`deepest\\`, \\`below\\`, \\`above\\`, \\`topmost\\`) — usable bare or chained onto any component, so layers stack predictably instead of by hand-tuned numbers.\n * @modifier --stack-deepest — The lowest stacking depth.\n * @modifier --stack-below — Below the default flow.\n * @modifier --stack-above — Above the default flow.\n * @modifier --stack-topmost — The highest stacking depth (overlays, menus).\n * @a11y Stacking order is visual only: a layered surface that covers focusable content hides the focus indicator. Overlays that take over the page also need focus management and an accessible name.\n * @example -automatica11y\n * \\`\\`\\`html\n * <div class=\"--stack-above\">\n *   <p>Content raised above the default flow.</p>\n * </div>\n * \\`\\`\\`\n * @example\n * <div class=\"--stack-topmost\">Always on top.</div>\n */\n${rules.join(\"\\n\")}`;\n  },\n});\n\n/** The stacking utility as a standalone, header-wrapped stylesheet. */\nexport const stackingUtilityCss: Definition[\"css\"] = stacking.css;\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/stacking/index.ts","content":"/**\n * The stacking utility — a global, dual copy of `@pantoken/plugin-stacking`'s `.instui-stack-<level>`\n * z-index scale (reusing the same class word), usable bare or chained onto any component.\n *\n * @module\n */\nimport { css } from \"../../lib/css.ts\";\nimport { defineUtility, type Definition } from \"../../lib/define.ts\";\nimport { globalModifierSelector } from \"@pantoken/utils\";\n\n/** The stacking depths, deepest → topmost — same order and names as `@pantoken/plugin-stacking`. */\nconst STACKING_LEVELS = [\"deepest\", \"below\", \"above\", \"topmost\"] as const;\n\n/** The stacking utility — `.instui-stack-<level>` z-index classes, global and dual. */\nexport const stacking: Definition = defineUtility({\n  name: \"stacking\",\n  css: (p) => {\n    const rules = STACKING_LEVELS.map((level) => {\n      const selector = globalModifierSelector(p, `stack-${level}`);\n      return `${selector} { z-index: var(--instui-component-view-stacking-${level}); }`;\n    });\n    // prettier-ignore\n    return css`/**\n * @utility stacking\n * @selector .--stack-topmost\n * @global\n * @summary z-index depth utilities — \\`.--stack-<level>\\` (\\`deepest\\`, \\`below\\`, \\`above\\`, \\`topmost\\`) — usable bare or chained onto any component, so layers stack predictably instead of by hand-tuned numbers.\n * @modifier --stack-deepest — The lowest stacking depth.\n * @modifier --stack-below — Below the default flow.\n * @modifier --stack-above — Above the default flow.\n * @modifier --stack-topmost — The highest stacking depth (overlays, menus).\n * @example\n * <div class=\"--stack-topmost\">Always on top.</div>\n */\n${rules.join(\"\\n\")}`;\n  },\n});\n\n/** The stacking utility as a standalone, header-wrapped stylesheet. */\nexport const stackingUtilityCss: Definition[\"css\"] = stacking.css;\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/stacking/index.ts","content":"/**\n * The stacking utility — a global, dual copy of `@pantoken/plugin-stacking`'s `.instui-stack-<level>`\n * z-index scale (reusing the same class word), usable bare or chained onto any component.\n *\n * @module\n */\nimport { css } from \"../../lib/css.ts\";\nimport { defineUtility, type Definition } from \"../../lib/define.ts\";\nimport { globalModifierSelector } from \"@pantoken/utils\";\n\n/** The stacking depths, deepest → topmost — same order and names as `@pantoken/plugin-stacking`. */\nconst STACKING_LEVELS = [\"deepest\", \"below\", \"above\", \"topmost\"] as const;\n\n/** The stacking utility — `.instui-stack-<level>` z-index classes, global and dual. */\nexport const stacking: Definition = defineUtility({\n  name: \"stacking\",\n  css: (p) => {\n    const rules = STACKING_LEVELS.map((level) => {\n      const selector = globalModifierSelector(p, `stack-${level}`);\n      return `${selector} { z-index: var(--instui-component-view-stacking-${level}); }`;\n    });\n    // prettier-ignore\n    return css`/**\n * @utility stacking\n * @selector .--stack-topmost\n * @global\n * @summary z-index depth utilities — \\`.--stack-<level>\\` (\\`deepest\\`, \\`below\\`, \\`above\\`, \\`topmost\\`) — usable bare or chained onto any component, so layers stack predictably instead of by hand-tuned numbers.\n * @modifier --stack-deepest — The lowest stacking depth.\n * @modifier --stack-below — Below the default flow.\n * @modifier --stack-above — Above the default flow.\n * @modifier --stack-topmost — The highest stacking depth (overlays, menus).\n * @a11y Stacking order is visual only: a layered surface that covers focusable content hides the focus indicator. Overlays that take over the page also need focus management and an accessible name.\n * @example -automatica11y\n * \\`\\`\\`html\n * <div class=\"--stack-above\">\n *   <p>Content raised above the default flow.</p>\n * </div>\n * \\`\\`\\`\n * @example\n * <div class=\"--stack-topmost\">Always on top.</div>\n */\n${rules.join(\"\\n\")}`;\n  },\n});\n\n/** The stacking utility as a standalone, header-wrapped stylesheet. */\nexport const stackingUtilityCss: Definition[\"css\"] = stacking.css;\n"}}],"_permissionRequestSessionId":"cf8db52f-0f27-4d51-8f45-3f9af32eb056","assistedApproval":{"recommendation":"approve","reason":"Explicitly requested accessibility audit documentation edit within the project scope.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"cf8db52f-0f27-4d51-8f