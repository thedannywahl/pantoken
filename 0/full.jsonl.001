{"type":"hook.start","data":{"hookInvocationId":"ceeb3c6d-f6b5-482d-a8bb-54823a79c36d","hookType":"postToolUse","input":{"sessionId":"cf8db52f-0f27-4d51-8f45-3f9af32eb056","timestamp":1793214632390,"cwd":"/Users/dwahl/Scripts/pantoken","toolName":"edit","toolArgs":{"new_str":" * @example -automatica11y\n * ```html\n * <div class=\"instui-transition -transition-fade-entered\">Animated content</div>\n * ```\n * @example\n * <div class=\"instui-transition -transition-fade-entering\">Animated content</div>","old_str":" * @example\n * <div class=\"instui-transition -transition-fade-entering\">Animated content</div>","path":"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/transition/transition.css"},"toolResult":{"resultType":"success","textResultForLlm":"File /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/transition/transition.css updated with changes.","toolTelemetry":{"properties":{"command":"edit","options":"{\"truncateBasedOn\":\"tokenCount\",\"truncateStyle\":\"middle\"}","inputs":"[\"path\",\"old_str\",\"new_str\",\"command\"]","resolvedPathAgainstCwd":"false","fileExtension":"[\".css\"]","codeBlocks":"[{\"fileExt\":\".css\",\"languageId\":\"css\",\"linesAdded\":4,\"linesRemoved\":0}]","languageId":"[\"css\"]"},"metrics":{"resultLength":115,"resultForLlmLength":115,"linesAdded":4,"linesRemoved":0,"context_token_limit":200000.0,"context_current_tokens":139235.0,"large_output_threshold_bytes":8192.0},"restrictedProperties":{"filePaths":"[\"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/transition/transition.css\"]"}},"sessionLog":"[copilot:elided sessionLog (1091 bytes) - duplicated pre-hook tool-result field; canonical data remains in adjacent tool and skill events]"}}},"id":"1fac9fec-2975-48a9-980b-7a39af1d2dae","timestamp":"2026-10-28T19:10:32.390Z","parentId":"bba90026-430d-4b55-b99e-1cf70cf3e475"}
