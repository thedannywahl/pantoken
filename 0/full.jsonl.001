creen-reader-content.css @@ - * <span aria-hidden=\"true\">⚙</span> + * <span aria-hidden=\"true\">+</span> *** End Patch\n[tool rg -> success] args={\"pattern\":\"custom-components|readdirSync\\\\(.*assets\",\"paths\":\"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\",\"output_mode\":\"content\",\"-n\":true,\"-C\":3}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts @@ \"components/fonts.css\", + ...(item.record === \"logo\" ? [\"logos/canvas-horizontal-color.css\"] : []), @@ [\"plugins/pantoken/custom-components/dist\", \"custom-components\"], + [\"plugins/pantoken/logos/dist\", \"logos\"], *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts @@ expect(page).toContain(\"control.checkValidity()\"); + const logoPage = renderPage({ ...cases[0]!, record: \"logo\" }); + expect(logoPage).toContain('href=\"assets/logos/canvas-horizontal-color.css\"'); @@ \"plugins/pantoken/custom-components/dist\", + \"plugins/pantoken/logos/dist\", @@ \"interactions\", + \"logos\", *** End Patch\n[tool bash -> success] args={\"command\":\"vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate plugin fixtures and harness\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --help\",\"description\":\"Check changeset CLI options\",\"initial_wait\":60}\n[tool bash -> success] args={\"command\":\"cd formats/components && node --input-type=module -e 'import {parseCssDocs} from \\\"@cssdoc/core\\\"; import {PLUGIN_AUDIT_RECORDS} from \\\"./scripts/audit-plugin-components.ts\\\"; console.log(JSON.stringify(parseCssDocs(PLUGIN_AUDIT_RECORDS.find(x=>x.name===\\\"banner\\\").rules(\\\"instui-\\\")).find(x=>x.name===\\\"banner\\\").modifiers,null,2))'\",\"description\":\"Inspect parsed modifier alias metadata\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-examples.test.ts @@ - if (modifier.name.includes(\"*\") || modifier.description.includes(\"@alias\")) continue; + if (modifier.pattern || modifier.alias) continue; *** End Patch\n[tool write_agent -> success] args={\"agent_ids\":[\"049c1373-ecc6-4d66-bbea-f19e45c06453\",\"78631379-5bbe-4a0d-a590-18491ff526c0\",\"13128f82-ab9e-41de-a14e-bd6978da289e\"],\"message\":\"Parsed CssDocEntry.modifiers carries modifier.alias.canonical (not description @alias) and modifier.pattern. I'll add metadata-derived guard that requires canonical visual color/size/variant/state modifier classes on matching component roots, skipping aliases/patterns. Flag any intentional exceptions with rationale. Please ensure data-a11y roots/triggers remain where harness needs them; root identifiers should remain unique. Guard tests now normalize pfx before checking IDs/ARIA for plugin records too.\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md @@ member's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it. Use fenced HTML so audience flags remain metadata, not visible page content. +Keep one audit example per record, with distinct visual variants together: canonical colors, sizes, +and supported states. Don't duplicate deprecated aliases or build a Cartesian product of every +modifier. Include meaningful labels, selected and unselected choices, and native `disabled`, +`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface +for inverse/on-color treatments, without overriding the component's tested colors. Keep decorative +content hidden from assistive technology and preserve required parent/member structures. + +Stack independent cases in normal document flow instead of forcing a wide row. Expanded dialog +variants can use `open` so they remain measurable without one modal hiding the others. Static state +markup is not evidence that hover, keyboard interaction, focus movement, or announcements work: +those still need interaction checks and manual testing. Don't remove a supported variant or add a +fixture-only CSS fix to make the audit pass. + Run `vp run audit:components` from the repository root. It builds local styles and behavior bundles, *** End Patch\n[tool bash -> success] args={\"command\":\"vp check --fix formats/components/tests/audit-examples.test.ts formats/components/scripts/audit-accessibility.ts formats/components/tests/audit-accessibility.test.ts formats/components/src/declarations/focus/index.ts formats/components/src/utilities/ai-gradient/index.ts plugins/pantoken/custom-components/src/components docs/conventions/authoring.md && vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate own plugin and utility changes\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --patch @pantoken/components,@pantoken/plugin-custom-components -m \\\"Expand accessibility audit examples to exercise distinct visual variants and native control states, with minimal component-owned markup.\\\"\",\"description\":\"Generate audit-fixture changeset\",\"initial_wait\":60}","copilot_cache_control":{"type":"ephemeral"}},{"content":"ALLOW: User authorized all five audit-fixture phases; this is an in-scope component example edit.","refusal":null,"role":"assistant","reasoning_opaque":"REDACTED","reasoning_text":"","encrypted_content":"REDACTED","reasoningBlocks":{"provider":"openai-responses","blocks":[{"content":[],"encrypted_content":"REDACTED","id":"","summary":[],"type":"reasoning"}]},"responses_message_status":"completed","phase":"final_answer","serverTools":{"provider":"openai-responses"},"apiCallId":"","outputTokens":183,"providerId":"copilot"}]},"id":"70adf87b-efcb-4da5-8121-6c151cf8ddc7","timestamp":"2026-10-28T21:04:46.475Z","parentId":"f4c2fff4-efaa-40a5-b2f0-79cfd9308a61"}
{"type":"permission.requested","data":{"requestId":"08db760e-20de-4a05-84c5-3973fbf36f4d","permissionRequest":{"kind":"write","toolCallId":"custom_call_ngvomRbtB2rjzm9A2QcYoPdP","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css\n@@ -69,12 +69,27 @@\n  * @sealed\n  * @example -automatica11y\n  * ```html\n- * <label>\n- *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n- * </label>\n- * \n- * <label for=\"storage-used\">Storage used</label>\n- * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n+ * <div><label>Uploading notes <progress class=\"pfx-progress -color-brand -size-xs\" value=\"70\" max=\"100\">70%</progress></label></div>\n+ * <div><label>Preparing files <progress class=\"pfx-progress -color-info -size-sm\" value=\"40\" max=\"100\">40%</progress></label></div>\n+ * <div><label>Reviews complete <progress class=\"pfx-progress -color-success -size-md\" value=\"100\" max=\"100\">100%</progress></label></div>\n+ * <div><label>Storage used <progress class=\"pfx-progress -color-warning -size-lg\" value=\"85\" max=\"100\">85%</progress></label></div>\n+ * <div><label>Failed transfers <progress class=\"pfx-progress -color-danger\" value=\"20\" max=\"100\">20%</progress></label></div>\n+ * <div><label>Starting upload <progress class=\"pfx-progress\" value=\"0\" max=\"100\">0%</progress></label></div>\n+ * <div><label>Finding files <progress class=\"pfx-progress\">Working</progress></label></div>\n+ * <label for=\"audit-storage-used\">Storage quota</label>\n+ * <meter id=\"audit-storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">40 of 60</meter>\n+ * <div class=\"--bg-inverse --text-inverse --p-md\">\n+ *   <label>Background upload <progress class=\"pfx-progress -color-primary-inverse\" value=\"60\" max=\"100\">60%</progress></label>\n+ *   <label>Archive upload <progress class=\"pfx-progress -color-inverse\" value=\"30\" max=\"100\">30%</progress></label>\n+ * </div>\n+ * <p id=\"audit-progress-label\">Processing documents</p>\n+ * <div class=\"pfx-progress -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-progress-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50; --max: 100\">\n+ *   <span class=\"bar\"></span><span class=\"value\">50%</span>\n+ * </div>\n+ * <p id=\"audit-progress-inside-label\">Preparing download</p>\n+ * <div class=\"pfx-progress -size-lg -render-value-inside\" role=\"progressbar\" aria-labelledby=\"audit-progress-inside-label\" aria-valuenow=\"70\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 70; --max: 100\">\n+ *   <span class=\"bar\"></span><span class=\"value\">70%</span>\n+ * </div>\n  * ```\n  */\n /* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n","newFileContents":"/**\n * @component progress\n * @selector .pfx-progress\n * @summary A determinate progress bar with a coloured meter, sizes, and an optional value label.\n * @remarks `.value` is a sibling of `.bar`, both children of the root — mirroring how progress-circle nests its own `.value` part. Native `<progress>` and `<meter>` use vendor value parts with the same semantic fill. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), using a CSS-owned sliding segment and hiding `.value` since there's no meaningful number to show. Reduced motion keeps a static segment; `<meter>` has no indeterminate state.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-inverse — For dark backgrounds.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate meter changes over half a second.\n * @modifier -render-value-inside — Renders `.value` inside the track, aligned to its start, instead of beside it; style it for legibility over the meter colour.\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .bar — The filled meter bar.\n * @part .value — The value text beside the bar.\n * @pseudo ::after — Draws the track's bottom rule as its own layer over the meter, so the full border and the bottom border stay independent across themes.\n * @pseudo ::before — Draws the native indeterminate segment without relying on the browser's built-in animation.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; draws a sliding segment on `::before` and hides `.value`.\n * @cssproperty --value <number> — The current progress value.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --pantoken-progress-fill <color> — The native value part and `.bar` fill; the -color-* modifiers set it.\n * @accessibility Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Scopes the meter part rules with the `@scope` at-rule; browsers without `@scope` support ignore those scoped rules.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"storage-used\">Storage used</label>\n * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress {\n *       .bar {}\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress {\n *     .bar {}\n *     .value {}\n *   }\n * }\n * @related progress-circle — The circular form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <div><label>Uploading notes <progress class=\"pfx-progress -color-brand -size-xs\" value=\"70\" max=\"100\">70%</progress></label></div>\n * <div><label>Preparing files <progress class=\"pfx-progress -color-info -size-sm\" value=\"40\" max=\"100\">40%</progress></label></div>\n * <div><label>Reviews complete <progress class=\"pfx-progress -color-success -size-md\" value=\"100\" max=\"100\">100%</progress></label></div>\n * <div><label>Storage used <progress class=\"pfx-progress -color-warning -size-lg\" value=\"85\" max=\"100\">85%</progress></label></div>\n * <div><label>Failed transfers <progress class=\"pfx-progress -color-danger\" value=\"20\" max=\"100\">20%</progress></label></div>\n * <div><label>Starting upload <progress class=\"pfx-progress\" value=\"0\" max=\"100\">0%</progress></label></div>\n * <div><label>Finding files <progress class=\"pfx-progress\">Working</progress></label></div>\n * <label for=\"audit-storage-used\">Storage quota</label>\n * <meter id=\"audit-storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">40 of 60</meter>\n * <div class=\"--bg-inverse --text-inverse --p-md\">\n *   <label>Background upload <progress class=\"pfx-progress -color-primary-inverse\" value=\"60\" max=\"100\">60%</progress></label>\n *   <label>Archive upload <progress class=\"pfx-progress -color-inverse\" value=\"30\" max=\"100\">30%</progress></label>\n * </div>\n * <p id=\"audit-progress-label\">Processing documents</p>\n * <div class=\"pfx-progress -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-progress-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50; --max: 100\">\n *   <span class=\"bar\"></span><span class=\"value\">50%</span>\n * </div>\n * <p id=\"audit-progress-inside-label\">Preparing download</p>\n * <div class=\"pfx-progress -size-lg -render-value-inside\" role=\"progressbar\" aria-labelledby=\"audit-progress-inside-label\" aria-valuenow=\"70\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 70; --max: 100\">\n *   <span class=\"bar\"></span><span class=\"value\">70%</span>\n * </div>\n * ```\n */\n/* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n   --value) reads as loading rather than rendering a broken 0%-width bar. */\n@keyframes pantoken-progress-indeterminate {\n  0% {\n    inset-inline-start: -40%;\n  }\n\n  100% {\n    inset-inline-start: 100%;\n  }\n}\n\n@scope (.pfx-progress) {\n  & {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    position: relative;\n    display: block;\n    width: 100%;\n    height: var(--instui-component-progress-bar-medium-height);\n    background: var(--instui-component-progress-bar-track-color);\n    /* The full border (InstUI trackLayout.border) frames the track on all sides. */\n    border: var(--instui-component-progress-bar-track-bottom-border-width) solid\n      var(--instui-component-progress-bar-border-color);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    overflow: hidden;\n  }\n\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar {\n    background: transparent;\n    border-radius: var(--instui-component-progress-bar-border-radius);\n  }\n\n  &::-webkit-progress-value {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-progress-bar {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-webkit-meter-bar {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-meter-bar {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  /* InstUI layers a distinct bottom rule (trackBottomBorderColor) over the meter, separate from the full\n     border. In legacy Canvas the full border is transparent so only this rule shows; in the newer themes\n     the full border shows and this rule is transparent. A pseudo keeps both layers independent. */\n  &::after {\n    content: \"\";\n    position: absolute;\n    inset-inline: 0;\n    bottom: 0;\n    height: var(--instui-component-progress-bar-track-bottom-border-width);\n    background: var(--instui-component-progress-bar-track-bottom-border-color);\n    pointer-events: none;\n  }\n\n  &.-size-xs {\n    height: var(--instui-component-progress-bar-x-small-height);\n  }\n\n  &.-size-sm {\n    height: var(--instui-component-progress-bar-small-height);\n  }\n\n  &.-size-md {\n    height: var(--instui-component-progress-bar-medium-height);\n  }\n\n  &.-size-lg {\n    height: var(--instui-component-progress-bar-large-height);\n  }\n\n  & > .bar {\n    height: 100%;\n    width: clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%);\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  & > .value {\n    padding: 0 var(--instui-component-progress-bar-value-padding);\n    color: var(--instui-component-progress-bar-text-color);\n    font-family: var(--instui-component-progress-bar-font-family);\n    font-size: var(--instui-component-progress-bar-medium-value-font-size);\n    font-weight: var(--instui-component-progress-bar-font-weight);\n    line-height: var(--instui-component-progress-bar-line-height);\n  }\n\n  &.-color-inverse > .value,\n  & > .value.-color-inverse {\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate > .bar,\n  &:indeterminate::before {\n    content: \"\";\n    position: absolute;\n    inset-block: 0;\n    inset-inline-start: 0;\n    width: 40%;\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-indeterminate 1.4s ease-in-out infinite;\n    }\n  }\n\n  &:indeterminate > .value {\n    visibility: hidden;\n  }\n\n  /* Color modifiers paired with deprecated meter-color aliases via :is(). */\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-progress-fill: var(--instui-color-background-info);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-progress-fill: var(--instui-color-background-success);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-progress-fill: var(--instui-color-background-warning);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-progress-fill: var(--instui-color-background-error);\n  }\n\n  /* color=\"primary-inverse\": the on-dark scheme. It's a distinct axis from meterColor and overrides it —\n     InstUI's inverse meter tokens all collapse to background-base — so it comes AFTER the meter rules and\n     wins at equal specificity. Pair it with a dark surface. */\n  &.-color-primary-inverse {\n    --pantoken-progress-fill: var(--instui-component-progress-bar-meter-color-brand-inverse);\n    background: var(--instui-component-progress-bar-track-color-inverse);\n    border-color: var(--instui-component-progress-bar-border-color-inverse);\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  &.-color-primary-inverse::after {\n    background: var(--instui-component-progress-bar-track-bottom-border-color-inverse);\n  }\n\n  &.-render-value-inside > .value {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n  }\n\n  /* Mount/value transition — the interactions layer toggles `-should-animate` on value changes. */\n  &.-should-animate > .bar {\n    @media (prefers-reduced-motion: no-preference) {\n      transition: all 0.5s;\n    }\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css","content":"/**\n * @component progress\n * @selector .pfx-progress\n * @summary A determinate progress bar with a coloured meter, sizes, and an optional value label.\n * @remarks `.value` is a sibling of `.bar`, both children of the root — mirroring how progress-circle nests its own `.value` part. Native `<progress>` and `<meter>` use vendor value parts with the same semantic fill. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), using a CSS-owned sliding segment and hiding `.value` since there's no meaningful number to show. Reduced motion keeps a static segment; `<meter>` has no indeterminate state.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-inverse — For dark backgrounds.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate meter changes over half a second.\n * @modifier -render-value-inside — Renders `.value` inside the track, aligned to its start, instead of beside it; style it for legibility over the meter colour.\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .bar — The filled meter bar.\n * @part .value — The value text beside the bar.\n * @pseudo ::after — Draws the track's bottom rule as its own layer over the meter, so the full border and the bottom border stay independent across themes.\n * @pseudo ::before — Draws the native indeterminate segment without relying on the browser's built-in animation.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; draws a sliding segment on `::before` and hides `.value`.\n * @cssproperty --value <number> — The current progress value.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --pantoken-progress-fill <color> — The native value part and `.bar` fill; the -color-* modifiers set it.\n * @accessibility Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Scopes the meter part rules with the `@scope` at-rule; browsers without `@scope` support ignore those scoped rules.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"storage-used\">Storage used</label>\n * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress {\n *       .bar {}\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress {\n *     .bar {}\n *     .value {}\n *   }\n * }\n * @related progress-circle — The circular form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n * </label>\n * \n * <label for=\"storage-used\">Storage used</label>\n * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n */\n/* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n   --value) reads as loading rather than rendering a broken 0%-width bar. */\n@keyframes pantoken-progress-indeterminate {\n  0% {\n    inset-inline-start: -40%;\n  }\n\n  100% {\n    inset-inline-start: 100%;\n  }\n}\n\n@scope (.pfx-progress) {\n  & {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    position: relative;\n    display: block;\n    width: 100%;\n    height: var(--instui-component-progress-bar-medium-height);\n    background: var(--instui-component-progress-bar-track-color);\n    /* The full border (InstUI trackLayout.border) frames the track on all sides. */\n    border: var(--instui-component-progress-bar-track-bottom-border-width) solid\n      var(--instui-component-progress-bar-border-color);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    overflow: hidden;\n  }\n\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar {\n    background: transparent;\n    border-radius: var(--instui-component-progress-bar-border-radius);\n  }\n\n  &::-webkit-progress-value {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-progress-bar {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-webkit-meter-bar {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-meter-bar {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  /* InstUI layers a distinct bottom rule (trackBottomBorderColor) over the meter, separate from the full\n     border. In legacy Canvas the full border is transparent so only this rule shows; in the newer themes\n     the full border shows and this rule is transparent. A pseudo keeps both layers independent. */\n  &::after {\n    content: \"\";\n    position: absolute;\n    inset-inline: 0;\n    bottom: 0;\n    height: var(--instui-component-progress-bar-track-bottom-border-width);\n    background: var(--instui-component-progress-bar-track-bottom-border-color);\n    pointer-events: none;\n  }\n\n  &.-size-xs {\n    height: var(--instui-component-progress-bar-x-small-height);\n  }\n\n  &.-size-sm {\n    height: var(--instui-component-progress-bar-small-height);\n  }\n\n  &.-size-md {\n    height: var(--instui-component-progress-bar-medium-height);\n  }\n\n  &.-size-lg {\n    height: var(--instui-component-progress-bar-large-height);\n  }\n\n  & > .bar {\n    height: 100%;\n    width: clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%);\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  & > .value {\n    padding: 0 var(--instui-component-progress-bar-value-padding);\n    color: var(--instui-component-progress-bar-text-color);\n    font-family: var(--instui-component-progress-bar-font-family);\n    font-size: var(--instui-component-progress-bar-medium-value-font-size);\n    font-weight: var(--instui-component-progress-bar-font-weight);\n    line-height: var(--instui-component-progress-bar-line-height);\n  }\n\n  &.-color-inverse > .value,\n  & > .value.-color-inverse {\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate > .bar,\n  &:indeterminate::before {\n    content: \"\";\n    position: absolute;\n    inset-block: 0;\n    inset-inline-start: 0;\n    width: 40%;\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-indeterminate 1.4s ease-in-out infinite;\n    }\n  }\n\n  &:indeterminate > .value {\n    visibility: hidden;\n  }\n\n  /* Color modifiers paired with deprecated meter-color aliases via :is(). */\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-progress-fill: var(--instui-color-background-info);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-progress-fill: var(--instui-color-background-success);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-progress-fill: var(--instui-color-background-warning);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-progress-fill: var(--instui-color-background-error);\n  }\n\n  /* color=\"primary-inverse\": the on-dark scheme. It's a distinct axis from meterColor and overrides it —\n     InstUI's inverse meter tokens all collapse to background-base — so it comes AFTER the meter rules and\n     wins at equal specificity. Pair it with a dark surface. */\n  &.-color-primary-inverse {\n    --pantoken-progress-fill: var(--instui-component-progress-bar-meter-color-brand-inverse);\n    background: var(--instui-component-progress-bar-track-color-inverse);\n    border-color: var(--instui-component-progress-bar-border-color-inverse);\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  &.-color-primary-inverse::after {\n    background: var(--instui-component-progress-bar-track-bottom-border-color-inverse);\n  }\n\n  &.-render-value-inside > .value {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n  }\n\n  /* Mount/value transition — the interactions layer toggles `-should-animate` on value changes. */\n  &.-should-animate > .bar {\n    @media (prefers-reduced-motion: no-preference) {\n      transition: all 0.5s;\n    }\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css","content":"/**\n * @component progress\n * @selector .pfx-progress\n * @summary A determinate progress bar with a coloured meter, sizes, and an optional value label.\n * @remarks `.value` is a sibling of `.bar`, both children of the root — mirroring how progress-circle nests its own `.value` part. Native `<progress>` and `<meter>` use vendor value parts with the same semantic fill. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), using a CSS-owned sliding segment and hiding `.value` since there's no meaningful number to show. Reduced motion keeps a static segment; `<meter>` has no indeterminate state.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-inverse — For dark backgrounds.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate meter changes over half a second.\n * @modifier -render-value-inside — Renders `.value` inside the track, aligned to its start, instead of beside it; style it for legibility over the meter colour.\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .bar — The filled meter bar.\n * @part .value — The value text beside the bar.\n * @pseudo ::after — Draws the track's bottom rule as its own layer over the meter, so the full border and the bottom border stay independent across themes.\n * @pseudo ::before — Draws the native indeterminate segment without relying on the browser's built-in animation.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; draws a sliding segment on `::before` and hides `.value`.\n * @cssproperty --value <number> — The current progress value.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --pantoken-progress-fill <color> — The native value part and `.bar` fill; the -color-* modifiers set it.\n * @accessibility Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Scopes the meter part rules with the `@scope` at-rule; browsers without `@scope` support ignore those scoped rules.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"storage-used\">Storage used</label>\n * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress {\n *       .bar {}\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress {\n *     .bar {}\n *     .value {}\n *   }\n * }\n * @related progress-circle — The circular form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <div><label>Uploading notes <progress class=\"pfx-progress -color-brand -size-xs\" value=\"70\" max=\"100\">70%</progress></label></div>\n * <div><label>Preparing files <progress class=\"pfx-progress -color-info -size-sm\" value=\"40\" max=\"100\">40%</progress></label></div>\n * <div><label>Reviews complete <progress class=\"pfx-progress -color-success -size-md\" value=\"100\" max=\"100\">100%</progress></label></div>\n * <div><label>Storage used <progress class=\"pfx-progress -color-warning -size-lg\" value=\"85\" max=\"100\">85%</progress></label></div>\n * <div><label>Failed transfers <progress class=\"pfx-progress -color-danger\" value=\"20\" max=\"100\">20%</progress></label></div>\n * <div><label>Starting upload <progress class=\"pfx-progress\" value=\"0\" max=\"100\">0%</progress></label></div>\n * <div><label>Finding files <progress class=\"pfx-progress\">Working</progress></label></div>\n * <label for=\"audit-storage-used\">Storage quota</label>\n * <meter id=\"audit-storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">40 of 60</meter>\n * <div class=\"--bg-inverse --text-inverse --p-md\">\n *   <label>Background upload <progress class=\"pfx-progress -color-primary-inverse\" value=\"60\" max=\"100\">60%</progress></label>\n *   <label>Archive upload <progress class=\"pfx-progress -color-inverse\" value=\"30\" max=\"100\">30%</progress></label>\n * </div>\n * <p id=\"audit-progress-label\">Processing documents</p>\n * <div class=\"pfx-progress -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-progress-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50; --max: 100\">\n *   <span class=\"bar\"></span><span class=\"value\">50%</span>\n * </div>\n * <p id=\"audit-progress-inside-label\">Preparing download</p>\n * <div class=\"pfx-progress -size-lg -render-value-inside\" role=\"progressbar\" aria-labelledby=\"audit-progress-inside-label\" aria-valuenow=\"70\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 70; --max: 100\">\n *   <span class=\"bar\"></span><span class=\"value\">70%</span>\n * </div>\n * ```\n */\n/* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n   --value) reads as loading rather than rendering a broken 0%-width bar. */\n@keyframes pantoken-progress-indeterminate {\n  0% {\n    inset-inline-start: -40%;\n  }\n\n  100% {\n    inset-inline-start: 100%;\n  }\n}\n\n@scope (.pfx-progress) {\n  & {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    position: relative;\n    display: block;\n    width: 100%;\n    height: var(--instui-component-progress-bar-medium-height);\n    background: var(--instui-component-progress-bar-track-color);\n    /* The full border (InstUI trackLayout.border) frames the track on all sides. */\n    border: var(--instui-component-progress-bar-track-bottom-border-width) solid\n      var(--instui-component-progress-bar-border-color);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    overflow: hidden;\n  }\n\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar {\n    background: transparent;\n    border-radius: var(--instui-component-progress-bar-border-radius);\n  }\n\n  &::-webkit-progress-value {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-progress-bar {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-webkit-meter-bar {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-meter-bar {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  /* InstUI layers a distinct bottom rule (trackBottomBorderColor) over the meter, separate from the full\n     border. In legacy Canvas the full border is transparent so only this rule shows; in the newer themes\n     the full border shows and this rule is transparent. A pseudo keeps both layers independent. */\n  &::after {\n    content: \"\";\n    position: absolute;\n    inset-inline: 0;\n    bottom: 0;\n    height: var(--instui-component-progress-bar-track-bottom-border-width);\n    background: var(--instui-component-progress-bar-track-bottom-border-color);\n    pointer-events: none;\n  }\n\n  &.-size-xs {\n    height: var(--instui-component-progress-bar-x-small-height);\n  }\n\n  &.-size-sm {\n    height: var(--instui-component-progress-bar-small-height);\n  }\n\n  &.-size-md {\n    height: var(--instui-component-progress-bar-medium-height);\n  }\n\n  &.-size-lg {\n    height: var(--instui-component-progress-bar-large-height);\n  }\n\n  & > .bar {\n    height: 100%;\n    width: clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%);\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  & > .value {\n    padding: 0 var(--instui-component-progress-bar-value-padding);\n    color: var(--instui-component-progress-bar-text-color);\n    font-family: var(--instui-component-progress-bar-font-family);\n    font-size: var(--instui-component-progress-bar-medium-value-font-size);\n    font-weight: var(--instui-component-progress-bar-font-weight);\n    line-height: var(--instui-component-progress-bar-line-height);\n  }\n\n  &.-color-inverse > .value,\n  & > .value.-color-inverse {\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate > .bar,\n  &:indeterminate::before {\n    content: \"\";\n    position: absolute;\n    inset-block: 0;\n    inset-inline-start: 0;\n    width: 40%;\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-indeterminate 1.4s ease-in-out infinite;\n    }\n  }\n\n  &:indeterminate > .value {\n    visibility: hidden;\n  }\n\n  /* Color modifiers paired with deprecated meter-color aliases via :is(). */\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-progress-fill: var(--instui-color-background-info);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-progress-fill: var(--instui-color-background-success);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-progress-fill: var(--instui-color-background-warning);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-progress-fill: var(--instui-color-background-error);\n  }\n\n  /* color=\"primary-inverse\": the on-dark scheme. It's a distinct axis from meterColor and overrides it —\n     InstUI's inverse meter tokens all collapse to background-base — so it comes AFTER the meter rules and\n     wins at equal specificity. Pair it with a dark surface. */\n  &.-color-primary-inverse {\n    --pantoken-progress-fill: var(--instui-component-progress-bar-meter-color-brand-inverse);\n    background: var(--instui-component-progress-bar-track-color-inverse);\n    border-color: var(--instui-component-progress-bar-border-color-inverse);\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  &.-color-primary-inverse::after {\n    background: var(--instui-component-progress-bar-track-bottom-border-color-inverse);\n  }\n\n  &.-render-value-inside > .value {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n  }\n\n  /* Mount/value transition — the interactions layer toggles `-should-animate` on value changes. */\n  &.-should-animate > .bar {\n    @media (prefers-reduced-motion: no-preference) {\n      transition: all 0.5s;\n    }\n  }\n}\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_ngvomRbtB2rjzm9A2QcYoPdP","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css\n@@ -69,12 +69,27 @@\n  * @sealed\n  * @example -automatica11y\n  * ```html\n- * <label>\n- *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n- * </label>\n- * \n- * <label for=\"storage-used\">Storage used</label>\n- * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n+ * <div><label>Uploading notes <progress class=\"pfx-progress -color-brand -size-xs\" value=\"70\" max=\"100\">70%</progress></label></div>\n+ * <div><label>Preparing files <progress class=\"pfx-progress -color-info -size-sm\" value=\"40\" max=\"100\">40%</progress></label></div>\n+ * <div><label>Reviews complete <progress class=\"pfx-progress -color-success -size-md\" value=\"100\" max=\"100\">100%</progress></label></div>\n+ * <div><label>Storage used <progress class=\"pfx-progress -color-warning -size-lg\" value=\"85\" max=\"100\">85%</progress></label></div>\n+ * <div><label>Failed transfers <progress class=\"pfx-progress -color-danger\" value=\"20\" max=\"100\">20%</progress></label></div>\n+ * <div><label>Starting upload <progress class=\"pfx-progress\" value=\"0\" max=\"100\">0%</progress></label></div>\n+ * <div><label>Finding files <progress class=\"pfx-progress\">Working</progress></label></div>\n+ * <label for=\"audit-storage-used\">Storage quota</label>\n+ * <meter id=\"audit-storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">40 of 60</meter>\n+ * <div class=\"--bg-inverse --text-inverse --p-md\">\n+ *   <label>Background upload <progress class=\"pfx-progress -color-primary-inverse\" value=\"60\" max=\"100\">60%</progress></label>\n+ *   <label>Archive upload <progress class=\"pfx-progress -color-inverse\" value=\"30\" max=\"100\">30%</progress></label>\n+ * </div>\n+ * <p id=\"audit-progress-label\">Processing documents</p>\n+ * <div class=\"pfx-progress -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-progress-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50; --max: 100\">\n+ *   <span class=\"bar\"></span><span class=\"value\">50%</span>\n+ * </div>\n+ * <p id=\"audit-progress-inside-label\">Preparing download</p>\n+ * <div class=\"pfx-progress -size-lg -render-value-inside\" role=\"progressbar\" aria-labelledby=\"audit-progress-inside-label\" aria-valuenow=\"70\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 70; --max: 100\">\n+ *   <span class=\"bar\"></span><span class=\"value\">70%</span>\n+ * </div>\n  * ```\n  */\n /* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n","newFileContents":"/**\n * @component progress\n * @selector .pfx-progress\n * @summary A determinate progress bar with a coloured meter, sizes, and an optional value label.\n * @remarks `.value` is a sibling of `.bar`, both children of the root — mirroring how progress-circle nests its own `.value` part. Native `<progress>` and `<meter>` use vendor value parts with the same semantic fill. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), using a CSS-owned sliding segment and hiding `.value` since there's no meaningful number to show. Reduced motion keeps a static segment; `<meter>` has no indeterminate state.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-inverse — For dark backgrounds.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate meter changes over half a second.\n * @modifier -render-value-inside — Renders `.value` inside the track, aligned to its start, instead of beside it; style it for legibility over the meter colour.\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .bar — The filled meter bar.\n * @part .value — The value text beside the bar.\n * @pseudo ::after — Draws the track's bottom rule as its own layer over the meter, so the full border and the bottom border stay independent across themes.\n * @pseudo ::before — Draws the native indeterminate segment without relying on the browser's built-in animation.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; draws a sliding segment on `::before` and hides `.value`.\n * @cssproperty --value <number> — The current progress value.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --pantoken-progress-fill <color> — The native value part and `.bar` fill; the -color-* modifiers set it.\n * @accessibility Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Scopes the meter part rules with the `@scope` at-rule; browsers without `@scope` support ignore those scoped rules.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"storage-used\">Storage used</label>\n * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress {\n *       .bar {}\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress {\n *     .bar {}\n *     .value {}\n *   }\n * }\n * @related progress-circle — The circular form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <div><label>Uploading notes <progress class=\"pfx-progress -color-brand -size-xs\" value=\"70\" max=\"100\">70%</progress></label></div>\n * <div><label>Preparing files <progress class=\"pfx-progress -color-info -size-sm\" value=\"40\" max=\"100\">40%</progress></label></div>\n * <div><label>Reviews complete <progress class=\"pfx-progress -color-success -size-md\" value=\"100\" max=\"100\">100%</progress></label></div>\n * <div><label>Storage used <progress class=\"pfx-progress -color-warning -size-lg\" value=\"85\" max=\"100\">85%</progress></label></div>\n * <div><label>Failed transfers <progress class=\"pfx-progress -color-danger\" value=\"20\" max=\"100\">20%</progress></label></div>\n * <div><label>Starting upload <progress class=\"pfx-progress\" value=\"0\" max=\"100\">0%</progress></label></div>\n * <div><label>Finding files <progress class=\"pfx-progress\">Working</progress></label></div>\n * <label for=\"audit-storage-used\">Storage quota</label>\n * <meter id=\"audit-storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">40 of 60</meter>\n * <div class=\"--bg-inverse --text-inverse --p-md\">\n *   <label>Background upload <progress class=\"pfx-progress -color-primary-inverse\" value=\"60\" max=\"100\">60%</progress></label>\n *   <label>Archive upload <progress class=\"pfx-progress -color-inverse\" value=\"30\" max=\"100\">30%</progress></label>\n * </div>\n * <p id=\"audit-progress-label\">Processing documents</p>\n * <div class=\"pfx-progress -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-progress-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50; --max: 100\">\n *   <span class=\"bar\"></span><span class=\"value\">50%</span>\n * </div>\n * <p id=\"audit-progress-inside-label\">Preparing download</p>\n * <div class=\"pfx-progress -size-lg -render-value-inside\" role=\"progressbar\" aria-labelledby=\"audit-progress-inside-label\" aria-valuenow=\"70\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 70; --max: 100\">\n *   <span class=\"bar\"></span><span class=\"value\">70%</span>\n * </div>\n * ```\n */\n/* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n   --value) reads as loading rather than rendering a broken 0%-width bar. */\n@keyframes pantoken-progress-indeterminate {\n  0% {\n    inset-inline-start: -40%;\n  }\n\n  100% {\n    inset-inline-start: 100%;\n  }\n}\n\n@scope (.pfx-progress) {\n  & {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    position: relative;\n    display: block;\n    width: 100%;\n    height: var(--instui-component-progress-bar-medium-height);\n    background: var(--instui-component-progress-bar-track-color);\n    /* The full border (InstUI trackLayout.border) frames the track on all sides. */\n    border: var(--instui-component-progress-bar-track-bottom-border-width) solid\n      var(--instui-component-progress-bar-border-color);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    overflow: hidden;\n  }\n\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar {\n    background: transparent;\n    border-radius: var(--instui-component-progress-bar-border-radius);\n  }\n\n  &::-webkit-progress-value {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-progress-bar {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-webkit-meter-bar {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-meter-bar {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  /* InstUI layers a distinct bottom rule (trackBottomBorderColor) over the meter, separate from the full\n     border. In legacy Canvas the full border is transparent so only this rule shows; in the newer themes\n     the full border shows and this rule is transparent. A pseudo keeps both layers independent. */\n  &::after {\n    content: \"\";\n    position: absolute;\n    inset-inline: 0;\n    bottom: 0;\n    height: var(--instui-component-progress-bar-track-bottom-border-width);\n    background: var(--instui-component-progress-bar-track-bottom-border-color);\n    pointer-events: none;\n  }\n\n  &.-size-xs {\n    height: var(--instui-component-progress-bar-x-small-height);\n  }\n\n  &.-size-sm {\n    height: var(--instui-component-progress-bar-small-height);\n  }\n\n  &.-size-md {\n    height: var(--instui-component-progress-bar-medium-height);\n  }\n\n  &.-size-lg {\n    height: var(--instui-component-progress-bar-large-height);\n  }\n\n  & > .bar {\n    height: 100%;\n    width: clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%);\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  & > .value {\n    padding: 0 var(--instui-component-progress-bar-value-padding);\n    color: var(--instui-component-progress-bar-text-color);\n    font-family: var(--instui-component-progress-bar-font-family);\n    font-size: var(--instui-component-progress-bar-medium-value-font-size);\n    font-weight: var(--instui-component-progress-bar-font-weight);\n    line-height: var(--instui-component-progress-bar-line-height);\n  }\n\n  &.-color-inverse > .value,\n  & > .value.-color-inverse {\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate > .bar,\n  &:indeterminate::before {\n    content: \"\";\n    position: absolute;\n    inset-block: 0;\n    inset-inline-start: 0;\n    width: 40%;\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-indeterminate 1.4s ease-in-out infinite;\n    }\n  }\n\n  &:indeterminate > .value {\n    visibility: hidden;\n  }\n\n  /* Color modifiers paired with deprecated meter-color aliases via :is(). */\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-progress-fill: var(--instui-color-background-info);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-progress-fill: var(--instui-color-background-success);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-progress-fill: var(--instui-color-background-warning);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-progress-fill: var(--instui-color-background-error);\n  }\n\n  /* color=\"primary-inverse\": the on-dark scheme. It's a distinct axis from meterColor and overrides it —\n     InstUI's inverse meter tokens all collapse to background-base — so it comes AFTER the meter rules and\n     wins at equal specificity. Pair it with a dark surface. */\n  &.-color-primary-inverse {\n    --pantoken-progress-fill: var(--instui-component-progress-bar-meter-color-brand-inverse);\n    background: var(--instui-component-progress-bar-track-color-inverse);\n    border-color: var(--instui-component-progress-bar-border-color-inverse);\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  &.-color-primary-inverse::after {\n    background: var(--instui-component-progress-bar-track-bottom-border-color-inverse);\n  }\n\n  &.-render-value-inside > .value {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n  }\n\n  /* Mount/value transition — the interactions layer toggles `-should-animate` on value changes. */\n  &.-should-animate > .bar {\n    @media (prefers-reduced-motion: no-preference) {\n      transition: all 0.5s;\n    }\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css","content":"/**\n * @component progress\n * @selector .pfx-progress\n * @summary A determinate progress bar with a coloured meter, sizes, and an optional value label.\n * @remarks `.value` is a sibling of `.bar`, both children of the root — mirroring how progress-circle nests its own `.value` part. Native `<progress>` and `<meter>` use vendor value parts with the same semantic fill. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), using a CSS-owned sliding segment and hiding `.value` since there's no meaningful number to show. Reduced motion keeps a static segment; `<meter>` has no indeterminate state.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-inverse — For dark backgrounds.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate meter changes over half a second.\n * @modifier -render-value-inside — Renders `.value` inside the track, aligned to its start, instead of beside it; style it for legibility over the meter colour.\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .bar — The filled meter bar.\n * @part .value — The value text beside the bar.\n * @pseudo ::after — Draws the track's bottom rule as its own layer over the meter, so the full border and the bottom border stay independent across themes.\n * @pseudo ::before — Draws the native indeterminate segment without relying on the browser's built-in animation.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; draws a sliding segment on `::before` and hides `.value`.\n * @cssproperty --value <number> — The current progress value.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --pantoken-progress-fill <color> — The native value part and `.bar` fill; the -color-* modifiers set it.\n * @accessibility Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Scopes the meter part rules with the `@scope` at-rule; browsers without `@scope` support ignore those scoped rules.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"storage-used\">Storage used</label>\n * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress {\n *       .bar {}\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress {\n *     .bar {}\n *     .value {}\n *   }\n * }\n * @related progress-circle — The circular form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n * </label>\n * \n * <label for=\"storage-used\">Storage used</label>\n * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n */\n/* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n   --value) reads as loading rather than rendering a broken 0%-width bar. */\n@keyframes pantoken-progress-indeterminate {\n  0% {\n    inset-inline-start: -40%;\n  }\n\n  100% {\n    inset-inline-start: 100%;\n  }\n}\n\n@scope (.pfx-progress) {\n  & {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    position: relative;\n    display: block;\n    width: 100%;\n    height: var(--instui-component-progress-bar-medium-height);\n    background: var(--instui-component-progress-bar-track-color);\n    /* The full border (InstUI trackLayout.border) frames the track on all sides. */\n    border: var(--instui-component-progress-bar-track-bottom-border-width) solid\n      var(--instui-component-progress-bar-border-color);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    overflow: hidden;\n  }\n\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar {\n    background: transparent;\n    border-radius: var(--instui-component-progress-bar-border-radius);\n  }\n\n  &::-webkit-progress-value {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-progress-bar {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-webkit-meter-bar {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-meter-bar {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  /* InstUI layers a distinct bottom rule (trackBottomBorderColor) over the meter, separate from the full\n     border. In legacy Canvas the full border is transparent so only this rule shows; in the newer themes\n     the full border shows and this rule is transparent. A pseudo keeps both layers independent. */\n  &::after {\n    content: \"\";\n    position: absolute;\n    inset-inline: 0;\n    bottom: 0;\n    height: var(--instui-component-progress-bar-track-bottom-border-width);\n    background: var(--instui-component-progress-bar-track-bottom-border-color);\n    pointer-events: none;\n  }\n\n  &.-size-xs {\n    height: var(--instui-component-progress-bar-x-small-height);\n  }\n\n  &.-size-sm {\n    height: var(--instui-component-progress-bar-small-height);\n  }\n\n  &.-size-md {\n    height: var(--instui-component-progress-bar-medium-height);\n  }\n\n  &.-size-lg {\n    height: var(--instui-component-progress-bar-large-height);\n  }\n\n  & > .bar {\n    height: 100%;\n    width: clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%);\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  & > .value {\n    padding: 0 var(--instui-component-progress-bar-value-padding);\n    color: var(--instui-component-progress-bar-text-color);\n    font-family: var(--instui-component-progress-bar-font-family);\n    font-size: var(--instui-component-progress-bar-medium-value-font-size);\n    font-weight: var(--instui-component-progress-bar-font-weight);\n    line-height: var(--instui-component-progress-bar-line-height);\n  }\n\n  &.-color-inverse > .value,\n  & > .value.-color-inverse {\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate > .bar,\n  &:indeterminate::before {\n    content: \"\";\n    position: absolute;\n    inset-block: 0;\n    inset-inline-start: 0;\n    width: 40%;\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-indeterminate 1.4s ease-in-out infinite;\n    }\n  }\n\n  &:indeterminate > .value {\n    visibility: hidden;\n  }\n\n  /* Color modifiers paired with deprecated meter-color aliases via :is(). */\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-progress-fill: var(--instui-color-background-info);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-progress-fill: var(--instui-color-background-success);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-progress-fill: var(--instui-color-background-warning);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-progress-fill: var(--instui-color-background-error);\n  }\n\n  /* color=\"primary-inverse\": the on-dark scheme. It's a distinct axis from meterColor and overrides it —\n     InstUI's inverse meter tokens all collapse to background-base — so it comes AFTER the meter rules and\n     wins at equal specificity. Pair it with a dark surface. */\n  &.-color-primary-inverse {\n    --pantoken-progress-fill: var(--instui-component-progress-bar-meter-color-brand-inverse);\n    background: var(--instui-component-progress-bar-track-color-inverse);\n    border-color: var(--instui-component-progress-bar-border-color-inverse);\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  &.-color-primary-inverse::after {\n    background: var(--instui-component-progress-bar-track-bottom-border-color-inverse);\n  }\n\n  &.-render-value-inside > .value {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n  }\n\n  /* Mount/value transition — the interactions layer toggles `-should-animate` on value changes. */\n  &.-should-animate > .bar {\n    @media (prefers-reduced-motion: no-preference) {\n      transition: all 0.5s;\n    }\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress/progress.css","content":"/**\n * @component progress\n * @selector .pfx-progress\n * @summary A determinate progress bar with a coloured meter, sizes, and an optional value label.\n * @remarks `.value` is a sibling of `.bar`, both children of the root — mirroring how progress-circle nests its own `.value` part. Native `<progress>` and `<meter>` use vendor value parts with the same semantic fill. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), using a CSS-owned sliding segment and hiding `.value` since there's no meaningful number to show. Reduced motion keeps a static segment; `<meter>` has no indeterminate state.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-inverse — For dark backgrounds.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate meter changes over half a second.\n * @modifier -render-value-inside — Renders `.value` inside the track, aligned to its start, instead of beside it; style it for legibility over the meter colour.\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .bar — The filled meter bar.\n * @part .value — The value text beside the bar.\n * @pseudo ::after — Draws the track's bottom rule as its own layer over the meter, so the full border and the bottom border stay independent across themes.\n * @pseudo ::before — Draws the native indeterminate segment without relying on the browser's built-in animation.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; draws a sliding segment on `::before` and hides `.value`.\n * @cssproperty --value <number> — The current progress value.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --pantoken-progress-fill <color> — The native value part and `.bar` fill; the -color-* modifiers set it.\n * @accessibility Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Scopes the meter part rules with the `@scope` at-rule; browsers without `@scope` support ignore those scoped rules.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress -color-brand\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"storage-used\">Storage used</label>\n * <meter id=\"storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress {\n *       .bar {}\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress {\n *     .bar {}\n *     .value {}\n *   }\n * }\n * @related progress-circle — The circular form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <div><label>Uploading notes <progress class=\"pfx-progress -color-brand -size-xs\" value=\"70\" max=\"100\">70%</progress></label></div>\n * <div><label>Preparing files <progress class=\"pfx-progress -color-info -size-sm\" value=\"40\" max=\"100\">40%</progress></label></div>\n * <div><label>Reviews complete <progress class=\"pfx-progress -color-success -size-md\" value=\"100\" max=\"100\">100%</progress></label></div>\n * <div><label>Storage used <progress class=\"pfx-progress -color-warning -size-lg\" value=\"85\" max=\"100\">85%</progress></label></div>\n * <div><label>Failed transfers <progress class=\"pfx-progress -color-danger\" value=\"20\" max=\"100\">20%</progress></label></div>\n * <div><label>Starting upload <progress class=\"pfx-progress\" value=\"0\" max=\"100\">0%</progress></label></div>\n * <div><label>Finding files <progress class=\"pfx-progress\">Working</progress></label></div>\n * <label for=\"audit-storage-used\">Storage quota</label>\n * <meter id=\"audit-storage-used\" class=\"pfx-progress -color-warning\" min=\"20\" value=\"40\" max=\"60\">40 of 60</meter>\n * <div class=\"--bg-inverse --text-inverse --p-md\">\n *   <label>Background upload <progress class=\"pfx-progress -color-primary-inverse\" value=\"60\" max=\"100\">60%</progress></label>\n *   <label>Archive upload <progress class=\"pfx-progress -color-inverse\" value=\"30\" max=\"100\">30%</progress></label>\n * </div>\n * <p id=\"audit-progress-label\">Processing documents</p>\n * <div class=\"pfx-progress -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-progress-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50; --max: 100\">\n *   <span class=\"bar\"></span><span class=\"value\">50%</span>\n * </div>\n * <p id=\"audit-progress-inside-label\">Preparing download</p>\n * <div class=\"pfx-progress -size-lg -render-value-inside\" role=\"progressbar\" aria-labelledby=\"audit-progress-inside-label\" aria-valuenow=\"70\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 70; --max: 100\">\n *   <span class=\"bar\"></span><span class=\"value\">70%</span>\n * </div>\n * ```\n */\n/* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n   --value) reads as loading rather than rendering a broken 0%-width bar. */\n@keyframes pantoken-progress-indeterminate {\n  0% {\n    inset-inline-start: -40%;\n  }\n\n  100% {\n    inset-inline-start: 100%;\n  }\n}\n\n@scope (.pfx-progress) {\n  & {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    position: relative;\n    display: block;\n    width: 100%;\n    height: var(--instui-component-progress-bar-medium-height);\n    background: var(--instui-component-progress-bar-track-color);\n    /* The full border (InstUI trackLayout.border) frames the track on all sides. */\n    border: var(--instui-component-progress-bar-track-bottom-border-width) solid\n      var(--instui-component-progress-bar-border-color);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    overflow: hidden;\n  }\n\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar {\n    background: transparent;\n    border-radius: var(--instui-component-progress-bar-border-radius);\n  }\n\n  &::-webkit-progress-value {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-progress-bar {\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-webkit-meter-bar {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  &::-moz-meter-bar {\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  /* InstUI layers a distinct bottom rule (trackBottomBorderColor) over the meter, separate from the full\n     border. In legacy Canvas the full border is transparent so only this rule shows; in the newer themes\n     the full border shows and this rule is transparent. A pseudo keeps both layers independent. */\n  &::after {\n    content: \"\";\n    position: absolute;\n    inset-inline: 0;\n    bottom: 0;\n    height: var(--instui-component-progress-bar-track-bottom-border-width);\n    background: var(--instui-component-progress-bar-track-bottom-border-color);\n    pointer-events: none;\n  }\n\n  &.-size-xs {\n    height: var(--instui-component-progress-bar-x-small-height);\n  }\n\n  &.-size-sm {\n    height: var(--instui-component-progress-bar-small-height);\n  }\n\n  &.-size-md {\n    height: var(--instui-component-progress-bar-medium-height);\n  }\n\n  &.-size-lg {\n    height: var(--instui-component-progress-bar-large-height);\n  }\n\n  & > .bar {\n    height: 100%;\n    width: clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%);\n    background: var(--pantoken-progress-fill);\n    border-radius: var(--instui-component-progress-bar-border-radius);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n  }\n\n  & > .value {\n    padding: 0 var(--instui-component-progress-bar-value-padding);\n    color: var(--instui-component-progress-bar-text-color);\n    font-family: var(--instui-component-progress-bar-font-family);\n    font-size: var(--instui-component-progress-bar-medium-value-font-size);\n    font-weight: var(--instui-component-progress-bar-font-weight);\n    line-height: var(--instui-component-progress-bar-line-height);\n  }\n\n  &.-color-inverse > .value,\n  & > .value.-color-inverse {\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate > .bar,\n  &:indeterminate::before {\n    content: \"\";\n    position: absolute;\n    inset-block: 0;\n    inset-inline-start: 0;\n    width: 40%;\n    background: var(--pantoken-progress-fill);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      background: Highlight;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-indeterminate 1.4s ease-in-out infinite;\n    }\n  }\n\n  &:indeterminate > .value {\n    visibility: hidden;\n  }\n\n  /* Color modifiers paired with deprecated meter-color aliases via :is(). */\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-progress-fill: var(--instui-color-background-brand);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-progress-fill: var(--instui-color-background-info);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-progress-fill: var(--instui-color-background-success);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-progress-fill: var(--instui-color-background-warning);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-progress-fill: var(--instui-color-background-error);\n  }\n\n  /* color=\"primary-inverse\": the on-dark scheme. It's a distinct axis from meterColor and overrides it —\n     InstUI's inverse meter tokens all collapse to background-base — so it comes AFTER the meter rules and\n     wins at equal specificity. Pair it with a dark surface. */\n  &.-color-primary-inverse {\n    --pantoken-progress-fill: var(--instui-component-progress-bar-meter-color-brand-inverse);\n    background: var(--instui-component-progress-bar-track-color-inverse);\n    border-color: var(--instui-component-progress-bar-border-color-inverse);\n    color: var(--instui-component-progress-bar-text-color-inverse);\n  }\n\n  &.-color-primary-inverse::after {\n    background: var(--instui-component-progress-bar-track-bottom-border-color-inverse);\n  }\n\n  &.-render-value-inside > .value {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n  }\n\n  /* Mount/value transition — the interactions layer toggles `-should-animate` on value changes. */\n  &.-should-animate > .bar {\n    @media (prefers-reduced-motion: no-preference) {\n      transition: all 0.5s;\n    }\n  }\n}\n"}}],"_permissionRequestSessionId":"44e9bcbc-c0c2-4d54-9c7b-2558508ad507","assistedApproval":{"recommendation":"approve","reason":"User authorized all five audit-fixture phases; this is an in-scope component example edit.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"44e9bcbc-c0c2-4d54-9c7b-2558508ad507"},"agentId":"78631379-5bbe-4a0d-a590-18491ff526c0","id":"d3ca9e61-0236-4748-bf38-8322b3cf9d46","timestamp":"2026-10-28T21:04:46.483Z","parentId":"0cd46fcf-f577-4ce9-8c82-0be6f37020c8"}
