\"../scripts/audit-accessibility.ts\"; @@ -test.each(records)(\"authors an explicit audit example for $name\", (record) => { +test.each([...records, ...PLUGIN_AUDIT_RECORDS])(\"authors an explicit audit example for $name\", (record) => { @@ - window.document.body.innerHTML = fences.map((match) => match[1]).join(\"\\n\"); + window.document.body.innerHTML = exampleHtml(example); @@ }); + +test.each(PLUGIN_AUDIT_RECORDS.filter((record) => + [\"banner\", \"button-set\", \"segmented-control\", \"skeleton-loader\"].includes(record.name), +))(\"covers every canonical visual modifier for the plugin $name\", (record) => { + const entry = parseCssDocs(record.rules(\"instui-\")).find((item) => item.name === record.name)!; + const markup = resolveExampleTargets(entry.examples).automatica11y + .map((index) => exampleHtml(entry.examples[index]!)) + .join(\"\\n\"); + const window = new Window(); + window.document.body.innerHTML = markup; + const classes = new Set( + [...window.document.querySelectorAll(\"[class]\")].flatMap((element) => [...element.classList]), + ); + for (const modifier of entry.modifiers) { + if (modifier.name.includes(\"*\") || modifier.description.includes(\"@alias\")) continue; + expect(classes.has(modifier.name), `${record.name}: ${modifier.name}`).toBe(true); + } + void window.happyDOM.abort(); +}); *** End Patch\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/declarations/focus/index.ts @@ - * <button class=\"instui-button -focus-color-danger\" data-a11y-root data-a11y-trigger>Delete</button> + * <button data-a11y-root data-a11y-trigger>Default focus</button> + * <button class=\"-focus-color-danger\">Danger focus</button> + * <button class=\"-focus-color-success\">Success focus</button> + * <div style=\"background: var(--instui-color-background-brand)\"> + * <button class=\"-focus-color-inverse\">Inverse focus</button> + * </div> + * <button class=\"-focus-position-inset\">Inset focus</button> + * <div class=\"-focus-within\"><button>Focus within</button></div> + * <button class=\"-without-focus-animation\">Focus without animation</button> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/ai-gradient/index.ts @@ - * <div class=\"--border-color-ai --border-radius-md --border-width-sm --p-md\"> - * AI-generated summary - * </div> + * <div class=\"--border-color-ai\">AI border</div> + * <div class=\"--border-color-ai-horizontal\">Horizontal AI border</div> + * <div class=\"--background-ai\">AI background</div> + * <div class=\"--background-ai-horizontal\">Horizontal AI background</div> + * <div dir=\"rtl\"> + * <div class=\"--border-color-ai-horizontal\">حدود الذكاء الاصطناعي</div> + * <div class=\"--background-ai-horizontal\">خلفية الذكاء الاصطناعي</div> + * </div> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/icon/icon.css @@ - * <button class=\"pfx-button\" data-a11y-root data-a11y-trigger> + * <button data-a11y-root data-a11y-trigger> @@ * </button> + * <span class=\"pfx-icon -icon-warning\" role=\"img\" aria-label=\"Warning\"></span> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/screen-reader-content/screen-reader-content.css @@ - * <a class=\"pfx-link\" href=\"#settings\" data-a11y-root data-a11y-trigger> - * <span class=\"pfx-icon -icon-settings\" aria-hidden=\"true\"></span> + * <bu… [truncated 176 chars]\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/ai-gradient/index.ts @@ - * <div class=\"--border-color-ai-horizontal\">حدود الذكاء الاصطناعي</div> - * <div class=\"--background-ai-horizontal\">خلفية الذكاء الاصطناعي</div> + * <div class=\"--border-color-ai-horizontal\">RTL AI border</div> + * <div class=\"--background-ai-horizontal\">RTL AI background</div> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/screen-reader-content/screen-reader-content.css @@ - * <span aria-hidden=\"true\">⚙</span> + * <span aria-hidden=\"true\">+</span> *** End Patch\n[tool rg -> success] args={\"pattern\":\"custom-components|readdirSync\\\\(.*assets\",\"paths\":\"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\",\"output_mode\":\"content\",\"-n\":true,\"-C\":3}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts @@ \"components/fonts.css\", + ...(item.record === \"logo\" ? [\"logos/canvas-horizontal-color.css\"] : []), @@ [\"plugins/pantoken/custom-components/dist\", \"custom-components\"], + [\"plugins/pantoken/logos/dist\", \"logos\"], *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts @@ expect(page).toContain(\"control.checkValidity()\"); + const logoPage = renderPage({ ...cases[0]!, record: \"logo\" }); + expect(logoPage).toContain('href=\"assets/logos/canvas-horizontal-color.css\"'); @@ \"plugins/pantoken/custom-components/dist\", + \"plugins/pantoken/logos/dist\", @@ \"interactions\", + \"logos\", *** End Patch\n[tool bash -> success] args={\"command\":\"vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate plugin fixtures and harness\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --help\",\"description\":\"Check changeset CLI options\",\"initial_wait\":60}\n[tool bash -> success] args={\"command\":\"cd formats/components && node --input-type=module -e 'import {parseCssDocs} from \\\"@cssdoc/core\\\"; import {PLUGIN_AUDIT_RECORDS} from \\\"./scripts/audit-plugin-components.ts\\\"; console.log(JSON.stringify(parseCssDocs(PLUGIN_AUDIT_RECORDS.find(x=>x.name===\\\"banner\\\").rules(\\\"instui-\\\")).find(x=>x.name===\\\"banner\\\").modifiers,null,2))'\",\"description\":\"Inspect parsed modifier alias metadata\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-examples.test.ts @@ - if (modifier.name.includes(\"*\") || modifier.description.includes(\"@alias\")) continue; + if (modifier.pattern || modifier.alias) continue; *** End Patch\n[tool write_agent -> success] args={\"agent_ids\":[\"049c1373-ecc6-4d66-bbea-f19e45c06453\",\"78631379-5bbe-4a0d-a590-18491ff526c0\",\"13128f82-ab9e-41de-a14e-bd6978da289e\"],\"message\":\"Parsed CssDocEntry.modifiers carries modifier.alias.canonical (not description @alias) and modifier.pattern. I'll add metadata-derived guard that requires canonical visual color/size/variant/state modifier classes on matching component roots, skipping aliases/patterns. Flag any intentional exceptions with rationale. Please ensure data-a11y roots/triggers remain where harness needs them; root identifiers should remain unique. Guard tests now normalize pfx before checking IDs/ARIA for plugin records too.\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md @@ member's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it. Use fenced HTML so audience flags remain metadata, not visible page content. +Keep one audit example per record, with distinct visual variants together: canonical colors, sizes, +and supported states. Don't duplicate deprecated aliases or build a Cartesian product of every +modifier. Include meaningful labels, selected and unselected choices, and native `disabled`, +`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface +for inverse/on-color treatments, without overriding the component's tested colors. Keep decorative +content hidden from assistive technology and preserve required parent/member structures. + +Stack independent cases in normal document flow instead of forcing a wide row. Expanded dialog +variants can use `open` so they remain measurable without one modal hiding the others. Static state +markup is not evidence that hover, keyboard interaction, focus movement, or announcements work: +those still need interaction checks and manual testing. Don't remove a supported variant or add a +fixture-only CSS fix to make the audit pass. + Run `vp run audit:components` from the repository root. It builds local styles and behavior bundles, *** End Patch\n[tool bash] args={\"command\":\"vp check --fix formats/components/tests/audit-examples.test.ts formats/components/scripts/audit-accessibility.ts formats/components/tests/audit-accessibility.test.ts formats/components/src/declarations/focus/index.ts formats/components/src/utilities/ai-gradient/index.ts plugins/pantoken/custom-components/src/components docs/conventions/authoring.md && vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate own plugin and utility changes\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --patch @pantoken/components,@pantoken/plugin-custom-components -m \\\"Expand accessibility audit examples to exercise distinct visual variants and native control states, with minimal component-owned markup.\\\"\",\"description\":\"Generate audit-fixture changeset\",\"initial_wait\":60}","copilot_cache_control":{"type":"ephemeral"}},{"content":"ALLOW: Authorized project fixture update; no mandatory exclusion is apparent.","refusal":null,"role":"assistant","reasoning_opaque":"REDACTED","reasoning_text":"","encrypted_content":"REDACTED","reasoningBlocks":{"provider":"openai-responses","blocks":[{"content":[],"encrypted_content":"REDACTED","id":"","summary":[],"type":"reasoning"}]},"responses_message_status":"completed","phase":"final_answer","serverTools":{"provider":"openai-responses"},"apiCallId":"","outputTokens":115,"providerId":"copilot"}]},"id":"1c3c26ef-820b-4183-8420-f6e8389df17b","timestamp":"2026-10-28T21:04:40.601Z","parentId":"692c31ab-3f16-4608-9c8d-1b7cb776239c"}
{"type":"permission.requested","data":{"requestId":"ceb495ee-cd2e-48e4-9b24-06092378ae63","permissionRequest":{"kind":"write","toolCallId":"custom_call_ngvomRbtB2rjzm9A2QcYoPdP","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css\n@@ -45,10 +45,38 @@\n  * @sealed\n  * @example -automatica11y\n  * ```html\n- * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n- * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n- * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n- * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n+ * <p class=\"pfx-text -size-xs\">Updated today.</p>\n+ * <p class=\"pfx-text -size-sm\">Last edited by Lee.</p>\n+ * <p class=\"pfx-text\">Your course is ready.</p>\n+ * <p class=\"pfx-text -size-lg\">Welcome to the course.</p>\n+ * <p class=\"pfx-text -size-xl\">Start learning today.</p>\n+ * <p class=\"pfx-text -color-primary\">Required reading.</p>\n+ * <p class=\"pfx-text -color-secondary\">Optional reading.</p>\n+ * <p class=\"pfx-text -color-brand\">Course overview.</p>\n+ * <p class=\"pfx-text -color-success\">Submission received.</p>\n+ * <p class=\"pfx-text -color-warning\">The deadline is approaching.</p>\n+ * <p class=\"pfx-text -color-danger\">The upload failed.</p>\n+ * <p class=\"pfx-text -color-ai-highlight\">Suggested summary.</p>\n+ * <div class=\"--bg-inverse --p-md\">\n+ *   <p class=\"pfx-text -color-primary-inverse\">Course announcement.</p>\n+ *   <p class=\"pfx-text -color-secondary-inverse\">Posted this morning.</p>\n+ * </div>\n+ * <div class=\"--bg-brand --p-md\">\n+ *   <p class=\"pfx-text -color-primary-on\">Enrollment is open.</p>\n+ *   <p class=\"pfx-text -color-secondary-on\">Choose your next course.</p>\n+ * </div>\n+ * <p class=\"pfx-text -weight-bold\"><strong>Save before leaving.</strong></p>\n+ * <p class=\"pfx-text -style-italic\"><em>Please review your answers.</em></p>\n+ * <p class=\"pfx-text -transform-uppercase\">New lesson</p>\n+ * <p class=\"pfx-text -transform-lowercase\">COURSE NOTES</p>\n+ * <p class=\"pfx-text -transform-capitalize\">weekly reading list</p>\n+ * <p class=\"pfx-text -variant-description-page\">Explore the course materials.</p>\n+ * <p class=\"pfx-text -variant-description-section\">Read this week's notes.</p>\n+ * <p class=\"pfx-text -variant-content\">The lesson begins with a short introduction.</p>\n+ * <p class=\"pfx-text -variant-content-important\"><strong>Bring your notes.</strong></p>\n+ * <blockquote class=\"pfx-text -variant-content-quote\">Learning takes practice.</blockquote>\n+ * <p class=\"pfx-text -variant-content-small\">Updated on Monday.</p>\n+ * <p class=\"pfx-text -variant-legend\">Figure 1: Course timeline.</p>\n  * ```\n  */\n @scope (.pfx-text) {\n","newFileContents":"/**\n * @component text\n * @selector .pfx-text\n * @a11y It sets appearance only and renders no semantics, so use `<p>`, `<strong>`, `<em>`, and similar elements for meaning, and check contrast of each `-color-*` against its background, especially the inverse colors.\n * @summary Body-text typography with size, weight, colour, and style modifiers.\n * @remarks The `-variant-*` presets and the `-color-*`/`-size-*`/`-weight-*` modifiers all compose on the same element; unlike `heading`, it renders no implicit semantic level.\n * @modifier -color-brand — Brand text colour.\n * @modifier -color-secondary — Secondary (muted) text colour.\n * @modifier -color-ai — @deprecated {@link -color-ai-highlight}\n * @modifier -color-ai-highlight — AI-accent text colour with background highlight.\n * @modifier -color-success — Success text colour.\n * @modifier -color-warning — Warning text colour.\n * @modifier -color-danger — Danger text colour.\n * @modifier -color-primary — Primary text colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) text colour.\n * @modifier -color-secondary-inverse — On-dark (secondary inverse) text colour.\n * @modifier -color-secondary-on — Secondary text colour on a coloured background.\n * @modifier -color-primary-on — Primary text colour on a coloured background.\n * @modifier -weight-bold — Bold weight.\n * @modifier -style-italic — Italic.\n * @modifier -transform-uppercase — Uppercase the text.\n * @modifier -transform-lowercase — Lowercase the text.\n * @modifier -transform-capitalize — Capitalise each word.\n * @modifier -variant-description-page — Page-description type preset.\n * @modifier -variant-description-section — Section-description type preset.\n * @modifier -variant-content — Content type preset.\n * @modifier -variant-content-important — Important-content type preset.\n * @modifier -variant-content-quote — Quote-content type preset.\n * @modifier -variant-content-small — Small-content type preset.\n * @modifier -variant-legend — Legend type preset.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -size-xl — Extra large.\n * @example -canvas-rce -docs\n * ```html\n * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n * ```\n * @related heading — Typography for headings rather than body text.\n * @related truncate — Clips this text to one line or a set number of lines.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <p class=\"pfx-text -size-xs\">Updated today.</p>\n * <p class=\"pfx-text -size-sm\">Last edited by Lee.</p>\n * <p class=\"pfx-text\">Your course is ready.</p>\n * <p class=\"pfx-text -size-lg\">Welcome to the course.</p>\n * <p class=\"pfx-text -size-xl\">Start learning today.</p>\n * <p class=\"pfx-text -color-primary\">Required reading.</p>\n * <p class=\"pfx-text -color-secondary\">Optional reading.</p>\n * <p class=\"pfx-text -color-brand\">Course overview.</p>\n * <p class=\"pfx-text -color-success\">Submission received.</p>\n * <p class=\"pfx-text -color-warning\">The deadline is approaching.</p>\n * <p class=\"pfx-text -color-danger\">The upload failed.</p>\n * <p class=\"pfx-text -color-ai-highlight\">Suggested summary.</p>\n * <div class=\"--bg-inverse --p-md\">\n *   <p class=\"pfx-text -color-primary-inverse\">Course announcement.</p>\n *   <p class=\"pfx-text -color-secondary-inverse\">Posted this morning.</p>\n * </div>\n * <div class=\"--bg-brand --p-md\">\n *   <p class=\"pfx-text -color-primary-on\">Enrollment is open.</p>\n *   <p class=\"pfx-text -color-secondary-on\">Choose your next course.</p>\n * </div>\n * <p class=\"pfx-text -weight-bold\"><strong>Save before leaving.</strong></p>\n * <p class=\"pfx-text -style-italic\"><em>Please review your answers.</em></p>\n * <p class=\"pfx-text -transform-uppercase\">New lesson</p>\n * <p class=\"pfx-text -transform-lowercase\">COURSE NOTES</p>\n * <p class=\"pfx-text -transform-capitalize\">weekly reading list</p>\n * <p class=\"pfx-text -variant-description-page\">Explore the course materials.</p>\n * <p class=\"pfx-text -variant-description-section\">Read this week's notes.</p>\n * <p class=\"pfx-text -variant-content\">The lesson begins with a short introduction.</p>\n * <p class=\"pfx-text -variant-content-important\"><strong>Bring your notes.</strong></p>\n * <blockquote class=\"pfx-text -variant-content-quote\">Learning takes practice.</blockquote>\n * <p class=\"pfx-text -variant-content-small\">Updated on Monday.</p>\n * <p class=\"pfx-text -variant-legend\">Figure 1: Course timeline.</p>\n * ```\n */\n@scope (.pfx-text) {\n  & {\n    font-family: var(--instui-component-text-content-font-family);\n    color: var(--instui-component-text-base-color);\n    font-size: var(--instui-component-text-font-size-medium);\n    font-weight: var(--instui-component-text-font-weight-normal);\n    line-height: var(--instui-component-text-content-line-height);\n  }\n\n  &.-size-xs {\n    font-size: var(--instui-component-text-font-size-x-small);\n  }\n\n  &.-size-sm {\n    font-size: var(--instui-component-text-font-size-small);\n  }\n\n  &.-size-lg {\n    font-size: var(--instui-component-text-font-size-large);\n  }\n\n  &.-size-xl {\n    font-size: var(--instui-component-text-font-size-x-large);\n  }\n\n  &.-weight-bold {\n    font-weight: var(--instui-component-text-font-weight-bold);\n  }\n\n  &.-style-italic {\n    font-style: italic;\n  }\n\n  &.-color-primary {\n    color: var(--instui-component-text-primary-color);\n  }\n\n  &.-color-secondary {\n    color: var(--instui-component-text-muted-color);\n  }\n\n  &.-color-brand {\n    color: light-dark(\n      var(--instui-color-institutional-brand-primary),\n      var(--instui-color-institutional-brand-font-color-dark)\n    );\n  }\n\n  &.-color-success {\n    color: var(--instui-component-text-success-color);\n  }\n\n  &.-color-danger {\n    color: var(--instui-component-text-error-color);\n  }\n\n  &.-color-warning {\n    color: var(--instui-component-text-warning-color);\n  }\n\n  &:is(.-color-ai-highlight, .-color-ai) {\n    color: var(--instui-component-text-ai-color);\n    background: var(--instui-component-text-ai-background-color);\n  }\n\n  &.-color-primary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-secondary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-primary-on {\n    color: var(--instui-component-text-base-on-color);\n  }\n\n  &.-color-secondary-on {\n    color: var(--instui-component-text-muted-on-color);\n  }\n\n  &.-variant-description-page {\n    font-size: var(--instui-component-text-description-page-font-size);\n    font-weight: var(--instui-component-text-description-page-font-weight);\n    line-height: var(--instui-component-text-description-page-line-height);\n  }\n\n  &.-variant-description-section {\n    font-size: var(--instui-component-text-description-section-font-size);\n    font-weight: var(--instui-component-text-description-section-font-weight);\n    line-height: var(--instui-component-text-description-section-line-height);\n  }\n\n  &.-variant-content {\n    font-size: var(--instui-component-text-content-font-size);\n    line-height: var(--instui-component-text-content-line-height);\n    font-weight: var(--instui-component-text-content-font-weight);\n  }\n\n  &.-variant-content-small {\n    font-size: var(--instui-component-text-content-small-font-size);\n    font-weight: var(--instui-component-text-content-small-font-weight);\n    line-height: var(--instui-component-text-content-small-line-height);\n  }\n\n  &.-variant-content-important {\n    font-size: var(--instui-component-text-content-important-font-size);\n    line-height: var(--instui-component-text-content-important-line-height);\n    font-weight: var(--instui-component-text-content-important-font-weight);\n  }\n\n  &.-variant-content-quote {\n    font-size: var(--instui-component-text-content-quote-font-size);\n    font-weight: var(--instui-component-text-content-quote-font-weight);\n    font-style: var(--instui-component-text-content-quote-font-style);\n    line-height: var(--instui-component-text-content-quote-line-height);\n  }\n\n  &.-variant-legend {\n    font-size: var(--instui-component-text-legend-font-size);\n    line-height: var(--instui-component-text-legend-line-height);\n    font-weight: var(--instui-component-text-legend-font-weight);\n  }\n\n  &.-transform-uppercase {\n    text-transform: uppercase;\n  }\n\n  &.-transform-lowercase {\n    text-transform: lowercase;\n  }\n\n  &.-transform-capitalize {\n    text-transform: capitalize;\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css","content":"/**\n * @component text\n * @selector .pfx-text\n * @a11y It sets appearance only and renders no semantics, so use `<p>`, `<strong>`, `<em>`, and similar elements for meaning, and check contrast of each `-color-*` against its background, especially the inverse colors.\n * @summary Body-text typography with size, weight, colour, and style modifiers.\n * @remarks The `-variant-*` presets and the `-color-*`/`-size-*`/`-weight-*` modifiers all compose on the same element; unlike `heading`, it renders no implicit semantic level.\n * @modifier -color-brand — Brand text colour.\n * @modifier -color-secondary — Secondary (muted) text colour.\n * @modifier -color-ai — @deprecated {@link -color-ai-highlight}\n * @modifier -color-ai-highlight — AI-accent text colour with background highlight.\n * @modifier -color-success — Success text colour.\n * @modifier -color-warning — Warning text colour.\n * @modifier -color-danger — Danger text colour.\n * @modifier -color-primary — Primary text colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) text colour.\n * @modifier -color-secondary-inverse — On-dark (secondary inverse) text colour.\n * @modifier -color-secondary-on — Secondary text colour on a coloured background.\n * @modifier -color-primary-on — Primary text colour on a coloured background.\n * @modifier -weight-bold — Bold weight.\n * @modifier -style-italic — Italic.\n * @modifier -transform-uppercase — Uppercase the text.\n * @modifier -transform-lowercase — Lowercase the text.\n * @modifier -transform-capitalize — Capitalise each word.\n * @modifier -variant-description-page — Page-description type preset.\n * @modifier -variant-description-section — Section-description type preset.\n * @modifier -variant-content — Content type preset.\n * @modifier -variant-content-important — Important-content type preset.\n * @modifier -variant-content-quote — Quote-content type preset.\n * @modifier -variant-content-small — Small-content type preset.\n * @modifier -variant-legend — Legend type preset.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -size-xl — Extra large.\n * @example -canvas-rce -docs\n * ```html\n * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n * ```\n * @related heading — Typography for headings rather than body text.\n * @related truncate — Clips this text to one line or a set number of lines.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n * ```\n */\n@scope (.pfx-text) {\n  & {\n    font-family: var(--instui-component-text-content-font-family);\n    color: var(--instui-component-text-base-color);\n    font-size: var(--instui-component-text-font-size-medium);\n    font-weight: var(--instui-component-text-font-weight-normal);\n    line-height: var(--instui-component-text-content-line-height);\n  }\n\n  &.-size-xs {\n    font-size: var(--instui-component-text-font-size-x-small);\n  }\n\n  &.-size-sm {\n    font-size: var(--instui-component-text-font-size-small);\n  }\n\n  &.-size-lg {\n    font-size: var(--instui-component-text-font-size-large);\n  }\n\n  &.-size-xl {\n    font-size: var(--instui-component-text-font-size-x-large);\n  }\n\n  &.-weight-bold {\n    font-weight: var(--instui-component-text-font-weight-bold);\n  }\n\n  &.-style-italic {\n    font-style: italic;\n  }\n\n  &.-color-primary {\n    color: var(--instui-component-text-primary-color);\n  }\n\n  &.-color-secondary {\n    color: var(--instui-component-text-muted-color);\n  }\n\n  &.-color-brand {\n    color: light-dark(\n      var(--instui-color-institutional-brand-primary),\n      var(--instui-color-institutional-brand-font-color-dark)\n    );\n  }\n\n  &.-color-success {\n    color: var(--instui-component-text-success-color);\n  }\n\n  &.-color-danger {\n    color: var(--instui-component-text-error-color);\n  }\n\n  &.-color-warning {\n    color: var(--instui-component-text-warning-color);\n  }\n\n  &:is(.-color-ai-highlight, .-color-ai) {\n    color: var(--instui-component-text-ai-color);\n    background: var(--instui-component-text-ai-background-color);\n  }\n\n  &.-color-primary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-secondary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-primary-on {\n    color: var(--instui-component-text-base-on-color);\n  }\n\n  &.-color-secondary-on {\n    color: var(--instui-component-text-muted-on-color);\n  }\n\n  &.-variant-description-page {\n    font-size: var(--instui-component-text-description-page-font-size);\n    font-weight: var(--instui-component-text-description-page-font-weight);\n    line-height: var(--instui-component-text-description-page-line-height);\n  }\n\n  &.-variant-description-section {\n    font-size: var(--instui-component-text-description-section-font-size);\n    font-weight: var(--instui-component-text-description-section-font-weight);\n    line-height: var(--instui-component-text-description-section-line-height);\n  }\n\n  &.-variant-content {\n    font-size: var(--instui-component-text-content-font-size);\n    line-height: var(--instui-component-text-content-line-height);\n    font-weight: var(--instui-component-text-content-font-weight);\n  }\n\n  &.-variant-content-small {\n    font-size: var(--instui-component-text-content-small-font-size);\n    font-weight: var(--instui-component-text-content-small-font-weight);\n    line-height: var(--instui-component-text-content-small-line-height);\n  }\n\n  &.-variant-content-important {\n    font-size: var(--instui-component-text-content-important-font-size);\n    line-height: var(--instui-component-text-content-important-line-height);\n    font-weight: var(--instui-component-text-content-important-font-weight);\n  }\n\n  &.-variant-content-quote {\n    font-size: var(--instui-component-text-content-quote-font-size);\n    font-weight: var(--instui-component-text-content-quote-font-weight);\n    font-style: var(--instui-component-text-content-quote-font-style);\n    line-height: var(--instui-component-text-content-quote-line-height);\n  }\n\n  &.-variant-legend {\n    font-size: var(--instui-component-text-legend-font-size);\n    line-height: var(--instui-component-text-legend-line-height);\n    font-weight: var(--instui-component-text-legend-font-weight);\n  }\n\n  &.-transform-uppercase {\n    text-transform: uppercase;\n  }\n\n  &.-transform-lowercase {\n    text-transform: lowercase;\n  }\n\n  &.-transform-capitalize {\n    text-transform: capitalize;\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css","content":"/**\n * @component text\n * @selector .pfx-text\n * @a11y It sets appearance only and renders no semantics, so use `<p>`, `<strong>`, `<em>`, and similar elements for meaning, and check contrast of each `-color-*` against its background, especially the inverse colors.\n * @summary Body-text typography with size, weight, colour, and style modifiers.\n * @remarks The `-variant-*` presets and the `-color-*`/`-size-*`/`-weight-*` modifiers all compose on the same element; unlike `heading`, it renders no implicit semantic level.\n * @modifier -color-brand — Brand text colour.\n * @modifier -color-secondary — Secondary (muted) text colour.\n * @modifier -color-ai — @deprecated {@link -color-ai-highlight}\n * @modifier -color-ai-highlight — AI-accent text colour with background highlight.\n * @modifier -color-success — Success text colour.\n * @modifier -color-warning — Warning text colour.\n * @modifier -color-danger — Danger text colour.\n * @modifier -color-primary — Primary text colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) text colour.\n * @modifier -color-secondary-inverse — On-dark (secondary inverse) text colour.\n * @modifier -color-secondary-on — Secondary text colour on a coloured background.\n * @modifier -color-primary-on — Primary text colour on a coloured background.\n * @modifier -weight-bold — Bold weight.\n * @modifier -style-italic — Italic.\n * @modifier -transform-uppercase — Uppercase the text.\n * @modifier -transform-lowercase — Lowercase the text.\n * @modifier -transform-capitalize — Capitalise each word.\n * @modifier -variant-description-page — Page-description type preset.\n * @modifier -variant-description-section — Section-description type preset.\n * @modifier -variant-content — Content type preset.\n * @modifier -variant-content-important — Important-content type preset.\n * @modifier -variant-content-quote — Quote-content type preset.\n * @modifier -variant-content-small — Small-content type preset.\n * @modifier -variant-legend — Legend type preset.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -size-xl — Extra large.\n * @example -canvas-rce -docs\n * ```html\n * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n * ```\n * @related heading — Typography for headings rather than body text.\n * @related truncate — Clips this text to one line or a set number of lines.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <p class=\"pfx-text -size-xs\">Updated today.</p>\n * <p class=\"pfx-text -size-sm\">Last edited by Lee.</p>\n * <p class=\"pfx-text\">Your course is ready.</p>\n * <p class=\"pfx-text -size-lg\">Welcome to the course.</p>\n * <p class=\"pfx-text -size-xl\">Start learning today.</p>\n * <p class=\"pfx-text -color-primary\">Required reading.</p>\n * <p class=\"pfx-text -color-secondary\">Optional reading.</p>\n * <p class=\"pfx-text -color-brand\">Course overview.</p>\n * <p class=\"pfx-text -color-success\">Submission received.</p>\n * <p class=\"pfx-text -color-warning\">The deadline is approaching.</p>\n * <p class=\"pfx-text -color-danger\">The upload failed.</p>\n * <p class=\"pfx-text -color-ai-highlight\">Suggested summary.</p>\n * <div class=\"--bg-inverse --p-md\">\n *   <p class=\"pfx-text -color-primary-inverse\">Course announcement.</p>\n *   <p class=\"pfx-text -color-secondary-inverse\">Posted this morning.</p>\n * </div>\n * <div class=\"--bg-brand --p-md\">\n *   <p class=\"pfx-text -color-primary-on\">Enrollment is open.</p>\n *   <p class=\"pfx-text -color-secondary-on\">Choose your next course.</p>\n * </div>\n * <p class=\"pfx-text -weight-bold\"><strong>Save before leaving.</strong></p>\n * <p class=\"pfx-text -style-italic\"><em>Please review your answers.</em></p>\n * <p class=\"pfx-text -transform-uppercase\">New lesson</p>\n * <p class=\"pfx-text -transform-lowercase\">COURSE NOTES</p>\n * <p class=\"pfx-text -transform-capitalize\">weekly reading list</p>\n * <p class=\"pfx-text -variant-description-page\">Explore the course materials.</p>\n * <p class=\"pfx-text -variant-description-section\">Read this week's notes.</p>\n * <p class=\"pfx-text -variant-content\">The lesson begins with a short introduction.</p>\n * <p class=\"pfx-text -variant-content-important\"><strong>Bring your notes.</strong></p>\n * <blockquote class=\"pfx-text -variant-content-quote\">Learning takes practice.</blockquote>\n * <p class=\"pfx-text -variant-content-small\">Updated on Monday.</p>\n * <p class=\"pfx-text -variant-legend\">Figure 1: Course timeline.</p>\n * ```\n */\n@scope (.pfx-text) {\n  & {\n    font-family: var(--instui-component-text-content-font-family);\n    color: var(--instui-component-text-base-color);\n    font-size: var(--instui-component-text-font-size-medium);\n    font-weight: var(--instui-component-text-font-weight-normal);\n    line-height: var(--instui-component-text-content-line-height);\n  }\n\n  &.-size-xs {\n    font-size: var(--instui-component-text-font-size-x-small);\n  }\n\n  &.-size-sm {\n    font-size: var(--instui-component-text-font-size-small);\n  }\n\n  &.-size-lg {\n    font-size: var(--instui-component-text-font-size-large);\n  }\n\n  &.-size-xl {\n    font-size: var(--instui-component-text-font-size-x-large);\n  }\n\n  &.-weight-bold {\n    font-weight: var(--instui-component-text-font-weight-bold);\n  }\n\n  &.-style-italic {\n    font-style: italic;\n  }\n\n  &.-color-primary {\n    color: var(--instui-component-text-primary-color);\n  }\n\n  &.-color-secondary {\n    color: var(--instui-component-text-muted-color);\n  }\n\n  &.-color-brand {\n    color: light-dark(\n      var(--instui-color-institutional-brand-primary),\n      var(--instui-color-institutional-brand-font-color-dark)\n    );\n  }\n\n  &.-color-success {\n    color: var(--instui-component-text-success-color);\n  }\n\n  &.-color-danger {\n    color: var(--instui-component-text-error-color);\n  }\n\n  &.-color-warning {\n    color: var(--instui-component-text-warning-color);\n  }\n\n  &:is(.-color-ai-highlight, .-color-ai) {\n    color: var(--instui-component-text-ai-color);\n    background: var(--instui-component-text-ai-background-color);\n  }\n\n  &.-color-primary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-secondary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-primary-on {\n    color: var(--instui-component-text-base-on-color);\n  }\n\n  &.-color-secondary-on {\n    color: var(--instui-component-text-muted-on-color);\n  }\n\n  &.-variant-description-page {\n    font-size: var(--instui-component-text-description-page-font-size);\n    font-weight: var(--instui-component-text-description-page-font-weight);\n    line-height: var(--instui-component-text-description-page-line-height);\n  }\n\n  &.-variant-description-section {\n    font-size: var(--instui-component-text-description-section-font-size);\n    font-weight: var(--instui-component-text-description-section-font-weight);\n    line-height: var(--instui-component-text-description-section-line-height);\n  }\n\n  &.-variant-content {\n    font-size: var(--instui-component-text-content-font-size);\n    line-height: var(--instui-component-text-content-line-height);\n    font-weight: var(--instui-component-text-content-font-weight);\n  }\n\n  &.-variant-content-small {\n    font-size: var(--instui-component-text-content-small-font-size);\n    font-weight: var(--instui-component-text-content-small-font-weight);\n    line-height: var(--instui-component-text-content-small-line-height);\n  }\n\n  &.-variant-content-important {\n    font-size: var(--instui-component-text-content-important-font-size);\n    line-height: var(--instui-component-text-content-important-line-height);\n    font-weight: var(--instui-component-text-content-important-font-weight);\n  }\n\n  &.-variant-content-quote {\n    font-size: var(--instui-component-text-content-quote-font-size);\n    font-weight: var(--instui-component-text-content-quote-font-weight);\n    font-style: var(--instui-component-text-content-quote-font-style);\n    line-height: var(--instui-component-text-content-quote-line-height);\n  }\n\n  &.-variant-legend {\n    font-size: var(--instui-component-text-legend-font-size);\n    line-height: var(--instui-component-text-legend-line-height);\n    font-weight: var(--instui-component-text-legend-font-weight);\n  }\n\n  &.-transform-uppercase {\n    text-transform: uppercase;\n  }\n\n  &.-transform-lowercase {\n    text-transform: lowercase;\n  }\n\n  &.-transform-capitalize {\n    text-transform: capitalize;\n  }\n}\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_ngvomRbtB2rjzm9A2QcYoPdP","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css\n@@ -45,10 +45,38 @@\n  * @sealed\n  * @example -automatica11y\n  * ```html\n- * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n- * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n- * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n- * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n+ * <p class=\"pfx-text -size-xs\">Updated today.</p>\n+ * <p class=\"pfx-text -size-sm\">Last edited by Lee.</p>\n+ * <p class=\"pfx-text\">Your course is ready.</p>\n+ * <p class=\"pfx-text -size-lg\">Welcome to the course.</p>\n+ * <p class=\"pfx-text -size-xl\">Start learning today.</p>\n+ * <p class=\"pfx-text -color-primary\">Required reading.</p>\n+ * <p class=\"pfx-text -color-secondary\">Optional reading.</p>\n+ * <p class=\"pfx-text -color-brand\">Course overview.</p>\n+ * <p class=\"pfx-text -color-success\">Submission received.</p>\n+ * <p class=\"pfx-text -color-warning\">The deadline is approaching.</p>\n+ * <p class=\"pfx-text -color-danger\">The upload failed.</p>\n+ * <p class=\"pfx-text -color-ai-highlight\">Suggested summary.</p>\n+ * <div class=\"--bg-inverse --p-md\">\n+ *   <p class=\"pfx-text -color-primary-inverse\">Course announcement.</p>\n+ *   <p class=\"pfx-text -color-secondary-inverse\">Posted this morning.</p>\n+ * </div>\n+ * <div class=\"--bg-brand --p-md\">\n+ *   <p class=\"pfx-text -color-primary-on\">Enrollment is open.</p>\n+ *   <p class=\"pfx-text -color-secondary-on\">Choose your next course.</p>\n+ * </div>\n+ * <p class=\"pfx-text -weight-bold\"><strong>Save before leaving.</strong></p>\n+ * <p class=\"pfx-text -style-italic\"><em>Please review your answers.</em></p>\n+ * <p class=\"pfx-text -transform-uppercase\">New lesson</p>\n+ * <p class=\"pfx-text -transform-lowercase\">COURSE NOTES</p>\n+ * <p class=\"pfx-text -transform-capitalize\">weekly reading list</p>\n+ * <p class=\"pfx-text -variant-description-page\">Explore the course materials.</p>\n+ * <p class=\"pfx-text -variant-description-section\">Read this week's notes.</p>\n+ * <p class=\"pfx-text -variant-content\">The lesson begins with a short introduction.</p>\n+ * <p class=\"pfx-text -variant-content-important\"><strong>Bring your notes.</strong></p>\n+ * <blockquote class=\"pfx-text -variant-content-quote\">Learning takes practice.</blockquote>\n+ * <p class=\"pfx-text -variant-content-small\">Updated on Monday.</p>\n+ * <p class=\"pfx-text -variant-legend\">Figure 1: Course timeline.</p>\n  * ```\n  */\n @scope (.pfx-text) {\n","newFileContents":"/**\n * @component text\n * @selector .pfx-text\n * @a11y It sets appearance only and renders no semantics, so use `<p>`, `<strong>`, `<em>`, and similar elements for meaning, and check contrast of each `-color-*` against its background, especially the inverse colors.\n * @summary Body-text typography with size, weight, colour, and style modifiers.\n * @remarks The `-variant-*` presets and the `-color-*`/`-size-*`/`-weight-*` modifiers all compose on the same element; unlike `heading`, it renders no implicit semantic level.\n * @modifier -color-brand — Brand text colour.\n * @modifier -color-secondary — Secondary (muted) text colour.\n * @modifier -color-ai — @deprecated {@link -color-ai-highlight}\n * @modifier -color-ai-highlight — AI-accent text colour with background highlight.\n * @modifier -color-success — Success text colour.\n * @modifier -color-warning — Warning text colour.\n * @modifier -color-danger — Danger text colour.\n * @modifier -color-primary — Primary text colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) text colour.\n * @modifier -color-secondary-inverse — On-dark (secondary inverse) text colour.\n * @modifier -color-secondary-on — Secondary text colour on a coloured background.\n * @modifier -color-primary-on — Primary text colour on a coloured background.\n * @modifier -weight-bold — Bold weight.\n * @modifier -style-italic — Italic.\n * @modifier -transform-uppercase — Uppercase the text.\n * @modifier -transform-lowercase — Lowercase the text.\n * @modifier -transform-capitalize — Capitalise each word.\n * @modifier -variant-description-page — Page-description type preset.\n * @modifier -variant-description-section — Section-description type preset.\n * @modifier -variant-content — Content type preset.\n * @modifier -variant-content-important — Important-content type preset.\n * @modifier -variant-content-quote — Quote-content type preset.\n * @modifier -variant-content-small — Small-content type preset.\n * @modifier -variant-legend — Legend type preset.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -size-xl — Extra large.\n * @example -canvas-rce -docs\n * ```html\n * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n * ```\n * @related heading — Typography for headings rather than body text.\n * @related truncate — Clips this text to one line or a set number of lines.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <p class=\"pfx-text -size-xs\">Updated today.</p>\n * <p class=\"pfx-text -size-sm\">Last edited by Lee.</p>\n * <p class=\"pfx-text\">Your course is ready.</p>\n * <p class=\"pfx-text -size-lg\">Welcome to the course.</p>\n * <p class=\"pfx-text -size-xl\">Start learning today.</p>\n * <p class=\"pfx-text -color-primary\">Required reading.</p>\n * <p class=\"pfx-text -color-secondary\">Optional reading.</p>\n * <p class=\"pfx-text -color-brand\">Course overview.</p>\n * <p class=\"pfx-text -color-success\">Submission received.</p>\n * <p class=\"pfx-text -color-warning\">The deadline is approaching.</p>\n * <p class=\"pfx-text -color-danger\">The upload failed.</p>\n * <p class=\"pfx-text -color-ai-highlight\">Suggested summary.</p>\n * <div class=\"--bg-inverse --p-md\">\n *   <p class=\"pfx-text -color-primary-inverse\">Course announcement.</p>\n *   <p class=\"pfx-text -color-secondary-inverse\">Posted this morning.</p>\n * </div>\n * <div class=\"--bg-brand --p-md\">\n *   <p class=\"pfx-text -color-primary-on\">Enrollment is open.</p>\n *   <p class=\"pfx-text -color-secondary-on\">Choose your next course.</p>\n * </div>\n * <p class=\"pfx-text -weight-bold\"><strong>Save before leaving.</strong></p>\n * <p class=\"pfx-text -style-italic\"><em>Please review your answers.</em></p>\n * <p class=\"pfx-text -transform-uppercase\">New lesson</p>\n * <p class=\"pfx-text -transform-lowercase\">COURSE NOTES</p>\n * <p class=\"pfx-text -transform-capitalize\">weekly reading list</p>\n * <p class=\"pfx-text -variant-description-page\">Explore the course materials.</p>\n * <p class=\"pfx-text -variant-description-section\">Read this week's notes.</p>\n * <p class=\"pfx-text -variant-content\">The lesson begins with a short introduction.</p>\n * <p class=\"pfx-text -variant-content-important\"><strong>Bring your notes.</strong></p>\n * <blockquote class=\"pfx-text -variant-content-quote\">Learning takes practice.</blockquote>\n * <p class=\"pfx-text -variant-content-small\">Updated on Monday.</p>\n * <p class=\"pfx-text -variant-legend\">Figure 1: Course timeline.</p>\n * ```\n */\n@scope (.pfx-text) {\n  & {\n    font-family: var(--instui-component-text-content-font-family);\n    color: var(--instui-component-text-base-color);\n    font-size: var(--instui-component-text-font-size-medium);\n    font-weight: var(--instui-component-text-font-weight-normal);\n    line-height: var(--instui-component-text-content-line-height);\n  }\n\n  &.-size-xs {\n    font-size: var(--instui-component-text-font-size-x-small);\n  }\n\n  &.-size-sm {\n    font-size: var(--instui-component-text-font-size-small);\n  }\n\n  &.-size-lg {\n    font-size: var(--instui-component-text-font-size-large);\n  }\n\n  &.-size-xl {\n    font-size: var(--instui-component-text-font-size-x-large);\n  }\n\n  &.-weight-bold {\n    font-weight: var(--instui-component-text-font-weight-bold);\n  }\n\n  &.-style-italic {\n    font-style: italic;\n  }\n\n  &.-color-primary {\n    color: var(--instui-component-text-primary-color);\n  }\n\n  &.-color-secondary {\n    color: var(--instui-component-text-muted-color);\n  }\n\n  &.-color-brand {\n    color: light-dark(\n      var(--instui-color-institutional-brand-primary),\n      var(--instui-color-institutional-brand-font-color-dark)\n    );\n  }\n\n  &.-color-success {\n    color: var(--instui-component-text-success-color);\n  }\n\n  &.-color-danger {\n    color: var(--instui-component-text-error-color);\n  }\n\n  &.-color-warning {\n    color: var(--instui-component-text-warning-color);\n  }\n\n  &:is(.-color-ai-highlight, .-color-ai) {\n    color: var(--instui-component-text-ai-color);\n    background: var(--instui-component-text-ai-background-color);\n  }\n\n  &.-color-primary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-secondary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-primary-on {\n    color: var(--instui-component-text-base-on-color);\n  }\n\n  &.-color-secondary-on {\n    color: var(--instui-component-text-muted-on-color);\n  }\n\n  &.-variant-description-page {\n    font-size: var(--instui-component-text-description-page-font-size);\n    font-weight: var(--instui-component-text-description-page-font-weight);\n    line-height: var(--instui-component-text-description-page-line-height);\n  }\n\n  &.-variant-description-section {\n    font-size: var(--instui-component-text-description-section-font-size);\n    font-weight: var(--instui-component-text-description-section-font-weight);\n    line-height: var(--instui-component-text-description-section-line-height);\n  }\n\n  &.-variant-content {\n    font-size: var(--instui-component-text-content-font-size);\n    line-height: var(--instui-component-text-content-line-height);\n    font-weight: var(--instui-component-text-content-font-weight);\n  }\n\n  &.-variant-content-small {\n    font-size: var(--instui-component-text-content-small-font-size);\n    font-weight: var(--instui-component-text-content-small-font-weight);\n    line-height: var(--instui-component-text-content-small-line-height);\n  }\n\n  &.-variant-content-important {\n    font-size: var(--instui-component-text-content-important-font-size);\n    line-height: var(--instui-component-text-content-important-line-height);\n    font-weight: var(--instui-component-text-content-important-font-weight);\n  }\n\n  &.-variant-content-quote {\n    font-size: var(--instui-component-text-content-quote-font-size);\n    font-weight: var(--instui-component-text-content-quote-font-weight);\n    font-style: var(--instui-component-text-content-quote-font-style);\n    line-height: var(--instui-component-text-content-quote-line-height);\n  }\n\n  &.-variant-legend {\n    font-size: var(--instui-component-text-legend-font-size);\n    line-height: var(--instui-component-text-legend-line-height);\n    font-weight: var(--instui-component-text-legend-font-weight);\n  }\n\n  &.-transform-uppercase {\n    text-transform: uppercase;\n  }\n\n  &.-transform-lowercase {\n    text-transform: lowercase;\n  }\n\n  &.-transform-capitalize {\n    text-transform: capitalize;\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css","content":"/**\n * @component text\n * @selector .pfx-text\n * @a11y It sets appearance only and renders no semantics, so use `<p>`, `<strong>`, `<em>`, and similar elements for meaning, and check contrast of each `-color-*` against its background, especially the inverse colors.\n * @summary Body-text typography with size, weight, colour, and style modifiers.\n * @remarks The `-variant-*` presets and the `-color-*`/`-size-*`/`-weight-*` modifiers all compose on the same element; unlike `heading`, it renders no implicit semantic level.\n * @modifier -color-brand — Brand text colour.\n * @modifier -color-secondary — Secondary (muted) text colour.\n * @modifier -color-ai — @deprecated {@link -color-ai-highlight}\n * @modifier -color-ai-highlight — AI-accent text colour with background highlight.\n * @modifier -color-success — Success text colour.\n * @modifier -color-warning — Warning text colour.\n * @modifier -color-danger — Danger text colour.\n * @modifier -color-primary — Primary text colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) text colour.\n * @modifier -color-secondary-inverse — On-dark (secondary inverse) text colour.\n * @modifier -color-secondary-on — Secondary text colour on a coloured background.\n * @modifier -color-primary-on — Primary text colour on a coloured background.\n * @modifier -weight-bold — Bold weight.\n * @modifier -style-italic — Italic.\n * @modifier -transform-uppercase — Uppercase the text.\n * @modifier -transform-lowercase — Lowercase the text.\n * @modifier -transform-capitalize — Capitalise each word.\n * @modifier -variant-description-page — Page-description type preset.\n * @modifier -variant-description-section — Section-description type preset.\n * @modifier -variant-content — Content type preset.\n * @modifier -variant-content-important — Important-content type preset.\n * @modifier -variant-content-quote — Quote-content type preset.\n * @modifier -variant-content-small — Small-content type preset.\n * @modifier -variant-legend — Legend type preset.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -size-xl — Extra large.\n * @example -canvas-rce -docs\n * ```html\n * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n * ```\n * @related heading — Typography for headings rather than body text.\n * @related truncate — Clips this text to one line or a set number of lines.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n * ```\n */\n@scope (.pfx-text) {\n  & {\n    font-family: var(--instui-component-text-content-font-family);\n    color: var(--instui-component-text-base-color);\n    font-size: var(--instui-component-text-font-size-medium);\n    font-weight: var(--instui-component-text-font-weight-normal);\n    line-height: var(--instui-component-text-content-line-height);\n  }\n\n  &.-size-xs {\n    font-size: var(--instui-component-text-font-size-x-small);\n  }\n\n  &.-size-sm {\n    font-size: var(--instui-component-text-font-size-small);\n  }\n\n  &.-size-lg {\n    font-size: var(--instui-component-text-font-size-large);\n  }\n\n  &.-size-xl {\n    font-size: var(--instui-component-text-font-size-x-large);\n  }\n\n  &.-weight-bold {\n    font-weight: var(--instui-component-text-font-weight-bold);\n  }\n\n  &.-style-italic {\n    font-style: italic;\n  }\n\n  &.-color-primary {\n    color: var(--instui-component-text-primary-color);\n  }\n\n  &.-color-secondary {\n    color: var(--instui-component-text-muted-color);\n  }\n\n  &.-color-brand {\n    color: light-dark(\n      var(--instui-color-institutional-brand-primary),\n      var(--instui-color-institutional-brand-font-color-dark)\n    );\n  }\n\n  &.-color-success {\n    color: var(--instui-component-text-success-color);\n  }\n\n  &.-color-danger {\n    color: var(--instui-component-text-error-color);\n  }\n\n  &.-color-warning {\n    color: var(--instui-component-text-warning-color);\n  }\n\n  &:is(.-color-ai-highlight, .-color-ai) {\n    color: var(--instui-component-text-ai-color);\n    background: var(--instui-component-text-ai-background-color);\n  }\n\n  &.-color-primary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-secondary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-primary-on {\n    color: var(--instui-component-text-base-on-color);\n  }\n\n  &.-color-secondary-on {\n    color: var(--instui-component-text-muted-on-color);\n  }\n\n  &.-variant-description-page {\n    font-size: var(--instui-component-text-description-page-font-size);\n    font-weight: var(--instui-component-text-description-page-font-weight);\n    line-height: var(--instui-component-text-description-page-line-height);\n  }\n\n  &.-variant-description-section {\n    font-size: var(--instui-component-text-description-section-font-size);\n    font-weight: var(--instui-component-text-description-section-font-weight);\n    line-height: var(--instui-component-text-description-section-line-height);\n  }\n\n  &.-variant-content {\n    font-size: var(--instui-component-text-content-font-size);\n    line-height: var(--instui-component-text-content-line-height);\n    font-weight: var(--instui-component-text-content-font-weight);\n  }\n\n  &.-variant-content-small {\n    font-size: var(--instui-component-text-content-small-font-size);\n    font-weight: var(--instui-component-text-content-small-font-weight);\n    line-height: var(--instui-component-text-content-small-line-height);\n  }\n\n  &.-variant-content-important {\n    font-size: var(--instui-component-text-content-important-font-size);\n    line-height: var(--instui-component-text-content-important-line-height);\n    font-weight: var(--instui-component-text-content-important-font-weight);\n  }\n\n  &.-variant-content-quote {\n    font-size: var(--instui-component-text-content-quote-font-size);\n    font-weight: var(--instui-component-text-content-quote-font-weight);\n    font-style: var(--instui-component-text-content-quote-font-style);\n    line-height: var(--instui-component-text-content-quote-line-height);\n  }\n\n  &.-variant-legend {\n    font-size: var(--instui-component-text-legend-font-size);\n    line-height: var(--instui-component-text-legend-line-height);\n    font-weight: var(--instui-component-text-legend-font-weight);\n  }\n\n  &.-transform-uppercase {\n    text-transform: uppercase;\n  }\n\n  &.-transform-lowercase {\n    text-transform: lowercase;\n  }\n\n  &.-transform-capitalize {\n    text-transform: capitalize;\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/text/text.css","content":"/**\n * @component text\n * @selector .pfx-text\n * @a11y It sets appearance only and renders no semantics, so use `<p>`, `<strong>`, `<em>`, and similar elements for meaning, and check contrast of each `-color-*` against its background, especially the inverse colors.\n * @summary Body-text typography with size, weight, colour, and style modifiers.\n * @remarks The `-variant-*` presets and the `-color-*`/`-size-*`/`-weight-*` modifiers all compose on the same element; unlike `heading`, it renders no implicit semantic level.\n * @modifier -color-brand — Brand text colour.\n * @modifier -color-secondary — Secondary (muted) text colour.\n * @modifier -color-ai — @deprecated {@link -color-ai-highlight}\n * @modifier -color-ai-highlight — AI-accent text colour with background highlight.\n * @modifier -color-success — Success text colour.\n * @modifier -color-warning — Warning text colour.\n * @modifier -color-danger — Danger text colour.\n * @modifier -color-primary — Primary text colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) text colour.\n * @modifier -color-secondary-inverse — On-dark (secondary inverse) text colour.\n * @modifier -color-secondary-on — Secondary text colour on a coloured background.\n * @modifier -color-primary-on — Primary text colour on a coloured background.\n * @modifier -weight-bold — Bold weight.\n * @modifier -style-italic — Italic.\n * @modifier -transform-uppercase — Uppercase the text.\n * @modifier -transform-lowercase — Lowercase the text.\n * @modifier -transform-capitalize — Capitalise each word.\n * @modifier -variant-description-page — Page-description type preset.\n * @modifier -variant-description-section — Section-description type preset.\n * @modifier -variant-content — Content type preset.\n * @modifier -variant-content-important — Important-content type preset.\n * @modifier -variant-content-quote — Quote-content type preset.\n * @modifier -variant-content-small — Small-content type preset.\n * @modifier -variant-legend — Legend type preset.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-lg — Large.\n * @modifier -size-xl — Extra large.\n * @example -canvas-rce -docs\n * ```html\n * <span class=\"pfx-text -size-xs --display-block\">x-small text</span>\n * <span class=\"pfx-text -size-sm --display-block\">small text</span>\n * <span class=\"pfx-text -variant-content-quote --display-block\">Quoted text</span>\n * <span class=\"pfx-text -color-ai-highlight\">AI highlight text</span>\n * ```\n * @related heading — Typography for headings rather than body text.\n * @related truncate — Clips this text to one line or a set number of lines.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <p class=\"pfx-text -size-xs\">Updated today.</p>\n * <p class=\"pfx-text -size-sm\">Last edited by Lee.</p>\n * <p class=\"pfx-text\">Your course is ready.</p>\n * <p class=\"pfx-text -size-lg\">Welcome to the course.</p>\n * <p class=\"pfx-text -size-xl\">Start learning today.</p>\n * <p class=\"pfx-text -color-primary\">Required reading.</p>\n * <p class=\"pfx-text -color-secondary\">Optional reading.</p>\n * <p class=\"pfx-text -color-brand\">Course overview.</p>\n * <p class=\"pfx-text -color-success\">Submission received.</p>\n * <p class=\"pfx-text -color-warning\">The deadline is approaching.</p>\n * <p class=\"pfx-text -color-danger\">The upload failed.</p>\n * <p class=\"pfx-text -color-ai-highlight\">Suggested summary.</p>\n * <div class=\"--bg-inverse --p-md\">\n *   <p class=\"pfx-text -color-primary-inverse\">Course announcement.</p>\n *   <p class=\"pfx-text -color-secondary-inverse\">Posted this morning.</p>\n * </div>\n * <div class=\"--bg-brand --p-md\">\n *   <p class=\"pfx-text -color-primary-on\">Enrollment is open.</p>\n *   <p class=\"pfx-text -color-secondary-on\">Choose your next course.</p>\n * </div>\n * <p class=\"pfx-text -weight-bold\"><strong>Save before leaving.</strong></p>\n * <p class=\"pfx-text -style-italic\"><em>Please review your answers.</em></p>\n * <p class=\"pfx-text -transform-uppercase\">New lesson</p>\n * <p class=\"pfx-text -transform-lowercase\">COURSE NOTES</p>\n * <p class=\"pfx-text -transform-capitalize\">weekly reading list</p>\n * <p class=\"pfx-text -variant-description-page\">Explore the course materials.</p>\n * <p class=\"pfx-text -variant-description-section\">Read this week's notes.</p>\n * <p class=\"pfx-text -variant-content\">The lesson begins with a short introduction.</p>\n * <p class=\"pfx-text -variant-content-important\"><strong>Bring your notes.</strong></p>\n * <blockquote class=\"pfx-text -variant-content-quote\">Learning takes practice.</blockquote>\n * <p class=\"pfx-text -variant-content-small\">Updated on Monday.</p>\n * <p class=\"pfx-text -variant-legend\">Figure 1: Course timeline.</p>\n * ```\n */\n@scope (.pfx-text) {\n  & {\n    font-family: var(--instui-component-text-content-font-family);\n    color: var(--instui-component-text-base-color);\n    font-size: var(--instui-component-text-font-size-medium);\n    font-weight: var(--instui-component-text-font-weight-normal);\n    line-height: var(--instui-component-text-content-line-height);\n  }\n\n  &.-size-xs {\n    font-size: var(--instui-component-text-font-size-x-small);\n  }\n\n  &.-size-sm {\n    font-size: var(--instui-component-text-font-size-small);\n  }\n\n  &.-size-lg {\n    font-size: var(--instui-component-text-font-size-large);\n  }\n\n  &.-size-xl {\n    font-size: var(--instui-component-text-font-size-x-large);\n  }\n\n  &.-weight-bold {\n    font-weight: var(--instui-component-text-font-weight-bold);\n  }\n\n  &.-style-italic {\n    font-style: italic;\n  }\n\n  &.-color-primary {\n    color: var(--instui-component-text-primary-color);\n  }\n\n  &.-color-secondary {\n    color: var(--instui-component-text-muted-color);\n  }\n\n  &.-color-brand {\n    color: light-dark(\n      var(--instui-color-institutional-brand-primary),\n      var(--instui-color-institutional-brand-font-color-dark)\n    );\n  }\n\n  &.-color-success {\n    color: var(--instui-component-text-success-color);\n  }\n\n  &.-color-danger {\n    color: var(--instui-component-text-error-color);\n  }\n\n  &.-color-warning {\n    color: var(--instui-component-text-warning-color);\n  }\n\n  &:is(.-color-ai-highlight, .-color-ai) {\n    color: var(--instui-component-text-ai-color);\n    background: var(--instui-component-text-ai-background-color);\n  }\n\n  &.-color-primary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-secondary-inverse {\n    color: var(--instui-component-text-inverse-color);\n  }\n\n  &.-color-primary-on {\n    color: var(--instui-component-text-base-on-color);\n  }\n\n  &.-color-secondary-on {\n    color: var(--instui-component-text-muted-on-color);\n  }\n\n  &.-variant-description-page {\n    font-size: var(--instui-component-text-description-page-font-size);\n    font-weight: var(--instui-component-text-description-page-font-weight);\n    line-height: var(--instui-component-text-description-page-line-height);\n  }\n\n  &.-variant-description-section {\n    font-size: var(--instui-component-text-description-section-font-size);\n    font-weight: var(--instui-component-text-description-section-font-weight);\n    line-height: var(--instui-component-text-description-section-line-height);\n  }\n\n  &.-variant-content {\n    font-size: var(--instui-component-text-content-font-size);\n    line-height: var(--instui-component-text-content-line-height);\n    font-weight: var(--instui-component-text-content-font-weight);\n  }\n\n  &.-variant-content-small {\n    font-size: var(--instui-component-text-content-small-font-size);\n    font-weight: var(--instui-component-text-content-small-font-weight);\n    line-height: var(--instui-component-text-content-small-line-height);\n  }\n\n  &.-variant-content-important {\n    font-size: var(--instui-component-text-content-important-font-size);\n    line-height: var(--instui-component-text-content-important-line-height);\n    font-weight: var(--instui-component-text-content-important-font-weight);\n  }\n\n  &.-variant-content-quote {\n    font-size: var(--instui-component-text-content-quote-font-size);\n    font-weight: var(--instui-component-text-content-quote-font-weight);\n    font-style: var(--instui-component-text-content-quote-font-style);\n    line-height: var(--instui-component-text-content-quote-line-height);\n  }\n\n  &.-variant-legend {\n    font-size: var(--instui-component-text-legend-font-size);\n    line-height: var(--instui-component-text-legend-line-height);\n    font-weight: var(--instui-component-text-legend-font-weight);\n  }\n\n  &.-transform-uppercase {\n    text-transform: uppercase;\n  }\n\n  &.-transform-lowercase {\n    text-transform: lowercase;\n  }\n\n  &.-transform-capitalize {\n    text-transform: capitalize;\n  }\n}\n"}}],"_permissionRequestSessionId":"44e9bcbc-c0c2-4d54-9c7b-2558508ad507","assistedApproval":{"recommendation":"approve","reason":"Authorized project fixture update; no mandatory exclusion is apparent.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"44e9bcbc-c0c2-4d54-9c7b-2558508ad507"},"agentId":"78631379-5bbe-4a0d-a590-18491ff526c0","id":"8e031f92-90c6-43f4-a365-2e4a17528220","timestamp":"2026-10-28T21:04:40.605Z","parentId":"584150cc-635a-44d7-98b7-0a725d3e4aed"}
