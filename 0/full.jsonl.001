{"type":"hook.start","data":{"hookInvocationId":"edb40b09-e007-47cd-812e-c625ca35dc3d","hookType":"postToolUse","input":{"sessionId":"78631379-5bbe-4a0d-a590-18491ff526c0","timestamp":1793221454598,"cwd":"/Users/dwahl/Scripts/pantoken","toolName":"apply_patch","toolArgs":"*** Begin Patch\n*** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/components/button/button.css\n@@\n- * <button class=\"pfx-button\" data-a11y-trigger data-a11y-root>Save</button>\n+ * <div data-a11y-root>\n+ *   <div><button class=\"pfx-button -color-primary -size-sm\" type=\"button\" data-a11y-trigger>Save draft</button></div>\n+ *   <div><button class=\"pfx-button -color-secondary -size-md\" type=\"button\">Preview draft</button></div>\n+ *   <div><button class=\"pfx-button -color-tertiary -size-lg\" type=\"button\">View history</button></div>\n+ *   <div><button class=\"pfx-button -color-success\" type=\"button\">Publish</button></div>\n+ *   <div><button class=\"pfx-button -color-danger\" type=\"button\">Delete draft</button></div>\n+ *   <div><button class=\"pfx-button -color-ai\" type=\"button\">Summarize notes</button></div>\n+ *   <div><button class=\"pfx-button -color-ai-secondary\" type=\"button\">Suggest a title</button></div>\n+ *   <div><button class=\"pfx-button -color-primary\" type=\"button\" disabled>Save unavailable</button></div>\n+ *   <div><button class=\"pfx-button -color-secondary\" type=\"button\" disabled>Preview unavailable</button></div>\n+ *   <div><button class=\"pfx-button -color-tertiary\" type=\"button\" disabled>History unavailable</button></div>\n+ *   <div><button class=\"pfx-button -color-success\" type=\"button\" disabled>Publish unavailable</button></div>\n+ *   <div><button class=\"pfx-button -color-danger\" type=\"button\" disabled>Delete unavailable</button></div>\n+ *   <div><button class=\"pfx-button -color-ai\" type=\"button\" disabled>Summary unavailable</button></div>\n+ *   <div><button class=\"pfx-button -color-ai-secondary\" type=\"button\" disabled>Suggestion unavailable</button></div>\n+ *   <div><button class=\"pfx-button\" type=\"button\" aria-disabled=\"true\">Saving draft</button></div>\n+ *   <div><button class=\"pfx-button -toggle\" type=\"button\" aria-pressed=\"false\">Pin draft</button></div>\n+ *   <div><button class=\"pfx-button -toggle\" type=\"button\" aria-pressed=\"true\">Pin notes</button></div>\n+ *   <div><button class=\"pfx-button -condensed\" type=\"button\">More actions</button></div>\n+ *   <div><button class=\"pfx-button -without-background\" type=\"button\">Discard changes</button></div>\n+ *   <div><button class=\"pfx-button -without-border\" type=\"button\">Continue</button></div>\n+ *   <div><button class=\"pfx-button -color-ai-secondary -without-border\" type=\"button\">Suggest edits</button></div>\n+ *   <div><button class=\"pfx-button -shape-square -icon-plus\" type=\"button\" aria-label=\"Add draft\"></button></div>\n+ *   <div><button class=\"pfx-button -shape-circle -icon-plus\" type=\"button\" aria-label=\"Add note\"></button></div>\n+ *   <div><button class=\"pfx-button -icon-arrow-right\" type=\"button\">Next draft</button></div>\n+ *   <div><button class=\"pfx-button -display-block\" type=\"button\">Submit draft</button></div>\n+ *   <div class=\"--bg-brand --p-md\">\n+ *     <div><button class=\"pfx-button -color-primary -on-color\" type=\"button\">Save on brand</button></div>\n+ *     <div><button class=\"pfx-button -color-secondary -on-color\" type=\"button\">Preview on brand</button></div>\n+ *     <div><button class=\"pfx-button -color-primary -on-color\" type=\"button\" disabled>Save unavailable on brand</button></div>\n+ *     <div><button class=\"pfx-button -color-secondary -on-color\" type=\"button\" disabled>Preview unavailable on brand</button></div>\n+ *   </div>\n+ * </div>\n*** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/components/alert/alert.css\n@@\n- * <button class=\"pfx-button\" type=\"button\" id=\"save-settings\" data-a11y-trigger>Save settings</button>\n- * <div class=\"pfx-alert -inline\" id=\"save-status\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\" data-a11y-root></div>\n- * <script>\n- * document.getElementById(\"save-settings\").addEventListener(\"click\", () => {\n- *   document.getElementById(\"save-status\").textContent = \"Settings saved.\";\n- * });\n- * </script>\n+ * <div data-a11y-root>\n+ *   <div class=\"pfx-alert -color-info --mb-md\" role=\"status\">Your export is ready.</div>\n+ *   <div class=\"pfx-alert -color-success --mb-md\" role=\"status\">Settings saved.</div>\n+ *   <div class=\"pfx-alert -color-warning --mb-md\" role=\"alert\">Your session expires soon.</div>\n+ *   <div class=\"pfx-alert -color-danger --mb-md\" role=\"alert\">The upload failed.</div>\n+ *   <div class=\"pfx-alert -color-info -inline --mb-md\" role=\"status\">An update is available.</div>\n+ *   <div class=\"pfx-alert -color-success -inline --mb-md\" role=\"status\">Your changes are published.</div>\n+ *   <div class=\"pfx-alert -color-warning -inline --mb-md\" role=\"alert\">Save your work before leaving.</div>\n+ *   <div class=\"pfx-alert -color-danger -inline --mb-md\" role=\"alert\">Check the file and try again.</div>\n+ *   <div class=\"pfx-alert -icon-megaphone --mb-md\" role=\"status\">Registration opens tomorrow.</div>\n+ *   <div class=\"pfx-alert -icon-megaphone -inline --mb-md\" role=\"status\">Registration is now open.</div>\n+ *   <div class=\"pfx-alert -screen-reader-only\" role=\"status\">All changes saved.</div>\n+ *   <div class=\"pfx-alert -timeout-5\" role=\"status\">A copy was saved automatically.</div>\n+ * </div>\n*** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/components/badge/badge.css\n@@\n  * @example -automatica11y\n  * ```html\n- * <span class=\"pfx-badge-wrapper\">\n- *   <button class=\"pfx-button\">Inbox</button>\n- *   <span class=\"pfx-badge -placement-top-end\">4</span>\n- * </span>\n+ * <div><span class=