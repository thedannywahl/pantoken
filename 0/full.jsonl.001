<legend>Inline fields with small gaps</legend>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Town</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-columns -col-spacing-medium -row-spacing-medium -v-align-bottom\">\n+ *   <legend>Columns with medium gaps</legend>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">City</span><span class=\"controls\"><input class=\"pfx-text-input\"></span></label>\n+ *   <label class=\"pfx-form-field\"><span class=\"label\">Area</span><span class=\"controls\"><textarea class=\"pfx-text-area\"></textarea></span></label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-form-field-group -layout-aligned -col-spacing-large -row-spacing-large -required\">\n+ *   <legend>Aligned required fields</legend>\n  *   <label class=\"pfx-form-field\">\n- *     <span class=\"label\">Last name</span>\n- *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n+ *     <span class=\"label\">Name</span>\n+ *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Alex\"></span>\n  *   </label>\n  *   <label class=\"pfx-form-field\">\n  *     <span class=\"label\">City</span>\n- *     <span class=\"controls\"><input class=\"pfx-text-input\"></span>\n- *   </label>\n- *   <label class=\"pfx-form-field\">\n- *     <span class=\"label\">State</span>\n- *     <span class=\"controls\">\n- *       <select class=\"pfx-simple-select\">\n- *         <option>CA</option>\n- *         <option>NY</option>\n- *         <option>TX</option>\n- *       </select>\n- *     </span>\n+ *     <span class=\"controls\"><input class=\"pfx-text-input\" required value=\"Denver\"></span>\n  *   </label>\n- *   <div class=\"pfx-form-field-messages\">\n- *     <span class=\"pfx-form-field-message -type-hint\">All fields are used for delivery only.</span>\n- *   </div>\n  * </fieldset>\n*** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/components/radio-input-group/radio-input-group.css\n@@\n  * @example -automatica11y\n  * ```html\n  * <fieldset class=\"pfx-radio-input-group\">\n- *   <legend>T-shirt size</legend>\n- *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\" checked> Small</label>\n- *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Medium</label>\n- *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"shirt-size\"> Large</label>\n+ *   <legend>Stacked sizes</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"sm\" checked>Small</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"md\">Medium</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-shirt-size\" value=\"lg\" disabled>Large unavailable</label>\n  * </fieldset>\n- * \n- * <fieldset class=\"pfx-radio-input-group -variant-toggle\">\n- *   <legend>Sweatshirt size</legend>\n- *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\" checked> Small</label>\n- *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Medium</label>\n- *   <label class=\"pfx-radio -variant-toggle\"><input type=\"radio\" name=\"sweatshirt-size\"> Large</label>\n+ * <fieldset class=\"pfx-radio-input-group -layout-columns\">\n+ *   <legend>Column sizes</legend>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"sm\" checked>Small</label>\n+ *   <label class=\"pfx-radio\"><input type=\"radio\" name=\"audit-column-size\" value=\"md\">Medium</label>\n+ * </fieldset>\n+ * <fieldset class=\"pfx-radio-input-group -layout-inline -required\">\n+ *   <legend>Required inline size</legend>\n+ *   <label class=\"pf