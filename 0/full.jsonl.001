\"../scripts/audit-accessibility.ts\"; @@ -test.each(records)(\"authors an explicit audit example for $name\", (record) => { +test.each([...records, ...PLUGIN_AUDIT_RECORDS])(\"authors an explicit audit example for $name\", (record) => { @@ - window.document.body.innerHTML = fences.map((match) => match[1]).join(\"\\n\"); + window.document.body.innerHTML = exampleHtml(example); @@ }); + +test.each(PLUGIN_AUDIT_RECORDS.filter((record) => + [\"banner\", \"button-set\", \"segmented-control\", \"skeleton-loader\"].includes(record.name), +))(\"covers every canonical visual modifier for the plugin $name\", (record) => { + const entry = parseCssDocs(record.rules(\"instui-\")).find((item) => item.name === record.name)!; + const markup = resolveExampleTargets(entry.examples).automatica11y + .map((index) => exampleHtml(entry.examples[index]!)) + .join(\"\\n\"); + const window = new Window(); + window.document.body.innerHTML = markup; + const classes = new Set( + [...window.document.querySelectorAll(\"[class]\")].flatMap((element) => [...element.classList]), + ); + for (const modifier of entry.modifiers) { + if (modifier.name.includes(\"*\") || modifier.description.includes(\"@alias\")) continue; + expect(classes.has(modifier.name), `${record.name}: ${modifier.name}`).toBe(true); + } + void window.happyDOM.abort(); +}); *** End Patch\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/declarations/focus/index.ts @@ - * <button class=\"instui-button -focus-color-danger\" data-a11y-root data-a11y-trigger>Delete</button> + * <button data-a11y-root data-a11y-trigger>Default focus</button> + * <button class=\"-focus-color-danger\">Danger focus</button> + * <button class=\"-focus-color-success\">Success focus</button> + * <div style=\"background: var(--instui-color-background-brand)\"> + * <button class=\"-focus-color-inverse\">Inverse focus</button> + * </div> + * <button class=\"-focus-position-inset\">Inset focus</button> + * <div class=\"-focus-within\"><button>Focus within</button></div> + * <button class=\"-without-focus-animation\">Focus without animation</button> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/ai-gradient/index.ts @@ - * <div class=\"--border-color-ai --border-radius-md --border-width-sm --p-md\"> - * AI-generated summary - * </div> + * <div class=\"--border-color-ai\">AI border</div> + * <div class=\"--border-color-ai-horizontal\">Horizontal AI border</div> + * <div class=\"--background-ai\">AI background</div> + * <div class=\"--background-ai-horizontal\">Horizontal AI background</div> + * <div dir=\"rtl\"> + * <div class=\"--border-color-ai-horizontal\">حدود الذكاء الاصطناعي</div> + * <div class=\"--background-ai-horizontal\">خلفية الذكاء الاصطناعي</div> + * </div> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/icon/icon.css @@ - * <button class=\"pfx-button\" data-a11y-root data-a11y-trigger> + * <button data-a11y-root data-a11y-trigger> @@ * </button> + * <span class=\"pfx-icon -icon-warning\" role=\"img\" aria-label=\"Warning\"></span> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/screen-reader-content/screen-reader-content.css @@ - * <a class=\"pfx-link\" href=\"#settings\" data-a11y-root data-a11y-trigger> - * <span class=\"pfx-icon -icon-settings\" aria-hidden=\"true\"></span> + * <bu… [truncated 176 chars]\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/ai-gradient/index.ts @@ - * <div class=\"--border-color-ai-horizontal\">حدود الذكاء الاصطناعي</div> - * <div class=\"--background-ai-horizontal\">خلفية الذكاء الاصطناعي</div> + * <div class=\"--border-color-ai-horizontal\">RTL AI border</div> + * <div class=\"--background-ai-horizontal\">RTL AI background</div> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/screen-reader-content/screen-reader-content.css @@ - * <span aria-hidden=\"true\">⚙</span> + * <span aria-hidden=\"true\">+</span> *** End Patch\n[tool rg -> success] args={\"pattern\":\"custom-components|readdirSync\\\\(.*assets\",\"paths\":\"/Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts\",\"output_mode\":\"content\",\"-n\":true,\"-C\":3}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts @@ \"components/fonts.css\", + ...(item.record === \"logo\" ? [\"logos/canvas-horizontal-color.css\"] : []), @@ [\"plugins/pantoken/custom-components/dist\", \"custom-components\"], + [\"plugins/pantoken/logos/dist\", \"logos\"], *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-accessibility.test.ts @@ expect(page).toContain(\"control.checkValidity()\"); + const logoPage = renderPage({ ...cases[0]!, record: \"logo\" }); + expect(logoPage).toContain('href=\"assets/logos/canvas-horizontal-color.css\"'); @@ \"plugins/pantoken/custom-components/dist\", + \"plugins/pantoken/logos/dist\", @@ \"interactions\", + \"logos\", *** End Patch\n[tool bash -> success] args={\"command\":\"vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate plugin fixtures and harness\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --help\",\"description\":\"Check changeset CLI options\",\"initial_wait\":60}\n[tool bash -> success] args={\"command\":\"cd formats/components && node --input-type=module -e 'import {parseCssDocs} from \\\"@cssdoc/core\\\"; import {PLUGIN_AUDIT_RECORDS} from \\\"./scripts/audit-plugin-components.ts\\\"; console.log(JSON.stringify(parseCssDocs(PLUGIN_AUDIT_RECORDS.find(x=>x.name===\\\"banner\\\").rules(\\\"instui-\\\")).find(x=>x.name===\\\"banner\\\").modifiers,null,2))'\",\"description\":\"Inspect parsed modifier alias metadata\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-examples.test.ts @@ - if (modifier.name.includes(\"*\") || modifier.description.includes(\"@alias\")) continue; + if (modifier.pattern || modifier.alias) continue; *** End Patch\n[tool write_agent -> success] args={\"agent_ids\":[\"049c1373-ecc6-4d66-bbea-f19e45c06453\",\"78631379-5bbe-4a0d-a590-18491ff526c0\",\"13128f82-ab9e-41de-a14e-bd6978da289e\"],\"message\":\"Parsed CssDocEntry.modifiers carries modifier.alias.canonical (not description @alias) and modifier.pattern. I'll add metadata-derived guard that requires canonical visual color/size/variant/state modifier classes on matching component roots, skipping aliases/patterns. Flag any intentional exceptions with rationale. Please ensure data-a11y roots/triggers remain where harness needs them; root identifiers should remain unique. Guard tests now normalize pfx before checking IDs/ARIA for plugin records too.\"}\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md @@ member's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it. Use fenced HTML so audience flags remain metadata, not visible page content. +Keep one audit example per record, with distinct visual variants together: canonical colors, sizes, +and supported states. Don't duplicate deprecated aliases or build a Cartesian product of every +modifier. Include meaningful labels, selected and unselected choices, and native `disabled`, +`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface +for inverse/on-color treatments, without overriding the component's tested colors. Keep decorative +content hidden from assistive technology and preserve required parent/member structures. + +Stack independent cases in normal document flow instead of forcing a wide row. Expanded dialog +variants can use `open` so they remain measurable without one modal hiding the others. Static state +markup is not evidence that hover, keyboard interaction, focus movement, or announcements work: +those still need interaction checks and manual testing. Don't remove a supported variant or add a +fixture-only CSS fix to make the audit pass. + Run `vp run audit:components` from the repository root. It builds local styles and behavior bundles, *** End Patch\n[tool bash -> success] args={\"command\":\"vp check --fix formats/components/tests/audit-examples.test.ts formats/components/scripts/audit-accessibility.ts formats/components/tests/audit-accessibility.test.ts formats/components/src/declarations/focus/index.ts formats/components/src/utilities/ai-gradient/index.ts plugins/pantoken/custom-components/src/components docs/conventions/authoring.md && vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\",\"description\":\"Validate own plugin and utility changes\",\"initial_wait\":120}\n[tool bash -> success] args={\"command\":\"vp exec changeset --patch @pantoken/components,@pantoken/plugin-custom-components -m \\\"Expand accessibility audit examples to exercise distinct visual variants and native control states, with minimal component-owned markup.\\\"\",\"description\":\"Generate audit-fixture changeset\",\"initial_wait\":60}","copilot_cache_control":{"type":"ephemeral"}},{"content":"ALLOW: Explicitly authorized accessibility-fixture update within the requested project scope.","refusal":null,"role":"assistant","reasoning_opaque":"REDACTED","reasoning_text":"**Evaluating write file task**\n\nI need to evaluate the user's request to write a file, which involves considering the proposal for editing. The scope seems to be clearly defined; it should only affect the CSS property without any destructive changes. There's some concern about the risk involved, particularly with the \"all five\" phases mentioned. The user has emphasized that I should ignore other agents in the repo, meaning I’ll handle this task independently without stopping. The changes will remain limited to the example document without committing.","encrypted_content":"REDACTED","reasoningBlocks":{"provider":"openai-responses","blocks":[{"content":[],"encrypted_content":"REDACTED","id":"","summary":[{"text":"**Evaluating write file task**\n\nI need to evaluate the user's request to write a file, which involves considering the proposal for editing. The scope seems to be clearly defined; it should only affect the CSS property without any destructive changes. There's some concern about the risk involved, particularly with the \"all five\" phases mentioned. The user has emphasized that I should ignore other agents in the repo, meaning I’ll handle this task independently without stopping. The changes will remain limited to the example document without committing.","type":"summary_text"}],"type":"reasoning"}]},"responses_message_status":"completed","phase":"final_answer","serverTools":{"provider":"openai-responses"},"apiCallId":"","outputTokens":171,"providerId":"copilot"}]},"id":"d062a92a-794c-4867-a2c5-88a449620f2b","timestamp":"2026-10-28T21:04:50.292Z","parentId":"ebb73208-5ed5-478d-b8aa-0bde81bb5e1d"}
{"type":"permission.requested","data":{"requestId":"5dcdcbe7-2312-4572-a099-404a2bec4e32","permissionRequest":{"kind":"write","toolCallId":"custom_call_ngvomRbtB2rjzm9A2QcYoPdP","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css\n@@ -68,12 +68,26 @@\n  * @sealed\n  * @example -automatica11y\n  * ```html\n- * <label>\n- *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n- * </label>\n- * \n- * <label for=\"score\">Score</label>\n- * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n+ * <div><label>Uploading notes <progress class=\"pfx-progress-circle -color-brand -size-xs\" value=\"70\" max=\"100\" style=\"--value: 70\">70%</progress></label></div>\n+ * <div><label>Preparing files <progress class=\"pfx-progress-circle -color-info -size-sm\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label></div>\n+ * <div><label>Reviews complete <progress class=\"pfx-progress-circle -color-success -size-md\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label></div>\n+ * <div><label>Storage used <progress class=\"pfx-progress-circle -color-warning -size-lg\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label></div>\n+ * <div><label>Failed transfers <progress class=\"pfx-progress-circle -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label></div>\n+ * <div><label>Starting upload <progress class=\"pfx-progress-circle\" value=\"0\" max=\"100\">0%</progress></label></div>\n+ * <div><label>Finding files <progress class=\"pfx-progress-circle\">Working</progress></label></div>\n+ * <label for=\"audit-review-score\">Review score</label>\n+ * <meter id=\"audit-review-score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\" style=\"--min: 20; --value: 40; --max: 60\">40 of 60</meter>\n+ * <div class=\"--bg-inverse --text-inverse --p-md\">\n+ *   <label>Background upload <progress class=\"pfx-progress-circle -color-primary-inverse -color-brand\" value=\"60\" max=\"100\" style=\"--value: 60\">60%</progress></label>\n+ *   <label>Preparing archive <progress class=\"pfx-progress-circle -color-primary-inverse -color-info\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label>\n+ *   <label>Archive ready <progress class=\"pfx-progress-circle -color-primary-inverse -color-success\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label>\n+ *   <label>Archive quota <progress class=\"pfx-progress-circle -color-primary-inverse -color-warning\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label>\n+ *   <label>Archive failures <progress class=\"pfx-progress-circle -color-primary-inverse -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label>\n+ * </div>\n+ * <p id=\"audit-circle-label\">Processing documents</p>\n+ * <div class=\"pfx-progress-circle -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-circle-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50\">\n+ *   <span class=\"value\">50%</span>\n+ * </div>\n  * ```\n  */\n \n","newFileContents":"/**\n * @component progress-circle\n * @selector .pfx-progress-circle\n * @summary A circular progress ring driven by `--value` and `--value-max` custom properties.\n * @remarks The ring is a `conic-gradient` donut painted on `::before` and clipped with a radial-gradient mask; `--value` divided by `--value-max` drives the arc. Add `-should-animate` and load the interactions entry point to animate it from zero on mount. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), spinning the ring at a fixed arc and hiding `.value` since there's no meaningful number to show. `<meter>` has no indeterminate state, so it's unaffected.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate the meter, ring, and centered value into place on mount.\n * @modifier -should-animate-on-mount — @alias {@link -should-animate}\n * @modifier -shold-animate-on-mount — @alias {@link -should-animate}\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .value — The value text centred in the ring's hole.\n * @pseudo ::before — Draws the ring itself: a conic-gradient donut clipped with a radial mask, whose arc tracks the `--value` custom property.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; spins `::before` at a fixed arc and hides `.value`.\n * @cssproperty --value <number> — The current progress value; registered with @property so it can transition.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --animation-delay <number> — Milliseconds to wait before starting the mount animation (default `0`).\n * @cssproperty --pantoken-pc-fill <color> — The filled arc (meter) colour; the -color-* modifiers set it.\n * @cssproperty --pantoken-pc-track <color> — The unfilled track colour.\n * @cssproperty --pantoken-pc-stroke <length> — The ring's stroke width; the -size-* modifiers set it.\n * @a11y Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Registers the numeric progress properties with `@property` and paints with CSS `mask` and `conic-gradient`; where custom-property transitions are unsupported the ring still renders but won't animate.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"score\">Score</label>\n * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress-circle {\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress-circle {\n *     .value {}\n *   }\n * }\n * @related progress — The linear bar form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <div><label>Uploading notes <progress class=\"pfx-progress-circle -color-brand -size-xs\" value=\"70\" max=\"100\" style=\"--value: 70\">70%</progress></label></div>\n * <div><label>Preparing files <progress class=\"pfx-progress-circle -color-info -size-sm\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label></div>\n * <div><label>Reviews complete <progress class=\"pfx-progress-circle -color-success -size-md\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label></div>\n * <div><label>Storage used <progress class=\"pfx-progress-circle -color-warning -size-lg\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label></div>\n * <div><label>Failed transfers <progress class=\"pfx-progress-circle -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label></div>\n * <div><label>Starting upload <progress class=\"pfx-progress-circle\" value=\"0\" max=\"100\">0%</progress></label></div>\n * <div><label>Finding files <progress class=\"pfx-progress-circle\">Working</progress></label></div>\n * <label for=\"audit-review-score\">Review score</label>\n * <meter id=\"audit-review-score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\" style=\"--min: 20; --value: 40; --max: 60\">40 of 60</meter>\n * <div class=\"--bg-inverse --text-inverse --p-md\">\n *   <label>Background upload <progress class=\"pfx-progress-circle -color-primary-inverse -color-brand\" value=\"60\" max=\"100\" style=\"--value: 60\">60%</progress></label>\n *   <label>Preparing archive <progress class=\"pfx-progress-circle -color-primary-inverse -color-info\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label>\n *   <label>Archive ready <progress class=\"pfx-progress-circle -color-primary-inverse -color-success\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label>\n *   <label>Archive quota <progress class=\"pfx-progress-circle -color-primary-inverse -color-warning\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label>\n *   <label>Archive failures <progress class=\"pfx-progress-circle -color-primary-inverse -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label>\n * </div>\n * <p id=\"audit-circle-label\">Processing documents</p>\n * <div class=\"pfx-progress-circle -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-circle-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50\">\n *   <span class=\"value\">50%</span>\n * </div>\n * ```\n */\n\n@property --value {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --value-now {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --min {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --value-max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --animation-delay {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@scope (.pfx-progress-circle) {\n  & {\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    --animation-delay: 0;\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    color: var(--instui-component-progress-circle-color);\n    font-family: var(--instui-component-progress-circle-font-family);\n    font-weight: var(--instui-component-progress-circle-font-weight);\n    line-height: var(--instui-component-progress-circle-line-height);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: --value 1s;\n    }\n  }\n\n  /* The ring is a masked conic donut on ::before; the value sits in the hole. */\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar,\n  &::-webkit-progress-value,\n  &::-webkit-meter-bar,\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-moz-progress-bar,\n  &::-moz-meter-bar {\n    background: transparent;\n  }\n\n  &::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: 50%;\n    background: conic-gradient(\n      var(--pantoken-pc-fill)\n        clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%),\n      var(--pantoken-pc-track) 0\n    );\n    -webkit-mask: radial-gradient(\n      farthest-side,\n      #0000 calc(100% - var(--pantoken-pc-stroke)),\n      #000 0\n    );\n    mask: radial-gradient(farthest-side, #0000 calc(100% - var(--pantoken-pc-stroke)), #000 0);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      --pantoken-pc-fill: CanvasText;\n      --pantoken-pc-track: Canvas;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 0.2s,\n        transform 0.5s;\n    }\n    transform: translate3d(0, 0, 0) scale(1);\n  }\n\n  & .value {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  &.-size-xs {\n    width: var(--instui-component-progress-circle-x-small-size);\n    height: var(--instui-component-progress-circle-x-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-x-small-stroke-width);\n  }\n\n  &.-size-sm {\n    width: var(--instui-component-progress-circle-small-size);\n    height: var(--instui-component-progress-circle-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-small-stroke-width);\n  }\n\n  &.-size-md {\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n  }\n\n  &.-size-lg {\n    width: var(--instui-component-progress-circle-large-size);\n    height: var(--instui-component-progress-circle-large-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-large-stroke-width);\n  }\n\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n  }\n\n  &.-color-primary-inverse:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info);\n  }\n\n  &.-color-primary-inverse:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info-inverse);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success);\n  }\n\n  &.-color-primary-inverse:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success-inverse);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning);\n  }\n\n  &.-color-primary-inverse:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning-inverse);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger);\n  }\n\n  &.-color-primary-inverse:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger-inverse);\n  }\n\n  &.-color-primary-inverse {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color-inverse);\n    color: var(--instui-component-progress-circle-color-inverse);\n  }\n\n  /* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n     --value) reads as loading rather than rendering a static, potentially-empty ring. */\n  @keyframes pantoken-progress-circle-indeterminate {\n    to {\n      transform: rotate(1turn);\n    }\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate {\n    --value: 25;\n    --min: 0;\n    --max: 100;\n  }\n\n  &:indeterminate::before {\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-circle-indeterminate 1s linear infinite;\n    }\n  }\n\n  &:indeterminate .value {\n    visibility: hidden;\n  }\n\n  & > .value {\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 1s,\n        transform 0.5s 1s;\n    }\n    transform: translate3d(0, 0, 0);\n  }\n\n  @media (prefers-reduced-motion: no-preference) {\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) {\n      --value: 0 !important;\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount)::before {\n      opacity: 0;\n      transform: translate3d(0, 0, 0) scale(0.75);\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) > .value {\n      opacity: 0;\n      transform: translate3d(0, 10%, 0);\n    }\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css","content":"/**\n * @component progress-circle\n * @selector .pfx-progress-circle\n * @summary A circular progress ring driven by `--value` and `--value-max` custom properties.\n * @remarks The ring is a `conic-gradient` donut painted on `::before` and clipped with a radial-gradient mask; `--value` divided by `--value-max` drives the arc. Add `-should-animate` and load the interactions entry point to animate it from zero on mount. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), spinning the ring at a fixed arc and hiding `.value` since there's no meaningful number to show. `<meter>` has no indeterminate state, so it's unaffected.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate the meter, ring, and centered value into place on mount.\n * @modifier -should-animate-on-mount — @alias {@link -should-animate}\n * @modifier -shold-animate-on-mount — @alias {@link -should-animate}\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .value — The value text centred in the ring's hole.\n * @pseudo ::before — Draws the ring itself: a conic-gradient donut clipped with a radial mask, whose arc tracks the `--value` custom property.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; spins `::before` at a fixed arc and hides `.value`.\n * @cssproperty --value <number> — The current progress value; registered with @property so it can transition.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --animation-delay <number> — Milliseconds to wait before starting the mount animation (default `0`).\n * @cssproperty --pantoken-pc-fill <color> — The filled arc (meter) colour; the -color-* modifiers set it.\n * @cssproperty --pantoken-pc-track <color> — The unfilled track colour.\n * @cssproperty --pantoken-pc-stroke <length> — The ring's stroke width; the -size-* modifiers set it.\n * @a11y Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Registers the numeric progress properties with `@property` and paints with CSS `mask` and `conic-gradient`; where custom-property transitions are unsupported the ring still renders but won't animate.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"score\">Score</label>\n * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress-circle {\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress-circle {\n *     .value {}\n *   }\n * }\n * @related progress — The linear bar form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n * </label>\n * \n * <label for=\"score\">Score</label>\n * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n */\n\n@property --value {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --value-now {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --min {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --value-max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --animation-delay {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@scope (.pfx-progress-circle) {\n  & {\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    --animation-delay: 0;\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    color: var(--instui-component-progress-circle-color);\n    font-family: var(--instui-component-progress-circle-font-family);\n    font-weight: var(--instui-component-progress-circle-font-weight);\n    line-height: var(--instui-component-progress-circle-line-height);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: --value 1s;\n    }\n  }\n\n  /* The ring is a masked conic donut on ::before; the value sits in the hole. */\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar,\n  &::-webkit-progress-value,\n  &::-webkit-meter-bar,\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-moz-progress-bar,\n  &::-moz-meter-bar {\n    background: transparent;\n  }\n\n  &::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: 50%;\n    background: conic-gradient(\n      var(--pantoken-pc-fill)\n        clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%),\n      var(--pantoken-pc-track) 0\n    );\n    -webkit-mask: radial-gradient(\n      farthest-side,\n      #0000 calc(100% - var(--pantoken-pc-stroke)),\n      #000 0\n    );\n    mask: radial-gradient(farthest-side, #0000 calc(100% - var(--pantoken-pc-stroke)), #000 0);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      --pantoken-pc-fill: CanvasText;\n      --pantoken-pc-track: Canvas;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 0.2s,\n        transform 0.5s;\n    }\n    transform: translate3d(0, 0, 0) scale(1);\n  }\n\n  & .value {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  &.-size-xs {\n    width: var(--instui-component-progress-circle-x-small-size);\n    height: var(--instui-component-progress-circle-x-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-x-small-stroke-width);\n  }\n\n  &.-size-sm {\n    width: var(--instui-component-progress-circle-small-size);\n    height: var(--instui-component-progress-circle-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-small-stroke-width);\n  }\n\n  &.-size-md {\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n  }\n\n  &.-size-lg {\n    width: var(--instui-component-progress-circle-large-size);\n    height: var(--instui-component-progress-circle-large-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-large-stroke-width);\n  }\n\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n  }\n\n  &.-color-primary-inverse:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info);\n  }\n\n  &.-color-primary-inverse:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info-inverse);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success);\n  }\n\n  &.-color-primary-inverse:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success-inverse);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning);\n  }\n\n  &.-color-primary-inverse:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning-inverse);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger);\n  }\n\n  &.-color-primary-inverse:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger-inverse);\n  }\n\n  &.-color-primary-inverse {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color-inverse);\n    color: var(--instui-component-progress-circle-color-inverse);\n  }\n\n  /* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n     --value) reads as loading rather than rendering a static, potentially-empty ring. */\n  @keyframes pantoken-progress-circle-indeterminate {\n    to {\n      transform: rotate(1turn);\n    }\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate {\n    --value: 25;\n    --min: 0;\n    --max: 100;\n  }\n\n  &:indeterminate::before {\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-circle-indeterminate 1s linear infinite;\n    }\n  }\n\n  &:indeterminate .value {\n    visibility: hidden;\n  }\n\n  & > .value {\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 1s,\n        transform 0.5s 1s;\n    }\n    transform: translate3d(0, 0, 0);\n  }\n\n  @media (prefers-reduced-motion: no-preference) {\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) {\n      --value: 0 !important;\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount)::before {\n      opacity: 0;\n      transform: translate3d(0, 0, 0) scale(0.75);\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) > .value {\n      opacity: 0;\n      transform: translate3d(0, 10%, 0);\n    }\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css","content":"/**\n * @component progress-circle\n * @selector .pfx-progress-circle\n * @summary A circular progress ring driven by `--value` and `--value-max` custom properties.\n * @remarks The ring is a `conic-gradient` donut painted on `::before` and clipped with a radial-gradient mask; `--value` divided by `--value-max` drives the arc. Add `-should-animate` and load the interactions entry point to animate it from zero on mount. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), spinning the ring at a fixed arc and hiding `.value` since there's no meaningful number to show. `<meter>` has no indeterminate state, so it's unaffected.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate the meter, ring, and centered value into place on mount.\n * @modifier -should-animate-on-mount — @alias {@link -should-animate}\n * @modifier -shold-animate-on-mount — @alias {@link -should-animate}\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .value — The value text centred in the ring's hole.\n * @pseudo ::before — Draws the ring itself: a conic-gradient donut clipped with a radial mask, whose arc tracks the `--value` custom property.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; spins `::before` at a fixed arc and hides `.value`.\n * @cssproperty --value <number> — The current progress value; registered with @property so it can transition.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --animation-delay <number> — Milliseconds to wait before starting the mount animation (default `0`).\n * @cssproperty --pantoken-pc-fill <color> — The filled arc (meter) colour; the -color-* modifiers set it.\n * @cssproperty --pantoken-pc-track <color> — The unfilled track colour.\n * @cssproperty --pantoken-pc-stroke <length> — The ring's stroke width; the -size-* modifiers set it.\n * @a11y Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Registers the numeric progress properties with `@property` and paints with CSS `mask` and `conic-gradient`; where custom-property transitions are unsupported the ring still renders but won't animate.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"score\">Score</label>\n * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress-circle {\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress-circle {\n *     .value {}\n *   }\n * }\n * @related progress — The linear bar form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <div><label>Uploading notes <progress class=\"pfx-progress-circle -color-brand -size-xs\" value=\"70\" max=\"100\" style=\"--value: 70\">70%</progress></label></div>\n * <div><label>Preparing files <progress class=\"pfx-progress-circle -color-info -size-sm\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label></div>\n * <div><label>Reviews complete <progress class=\"pfx-progress-circle -color-success -size-md\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label></div>\n * <div><label>Storage used <progress class=\"pfx-progress-circle -color-warning -size-lg\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label></div>\n * <div><label>Failed transfers <progress class=\"pfx-progress-circle -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label></div>\n * <div><label>Starting upload <progress class=\"pfx-progress-circle\" value=\"0\" max=\"100\">0%</progress></label></div>\n * <div><label>Finding files <progress class=\"pfx-progress-circle\">Working</progress></label></div>\n * <label for=\"audit-review-score\">Review score</label>\n * <meter id=\"audit-review-score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\" style=\"--min: 20; --value: 40; --max: 60\">40 of 60</meter>\n * <div class=\"--bg-inverse --text-inverse --p-md\">\n *   <label>Background upload <progress class=\"pfx-progress-circle -color-primary-inverse -color-brand\" value=\"60\" max=\"100\" style=\"--value: 60\">60%</progress></label>\n *   <label>Preparing archive <progress class=\"pfx-progress-circle -color-primary-inverse -color-info\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label>\n *   <label>Archive ready <progress class=\"pfx-progress-circle -color-primary-inverse -color-success\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label>\n *   <label>Archive quota <progress class=\"pfx-progress-circle -color-primary-inverse -color-warning\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label>\n *   <label>Archive failures <progress class=\"pfx-progress-circle -color-primary-inverse -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label>\n * </div>\n * <p id=\"audit-circle-label\">Processing documents</p>\n * <div class=\"pfx-progress-circle -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-circle-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50\">\n *   <span class=\"value\">50%</span>\n * </div>\n * ```\n */\n\n@property --value {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --value-now {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --min {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --value-max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --animation-delay {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@scope (.pfx-progress-circle) {\n  & {\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    --animation-delay: 0;\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    color: var(--instui-component-progress-circle-color);\n    font-family: var(--instui-component-progress-circle-font-family);\n    font-weight: var(--instui-component-progress-circle-font-weight);\n    line-height: var(--instui-component-progress-circle-line-height);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: --value 1s;\n    }\n  }\n\n  /* The ring is a masked conic donut on ::before; the value sits in the hole. */\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar,\n  &::-webkit-progress-value,\n  &::-webkit-meter-bar,\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-moz-progress-bar,\n  &::-moz-meter-bar {\n    background: transparent;\n  }\n\n  &::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: 50%;\n    background: conic-gradient(\n      var(--pantoken-pc-fill)\n        clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%),\n      var(--pantoken-pc-track) 0\n    );\n    -webkit-mask: radial-gradient(\n      farthest-side,\n      #0000 calc(100% - var(--pantoken-pc-stroke)),\n      #000 0\n    );\n    mask: radial-gradient(farthest-side, #0000 calc(100% - var(--pantoken-pc-stroke)), #000 0);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      --pantoken-pc-fill: CanvasText;\n      --pantoken-pc-track: Canvas;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 0.2s,\n        transform 0.5s;\n    }\n    transform: translate3d(0, 0, 0) scale(1);\n  }\n\n  & .value {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  &.-size-xs {\n    width: var(--instui-component-progress-circle-x-small-size);\n    height: var(--instui-component-progress-circle-x-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-x-small-stroke-width);\n  }\n\n  &.-size-sm {\n    width: var(--instui-component-progress-circle-small-size);\n    height: var(--instui-component-progress-circle-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-small-stroke-width);\n  }\n\n  &.-size-md {\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n  }\n\n  &.-size-lg {\n    width: var(--instui-component-progress-circle-large-size);\n    height: var(--instui-component-progress-circle-large-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-large-stroke-width);\n  }\n\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n  }\n\n  &.-color-primary-inverse:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info);\n  }\n\n  &.-color-primary-inverse:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info-inverse);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success);\n  }\n\n  &.-color-primary-inverse:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success-inverse);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning);\n  }\n\n  &.-color-primary-inverse:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning-inverse);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger);\n  }\n\n  &.-color-primary-inverse:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger-inverse);\n  }\n\n  &.-color-primary-inverse {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color-inverse);\n    color: var(--instui-component-progress-circle-color-inverse);\n  }\n\n  /* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n     --value) reads as loading rather than rendering a static, potentially-empty ring. */\n  @keyframes pantoken-progress-circle-indeterminate {\n    to {\n      transform: rotate(1turn);\n    }\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate {\n    --value: 25;\n    --min: 0;\n    --max: 100;\n  }\n\n  &:indeterminate::before {\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-circle-indeterminate 1s linear infinite;\n    }\n  }\n\n  &:indeterminate .value {\n    visibility: hidden;\n  }\n\n  & > .value {\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 1s,\n        transform 0.5s 1s;\n    }\n    transform: translate3d(0, 0, 0);\n  }\n\n  @media (prefers-reduced-motion: no-preference) {\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) {\n      --value: 0 !important;\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount)::before {\n      opacity: 0;\n      transform: translate3d(0, 0, 0) scale(0.75);\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) > .value {\n      opacity: 0;\n      transform: translate3d(0, 10%, 0);\n    }\n  }\n}\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_ngvomRbtB2rjzm9A2QcYoPdP","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css\n@@ -68,12 +68,26 @@\n  * @sealed\n  * @example -automatica11y\n  * ```html\n- * <label>\n- *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n- * </label>\n- * \n- * <label for=\"score\">Score</label>\n- * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n+ * <div><label>Uploading notes <progress class=\"pfx-progress-circle -color-brand -size-xs\" value=\"70\" max=\"100\" style=\"--value: 70\">70%</progress></label></div>\n+ * <div><label>Preparing files <progress class=\"pfx-progress-circle -color-info -size-sm\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label></div>\n+ * <div><label>Reviews complete <progress class=\"pfx-progress-circle -color-success -size-md\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label></div>\n+ * <div><label>Storage used <progress class=\"pfx-progress-circle -color-warning -size-lg\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label></div>\n+ * <div><label>Failed transfers <progress class=\"pfx-progress-circle -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label></div>\n+ * <div><label>Starting upload <progress class=\"pfx-progress-circle\" value=\"0\" max=\"100\">0%</progress></label></div>\n+ * <div><label>Finding files <progress class=\"pfx-progress-circle\">Working</progress></label></div>\n+ * <label for=\"audit-review-score\">Review score</label>\n+ * <meter id=\"audit-review-score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\" style=\"--min: 20; --value: 40; --max: 60\">40 of 60</meter>\n+ * <div class=\"--bg-inverse --text-inverse --p-md\">\n+ *   <label>Background upload <progress class=\"pfx-progress-circle -color-primary-inverse -color-brand\" value=\"60\" max=\"100\" style=\"--value: 60\">60%</progress></label>\n+ *   <label>Preparing archive <progress class=\"pfx-progress-circle -color-primary-inverse -color-info\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label>\n+ *   <label>Archive ready <progress class=\"pfx-progress-circle -color-primary-inverse -color-success\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label>\n+ *   <label>Archive quota <progress class=\"pfx-progress-circle -color-primary-inverse -color-warning\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label>\n+ *   <label>Archive failures <progress class=\"pfx-progress-circle -color-primary-inverse -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label>\n+ * </div>\n+ * <p id=\"audit-circle-label\">Processing documents</p>\n+ * <div class=\"pfx-progress-circle -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-circle-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50\">\n+ *   <span class=\"value\">50%</span>\n+ * </div>\n  * ```\n  */\n \n","newFileContents":"/**\n * @component progress-circle\n * @selector .pfx-progress-circle\n * @summary A circular progress ring driven by `--value` and `--value-max` custom properties.\n * @remarks The ring is a `conic-gradient` donut painted on `::before` and clipped with a radial-gradient mask; `--value` divided by `--value-max` drives the arc. Add `-should-animate` and load the interactions entry point to animate it from zero on mount. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), spinning the ring at a fixed arc and hiding `.value` since there's no meaningful number to show. `<meter>` has no indeterminate state, so it's unaffected.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate the meter, ring, and centered value into place on mount.\n * @modifier -should-animate-on-mount — @alias {@link -should-animate}\n * @modifier -shold-animate-on-mount — @alias {@link -should-animate}\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .value — The value text centred in the ring's hole.\n * @pseudo ::before — Draws the ring itself: a conic-gradient donut clipped with a radial mask, whose arc tracks the `--value` custom property.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; spins `::before` at a fixed arc and hides `.value`.\n * @cssproperty --value <number> — The current progress value; registered with @property so it can transition.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --animation-delay <number> — Milliseconds to wait before starting the mount animation (default `0`).\n * @cssproperty --pantoken-pc-fill <color> — The filled arc (meter) colour; the -color-* modifiers set it.\n * @cssproperty --pantoken-pc-track <color> — The unfilled track colour.\n * @cssproperty --pantoken-pc-stroke <length> — The ring's stroke width; the -size-* modifiers set it.\n * @a11y Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Registers the numeric progress properties with `@property` and paints with CSS `mask` and `conic-gradient`; where custom-property transitions are unsupported the ring still renders but won't animate.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"score\">Score</label>\n * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress-circle {\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress-circle {\n *     .value {}\n *   }\n * }\n * @related progress — The linear bar form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <div><label>Uploading notes <progress class=\"pfx-progress-circle -color-brand -size-xs\" value=\"70\" max=\"100\" style=\"--value: 70\">70%</progress></label></div>\n * <div><label>Preparing files <progress class=\"pfx-progress-circle -color-info -size-sm\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label></div>\n * <div><label>Reviews complete <progress class=\"pfx-progress-circle -color-success -size-md\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label></div>\n * <div><label>Storage used <progress class=\"pfx-progress-circle -color-warning -size-lg\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label></div>\n * <div><label>Failed transfers <progress class=\"pfx-progress-circle -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label></div>\n * <div><label>Starting upload <progress class=\"pfx-progress-circle\" value=\"0\" max=\"100\">0%</progress></label></div>\n * <div><label>Finding files <progress class=\"pfx-progress-circle\">Working</progress></label></div>\n * <label for=\"audit-review-score\">Review score</label>\n * <meter id=\"audit-review-score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\" style=\"--min: 20; --value: 40; --max: 60\">40 of 60</meter>\n * <div class=\"--bg-inverse --text-inverse --p-md\">\n *   <label>Background upload <progress class=\"pfx-progress-circle -color-primary-inverse -color-brand\" value=\"60\" max=\"100\" style=\"--value: 60\">60%</progress></label>\n *   <label>Preparing archive <progress class=\"pfx-progress-circle -color-primary-inverse -color-info\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label>\n *   <label>Archive ready <progress class=\"pfx-progress-circle -color-primary-inverse -color-success\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label>\n *   <label>Archive quota <progress class=\"pfx-progress-circle -color-primary-inverse -color-warning\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label>\n *   <label>Archive failures <progress class=\"pfx-progress-circle -color-primary-inverse -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label>\n * </div>\n * <p id=\"audit-circle-label\">Processing documents</p>\n * <div class=\"pfx-progress-circle -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-circle-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50\">\n *   <span class=\"value\">50%</span>\n * </div>\n * ```\n */\n\n@property --value {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --value-now {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --min {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --value-max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --animation-delay {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@scope (.pfx-progress-circle) {\n  & {\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    --animation-delay: 0;\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    color: var(--instui-component-progress-circle-color);\n    font-family: var(--instui-component-progress-circle-font-family);\n    font-weight: var(--instui-component-progress-circle-font-weight);\n    line-height: var(--instui-component-progress-circle-line-height);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: --value 1s;\n    }\n  }\n\n  /* The ring is a masked conic donut on ::before; the value sits in the hole. */\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar,\n  &::-webkit-progress-value,\n  &::-webkit-meter-bar,\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-moz-progress-bar,\n  &::-moz-meter-bar {\n    background: transparent;\n  }\n\n  &::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: 50%;\n    background: conic-gradient(\n      var(--pantoken-pc-fill)\n        clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%),\n      var(--pantoken-pc-track) 0\n    );\n    -webkit-mask: radial-gradient(\n      farthest-side,\n      #0000 calc(100% - var(--pantoken-pc-stroke)),\n      #000 0\n    );\n    mask: radial-gradient(farthest-side, #0000 calc(100% - var(--pantoken-pc-stroke)), #000 0);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      --pantoken-pc-fill: CanvasText;\n      --pantoken-pc-track: Canvas;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 0.2s,\n        transform 0.5s;\n    }\n    transform: translate3d(0, 0, 0) scale(1);\n  }\n\n  & .value {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  &.-size-xs {\n    width: var(--instui-component-progress-circle-x-small-size);\n    height: var(--instui-component-progress-circle-x-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-x-small-stroke-width);\n  }\n\n  &.-size-sm {\n    width: var(--instui-component-progress-circle-small-size);\n    height: var(--instui-component-progress-circle-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-small-stroke-width);\n  }\n\n  &.-size-md {\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n  }\n\n  &.-size-lg {\n    width: var(--instui-component-progress-circle-large-size);\n    height: var(--instui-component-progress-circle-large-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-large-stroke-width);\n  }\n\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n  }\n\n  &.-color-primary-inverse:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info);\n  }\n\n  &.-color-primary-inverse:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info-inverse);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success);\n  }\n\n  &.-color-primary-inverse:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success-inverse);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning);\n  }\n\n  &.-color-primary-inverse:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning-inverse);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger);\n  }\n\n  &.-color-primary-inverse:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger-inverse);\n  }\n\n  &.-color-primary-inverse {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color-inverse);\n    color: var(--instui-component-progress-circle-color-inverse);\n  }\n\n  /* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n     --value) reads as loading rather than rendering a static, potentially-empty ring. */\n  @keyframes pantoken-progress-circle-indeterminate {\n    to {\n      transform: rotate(1turn);\n    }\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate {\n    --value: 25;\n    --min: 0;\n    --max: 100;\n  }\n\n  &:indeterminate::before {\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-circle-indeterminate 1s linear infinite;\n    }\n  }\n\n  &:indeterminate .value {\n    visibility: hidden;\n  }\n\n  & > .value {\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 1s,\n        transform 0.5s 1s;\n    }\n    transform: translate3d(0, 0, 0);\n  }\n\n  @media (prefers-reduced-motion: no-preference) {\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) {\n      --value: 0 !important;\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount)::before {\n      opacity: 0;\n      transform: translate3d(0, 0, 0) scale(0.75);\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) > .value {\n      opacity: 0;\n      transform: translate3d(0, 10%, 0);\n    }\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css","content":"/**\n * @component progress-circle\n * @selector .pfx-progress-circle\n * @summary A circular progress ring driven by `--value` and `--value-max` custom properties.\n * @remarks The ring is a `conic-gradient` donut painted on `::before` and clipped with a radial-gradient mask; `--value` divided by `--value-max` drives the arc. Add `-should-animate` and load the interactions entry point to animate it from zero on mount. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), spinning the ring at a fixed arc and hiding `.value` since there's no meaningful number to show. `<meter>` has no indeterminate state, so it's unaffected.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate the meter, ring, and centered value into place on mount.\n * @modifier -should-animate-on-mount — @alias {@link -should-animate}\n * @modifier -shold-animate-on-mount — @alias {@link -should-animate}\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .value — The value text centred in the ring's hole.\n * @pseudo ::before — Draws the ring itself: a conic-gradient donut clipped with a radial mask, whose arc tracks the `--value` custom property.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; spins `::before` at a fixed arc and hides `.value`.\n * @cssproperty --value <number> — The current progress value; registered with @property so it can transition.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --animation-delay <number> — Milliseconds to wait before starting the mount animation (default `0`).\n * @cssproperty --pantoken-pc-fill <color> — The filled arc (meter) colour; the -color-* modifiers set it.\n * @cssproperty --pantoken-pc-track <color> — The unfilled track colour.\n * @cssproperty --pantoken-pc-stroke <length> — The ring's stroke width; the -size-* modifiers set it.\n * @a11y Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Registers the numeric progress properties with `@property` and paints with CSS `mask` and `conic-gradient`; where custom-property transitions are unsupported the ring still renders but won't animate.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"score\">Score</label>\n * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress-circle {\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress-circle {\n *     .value {}\n *   }\n * }\n * @related progress — The linear bar form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n * </label>\n * \n * <label for=\"score\">Score</label>\n * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n */\n\n@property --value {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --value-now {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --min {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --value-max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --animation-delay {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@scope (.pfx-progress-circle) {\n  & {\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    --animation-delay: 0;\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    color: var(--instui-component-progress-circle-color);\n    font-family: var(--instui-component-progress-circle-font-family);\n    font-weight: var(--instui-component-progress-circle-font-weight);\n    line-height: var(--instui-component-progress-circle-line-height);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: --value 1s;\n    }\n  }\n\n  /* The ring is a masked conic donut on ::before; the value sits in the hole. */\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar,\n  &::-webkit-progress-value,\n  &::-webkit-meter-bar,\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-moz-progress-bar,\n  &::-moz-meter-bar {\n    background: transparent;\n  }\n\n  &::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: 50%;\n    background: conic-gradient(\n      var(--pantoken-pc-fill)\n        clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%),\n      var(--pantoken-pc-track) 0\n    );\n    -webkit-mask: radial-gradient(\n      farthest-side,\n      #0000 calc(100% - var(--pantoken-pc-stroke)),\n      #000 0\n    );\n    mask: radial-gradient(farthest-side, #0000 calc(100% - var(--pantoken-pc-stroke)), #000 0);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      --pantoken-pc-fill: CanvasText;\n      --pantoken-pc-track: Canvas;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 0.2s,\n        transform 0.5s;\n    }\n    transform: translate3d(0, 0, 0) scale(1);\n  }\n\n  & .value {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  &.-size-xs {\n    width: var(--instui-component-progress-circle-x-small-size);\n    height: var(--instui-component-progress-circle-x-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-x-small-stroke-width);\n  }\n\n  &.-size-sm {\n    width: var(--instui-component-progress-circle-small-size);\n    height: var(--instui-component-progress-circle-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-small-stroke-width);\n  }\n\n  &.-size-md {\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n  }\n\n  &.-size-lg {\n    width: var(--instui-component-progress-circle-large-size);\n    height: var(--instui-component-progress-circle-large-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-large-stroke-width);\n  }\n\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n  }\n\n  &.-color-primary-inverse:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info);\n  }\n\n  &.-color-primary-inverse:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info-inverse);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success);\n  }\n\n  &.-color-primary-inverse:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success-inverse);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning);\n  }\n\n  &.-color-primary-inverse:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning-inverse);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger);\n  }\n\n  &.-color-primary-inverse:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger-inverse);\n  }\n\n  &.-color-primary-inverse {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color-inverse);\n    color: var(--instui-component-progress-circle-color-inverse);\n  }\n\n  /* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n     --value) reads as loading rather than rendering a static, potentially-empty ring. */\n  @keyframes pantoken-progress-circle-indeterminate {\n    to {\n      transform: rotate(1turn);\n    }\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate {\n    --value: 25;\n    --min: 0;\n    --max: 100;\n  }\n\n  &:indeterminate::before {\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-circle-indeterminate 1s linear infinite;\n    }\n  }\n\n  &:indeterminate .value {\n    visibility: hidden;\n  }\n\n  & > .value {\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 1s,\n        transform 0.5s 1s;\n    }\n    transform: translate3d(0, 0, 0);\n  }\n\n  @media (prefers-reduced-motion: no-preference) {\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) {\n      --value: 0 !important;\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount)::before {\n      opacity: 0;\n      transform: translate3d(0, 0, 0) scale(0.75);\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) > .value {\n      opacity: 0;\n      transform: translate3d(0, 10%, 0);\n    }\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/progress-circle/progress-circle.css","content":"/**\n * @component progress-circle\n * @selector .pfx-progress-circle\n * @summary A circular progress ring driven by `--value` and `--value-max` custom properties.\n * @remarks The ring is a `conic-gradient` donut painted on `::before` and clipped with a radial-gradient mask; `--value` divided by `--value-max` drives the arc. Add `-should-animate` and load the interactions entry point to animate it from zero on mount. InstUI has no indeterminate state; `:indeterminate` is a pantoken-only best guess (native `<progress>` without a `value` attribute), spinning the ring at a fixed arc and hiding `.value` since there's no meaningful number to show. `<meter>` has no indeterminate state, so it's unaffected.\n * @element progress, meter\n * @modifier -color-brand — Brand meter colour.\n * @modifier -color-info — Informational meter colour.\n * @modifier -color-success — Success meter colour.\n * @modifier -color-warning — Warning meter colour.\n * @modifier -color-danger — Danger meter colour.\n * @modifier -color-primary-inverse — On-dark (primary inverse) meter colour.\n * @modifier -size-xs — Extra small.\n * @modifier -size-sm — Small.\n * @modifier -size-md — Medium (default).\n * @modifier -size-lg — Large.\n * @modifier -should-animate — @interaction Animate the meter, ring, and centered value into place on mount.\n * @modifier -should-animate-on-mount — @alias {@link -should-animate}\n * @modifier -shold-animate-on-mount — @alias {@link -should-animate}\n * @modifier -meter-color-brand — @deprecated {@link -color-brand}\n * @modifier -meter-color-info — @deprecated {@link -color-info}\n * @modifier -meter-color-success — @deprecated {@link -color-success}\n * @modifier -meter-color-warning — @deprecated {@link -color-warning}\n * @modifier -meter-color-alert — @deprecated {@link -color-warning}\n * @modifier -meter-color-danger — @deprecated {@link -color-danger}\n * @part .value — The value text centred in the ring's hole.\n * @pseudo ::before — Draws the ring itself: a conic-gradient donut clipped with a radial mask, whose arc tracks the `--value` custom property.\n * @pseudo :indeterminate — Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; spins `::before` at a fixed arc and hides `.value`.\n * @cssproperty --value <number> — The current progress value; registered with @property so it can transition.\n * @cssproperty --value-now <number> — @alias Alias for `--value`.\n * @cssproperty --min <number> — The minimum meter value (default `0`).\n * @cssproperty --max <number> — The maximum progress value (default `100`).\n * @cssproperty --value-max <number> — @alias {@link --max} The maximum progress value (default `100`).\n * @cssproperty --animation-delay <number> — Milliseconds to wait before starting the mount animation (default `0`).\n * @cssproperty --pantoken-pc-fill <color> — The filled arc (meter) colour; the -color-* modifiers set it.\n * @cssproperty --pantoken-pc-track <color> — The unfilled track colour.\n * @cssproperty --pantoken-pc-stroke <length> — The ring's stroke width; the -size-* modifiers set it.\n * @a11y Use native `<progress>` for a zero-based task completion range and `<meter>` when the minimum is non-zero. Give either element an accessible name by nesting it in `<label>` or associating a separate `<label>` through matching `for` and `id` values.\n * @compat Registers the numeric progress properties with `@property` and paints with CSS `mask` and `conic-gradient`; where custom-property transitions are unsupported the ring still renders but won't animate.\n * @example -canvas-rce -docs\n * ### Nested label\n * ```html -canvas-rce -docs\n * <label>\n *   Uploading Document: <progress class=\"pfx-progress-circle -size-sm\" value=\"70\">70%</progress>\n * </label>\n * ```\n * ### External label\n * ```html\n * <label for=\"score\">Score</label>\n * <meter id=\"score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\">50%</meter>\n * ```\n * @structure\n * @variant nested-label {\n *   label {\n *     .pfx-progress-circle {\n *       .value {}\n *     }\n *   }\n * }\n * @variant external-label {\n *   label {}\n *   .pfx-progress-circle {\n *     .value {}\n *   }\n * }\n * @related progress — The linear bar form of the same determinate progress.\n * @stable\n * @sealed\n * @example -automatica11y\n * ```html\n * <div><label>Uploading notes <progress class=\"pfx-progress-circle -color-brand -size-xs\" value=\"70\" max=\"100\" style=\"--value: 70\">70%</progress></label></div>\n * <div><label>Preparing files <progress class=\"pfx-progress-circle -color-info -size-sm\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label></div>\n * <div><label>Reviews complete <progress class=\"pfx-progress-circle -color-success -size-md\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label></div>\n * <div><label>Storage used <progress class=\"pfx-progress-circle -color-warning -size-lg\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label></div>\n * <div><label>Failed transfers <progress class=\"pfx-progress-circle -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label></div>\n * <div><label>Starting upload <progress class=\"pfx-progress-circle\" value=\"0\" max=\"100\">0%</progress></label></div>\n * <div><label>Finding files <progress class=\"pfx-progress-circle\">Working</progress></label></div>\n * <label for=\"audit-review-score\">Review score</label>\n * <meter id=\"audit-review-score\" class=\"pfx-progress-circle -color-success\" min=\"20\" value=\"40\" max=\"60\" style=\"--min: 20; --value: 40; --max: 60\">40 of 60</meter>\n * <div class=\"--bg-inverse --text-inverse --p-md\">\n *   <label>Background upload <progress class=\"pfx-progress-circle -color-primary-inverse -color-brand\" value=\"60\" max=\"100\" style=\"--value: 60\">60%</progress></label>\n *   <label>Preparing archive <progress class=\"pfx-progress-circle -color-primary-inverse -color-info\" value=\"40\" max=\"100\" style=\"--value: 40\">40%</progress></label>\n *   <label>Archive ready <progress class=\"pfx-progress-circle -color-primary-inverse -color-success\" value=\"100\" max=\"100\" style=\"--value: 100\">100%</progress></label>\n *   <label>Archive quota <progress class=\"pfx-progress-circle -color-primary-inverse -color-warning\" value=\"85\" max=\"100\" style=\"--value: 85\">85%</progress></label>\n *   <label>Archive failures <progress class=\"pfx-progress-circle -color-primary-inverse -color-danger\" value=\"20\" max=\"100\" style=\"--value: 20\">20%</progress></label>\n * </div>\n * <p id=\"audit-circle-label\">Processing documents</p>\n * <div class=\"pfx-progress-circle -should-animate\" role=\"progressbar\" aria-labelledby=\"audit-circle-label\" aria-valuenow=\"50\" aria-valuemin=\"0\" aria-valuemax=\"100\" style=\"--value: 50\">\n *   <span class=\"value\">50%</span>\n * </div>\n * ```\n */\n\n@property --value {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --value-now {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --min {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@property --max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --value-max {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 100;\n}\n\n@property --animation-delay {\n  syntax: \"<number>\";\n  inherits: true;\n  initial-value: 0;\n}\n\n@scope (.pfx-progress-circle) {\n  & {\n    --value: var(--value-now);\n    --min: 0;\n    --max: var(--value-max);\n    --animation-delay: 0;\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    color: var(--instui-component-progress-circle-color);\n    font-family: var(--instui-component-progress-circle-font-family);\n    font-weight: var(--instui-component-progress-circle-font-weight);\n    line-height: var(--instui-component-progress-circle-line-height);\n    @media (prefers-reduced-motion: no-preference) {\n      transition: --value 1s;\n    }\n  }\n\n  /* The ring is a masked conic donut on ::before; the value sits in the hole. */\n  &:is(progress, meter) {\n    appearance: none;\n  }\n\n  &::-webkit-progress-bar,\n  &::-webkit-progress-value,\n  &::-webkit-meter-bar,\n  &::-webkit-meter-optimum-value,\n  &::-webkit-meter-suboptimum-value,\n  &::-webkit-meter-even-less-good-value {\n    background: transparent;\n    border: 0;\n    box-shadow: none;\n  }\n\n  &::-moz-progress-bar,\n  &::-moz-meter-bar {\n    background: transparent;\n  }\n\n  &::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    border-radius: 50%;\n    background: conic-gradient(\n      var(--pantoken-pc-fill)\n        clamp(0%, calc((var(--value) - var(--min)) / (var(--max) - var(--min)) * 100%), 100%),\n      var(--pantoken-pc-track) 0\n    );\n    -webkit-mask: radial-gradient(\n      farthest-side,\n      #0000 calc(100% - var(--pantoken-pc-stroke)),\n      #000 0\n    );\n    mask: radial-gradient(farthest-side, #0000 calc(100% - var(--pantoken-pc-stroke)), #000 0);\n    @media (forced-colors: active) {\n      forced-color-adjust: preserve-parent-color;\n      --pantoken-pc-fill: CanvasText;\n      --pantoken-pc-track: Canvas;\n    }\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 0.2s,\n        transform 0.5s;\n    }\n    transform: translate3d(0, 0, 0) scale(1);\n  }\n\n  & .value {\n    position: relative;\n    z-index: 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  &.-size-xs {\n    width: var(--instui-component-progress-circle-x-small-size);\n    height: var(--instui-component-progress-circle-x-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-x-small-stroke-width);\n  }\n\n  &.-size-sm {\n    width: var(--instui-component-progress-circle-small-size);\n    height: var(--instui-component-progress-circle-small-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-small-stroke-width);\n  }\n\n  &.-size-md {\n    width: var(--instui-component-progress-circle-medium-size);\n    height: var(--instui-component-progress-circle-medium-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-medium-stroke-width);\n  }\n\n  &.-size-lg {\n    width: var(--instui-component-progress-circle-large-size);\n    height: var(--instui-component-progress-circle-large-size);\n    --pantoken-pc-stroke: var(--instui-component-progress-circle-large-stroke-width);\n  }\n\n  &:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand);\n  }\n\n  &.-color-primary-inverse:is(.-color-brand, .-meter-color-brand) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n  }\n\n  &:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info);\n  }\n\n  &.-color-primary-inverse:is(.-color-info, .-meter-color-info) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-info-inverse);\n  }\n\n  &:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success);\n  }\n\n  &.-color-primary-inverse:is(.-color-success, .-meter-color-success) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-success-inverse);\n  }\n\n  &:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning);\n  }\n\n  &.-color-primary-inverse:is(.-color-warning, .-meter-color-warning, .-meter-color-alert) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-warning-inverse);\n  }\n\n  &:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger);\n  }\n\n  &.-color-primary-inverse:is(.-color-danger, .-meter-color-danger) {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-danger-inverse);\n  }\n\n  &.-color-primary-inverse {\n    --pantoken-pc-fill: var(--instui-component-progress-circle-meter-color-brand-inverse);\n    --pantoken-pc-track: var(--instui-component-progress-circle-track-color-inverse);\n    color: var(--instui-component-progress-circle-color-inverse);\n  }\n\n  /* Not an InstUI concept: a best guess so a <progress> missing its value attribute (or fed a bad\n     --value) reads as loading rather than rendering a static, potentially-empty ring. */\n  @keyframes pantoken-progress-circle-indeterminate {\n    to {\n      transform: rotate(1turn);\n    }\n  }\n\n  /* :indeterminate only matches a valueless <progress>; <meter> always requires a value. */\n  &:indeterminate {\n    --value: 25;\n    --min: 0;\n    --max: 100;\n  }\n\n  &:indeterminate::before {\n    @media (prefers-reduced-motion: no-preference) {\n      animation: pantoken-progress-circle-indeterminate 1s linear infinite;\n    }\n  }\n\n  &:indeterminate .value {\n    visibility: hidden;\n  }\n\n  & > .value {\n    @media (prefers-reduced-motion: no-preference) {\n      transition:\n        opacity 0.5s 1s,\n        transform 0.5s 1s;\n    }\n    transform: translate3d(0, 0, 0);\n  }\n\n  @media (prefers-reduced-motion: no-preference) {\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) {\n      --value: 0 !important;\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount)::before {\n      opacity: 0;\n      transform: translate3d(0, 0, 0) scale(0.75);\n    }\n\n    &:is(.-should-animate, .-should-animate-on-mount, .-shold-animate-on-mount) > .value {\n      opacity: 0;\n      transform: translate3d(0, 10%, 0);\n    }\n  }\n}\n"}}],"_permissionRequestSessionId":"44e9bcbc-c0c2-4d54-9c7b-2558508ad507","assistedApproval":{"recommendation":"approve","reason":"Explicitly authorized accessibility-fixture update within the requested project scope.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"44e9bcbc-c0c2-4d54-9c7b-2558508ad507"},"agentId":"78631379-5bbe-4a0d