token/formats/components/src/components/in-place-edit/in-place-edit.css\\\\nindex 0000000..0000000 100644\\\\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/in-place-edit/in-place-edit.css\\\\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/in-place-edit/in-place-edit.css\\\\n@@ -13,7 +13,8 @@\\\\n  * @demo self:in-place-edit\\\\n  * @example -automatica11y\\\\n  * ```html\\\\n- * <span class=\\\\\\\"pfx-in-place-edit\\\\\\\" contenteditable=\\\\\\\"true\\\\\\\" role=\\\\\\\"textbox\\\\\\\" aria-label=\\\\\\\"Project name\\\\\\\">Untitled</span>\\\\n+ * <p><span id=\\\\\\\"audit-project-label\\\\\\\">Project name</span>: <span class=\\\\\\\"pfx-in-place-edit\\\\\\\" contenteditable=\\\\\\\"true\\\\\\\" role=\\\\\\\"textbox\\\\\\\" aria-labelledby=\\\\\\\"audit-project-label\\\\\\\">Untitled</span></p>\\\\n+ * <p><span id=\\\\\\\"audit-project-locked-label\\\\\\\">Locked project name</span>: <span class=\\\\\\\"pfx-in-place-edit -readonly\\\\\\\" contenteditable=\\\\\\\"false\\\\\\\" role=\\\\\\\"textbox\\\\\\\" aria-readonly=\\\\\\\"true\\\\\\\" aria-labelledby=\\\\\\\"audit-project-locked-label\\\\\\\">Published project</span></p>\\\\n  * ```\\\\n  */\\\\n @scope (.pfx-in-place-edit) {\\\\n\\\",\\n  \\\"newFileContents\\\": \\\"/**\\\\n * @component in-place-edit\\\\n * @selector .pfx-in-place-edit\\\\n * @summary A [contenteditable] that reads as text until focused, then shows input chrome.\\\\n * @remarks The input chrome only appears while focused; `-readonly` suppresses both the hover and focus affordances so the element always reads as plain inline text.\\\\n * @modifier -readonly — Shown inline but not editable (no hover/focus affordance).\\\\n * @a11y Give the editable element `role=\\\\\\\"textbox\\\\\\\"` and an accessible name (`aria-label`).\\\\n * @example -canvas-rce -docs\\\\n * ```html\\\\n * <span class=\\\\\\\"pfx-in-place-edit\\\\\\\" contenteditable=\\\\\\\"true\\\\\\\" role=\\\\\\\"textbox\\\\\\\" aria-