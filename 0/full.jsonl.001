{"type":"permission.requested","data":{"requestId":"66379d3a-7ffe-4017-96f2-344b1325471a","permissionRequest":{"kind":"write","toolCallId":"custom_call_vwFQwv2RaBOfkTL8HzNp5qrH","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css\n@@ -28,11 +28,26 @@\n  * }\n  * @example -automatica11y\n  * ```html\n- * <label class=\"pfx-file-drop\" id=\"fd\">\n- *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n- *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n- *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n- *   <input type=\"file\" id=\"fd-input\">\n+ * <label class=\"pfx-file-drop\">\n+ *   <span class=\"-icon-cloud-upload\" aria-hidden=\"true\"></span>\n+ *   <span id=\"audit-file-label\">Upload an image</span>\n+ *   <span id=\"audit-file-hint\">Choose a PNG or JPEG file, up to 5 MB.</span>\n+ *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-label\" aria-describedby=\"audit-file-hint\">\n+ * </label>\n+ * <label class=\"pfx-file-drop -hover\">\n+ *   <span id=\"audit-file-hover-label\">Upload while dragging a file</span>\n+ *   <span id=\"audit-file-hover-hint\">Drop the file here, or use the file picker.</span>\n+ *   <input type=\"file\" aria-labelledby=\"audit-file-hover-label\" aria-describedby=\"audit-file-hover-hint\">\n+ * </label>\n+ * <label class=\"pfx-file-drop -accepted\">\n+ *   <span id=\"audit-file-accepted-label\">Upload an acceptable image</span>\n+ *   <span id=\"audit-file-accepted-hint\">This file type is accepted: PNG or JPEG.</span>\n+ *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-accepted-label\" aria-describedby=\"audit-file-accepted-hint\">\n+ * </label>\n+ * <label class=\"pfx-file-drop -rejected\">\n+ *   <span id=\"audit-file-rejected-label\">Replace a rejected image</span>\n+ *   <span id=\"audit-file-error\">File rejected. Choose a PNG or JPEG file, up to 5 MB.</span>\n+ *   <input type=\"file\" accept=\"image/png,image/jpeg\" required aria-invalid=\"true\" aria-labelledby=\"audit-file-rejected-label\" aria-describedby=\"audit-file-error\">\n  * </label>\n  * ```\n  */\n","newFileContents":"/**\n * @component file-drop\n * @selector .pfx-file-drop\n * @summary A file dropzone with hover, accepted, and rejected states.\n * @remarks The `-hover`/`-accepted`/`-rejected` classes are purely visual — actual drag-and-drop detection and file validation are the consumer's JS to wire up around the wrapped native input.\n * @modifier -icon-* — Render the leading dropzone glyph icon.\n * @modifier -accepted — Drag state for an acceptable file.\n * @modifier -hover — Hover or drag-over state.\n * @modifier -rejected — Drag state for a rejected file.\n * @accessibility Wrap a native `<input type=\"file\">` in the `<label>` drop zone so it stays a real, labelled file control that the keyboard and assistive tech can operate.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-file-drop\" id=\"fd\">\n *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n *   <input type=\"file\" id=\"fd-input\">\n * </label>\n * ```\n * @structure\n * .pfx-file-drop {\n *   [class*=\"-icon-\"]:optional {}\n *   .pfx-text {\n *     strong {}\n *   }\n *   .pfx-text {}\n *   input {}\n * }\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-file-drop\">\n *   <span class=\"-icon-cloud-upload\" aria-hidden=\"true\"></span>\n *   <span id=\"audit-file-label\">Upload an image</span>\n *   <span id=\"audit-file-hint\">Choose a PNG or JPEG file, up to 5 MB.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-label\" aria-describedby=\"audit-file-hint\">\n * </label>\n * <label class=\"pfx-file-drop -hover\">\n *   <span id=\"audit-file-hover-label\">Upload while dragging a file</span>\n *   <span id=\"audit-file-hover-hint\">Drop the file here, or use the file picker.</span>\n *   <input type=\"file\" aria-labelledby=\"audit-file-hover-label\" aria-describedby=\"audit-file-hover-hint\">\n * </label>\n * <label class=\"pfx-file-drop -accepted\">\n *   <span id=\"audit-file-accepted-label\">Upload an acceptable image</span>\n *   <span id=\"audit-file-accepted-hint\">This file type is accepted: PNG or JPEG.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-accepted-label\" aria-describedby=\"audit-file-accepted-hint\">\n * </label>\n * <label class=\"pfx-file-drop -rejected\">\n *   <span id=\"audit-file-rejected-label\">Replace a rejected image</span>\n *   <span id=\"audit-file-error\">File rejected. Choose a PNG or JPEG file, up to 5 MB.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" required aria-invalid=\"true\" aria-labelledby=\"audit-file-rejected-label\" aria-describedby=\"audit-file-error\">\n * </label>\n * ```\n */\n@scope (.pfx-file-drop) {\n  & {\n    display: block;\n    text-align: center;\n    padding: var(--instui-spacing-space-lg);\n    color: var(--instui-color-text-base);\n    background: var(--instui-component-file-drop-background-color);\n    border: var(--instui-component-file-drop-border-width)\n      var(--instui-component-file-drop-border-style) var(--instui-component-file-drop-border-color);\n    border-radius: var(--instui-component-file-drop-border-radius);\n  }\n\n  &:hover,\n  &.-hover {\n    border-color: var(--instui-component-file-drop-hover-border-color);\n  }\n\n  &.-accepted {\n    border-color: var(--instui-component-file-drop-accepted-color);\n  }\n\n  &.-rejected {\n    border-color: var(--instui-component-file-drop-rejected-color);\n  }\n\n  & > :is([class^=\"-icon-\"], [class*=\" -icon-\"]) {\n    line-height: 1;\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css","content":"/**\n * @component file-drop\n * @selector .pfx-file-drop\n * @summary A file dropzone with hover, accepted, and rejected states.\n * @remarks The `-hover`/`-accepted`/`-rejected` classes are purely visual — actual drag-and-drop detection and file validation are the consumer's JS to wire up around the wrapped native input.\n * @modifier -icon-* — Render the leading dropzone glyph icon.\n * @modifier -accepted — Drag state for an acceptable file.\n * @modifier -hover — Hover or drag-over state.\n * @modifier -rejected — Drag state for a rejected file.\n * @accessibility Wrap a native `<input type=\"file\">` in the `<label>` drop zone so it stays a real, labelled file control that the keyboard and assistive tech can operate.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-file-drop\" id=\"fd\">\n *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n *   <input type=\"file\" id=\"fd-input\">\n * </label>\n * ```\n * @structure\n * .pfx-file-drop {\n *   [class*=\"-icon-\"]:optional {}\n *   .pfx-text {\n *     strong {}\n *   }\n *   .pfx-text {}\n *   input {}\n * }\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-file-drop\" id=\"fd\">\n *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n *   <input type=\"file\" id=\"fd-input\">\n * </label>\n * ```\n */\n@scope (.pfx-file-drop) {\n  & {\n    display: block;\n    text-align: center;\n    padding: var(--instui-spacing-space-lg);\n    color: var(--instui-color-text-base);\n    background: var(--instui-component-file-drop-background-color);\n    border: var(--instui-component-file-drop-border-width)\n      var(--instui-component-file-drop-border-style) var(--instui-component-file-drop-border-color);\n    border-radius: var(--instui-component-file-drop-border-radius);\n  }\n\n  &:hover,\n  &.-hover {\n    border-color: var(--instui-component-file-drop-hover-border-color);\n  }\n\n  &.-accepted {\n    border-color: var(--instui-component-file-drop-accepted-color);\n  }\n\n  &.-rejected {\n    border-color: var(--instui-component-file-drop-rejected-color);\n  }\n\n  & > :is([class^=\"-icon-\"], [class*=\" -icon-\"]) {\n    line-height: 1;\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css","content":"/**\n * @component file-drop\n * @selector .pfx-file-drop\n * @summary A file dropzone with hover, accepted, and rejected states.\n * @remarks The `-hover`/`-accepted`/`-rejected` classes are purely visual — actual drag-and-drop detection and file validation are the consumer's JS to wire up around the wrapped native input.\n * @modifier -icon-* — Render the leading dropzone glyph icon.\n * @modifier -accepted — Drag state for an acceptable file.\n * @modifier -hover — Hover or drag-over state.\n * @modifier -rejected — Drag state for a rejected file.\n * @accessibility Wrap a native `<input type=\"file\">` in the `<label>` drop zone so it stays a real, labelled file control that the keyboard and assistive tech can operate.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-file-drop\" id=\"fd\">\n *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n *   <input type=\"file\" id=\"fd-input\">\n * </label>\n * ```\n * @structure\n * .pfx-file-drop {\n *   [class*=\"-icon-\"]:optional {}\n *   .pfx-text {\n *     strong {}\n *   }\n *   .pfx-text {}\n *   input {}\n * }\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-file-drop\">\n *   <span class=\"-icon-cloud-upload\" aria-hidden=\"true\"></span>\n *   <span id=\"audit-file-label\">Upload an image</span>\n *   <span id=\"audit-file-hint\">Choose a PNG or JPEG file, up to 5 MB.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-label\" aria-describedby=\"audit-file-hint\">\n * </label>\n * <label class=\"pfx-file-drop -hover\">\n *   <span id=\"audit-file-hover-label\">Upload while dragging a file</span>\n *   <span id=\"audit-file-hover-hint\">Drop the file here, or use the file picker.</span>\n *   <input type=\"file\" aria-labelledby=\"audit-file-hover-label\" aria-describedby=\"audit-file-hover-hint\">\n * </label>\n * <label class=\"pfx-file-drop -accepted\">\n *   <span id=\"audit-file-accepted-label\">Upload an acceptable image</span>\n *   <span id=\"audit-file-accepted-hint\">This file type is accepted: PNG or JPEG.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-accepted-label\" aria-describedby=\"audit-file-accepted-hint\">\n * </label>\n * <label class=\"pfx-file-drop -rejected\">\n *   <span id=\"audit-file-rejected-label\">Replace a rejected image</span>\n *   <span id=\"audit-file-error\">File rejected. Choose a PNG or JPEG file, up to 5 MB.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" required aria-invalid=\"true\" aria-labelledby=\"audit-file-rejected-label\" aria-describedby=\"audit-file-error\">\n * </label>\n * ```\n */\n@scope (.pfx-file-drop) {\n  & {\n    display: block;\n    text-align: center;\n    padding: var(--instui-spacing-space-lg);\n    color: var(--instui-color-text-base);\n    background: var(--instui-component-file-drop-background-color);\n    border: var(--instui-component-file-drop-border-width)\n      var(--instui-component-file-drop-border-style) var(--instui-component-file-drop-border-color);\n    border-radius: var(--instui-component-file-drop-border-radius);\n  }\n\n  &:hover,\n  &.-hover {\n    border-color: var(--instui-component-file-drop-hover-border-color);\n  }\n\n  &.-accepted {\n    border-color: var(--instui-component-file-drop-accepted-color);\n  }\n\n  &.-rejected {\n    border-color: var(--instui-component-file-drop-rejected-color);\n  }\n\n  & > :is([class^=\"-icon-\"], [class*=\" -icon-\"]) {\n    line-height: 1;\n  }\n}\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_vwFQwv2RaBOfkTL8HzNp5qrH","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css\n@@ -28,11 +28,26 @@\n  * }\n  * @example -automatica11y\n  * ```html\n- * <label class=\"pfx-file-drop\" id=\"fd\">\n- *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n- *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n- *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n- *   <input type=\"file\" id=\"fd-input\">\n+ * <label class=\"pfx-file-drop\">\n+ *   <span class=\"-icon-cloud-upload\" aria-hidden=\"true\"></span>\n+ *   <span id=\"audit-file-label\">Upload an image</span>\n+ *   <span id=\"audit-file-hint\">Choose a PNG or JPEG file, up to 5 MB.</span>\n+ *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-label\" aria-describedby=\"audit-file-hint\">\n+ * </label>\n+ * <label class=\"pfx-file-drop -hover\">\n+ *   <span id=\"audit-file-hover-label\">Upload while dragging a file</span>\n+ *   <span id=\"audit-file-hover-hint\">Drop the file here, or use the file picker.</span>\n+ *   <input type=\"file\" aria-labelledby=\"audit-file-hover-label\" aria-describedby=\"audit-file-hover-hint\">\n+ * </label>\n+ * <label class=\"pfx-file-drop -accepted\">\n+ *   <span id=\"audit-file-accepted-label\">Upload an acceptable image</span>\n+ *   <span id=\"audit-file-accepted-hint\">This file type is accepted: PNG or JPEG.</span>\n+ *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-accepted-label\" aria-describedby=\"audit-file-accepted-hint\">\n+ * </label>\n+ * <label class=\"pfx-file-drop -rejected\">\n+ *   <span id=\"audit-file-rejected-label\">Replace a rejected image</span>\n+ *   <span id=\"audit-file-error\">File rejected. Choose a PNG or JPEG file, up to 5 MB.</span>\n+ *   <input type=\"file\" accept=\"image/png,image/jpeg\" required aria-invalid=\"true\" aria-labelledby=\"audit-file-rejected-label\" aria-describedby=\"audit-file-error\">\n  * </label>\n  * ```\n  */\n","newFileContents":"/**\n * @component file-drop\n * @selector .pfx-file-drop\n * @summary A file dropzone with hover, accepted, and rejected states.\n * @remarks The `-hover`/`-accepted`/`-rejected` classes are purely visual — actual drag-and-drop detection and file validation are the consumer's JS to wire up around the wrapped native input.\n * @modifier -icon-* — Render the leading dropzone glyph icon.\n * @modifier -accepted — Drag state for an acceptable file.\n * @modifier -hover — Hover or drag-over state.\n * @modifier -rejected — Drag state for a rejected file.\n * @accessibility Wrap a native `<input type=\"file\">` in the `<label>` drop zone so it stays a real, labelled file control that the keyboard and assistive tech can operate.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-file-drop\" id=\"fd\">\n *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n *   <input type=\"file\" id=\"fd-input\">\n * </label>\n * ```\n * @structure\n * .pfx-file-drop {\n *   [class*=\"-icon-\"]:optional {}\n *   .pfx-text {\n *     strong {}\n *   }\n *   .pfx-text {}\n *   input {}\n * }\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-file-drop\">\n *   <span class=\"-icon-cloud-upload\" aria-hidden=\"true\"></span>\n *   <span id=\"audit-file-label\">Upload an image</span>\n *   <span id=\"audit-file-hint\">Choose a PNG or JPEG file, up to 5 MB.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-label\" aria-describedby=\"audit-file-hint\">\n * </label>\n * <label class=\"pfx-file-drop -hover\">\n *   <span id=\"audit-file-hover-label\">Upload while dragging a file</span>\n *   <span id=\"audit-file-hover-hint\">Drop the file here, or use the file picker.</span>\n *   <input type=\"file\" aria-labelledby=\"audit-file-hover-label\" aria-describedby=\"audit-file-hover-hint\">\n * </label>\n * <label class=\"pfx-file-drop -accepted\">\n *   <span id=\"audit-file-accepted-label\">Upload an acceptable image</span>\n *   <span id=\"audit-file-accepted-hint\">This file type is accepted: PNG or JPEG.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-accepted-label\" aria-describedby=\"audit-file-accepted-hint\">\n * </label>\n * <label class=\"pfx-file-drop -rejected\">\n *   <span id=\"audit-file-rejected-label\">Replace a rejected image</span>\n *   <span id=\"audit-file-error\">File rejected. Choose a PNG or JPEG file, up to 5 MB.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" required aria-invalid=\"true\" aria-labelledby=\"audit-file-rejected-label\" aria-describedby=\"audit-file-error\">\n * </label>\n * ```\n */\n@scope (.pfx-file-drop) {\n  & {\n    display: block;\n    text-align: center;\n    padding: var(--instui-spacing-space-lg);\n    color: var(--instui-color-text-base);\n    background: var(--instui-component-file-drop-background-color);\n    border: var(--instui-component-file-drop-border-width)\n      var(--instui-component-file-drop-border-style) var(--instui-component-file-drop-border-color);\n    border-radius: var(--instui-component-file-drop-border-radius);\n  }\n\n  &:hover,\n  &.-hover {\n    border-color: var(--instui-component-file-drop-hover-border-color);\n  }\n\n  &.-accepted {\n    border-color: var(--instui-component-file-drop-accepted-color);\n  }\n\n  &.-rejected {\n    border-color: var(--instui-component-file-drop-rejected-color);\n  }\n\n  & > :is([class^=\"-icon-\"], [class*=\" -icon-\"]) {\n    line-height: 1;\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css","content":"/**\n * @component file-drop\n * @selector .pfx-file-drop\n * @summary A file dropzone with hover, accepted, and rejected states.\n * @remarks The `-hover`/`-accepted`/`-rejected` classes are purely visual — actual drag-and-drop detection and file validation are the consumer's JS to wire up around the wrapped native input.\n * @modifier -icon-* — Render the leading dropzone glyph icon.\n * @modifier -accepted — Drag state for an acceptable file.\n * @modifier -hover — Hover or drag-over state.\n * @modifier -rejected — Drag state for a rejected file.\n * @accessibility Wrap a native `<input type=\"file\">` in the `<label>` drop zone so it stays a real, labelled file control that the keyboard and assistive tech can operate.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-file-drop\" id=\"fd\">\n *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n *   <input type=\"file\" id=\"fd-input\">\n * </label>\n * ```\n * @structure\n * .pfx-file-drop {\n *   [class*=\"-icon-\"]:optional {}\n *   .pfx-text {\n *     strong {}\n *   }\n *   .pfx-text {}\n *   input {}\n * }\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-file-drop\" id=\"fd\">\n *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n *   <input type=\"file\" id=\"fd-input\">\n * </label>\n * ```\n */\n@scope (.pfx-file-drop) {\n  & {\n    display: block;\n    text-align: center;\n    padding: var(--instui-spacing-space-lg);\n    color: var(--instui-color-text-base);\n    background: var(--instui-component-file-drop-background-color);\n    border: var(--instui-component-file-drop-border-width)\n      var(--instui-component-file-drop-border-style) var(--instui-component-file-drop-border-color);\n    border-radius: var(--instui-component-file-drop-border-radius);\n  }\n\n  &:hover,\n  &.-hover {\n    border-color: var(--instui-component-file-drop-hover-border-color);\n  }\n\n  &.-accepted {\n    border-color: var(--instui-component-file-drop-accepted-color);\n  }\n\n  &.-rejected {\n    border-color: var(--instui-component-file-drop-rejected-color);\n  }\n\n  & > :is([class^=\"-icon-\"], [class*=\" -icon-\"]) {\n    line-height: 1;\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/file-drop/file-drop.css","content":"/**\n * @component file-drop\n * @selector .pfx-file-drop\n * @summary A file dropzone with hover, accepted, and rejected states.\n * @remarks The `-hover`/`-accepted`/`-rejected` classes are purely visual — actual drag-and-drop detection and file validation are the consumer's JS to wire up around the wrapped native input.\n * @modifier -icon-* — Render the leading dropzone glyph icon.\n * @modifier -accepted — Drag state for an acceptable file.\n * @modifier -hover — Hover or drag-over state.\n * @modifier -rejected — Drag state for a rejected file.\n * @accessibility Wrap a native `<input type=\"file\">` in the `<label>` drop zone so it stays a real, labelled file control that the keyboard and assistive tech can operate.\n * @example -canvas-rce -docs\n * ```html\n * <label class=\"pfx-file-drop\" id=\"fd\">\n *   <span class=\"pfx-icon -icon-cloud-upload\"></span>\n *   <div class=\"pfx-text\"><strong>Drag an image here</strong>, or click to browse.</div>\n *   <div class=\"pfx-text -size-sm pfx-fg-muted\" id=\"fd-msg\">PNG or JPG up to 5&nbsp;MB.</div>\n *   <input type=\"file\" id=\"fd-input\">\n * </label>\n * ```\n * @structure\n * .pfx-file-drop {\n *   [class*=\"-icon-\"]:optional {}\n *   .pfx-text {\n *     strong {}\n *   }\n *   .pfx-text {}\n *   input {}\n * }\n * @example -automatica11y\n * ```html\n * <label class=\"pfx-file-drop\">\n *   <span class=\"-icon-cloud-upload\" aria-hidden=\"true\"></span>\n *   <span id=\"audit-file-label\">Upload an image</span>\n *   <span id=\"audit-file-hint\">Choose a PNG or JPEG file, up to 5 MB.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-label\" aria-describedby=\"audit-file-hint\">\n * </label>\n * <label class=\"pfx-file-drop -hover\">\n *   <span id=\"audit-file-hover-label\">Upload while dragging a file</span>\n *   <span id=\"audit-file-hover-hint\">Drop the file here, or use the file picker.</span>\n *   <input type=\"file\" aria-labelledby=\"audit-file-hover-label\" aria-describedby=\"audit-file-hover-hint\">\n * </label>\n * <label class=\"pfx-file-drop -accepted\">\n *   <span id=\"audit-file-accepted-label\">Upload an acceptable image</span>\n *   <span id=\"audit-file-accepted-hint\">This file type is accepted: PNG or JPEG.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" aria-labelledby=\"audit-file-accepted-label\" aria-describedby=\"audit-file-accepted-hint\">\n * </label>\n * <label class=\"pfx-file-drop -rejected\">\n *   <span id=\"audit-file-rejected-label\">Replace a rejected image</span>\n *   <span id=\"audit-file-error\">File rejected. Choose a PNG or JPEG file, up to 5 MB.</span>\n *   <input type=\"file\" accept=\"image/png,image/jpeg\" required aria-invalid=\"true\" aria-labelledby=\"audit-file-rejected-label\" aria-describedby=\"audit-file-error\">\n * </label>\n * ```\n */\n@scope (.pfx-file-drop) {\n  & {\n    display: block;\n    text-align: center;\n    padding: var(--instui-spacing-space-lg);\n    color: var(--instui-color-text-base);\n    background: var(--instui-component-file-drop-background-color);\n    border: var(--instui-component-file-drop-border-width)\n      var(--instui-component-file-drop-border-style) var(--instui-component-file-drop-border-color);\n    border-radius: var(--instui-component-file-drop-border-radius);\n  }\n\n  &:hover,\n  &.-hover {\n    border-color: var(--instui-component-file-drop-hover-border-color);\n  }\n\n  &.-accepted {\n    border-color: var(--instui-component-file-drop-accepted-color);\n  }\n\n  &.-rejected {\n    border-color: var(--instui-component-file-drop-rejected-color);\n  }\n\n  & > :is([class^=\"-icon-\"], [class*=\" -icon-\"]) {\n    line-height: 1;\n  }\n}\n"}}],"_permissionRequestSessionId":"e0a110b6-b8dd-47be-82d5-