: move.\n * @modifier --cursor-grab — cursor: grab.\n * @modifier --cursor-wait — cursor: wait.\n * @a11y The cursor only affects pointer users; a pointer cursor doesn't make an element operable. Put it on native controls (\\`button\\`, \\`a\\`), and never use \\`--cursor-not-allowed\\` or \\`--cursor-wait\\` as the only sign that something is disabled or busy.\n * @example -automatica11y\n * \\`\\`\\`html\n * <button class=\"instui-button --cursor-pointer\">Open details</button>\n * \\`\\`\\`\n * @example\n * <div class=\"--cursor-pointer\">…</div>\n */\n${rules.join(\"\\n\")}`;\n  },\n});\n\n/** The cursor utility as a standalone, header-wrapped stylesheet. */\nexport const cursorUtilitiesCss: Definition[\"css\"] = cursor.css;\n"}}],"_permissionRequestSessionId":"cf8db52f-0f27-4d51-8f45-3f9af32eb056","assistedApproval":{"recommendation":"approve","reason":"Adds relevant accessibility guidance and test example within the requested project scope.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"cf8db52f-0f27-4d51-8f45-3f9af32eb056"},"id":"ae0ea985-2362-4f65-bcda-907125d2242b","timestamp":"2026-10-28T19:10:16.517Z","parentId":"406ab958-c3a5-4992-942d-91e4cf274acf"}
