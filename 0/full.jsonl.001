ing {\n    background: var(--instui-component-pill-warning-background-color);\n    color: var(--instui-component-pill-warning-text-color);\n    border-color: var(--instui-component-pill-warning-border-color);\n  }\n\n  &:is(.-color-danger, .-color-error) {\n    background: var(--instui-component-pill-error-background-color);\n    color: var(--instui-component-pill-error-text-color);\n    border-color: var(--instui-component-pill-error-border-color);\n  }\n\n  &.-color-plum {\n    background: var(--instui-component-pill-plum-background-color);\n    color: var(--instui-component-pill-plum-text-color);\n    border-color: var(--instui-component-pill-plum-border-color);\n  }\n\n  &.-color-aurora {\n    background: var(--instui-component-pill-aurora-background-color);\n    color: var(--instui-component-pill-aurora-text-color);\n    border-color: var(--instui-component-pill-aurora-border-color);\n  }\n\n  &.-color-sky {\n    background: var(--instui-component-pill-sky-background-color);\n    color: var(--instui-component-pill-sky-text-color);\n    border-color: var(--instui-component-pill-sky-border-color);\n  }\n\n  &.-color-orange {\n    background: var(--instui-component-pill-orange-background-color);\n    color: var(--instui-component-pill-orange-text-color);\n    border-color: var(--instui-component-pill-orange-border-color);\n  }\n\n  &.-color-violet {\n    background: var(--instui-component-pill-violet-background-color);\n    color: var(--instui-component-pill-violet-text-color);\n    border-color: var(--instui-component-pill-violet-border-color);\n  }\n\n  &.-color-sea {\n    background: var(--instui-component-pill-sea-background-color);\n    color: var(--instui-component-pill-sea-text-color);\n    border-color: var(--instui-component-pill-sea-border-color);\n  }\n\n  &.-color-stone {\n    background: var(--instui-component-pill-stone-background-color);\n    color: var(--instui-component-pill-stone-text-color);\n    border-color: var(--instui-component-pill-stone-border-color);\n  }\n\n  &.-color-info,\n  &.-color-success,\n  &.-color-warning,\n  &.-color-danger {\n    font-weight: var(--instui-component-pill-status-label-font-weight);\n  }\n}\n"}}]},"promptRequest":{"kind":"write","toolCallId":"custom_call_amZHG0wOZvGKtJimdsvXazQi","intention":"Update file","fileName":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/pill/pill.css","diff":"\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/pill/pill.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/pill/pill.css\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/pill/pill.css\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/pill/pill.css\n@@ -36,14 +36,18 @@\n  * @related tag — A tag is the removable, form-oriented counterpart.\n  * @example -automatica11y\n  * ```html\n- * <div class=\"pfx-view --display-flex --gap-md\" style=\"flex-wrap: wrap\">\n- *   <span class=\"pfx-pill -color-success -icon-check\">Published</span>\n- *   <span class=\"pfx-pill\">Draft</span>\n- *   <span class=\"pfx-pill -color-info\">In review</span>\n- *   <span class=\"pfx-pill -color-warning\">Stale</span>\n- *   <span class=\"pfx-pill -color-danger\">Blocked</span>\n- *   <span class=\"pfx-pill -color-violet\">Pastel</span>\n- * </div>\n+ * <div><span class=\"pfx-pill -color-neutral -size-x-small\">Draft</span></div>\n+ * <div><span class=\"pfx-pill -color-info -size-medium\">In review</span></div>\n+ * <div><span class=\"pfx-pill -color-success -size-large -icon-check\">Published</span></div>\n+ * <div><span class=\"pfx-pill -color-warning\">Needs review</span></div>\n+ * <div><span class=\"pfx-pill -color-danger\">Blocked</span></div>\n+ * <div><span class=\"pfx-pill -color-plum\">Plum team</span></div>\n+ * <div><span class=\"pfx-pill -color-aurora\">Aurora team</span></div>\n+ * <div><span class=\"pfx-pill -color-sky\">Sky team</span></div>\n+ * <div><span class=\"pfx-pill -color-orange\">Orange team</span></div>\n+ * <div><span class=\"pfx-pill -color-violet\">Violet team</span></div>\n+ * <div><span class=\"pfx-pill -color-sea\">Sea team</span></div>\n+ * <div><span class=\"pfx-pill -color-stone\">Stone team</span></div>\n  * ```\n  */\n @scope (.pfx-pill) {\n","newFileContents":"/**\n * @component pill\n * @selector .pfx-pill\n * @a11y The status colors are visual only, so state the status in the label text or a visually hidden label. The leading glyph is a masked `::before` and isn't announced.\n * @summary A compact status label; add a leading glyph with the shared `-icon-<name>` form.\n * @remarks Unlike `badge`, which shows a count, or `tag`, which is removable, the pill is a static status label; its leading glyph is a masked `::before`, not an `<img>`. Let groups wrap with `flex-wrap: wrap` on their container so compact labels reflow on narrow screens.\n * @modifier -size-x-small — The smallest pill size.\n * @modifier -size-medium — The medium pill size.\n * @modifier -size-large — The largest pill size.\n * @modifier -color-neutral — A neutral status.\n * @modifier -color-info — Informational status.\n * @modifier -color-success — Positive status.\n * @modifier -color-warning — Cautionary status.\n * @modifier -color-danger — Error status.\n * @modifier -color-plum — Plum accent status.\n * @modifier -color-aurora — Aurora accent status.\n * @modifier -color-sky — Sky accent status.\n * @modifier -color-orange — Orange accent status.\n * @modifier -color-violet — Violet accent status.\n * @modifier -color-sea — Sea accent status.\n * @modifier -color-stone — Stone accent status.\n * @modifier -icon-* — A leading glyph from the icon set (e.g. `-icon-check`), painted before the label.\n * @pseudo ::before — The leading icon glyph, sized and spaced to the pill.\n * @example -canvas-rce -docs\n * ```html\n * <div class=\"pfx-view --display-flex --gap-md\" style=\"flex-wrap: wrap\">\n *   <span class=\"instui-pill -color-success -icon-check\">Published</span>\n *   <span class=\"instui-pill\">Draft</span>\n *   <span class=\"instui-pill -color-info\">In review</span>\n *   <span class=\"instui-pill -color-warning\">Stale</span>\n *   <span class=\"instui-pill -color-danger\">Blocked</span>\n *   <span class=\"instui-pill -color-violet\">Pastel</span>\n * </div>\n * ```\n * @related badge — A badge is the count or notification counterpart.\n * @related tag — A tag is the removable, form-oriented counterpart.\n * @example -automatica11y\n * ```html\n * <div><span class=\"pfx-pill -color-neutral -size-x-small\">Draft</span></div>\n * <div><span class=\"pfx-pill -color-info -size-medium\">In review</span></div>\n * <div><span class=\"pfx-pill -color-success -size-large -icon-check\">Published</span></div>\n * <div><span class=\"pfx-pill -color-warning\">Needs review</span></div>\n * <div><span class=\"pfx-pill -color-danger\">Blocked</span></div>\n * <div><span class=\"pfx-pill -color-plum\">Plum team</span></div>\n * <div><span class=\"pfx-pill -color-aurora\">Aurora team</span></div>\n * <div><span class=\"pfx-pill -color-sky\">Sky team</span></div>\n * <div><span class=\"pfx-pill -color-orange\">Orange team</span></div>\n * <div><span class=\"pfx-pill -color-violet\">Violet team</span></div>\n * <div><span class=\"pfx-pill -color-sea\">Sea team</span></div>\n * <div><span class=\"pfx-pill -color-stone\">Stone team</span></div>\n * ```\n */\n@scope (.pfx-pill) {\n  & {\n    display: inline-flex;\n    align-items: center;\n    height: var(--instui-component-pill-height);\n    max-width: var(--instui-component-pill-max-width);\n    padding-block: var(--instui-component-pill-padding-vertical);\n    padding-inline: var(--instui-component-pill-padding-horizontal);\n    gap: var(--instui-component-pill-gap-content);\n    background: var(--instui-component-pill-neutral-background-color);\n    color: var(--instui-component-pill-base-text-color);\n    border: var(--instui-component-pill-border-width) var(--instui-component-pill-border-style)\n      var(--instui-component-pill-base-border-color);\n    border-radius: var(--instui-component-pill-border-radius);\n    font-family: var(--instui-component-pill-font-family);\n    font-size: var(--instui-component-pill-text-font-size);\n    font-weight: var(--instui-component-pill-text-font-weight);\n    line-height: var(--instui-component-pill-line-height);\n  }\n\n  &:is([class^=\"-icon-\"], [class*=\" -icon-\"])::before {\n    inline-size: var(--instui-font-size-text-xs);\n    block-size: var(--instui-font-size-text-xs);\n    margin-inline-end: var(--instui-component-pill-gap-icon-label);\n  }\n\n  &.-size-x-small {\n    height: var(--instui-component-pill-height-x-small);\n  }\n\n  &.-size-medium {\n    height: var(--instui-component-pill-height-medium);\n    padding-inline: var(--instui-component-pill-padding-horizontal-medium);\n    font-size: var(--instui-component-pill-text-font-size-medium);\n    gap: var(--instui-component-pill-gap-content);\n  }\n\n  &.-size-large {\n    height: var(--instui-component-pill-height-large);\n    padding-inline: var(--instui-component-pill-padding-horizontal-large);\n    font-size: var(--instui-component-pill-text-font-size-large);\n    gap: var(--instui-component-pill-gap-content);\n  }\n\n  &.-size-medium:is([class^=\"-icon-\"], [class*=\" -icon-\"])::before {\n    margin-inline-end: var(--instui-component-pill-gap-icon-label-medium);\n  }\n\n  &.-size-large:is([class^=\"-icon-\"], [class*=\" -icon-\"])::before {\n    margin-inline-end: var(--instui-component-pill-gap-icon-label-large);\n  }\n\n  &.-color-neutral {\n    background: var(--instui-component-pill-neutral-background-color);\n  }\n\n  &.-color-info {\n    background: var(--instui-component-pill-info-background-color);\n    color: var(--instui-component-pill-info-text-color);\n    border-color: var(--instui-component-pill-info-border-color);\n  }\n\n  &.-color-success {\n    background: var(--instui-component-pill-success-background-color);\n    color: var(--instui-component-pill-success-text-color);\n    border-color: var(--instui-component-pill-success-border-color);\n  }\n\n  &.-color-warning {\n    background: var(--instui-component-pill-warning-background-color);\n    color: var(--instui-component-pill-warning-text-color);\n    border-color: var(--instui-component-pill-warning-border-color);\n  }\n\n  &:is(.-color-danger, .-color-error) {\n    background: var(--instui-component-pill-error-background-color);\n    color: var(--instui-component-pill-error-text-color);\n    border-color: var(--instui-component-pill-error-border-color);\n  }\n\n  &.-color-plum {\n    background: var(--instui-component-pill-plum-background-color);\n    color: var(--instui-component-pill-plum-text-color);\n    border-color: var(--instui-component-pill-plum-border-color);\n  }\n\n  &.-color-aurora {\n    background: var(--instui-component-pill-aurora-background-color);\n    color: var(--instui-component-pill-aurora-text-color);\n    border-color: var(--instui-component-pill-aurora-border-color);\n  }\n\n  &.-color-sky {\n    background: var(--instui-component-pill-sky-background-color);\n    color: var(--instui-component-pill-sky-text-color);\n    border-color: var(--instui-component-pill-sky-border-color);\n  }\n\n  &.-color-orange {\n    background: var(--instui-component-pill-orange-background-color);\n    color: var(--instui-component-pill-orange-text-color);\n    border-color: var(--instui-component-pill-orange-border-color);\n  }\n\n  &.-color-violet {\n    background: var(--instui-component-pill-violet-background-color);\n    color: var(--instui-component-pill-violet-text-color);\n    border-color: var(--instui-component-pill-violet-border-color);\n  }\n\n  &.-color-sea {\n    background: var(--instui-component-pill-sea-background-color);\n    color: var(--instui-component-pill-sea-text-color);\n    border-color: var(--instui-component-pill-sea-border-color);\n  }\n\n  &.-color-stone {\n    background: var(--instui-component-pill-stone-background-color);\n    color: var(--instui-component-pill-stone-text-color);\n    border-color: var(--instui-component-pill-stone-border-color);\n  }\n\n  &.-color-info,\n  &.-color-success,\n  &.-color-warning,\n  &.-color-danger {\n    font-weight: var(--instui-component-pill-status-label-font-weight);\n  }\n}\n","canOfferSessionApproval":true,"fileEdits":[{"before":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/pill/pill.css","content":"/**\n * @component pill\n * @selector .pfx-pill\n * @a11y The status colors are visual only, so state the status in the label text or a visually hidden label. The leading glyph is a masked `::before` and isn't announced.\n * @summary A compact status label; add a leading glyph with the shared `-icon-<name>` form.\n * @remarks Unlike `badge`, which shows a count, or `tag`, which is removable, the pill is a static status label; its leading glyph is a masked `::before`, not an `<img>`. Let groups wrap with `flex-wrap: wrap` on their container so compact labels reflow on narrow screens.\n * @modifier -size-x-small — The smallest pill size.\n * @modifier -size-medium — The medium pill size.\n * @modifier -size-large — The largest pill size.\n * @modifier -color-neutral — A neutral status.\n * @modifier -color-info — Informational status.\n * @modifier -color-success — Positive status.\n * @modifier -color-warning — Cautionary status.\n * @modifier -color-danger — Error status.\n * @modifier -color-plum — Plum accent status.\n * @modifier -color-aurora — Aurora accent status.\n * @modifier -color-sky — Sky accent status.\n * @modifier -color-orange — Orange accent status.\n * @modifier -color-violet — Violet accent status.\n * @modifier -color-sea — Sea accent status.\n * @modifier -color-stone — Stone accent status.\n * @modifier -icon-* — A leading glyph from the icon set (e.g. `-icon-check`), painted before the label.\n * @pseudo ::before — The leading icon glyph, sized and spaced to the pill.\n * @example -canvas-rce -docs\n * ```html\n * <div class=\"pfx-view --display-flex --gap-md\" style=\"flex-wrap: wrap\">\n *   <span class=\"instui-pill -color-success -icon-check\">Published</span>\n *   <span class=\"instui-pill\">Draft</span>\n *   <span class=\"instui-pill -color-info\">In review</span>\n *   <span class=\"instui-pill -color-warning\">Stale</span>\n *   <span class=\"instui-pill -color-danger\">Blocked</span>\n *   <span class=\"instui-pill -color-violet\">Pastel</span>\n * </div>\n * ```\n * @related badge — A badge is the count or notification counterpart.\n * @related tag — A tag is the removable, form-oriented counterpart.\n * @example -automatica11y\n * ```html\n * <div class=\"pfx-view --display-flex --gap-md\" style=\"flex-wrap: wrap\">\n *   <span class=\"pfx-pill -color-success -icon-check\">Published</span>\n *   <span class=\"pfx-pill\">Draft</span>\n *   <span class=\"pfx-pill -color-info\">In review</span>\n *   <span class=\"pfx-pill -color-warning\">Stale</span>\n *   <span class=\"pfx-pill -color-danger\">Blocked</span>\n *   <span class=\"pfx-pill -color-violet\">Pastel</span>\n * </div>\n * ```\n */\n@scope (.pfx-pill) {\n  & {\n    display: inline-flex;\n    align-items: center;\n    height: var(--instui-component-pill-height);\n    max-width: var(--instui-component-pill-max-width);\n    padding-block: var(--instui-component-pill-padding-vertical);\n    padding-inline: var(--instui-component-pill-padding-horizontal);\n    gap: var(--instui-component-pill-gap-content);\n    background: var(--instui-component-pill-neutral-background-color);\n    color: var(--instui-component-pill-base-text-color);\n    border: var(--instui-component-pill-border-width) var(--instui-component-pill-border-style)\n      var(--instui-component-pill-base-border-color);\n    border-radius: var(--instui-component-pill-border-radius);\n    font-family: var(--instui-component-pill-font-family);\n    font-size: var(--instui-component-pill-text-font-size);\n    font-weight: var(--instui-component-pill-text-font-weight);\n    line-height: var(--instui-component-pill-line-height);\n  }\n\n  &:is([class^=\"-icon-\"], [class*=\" -icon-\"])::before {\n    inline-size: var(--instui-font-size-text-xs);\n    block-size: var(--instui-font-size-text-xs);\n    margin-inline-end: var(--instui-component-pill-gap-icon-label);\n  }\n\n  &.-size-x-small {\n    height: var(--instui-component-pill-height-x-small);\n  }\n\n  &.-size-medium {\n    height: var(--instui-component-pill-height-medium);\n    padding-inline: var(--instui-component-pill-padding-horizontal-medium);\n    font-size: var(--instui-component-pill-text-font-size-medium);\n    gap: var(--instui-component-pill-gap-content);\n  }\n\n  &.-size-large {\n    height: var(--instui-component-pill-height-large);\n    padding-inline: var(--instui-component-pill-padding-horizontal-large);\n    font-size: var(--instui-component-pill-text-font-size-large);\n    gap: var(--instui-component-pill-gap-content);\n  }\n\n  &.-size-medium:is([class^=\"-icon-\"], [class*=\" -icon-\"])::before {\n    margin-inline-end: var(--instui-component-pill-gap-icon-label-medium);\n  }\n\n  &.-size-large:is([class^=\"-icon-\"], [class*=\" -icon-\"])::before {\n    margin-inline-end: var(--instui-component-pill-gap-icon-label-large);\n  }\n\n  &.-color-neutral {\n    background: var(--instui-component-pill-neutral-background-color);\n  }\n\n  &.-color-info {\n    background: var(--instui-component-pill-info-background-color);\n    color: var(--instui-component-pill-info-text-color);\n    border-color: var(--instui-component-pill-info-border-color);\n  }\n\n  &.-color-success {\n    background: var(--instui-component-pill-success-background-color);\n    color: var(--instui-component-pill-success-text-color);\n    border-color: var(--instui-component-pill-success-border-color);\n  }\n\n  &.-color-warning {\n    background: var(--instui-component-pill-warning-background-color);\n    color: var(--instui-component-pill-warning-text-color);\n    border-color: var(--instui-component-pill-warning-border-color);\n  }\n\n  &:is(.-color-danger, .-color-error) {\n    background: var(--instui-component-pill-error-background-color);\n    color: var(--instui-component-pill-error-text-color);\n    border-color: var(--instui-component-pill-error-border-color);\n  }\n\n  &.-color-plum {\n    background: var(--instui-component-pill-plum-background-color);\n    color: var(--instui-component-pill-plum-text-color);\n    border-color: var(--instui-component-pill-plum-border-color);\n  }\n\n  &.-color-aurora {\n    background: var(--instui-component-pill-aurora-background-color);\n    color: var(--instui-component-pill-aurora-text-color);\n    border-color: var(--instui-component-pill-aurora-border-color);\n  }\n\n  &.-color-sky {\n    background: var(--instui-component-pill-sky-background-color);\n    color: var(--instui-component-pill-sky-text-color);\n    border-color: var(--instui-component-pill-sky-border-color);\n  }\n\n  &.-color-orange {\n    background: var(--instui-component-pill-orange-background-color);\n    color: var(--instui-component-pill-orange-text-color);\n    border-color: var(--instui-component-pill-orange-border-color);\n  }\n\n  &.-color-violet {\n    background: var(--instui-component-pill-violet-background-color);\n    color: var(--instui-component-pill-violet-text-color);\n    border-color: var(--instui-component-pill-violet-border-color);\n  }\n\n  &.-color-sea {\n    background: var(--instui-component-pill-sea-background-color);\n    color: var(--instui-component-pill-sea-text-color);\n    border-color: var(--instui-component-pill-sea-border-color);\n  }\n\n  &.-color-stone {\n    background: var(--instui-component-pill-stone-background-color);\n    color: var(--instui-component-pill-stone-text-color);\n    border-color: var(--instui-component-pill-stone-border-color);\n  }\n\n  &.-color-info,\n  &.-color-success,\n  &.-color-warning,\n  &.-color-danger {\n    font-weight: var(--instui-component-pill-status-label-font-weight);\n  }\n}\n"},"after":{"path":"/Users/dwahl/Scripts/pantoken/formats/components/src/components/pill/pill.css","content":"/**\n * @component pill\n * @selector .pfx-pill\n * @a11y The status colors are visual only, so state the status in the label text or a visually hidden label. The leading glyph is a masked `::before` and isn't announced.\n * @summary A compact status label; add a leading glyph with the shared `-icon-<name>` form.\n * @remarks Unlike `badge`, which shows a count, or `tag`, which is removable, the pill is a static status label; its leading glyph is a masked `::before`, not an `<img>`. Let groups wrap with `flex-wrap: wrap` on their container so compact labels reflow on narrow screens.\n * @modifier -size-x-small — The smallest pill size.\n * @modifier -size-medium — The medium pill size.\n * @modifier -size-large — The largest pill size.\n * @modifier -color-neutral — A neutral status.\n * @modifier -color-info — Informational status.\n * @modifier -color-success — Positive status.\n * @modifier -color-warning — Cautionary status.\n * @modifier -color-danger — Error status.\n * @modifier -color-plum — Plum accent status.\n * @modifier -color-aurora — Aurora accent status.\n * @modifier -color-sky — Sky accent status.\n * @modifier -color-orange — Orange accent status.\n * @modifier -color-violet — Violet accent status.\n * @modifier -color-sea — Sea accent status.\n * @modifier -color-stone — Stone accent status.\n * @modifier -icon-* — A leading glyph from the icon set (e.g. `-icon-check`), painted before the label.\n * @pseudo ::before — The leading icon glyph, sized and spaced to the pill.\n * @example -canvas-rce -docs\n * ```html\n * <div class=\"pfx-view --display-flex --gap-md\" style=\"flex-wrap: wrap\">\n *   <span class=\"instui-pill -color-success -icon-check\">Published</span>\n *   <span class=\"instui-pill\">Draft</span>\n *   <span class=\"instui-pill -color-info\">In review</span>\n *   <span class=\"instui-pill -color-warning\">Stale</span>\n *   <span class=\"instui-pill -color-danger\">Blocked</span>\n *   <span class=\"instui-pill -color-violet\">Pastel</span>\n * </div>\n * ```\n * @related badge — A badge is the count or notification counterpart.\n * @related tag — A tag is the removable, form-oriented counterpart.\n * @example -automatica11y\n * ```html\n * <div><span class=\"pfx-pill -color-neutral -size-x-small\">Draft</span></div>\n * <div><span class=\"pfx-pill -color-info -size-medium\">In review</span></div>\n * <div><span class=\"pfx-pill -color-success -size-large -icon-check\">Published</span></div>\n * <div><span class=\"pfx-pill -color-warning\">Needs review</span></div>\n * <div><span class=\"pfx-pill -color-danger\">Blocked</span></div>\n * <div><span class=\"pfx-pill -color-plum\">Plum team</span></div>\n * <div><span class=\"pfx-pill -color-aurora\">Aurora team</span></div>\n * <div><span class=\"pfx-pill -color-sky\">Sky team</span></div>\n * <div><span class=\"pfx-pill -color-orange\">Orange team</span></div>\n * <div><span class=\"pfx-pill -color-violet\">Violet team</span></div>\n * <div><span class=\"pfx-pill -color-sea\">Sea team</span></div>\n * <div><span class=\"pfx-pill -color-stone\">Stone team</span></div>\n * ```\n */\n@scope (.pfx-pill) {\n  & {\n    display: inline-flex;\n    align-items: center;\n    height: var(--instui-component-pill-height);\n    max-width: var(--instui-component-pill-max-width);\n    padding-block: var(--instui-component-pill-padding-vertical);\n    padding-inline: var(--instui-component-pill-padding-horizontal);\n    gap: var(--instui-component-pill-gap-content);\n    background: var(--instui-component-pill-neutral-background-color);\n    color: var(--instui-component-pill-base-text-color);\n    border: var(--instui-component-pill-border-width) var(--instui-component-pill-border-style)\n      var(--instui-component-pill-base-border-color);\n    border-radius: var(--instui-component-pill-border-radius);\n    font-family: var(--instui-component-pill-font-family);\n    font-size: var(--instui-component-pill-text-font-size);\n    font-weight: var(--instui-component-pill-text-font-weight);\n    line-height: var(--instui-component-pill-line-height);\n  }\n\n  &:is([class^=\"-icon-\"], [class*=\" -icon-\"])::before {\n    inline-size: var(--instui-font-size-text-xs);\n    block-size: var(--instui-font-size-text-xs);\n    margin-inline-end: var(--instui-component-pill-gap-icon-label);\n  }\n\n  &.-size-x-small {\n    height: var(--instui-component-pill-height-x-small);\n  }\n\n  &.-size-medium {\n    height: var(--instui-component-pill-height-medium);\n    padding-inline: var(--instui-component-pill-padding-horizontal-medium);\n    font-size: var(--instui-component-pill-text-font-size-medium);\n    gap: var(--instui-component-pill-gap-content);\n  }\n\n  &.-size-large {\n    height: var(--instui-component-pill-height-large);\n    padding-inline: var(--instui-component-pill-padding-horizontal-large);\n    font-size: var(--instui-component-pill-text-font-size-large);\n    gap: var(--instui-component-pill-gap-content);\n  }\n\n  &.-size-medium:is([class^=\"-icon-\"], [class*=\" -icon-\"])::before {\n    margin-inline-end: var(--instui-component-pill-gap-icon-label-medium);\n  }\n\n  &.-size-large:is([class^=\"-icon-\"], [class*=\" -icon-\"])::before {\n    margin-inline-end: var(--instui-component-pill-gap-icon-label-large);\n  }\n\n  &.-color-neutral {\n    background: var(--instui-component-pill-neutral-background-color);\n  }\n\n  &.-color-info {\n    background: var(--instui-component-pill-info-background-color);\n    color: var(--instui-component-pill-info-text-color);\n    border-color: var(--instui-component-pill-info-border-color);\n  }\n\n  &.-color-success {\n    background: var(--instui-component-pill-success-background-color);\n    color: var(--instui-component-pill-success-text-color);\n    border-color: var(--instui-component-pill-success-border-color);\n  }\n\n  &.-color-warning {\n    background: var(--instui-component-pill-warning-background-color);\n    color: var(--instui-component-pill-warning-text-color);\n    border-color: var(--instui-component-pill-warning-border-color);\n  }\n\n  &:is(.-color-danger, .-color-error) {\n    background: var(--instui-component-pill-error-background-color);\n    color: var(--instui-component-pill-error-text-color);\n    border-color: var(--instui-component-pill-error-border-color);\n  }\n\n  &.-color-plum {\n    background: var(--instui-component-pill-plum-background-color);\n    color: var(--instui-component-pill-plum-text-color);\n    border-color: var(--instui-component-pill-plum-border-color);\n  }\n\n  &.-color-aurora {\n    background: var(--instui-component-pill-aurora-background-color);\n    color: var(--instui-component-pill-aurora-text-color);\n    border-color: var(--instui-component-pill-aurora-border-color);\n  }\n\n  &.-color-sky {\n    background: var(--instui-component-pill-sky-background-color);\n    color: var(--instui-component-pill-sky-text-color);\n    border-color: var(--instui-component-pill-sky-border-color);\n  }\n\n  &.-color-orange {\n    background: var(--instui-component-pill-orange-background-color);\n    color: var(--instui-component-pill-orange-text-color);\n    border-color: var(--instui-component-pill-orange-border-color);\n  }\n\n  &.-color-violet {\n    background: var(--instui-component-pill-violet-background-color);\n    color: var(--instui-component-pill-violet-text-color);\n    border-color: var(--instui-component-pill-violet-border-color);\n  }\n\n  &.-color-sea {\n    background: var(--instui-component-pill-sea-background-color);\n    color: var(--instui-component-pill-sea-text-color);\n    border-color: var(--instui-component-pill-sea-border-color);\n  }\n\n  &.-color-stone {\n    background: var(--instui-component-pill-stone-background-color);\n    color: var(--instui-component-pill-stone-text-color);\n    border-color: var(--instui-component-pill-stone-border-color);\n  }\n\n  &.-color-info,\n  &.-color-success,\n  &.-color-warning,\n  &.-color-danger {\n    font-weight: var(--instui-component-pill-status-label-font-weight);\n  }\n}\n"}}],"_permissionRequestSessionId":"44e9bcbc-c0c2-4d54-9c7b-2558508ad507","assistedApproval":{"recommendation":"approve","reason":"Human approved all five phases; this in-scope fixture edit triggers no mandatory exclusion.","model":"gpt-6-luna","evaluation":{"reasonCode":"judge-verdict","judgeStatus":"completed","evaluationStage":"judge","judgeAttempted":true}}},"agentMode":"interactive","permissionMode":"assisted","ownerSessionId":"44e9bcbc-c0c2-4d54-9c7b-2558508ad507"},"agentId":"78631379-5bbe-4a0d-a590-18491ff526c0","id":"e875865b-2d33-46e6-8e3b-7e6f38ad2745","timestamp":"2026-10-28T21:04:11.697Z","parentId":"88cabe21-4848-47de-8dd6-b658abdcbcaf"}
