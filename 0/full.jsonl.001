for (const modifier of entry.modifiers) { + if (modifier.name.includes(\\\"*\\\") || modifier.description.includes(\\\"@alias\\\")) continue; + expect(classes.has(modifier.name), `${record.name}: ${modifier.name}`).toBe(true); + } + void window.happyDOM.abort(); +}); *** End Patch\\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/declarations/focus/index.ts @@ - * <button class=\\\"instui-button -focus-color-danger\\\" data-a11y-root data-a11y-trigger>Delete</button> + * <button data-a11y-root data-a11y-trigger>Default focus</button> + * <button class=\\\"-focus-color-danger\\\">Danger focus</button> + * <button class=\\\"-focus-color-success\\\">Success focus</button> + * <div style=\\\"background: var(--instui-color-background-brand)\\\"> + * <button class=\\\"-focus-color-inverse\\\">Inverse focus</button> + * </div> + * <button class=\\\"-focus-position-inset\\\">Inset focus</button> + * <div class=\\\"-focus-within\\\"><button>Focus within</button></div> + * <button class=\\\"-without-focus-animation\\\">Focus without animation</button> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/ai-gradient/index.ts @@ - * <div class=\\\"--border-color-ai --border-radius-md --border-width-sm --p-md\\\"> - * AI-generated summary - * </div> + * <div class=\\\"--border-color-ai\\\">AI border</div> + * <div class=\\\"--border-color-ai-horizontal\\\">Horizontal AI border</div> + * <div class=\\\"--background-ai\\\">AI background</div> + * <div class=\\\"--background-ai-horizontal\\\">Horizontal AI background</div> + * <div dir=\\\"rtl\\\"> + * <div class=\\\"--border-color-ai-horizontal\\\">حدود الذكاء الاصطناعي</div> + * <div class=\\\"--background-ai-horizontal\\\">خلفية الذكاء الاصطناعي</div> + * </div> *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/src/utilities/icon/icon.css @@ - * <button class=\\\"pfx-button\\\" data-a11y-root data-a11y-trigger> + *