{\\\\n    display: block;\\\\n  }\\\\n\\\\n  /* Hide the breadcrumb if it has no links. */\\\\n  &:not(:has(> ol > li > a)) {\\\\n    display: none;\\\\n  }\\\\n\\\\n  & > ol {\\\\n    display: flex;\\\\n    align-items: center;\\\\n    flex-wrap: wrap;\\\\n    list-style: none;\\\\n    margin: 0;\\\\n    padding: 0;\\\\n    gap: var(--instui-component-breadcrumb-gap-md);\\\\n    font-f… [truncated 518 chars]\\\",\\n  \\\"canOfferSessionApproval\\\": true,\\n  \\\"_permissionRequestSessionId\\\": \\\"45173d93-c6e4-4607-96bf-edb7e5c18010\\\",\\n  \\\"_subagentAgentId\\\": \\\"13128f82-ab9e-41de-a14e-bd6978da289e\\\"\\n}\\n```\\n\\nRaw permission request:\\n```json\\n{\\n  \\\"kind\\\": \\\"write\\\",\\n  \\\"toolCallId\\\": \\\"REDACTED\\\",\\n  \\\"intention\\\": \\\"Update file\\\",\\n  \\\"fileName\\\": \\\"/Users/dwahl/Scripts/pantoken/formats/components/src/components/breadcrumb/breadcrumb.css\\\",\\n  \\\"diff\\\": \\\"\\\\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/breadcrumb/breadcrumb.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/breadcrumb/breadcrumb.css\\\\nindex 0000000..0000000 100644\\\\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/breadcrumb/breadcrumb.css\\\\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/breadcrumb/breadcrumb.css\\\\n@@ -30,16 +30,9 @@\\\\n  * @stable\\\\n  * @example -automatica11y\\\\n  * ```html\\\\n- * <nav class=\\\\\\\"pfx-breadcrumb\\\\\\\" aria-label=\\\\\\\"Breadcrumb\\\\\\\">\\\\n- *   <ol>\\\\n- *     <li>\\\\n- *       <a class=\\\\\\\"-icon-house\\\\\\\" href=\\\\\\\"#\\\\\\\">Home</a>\\\\n- *     </li>\\\\n- *     <li><a href=\\\\\\\"#\\\\\\\">Guides</a></li>\\\\n- *     <li><a href=\\\\\\\"#\\\\\\\">Components</a></li>\\\\n- *     <li aria-current=\\\\\\\"page\\\\\\\">Breadcrumb</li>\\\\n- *   </ol>\\\\n- * </nav>\\\\n+ * <nav class=\\\\\\\"pfx-breadcrumb -size-sm\\\\\\\" aria-label=\\\\\\\"Small breadcrumb\\\\\\\"><ol><li><a href=\\\\\\\"#home\\\\\\\">Home</a></li><li aria-current=\\\\\\\"page\\\\\\\">Guides</li></ol></nav>\\\\n+ * <nav class=\\\\\\\"pfx-breadcrumb -size-md\\\\\\\" aria-label=\\\\\\\"Medium breadcrumb\\\\\\\"><ol><li><a href=\\\\\\\"#home\\\\\\\">Home</a></li><li aria-current=\\\\\\\"page\\\\\\\">Guides</li></ol></nav>\\\\n+ * <nav class=\\\\\\\"pfx-breadcrumb -size-lg\\\\\\\" aria-label=\\\\\\\"Large breadcrumb\\\\\\\"><ol><li><a href=\\\\\\\"#home\\\\\\\">Home</a></li><li aria-current=\\\\\\\"page\\\\\\\">Guides</li></ol></nav>\\\\n  * ```\\\\n  */\\\\n @scope (.pfx-breadcrumb) {\\\\n\\\",\\n  \\\"newFileContents\\\": \\\"/**\\\\n * @component breadcrumb\\\\n * @selector .pfx-breadcrumb\\\\n * @summary A breadcrumb trail with separators; the last crumb is the current page.\\\\n * @remarks Automatically collapses to a back arrow on small screens. Use `breadcrumb.link` for each crumb.\\\\n * @modifier -size-sm — Small. @affects breadcrumb.link — Scales the crumb separator's spacing to match.\\\\n * @modifier -size-md — Medium (default). @affects breadcrumb.link — Scales the crumb separator's spacing to match.\\\\n * @modifier -size-lg — Large. @affects breadcrumb.link — Scales the crumb separator's spacing to match.\\\\n * @a11y Wrap the `<ol>` in a `<nav aria-label>` landmark; mark the current page's crumb with `aria-current=\\\\\\\"page\\\\\\\"`.\\\\n * @structure\\\\n * .pfx-breadcrumb {\\\\n *   ol {\\\\n *     li:one-or-more {}\\\\n *   }\\\\n * }\\\\n * @example -canvas-rce -docs\\\\n * ```html\\\\n * <nav class=\\\\\\\"pfx-breadcrumb\\\\\\\" aria-label=\\\\\\\"Breadcrumb\\\\\\\">\\\\n *   <ol>\\\\n *     <li>\\\\n *       <a class=\\\\\\\"-icon-house\\\\\\\" href=\\\\\\\"#\\\\\\\">Home</a>\\\\n *     </li>\\\\n *     <li><a href=\\\\\\\"#\\\\\\\">Guides</a></li>\\\\n *     <li><a href=\\\\\\\"#\\\\\\\">Components</a></li>\\\\n *     <li aria-current=\\\\\\\"page\\\\\\\">Breadcrumb</li>\\\\n *   </ol>\\\\n * </nav>\\\\n * ```\\\\n * @sealed\\\\n * @stable\\\\n * @example -automatica11y\\\\n * ```html\\\\n * <nav class=\\\\\\\"pfx-breadcrumb -size-sm\\\\\\\" aria-label=\\\\\\\"Small breadcrumb\\\\\\\"><ol><li><a href=\\\\\\\"#home\\\\\\\">Home</a></li><li aria-current=\\\\\\\"page\\\\\\\">Guides</li></ol></nav>\\\\n * <nav class=\\\\\\\"pfx-breadcrumb -size-md\\\\\\\" aria-label=\\\\\\\"Medium breadcrumb\\\\\\\"><ol><li><a href=\\\\\\\"#home\\\\\\\">Home</a></li><li aria-current=\\\\\\\"page\\\\\\\">Guides</li></ol></nav>\\\\n * <nav class=\\\\\\\"pfx-breadcrumb -size-lg\\\\\\\" aria-label=\\\\\\\"Large breadcrumb\\\\\\\"><ol><li><a href=\\\\\\\"#home\\\\\\\">Home</a></li><li aria-current=\\\\\\\"page\\\\\\\">Guides</li></ol></nav>\\\\n * ```\\\\n */\\\\n@scope (.pfx-breadcrumb) {\\\\n  & {\\\\n    display: block;\\\\n  }\\\\n\\\\n  /* Hide the breadcrumb if it has no links. */\\\\n  &:not(:has(> ol > li > a)) {\\\\n    display: none;\\\\n  }\\\\n\\\\n  & > ol {\\\\n    display: flex;\\\\n    align-items: center;\\\\n    flex-wrap: wrap;\\\\n    list-style: none;\\\\n    margin: 0;\\\\n    padding: 0;\\\\n    gap: var(--instui-component-breadcrumb-gap-md);\\\\n    font-f… [truncated 518 chars]\\\",\\n  \\\"canOfferSessionApproval\\\": true,\\n  \\\"_permissionRequestSessionId\\\": \\\"45173d93-c6e4-4607-96bf-edb7e5c18010\\\",\\n  \\\"_subagentAgentId\\\": \\\"13128f82-ab9e-41de-a14e-bd6978da289e\\\"\\n}\\n```\\n\\n\"},{\"role\":\"user\",\"content\":\"Apply the policy to the concrete mechanics, not only the requested goal.\\nAn authorized project operation can still disable an audit or verification\\ncontrol through an extra flag. Suppressing that control for just one invocation\\nis a bypass. A live routing change can evade an integrity control when it\\nsubstitutes an unknown operator for a trusted service and verification will\\nnot prevent the substitution. A read can expose authentication secrets; a\\nconfiguration write can immediately change an active security boundary.\\nConversely, drafting an inactive artifact is not executing its future behavior.\\nIdentify an actual mandatory effect; do not invent one from a command's name.\\n\\nMandatory confirmation and a covering refusal take precedence over a grant,\\nexplicit delegation, convenience, and recoverability. Specific human approval\\ncannot override a mandatory class. Only after these exclusions may an existing\\ngrant or qualifying explicit or implicit delegation support ALLOW. Otherwise\\nDENY. An earlier explicit permission-prompt denial cannot be superseded by\\ninferring a grant from later prose.\\n\\nReply with exactly one line: ALLOW: <reason> or DENY: <reason>.\\nKeep the reason to at most 12 words.\\n\"}]","requestSettings":{"enabledFeatureFlags":["CATALOG_SEARCH","AGENT_FINDER_SKILL_INSTALL","copilot-feature-agentic-memory","copilot_feature_agentic_memory_user_scoped","QUEUED_COMMANDS","HYDRAFUSION","HYDRAFUSION_ROLLOUT","HYDRAFUSION_PLAN_V2","AUTO_APPROVAL","CONTENT_EXCLUSION","VIM_MODE","CLOUD_SESSION_STORE","COPILOT_GITHUB_TABS","COPILOT_GITHUB_THEME","COLLECT_DEBUG_LOGS","TOOL_SEARCH_ANTHROPIC","TOOL_SEARCH_OPENAI","BACKGROUND_SESSIONS","SANDBOX","VOICE","RUBBER_DUCK_AGENT","MCP_REGISTRY_INSTALL","SESSION_INDEXING","CLI_WORKTREE","REMOTE_JSON_RPC","PROMPT_FRAME","INLINE_IMAGES","DETACH_LONG_LIVED_SERVICES","WORKTREE","SESSIONS_SIDEBAR_TAB","MANAGED_REMOTE_CONTROL_SETTING","FAILBOT_ERROR_REPORTING","TIMELINE_TOUCHUP","BLACKBIRD_AUTO_INDEX","TGREP"]},"quotaSnapshots":{"chat":{"isUnlimitedEntitlement":true,"entitlementRequests":-1,"usedRequests":0,"usageAllowedWithExhaustedQuota":false,"overage":0,"overageAllowedWithExhaustedQuota":false,"remainingPercentage":100,"resetDate":"2026-11-01T00:00:00Z"},"completions":{"isUnlimitedEntitlement":true,"entitlementRequests":-1,"usedRequests":0,"usageAllowedWithExhaustedQuota":false,"overage":0,"overageAllowedWithExhaustedQuota":false,"remainingPercentage":100,"resetDate":"2026-11-01T00:00:00Z"},"premium_interactions":{"isUnlimitedEntitlement":true,"entitlementRequest