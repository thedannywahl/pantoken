tool edit -> success] args={\\\"new_str\\\":\\\" * @a11y The defaults keep headings in a logical order and links underlined with an interactive colour, so they don't rely on colour alone. Don't skip heading levels for visual size, and don't remove the link underline without another cue.\\\\n * @example -automatica11y\\\\n * \\\\\\\\`\\\\\\\\`\\\\\\\\`html\\\\n * <article>\\\\n * <h2>Release notes</h2>\\\\n * <p>Body copy with a <a href=\\\\\\\"#notes\\\\\\\">link</a>.</p>\\\\n * </article>\\\\n * \\\\\\\\`\\\\\\\\`\\\\\\\\`\\\\n * @example\\\\n * <article>\\\",\\\"old_str\\\":\\\" * @example\\\\n * <article>\\\",\\\"path\\\":\\\"/Users/dwahl/Scripts/pantoken/formats/components/src/rules/prose/index.ts\\\"}\\n[tool edit -> success] args={\\\"new_str\\\":\\\" * @a11y The gradient border and background are decoration. Keep text on them at a readable contrast (the gradient stops vary), and don't use the AI treatment as the only sign that content came from an AI.\\\\n * @example -automatica11y\\\\n * \\\\\\\\`\\\\\\\\`\\\\\\\\`html\\\\n * <div class=\\\\\\\"--border-color-ai --border-radius-md --border-width-sm --p-md\\\\\\\">\\\\n * AI-generated summary\\\\n * </div>\\\\n * \\\\\\\\`\\\\\\\\`\\\\\\\\`\\\\n * @example\\\\n * <div class=\\\\\\\"--border-color-ai --border-radius-md --border-width-sm --background-secondary\\\\\\\">\\\",\\\"old_str\\\":\\\" * @example\\\\n * <div class=\\\\\\\"--border-color-ai --border-radius-md --border-width-sm --background-secondary\\\\\\\">\\\",\\\"path\\\":\\\"/Users/dwahl/Scripts/pantoken/formats/components/src/utilities/ai-gradient/index.ts\\\"}\\n[tool bash -> success] args={\\\"command\\\":\\\"cd /Users/dwahl/Scripts/pantoken/formats/components && python3 - <<'E'\\\\nE\\\\nsed -n 1,12p scripts/audit-plugin-components.ts; grep -n \\\\\\\"\\\\\\\\.\\\\\\\\.\\\\\\\\.PLUGIN_AUDIT_RECORDS\\\\\\\" scripts/audit-accessibility.ts; grep -rn \\\\\\\"PLUGIN_AUDIT_RECORDS\\\\\\\" tests | head\\\",\\\"description\\\":\\\"Find usages\\\"}\\n[assistant] I'll add a core-extras export in the same module and a single `auditRecords()` helper.\\n[tool edit -> success] args={\\\"new_str\\\":\\\"/**\\\\n * Plugin-owned components that the page audit covers alongside the core records. Each rendered\\\\n * page also loads the plugin stylesheet, since the core styles don't include these components.\\\\n * @module\\\\n */\\\\nimport type { Definition } from \\\\\\\"../src/lib/define.ts\\\\\\\";\\\\nimport { COMPONENTS } from \\\\\\\"../src/components/index.ts\\\\\\\";\\\\nimport { focus } from \\\\\\\"../src/declarations/focus/index.ts\\\\\\\";\\\\nimport { prose } from \\\\\\\"../src/rules/prose/index.ts\\\\\\\";\\\\nimport { base } from \\\\\\\"../src/rules/base/index.ts\\\\\\\";\\\\nimport { aiGradient } from \\\\\\\"../src/utilities/ai-gradient/index.ts\\\\\\\";\\\\nimport { UTILITIES } from \\\\\\\"../src/utilities/index.ts\\\\\\\";\\\\nimport {\\\",\\\"old_str\\\":\\\"/**\\\\n * Plugin-owned components that the page audit covers alongside the core records. Each rendered\\\\n * page also loads the plugin stylesheet, since the core styles don't include these components.\\\\n * @module\\\\n */\\\\nimport {\\\",\\\"path\\\":\\\"/Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-plugin-components.ts\\\"}\\n[tool bash -> success] args={\\\"command\\\":\\\"cd /Users/dwahl/Scripts/pantoken/formats/components && cat >> scripts/audit-plugin-components.ts <<'E'\\\\nE\\\\ntail -12 scripts/audit-plugin-components.ts; grep -n \\\\\\\"export const prose\\\\\\\\|export const base\\\\\\\" src/rules/*/index.ts\\\",\\\"description\\\":\\\"Check exports\\\"}\\n[tool edit -> success] args={\\\"new_str\\\":\\\"/** Plugin stylesheet copied next to the core assets for the page audit. */\\\\nexport const PLUGIN_STYLESHEET = \\\\\\\"custom-components/custom-components.css\\\\\\\";\\\\n\\\\n/** Core utilities and rules whose markup carries accessibility meaning; `icon` and `screen-reader-content` already ship in `COMPONENTS`. */\\\\nexport const CORE_AUDIT_EXTRAS: readonly Definition[] = [\\\\n ...UTILITIES.filter(\\\\n (record) =>\\\\n !COMPONENTS.some((component) => component.name === record.name) && record.name !== \\\\\\\"mask\\\\\\\",\\\\n ),\\\\n aiGradient,\\\\n base,\\\\n prose,\\\\n];\\\\n\\\\n/** Every record the page audit covers, in a stable order with unique names. */\\\\nexport function auditRecords(): readonly (Definition | PluginAuditRecord)[] {\\\\n return [...COMPONENTS, focus, ...CORE_AUDIT_EXTRAS, ...PLUGIN_AUDIT_RECORDS];\\\\n}\\\",\\\"old_str\\\":\\\"/** Plugin stylesheet copied next to the core assets for the page audit. */\\\\nexport const PLUGIN_STYLESHEET = \\\\\\\"custom-components/custom-components.css\\\\\\\";\\\",\\\"path\\\":\\\"/Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-plugin-components.ts\\\"}\\n[tool edit] args={\\\"new_str\\\":\\\" const definitions = auditRecords();\\\",\\\"old_str\\\":\\\" const definitions = [...COMPONENTS, focus, ...PLUGIN_AUDIT_RECORDS];\\\",\\\"path\\\":\\\"/Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts\\\"}\\n[tool edit] args={\\\"new_str\\\":\\\"import { auditRecords, PLUGIN_STYLESHEET } from \\\\\\\"./audit-plugin-components.ts\\\\\\\";\\\",\\\"old_str\\\":\\\"import { PLUGIN_AUDIT_RECORDS, PLUGIN_STYLESHEET } from \\\\\\\"./audit-plugin-components.ts\\\\\\\";\\\",\\\"path\\\":\\\"/Users/dwahl/Scripts/pantoken/formats/components/scripts/audit-accessibility.ts\\\"}\"},{\"role\":\"assistant\",\"content\":\"Runtime-derived request context:\\n```json\\n{\\n  \\\"permissionBoundary\\\": \\\"write\\\",\\n  \\\"pathAccessKind\\\": null,\\n  \\\"rawRequestKind\\\": \\\"write\\\",\\n  \\\"parsedCommandCount\\\": null,\\n  \\\"allParsedCommandsReadOnly\\\": null,\\n  \\\"hasWriteFileRedirection\\\": null,\\n  \\\"possiblePathCount\\\": null,\\n  \\\"possibleUrlCount\\\": null,\\n  \\\"requestSandboxBypass\\\": false\\n}\\n```\\n\\n`permissionBoundary` identifies what the permission en