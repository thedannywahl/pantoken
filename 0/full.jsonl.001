{"type":"tool.execution_complete","data":{"toolCallId":"toolu_01HZhQBk55GGtW7uyNinpBrd","model":"claude-sonnet-5.5","interactionId":"13d1d66b-1a27-42a1-a76c-b2ac94a56693","turnId":"58","rte":true,"fileEdits":[{"path":"/Users/dwahl/Scripts/pantoken/docs/scripts/accessibility-evidence.test.ts","kind":"edit"}],"success":true,"result":{"content":"File /Users/dwahl/Scripts/pantoken/docs/scripts/accessibility-evidence.test.ts updated with changes.","detailedContent":"\ndiff --git a/Users/dwahl/Scripts/pantoken/docs/scripts/accessibility-evidence.test.ts b/Users/dwahl/Scripts/pantoken/docs/scripts/accessibility-evidence.test.ts\nindex 0000000..0000000 100644\n--- a/Users/dwahl/Scripts/pantoken/docs/scripts/accessibility-evidence.test.ts\n+++ b/Users/dwahl/Scripts/pantoken/docs/scripts/accessibility-evidence.test.ts\n@@ -285,7 +285,7 @@\n \n test(\"checked-in evidence has supported coverage and retains real review/failure gaps\", () => {\n   const snapshot = loadAccessibilitySnapshot(snapshotJson);\n-  expect(Object.keys(snapshot.records)).toHaveLength(76);\n+  expect(Object.keys(snapshot.records)).toHaveLength(82);\n   expect(snapshot.records.badge).toHaveLength(4);\n   expect(snapshot.records.alert).toHaveLength(8);\n   expect(snapshot.records.badge!.every((row) => (row.checks.conditions?.fail ?? 0) === 0)).toBe(\n"},"toolTelemetry":{"properties":{"command":"edit","options":"{\"truncateBasedOn\":\"tokenCount\",\"truncateStyle\":\"middle\"}","inputs":"[\"path\",\"old_str\",\"new_str\",\"command\"]","resolvedPathAgainstCwd":"false","fileExtension":"[\".ts\"]","codeBlocks":"[{\"fileExt\":\".ts\",\"languageId\":\"typescript\",\"linesAdded\":1,\"linesRemoved\":1}]","languageId":"[\"typescript\"]"},"restrictedProperties":{"filePaths":"[\"/Users/dwahl/Scripts/pantoken/docs/scripts/accessibility-evidence.test.ts\"]"},"metrics":{"resultLength":100,"resultForLlmLength":100,"linesAdded":1,"linesRemoved":1,"context_token_limit":200000.0,"context_current_tokens":114051.0,"large_output