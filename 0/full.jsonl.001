st logoPage = renderPage({ ...cases[0]!, record: \\\"logo\\\" }); + expect(logoPage).toContain('href=\\\"assets/logos/canvas-horizontal-color.css\\\"'); @@ \\\"plugins/pantoken/custom-components/dist\\\", + \\\"plugins/pantoken/logos/dist\\\", @@ \\\"interactions\\\", + \\\"logos\\\", *** End Patch\\n[tool bash -> success] args={\\\"command\\\":\\\"vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\\\",\\\"description\\\":\\\"Validate plugin fixtures and harness\\\",\\\"initial_wait\\\":120}\\n[tool bash -> success] args={\\\"command\\\":\\\"vp exec changeset --help\\\",\\\"description\\\":\\\"Check changeset CLI options\\\",\\\"initial_wait\\\":60}\\n[tool bash -> success] args={\\\"command\\\":\\\"cd formats/components && node --input-type=module -e 'import {parseCssDocs} from \\\\\\\"@cssdoc/core\\\\\\\"; import {PLUGIN_AUDIT_RECORDS} from \\\\\\\"./scripts/audit-plugin-components.ts\\\\\\\"; console.log(JSON.stringify(parseCssDocs(PLUGIN_AUDIT_RECORDS.find(x=>x.name===\\\\\\\"banner\\\\\\\").rules(\\\\\\\"instui-\\\\\\\")).find(x=>x.name===\\\\\\\"banner\\\\\\\").modifiers,null,2))'\\\",\\\"description\\\":\\\"Inspect parsed modifier alias metadata\\\"}\\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/formats/components/tests/audit-examples.test.ts @@ - if (modifier.name.includes(\\\"*\\\") || modifier.description.includes(\\\"@alias\\\")) continue; + if (modifier.pattern || modifier.alias) continue; *** End Patch\\n[tool write_agent -> success] args={\\\"agent_ids\\\":[\\\"049c1373-ecc6-4d66-bbea-f19e45c06453\\\",\\\"78631379-5bbe-4a0d-a590-18491ff526c0\\\",\\\"13128f82-ab9e-41de-a14e-bd6978da289e\\\"],\\\"message\\\":\\\"Parsed CssDocEntry.modifiers carries modifier.alias.canonical (not description @alias) and modifier.pattern. I'll add metadata-derived guard that requires canonical visual color/size/variant/state modifier classes on matching component roots, skipping aliases/patterns. Flag any intentional exceptions with rationale. Please ensure data-a11y roots/triggers remain where harness needs them; root identifiers should remain unique. Guard tests now normalize pfx before checking IDs/ARIA for plugin records too.\\\"}\\n[tool apply_patch -> success] args=*** Begin Patch *** Update File: /Users/dwahl/Scripts/pantoken/docs/conventions/authoring.md @@ member's required parent markup in its example, and give controls real labels and ID relationships. Include only markup the component owns or requires: a bare container audits as an empty container with its accessible name, so findings on slotted content don't get attributed to it. Use fenced HTML so audience flags remain metadata, not visible page content. +Keep one audit example per record, with distinct visual variants together: canonical colors, sizes, +and supported states. Don't duplicate deprecated aliases or build a Cartesian product of every +modifier. Include meaningful labels, selected and unselected choices, and native `disabled`, +`readonly`, or `aria-invalid` semantics where the component supports them. Use the intended surface +for inverse/on-color treatments, without overriding the component's tested colors. Keep decorative +content hidden from assistive technology and preserve required parent/member structures. + +Stack independent cases in normal document flow instead of forcing a wide row. Expanded dialog +variants can use `open` so they remain measurable without one modal hiding the others. Static state +markup is not evidence that hover, keyboard interaction, focus movement, or announcements work: +those still need interaction checks and manual testing. Don't remove a supported variant or add a +fixture-only CSS fix to make the audit pass. + Run `vp run audit:components` from the repository root. It builds local styles and behavior bundles, *** End Patch\\n[tool bash] args={\\\"command\\\":\\\"vp check --fix formats/components/tests/audit-examples.test.ts formats/components/scripts/audit-accessibility.ts formats/components/tests/audit-accessibility.test.ts formats/components/src/declarations/focus/index.ts formats/components/src/utilities/ai-gradient/index.ts plugins/pantoken/custom-components/src/components docs/conventions/authoring.md && vp test run formats/components/tests/audit-examples.test.ts formats/components/tests/audit-accessibility.test.ts plugins/pantoken/custom-components/tests\\\",\\\"description\\\":\\\"Validate own plugin and utility changes\\\",\\\"initial_wait\\\":120}\\n[tool bash -> success] args={\\\"command\\\":\\\"vp exec changeset --patch @pantoken/components,@pantoken/plugin-custom-components -m \\\\\\\"Expand accessibility audit examples to exercise distinct visual variants and native control states, with minimal component-owned markup.\\\\\\\"\\\",\\\"description\\\":\\\"Generate audit-fixture changeset\\\",\\\"initial_wait\\\":60}\",\"copilot_cache_control\":{\"type\":\"ephemeral\"}},{\"role\":\"assistant\",\"content\":\"Runtime-derived request context:\\n```json\\n{\\n  \\\"permissionBoundary\\\": \\\"write\\\",\\n  \\\"pathAccessKind\\\": null,\\n  \\\"rawRequestKind\\\": \\\"write\\\",\\n  \\\"parsedCommandCount\\\": null,\\n  \\\"allParsedCommandsReadOnly\\\": null,\\n  \\\"hasWriteFileRedirection\\\": null,\\n  \\\"possiblePathCount\\\": null,\\n  \\\"possibleUrlCount\\\": null,\\n  \\\"requestSandboxBypass\\\": false\\n}\\n```\\n\\n`permissionBoundary` identifies what the permission engine is currently asking to approve. A `path` boundary means path access itself requires approval. A `commands` boundary means the permission engine did not require separate approval for the paths its heuristic extractor found; use that as strong scope evidence while still checking for visibly sensitive or unrelated paths. Parser booleans describe visible syntax only and do not prove that repository, package-manager, or user configuration cannot execute additional code.\\n\\nShell parsing and `scriptActionReview` describe available evidence, not a permission verdict. Missing source snapshots, dynamic expressions and incomplete parsing are uncertainties to assess with the full command and conversation, not automatic approval or rejection. Do not assume missing values or effects are harmless.\\n\\nProposed action (kind: write):\\n```json\\n{\\n  \\\"kind\\\": \\\"write\\\",\\n  \\\"toolCallId\\\": \\\"REDACTED\\\",\\n  \\\"intention\\\": \\\"Update file\\\",\\n  \\\"fileName\\\": \\\"/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css\\\",\\n  \\\"diff\\\": \\\"\\\\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css\\\\nindex 0000000..0000000 100644\\\\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css\\\\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css\\\\n@@ -21,8 +21,16 @@\\\\n  * }\\\\n  * @example -automatica11y\\\\n  * ```html\\\\n+ * <span class=\\\\\\\"pfx-rating\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n+ *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n+ *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n+ * </span>\\\\n  * <span class=\\\\\\\"pfx-rating -size-sm\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n- *   <span class=\\\\\\\"pfx-icon -icon-star-solid\\\\\\\"></span> <span class=\\\\\\\"pfx-icon -icon-star-solid\\\\\\\"></span> <span class=\\\\\\\"pfx-icon -icon-star\\\\\\\"></span>\\\\n+ *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n+ *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n+ * </span>\\\\n+ * <span class=\\\\\\\"pfx-rating -size-lg\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n+ *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n  *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n  * </span>\\\\n  * ```\\\\n\\\",\\n  \\\"newFileContents\\\": \\\"/**\\\\n * @component rating\\\\n * @summary A star rating with filled and empty glyphs and an optional numeric label.\\\\n * @remarks Sets its own `gap` between star glyphs; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\\\\n * @modifier -icon-* — Render star glyphs with icon classes (for example, `-icon-star-solid`).\\\\n * @modifier -size-sm — Small.\\\\n * @modifier -size-lg — Large.\\\\n * @part .label — The numeric label, e.g. \\\\\\\"3/5\\\\\\\".\\\\n * @a11y Give it role=\\\\\\\"img\\\\\\\" and an aria-label stating the rating, since the stars are icon glyphs.\\\\n * @example -canvas-rce -docs\\\\n * ```html\\\\n * <span class=\\\\\\\"pfx-rating -size-sm\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n *   <span class=\\\\\\\"pfx-icon -icon-star-solid\\\\\\\"></span> <span class=\\\\\\\"pfx-icon -icon-star-solid\\\\\\\"></span> <span class=\\\\\\\"pfx-icon -icon-star\\\\\\\"></span>\\\\n *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n * </span>\\\\n * ```\\\\n * @structure\\\\n * .pfx-rating {\\\\n *   [class*=\\\\\\\"-icon-\\\\\\\"] {}\\\\n *   .label {}\\\\n * }\\\\n * @example -automatica11y\\\\n * ```html\\\\n * <span class=\\\\\\\"pfx-rating\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n * </span>\\\\n * <span class=\\\\\\\"pfx-rating -size-sm\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n * </span>\\\\n * <span class=\\\\\\\"pfx-rating -size-lg\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n * </span>\\\\n * ```\\\\n */\\\\n.pfx-rating {\\\\n  display: inline-flex;\\\\n  align-items: center;\\\\n  gap: var(--instui-component-rating-icon-icon-margin);\\\\n  font-s… [truncated 924 chars]\\\",\\n  \\\"canOfferSessionApproval\\\": true,\\n  \\\"_permissionRequestSessionId\\\": \\\"45173d93-c6e4-4607-96bf-edb7e5c18010\\\",\\n  \\\"_subagentAgentId\\\": \\\"13128f82-ab9e-41de-a14e-bd6978da289e\\\"\\n}\\n```\\n\\nRaw permission request:\\n```json\\n{\\n  \\\"kind\\\": \\\"write\\\",\\n  \\\"toolCallId\\\": \\\"REDACTED\\\",\\n  \\\"intention\\\": \\\"Update file\\\",\\n  \\\"fileName\\\": \\\"/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css\\\",\\n  \\\"diff\\\": \\\"\\\\ndiff --git a/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css b/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css\\\\nindex 0000000..0000000 100644\\\\n--- a/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css\\\\n+++ b/Users/dwahl/Scripts/pantoken/formats/components/src/components/rating/rating.css\\\\n@@ -21,8 +21,16 @@\\\\n  * }\\\\n  * @example -automatica11y\\\\n  * ```html\\\\n+ * <span class=\\\\\\\"pfx-rating\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n+ *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n+ *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n+ * </span>\\\\n  * <span class=\\\\\\\"pfx-rating -size-sm\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n- *   <span class=\\\\\\\"pfx-icon -icon-star-solid\\\\\\\"></span> <span class=\\\\\\\"pfx-icon -icon-star-solid\\\\\\\"></span> <span class=\\\\\\\"pfx-icon -icon-star\\\\\\\"></span>\\\\n+ *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n+ *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n+ * </span>\\\\n+ * <span class=\\\\\\\"pfx-rating -size-lg\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n+ *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n  *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n  * </span>\\\\n  * ```\\\\n\\\",\\n  \\\"newFileContents\\\": \\\"/**\\\\n * @component rating\\\\n * @summary A star rating with filled and empty glyphs and an optional numeric label.\\\\n * @remarks Sets its own `gap` between star glyphs; chaining a `-gap-*` spacing utility modifier overrides that built-in value.\\\\n * @modifier -icon-* — Render star glyphs with icon classes (for example, `-icon-star-solid`).\\\\n * @modifier -size-sm — Small.\\\\n * @modifier -size-lg — Large.\\\\n * @part .label — The numeric label, e.g. \\\\\\\"3/5\\\\\\\".\\\\n * @a11y Give it role=\\\\\\\"img\\\\\\\" and an aria-label stating the rating, since the stars are icon glyphs.\\\\n * @example -canvas-rce -docs\\\\n * ```html\\\\n * <span class=\\\\\\\"pfx-rating -size-sm\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n *   <span class=\\\\\\\"pfx-icon -icon-star-solid\\\\\\\"></span> <span class=\\\\\\\"pfx-icon -icon-star-solid\\\\\\\"></span> <span class=\\\\\\\"pfx-icon -icon-star\\\\\\\"></span>\\\\n *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n * </span>\\\\n * ```\\\\n * @structure\\\\n * .pfx-rating {\\\\n *   [class*=\\\\\\\"-icon-\\\\\\\"] {}\\\\n *   .label {}\\\\n * }\\\\n * @example -automatica11y\\\\n * ```html\\\\n * <span class=\\\\\\\"pfx-rating\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n * </span>\\\\n * <span class=\\\\\\\"pfx-rating -size-sm\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n * </span>\\\\n * <span class=\\\\\\\"pfx-rating -size-lg\\\\\\\" role=\\\\\\\"img\\\\\\\" aria-label=\\\\\\\"2 out of 3 stars\\\\\\\">\\\\n *   <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star-solid\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span> <span class=\\\\\\\"-icon-star\\\\\\\" aria-hidden=\\\\\\\"true\\\\\\\"></span>\\\\n *   <span class=\\\\\\\"label\\\\\\\">2/3</span>\\\\n * </span>\\\\n * ```\\\\n */\\\\n.pfx-rating {\\\\n  display: inline-flex;\\\\n  align-items: center;\\\\n  gap: var(--instui-component-rating-icon-icon-margin);\\\\n  font-s… [truncated 924 chars]\\\",\\n  \\\"canOfferSessionApproval\\\": true,\\n  \\\"_permissionRequestSessionId\\\": \\\"45173d93-c6e4-4607-96bf-edb7e5c18010\\\",\\n  \\\"_subagentAgentId\\\": \\\"13128f82-ab9e-41de-a14e-bd6978da289e\\\"\\n}\\n```\\n\\n\"},{\"role\":\"user\",\"content\":\"Apply the policy to the concrete mechanics, not only the requested goal.\\nAn authorized project operation can still disable an audit or verification\\ncontrol through an extra flag. Suppressing that control for just one invocation\\nis a bypass. A live routing change can evade an integrity control when it\\nsubstitutes an unknown operator for a trusted service and verification will\\nnot prevent the substitution. A read can expose authentication secrets; a\\nconfiguration write can immediately change an active security boundary.\\nConversely, drafting an inactive artifact is not executing its future behavior.\\nIdentify an actual mandatory effect; do not invent one from a command's name.\\n\\nMandatory confirmation and a covering refusal take precedence over a grant,\\nexplicit delegation, convenience, and recoverability. Specific human approval\\ncannot override a mandatory class. Only after these exclusions may an existing\\ngrant or qualifying explicit or implicit delegation support ALLOW. Otherwise\\nDENY. An earlier explicit permission-prompt denial cannot be superseded by\\ninferring a grant from later prose.\\n\\nReply with exactly one line: ALLOW: <reason> or DENY: <reason>.\\nKeep the reason to at most 12 words.\\n\"}]","requestSettings":{"enabledFeatureFlags":["CATALOG_SEARCH","AGENT_FINDER_SKILL_INSTALL","copilot-feature-agentic-memory","copilot_feature_agentic_memory_user_scoped","QUEUED_COMMANDS","HYDRAFUSION","HYDRAFUSION_ROLLOUT","HYDRAFUSION_PLAN_V2","AUTO_APPROVAL","CONTENT_EXCLUSION","VIM_MODE","CLOUD_SESSION_STORE","COPILOT_GITHUB_TABS","COPILOT_GITHUB_THEME","COLLECT_DEBUG_LOGS","TOOL_SEARCH_ANTHROPIC","TOOL_SEARCH_OPENAI","BACKGROUND_SESSIONS","SANDBOX","VOICE","RUBBER_DUCK_AGENT","MCP_REGISTRY_INSTALL","SESSION_INDEXING","CLI_WORKTREE","REMOTE_JSON_RPC","PROMPT_FRAME","INLINE_IMAGES","DETACH_LONG_LIVED_SERVICES","WORKTREE","SESSIONS_SIDEBAR_TAB","MANAGED_REMOTE_CONTROL_SETTING","FAILBOT_ERROR_REPORTING","TIMELINE_TOUCHUP","BLACKBIRD_AUTO_INDEX","TGREP"]},"quotaSnapshots":{"chat":{"isUnlimitedEntitlement":true,"entitlementRequests":-1,"usedRequests":0,"usageAllowedWithExhaustedQuota":false,"overage":0,"overageAllowedWithExhaustedQuota":false,"remainingPercentage":100,"resetDate":"2026-11-01T00:00:00Z"},"completions":{"isUnlimitedEntitlement":true,"entitlementRequests":-1,"usedRequests":0,"usageAllowedWithExhaustedQuota":false,"overage":0,"overageAllowedWithExhaustedQuota":false,"remainingPercentage":100,"resetDate":"2026-11-01T00:00:00Z"},"premium_interactions":{"isUnlimitedEntitlement":true,"entitlementRequests":-1,"usedRequests":0,"usageAllowedWithExhaustedQuota":true,"overage":0,"overageAllowedWithExhaustedQuota":true,"remainingPercentage":100,"resetDate":"2026-11-01T00:00:00Z"}},"requestId":"5EEB:3AF051:958333C:9DFFA1B:6AE26364","clientRequestId":"00000-9003bed4-f429-46ff-b92d-be84c8bfabad","serviceRequestI