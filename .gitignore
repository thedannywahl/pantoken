# Generated build artifacts — per-package generated/ dirs, reproduced by `vp run -r build`.
**/generated/

# Materialized `scaffold:dev` preview instances (packages/scaffold/scripts/scaffold-dev.ts).
packages/scaffold/.dev/

# Docs site build output (TypeDoc API markdown, VitePress cache, generated nav logos; reproduced by `docs:build`).
docs/api/
docs/*/api/
docs/.vitepress/cache/
docs/docs/.vitepress/cache/
docs/.vitepress/.temp/
docs/docs/.vitepress/.temp/
docs/public/
!docs/public/
docs/public/*
!docs/public/logo-dark.svg
!docs/public/logo-light.svg
# Static (non-generated) site assets: favicons and the home-page feature icons. Nothing regenerates
# these, so they have to be committed or the deployed site 404s on them.
!docs/public/favicon.ico
!docs/public/favicon.png
!docs/public/book-check-dark.svg
!docs/public/book-check-light.svg
!docs/public/package-dark.svg
!docs/public/package-light.svg
!docs/public/unlink-dark.svg
!docs/public/unlink-light.svg
!docs/public/workflow-dark.svg
!docs/public/workflow-light.svg
!docs/public/robots.txt
!docs/public/.well-known/
docs/public/.well-known/*
!docs/public/.well-known/api-catalog

# Noto script faces the social-card renderer fetches on demand (docs/scripts/lib/og-fonts.ts).
docs/assets/fonts/noto/

