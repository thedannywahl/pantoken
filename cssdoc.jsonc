{
  "$schema": "https://cssdoc.dev/cssdoc.schema.json",
  "modifierConvention": "rscss",
  "inlineComments": "ignore",
  // A component's own `@modifier` always wins over a same-named `@global` utility modifier (e.g.
  // `view`'s `-background-secondary` vs. the global `background` utility's copy of the same name) —
  // "base" is already the default; pinned explicitly so the tie-break is documented, not implicit.
  "globalPrecedence": "base",
  "render": {
    "sectionOrder": [
      "accessibility",
      "usage",
      "demo",
      "examples",
      "structure",
      "slots",
      "modifiers",
      "parts",
      "shadowParts",
      "pseudoElements",
      "states",
      "cssProperties",
      "functions",
      "animations",
      "layers",
      "conditions",
      "tokensConsumed",
      "compat",
      "subcomponents",
      "related",
      "see"
    ],
    "headingPrefix": "CSS:",
    "structureView": "both"
  }
}
