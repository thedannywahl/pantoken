{
  "name": "@pantoken/plugin-layouts",
  "version": "0.4.0",
  "description": "pantoken plugin: layout composition records for downstream consumers.",
  "homepage": "https://pantoken.app",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "plugins/pantoken/layouts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./layouts.css": "./dist/layouts.css",
    "./*.css": "./dist/*.css",
    "./model.json": "./dist/model.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vp run generate && vp pack --watch",
    "test": "vp run generate && vp test",
    "check": "vp run generate && vp check && vp run check:drift",
    "extract": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" extract layouts.strings",
    "translate": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate layouts.strings --provider claude",
    "translate:agy": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate layouts.strings --provider agy",
    "translate:copilot": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate layouts.strings --provider copilot",
    "translate:force": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate layouts.strings --provider claude --force",
    "translate:force:agy": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate layouts.strings --provider agy --force",
    "translate:force:copilot": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate layouts.strings --provider copilot --force",
    "check:drift": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" check layouts.strings"
  },
  "dependencies": {
    "@pantoken/model": "workspace:*",
    "@pantoken/plugin-kit": "workspace:*"
  },
  "devDependencies": {
    "@pantoken/cssdoc-model": "workspace:*",
    "@pantoken/i18n-engine": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pantoken": {
    "key": "layouts",
    "kind": "namespace"
  }
}
