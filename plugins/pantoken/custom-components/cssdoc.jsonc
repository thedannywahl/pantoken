{
  // Scoped cssdoc config for @pantoken/plugin-custom-components generated CSS linting.
  // Extends the repo-root config and adds providers for records referenced by plugin-authored CSS.
  "$schema": "https://cssdoc.dev/cssdoc.schema.json",
  "extends": ["../../../cssdoc.jsonc"],
  "providers": [
    { "path": "../../../formats/components/src/generated/_records.css" },
    { "path": "../../../formats/components/generated/utilities.css" }
  ]
}
