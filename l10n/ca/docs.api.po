msgid "# Variable: iconButton"
msgstr "# Variable: iconButton"

#: renderers/web-components/src/variables/iconButton.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`<instui-icon-button>` — an icon-only, square button. `label` becomes the button's `aria-label`;\nslotted content is the glyph (e.g. an `<instui-icon>`)."
msgstr "`&lt;instui-icon-button&gt;` — un botó quadrat només amb icona. `label` es converteix en `aria-label` del botó; el contingut ranurat és el glyph (per exemple, un `&lt;instui-icon&gt;`)."

