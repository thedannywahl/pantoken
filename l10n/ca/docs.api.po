#, no-c-format
msgctxt "docs.api:prose"
msgid "The dropped upstream token name, e.g. `--instui-component-truncate-text-line-height`."
msgstr "El nom del token ascendent eliminat, p. ex. `--instui-component-truncate-text-line-height`."

