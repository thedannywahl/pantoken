msgstr "Estats als quals reacciona el component, de `@cssstate`, `:state()`, pseudo-classes, o classes d'estat."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### slots"
msgstr "### slots"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Named slots the component shell exposes, from `@slot`."
msgstr "Ranures nomenades que el component exposa, de `@slot`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### elements?"
msgstr "### elements?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Allowed HTML elements from `@element` (default + optional named profiles)."
msgstr "Elements HTML permesos de `@element` (per defecte + perfils nomenats opcionals)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### todos"
msgstr "### todos"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Internal to-do notes, from `@todo` tags and `/* @todo … */` inline comments. Development notes,\nnot public API — emitters may omit them (like [CssDocEntry.privateRemarks](#privateremarks))."
msgstr "Notes internes de tasques pendents, d'etiquetes `@todo` i comentaris `/* @todo … */` inline. Notes de desenvolupament,\nno una API pública — els emissors poden ometre-les (com [CssDocEntry.privateRemarks](#privateremarks))."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### cssPropertiesConsumed"
msgstr "### cssPropertiesConsumed"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
