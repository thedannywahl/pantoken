#, no-c-format
msgctxt "docs.api:prose"
msgid "The release stage from a modifier flag tag (`@alpha`/`@beta`/`@experimental`/`@internal`/`@public`)."
msgstr "L'etapa de llançament d'una etiqueta de bandera de modificador (`@alpha`/`@beta`/`@experimental`/`@internal`/`@public`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### since?"
msgstr "### since?"

