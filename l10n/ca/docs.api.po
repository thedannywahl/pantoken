msgid "The elements the ring applies to by default (the common interactive/focusable elements)."
msgstr "Els elements als quals s'aplica l'anell per defecte (els elements interactius/enfocables comuns)."

#: formats/components/src/variables/alertCss.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Variable: alertCss"
msgstr "# Variable: alertCss"

