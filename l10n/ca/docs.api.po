msgctxt "docs.api:text"
msgid "# CSS: rubric-note"
msgstr ""

#: css/rubric-note.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`div[class~=\"instui-rubric-note\"]` — Structured note with rubric categories and scoring indicators."
msgstr ""

#: css/rubric-note.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "✅ Use Rubric-Note when:"
msgstr ""

#: css/rubric-note.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "- Displaying grading rubric or assessment criteria\n- You need to structure content by category with scores or indicators\n- The layout should emphasize structure and hierarchy\n🚫 Don't use Rubric-Note when:"
msgstr ""

