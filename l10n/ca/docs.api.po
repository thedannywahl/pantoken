msgstr "Funcions personalitzades CSS (`@function`) que aquest component defineix."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### animations"
msgstr "### animations"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Animations (`@keyframes`) this component exposes."
msgstr "Animacions (`@keyframes`) que aquest component exposa."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
