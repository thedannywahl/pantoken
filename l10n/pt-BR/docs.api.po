msgid "Sets `display: flex`."
msgstr "Define `display: flex`."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Display utilities: `block`, `inline-block`, `inline`, `flex`, `inline-flex`, and `none`."
msgstr "Utilitários de display: `block`, `inline-block`, `inline`, `flex`, `inline-flex` e `none`."

#: css/layout.md
