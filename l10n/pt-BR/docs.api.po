msgctxt "docs.api:prose"
msgid "A single file to load from a CDN, identified by npm package name and path within it."
msgstr "Um único arquivo para carregar de um CDN, identificado pelo nome do pacote npm e pelo caminho dentro dele."

#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### package"
msgstr "### package"

#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The npm package name, e.g. `\"@pantoken/components\"`."
msgstr "O nome do pacote npm, p.ex. `\"@pantoken/components\"`."

