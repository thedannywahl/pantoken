msgstr "### sync()"

#: formats/interactions/src/interfaces/TruncateAutoHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Force a recompute of the derived `--lines` value."
msgstr "Fòse rekalkil valè derive `--lines`."

#: formats/interactions/src/interfaces/TruncateAutoHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Remove observers/listeners created by init."
msgstr "Retire observatè/ekoutè yo ki te kreye pa init."

#: formats/interactions/src/interfaces/TruncateAutoOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: TruncateAutoOptions"
msgstr "# Entèfas: TruncateAutoOptions"

#: formats/interactions/src/interfaces/TruncateAutoOptions.md
#, no-c-format
