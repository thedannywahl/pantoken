#: formats/interactions/src/type-aliases/CommandHandler.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Type Alias: CommandHandler"
msgstr "# Alyas tip: CommandHandler"

#: formats/interactions/src/type-aliases/CommandHandler.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Callback invoked when a `command` event (or fallback click) resolves to a target."
msgstr "Fonksyon callback ki rele lè yon evènman `command` (oswa klik ranplasman) rezoud sou yon sib."

#: formats/interactions/src/type-aliases/OnCommand.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Type Alias: OnCommand"
msgstr "# Alyas tip: OnCommand"

#: formats/interactions/src/type-aliases/OnCommand.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Command-event wiring function: bind one target to a handler, with click fallback when needed."
msgstr "Fonksyon pou ranje koneksyon kòmand-evènman: lye yon sib ak yon handler, avèk yon fallback klik lè sa nesesè."

#: formats/interactions/src/type-aliases/OnCommand.md
#, no-c-format
msgctxt "docs.api:text"
