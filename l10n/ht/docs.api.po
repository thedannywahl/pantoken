msgstr "Manch ki retounen pa [initProgressCircle](../functions/initProgressCircle.md)."

#: formats/interactions/src/interfaces/ProgressCircleHandle.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### cleanup()"
msgstr "### cleanup()"

#: formats/interactions/src/interfaces/ProgressCircleHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Cancel the pending mount animation."
msgstr "Anile animasyon montaj ki an atant."

#: formats/interactions/src/interfaces/ProgressCircleHandle.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### finish()"
msgstr "### finish()"

#: formats/interactions/src/interfaces/ProgressCircleHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Release the mount state immediately."
msgstr "Lage eta montaj la imedyatman."

#: formats/interactions/src/interfaces/ProgressCircleOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: ProgressCircleOptions"
msgstr "# Entèfas: ProgressCircleOptions"

#: formats/interactions/src/interfaces/ProgressCircleOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Options for the ProgressCircle mount animation."
msgstr "Opsyon pou animasyon montaj ProgressCircle la."

#: formats/interactions/src/interfaces/ProgressCircleOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### animationDelay?"
msgstr "### animationDelay?"

#: formats/interactions/src/interfaces/ProgressCircleOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Milliseconds before the mount state is released. Defaults to computed `--animation-delay`."
msgstr "Milisgond anvan eta montaj la lage. Pa default li se valè kalkile `--animation-delay`."

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: RemoveHandle"
msgstr "# Entèfas: RemoveHandle"

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Handle returned by [initRemove](../functions/initRemove.md)."
msgstr "Objè retounen pa [initRemove](../functions/initRemove.md)."

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Cancel pending dismissal and removal work."
msgstr "Anile travay ki an atant pou fèmen ak retire."

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### dismiss()"
msgstr "### dismiss()"

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Dismiss immediately, without waiting for the configured timeout."
msgstr "Fèmen imedyatman, san rete tann delè ki konfigire a."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: RemoveOptions"
msgstr "# Entèfas: RemoveOptions"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Options for a timeout-based removal."
msgstr "Opsyon pou retire ki baze sou delè (timeout)."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### timeout?"
msgstr "### timeout?"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Milliseconds before dismissal. Defaults to the target's computed `--timeout`."
msgstr "Milisèkond anvan fèmen. Pa default se `--timeout` kalkile pou sib la."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### transition?"
msgstr "### transition?"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Exit treatment. Defaults to `\"fade\"`, matching InstUI Alert."
msgstr "Tretman pou sòti. Pa default se `\"fade\"`, ki matche ak InstUI Alert."

#: formats/interactions/src/interfaces/TooltipHandle.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: TooltipHandle"
msgstr "# Entèfas: TooltipHandle"

#: formats/interactions/src/interfaces/TooltipHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Handle returned by [initTooltip](../functions/initTooltip.md)."
msgstr "Manyen ki retounen pa [initTooltip](../functions/initTooltip.md)."

#: formats/interactions/src/interfaces/TooltipHandle.md
