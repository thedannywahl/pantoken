msgctxt "docs.api:text"
msgid "# android"
msgstr "# android"

#: platforms/android/src/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`@pantoken/android` — emit Instructure design tokens as Android resource XML."
msgstr "`@pantoken/android` — emèt Instructure design tokens kòm XML resous Android."

#: platforms/android/src/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "It flattens the IR to concrete, single-mode values (`@pantoken/core`'s `toStyleDictionary`), then\nemits `res/values/colors.xml` (colour tokens) and `res/values/dimens.xml` (dimension tokens) via\n`@pantoken/sd-config`. Style Dictionary applies the Android transforms (`#aarrggbb`, `dp`/`sp`)."
msgstr "Li aplatir IR la pou valè konkrè, yon sèl-mòd (`@pantoken/core`'s `toStyleDictionary`), then\nemèt `res/values/colors.xml` (colour tokens) ak `res/values/dimens.xml` (dimension tokens) via\n`@pantoken/sd-config`. Style Dictionary aplike transfòmasyon Android yo (`#aarrggbb`, `dp`/`sp`)."

#: platforms/android/src/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Renames and re-exports [generateAndroid](functions/generateAndroid.md)"
msgstr "Renome epi re-eksporte [generateAndroid](functions/generateAndroid.md)"

#: platforms/android/src/interfaces/GenerateAndroidOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: GenerateAndroidOptions"
msgstr "# Entèfas: GenerateAndroidOptions"

#: platforms/android/src/interfaces/GenerateAndroidOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Options for [generateAndroid](../functions/generateAndroid.md) / [toAndroid](../functions/toAndroid.md)."
msgstr "Opsyon pou [generateAndroid](../functions/generateAndroid.md) / [toAndroid](../functions/toAndroid.md)."

#: platforms/android/src/interfaces/GenerateAndroidOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### outDir"
msgstr "### outDir"

#: platforms/android/src/interfaces/GenerateAndroidOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The output directory; files are written under `<outDir>/res/values`."
msgstr "The output directory; files are written under `&lt;outDir&gt;/res/values`."

#: platforms/android/src/interfaces/GenerateAndroidOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The theme to emit (default: `\"rebrand\"`)."
msgstr "Tèm pou emèt (pa defo: `\"rebrand\"`)."

#: platforms/android/src/interfaces/GenerateAndroidOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Which `light-dark()` mode to resolve (default: `\"light\"`)."
msgstr "Ki mòd `light-dark()` pou rezoud (pa defo: `\"light\"`)."

#: platforms/android/src/interfaces/GenerateAndroidOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Icon names to also emit as VectorDrawables under `res/drawable` (default: none)."
msgstr "Non ikon pou tou emèt kòm VectorDrawables anba `res/drawable` (pa defo: pa gen anyen)."

