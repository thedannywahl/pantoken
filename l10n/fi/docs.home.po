#: index.md:5
#, no-c-format
msgid "Create beautiful,<br/><span class=\"platform-line\">accessible<br/><span class=\"platform web\">web</span></span><br/>apps."
msgstr "Luo kauniita,<br/><span class=\"platform-line\">saavutettavia<br/><span class=\"platform web\">web</span></span><br/>sovelluksia."

#: index.md:7
#, no-c-format
msgid "One resolved token model, reshaped into stylesheets, framework bindings, native code, and design-tool payloads."
msgstr "Yksi ratkaistu token-malli, muutettuna tyylitaulukoiksi, kehys-sidoksiksi, natiivikoodiksi ja suunnittelutyökalujen sisältöihin."

#: index.md:10
#, no-c-format
msgid "Getting started"
msgstr "Aloittaminen"

#: index.md:13
#, no-c-format
msgid "CSS reference"
msgstr "CSS-viite"

#: index.md:16
#, no-c-format
msgid "API reference"
msgstr "API-viite"

#: index.md:22
#, no-c-format
msgid "One source of truth"
msgstr "Yksi totuuden lähde"

#: index.md:23
#, no-c-format
msgid "Every packages uses the official Instructure design tokens, components, and interactions from <a href=\"https://instructure.design\" target=\"_blank\">InstUI</a>."
msgstr "Jokainen paketti käyttää virallisia Instructure-suunnittelutunnuksia, komponentteja ja vuorovaikutuksia osoitteesta <a href=\"https://instructure.design\" target=\"_blank\">InstUI</a>."

#: index.md:27
#, no-c-format
msgid "Use the smallest package"
msgstr "Käytä pienintä pakettia"

#: index.md:28
#, fuzzy, no-c-format
msgid "Install just <code>@pantoken/css</code> for a stylesheet, <code>@pantoken/pendo</code> for guides, or a bundler preset for Tailwind, Panda, or MUI."
msgstr "Asenna vain @pantoken/css tyylitaulukkoa varten, @pantoken/react hookeja ja ikoneja varten, tai käytä bundlerin esiasetusta Tailwindille, Pandalle tai MUI:lle."

#: index.md:32
#, no-c-format
msgid "Generate for any platform"
msgstr "Luo mille tahansa alustalle"

#: index.md:33
#, no-c-format
msgid "Install the pantoken cli to generate presets or add components for any platform&colon; web, native, and anything in between."
msgstr "Asenna pantoken cli luodaksesi esiasetuksia tai lisätäksesi komponentteja mille tahansa alustalle&colon; web, natiivi ja mitä tahansa siltä väliltä."

#: index.md:37
#, no-c-format
msgid "No React needed"
msgstr "React ei tarvita"

#: index.md:38
#, no-c-format
msgid "The InstUI library is tightly coupled with React. If you want to use it, you have to use React. Now you can build anywhere."
msgstr "InstUI-kirjasto on tiiviisti kytketty React:iin. Jos haluat käyttää sitä, sinun täytyy käyttää React:ia. Nyt voit rakentaa missä tahansa."

#, no-c-format
#~ msgid "InstUI, everywhere"
#~ msgstr "InstUI, kaikkialla"

#, no-c-format
#~ msgid "Every package reads the same resolved token IR. Change a token upstream and it flows to CSS, SCSS, native code, and Figma the same way."
#~ msgstr "Jokainen paketti lukee saman ratkaistun tokenien IR:n. Muuta tokenia ylhäältä päin, ja muutos virtaa samalla tavalla CSS:ään, SCSS:ään, natiivikoodiin ja Figmaan."

#, no-c-format
#~ msgid "Run `pantoken generate` to emit Swift, Kotlin, Compose, Flutter, Rust, WordPress, and more. The same tokens, in each ecosystem's idiom."
#~ msgstr "Suorita `pantoken generate` tuottaaksesi Swift-, Kotlin-, Compose-, Flutter-, Rust-, WordPress- ja muita lähtöjä. Samat tokenit, kunkin ekosysteemin idiomilla."

#, no-c-format
#~ msgid "No upstream coupling"
#~ msgstr "Ei upstream-riippuvuutta"

#, no-c-format
#~ msgid "The tokens ship vendored as static JSON, so `npm i` never reaches for a GitHub-only source. Publishable, semver'd, offline-friendly."
#~ msgstr "Tokenit toimitetaan mukana staattisina JSON-tiedostoina, joten `npm i` ei koskaan turvaudu vain GitHub-lähteeseen. Julkaistavia, semveröityjä ja offline-ystävällisiä."

#, no-c-format
#~ msgid "The package map"
#~ msgstr "Pakettikartta"
