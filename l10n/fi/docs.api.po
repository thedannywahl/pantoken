#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### refs"
msgstr "### refs"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Local annotation references from `@ref`, in author order."
msgstr "Paikallisen annotaation viitteet `@ref`-järjestyksessä, kirjoittajan järjestyksessä."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
