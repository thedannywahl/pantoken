msgid "  CSS:  host = .instui-in-place-edit element (which IS contenteditable)\n  WC:   host = shadow .instui-in-place-edit span"
msgstr "  CSS:  host = .instui-in-place-edit elementti (joka ON contenteditable)\n  WC:   host = shadow .instui-in-place-edit span"

