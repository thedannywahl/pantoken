#, no-c-format
msgctxt "docs.api:prose"
msgid "Which agent tool's assets to install alongside the scaffold (default `\"all\"`)."
msgstr "Minkä agenttityökalun resurssit asennetaan scaffoldin yhteyteen (oletus `\"all\"`)."

