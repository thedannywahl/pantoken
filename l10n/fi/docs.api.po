msgstr "Tavallisen kortin otsikon tyyliasetus."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Card section-title preset."
msgstr "Kortin osion otsikon tyyliasetus."

#: css/heading.md
