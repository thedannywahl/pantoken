msgstr "Sallitut HTML-elementit `@element`-kohdasta (oletus + valinnaiset nimetyt profiilit)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### todos"
msgstr "### todos"

