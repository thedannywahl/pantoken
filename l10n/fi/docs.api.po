msgid "Medium (default). @affects list.item — Scales the item spacing to match."
msgstr "Keskikokoinen (oletus). @affects list.item — Skaalaa kohteiden välistyksen vastaavaksi."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). @affects list.item — Scales the item spacing to match. Long-form alias of `-size-md`."
msgstr "Keskikokoinen (oletus). @affects list.item — Skaalaa kohteiden välistyksen vastaavaksi. Pitkämuotoinen alias `-size-md`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
