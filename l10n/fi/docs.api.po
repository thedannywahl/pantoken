msgstr "Renderöi h3-tyyliskaalan mukaan."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Render at the h4 type scale."
msgstr "Renderöi h4-tyyliskaalan mukaan."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Render at the h5 type scale."
msgstr "Renderöi h5-tyyliskaalan mukaan."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Render at the h6 type scale."
msgstr "Renderöi h6-tyyliskaalan mukaan."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Label type preset."
msgstr "Tunnisteen tyyliasetus."

#: css/heading.md
#, no-c-format
