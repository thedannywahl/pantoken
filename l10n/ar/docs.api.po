msgstr "متوسط (افتراضي). @affects list.item — يغير مقياس تباعد العناصر ليلائم. اسم بديل مطول لـ `-size-md`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Small. @affects list.item — Scales the item spacing to match."
msgstr "صغير. @affects list.item — يغير مقياس تباعد العناصر ليلائم."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Small. @affects list.item — Scales the item spacing to match. Long-form alias of `-size-sm`."
msgstr "صغير. @affects list.item — يغير مقياس تباعد العناصر ليلائم. اسم بديل مطول لـ `-size-sm`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Remove markers and padding."
msgstr "إزالة العلامات والحشوة."

