#: css/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "App-shell row: side nav, container with header, and optional panel."
msgstr "App-shell-rad: side-navigasjon, container med header, og valgfritt panel."

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: input-group"
msgstr ""

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.instui-input-group` — A facade around a text input with leading and trailing icon slots."
msgstr "`.instui-input-group` — En fasade rundt et tekstfelt med plass for ikoner foran og bak."

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Wraps the same field chrome as `text-input` with icon slots either side of it; `-should-not-wrap` is only needed when the group's contents would otherwise overflow onto a second line."
msgstr "Pakker samme felt-ramme som `text-input` med ikonplasser på hver side; `-should-not-wrap` trengs bare når gruppens innhold ellers ville flyte over på en andre linje."

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Source:** [input-group.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/input-group/input-group.css)"
msgstr "**Source:** [input-group.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/input-group/input-group.css)"

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Disabled state."
msgstr "Deaktivert tilstand."

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Keep the group on one line (no wrapping)."
msgstr "Hold gruppen på én linje (ingen linjebryting)."

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Success (valid) state."
msgstr "Suksess (gyldig) tilstand."

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The trailing content slot."
msgstr "Plass for etterfølgende innhold."

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The leading content slot."
msgstr "Plass for innhold foran."

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The placeholder text of the inner input, in a muted color."
msgstr "Fyllteksten (placeholder) i det indre inntastingsfeltet, vist i en dempet farge."

#: css/input-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "- [text-input](/api/css/text-input.md) — Wraps a text input, adding leading and trailing icon slots."
msgstr "- [text-input](/api/css/text-input.md) — Pakker et tekstfelt og legger til ikonplasser foran og bak."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: layout"
msgstr ""

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.--display-flex` — Display and text-align utilities — `.--display-<value>` and `.--text-align-<value>` — as composable, global classes, usable bare or chained onto any component."
msgstr "`.--display-flex` — visnings- og tekstjusteringsverktøy — `.--display-<value>` og `.--text-align-<value>` — som komponerbare, globale klasser, brukbare alene eller kjedet på hvilken som helst komponent."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Source:** [index.ts](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/utilities/layout/index.ts)"
msgstr "**Source:** [index.ts](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/utilities/layout/index.ts)"

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sets `display: flex`."
msgstr "Angir `display: flex`."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Display utilities: `block`, `inline-block`, `inline`, `flex`, `inline-flex`, and `none`."
msgstr "Visningsverktøy: `block`, `inline-block`, `inline`, `flex`, `inline-flex` og `none`."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Text-alignment utilities: `start`, `center`, `end`, and `justify`."
msgstr "Tekstjusteringsverktøy: `start`, `center`, `end` og `justify`."

#: css/link.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: link"
msgstr ""

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.instui-link` — A styled hyperlink with sizes, an inverse variant for dark backgrounds, and inline or unstyled forms."
msgstr "`.instui-link` — En stilisert hyperlenke med størrelser, en invers variant for mørke bakgrunner, og inline- eller ustylet form."

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sets its own responsive `gap` between an icon and its text (`-size-sm`/`-size-lg` scale it); chaining a `-gap-*` spacing utility modifier overrides that built-in value."
msgstr "Setter sin egen responsive `gap` mellom et ikon og teksten (`-size-sm`/`-size-lg` skalerer den); kjeding av en `-gap-*` spacing-utility-modifikator overstyrer den innebygde verdien."

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Source:** [link.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/link/link.css)"
msgstr "**Source:** [link.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/link/link.css)"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Mark a disabled link with `aria-disabled=\"true\"`."
msgstr "Merk en deaktivert lenke med `aria-disabled=\"true\"`."

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "For dark backgrounds."
msgstr "For mørke bakgrunner."

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Inline link, underlined within flowing text."
msgstr "Inline-lenke, understreket i løpende tekst."

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large inline link (used with `-inline`)."
msgstr "Stor inline-lenke (brukes med `-inline`)."

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Small inline link (used with `-inline`)."
msgstr "Liten inline-lenke (brukes med `-inline`)."

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Strip link styling: inherit colour, no underline."
msgstr "Fjern lenkestil: arver farge, ingen understreking."

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "- [breadcrumb](/api/css/breadcrumb.md) — A breadcrumb trail is built from links; also its small-screen fallback (pair with the `responsive` utility to swap Breadcrumb for a Link below ~768px)."
msgstr "- [breadcrumb](/api/css/breadcrumb.md) — En brødsmulesti bygges av lenker; også dens fallback for små skjermer (par med `responsive`-verktøyet for å bytte Breadcrumb for en Link under ~768px)."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: list.item"
msgstr ""

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.instui-list` — A list item (InstUI `List.Item`)."
msgstr "`.instui-list` — Et listeelement (InstUI `List.Item`)."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The parent `list`'s `-size-sm`/`-size-lg`, `-ordered`, and `-delimiter-solid`/`-delimiter-dashed` modifiers restyle this member — see `list`'s own doc for those modifiers."
msgstr "Forelderen `list`'s `-size-sm`/`-size-lg`, `-ordered`, og `-delimiter-solid`/`-delimiter-dashed` modifikatorer endrer stilen til dette medlemmet — se `list`'s egen dokumentasjon for disse modifikatorene."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Separate items with a dashed rule. @affects list.item — Adds the delimiter rule between items."
msgstr "Skill elementene med en stiplet skillelinje. @affects list.item — Legger til skillelinjen mellom elementene."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Separate items with a solid rule. @affects list.item — Adds the delimiter rule between items."
msgstr "Skill elementene med en heltrukket skillelinje. @affects list.item — Legger til skillelinjen mellom elementene."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Ordered-list numbering. @affects list.item — Adds marker weight and indentation."
msgstr "Nummerering for ordnede lister. @affects list.item — Legger til markørvekt og innrykk."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Renders the list bullet or ordered-list number."
msgstr "Rendererer listepunktet eller nummeret for ordnede lister."

#: css/list.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: list"
msgstr ""

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.instui-list` — A list with token-driven item spacing."
msgstr "`.instui-list` — En liste med tokenstyrt avstand mellom elementene."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sets its own `padding-inline-start` for list indentation; chaining a `-p*`/`-padding*` spacing utility modifier overrides that built-in value. See the `list.item` member for the individual items."
msgstr "Setter sin egen `padding-inline-start` for innrykk i listen; å kjede en `-p*`/`-padding*` mellomroms-utility-modifikator overstyrer den innebygde verdien. Se `list.item`-medlemmet for de individuelle elementene."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Source:** [list.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/list/list.css)"
msgstr "**Source:** [list.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/list/list.css)"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Lay items out inline (horizontal)."
msgstr "Plasser elementene på linje (horisontalt)."

