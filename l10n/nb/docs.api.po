msgctxt "docs.api:text"
msgid "# pantoken-ai"
msgstr "# pantoken-ai"

#: ai/pantoken-ai/src/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`@pantoken/ai` — consumer-facing agent assets for projects that *use* pantoken (not for\ndeveloping pantoken itself)."
msgstr "`@pantoken/ai` — consumer-facing agent assets for projects that *use* pantoken (not for\ndeveloping pantoken itself)."

#: ai/pantoken-ai/src/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "It ships an `AGENTS.md`, an `llms.txt`, editor/agent rule files (Cursor, Copilot, Windsurf), and\nClaude Code skills (`init-pantoken`, `create-pantoken-app`), plus [installAgentAssets](functions/installAgentAssets.md) /\n[scaffoldAndInit](functions/scaffoldAndInit.md) / the `pantoken-ai` CLI to drop them into a consumer repo at the\nconventional paths."
msgstr "It ships an `AGENTS.md`, an `llms.txt`, editor/agent rule files (Cursor, Copilot, Windsurf), and\nClaude Code skills (`init-pantoken`, `create-pantoken-app`), plus [installAgentAssets](functions/installAgentAssets.md) /\n[scaffoldAndInit](functions/scaffoldAndInit.md) / the `pantoken-ai` CLI to drop them into a consumer repo at the\nconventional paths."

