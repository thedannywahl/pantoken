#, no-c-format
msgctxt "docs.api:prose"
msgid "The target directory (default `\".\"`). Its basename (or `\"pantoken-app\"` for `\".\"`)\n  is substituted for `{{projectName}}` in the scaffold's template files."
msgstr "Målkatalogen (standard `\".\"`). Dens basenavn (eller `\"pantoken-app\"` for `\".\"`)\n  settes inn for `{{projectName}}` i scaffoldens malfiler."

