#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: CommandEventish"
msgstr "# Grensesnitt: CommandEventish"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The `command`/`source` shape of an Invoker Commands `CommandEvent` (not yet in DOM lib types)."
msgstr "The `command`/`source` shape of an Invoker Commands `CommandEvent` (not yet in DOM lib types)."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### command"
msgstr "### command"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### source"
msgstr "### source"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### bubbles"
msgstr "### bubbles"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`bubbles`** read-only property of the Event interface indicates whether the event bubbles up through the DOM tree or not."
msgstr "The **`bubbles`** read-only property of the Event interface indicates whether the event bubbles up through the DOM tree or not."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### ~~cancelBubble~~"
msgstr "### ~~cancelBubble~~"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`cancelBubble`** property of the Event interface is deprecated. Use Event.stopPropagation() instead. Setting its value to true before returning from an event handler prevents propagation of the event. In later implementations, setting this to false does nothing. See Browser compatibility for details."
msgstr "The **`cancelBubble`** property of the Event interface is deprecated. Use Event.stopPropagation() instead. Setting its value to true before returning from an event handler prevents propagation of the event. In later implementations, setting this to false does nothing. See Browser compatibility for details."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "#### Deprecated"
msgstr "#### Utdatert"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### cancelable"
msgstr "### cancelable"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`cancelable`** read-only property of the Event interface indicates whether the event can be canceled, and therefore prevented as if the event never happened."
msgstr "The **`cancelable`** read-only property of the Event interface indicates whether the event can be canceled, and therefore prevented as if the event never happened."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### composed"
msgstr "### composed"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The read-only **`composed`** property of the Event interface returns a boolean value which indicates whether or not the event will propagate across the shadow DOM boundary into the standard DOM."
msgstr "The read-only **`composed`** property of the Event interface returns a boolean value which indicates whether or not the event will propagate across the shadow DOM boundary into the standard DOM."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### currentTarget"
msgstr "### currentTarget"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`currentTarget`** read-only property of the Event interface identifies the element to which the event handler has been attached."
msgstr "The **`currentTarget`** read-only property of the Event interface identifies the element to which the event handler has been attached."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### defaultPrevented"
msgstr "### defaultPrevented"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`defaultPrevented`** read-only property of the Event interface returns a boolean value indicating whether or not the call to Event.preventDefault() canceled the event."
msgstr "The **`defaultPrevented`** read-only property of the Event interface returns a boolean value indicating whether or not the call to Event.preventDefault() canceled the event."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### eventPhase"
msgstr "### eventPhase"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`eventPhase`** read-only property of the Event interface indicates which phase of the event flow is currently being evaluated."
msgstr "The **`eventPhase`** read-only property of the Event interface indicates which phase of the event flow is currently being evaluated."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### isTrusted"
msgstr "### isTrusted"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`isTrusted`** read-only property of the Event interface is a boolean value that is true when the event was generated by the user agent (including via user actions and programmatic methods such as HTMLElement.focus()), and false when the event was dispatched via EventTarget.dispatchEvent(). The only exception is the click event, which initializes the isTrusted property to false in user agents."
msgstr "The **`isTrusted`** read-only property of the Event interface is a boolean value that is true when the event was generated by the user agent (including via user actions and programmatic methods such as HTMLElement.focus()), and false when the event was dispatched via EventTarget.dispatchEvent(). The only exception is the click event, which initializes the isTrusted property to false in user agents."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### ~~returnValue~~"
msgstr "### ~~returnValue~~"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The Event property **`returnValue`** indicates whether the default action for this event has been prevented or not."
msgstr "The Event property **`returnValue`** indicates whether the default action for this event has been prevented or not."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### ~~srcElement~~"
msgstr "### ~~srcElement~~"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The deprecated **`Event.srcElement`** is an alias for the Event.target property. Use Event.target instead."
msgstr "The deprecated **`Event.srcElement`** is an alias for the Event.target property. Use Event.target instead."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The read-only **`target`** property of the Event interface is a reference to the object onto which the event was dispatched. It is different from Event.currentTarget when the event handler is called during the bubbling or capturing phase of the event."
msgstr "The read-only **`target`** property of the Event interface is a reference to the object onto which the event was dispatched. It is different from Event.currentTarget when the event handler is called during the bubbling or capturing phase of the event."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### timeStamp"
msgstr "### timeStamp"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`timeStamp`** read-only property of the Event interface returns the time (in milliseconds) at which the event was created."
msgstr "The **`timeStamp`** read-only property of the Event interface returns the time (in milliseconds) at which the event was created."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`type`** read-only property of the Event interface returns a string containing the event's type. It is set when the event is constructed and is the name commonly used to refer to the specific event, such as click, load, or error."
msgstr "The **`type`** read-only property of the Event interface returns a string containing the event's type. It is set when the event is constructed and is the name commonly used to refer to the specific event, such as click, load, or error."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### NONE"
msgstr "### NONE"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### CAPTURING\\_PHASE"
msgstr "### CAPTURING\\_PHASE"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### AT\\_TARGET"
msgstr "### AT\\_TARGET"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### BUBBLING\\_PHASE"
msgstr "### BUBBLING\\_PHASE"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### composedPath()"
msgstr "### composedPath()"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`composedPath()`** method of the Event interface returns the event's path which is an array of the objects on which listeners will be invoked. This does not include nodes in shadow trees if the shadow root was created with its ShadowRoot.mode closed."
msgstr "The **`composedPath()`** method of the Event interface returns the event's path which is an array of the objects on which listeners will be invoked. This does not include nodes in shadow trees if the shadow root was created with its ShadowRoot.mode closed."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### ~~initEvent()~~"
msgstr "### ~~initEvent()~~"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The **`Event.initEvent()`** method is used to initialize the value of an event created using Document.createEvent()."
msgstr "The **`Event.initEvent()`** method is used to initialize the value of an event created using Document.createEvent()."

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "##### type"
msgstr "##### type"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
msgctxt "docs.api:text"
msgid "##### bubbles?"
msgstr "##### bubbles?"

#: formats/interactions/src/interfaces/CommandEventish.md
#, no-c-format
