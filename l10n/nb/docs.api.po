#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match. Long-form alias of `-size-lg`."
msgstr "Stor. @affects list.item — Skalerer elementavstanden tilsvarende. Langform-alias for `-size-lg`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match."
msgstr "Stor. @affects list.item — Skalerer elementavstanden tilsvarende."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). @affects list.item — Scales the item spacing to match."
msgstr "Middels (standard). @affects list.item — Skalerer elementavstanden tilsvarende."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). @affects list.item — Scales the item spacing to match. Long-form alias of `-size-md`."
msgstr "Middels (standard). @affects list.item — Skalerer elementavstanden tilsvarende. Langform-alias for `-size-md`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
