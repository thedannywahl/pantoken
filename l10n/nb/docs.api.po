msgctxt "docs.api:text"
msgid "# Interface: CssDocEntry"
msgstr "# Grensesnitt: CssDocEntry"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One documented CSS record: its base class plus everything derived from the CSS + doc comments."
msgstr "Én dokumentert CSS-post: dens basisklasse pluss alt avledet fra CSS + doc-kommentarer."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The record name from `@component`/`@utility`/`@rule`/`@declaration`/`@name`, e.g. `button`."
msgstr "Postnavnet fra `@component`/`@utility`/`@rule`/`@declaration`/`@name`, f.eks. `button`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### kind"
msgstr "### kind"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Which kind of CSS surface this documents (defaults to `component`)."
msgstr "Hvilken type CSS-flate dette dokumenterer (standard er `component`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The base CSS selector — a class (`.button`), attribute (`[data-layout=\"x\"]`), ID (`#foo`),\n or shadow-DOM pseudo (`:host`) — inferred from the first bare-class rule or set explicitly via\n `@selector`. Always non-empty (falls back to `.${name}` when inference fails)."
msgstr "Den grunnleggende CSS-selektoren — en klasse (`.button`), attributt (`[data-layout=\"x\"]`), ID (`#foo`),\neller shadow-DOM pseudo (`:host`) — utledet fra den første bare-klasse-regelen eller satt eksplisitt via\n`@selector`. Alltid ikke-tom (faller tilbake til `.${name}` når utledning mislykkes)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### summary?"
msgstr "### summary?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One-line summary from `@summary`."
msgstr "Én-linjers oppsummering fra `@summary`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### remarks?"
msgstr "### remarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Extended prose from `@remarks`."
msgstr "Utvidet prosa fra `@remarks`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### privateRemarks?"
msgstr "### privateRemarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Internal-only prose from `@privateRemarks` (emitters may choose to omit it from public output)."
msgstr "Internt-only prosa fra `@privateRemarks` (emittere kan velge å utelate dette fra offentlig output)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### releaseStage?"
msgstr "### releaseStage?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The release stage from a modifier flag tag (`@alpha`/`@beta`/`@experimental`/`@internal`/`@public`)."
msgstr "Utgivelseskategori fra et modifikatortagg (`@alpha`/`@beta`/`@experimental`/`@internal`/`@public`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### since?"
msgstr "### since?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Version introduced, from `@since`."
msgstr "Versjon der den ble introdusert, fra `@since`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### group?"
msgstr "### group?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A documentation group/category, from `@group`/`@category`."
msgstr "En dokumentasjonsgruppe/kategori, fra `@group`/`@category`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### accessibility?"
msgstr "### accessibility?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Accessibility guidance, from `@a11y`/`@accessibility`."
msgstr "Veiledning for tilgjengelighet, fra `@a11y`/`@accessibility`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### global?"
msgstr "### global?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Set when this record carries a `@global` tag — its modifiers (and per-modifier `@global` flags)\napply to any component/layout/rule/declaration, not just this record's base class. Used during\nvalidation and consumption checks to resolve modifier matches globally."
msgstr "Satt når denne posten har et `@global`-tagg — dens modifikatorer (og per-modifikator `@global`-flagg)\ngjelder for enhver komponent/lay-out/regel/deklarasjon, ikke bare denne postens basisklasse. Brukes under\nvalidering og konsumkontroller for å løse modifikatormatcher globalt."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### modifiers"
msgstr "### modifiers"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "AST-extracted modifiers, annotated with `@modifier` prose where authored."
msgstr "AST-ekstraherte modifikatorer, annotert med `@modifier`-prosa hvor forfattet."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### parts"
msgstr "### parts"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "AST-extracted sub-element parts (class-based), annotated with `@part` prose where authored."
msgstr "AST-ekstraherte sub-elementdeler (klassebaserte), annotert med `@part`-prosa hvor forfattet."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### shadowParts"
msgstr "### shadowParts"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Shadow-DOM exposed parts (`::part(name)`), from `@csspart` or a `::part()` selector."
msgstr "Shadow-DOM eksponerte parts (`::part(name)`), fra `@csspart` eller en `::part()`-selektor."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### pseudoElements"
msgstr "### pseudoElements"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Native pseudo-elements the component styles (`::before`, `::marker`, …), from `@pseudo` or a selector."
msgstr "Native pseudo-elementer komponenten styler (`::before`, `::marker`, …), fra `@pseudo` eller en selektor."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### states"
msgstr "### states"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "States the component reacts to, from `@cssstate`, `:state()`, pseudo-classes, or state classes."
msgstr "Tilstander komponenten reagerer på, fra `@cssstate`, `:state()`, pseudo-klasser eller tilstandsklasser."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### slots"
msgstr "### slots"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Named slots the component shell exposes, from `@slot`."
msgstr "Navngitte slots som komponentens shell eksponerer, fra `@slot`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### elements?"
msgstr "### elements?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Allowed HTML elements from `@element` (default + optional named profiles)."
msgstr "Tillatte HTML-elementer fra `@element` (standard + valgfrie navngitte profiler)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### todos"
msgstr "### todos"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Internal to-do notes, from `@todo` tags and `/* @todo … */` inline comments. Development notes,\nnot public API — emitters may omit them (like [CssDocEntry.privateRemarks](#privateremarks))."
msgstr "Interne TODO-notater, fra `@todo`-tagger og `/* @todo … */` inline-kommentarer. Utviklingsnotater,\nikke offentlig API — emittere kan utelate dem (som [CssDocEntry.privateRemarks](#privateremarks))."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### cssPropertiesConsumed"
msgstr "### cssPropertiesConsumed"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Design tokens this component consumes: every `--*` custom property referenced via `var(...)` inside\nits rules, each annotated with `@tokens` prose where authored (and including any `@tokens`-declared\ntoken not literally found via `var()`)."
msgstr "Design tokens denne komponenten bruker: hver `--*`-custom property referert via `var(...)` inne\nreglene, hver annotert med `@tokens`-prosa hvor forfattet (og inkludert enhver `@tokens`-deklarert\ntoken som ikke bokstavelig ble funnet via `var()`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### cssPropertiesDeclared"
msgstr "### cssPropertiesDeclared"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Custom properties this component declares (`@property`) or documents (`@cssproperty`)."
msgstr "Custom properties denne komponenten definerer (`@property`) eller dokumenterer (`@cssproperty`)."

