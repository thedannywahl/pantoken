msgstr ""

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default)."
msgstr "Medium (standard)."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). Long-form alias of `-size-md`."
msgstr "Medium (standard). Langform-alias for `-size-md`."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The value text centred in the ring's hole."
msgstr "Verditeksten sentrert i ringens hull."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Custom, not part of InstUI. Applies only to a native `<progress>` missing its `value` attribute; spins `::before` at a fixed arc and hides `.value`."
msgstr "Egendefinert, ikke del av InstUI. Gjelder bare for en native `<progress>` som mangler sitt `value`-attributt; spinner `::before` med en fast bue og skjuler `.value`."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Draws the ring itself: a conic-gradient donut clipped with a radial mask, whose arc tracks the `--value` custom property."
msgstr "Tegner selve ringen: en conic-gradient-smultring klippet med en radial maske, hvis bue følger `--value` egenskapen."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Milliseconds to wait before starting the mount animation (default `0`)."
msgstr "Millisekunder å vente før start av mount-animasjonen (standard `0`)."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The maximum progress value (default `100`)."
msgstr "Maksimal fremdriftsverdi (standard `100`)."

#: css/progress-circle.md
#, no-c-format
