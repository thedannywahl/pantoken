msgid "# Interface: RemoveHandle"
msgstr "# Interfejs: RemoveHandle"

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Handle returned by [initRemove](../functions/initRemove.md)."
msgstr "Uchwyt zwrócony przez [initRemove](../functions/initRemove.md)."

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Cancel pending dismissal and removal work."
msgstr "Anuluj oczekujące operacje odrzucenia i usunięcia."

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
