msgstr "Odrzuć natychmiast, nie czekając na skonfigurowany limit czasu."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: RemoveOptions"
msgstr "# Interfejs: RemoveOptions"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Options for a timeout-based removal."
msgstr "Opcje usuwania opartego na limicie czasu."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### timeout?"
msgstr "### timeout?"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
