msgctxt "docs.api:prose"
msgid "Second item"
msgstr "Secondo elemento"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Third item"
msgstr "Terzo elemento"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Lay items out inline (horizontal)."
msgstr "Disponi gli elementi in linea (orizzontale)."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match. Long-form alias of `-size-lg`."
msgstr "Grande. @affects list.item — Scala la spaziatura degli elementi di conseguenza. Alias in forma estesa di `-size-lg`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match."
msgstr "Grande. @affects list.item — Scala la spaziatura degli elementi di conseguenza."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). @affects list.item — Scales the item spacing to match."
msgstr "Medio (predefinito). @affects list.item — Scala la spaziatura degli elementi di conseguenza."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). @affects list.item — Scales the item spacing to match. Long-form alias of `-size-md`."
msgstr "Medio (predefinito). @affects list.item — Scala la spaziatura degli elementi di conseguenza. Alias in forma estesa di `-size-md`."

#: css/list.md
#, no-c-format
