msgstr "Plugin i cui hook `rehype` contribuiscono risolutori (es. simple-icons)."

#: renderers/react-markdown/src/interfaces/InstuiMarkdownRenderOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Inline color-code swatches (e.g. `#03893D`)."
msgstr "Campioni di colore inline (es. `#03893D`)."

#: renderers/react-markdown/src/interfaces/InstuiMarkdownRenderOptions.md
#, no-c-format
