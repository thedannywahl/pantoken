msgctxt "docs.api:prose"
msgid "The computed handle diameter."
msgstr "Il diametro calcolato del manopola."

#: css/checkbox.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The handle inset from each track edge."
msgstr "L'inset del manopola rispetto a ciascun bordo della traccia."

#: css/checkbox.md
