msgstr "Rīpene tūpou (font sheet(s)). Ko [DEFAULT\\_THEME\\_FONT\\_ASSETS](../variables/DEFAULT_THEME_FONT_ASSETS.md) te taunoa."

#: platforms/canvas-theme-editor/src/interfaces/BuildThemeOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### js?"
msgstr "### js?"

#: platforms/canvas-theme-editor/src/interfaces/BuildThemeOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Script(s). Defaults to [DEFAULT\\_THEME\\_JS\\_ASSETS](../variables/DEFAULT_THEME_JS_ASSETS.md)."
msgstr "Kōwae tuhi (script(s)). Ko [DEFAULT\\_THEME\\_JS\\_ASSETS](../variables/DEFAULT_THEME_JS_ASSETS.md) te taunoa."

#: platforms/canvas-theme-editor/src/interfaces/BuildThemeOptions.md
#, no-c-format
msgctxt "docs.api:text"
