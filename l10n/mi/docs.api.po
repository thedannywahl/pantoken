msgstr "Ngā kōwhiringa mō te animation tāuta (mount) o ProgressCircle."

#: formats/interactions/src/interfaces/ProgressCircleOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### animationDelay?"
msgstr "### animationDelay?"

#: formats/interactions/src/interfaces/ProgressCircleOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Milliseconds before the mount state is released. Defaults to computed `--animation-delay`."
msgstr "Ngā mirisekone i mua i te tukunga o te āhuatanga tāuta. Hei taunoa, ko te `--animation-delay` kua tatau."

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: RemoveHandle"
msgstr "# Atanga: RemoveHandle"

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Handle returned by [initRemove](../functions/initRemove.md)."
msgstr "Tohu i whakahokia e [initRemove](../functions/initRemove.md)."

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Cancel pending dismissal and removal work."
msgstr "Whakakāhorehia ngā mahi e tatari ana mō te whakakore me te tango."

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:text"
