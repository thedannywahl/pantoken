msgid "`.day` — A day cell (InstUI `Calendar.Day`); `-today`, `-selected`, and `-outside-month` mark its state."
msgstr "`.day` — He pūtau rā (InstUI `Calendar.Day`); ko `-today`, `-selected`, me `-outside-month` e tohu ana i tōna āhua."

#: css/calendar.day.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A day from the adjacent month (leading/trailing filler)."
msgstr "He rā nō te marama tata (whakakī ārahina/whakamutunga)."

#: css/calendar.day.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The selected date."
msgstr "Te rā kua tīpako."

#: css/calendar.day.md
#, no-c-format
msgctxt "docs.api:prose"
