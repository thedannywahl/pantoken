#, no-c-format
msgctxt "docs.api:prose"
msgid "Pins the version for every asset below that doesn't specify its own `version`."
msgstr "E tūhono ana i te putanga mō ia rawa i raro nei kāore i tohu i tōna `version` ake."

#: platforms/canvas-theme-editor/src/interfaces/BuildThemeOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Token theme variant. Defaults to `\"rebrand\"`. Ignored when `css` is supplied."
msgstr "Rerekētanga kaupapa token. Ko `\"rebrand\"` te taunoa. Ka whakakorehia mēnā ka tukuna `css`."

#: platforms/canvas-theme-editor/src/interfaces/BuildThemeOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Rebrand token mode. Defaults to `\"light\"`. Ignored outside the `rebrand` theme, or when `css` is supplied."
msgstr "Aratau token whakahou ingoa. Ko `\"light\"` te taunoa. Ka whakakorehia i waho o te kaupapa `rebrand`, ā, ka whakakorehia rānei mēnā ka tukuna `css`."

