msgstr ""

#: css/button.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A lower-emphasis secondary action."
msgstr "He mahi tuarua whāiti-uruhanga."

#: css/button.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A positive/confirming action."
msgstr "He mahi poutama/whakauka."

#: css/button.md
