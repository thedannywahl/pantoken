#, no-c-format
msgctxt "docs.api:prose"
msgid "Lay items out inline (horizontal)."
msgstr "Whakarārangihia ngā tūemi i runga i tētahi raina kotahi (ā-whanui)."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match. Long-form alias of `-size-lg`."
msgstr "Rahi. @affects list.item — Ka whakatairite i te wāhi tūemi kia rite. Ingā roa mō `-size-lg`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
