msgid "(default) medium size. Long-form alias of `-size-md`."
msgstr "(taunoa) rahi ātaahua. He ingoa roa mō `-size-md`."

#: css/button.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A pressed-state toggle button (drive with aria-pressed)."
msgstr "He pātene tīpoka ā-āhua pēhanga (whakahaeretia mā aria-pressed)."

#: css/button.md
#, no-c-format
msgctxt "docs.api:prose"
