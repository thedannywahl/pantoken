msgstr "Tae mō te pānui mōhiohio."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "On-dark (primary inverse) meter colour."
msgstr "Tae mita mō runga-kore (kaha matua inverse)."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Success meter colour."
msgstr "Tae mita angitu."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
