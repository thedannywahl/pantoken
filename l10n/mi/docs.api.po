msgstr "### dismiss()"

#: formats/interactions/src/interfaces/RemoveHandle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Dismiss immediately, without waiting for the configured timeout."
msgstr "Whakakāhore tonu, me te kore e tatari mō te wā whakamutu kua whakaritea."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: RemoveOptions"
msgstr "# Atanga: RemoveOptions"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Options for a timeout-based removal."
msgstr "Ngā kōwhiringa mō te tangohanga ā-wā whakamutu."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### timeout?"
msgstr "### timeout?"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Milliseconds before dismissal. Defaults to the target's computed `--timeout`."
msgstr "Ngā mirisekone i mua i te whakakore. Ko te taunoa ko te `--timeout` kua tatauhia o te whāinga."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
