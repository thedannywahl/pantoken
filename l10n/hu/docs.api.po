msgstr "A rövid skálakulcs, például `\"sm\"` (a nulla lépés rövid kulcsa a(z) `\"0\"`)."

#: packages/utils/src/interfaces/SpacingStep.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### long"
msgstr "### long"

#: packages/utils/src/interfaces/SpacingStep.md
#, no-c-format
msgctxt "docs.api:prose"
