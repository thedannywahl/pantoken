msgid "# CSS: table.row"
msgstr "# CSS: table.row"

#: css/table.row.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`tr` — A table row (InstUI `Table.Row`)."
msgstr "`tr` — Egy táblázatsor (InstUI `Table.Row`)."

#: css/table.row.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The parent `table`'s `-hover` and `-layout-stacked` modifiers restyle this member — see `table`'s own doc for those modifiers."
msgstr "A szülő `table` `-hover` és `-layout-stacked` módosítói újraformázzák ezt a tagot — lásd a(z) `table` saját dokumentációját ezekről a módosítókról."

