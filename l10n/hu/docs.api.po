msgstr "# Interfész: TokenUtilityGroup"

#: packages/utils/src/interfaces/TokenUtilityGroup.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A set of tokens that all map to one CSS property (e.g. every `--instui-font-weight-*` → `font-weight`)."
msgstr "Egy token halmaz, amely egy CSS tulajdonsághoz térképez (pl. minden `--instui-font-weight-*` → `font-weight`)."

#: packages/utils/src/interfaces/TokenUtilityGroup.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### property"
msgstr "### property"

#: packages/utils/src/interfaces/TokenUtilityGroup.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The CSS property the tokens set (e.g. `\"font-weight\"`, `\"border-radius\"`, `\"box-shadow\"`)."
msgstr "A CSS tulajdonság, amelyet a tokenek beállítanak (pl. `\"font-weight\"`, `\"border-radius\"`, `\"box-shadow\"`)."

#: packages/utils/src/interfaces/TokenUtilityGroup.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Full token names (e.g. `\"--instui-font-weight-body-strong\"`); the `--instui-` tail becomes the class."
msgstr "Teljes token nevek (pl. `\"--instui-font-weight-body-strong\"`); a `--instui-` vége az osztállyá válik."

#: packages/utils/src/interfaces/UtilityOptions.md
#, no-c-format
