#, no-c-format
msgctxt "tinymce.strings:confirmOverwrite"
msgid "A preset named “{{name}}” already exists. Replace it?"
msgstr "Mae rhag-osodiad o'r enw “{{name}}” eisoes yn bodoli. A'i ddisodli?"

#: plugins/tinymce/save/src/i18n.json#confirmDiscard
#, no-c-format
msgctxt "tinymce.strings:confirmDiscard"
msgid "Open “{{name}}” and discard the current unsaved changes?"
msgstr "Agor “{{name}}” a gwaredu'r newidiadau cyfredol heb eu cadw?"

#: plugins/tinymce/save/src/i18n.json#confirmDelete
#, no-c-format
msgctxt "tinymce.strings:confirmDelete"
msgid "Delete “{{name}}”? This cannot be undone."
msgstr "Dileu “{{name}}”? Ni ellir dadwneud hyn."

#: plugins/tinymce/save/src/i18n.json#emptyPresets
#, no-c-format
msgctxt "tinymce.strings:emptyPresets"
msgid "No saved presets are available."
msgstr "Nid oes rhag-osodiadau wedi'u cadw ar gael."

#: plugins/tinymce/save/src/i18n.json#invalidName
#, no-c-format
msgctxt "tinymce.strings:invalidName"
msgid "Enter a preset name."
msgstr "Rhowch enw rhag-osodiad."

#: plugins/tinymce/save/src/i18n.json#invalidPreset
#, no-c-format
msgctxt "tinymce.strings:invalidPreset"
msgid "This preset is invalid and could not be opened."
msgstr "Mae'r rhag-osodiad hwn yn annilys ac ni ellid ei agor."

#: plugins/tinymce/save/src/i18n.json#storageReadError
#, no-c-format
msgctxt "tinymce.strings:storageReadError"
msgid "Saved presets could not be read from this browser."
msgstr "Ni ellid darllen rhag-osodiadau cadw o'r porwr hwn."

#: plugins/tinymce/save/src/i18n.json#storageWriteError
#, no-c-format
msgctxt "tinymce.strings:storageWriteError"
msgid "The preset could not be saved in this browser."
msgstr "Ni ellid cadw'r rhag-osodiad yn y porwr hwn."

#: plugins/tinymce/save/src/i18n.json#storageDeleteError
#, no-c-format
msgctxt "tinymce.strings:storageDeleteError"
msgid "The preset could not be deleted from this browser."
msgstr "Ni ellid dileu'r rhag-osodiad o'r porwr hwn."

#: plugins/tinymce/save/src/i18n.json#presetSaveButton
#, no-c-format
msgctxt "tinymce.strings:presetSaveButton"
msgid "Save"
msgstr "Cadw"

#: plugins/tinymce/save/src/i18n.json#presetOpenButton
#, no-c-format
msgctxt "tinymce.strings:presetOpenButton"
msgid "Open"
msgstr "Agor"

#: plugins/tinymce/save/src/i18n.json#presetDeleteButton
#, no-c-format
msgctxt "tinymce.strings:presetDeleteButton"
msgid "Delete"
msgstr "Dileu"

#: plugins/tinymce/save/src/i18n.json#presetCancelButton
#, fuzzy, no-c-format
msgctxt "tinymce.strings:presetCancelButton"
msgid "Cancel"
msgstr "Canslo"
