msgid "<span class=\"instui-pill -color-info pantoken-doc-tag\">Alias</span> — maps to `.-show-min-sm`."
msgstr "<span class=\"instui-pill -color-info pantoken-doc-tag\">Alias</span> — maps to `.-show-min-sm`."

#: css/responsive.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Show (inverse of `-hidden-max-sm`) when the viewport is at or above the `sm` breakpoint (`20em`); hidden otherwise."
msgstr "Afficher (inverse de `-hidden-max-sm`) lorsque la fenêtre d'affichage est à ou au-dessus du point d'arrêt `sm` (`20em`) ; masqué sinon."

#: css/responsive.md
