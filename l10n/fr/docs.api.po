msgid "Sit at the end (inline-end) of the anchor."
msgstr "Se placer à la fin (inline-end) de l'ancre."

#: css/context-view.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sit at the start (inline-start) of the anchor."
msgstr "Se placer au début (inline-start) de l'ancre."

#: css/context-view.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sit above the anchor."
msgstr "Se placer au-dessus de l'ancre."

#: css/context-view.md
#, no-c-format
