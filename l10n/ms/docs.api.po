#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match. Long-form alias of `-size-lg`."
msgstr "Besar. @affects list.item — Menyesuaikan jarak item supaya sesuai. Alias panjang bagi `-size-lg`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match."
msgstr "Besar. @affects list.item — Menyesuaikan jarak item supaya sesuai."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). @affects list.item — Scales the item spacing to match."
msgstr "Sederhana (lalai). @affects list.item — Menyesuaikan jarak item supaya sesuai."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). @affects list.item — Scales the item spacing to match. Long-form alias of `-size-md`."
msgstr "Sederhana (lalai). @affects list.item — Menyesuaikan jarak item supaya sesuai. Alias panjang bagi `-size-md`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Small. @affects list.item — Scales the item spacing to match."
msgstr "Kecil. @affects list.item — Menyesuaikan jarak item supaya sesuai."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Small. @affects list.item — Scales the item spacing to match. Long-form alias of `-size-sm`."
msgstr "Kecil. @affects list.item — Menyesuaikan jarak item supaya sesuai. Alias panjang bagi `-size-sm`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Remove markers and padding."
msgstr "Buang penanda dan padding."

