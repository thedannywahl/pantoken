msgstr "Lepaskan keadaan pemasangan dengan segera."

#: formats/interactions/src/interfaces/ProgressCircleOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: ProgressCircleOptions"
msgstr "# Antaramuka: ProgressCircleOptions"

#: formats/interactions/src/interfaces/ProgressCircleOptions.md
