msgid "Below the default flow."
msgstr "Di bawah aliran lalai."

#: css/stacking.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The lowest stacking depth."
msgstr "Kedalaman timbunan terendah."

#: css/stacking.md
#, no-c-format
