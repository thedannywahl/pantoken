msgstr "Baris legenda anotasi tempatan dari `@annotations`, mengikut susunan pengarang."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### refs"
msgstr "### refs"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Local annotation references from `@ref`, in author order."
msgstr "Rujukan anotasi tempatan dari `@ref`, mengikut susunan pengarang."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### decorators"
msgstr "### decorators"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
