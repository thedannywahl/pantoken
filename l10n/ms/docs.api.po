msgstr "Singkirkan serta-merta, tanpa menunggu masa tamat yang dikonfigurasikan."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: RemoveOptions"
msgstr "# Antaramuka: RemoveOptions"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Options for a timeout-based removal."
msgstr "Pilihan untuk penghapusan berdasarkan tamat masa."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### timeout?"
msgstr "### timeout?"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Milliseconds before dismissal. Defaults to the target's computed `--timeout`."
msgstr "Millisaat sebelum penyingkiran. Lalai kepada `--timeout` yang dikira bagi sasaran."

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### transition?"
msgstr "### transition?"

#: formats/interactions/src/interfaces/RemoveOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Exit treatment. Defaults to `\"fade\"`, matching InstUI Alert."
msgstr "Tindakan keluar. Lalai kepada `\"fade\"`, sepadan dengan InstUI Alert."

#: formats/interactions/src/interfaces/TooltipHandle.md
