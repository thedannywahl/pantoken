#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: CssDocEntry"
msgstr "# Antaramuka: CssDocEntry"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One documented CSS record: its base class plus everything derived from the CSS + doc comments."
msgstr "Satu rekod CSS yang didokumenkan: kelas asasnya serta segala yang diturunkan daripada CSS + komen dokumen."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The record name from `@component`/`@utility`/`@rule`/`@declaration`/`@name`, e.g. `button`."
msgstr "Nama rekod dari `@component`/`@utility`/`@rule`/`@declaration`/`@name`, contohnya `button`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### kind"
msgstr "### kind"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Which kind of CSS surface this documents (defaults to `component`)."
msgstr "Jenis permukaan CSS yang didokumenkan (lalai kepada `component`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The base CSS selector — a class (`.button`), attribute (`[data-layout=\"x\"]`), ID (`#foo`),\n or shadow-DOM pseudo (`:host`) — inferred from the first bare-class rule or set explicitly via\n `@selector`. Always non-empty (falls back to `.${name}` when inference fails)."
msgstr "Penyilih asas CSS — satu kelas (`.button`), atribut (`[data-layout=\"x\"]`), ID (`#foo`),\natau pseudo shadow-DOM (`:host`) — ditentukan daripada peraturan kelas kosong pertama atau ditetapkan secara eksplisit melalui\n`@selector`. Sentiasa tidak kosong (kembali kepada `.${name}` apabila inferens gagal)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### summary?"
msgstr "### summary?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One-line summary from `@summary`."
msgstr "Ringkasan satu baris dari `@summary`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### remarks?"
msgstr "### remarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Extended prose from `@remarks`."
msgstr "Prosa lanjutan dari `@remarks`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### privateRemarks?"
msgstr "### privateRemarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Internal-only prose from `@privateRemarks` (emitters may choose to omit it from public output)."
msgstr "Prosa untuk kegunaan dalaman sahaja dari `@privateRemarks` (pemerbit boleh memilih untuk mengabaikannya dalam keluaran awam)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### releaseStage?"
msgstr "### releaseStage?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The release stage from a modifier flag tag (`@alpha`/`@beta`/`@experimental`/`@internal`/`@public`)."
msgstr "Tahap pelepasan dari tag bendera pengubah (`@alpha`/`@beta`/`@experimental`/`@internal`/`@public`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### since?"
msgstr "### since?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Version introduced, from `@since`."
msgstr "Versi diperkenalkan, dari `@since`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### group?"
msgstr "### group?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A documentation group/category, from `@group`/`@category`."
msgstr "Kumpulan/kategori dokumentasi, dari `@group`/`@category`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### accessibility?"
msgstr "### accessibility?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Accessibility guidance, from `@a11y`/`@accessibility`."
msgstr "Panduan kebolehcapaian, dari `@a11y`/`@accessibility`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### global?"
msgstr "### global?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Set when this record carries a `@global` tag — its modifiers (and per-modifier `@global` flags)\napply to any component/layout/rule/declaration, not just this record's base class. Used during\nvalidation and consumption checks to resolve modifier matches globally."
msgstr "Ditetapkan apabila rekod ini membawa tag `@global` — pengubahnya (dan bendera `@global` setiap-pengubah)\nberlaku kepada mana-mana komponen/tataletak/peraturan/deklarasi, bukan hanya kelas asas rekod ini. Digunakan semasa\npengesahan dan semakan penggunaan untuk menyelesaikan padanan pengubah secara global."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### modifiers"
msgstr "### modifiers"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "AST-extracted modifiers, annotated with `@modifier` prose where authored."
msgstr "Pengubah yang diekstrak dari AST, dihiasi dengan prosa `@modifier` apabila ditulis."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### parts"
msgstr "### parts"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "AST-extracted sub-element parts (class-based), annotated with `@part` prose where authored."
msgstr "Bahagian sub-elemen yang diekstrak dari AST (berasaskan kelas), dihiasi dengan prosa `@part` apabila ditulis."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### shadowParts"
msgstr "### shadowParts"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Shadow-DOM exposed parts (`::part(name)`), from `@csspart` or a `::part()` selector."
msgstr "Bahagian yang didedahkan Shadow-DOM (`::part(name)`), dari `@csspart` atau penyilih `::part()`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### pseudoElements"
msgstr "### pseudoElements"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Native pseudo-elements the component styles (`::before`, `::marker`, …), from `@pseudo` or a selector."
msgstr "Pseudo-elemen natif yang gaya komponen gunakan (`::before`, `::marker`, …), dari `@pseudo` atau penyilih."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### states"
msgstr "### states"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "States the component reacts to, from `@cssstate`, `:state()`, pseudo-classes, or state classes."
msgstr "Status yang komponen bertindak balas, dari `@cssstate`, `:state()`, pseudo-kelas, atau kelas status."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### slots"
msgstr "### slots"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Named slots the component shell exposes, from `@slot`."
msgstr "Slot bernama yang didedahkan oleh shell komponen, dari `@slot`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### elements?"
msgstr "### elements?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Allowed HTML elements from `@element` (default + optional named profiles)."
msgstr "Elemen HTML yang dibenarkan dari `@element` (lalai + profil bernama pilihan)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### todos"
msgstr "### todos"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Internal to-do notes, from `@todo` tags and `/* @todo … */` inline comments. Development notes,\nnot public API — emitters may omit them (like [CssDocEntry.privateRemarks](#privateremarks))."
msgstr "Nota to-do dalaman, dari tag `@todo` dan komen sebaris `/* @todo … */`. Nota pembangunan,\nbukan API awam — pemerbit boleh mengabaikannya (seperti [CssDocEntry.privateRemarks](#privateremarks))."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### cssPropertiesConsumed"
msgstr "### cssPropertiesConsumed"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Design tokens this component consumes: every `--*` custom property referenced via `var(...)` inside\nits rules, each annotated with `@tokens` prose where authored (and including any `@tokens`-declared\ntoken not literally found via `var()`)."
msgstr "Token reka bentuk yang komponen ini guna: setiap `--*` properti tersuai yang dirujuk melalui `var(...)` dalam\nperaturan, setiap satu dihiasi dengan prosa `@tokens` apabila ditulis (dan termasuk sebarang token yang diisytiharkan oleh `@tokens`\nyang tidak dijumpai secara literal melalui `var()`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### cssPropertiesDeclared"
msgstr "### cssPropertiesDeclared"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Custom properties this component declares (`@property`) or documents (`@cssproperty`)."
msgstr "Properti tersuai yang komponen ini isytihar (`@property`) atau dokumenkan (`@cssproperty`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### functions"
msgstr "### functions"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "CSS custom functions (`@function`) this component defines."
msgstr "Fungsi tersuai CSS (`@function`) yang komponen ini takrif."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### animations"
msgstr "### animations"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Animations (`@keyframes`) this component exposes."
msgstr "Animasi (`@keyframes`) yang komponen ini dedahkan."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### layers"
msgstr "### layers"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Cascade layers (`@layer`) this component participates in."
msgstr "Lapisan cascade (`@layer`) yang komponen ini sertai."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### conditions"
msgstr "### conditions"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Conditional-support blocks (`@container`/`@supports`/`@media`) the rules sit under."
msgstr "Blok sokongan bersyarat (`@container`/`@supports`/`@media`) yang peraturan berada di bawahnya."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### examples"
msgstr "### examples"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`@example` blocks, verbatim."
msgstr "Blok `@example`, secara literal."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### structure?"
msgstr "### structure?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The authored `@structure` element tree (top-level nodes), when present. When the `@structure` body\nuses `@variant` blocks (see [structureVariants](#structurevariants)), this holds the first variant's nodes only,\nfor back-compat with any code that hasn't been updated to read `structureVariants`."
msgstr "Pokok elemen `@structure` yang ditulis (nod peringkat teratas), apabila wujud. Apabila badan `@structure` yang ditulis\nmenggunakan blok `@variant` (lihat [structureVariants](#structurevariants)), ini memegang nod varian pertama sahaja,\nuntuk kebal-kod belakang dengan sebarang kod yang belum dikemas kini untuk membaca `structureVariants`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### structureVariants?"
msgstr "### structureVariants?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Alternative DOM shapes for this component, when the authored `@structure` body contains one or\nmore top-level `@variant` blocks — absent for the common case of a single, non-variant structure."
msgstr "Bentuk DOM alternatif untuk komponen ini, apabila badan `@structure` yang ditulis mengandungi satu atau\nlebih blok `@variant` peringkat teratas — tiada untuk kes biasa struktur tunggal tanpa varian."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### structureDescription?"
msgstr "### structureDescription?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "An optional prose description leading the `@structure` body, when authored."
msgstr "Satu penerangan prosa pilihan yang memimpin badan `@structure`, apabila ditulis."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### demo?"
msgstr "### demo?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`@demo <spec>` (e.g. `self:button`), when authored."
msgstr "`@demo &lt;spec&gt;` (e.g. `self:button`), when authored."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Component-level deprecation replacement text, when authored (the argument to a `@deprecated` tag)."
msgstr "Teks penggantian penyahgunaan pada peringkat komponen, apabila ditulis (argumen kepada tag `@deprecated`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### see"
msgstr "### see"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`@see <ref>` cross-references."
msgstr "`@see &lt;ref&gt;` cross-references."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### usage?"
msgstr "### usage?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Usage prose from `@usage` — how to include the stylesheet / use the component."
msgstr "Prosa penggunaan dari `@usage` — cara memasukkan helaian gaya / menggunakan komponen."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### annotations"
msgstr "### annotations"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
