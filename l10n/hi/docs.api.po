msgstr "`--instui-primitive-font-weight-*` — `font-weight` यूटिलिटीज़ के रूप में निर्गत।"

#: plugins/pantoken/primitives/src/interfaces/PrimitivesOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Options for [primitivesCss](../functions/primitivesCss.md)."
msgstr "[primitivesCss](../functions/primitivesCss.md) के लिए विकल्प।"

#: plugins/pantoken/primitives/src/interfaces/PrimitivesOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The class prefix. A truthy string namespaces every class (`\"instui\"` → `.instui-bg-…`); any falsy\nvalue drops the prefix entirely (`.bg-…`). The shipped `primitives.css` is built with `\"instui\"`."
msgstr "क्लास प्रीफिक्स। एक सत्य-पुष्ट स्ट्रिंग हर क्लास का नामस्थान बनाती है (`\"instui\"` → `.instui-bg-…`); कोई भी असत्य मान प्रीफिक्स को पूरी तरह हटा देता है (`.bg-…`). वितरित `primitives.css` को `\"instui\"` के साथ बनाया गया है।"

