msgid "The committed token deprecation ledger (`formats/tokens/deprecations.json`)."
msgstr "प्रतिबद्ध टोकन हटाने का लेखा-जोखा (`formats/tokens/deprecations.json`)."

#: packages/model/src/interfaces/DeprecationLedger.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The ledger schema version."
msgstr "लेजर स्कीमा संस्करण."

#: packages/model/src/interfaces/DeprecationLedger.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The deprecation entries, one per dropped upstream token."
msgstr "निष्कासन प्रविष्टियाँ, प्रत्येक हटाए गए अपस्ट्रीम टोकन के लिए एक."

#: packages/model/src/interfaces/PropertyRule.md
#, no-c-format
msgctxt "docs.api:prose"
