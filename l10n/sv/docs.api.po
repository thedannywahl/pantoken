msgstr "Ovanför standardflödet."

#: css/stacking.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Below the default flow."
msgstr "Under standardflödet."

#: css/stacking.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The lowest stacking depth."
msgstr "Det lägsta staplingsdjupet."

#: css/stacking.md
