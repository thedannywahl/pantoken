msgstr "Begränsa till en rad (standard)."

#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Clamp to two lines."
msgstr "Begränsa till två rader."

#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Clamp to three lines."
msgstr "Begränsa till tre rader."

#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Clamp to four lines."
msgstr "Begränsa till fyra rader."

#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
