msgstr "Ytterligare paketnamn att lägga till i `transpilePackages`."

#: bundlers/next/src/variables/INSTUI_TRANSPILE_PACKAGES.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The Instructure UI packages Next needs to transpile. Extend via [WithPantokenOptions](../interfaces/WithPantokenOptions.md)."
msgstr "De Instructure UI-paket som Next behöver transpileras. Utöka via [WithPantokenOptions](../interfaces/WithPantokenOptions.md)."

