#: css/testimonial.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`div[class~=\"instui-testimonial\"]` — Quote or testimonial display with attribution and optional imagery."
msgstr "`div[class~=\"instui-testimonial\"]` — Citat- eller rekommendationsvisning med attribuering och valfri bild."

#: css/testimonial.md
#, no-c-format
