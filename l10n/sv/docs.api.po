msgstr "Iframen `src`."

#: tools/demo/src/interfaces/ResolvedDemo.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The iframe `sandbox` attribute."
msgstr "Iframen `sandbox`-attributet."

#: tools/demo/src/interfaces/RunnerLabels.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The runner's view-tab labels. Omitted keys fall back to the runner's English defaults."
msgstr "Runnerns vyfliksetiketter. Uteslutna nycklar faller tillbaka till runnerns engelska standardvärden."

#: tools/demo/src/interfaces/RunnerLabels.md
#, no-c-format
msgctxt "docs.api:prose"
