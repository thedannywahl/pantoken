#: plugins/tinymce/a11y/src/i18n.json#a11yImageAltMessage
#, no-c-format
msgctxt "tinymce.strings:a11yImageAltMessage"
msgid "Images must have alternative text."
msgstr "Bilder måste ha alternativtext."

#: plugins/tinymce/a11y/src/i18n.json#a11yImageAltWhy
#, no-c-format
msgctxt "tinymce.strings:a11yImageAltWhy"
msgid "Screen readers need an alt attribute to describe an image or identify it as decorative."
msgstr "Skärmläsare behöver ett alt-attribut för att beskriva en bild eller identifiera den som dekorativ."

#: plugins/tinymce/a11y/src/i18n.json#a11yImageAltFilenameMessage
#, no-c-format
msgctxt "tinymce.strings:a11yImageAltFilenameMessage"
msgid "Image alternative text should describe the image, not repeat its filename."
msgstr "Bildens alternativtext bör beskriva bilden, inte upprepa dess filnamn."

#: plugins/tinymce/a11y/src/i18n.json#a11yImageAltFilenameWhy
#, no-c-format
msgctxt "tinymce.strings:a11yImageAltFilenameWhy"
msgid "A filename rarely gives screen reader users useful information about an image."
msgstr "Ett filnamn ger sällan skärmläsaranvändare användbar information om en bild."

#: plugins/tinymce/a11y/src/i18n.json#a11yImageAltLengthMessage
#, no-c-format
msgctxt "tinymce.strings:a11yImageAltLengthMessage"
msgid "Image alternative text should be 125 characters or fewer."
msgstr "Bildens alternativtext bör vara 125 tecken eller färre."

#: plugins/tinymce/a11y/src/i18n.json#a11yImageAltLengthWhy
#, no-c-format
msgctxt "tinymce.strings:a11yImageAltLengthWhy"
msgid "Short descriptions are easier to understand and navigate with assistive technology."
msgstr "Korta beskrivningar är lättare att förstå och navigera med hjälpteknik."

#: plugins/tinymce/a11y/src/i18n.json#a11yHeadingSequenceMessage
#, no-c-format
msgctxt "tinymce.strings:a11yHeadingSequenceMessage"
msgid "Heading levels should not skip levels."
msgstr "Rubriknivåer bör inte hoppa över nivåer."

#: plugins/tinymce/a11y/src/i18n.json#a11yHeadingSequenceWhy
#, no-c-format
msgctxt "tinymce.strings:a11yHeadingSequenceWhy"
msgid "A logical heading outline helps people navigate content with assistive technology."
msgstr "En logisk rubrikstruktur hjälper personer att navigera innehåll med hjälpteknik."

#: plugins/tinymce/a11y/src/i18n.json#a11yTableHeaderMessage
#, no-c-format
msgctxt "tinymce.strings:a11yTableHeaderMessage"
msgid "Tables must include header cells."
msgstr "Tabeller måste innehålla headerceller."

#: plugins/tinymce/a11y/src/i18n.json#a11yTableHeaderWhy
#, no-c-format
msgctxt "tinymce.strings:a11yTableHeaderWhy"
msgid "Header cells give screen readers the context needed to understand table data."
msgstr "Headerceller ger skärmläsare den kontext som krävs för att förstå tabelldata."

#: plugins/tinymce/a11y/src/i18n.json#a11yTableCaptionMessage
#, no-c-format
msgctxt "tinymce.strings:a11yTableCaptionMessage"
msgid "Tables should include a caption."
msgstr "Tabeller bör innehålla en bildtext (caption)."

#: plugins/tinymce/a11y/src/i18n.json#a11yTableCaptionWhy
#, no-c-format
msgctxt "tinymce.strings:a11yTableCaptionWhy"
msgid "A caption identifies a table's purpose before a screen reader enters its cells."
msgstr "En bildtext identifierar en tabells syfte innan en skärmläsare går in i dess celler."

#: plugins/tinymce/a11y/src/i18n.json#a11yTableHeaderScopeMessage
#, no-c-format
msgctxt "tinymce.strings:a11yTableHeaderScopeMessage"
msgid "Table header cells should declare their scope."
msgstr "Tabellhuvudceller bör ange sitt scope."

#: plugins/tinymce/a11y/src/i18n.json#a11yTableHeaderScopeWhy
#, no-c-format
msgctxt "tinymce.strings:a11yTableHeaderScopeWhy"
msgid "The scope attribute lets assistive technology associate headers with data cells."
msgstr "Attributet scope låter hjälpmedel associera rubriker med dataceller."

#: plugins/tinymce/a11y/src/i18n.json#a11yAdjacentLinksMessage
#, no-c-format
msgctxt "tinymce.strings:a11yAdjacentLinksMessage"
msgid "Adjacent links with the same destination should be combined."
msgstr "Intilliggande länkar med samma destination bör slås ihop."

#: plugins/tinymce/a11y/src/i18n.json#a11yAdjacentLinksWhy
#, no-c-format
msgctxt "tinymce.strings:a11yAdjacentLinksWhy"
msgid "Repeated links create unnecessary stops for keyboard and screen reader users."
msgstr "Upprepade länkar skapar onödiga stopp för tangentbords- och skärmläsaranvändare."

#: plugins/tinymce/a11y/src/i18n.json#a11yHeadingStartMessage
#, no-c-format
msgctxt "tinymce.strings:a11yHeadingStartMessage"
msgid "The first heading should be an h2."
msgstr "Den första rubriken bör vara en h2."

#: plugins/tinymce/a11y/src/i18n.json#a11yHeadingStartWhy
#, no-c-format
msgctxt "tinymce.strings:a11yHeadingStartWhy"
msgid "The editor's document title is supplied outside the editable content."
msgstr "Redigerarens dokumenttitel anges utanför det redigerbara innehållet."

#: plugins/tinymce/a11y/src/i18n.json#a11yListStructureMessage
#, no-c-format
msgctxt "tinymce.strings:a11yListStructureMessage"
msgid "List items must be contained by an ordered or unordered list."
msgstr "Listobjekt måste vara inneslutna i en ordnad eller oordnad lista."

#: plugins/tinymce/a11y/src/i18n.json#a11yListStructureWhy
#, no-c-format
msgctxt "tinymce.strings:a11yListStructureWhy"
msgid "Assistive technology relies on list structure to announce item counts and position."
msgstr "Hjälpmedel förlitar sig på liststrukturen för att meddela antal och position för objekt."

