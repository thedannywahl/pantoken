#: index.md:5
#, no-c-format
msgid "Create beautiful,<br/><span class=\"platform-line\">accessible<br/><span class=\"platform web\">web</span></span><br/>apps."
msgstr "Skapa vackra,<br/><span class=\"platform-line\">tillgängliga<br/><span class=\"platform web\">webb</span></span><br/>appar."

#: index.md:7
#, no-c-format
msgid "One resolved token model, reshaped into stylesheets, framework bindings, native code, and design-tool payloads."
msgstr "En enda upplöst tokenmodell, omformad till stilmallar, ramverksbindningar, nativekod och data för designverktyg."

#: index.md:10
#, no-c-format
msgid "Getting started"
msgstr "Kom igång"

#: index.md:13
#, no-c-format
msgid "CSS reference"
msgstr "CSS-referens"

#: index.md:16
#, no-c-format
msgid "API reference"
msgstr "API-referens"

#: index.md:22
#, no-c-format
msgid "One source of truth"
msgstr "En enda sanningskälla"

#: index.md:23
#, no-c-format
msgid "Every packages uses the official Instructure design tokens, components, and interactions from <a href=\"https://instructure.design\" target=\"_blank\">InstUI</a>."
msgstr "Alla paket använder de officiella Instructure-designtokens, komponenter och interaktioner från <a href=\"https://instructure.design\" target=\"_blank\">InstUI</a>."

#: index.md:27
#, no-c-format
msgid "Use the smallest package"
msgstr "Använd det minsta paketet"

#: index.md:28
#, fuzzy, no-c-format
msgid "Install just <code>@pantoken/css</code> for a stylesheet, <code>@pantoken/pendo</code> for guides, or a bundler preset for Tailwind, Panda, or MUI."
msgstr "Installera bara @pantoken/css för en stilmall, @pantoken/react för hooks och ikoner, eller ett bundler‑preset för Tailwind, Panda eller MUI."

#: index.md:32
#, no-c-format
msgid "Generate for any platform"
msgstr "Generera för vilken plattform som helst"

#: index.md:33
#, no-c-format
msgid "Install the pantoken cli to generate presets or add components for any platform&colon; web, native, and anything in between."
msgstr "Installera pantoken cli för att generera förinställningar eller lägga till komponenter för vilken plattform som helst&colon; webb, nativ och allt däremellan."

#: index.md:37
#, no-c-format
msgid "No React needed"
msgstr "React behövs inte"

#: index.md:38
#, no-c-format
msgid "The InstUI library is tightly coupled with React. If you want to use it, you have to use React. Now you can build anywhere."
msgstr "InstUI-biblioteket är tätt kopplat till React. Om du vill använda det måste du använda React. Nu kan du bygga överallt."

#, no-c-format
#~ msgid "InstUI, everywhere"
#~ msgstr "InstUI, överallt"

#, no-c-format
#~ msgid "Every package reads the same resolved token IR. Change a token upstream and it flows to CSS, SCSS, native code, and Figma the same way."
#~ msgstr "Varje paket läser samma upplösta token-IR. Ändra en token uppströms och den förs vidare till CSS, SCSS, nativekod och Figma på samma sätt."

#, no-c-format
#~ msgid "Run `pantoken generate` to emit Swift, Kotlin, Compose, Flutter, Rust, WordPress, and more. The same tokens, in each ecosystem's idiom."
#~ msgstr "Kör `pantoken generate` för att generera Swift, Kotlin, Compose, Flutter, Rust, WordPress med mera. Samma tokens, i varje ekosystems idiom."

#, no-c-format
#~ msgid "No upstream coupling"
#~ msgstr "Ingen uppströmskoppling"

#, no-c-format
#~ msgid "The tokens ship vendored as static JSON, so `npm i` never reaches for a GitHub-only source. Publishable, semver'd, offline-friendly."
#~ msgstr "Tokens levereras vendorerade som statisk JSON, så `npm i` behöver aldrig slå mot en GitHub‑endast källa. Publicerbara, semver-versionerade och offline‑vänliga."

#, no-c-format
#~ msgid "The package map"
#~ msgstr "Paketkartan"
