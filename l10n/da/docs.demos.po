msgstr "Sæt"

#: truncate/i18n.json#text3
#, no-c-format
msgctxt "docs.demos:truncate:text3"
msgid "custom property to clamp to a fixed number of lines instead. This\n      paragraph runs long on purpose so the clamp has something to cut off after the second line."
msgstr "den brugerdefinerede property for i stedet at begrænse til et fast antal linjer. Dette\n      afsnit er bevidst langt så clamp kan afkorte efter den anden linje."

