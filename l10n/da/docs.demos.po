msgctxt "docs.demos:truncate:text1"
msgid "This single line keeps going past the edge of its box, so it ends in an ellipsis."
msgstr "Denne enkeltlinje fortsætter forbi kanten af sin boks, så den ender i en ellipse."

#: truncate/i18n.json#text2
#, no-c-format
