#: css/list.item.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: list.item"
msgstr ""

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.instui-list` — A list item (InstUI `List.Item`)."
msgstr "`.instui-list` — Et listeelement (InstUI `List.Item`)."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The parent `list`'s `-size-sm`/`-size-lg`, `-ordered`, and `-delimiter-solid`/`-delimiter-dashed` modifiers restyle this member — see `list`'s own doc for those modifiers."
msgstr "Den overordnede `list`'s `-size-sm`/`-size-lg`, `-ordered` og `-delimiter-solid`/`-delimiter-dashed` modifikatorer ændrer udseendet af dette medlem — se `list`'s egen dokumentation for disse modifikatorer."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Separate items with a dashed rule. @affects list.item — Adds the delimiter rule between items."
msgstr "Adskil elementer med en streget regel. @affects list.item — Tilføjer afgrænsningsreglen mellem elementer."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Separate items with a solid rule. @affects list.item — Adds the delimiter rule between items."
msgstr "Adskil elementer med en heltrukken regel. @affects list.item — Tilføjer afgrænsningsreglen mellem elementer."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Ordered-list numbering. @affects list.item — Adds marker weight and indentation."
msgstr "Nummerering af ordnede lister. @affects list.item — Tilføjer markørtykkelse og indrykning."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Renders the list bullet or ordered-list number."
msgstr "Renderer listepunktet eller nummeret i en ordnet liste."

