#, no-c-format
msgctxt "docs.api:prose"
msgid "AST-extracted modifiers, annotated with `@modifier` prose where authored."
msgstr "AST-ekstraherede modifikatorer, annoteret med `@modifier` tekst hvor der er forfattet."

