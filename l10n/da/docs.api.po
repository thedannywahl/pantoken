msgstr ""

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default)."
msgstr "Mellem (standard)."

#: css/progress-circle.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). Long-form alias of `-size-md`."
msgstr "Medium (standard). Langformet alias for `-size-md`."

#: css/progress-circle.md
#, no-c-format
