msgstr "Sætter `display: flex`."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Display utilities: `block`, `inline-block`, `inline`, `flex`, `inline-flex`, and `none`."
msgstr "Visningsværktøjer: `block`, `inline-block`, `inline`, `flex`, `inline-flex` og `none`."

