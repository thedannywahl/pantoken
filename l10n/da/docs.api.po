msgctxt "docs.api:prose"
msgid "`<instui-icon-button>` — an icon-only, square button. `label` becomes the button's `aria-label`;\nslotted content is the glyph (e.g. an `<instui-icon>`)."
msgstr "`&lt;instui-icon-button&gt;` — en ikon-kun, kvadratisk knap. `label` bliver knappens `aria-label`;\nslottet indhold er glyphen (f.eks. en `&lt;instui-icon&gt;`)."

