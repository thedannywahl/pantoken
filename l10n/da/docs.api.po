msgstr "Tilladte HTML-elementer fra `@element` (standard + valgfrie navngivne profiler)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### todos"
msgstr "### todos"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Internal to-do notes, from `@todo` tags and `/* @todo … */` inline comments. Development notes,\nnot public API — emitters may omit them (like [CssDocEntry.privateRemarks](#privateremarks))."
msgstr "Interne todo-noter, fra `@todo` tags og `/* @todo … */` inline-kommentarer. Udviklings-noter,\nikke offentlig API — emittere kan udelade dem (som [CssDocEntry.privateRemarks](#privateremarks))."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### cssPropertiesConsumed"
msgstr "### cssPropertiesConsumed"

