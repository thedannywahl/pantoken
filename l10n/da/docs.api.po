#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: CssDocEntry"
msgstr "# Interface: CssDocEntry"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One documented CSS record: its base class plus everything derived from the CSS + doc comments."
msgstr "En dokumenteret CSS-post: dens basisklasse plus alt afledt fra CSS + dokumentationskommentarer."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The record name from `@component`/`@utility`/`@rule`/`@declaration`/`@name`, e.g. `button`."
msgstr "Postnavnet fra `@component`/`@utility`/`@rule`/`@declaration`/`@name`, f.eks. `button`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### kind"
msgstr "### kind"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Which kind of CSS surface this documents (defaults to `component`)."
msgstr "Hvilken slags CSS-overflade dette dokumenterer (standard til `component`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The base CSS selector — a class (`.button`), attribute (`[data-layout=\"x\"]`), ID (`#foo`),\n or shadow-DOM pseudo (`:host`) — inferred from the first bare-class rule or set explicitly via\n `@selector`. Always non-empty (falls back to `.${name}` when inference fails)."
msgstr "Basis-CSS-vælgeren — en klasse (`.button`), attribut (`[data-layout=\"x\"]`), ID (`#foo`),\n eller shadow-DOM pseudo (`:host`) — udledt fra den første bare-class-regel eller eksplicit sat via\n `@selector`. Altid ikke-tom (falder tilbage til `.${name}` når udledning mislykkes)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### summary?"
msgstr "### summary?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One-line summary from `@summary`."
msgstr "Enlinjeresumé fra `@summary`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### remarks?"
msgstr "### remarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Extended prose from `@remarks`."
msgstr "Udvidet tekst fra `@remarks`."

