#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One documented CSS record: its base class plus everything derived from the CSS + doc comments."
msgstr "Eitt dokumentert CSS-oppføring: baseklassen og alt som er avleidd frå CSS + dokkommentarane."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The record name from `@component`/`@utility`/`@rule`/`@declaration`/`@name`, e.g. `button`."
msgstr "Oppføringsnamnet frå `@component`/`@utility`/`@rule`/`@declaration`/`@name`, t.d. `button`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### kind"
msgstr "### kind"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Which kind of CSS surface this documents (defaults to `component`)."
msgstr "Kva slags CSS-flate dette dokumenterer (standard: `component`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The base CSS selector — a class (`.button`), attribute (`[data-layout=\"x\"]`), ID (`#foo`),\n or shadow-DOM pseudo (`:host`) — inferred from the first bare-class rule or set explicitly via\n `@selector`. Always non-empty (falls back to `.${name}` when inference fails)."
msgstr "Den grunnleggande CSS-selektoren — ein klasse (`.button`), attributt (`[data-layout=\"x\"]`), ID (`#foo`),\neller shadow-DOM-pseudo (`:host`) — utoverført frå den første bare-klasse-regelen eller sett eksplisitt via\n`@selector`. Alltid ikkje-tom (fell tilbake til `.${name}` når inferens feilar)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### summary?"
msgstr "### summary?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One-line summary from `@summary`."
msgstr "Einlinje-samanfatning frå `@summary`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### remarks?"
msgstr "### remarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Extended prose from `@remarks`."
msgstr "Utvida prosa frå `@remarks`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### privateRemarks?"
msgstr "### privateRemarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Internal-only prose from `@privateRemarks` (emitters may choose to omit it from public output)."
msgstr "Intern-prosa frå `@privateRemarks` (emitørar kan velje å utelate dette i offentleg output)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### releaseStage?"
msgstr "### releaseStage?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The release stage from a modifier flag tag (`@alpha`/`@beta`/`@experimental`/`@internal`/`@public`)."
msgstr "Utgjevingstrinnet frå eit modifikator-flaggtagg (`@alpha`/`@beta`/`@experimental`/`@internal`/`@public`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### since?"
msgstr "### since?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Version introduced, from `@since`."
msgstr "Versjon introdusert, frå `@since`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### group?"
msgstr "### group?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A documentation group/category, from `@group`/`@category`."
msgstr "Ei dokumentasjonsgruppe/kategori, frå `@group`/`@category`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### accessibility?"
msgstr "### accessibility?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Accessibility guidance, from `@a11y`/`@accessibility`."
msgstr "Tilgjengelegheitsrettleiing, frå `@a11y`/`@accessibility`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### global?"
msgstr "### global?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Set when this record carries a `@global` tag — its modifiers (and per-modifier `@global` flags)\napply to any component/layout/rule/declaration, not just this record's base class. Used during\nvalidation and consumption checks to resolve modifier matches globally."
msgstr "Set når denne oppføringa har eit `@global`-tagg — modifikatorane (og per-modifikator `@global`-flagga)\ngjelder for alle komponentar/layout/reglar/deklarasjonar, ikkje berre denne oppføringens baseklasse. Brukt under\nvalidering og forbrukarkontroll for å løyse modifikator-matchar globalt."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### modifiers"
msgstr "### modifiers"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "AST-extracted modifiers, annotated with `@modifier` prose where authored."
msgstr "AST-uttrekte modifikatorar, annoterte med `@modifier`-prosa der det er forfatta."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### parts"
msgstr "### parts"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "AST-extracted sub-element parts (class-based), annotated with `@part` prose where authored."
msgstr "AST-uttrekte under-elementdelar (klasse-baserte), annoterte med `@part`-prosa der det er forfatta."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### shadowParts"
msgstr "### shadowParts"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Shadow-DOM exposed parts (`::part(name)`), from `@csspart` or a `::part()` selector."
msgstr "Shadow-DOM-eksponerte delar (`::part(name)`), frå `@csspart` eller ein `::part()`-selektor."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### pseudoElements"
msgstr "### pseudoElements"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Native pseudo-elements the component styles (`::before`, `::marker`, …), from `@pseudo` or a selector."
msgstr "Native pseudo-element som komponenten stiliserer (`::before`, `::marker`, …), frå `@pseudo` eller ein selektor."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### states"
msgstr "### states"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "States the component reacts to, from `@cssstate`, `:state()`, pseudo-classes, or state classes."
msgstr "Tilstandar komponenten reagerer på, frå `@cssstate`, `:state()`, pseudo-klassar eller tilstandsklassar."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### slots"
msgstr "### slots"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Named slots the component shell exposes, from `@slot`."
msgstr "Namngjevne slots som komponent-skallet eksponerer, frå `@slot`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### elements?"
msgstr "### elements?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Allowed HTML elements from `@element` (default + optional named profiles)."
msgstr "Tillatne HTML-element frå `@element` (standard + valfrie namngjevne profiler)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### todos"
msgstr "### todos"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Internal to-do notes, from `@todo` tags and `/* @todo … */` inline comments. Development notes,\nnot public API — emitters may omit them (like [CssDocEntry.privateRemarks](#privateremarks))."
msgstr "Interne to-do-merknader, frå `@todo`-taggar og `/* @todo … */` inline-kommentarar. Utviklarmerknader,\nikkje offentleg API — emitørar kan utelate dei (som [CssDocEntry.privateRemarks](#privateremarks))."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### cssPropertiesConsumed"
msgstr "### cssPropertiesConsumed"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
