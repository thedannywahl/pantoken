#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Interface: CdnFile"
msgstr "# Grensesnitt: CdnFile"

#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A single file to load from a CDN, identified by npm package name and path within it."
msgstr "Ei enkelt fil som skal lastast frå ein CDN, identifisert ved npm-pakkenamn og sti i pakken."

#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### package"
msgstr "### package"

#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The npm package name, e.g. `\"@pantoken/components\"`."
msgstr "Namn på npm-pakken, til dømes `\"@pantoken/components\"`."

#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The path within the package, e.g. `\"dist/components.css\"`. Omit to reference the package root."
msgstr "Stien i pakken, til dømes `\"dist/components.css\"`. Utelate for å referere til pakkens rot."

#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Overrides the provider/build-level version for this file only."
msgstr "Overstyrer leverandør-/bygg-nivåversjonen for berre denne fila."

#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### raw?"
msgstr "### raw?"

#: platforms/canvas-theme-editor/src/interfaces/CdnFile.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "For providers that transform JS by default (esm.sh): `false` lets the provider apply its normal\nESM transform (needed to `import` a real package entry point). Defaults to `true` — serve the\nfile verbatim, required for prebuilt/non-ESM assets like CSS sheets and IIFE bundles."
msgstr "For leverandørar som som standard transformerer JS (esm.sh): `false` lèt leverandøren bruke sin vanlege\nESM-transformasjon (nødvendig for å `import` eit verkeleg pakkepunkt). Standard er `true` — server fila ordrett, påkrevd for førehandsbygde/ikkje-ESM-ressursar som CSS-ark og IIFE-bundlar."

