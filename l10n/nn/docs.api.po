#, no-c-format
msgctxt "docs.api:prose"
msgid "The target directory (default `\".\"`). Its basename (or `\"pantoken-app\"` for `\".\"`)\n  is substituted for `{{projectName}}` in the scaffold's template files."
msgstr "Målkatalogen (standard `\".\"`). Basenamnet hennar (eller `\"pantoken-app\"` for `\".\"`)\n  blir sett inn i malfilene til scaffolden i staden for `{{projectName}}`."

