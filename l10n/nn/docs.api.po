msgid "Long-form alias of `-size-md`."
msgstr "Langform-alias for `-size-md`."

#: css/breadcrumb.link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Long-form alias of `-size-sm`."
msgstr "Langform-alias for `-size-sm`."

#: css/breadcrumb.link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Renders the chevron separator after every crumb except the last; mirrors to `chevron-left` in `[dir=\"rtl\"]`."
msgstr "Gjev chevron-skiljaren etter kvar brødsmule bortsett frå den siste; speglar til `chevron-left` i `[dir=\"rtl\"]`."

#: css/breadcrumb.link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "In a collapsed parent draws a masked back-arrow before this crumb's second-to-last link."
msgstr "I ein kollapsa overordna teiknar ein maskert tilbake-pil før denne brødsmulen sin nest-siste lenke."

#: css/breadcrumb.link.md
#, no-c-format
msgctxt "docs.api:text"
msgid "## Conditions"
msgstr "## Vilkår"

#: css/breadcrumb.link.md
#, no-c-format
msgctxt "docs.api:text"
msgid "Query"
msgstr "Førespurnad"

