"| `--instui-icon-history`                                       | "
"`ui@11.7.6`   | `ui@11.8.0` | `--instui-icon-rotate-ccw-"
"clock`                               |\n"
"| `--instui-icon-laugh`                                         | "
"`ui@11.7.6`   | `ui@11.8.0` | _frozen "
