msgstr "Streži samo datoteke, katerih URL-pot se konča s to pripono, npr. `\".css\"`."

#: plugins/vite/workspace-orchestrator/src/interfaces/FileServerEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Value for the `Content-Type` response header."
msgstr "Vrednost za glavo odgovora `Content-Type`."

