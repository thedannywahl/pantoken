msgstr "Možnosti za [withPantoken](../functions/withPantoken.md)."

#: bundlers/next/src/interfaces/WithPantokenOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Extra package names to add to `transpilePackages`."
msgstr "Dodatna imena paketov, ki jih je treba dodati v `transpilePackages`."

#: bundlers/next/src/variables/INSTUI_TRANSPILE_PACKAGES.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The Instructure UI packages Next needs to transpile. Extend via [WithPantokenOptions](../interfaces/WithPantokenOptions.md)."
msgstr "Paketi Instructure UI, ki jih mora Next transpilirati. Razširite preko [WithPantokenOptions](../interfaces/WithPantokenOptions.md)."

#: bundlers/next/src/variables/INSTUI_TRANSPILE_PACKAGES.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Feed the list into a manual transpilePackages**"
msgstr "**Posredujte seznam v ročni transpilePackages**"

