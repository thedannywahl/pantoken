#: ai/pantoken-ai/src/functions/installAgentAssets.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Write pantoken's agent assets for a tool into a consumer repo."
msgstr "Zapiši agentne vire pantoken za orodje v repozitorij uporabnika."

#: ai/pantoken-ai/src/functions/installAgentAssets.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A specific [AgentTool](../type-aliases/AgentTool.md), or `\"all\"` for every asset."
msgstr "Določeno [AgentTool](../type-aliases/AgentTool.md), ali `\"all\"` za vsak vir."

#: ai/pantoken-ai/src/functions/installAgentAssets.md
#, no-c-format
msgctxt "docs.api:prose"
