msgstr "Predpona URL-poti, kjer se bo middleware priključil, npr. `\"/styles/apps\"`."

#: plugins/vite/workspace-orchestrator/src/interfaces/FileServerEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Local directory to serve files from."
msgstr "Lokalni imenik, iz katerega se bodo strežile datoteke."

#: plugins/vite/workspace-orchestrator/src/interfaces/FileServerEntry.md
#, no-c-format
msgctxt "docs.api:prose"
