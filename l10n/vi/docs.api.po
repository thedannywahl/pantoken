#: packages/core/src/functions/cssSyntaxForValue.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# Function: cssSyntaxForValue()"
msgstr "# Hàm: cssSyntaxForValue()"

#: packages/core/src/functions/cssSyntaxForValue.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sniff the CSS `@property` `syntax` a concrete token should register under. Tokens Studio\n`type`s don't map 1:1 to CSS syntax, so the value is inspected. Returns `\"*\"` (universal) for\nanything that isn't a single, computationally-independent typed token."
msgstr "Xác định `@property` `syntax` trong CSS mà một token cụ thể nên đăng ký dưới đó. Tokens Studio\n`type`s không ánh xạ 1:1 tới cú pháp CSS, nên giá trị được kiểm tra. Trả về `\"*\"` (chung) cho\nbất cứ thứ gì không phải là một token kiểu đơn lẻ, độc lập về mặt tính toán."

#: packages/core/src/functions/cssSyntaxForValue.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A concrete value (no `var()` / `light-dark()`)."
msgstr "Một giá trị cụ thể (không có `var()` / `light-dark()`)."

#: packages/core/src/functions/cssSyntaxForValue.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The `@property` syntax descriptor."
msgstr "Bộ mô tả cú pháp `@property`."

#: packages/core/src/functions/cssSyntaxForValue.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Typed single-token values**"
msgstr "**Giá trị đơn-token có kiểu**"

#: packages/core/src/functions/cssSyntaxForValue.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Font-relative units and complex values fall back to universal**"
msgstr "**Đơn vị tương đối phông chữ và các giá trị phức tạp sẽ quay về loại chung**"

