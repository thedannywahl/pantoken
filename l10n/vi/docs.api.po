#, no-c-format
msgctxt "docs.api:prose"
msgid "A rehype plugin factory. Returns a transformer that rewrites `:code:` tokens to inline SVG."
msgstr "Một factory plugin rehype. Trả về một bộ biến đổi (transformer) thay thế các token `:code:` thành SVG nhúng."

