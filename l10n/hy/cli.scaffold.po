#: packages/scaffold/src/i18n.json
#, no-c-format
msgctxt "cli.scaffold:canvas-theme-editor.notes"
msgid "Upload theme.css and theme.js to Canvas's Theme Editor (Advanced → CSS / JavaScript) so pantoken's classes are available on every page."
msgstr "Վերբեռնել theme.css և theme.js- ը Canvas-ի Theme Editor (Advanced → CSS / JavaScript) բաժինն՝ որպեսզի pantoken-ի դասերն հասանելի լինեն յուրաքանչյուր էջում."

#: packages/scaffold/src/i18n.json
#, no-c-format
msgctxt "cli.scaffold:canvas-theme-editor.caveats"
msgid "Canvas sanitizes pasted HTML server-side — always verify content pasted from the RCE preview in Canvas."
msgstr "Canvas-ը սերվեր-մակարդակում սանիտիզացնում է հղթված HTML-ը — միշտ ստուգեք RCE նախադիտման մեջ պատճենած ու մատնանշած բովանդակությունը Canvas-ում."

#: packages/scaffold/src/i18n.json
#, no-c-format
msgctxt "cli.scaffold:canvas-theme-editor.pageTitle"
msgid "RCE template authoring"
msgstr "RCE տեմպլեյթի հեղինակություն"

#: packages/scaffold/src/i18n.json
#, no-c-format
