msgstr "# Ֆունկցիա: baseCss()"

#: formats/components/src/functions/baseCss.md
#, no-c-format
msgctxt "docs.api:text"
msgid "<span class=\"instui-pill -color-warning pantoken-doc-tag\">Beta</span>"
msgstr "<span class=\"instui-pill -color-warning pantoken-doc-tag\">Բետա</span>"

#: formats/components/src/functions/baseCss.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Build the opt-in base/reset stylesheet: global document defaults from the tokens (box-sizing, body\nreset, page surface, base text colour/font, `color-scheme`, base link), followed by the focus-ring\nrules (a document-level default that targets bare focusables). Only the ring *rules* live here — the\n`--instui-focus-outline-*` custom properties they read ship in the token sheet (`@pantoken/css`), so\n`base.css` no longer redefines them. Load it once, ahead of the component and prose sheets, when\npantoken owns the page."
msgstr "Կառուցեք ընտրովի բազային/վերականգնիչ ոճ-հաղորդակցման թերթ՝ տոկենից ստացված գլոբալ փաստաթղթի կանխակարգեր (box-sizing, body վերականգնում, էջի մակերեսություն, բազային տեքստի գույն/տառատեսակ, `color-scheme`, բազային հղում), որին հաջորդում է focus-ring կանոնները (փաստաթղթի մակարդակի կանխակարգ, որը ուղղված է մերկ կենտրոնացրածներին)։ Միայն ring *կանոնները* ապրում են այստեղ — այն `--instui-focus-outline-*` հատուկ հատկությունները, որոնք նրանք կարդում են, գալիս են տոկեն թերթում (`@pantoken/css`), ուստի `base.css` այլեւ չի վերասահմանում դրանք։ Բեռնեք այն մեկ անգամ, բաղադրիչ և տեքստային թերթերից առաջ, երբ pantoken-ը սեփական է էջը։"

#: formats/components/src/functions/baseCss.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The CSS string."
msgstr "CSS տողը։"

#: formats/components/src/functions/componentsCss.md
