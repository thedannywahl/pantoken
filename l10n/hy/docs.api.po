msgctxt "docs.api:prose"
msgid "The localized wordmark's language, if a translated variant is wanted."
msgstr "Տեղայնացված բառանիշի լեզուն, եթե ցանկացվում է թարգմանված տարբերակ."

msgctxt "docs.api:prose"
msgid "The localized wordmark's language, absent for the default (English) variant."
msgstr "Տեղայնացված բառանշանի լեզուն; բացակայում է սկզբնական (անգլերեն) տարբերակի համար."

msgctxt "docs.api:prose"
msgid "A trailing language code on a localized wordmark variant, e.g. `\"horizontal-full-color-ar\"`."
msgstr "Տեղայնացված բառանշանի տարբերակի վերջում գտնվող լեզվի կոդը, օրինակ՝ `\"horizontal-full-color-ar\"`."

msgctxt "docs.api:prose"
msgid "BCP47 locale tag or a pre-built [LocaleBundle](#). When set, uses `registerLocalized`."
msgstr "BCP47 տեղական թեգ կամ նախապես կառուցված [LocaleBundle](#):. Երբ սահմանված է, օգտագործվում է `registerLocalized`."

msgctxt "docs.api:prose"
msgid "Accepts a fully resolved [LocaleBundle](#) *or* a raw BCP47 tag string. When a string is\npassed, [makeStrings](#) derives weekday names via `Intl.DateTimeFormat` and all other strings\nfall back to English; pass a bundle for full translations."
msgstr "Ընդունում է ամբողջությամբ լուծված [LocaleBundle](#)-ը *կամ* հում BCP47 պիտակի տող։ Երբ տող է\nփոխանցվում, [makeStrings](#)-ը ստանում է շաբաթվա օրերի անունները `Intl.DateTimeFormat`-ի միջոցով, իսկ բոլոր այլ տողերը\nվերադառնում են անգլերենի; ամբողջական թարգմանությունների համար փոխանցեք bundle։"

msgctxt "docs.api:prose"
msgid "A [LocaleBundle](#) object, or a BCP47 tag (`\"hu\"`, `\"ar\"`, …)."
msgstr "Մեկ [LocaleBundle](#) օբյեկտ, կամ BCP47 պիտակ (`\"hu\"`, `\"ar\"`, …)."
