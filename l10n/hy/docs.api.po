msgctxt "docs.api:prose"
msgid "`@pantoken/vitepress` — theme a VitePress site with Instructure tokens."
msgstr "`@pantoken/vitepress` — VitePress կայքին թեմա տալ Instructure մեջբերումներով:"

#: renderers/vitepress/src/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "VitePress theming is driven by `--vp-*` CSS variables. This points them at `var(--instui-*)`, so\ndropping the output into `.vitepress/theme/custom.css` (alongside `@pantoken/css`, which defines\nthe custom properties) re-skins the docs with the Instructure look while light/dark keeps flowing\nthrough the same tokens."
msgstr "VitePress-ի թեմայի ընտրությունը վարվում է `--vp-*` CSS փոփոխականներով: Սա ուղղում է դրանք դեպի `var(--instui-*)`, ուստի\nարդյունքը `.vitepress/theme/custom.css`-ի մեջ նետելը (մեկտեղ `@pantoken/css`-ի հետ, որը սահմանում է\nկաղապար հատկությունները) վերականգնում է փաստաթղթերի տեսքը Instructure արտաքինի հետ, մինչ լույս/մուգ շարունակում է\nհոսել նույն մեջբերումների միջով:"

