msgstr "- [text-input](/api/css/text-input.md) — Փաթաթում է տեքստային մուտք, ավելացնելով առաջատար և հետևորդ պատկերակների սլոթեր։"

#: css/layout.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: layout"
msgstr ""

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.--display-flex` — Display and text-align utilities — `.--display-<value>` and `.--text-align-<value>` — as composable, global classes, usable bare or chained onto any component."
msgstr "`.--display-flex` — ցուցադրման և տեքստի դասավորման օգտակար դասեր — `.--display-<value>` և `.--text-align-<value>` — որպես կոմպոզիտիվ, գլոբալ դասեր, որոնք կարելի է օգտագործել մաքուր կամ շղթայաբար ցանկացած կոմպոնենտի վրա."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Source:** [index.ts](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/utilities/layout/index.ts)"
msgstr "**Source:** [index.ts](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/utilities/layout/index.ts)"

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sets `display: flex`."
msgstr "Սահմանում է `display: flex`."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Display utilities: `block`, `inline-block`, `inline`, `flex`, `inline-flex`, and `none`."
msgstr "Ցուցադրման օգտակար դասեր՝ `block`, `inline-block`, `inline`, `flex`, `inline-flex` և `none`."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Text-alignment utilities: `start`, `center`, `end`, and `justify`."
msgstr "Տեքստի դասավորման օգտակար դասեր՝ `start`, `center`, `end` և `justify`."

#: css/link.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: link"
msgstr ""

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.instui-link` — A styled hyperlink with sizes, an inverse variant for dark backgrounds, and inline or unstyled forms."
msgstr "`.instui-link` — ոճավորված հիպերհղում՝ տարբեր չափերով, մուգ ֆոնների համար հակադարձ տարբերակով և inline կամ անօճելի ձևերով։"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sets its own responsive `gap` between an icon and its text (`-size-sm`/`-size-lg` scale it); chaining a `-gap-*` spacing utility modifier overrides that built-in value."
msgstr "Իր սեփական պատասխանատու `gap`-ը սահմանում է նշանի և նրա տեքստի (`-size-sm`/`-size-lg`) միջև (բարձրությունը կարգավորվում է); `-gap-*` spacing utility մոդիֆիկատորը շարակցելով՝ վերաձգվում է այդ ներառական արժեքը։"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Source:** [link.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/link/link.css)"
msgstr "**Source:** [link.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/link/link.css)"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Mark a disabled link with `aria-disabled=\"true\"`."
msgstr "փակված հղումը նշելու համար օգտագործեք `aria-disabled=\"true\"`։"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "For dark backgrounds."
msgstr "Մուգ ֆոնների համար։"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Inline link, underlined within flowing text."
msgstr "Inline հղում, գծապատկերված հոսող տեքստի մեջ։"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large inline link (used with `-inline`)."
msgstr "Մեծ inline հղում (կիրառվում է `-inline`-ի հետ)।"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Small inline link (used with `-inline`)."
msgstr "Փոքր inline հղում (կիրառվում է `-inline`-ի հետ)。"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Strip link styling: inherit colour, no underline."
msgstr "Հեռացրե՛ք հղման ոճավորումն՝ ժառանգել գույնը, առանց ենթակետման։"

#: css/link.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "- [breadcrumb](/api/css/breadcrumb.md) — A breadcrumb trail is built from links; also its small-screen fallback (pair with the `responsive` utility to swap Breadcrumb for a Link below ~768px)."
msgstr "- [breadcrumb](/api/css/breadcrumb.md) — Breadcrumb ուղու կազմությունը սերտաճում է հղումներից; ինչպես նաև նրա փոքր էկրանների ֆոլբեքը (գործակցիր `responsive` utility-ով՝ Breadcrumb-ը փոխարինելու համար Link-ով մոտավորապես ~768px-ից ցածր էկրաններում)।"

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: list.item"
msgstr ""

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.instui-list` — A list item (InstUI `List.Item`)."
msgstr "`.instui-list` — Ցանկի տարր (InstUI `List.Item`)."

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The parent `list`'s `-size-sm`/`-size-lg`, `-ordered`, and `-delimiter-solid`/`-delimiter-dashed` modifiers restyle this member — see `list`'s own doc for those modifiers."
msgstr "Մայր `list`-ի `-size-sm`/`-size-lg`, `-ordered` և `-delimiter-solid`/`-delimiter-dashed` փոփոխականները վերաոճավորում են այս անդամը — այդ փոփոխականների համար տեսեք `list`-ի փաստաթուղթը։"

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Separate items with a dashed rule. @affects list.item — Adds the delimiter rule between items."
msgstr "Տարրերը բաժանեք ծակոտկեն գծով։ @affects list.item — Ավելացնում է տարրերի միջև բաժանարար կանոնը։"

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Separate items with a solid rule. @affects list.item — Adds the delimiter rule between items."
msgstr "Տարրերը բաժանեք պինդ գծով։ @affects list.item — Ավելացնում է տարրերի միջև բաժանարար կանոնը։"

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Ordered-list numbering. @affects list.item — Adds marker weight and indentation."
msgstr "Հաշված ցանկի համար թվանշում։ @affects list.item — Ավելացնում է նշակի հաստությունն ու ներդրումը։"

#: css/list.item.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Renders the list bullet or ordered-list number."
msgstr "Ցուցադրում է ցանկի կետը կամ հաշվարկված ցանկի թիվը։"

#: css/list.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: list"
msgstr ""

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.instui-list` — A list with token-driven item spacing."
msgstr "`.instui-list` — Ցանկ՝ տոկենով կարգավորված տարրերի միջև բացվածքով։"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sets its own `padding-inline-start` for list indentation; chaining a `-p*`/`-padding*` spacing utility modifier overrides that built-in value. See the `list.item` member for the individual items."
msgstr "Կարգավորում է իր սեփական `padding-inline-start`-ը ցանկի չեղավորումի համար; `-p*`/`-padding*` բացվածքի utility մոդիֆիկատորը ռետ chaining-ի դեպքում գերակշռում է այդ ներառված արժեքը։ Տեսեք `list.item` անդամը անհատական տարրերի համար։"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "**Source:** [list.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/list/list.css)"
msgstr "**Source:** [list.css](https://github.com/thedannywahl/pantoken/blob/main/formats/components/src/components/list/list.css)"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Lay items out inline (horizontal)."
msgstr "Տարրերը դասավորել նույն տողում (հորիզոնական)."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match. Long-form alias of `-size-lg`."
msgstr "Մեծ։ @affects list.item — Պիտակների միջև բացվածքը համապատասխան կերպով մեծացվում է։ `-size-lg`-ի երկարաձև հոմանիշ։"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match."
msgstr "Մեծ։ @affects list.item — Պիտակների միջև բացվածքը համապատասխան կերպով մեծացվում է։"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). @affects list.item — Scales the item spacing to match."
msgstr "Միջին (պետք էավոր)։ @affects list.item — Պիտակների միջև բացվածքը համապատասխան կերպով կարգավորվում է։"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium (default). @affects list.item — Scales the item spacing to match. Long-form alias of `-size-md`."
msgstr "Միջին (պետք էավոր)։ @affects list.item — Պիտակների միջև բացվածքը համապատասխան կերպով կարգավորվում է։ `-size-md`-ի երկարաձև հոմանիշ։"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Small. @affects list.item — Scales the item spacing to match."
msgstr "Փոքր։ @affects list.item — Պիտակների միջև բացվածքը համապատասխան կերպով փոքրացվում է։"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Small. @affects list.item — Scales the item spacing to match. Long-form alias of `-size-sm`."
msgstr "Փոքր։ @affects list.item — Պիտակների միջև բացվածքը համապատասխան կերպով փոքրացվում է։ `-size-sm`-ի երկարաձև հոմանիշ։"

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Remove markers and padding."
msgstr "Հեռացնել նշանները և padding-ը։"

#: css/logos.md
#, no-c-format
msgctxt "docs.api:text"
msgid "# CSS: logos"
msgstr ""

#: css/logos.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.logos` — Instructure product logos as CSS image tokens: `--instui-logo-<product>-<layout>-<mode>` holds a data-URI SVG, so a logo paints via e.g. `background-image: var(--instui-logo-canvas-horizontal-color)`."
msgstr "`.logos` — Instructure ապրանքի լոգոները որպես CSS պատկերային տոկեններ։ `--instui-logo-<product>-<layout>-<mode>` պարունակում է data-URI SVG, այնպես որ լոգոն նկարվում է, օրինակ, `background-image: var(--instui-logo-canvas-horizontal-color)`-ի միջոցով։"

#: css/logos.md
