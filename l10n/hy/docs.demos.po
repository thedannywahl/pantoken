#: docs/demos/base/i18n.json#text3
#, no-c-format
msgctxt "docs.demos:base:text3"
msgid "loaded first. The page surface, base text color\n    and font, and"
msgstr "առաջին բեռնելով։ Էջի մակերեսը, հիմնական տեքստի գույնը\n    և տառատեսակը, և"

