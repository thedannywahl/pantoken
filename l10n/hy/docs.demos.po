#, no-c-format
msgctxt "docs.demos:base:text6"
msgid "base link"
msgstr "միջին հղում"

#: docs/demos/base/i18n.json#text7
#, no-c-format
msgctxt "docs.demos:base:text7"
msgid ", and everything sits on the token page surface. Switch the theme (or\n    light/dark) and the surface, text, and link all follow."
msgstr ", և ամեն ինչ նստած է տոկենի էջի մակերեսի վրա։ Փոխանցեք թեման (կամ\n    լույս/մութ) և մակերեսը, տեքստը ու հղումը հետևում են։"

