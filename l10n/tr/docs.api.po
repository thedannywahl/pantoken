msgid "The box's mask glyph: a tick when checked, a dash when indeterminate."
msgstr "Kutunun maske simgesi: işaretliyse tik, belirsizse kısa çizgi."

#: css/checkbox.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The toggle border width."
msgstr "Anahtar kenarlık kalınlığı."

#: css/checkbox.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The toggle switch height."
msgstr "Anahtar yüksekliği."

#: css/checkbox.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The computed handle diameter."
msgstr "Hesaplanmış tutucu çapı."

#: css/checkbox.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The handle inset from each track edge."
msgstr "Tutucunun her iz kenarından içe uzaklığı."

#: css/checkbox.md
