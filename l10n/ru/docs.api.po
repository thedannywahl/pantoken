#, no-c-format
msgctxt "docs.api:prose"
msgid "Theme to source the `--instui-*` layer from (default `\"rebrand\"`)."
msgstr "Тема, из которой брать слой `--instui-*` (по умолчанию `\"rebrand\"`)."

