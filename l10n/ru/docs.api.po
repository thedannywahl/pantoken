msgstr "Круглая кнопка-иконка."

#: css/button.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A square icon button."
msgstr "Квадратная кнопка-иконка."

#: css/button.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "(default) medium size."
msgstr "(по умолчанию) средний размер."

#: css/button.md
