#, no-c-format
msgctxt "docs.api:prose"
msgid "The dropped upstream token name, e.g. `--instui-component-truncate-text-line-height`."
msgstr "Имя удалённого upstream‑токена, например `--instui-component-truncate-text-line-height`."

