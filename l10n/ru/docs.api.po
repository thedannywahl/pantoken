msgid "# Interface: CssDocEntry"
msgstr "# Интерфейс: CssDocEntry"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One documented CSS record: its base class plus everything derived from the CSS + doc comments."
msgstr "Одна документированная запись CSS: её базовый класс плюс всё, что выведено из CSS и комментариев документации."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The record name from `@component`/`@utility`/`@rule`/`@declaration`/`@name`, e.g. `button`."
msgstr "Имя записи из `@component`/`@utility`/`@rule`/`@declaration`/`@name`, например `button`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### kind"
msgstr "### kind"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Which kind of CSS surface this documents (defaults to `component`)."
msgstr "Какого рода CSS‑поверхность документируется (по умолчанию `component`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The base CSS selector — a class (`.button`), attribute (`[data-layout=\"x\"]`), ID (`#foo`),\n or shadow-DOM pseudo (`:host`) — inferred from the first bare-class rule or set explicitly via\n `@selector`. Always non-empty (falls back to `.${name}` when inference fails)."
msgstr "Базовый CSS‑селектор — класс (`.button`), атрибут (`[data-layout=\"x\"]`), ID (`#foo`),\nили псевдо для shadow‑DOM (`:host`) — выводится из первого bare-class правила или задаётся явно через\n`@selector`. Всегда непустой (при неудаче вывод возвращается к `.${name}`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### summary?"
msgstr "### summary?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One-line summary from `@summary`."
msgstr "Краткое однострочное резюме из `@summary`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### remarks?"
msgstr "### remarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Extended prose from `@remarks`."
msgstr "Расширенный прозаический текст из `@remarks`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### privateRemarks?"
msgstr "### privateRemarks?"

