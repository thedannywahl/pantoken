msgstr ""
"Supports authoring with either direct theme custom-idents in media features "
"(for example,\n"
"`(theme: canvas)`) or built-in `@custom-media --theme-*` aliases."

#: plugins/typedoc/demo/src/functions/load.md
#, no-c-format
msgctxt "docs.api:prose"
msgid ""
"TypeDoc entry point. Registers a resolve-time pass that rewrites `@demo` "
"tags into demo fences."
msgstr ""
"TypeDoc entry point. Registers a resolve-time pass that rewrites `@demo` "
"tags into demo fences."

#: plugins/typedoc/demo/src/functions/load.md
#, no-c-format
msgctxt "docs.api:prose"
