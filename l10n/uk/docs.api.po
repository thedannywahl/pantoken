#, no-c-format
msgctxt "docs.api:prose"
msgid "Clamp to one line (default)."
msgstr "Обмежити одним рядком (за замовчуванням)."

#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Clamp to two lines."
msgstr "Обмежити двома рядками."

#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Clamp to three lines."
msgstr "Обмежити трьома рядками."

