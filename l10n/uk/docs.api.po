msgstr "overflow-x: visible."

#: css/overflow.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "overflow-y: auto."
msgstr "overflow-y: auto."

#: css/overflow.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "overflow-y: clip."
msgstr "overflow-y: clip."

#: css/overflow.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "overflow-y: hidden."
msgstr "overflow-y: hidden."

#: css/overflow.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "overflow-y: scroll."
msgstr "overflow-y: scroll."

#: css/overflow.md
