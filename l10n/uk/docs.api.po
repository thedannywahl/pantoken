msgstr "overflow-x: clip."

#: css/overflow.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "overflow-x: hidden."
msgstr "overflow-x: hidden."

#: css/overflow.md
#, no-c-format
msgctxt "docs.api:prose"
