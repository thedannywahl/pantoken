#, no-c-format
msgctxt "docs.api:prose"
msgid "The path within the package, e.g. `\"dist/components.css\"`. Omit to reference the package root."
msgstr "An cosán laistigh den phacáiste, m.sh. `\"dist/components.css\"`. Fág é amach chun tagairt a dhéanamh don fréamhphacáiste."

