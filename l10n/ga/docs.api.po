#, no-c-format
msgctxt "docs.api:prose"
msgid "Version introduced, from `@since`."
msgstr "Leagan ina gcuireadh isteach, ó `@since`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### group?"
msgstr "### group?"

