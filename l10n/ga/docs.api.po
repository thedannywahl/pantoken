#, no-c-format
msgctxt "docs.api:prose"
msgid "An optional prose description leading the `@structure` body, when authored."
msgstr "Cur síos prose roghnach a réamhthreoraíonn corp `@structure`, nuair a scríobhadh é."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
