#, no-c-format
msgctxt "docs.api:prose"
msgid "Allowed HTML elements from `@element` (default + optional named profiles)."
msgstr "Eilimintí HTML ceadaithe ó `@element` (réamhshocrú + próifílí ainmniúla roghnacha)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### todos"
msgstr "### todos"

