#, no-c-format
msgctxt "docs.api:text"
msgid "### global?"
msgstr "### global?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Set when this record carries a `@global` tag — its modifiers (and per-modifier `@global` flags)\napply to any component/layout/rule/declaration, not just this record's base class. Used during\nvalidation and consumption checks to resolve modifier matches globally."
msgstr "Socraithe nuair a thaiscaíonn an taifead seo clib `@global` — cuireann a mhodhnóirí (agus gach modhnóir in aghaidh a n-`@global` bratach)\n i bhfeidhm ar aon chomhpháirt/leagan/riail/ráiteas, ní hamháin ar rang bhunúsach an taifeada seo. Úsáidtear le linn seiceálacha bailíochta agus tomhais tomhaltóra chun comhionannais mhodhnóra a réiteach go domhanda."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
