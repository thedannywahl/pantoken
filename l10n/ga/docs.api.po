msgctxt "docs.api:text"
msgid "# Interface: CssDocEntry"
msgstr "# Comhéadan: CssDocEntry"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One documented CSS record: its base class plus everything derived from the CSS + doc comments."
msgstr "Taifead CSS amháin a doiciméadaíodh: a rang bhunúsach agus gach rud a dhéantar as an CSS + tuairimí doiciméid."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The record name from `@component`/`@utility`/`@rule`/`@declaration`/`@name`, e.g. `button`."
msgstr "Ainm an taifeada ó `@component`/`@utility`/`@rule`/`@declaration`/`@name`, m.sh. `button`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### kind"
msgstr "### kind"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Which kind of CSS surface this documents (defaults to `component`)."
msgstr "Cén saghas dromchla CSS a bhfuil an doiciméadú air (réamhshocrú go `component`)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The base CSS selector — a class (`.button`), attribute (`[data-layout=\"x\"]`), ID (`#foo`),\n or shadow-DOM pseudo (`:host`) — inferred from the first bare-class rule or set explicitly via\n `@selector`. Always non-empty (falls back to `.${name}` when inference fails)."
msgstr "An roghnóir CSS bunúsach — rang (`.button`), tréith (`[data-layout=\"x\"]`), ID (`#foo`),\n nó pseudo shadow-DOM (`:host`) — cuartha ón riail chláirseach-bhunaithe chéaduaire nó socraithe go sainráite tríd\n `@selector`. I gcónaí neamh-fholamh (tuairisceann sé ar `.${name}` nuair nach rith an tuarascáil)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### summary?"
msgstr "### summary?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "One-line summary from `@summary`."
msgstr "Sármhínigh aon líne ó `@summary`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### remarks?"
msgstr "### remarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Extended prose from `@remarks`."
msgstr "Faisnéis shonrach fhada ó `@remarks`."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### privateRemarks?"
msgstr "### privateRemarks?"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Internal-only prose from `@privateRemarks` (emitters may choose to omit it from public output)."
msgstr "Faisnéis inmheánach amháin ó `@privateRemarks` (d’fhéadfadh go roghnófadh emissoirí é a bhaint as an aschur poiblí)."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
