msgstr "Léirigh ag scála cló h3."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Render at the h4 type scale."
msgstr "Léirigh ag scála cló h4."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Render at the h5 type scale."
msgstr "Léirigh ag scála cló h5."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Render at the h6 type scale."
msgstr "Léirigh ag scála cló h6."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
