#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Sets `display: flex`."
msgstr "مقدار `display: flex` را تنظیم می‌کند."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Display utilities: `block`, `inline-block`, `inline`, `flex`, `inline-flex`, and `none`."
msgstr "ابزارهای نمایش: `block`, `inline-block`, `inline`, `flex`, `inline-flex` و `none`."

#: css/layout.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Text-alignment utilities: `start`, `center`, `end`, and `justify`."
