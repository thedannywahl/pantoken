msgid "Build the full `<!doctype html>` document string for an isolated live-example preview."
msgstr "Smíða fullan `<!doctype html>` skjalstreng fyrir einangraða forskoðun lifandi dæmis."

#: tools/demo/src/functions/buildExampleSrcdoc.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The example's raw markup (verbatim from its source fence)."
msgstr "Hrá uppsetning dæmisins (beint afrit úr uppsprettukóðablokk þess)."

#: tools/demo/src/functions/buildExampleSrcdoc.md
#, no-c-format
