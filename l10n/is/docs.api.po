msgctxt "docs.api:prose"
msgid " Rubric.docx"
msgstr " Einkunnunarviðmið.docx"

#: css/tree-browser.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Render folder/file glyph icons in summaries and leaf items."
msgstr "Birta möppu- og skráartákn í samantektum og laufliðum."

#: css/tree-browser.md
#, no-c-format
msgctxt "docs.api:prose"
