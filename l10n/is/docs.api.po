msgid "Enables truncation and line clamping on the target element."
msgstr "Virkjar skurð og línubindingu á tilteknum frumefni."

#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "(default) Truncate at the character level."
msgstr "(sjálfgefið) Afsmelltu á stafsstigi."

#: css/truncate.md
