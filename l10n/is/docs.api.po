#, no-c-format
msgctxt "docs.api:prose"
msgid "`tbody` — The table's data row group (InstUI `Table.Body`)."
msgstr "`tbody` — Gagnaraðarhópur töflunnar (InstUI `Table.Body`)."

#: css/table.body.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The parent `table`'s `-layout-stacked` modifier restyles this member — see `table`'s own doc for that modifier."
msgstr "`table`'s `-layout-stacked` breytir útliti þessa meðlims — sjá `table`'s eigið skjal um þann breytir."

