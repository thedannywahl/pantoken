#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Alias of `--max-lines-5`."
msgstr "Gælunafn fyrir `--max-lines-5`."

#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Clamp to one line (default)."
msgstr "Takmarka við eina línu (sjálfgefið)."

#: css/truncate.md
#, no-c-format
msgctxt "docs.api:prose"
