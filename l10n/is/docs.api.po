msgid "Hide when the marked container is at or above the `content-full-width` breakpoint (`98.75em`)."
msgstr "Fela þegar tilgreint ílát er á eða yfir brotpunktinum `content-full-width` (`98.75em`)."

#: css/responsive.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Hide when the marked container is at or above the `lg` breakpoint (`48em`)."
msgstr "Fela þegar tilgreint ílát er á eða yfir brotpunktinum `lg` (`48em`)."

#: css/responsive.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Hide when the marked container is at or above the `md` breakpoint (`30em`)."
msgstr "Fela þegar tilgreint ílát er á eða yfir brotpunktinum `md` (`30em`)."

#: css/responsive.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Hide when the marked container is at or above the `sm` breakpoint (`20em`)."
msgstr "Fela þegar tilgreint ílát er á eða yfir brotpunktinum `sm` (`20em`)."

#: css/responsive.md
#, no-c-format
