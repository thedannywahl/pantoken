msgstr "以 h6 字級渲染。"

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Label type preset."
msgstr "標籤字體預設。"

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Mini card-title preset."
msgstr "迷你卡片標題預設。"

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Regular card-title preset."
msgstr "一般卡片標題預設。"

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Card section-title preset."
msgstr "卡片區段標題預設。"

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Page-title preset."
msgstr "頁面標題預設。"

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Section-title preset."
msgstr "章節標題預設。"

#: css/heading.md
