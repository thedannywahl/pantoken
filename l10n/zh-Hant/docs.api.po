msgstr "名字"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Last name"
msgstr "姓氏"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "City"
msgstr "城市"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "State"
msgstr "州"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "CA"
msgstr "CA"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "NY"
msgstr "NY"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "TX"
msgstr "TX"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "All fields are used for delivery only."
msgstr "所有欄位僅用於配送。"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large column gap."
msgstr "大型欄間距。"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Medium column gap."
msgstr "中型欄間距。"

#: css/form-field-group.md
#, no-c-format
msgctxt "docs.api:prose"
