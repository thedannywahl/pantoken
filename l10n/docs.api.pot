msgstr ""

#: renderers/web-components/src/variables/ICON_ELEMENTS.md
#, no-c-format
msgctxt "docs.api:glossary"
msgid "# Variable: ICON\\_ELEMENTS"
msgstr ""

#: renderers/web-components/src/variables/ICON_ELEMENTS.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Base element names that actually call [iconSvg](../functions/iconSvg.md) to render an inline glyph, as opposed to the\nseparate, CSS-only `-icon-<name>` glyph painting most components use (a mask on a CSS custom\nproperty, no JS resolution involved). `date-time-input` isn't listed because it doesn't call\n`iconSvg` itself — it nests `date-input`/`calendar` (see [NESTED\\_DEPS](NESTED_DEPS.md)), which do."
msgstr ""

#: renderers/web-components/src/variables/LOCALES.md
