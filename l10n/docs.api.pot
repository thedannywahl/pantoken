msgid "Every element definition, in the canonical registration order. The order is load-bearing:\n`date-input` renders a nested `calendar` and `date-time-input` renders a nested `date-input`, and\nthe `ELEMENTS` tuple / the register-order test both derive from this list."
msgstr ""

#: renderers/web-components/src/variables/ELEMENTS.md
#, no-c-format
msgctxt "docs.api:glossary"
msgid "# Variable: ELEMENTS"
msgstr ""

#: renderers/web-components/src/variables/ELEMENTS.md
