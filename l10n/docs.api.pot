#: renderers/web-components/src/variables/dateInput.md
#, no-c-format
msgctxt "docs.api:glossary"
msgid "# Variable: dateInput"
msgstr ""

#: renderers/web-components/src/variables/dateInput.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`<instui-date-input>` — a text field plus a calendar dropdown. The trigger toggles a `[popover]`\nthrough the built-in `toggle-popover` Invoker Command (a click fallback covers browsers without the\nAPI); picking a day in the nested `<instui-calendar>` fills the field (ISO `yyyy-mm-dd`), closes the\npopover, and emits a composed, bubbling `change` (`detail.value`). Typing a valid `yyyy-mm-dd` (or\nclearing it) and committing on the input's `change` works too. `value` is the ISO date, `label` the\naccessible name (default `Date`), and `placeholder` the hint (default `yyyy-mm-dd`)."
msgstr ""

#: renderers/web-components/src/variables/dateTimeInput.md
#, no-c-format
msgctxt "docs.api:glossary"
msgid "# Variable: dateTimeInput"
msgstr ""

#: renderers/web-components/src/variables/dateTimeInput.md
#, no-c-format
msgctxt "docs.api:prose"
