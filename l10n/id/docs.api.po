msgstr "Registri Simple Icons (default: paket `simple-icons`, dimuat secara malas)."

#: plugins/pantoken/simple-icons/src/interfaces/SimpleIconsOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The token-name prefix (default: `--instui-icon-`)."
msgstr "Awalan nama token (default: `--instui-icon-`)."

