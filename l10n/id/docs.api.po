msgctxt "docs.api:prose"
msgid "`<instui-spinner>` — a loading spinner with `role=\"status\"`. Purely presentational; size and\ncolour follow the CSS tokens."
msgstr "`&lt;instui-spinner&gt;` — a loading spinner with `role=\"status\"`. Purely presentational; size and\ncolour follow the CSS tokens."

#: renderers/web-components/src/variables/sv.md
#, no-c-format
msgctxt "docs.api:prose"
