msgstr "สีรอง (จาง)."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Render at the h1 type scale."
msgstr "เรนเดอร์ที่สเกลตัวอักษร h1."

#: css/heading.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Render at the h2 type scale."
msgstr "เรนเดอร์ที่สเกลตัวอักษร h2."

#: css/heading.md
#, no-c-format
