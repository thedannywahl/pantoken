msgstr "ปุ่มไอคอนทรงสี่เหลี่ยม."

#: css/button.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "(default) medium size."
msgstr "(ค่าเริ่มต้น) ขนาดกลาง."

#: css/button.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "(default) medium size. Long-form alias of `-size-md`."
msgstr "(ค่าเริ่มต้น) ขนาดกลาง. ชื่อยาวเป็นนามแฝงของ `-size-md`."

#: css/button.md
