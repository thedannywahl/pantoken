msgstr "# ฟังก์ชัน: initInPlaceEdit()"

#: formats/interactions/src/functions/initInPlaceEdit.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Wire a contenteditable field for click-to-edit commit/revert behaviour.\nEnter commits, Escape reverts; blur also commits if the value changed.\nFires a bubbling `change` CustomEvent with `detail.value` on commit."
msgstr "เชื่อมต่อฟิลด์ contenteditable สำหรับพฤติกรรมคลิกเพื่อแก้ไข (commit/revert).\nกด Enter เพื่อ commit, กด Escape เพื่อ revert; การ blur จะ commit ด้วยหากค่ามีการเปลี่ยนแปลง.\nจะส่งเหตุการณ์แบบ bubbling `change` CustomEvent ที่มี `detail.value` เมื่อ commit"

#: formats/interactions/src/functions/initInPlaceEdit.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "  CSS:  host = .instui-in-place-edit element (which IS contenteditable)\n  WC:   host = shadow .instui-in-place-edit span"
msgstr "  CSS:  host = .instui-in-place-edit element (ซึ่งเป็น contenteditable)\n  WC:   host = shadow .instui-in-place-edit span"

