#: index.md:5
#, no-c-format
msgid "Create beautiful,<br/><span class=\"platform-line\">accessible<br/><span class=\"platform web\">web</span></span><br/>apps."
msgstr "Δημιουργήστε ωραία,<br/><span class=\"platform-line\">προσιτή<br/><span class=\"platform web\">ιστό</span></span><br/>εφαρμογές."

#: index.md:7
#, no-c-format
msgid "One resolved token model, reshaped into stylesheets, framework bindings, native code, and design-tool payloads."
msgstr "Ένα επιλυμένο μοντέλο token, διαμορφωμένο σε stylesheets, συνδέσεις framework, native κώδικα και δεδομένα για εργαλεία σχεδίασης."

#: index.md:10
#, no-c-format
msgid "Getting started"
msgstr "Ξεκινώντας"

#: index.md:13
#, no-c-format
msgid "CSS reference"
msgstr "Αναφορά CSS"

#: index.md:16
#, no-c-format
msgid "API reference"
msgstr "Αναφορά API"

#: index.md:22
#, no-c-format
msgid "One source of truth"
msgstr "Μία πηγή αλήθειας"

#: index.md:23
#, no-c-format
msgid "Every packages uses the official Instructure design tokens, components, and interactions from <a href=\"https://instructure.design\" target=\"_blank\">InstUI</a>."
msgstr "Κάθε πακέτο χρησιμοποιεί τα επίσημα διακριτικά σχεδίασης Instructure, τα συστατικά και τις αλληλεπιδράσεις από <a href=\"https://instructure.design\" target=\"_blank\">InstUI</a>."

#: index.md:27
#, no-c-format
msgid "Use the smallest package"
msgstr "Χρησιμοποιήστε το μικρότερο πακέτο"

#: index.md:28
#, fuzzy, no-c-format
msgid "Install just <code>@pantoken/css</code> for a stylesheet, <code>@pantoken/pendo</code> for guides, or a bundler preset for Tailwind, Panda, or MUI."
msgstr "Εγκαταστήστε μόνο @pantoken/css για ένα stylesheet, @pantoken/react για hooks και εικονίδια, ή ένα preset bundler για Tailwind, Panda ή MUI."

#: index.md:32
#, no-c-format
msgid "Generate for any platform"
msgstr "Δημιουργία για οποιαδήποτε πλατφόρμα"

#: index.md:33
#, no-c-format
msgid "Install the pantoken cli to generate presets or add components for any platform&colon; web, native, and anything in between."
msgstr "Εγκαταστήστε το pantoken cli για να δημιουργήσετε προεπιλογές ή προσθέστε συστατικά για οποιαδήποτε πλατφόρμα&colon; ιστό, εγγενής και οτιδήποτε ανάμεσα."

#: index.md:37
#, no-c-format
msgid "No React needed"
msgstr "Δεν απαιτείται React"

#: index.md:38
#, no-c-format
msgid "The InstUI library is tightly coupled with React. If you want to use it, you have to use React. Now you can build anywhere."
msgstr "Η βιβλιοθήκη InstUI είναι ισχυρά συνδεδεμένη με React. Εάν θέλετε να τη χρησιμοποιήσετε, πρέπει να χρησιμοποιήσετε React. Τώρα μπορείτε να δημιουργήσετε παντού."

#, no-c-format
#~ msgid "InstUI, everywhere"
#~ msgstr "InstUI, παντού"

#, no-c-format
#~ msgid "Every package reads the same resolved token IR. Change a token upstream and it flows to CSS, SCSS, native code, and Figma the same way."
#~ msgstr "Κάθε πακέτο χρησιμοποιεί την ίδια επιλυμένη αναπαράσταση token (IR). Αλλάξτε ένα token στην upstream πηγή και αυτό μεταδίδεται στην CSS, SCSS, native κώδικα και Figma με τον ίδιο τρόπο."

#, no-c-format
#~ msgid "Run `pantoken generate` to emit Swift, Kotlin, Compose, Flutter, Rust, WordPress, and more. The same tokens, in each ecosystem's idiom."
#~ msgstr "Εκτελέστε `pantoken generate` για να παράγετε Swift, Kotlin, Compose, Flutter, Rust, WordPress και άλλα. Τα ίδια tokens, στην ιδιωματική μορφή κάθε οικοσυστήματος."

#, no-c-format
#~ msgid "No upstream coupling"
#~ msgstr "Χωρίς σύνδεση με upstream"

#, no-c-format
#~ msgid "The tokens ship vendored as static JSON, so `npm i` never reaches for a GitHub-only source. Publishable, semver'd, offline-friendly."
#~ msgstr "Τα tokens διανέμονται ως vendored στατικά JSON, οπότε το `npm i` δεν αναζητά ποτέ πηγή αποκλειστικά στο GitHub. Μπορούν να δημοσιευτούν, έχουν semver και είναι φιλικά για offline χρήση."

#, no-c-format
#~ msgid "The package map"
#~ msgstr "Ο χάρτης πακέτων"
