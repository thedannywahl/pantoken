"`^11.7.8`                                             | "
"`11.7.8`              |\n"
"| `@instructure/ui-link`                   | instui-react | "
"`^11.7.8`                                             | "
"`11.7.8`              |\n"
"| `@instructure/ui-list`                   | instui-react | "
"`^11.7.8`                                             | "
