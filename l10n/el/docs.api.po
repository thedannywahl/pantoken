msgstr "Θέση στο κέντρο της άκρης αρχής."

#: css/badge.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Position at the top-end corner."
msgstr "Θέση στην πάνω-τέλος γωνία."

#: css/badge.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Position at the top-start corner."
msgstr "Θέση στην πάνω-αρχική γωνία."

#: css/badge.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A pulsing attention ring."
msgstr "Ένας παλλόμενος δακτύλιος προσοχής."

#: css/badge.md
