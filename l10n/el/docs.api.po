msgstr "### fonts?"

#: platforms/canvas-theme-editor/src/interfaces/BuildThemeOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Font sheet(s). Defaults to [DEFAULT\\_THEME\\_FONT\\_ASSETS](../variables/DEFAULT_THEME_FONT_ASSETS.md)."
msgstr "Αρχείο(-α) γραμματοσειράς. Προεπιλογή τα [DEFAULT\\_THEME\\_FONT\\_ASSETS](../variables/DEFAULT_THEME_FONT_ASSETS.md)."

#: platforms/canvas-theme-editor/src/interfaces/BuildThemeOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### js?"
msgstr "### js?"

#: platforms/canvas-theme-editor/src/interfaces/BuildThemeOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Script(s). Defaults to [DEFAULT\\_THEME\\_JS\\_ASSETS](../variables/DEFAULT_THEME_JS_ASSETS.md)."
msgstr "Σενάριο(-α). Προεπιλογή τα [DEFAULT\\_THEME\\_JS\\_ASSETS](../variables/DEFAULT_THEME_JS_ASSETS.md)."

#: platforms/canvas-theme-editor/src/interfaces/BuildThemeOptions.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### strings?"
msgstr "### strings?"

