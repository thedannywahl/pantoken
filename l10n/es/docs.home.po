#: index.md:7
#, no-c-format
msgid ""
"One resolved token model, reshaped into stylesheets, framework bindings, "
"native code, and design-tool payloads."
msgstr ""
"Un único modelo de tokens resuelto, transformado en hojas de estilo, enlaces "
"para frameworks, código nativo y payloads para herramientas de diseño."

#: index.md:10
#, no-c-format
msgid "Getting started"
msgstr "Primeros pasos"

#: index.md:13
#, no-c-format
