msgstr "El nombre de la clase aplicado al wrapper emitido (por defecto: `pantoken-icon`)."

#: renderers/shadcn/src/functions/toShadcnCss.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Emit the shadcn → Instructure CSS-variable bridge."
msgstr "Emitir el puente de variables CSS de shadcn → Instructure."

#: renderers/shadcn/src/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`@pantoken/shadcn` — theme shadcn/ui with Instructure tokens."
msgstr "`@pantoken/shadcn` — tema shadcn/ui con tokens de Instructure."

#: renderers/shadcn/src/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "[toShadcnCss](functions/toShadcnCss.md) emits a `:root` block pointing shadcn's CSS variables at `var(--instui-*)`.\nDrop it in alongside `@pantoken/css` (which defines the custom properties) and shadcn components\nadopt the Instructure look. Icons align for free — shadcn and Instructure both use Lucide."
msgstr "[toShadcnCss](functions/toShadcnCss.md) emite un bloque `:root` que apunta las variables CSS de shadcn a `var(--instui-*)`.\nColócalo junto a `@pantoken/css` (que define las propiedades personalizadas) y los componentes shadcn\nadoptarán la apariencia de Instructure. Los iconos coinciden sin más — shadcn e Instructure usan ambos Lucide."

#: renderers/shadcn/src/index.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Renames and re-exports [shadcnCss](variables/shadcnCss.md)"
msgstr "Renombra y reexporta [shadcnCss](variables/shadcnCss.md)"

#: renderers/shadcn/src/interfaces/ToShadcnCssOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Options for [toShadcnCss](../functions/toShadcnCss.md)."
msgstr "Opciones para [toShadcnCss](../functions/toShadcnCss.md)."

#: renderers/shadcn/src/variables/SHADCN_TO_INSTUI.md
#, no-c-format
msgctxt "docs.api:prose"
