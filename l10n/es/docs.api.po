msgstr "El origen de un glifo de icono."

#: packages/core/src/interfaces/TokenMeta.md
#: packages/model/src/interfaces/TokenMeta.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A colour modifier preserved for the native lineage (Style Dictionary)."
msgstr "Un modificador de color preservado para el linaje nativo (Style Dictionary)."

#: packages/core/src/interfaces/TokenMeta.md
#: packages/model/src/interfaces/TokenMeta.md
#, no-c-format
