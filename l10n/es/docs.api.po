#, no-c-format
msgctxt "docs.api:prose"
msgid "The modifier amount, `0`–`1`."
msgstr "La cantidad del modificador, `0`–`1`."

#: packages/core/src/interfaces/TokenModify.md
#: packages/model/src/interfaces/TokenModify.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "The colour space the modifier operates in (e.g. `\"hsl\"`)."
msgstr "El espacio de color en el que opera el modificador (p. ej., `\"hsl\"`)."

#: packages/core/src/interfaces/TokenModify.md
#: packages/model/src/interfaces/TokenModify.md
#, no-c-format
