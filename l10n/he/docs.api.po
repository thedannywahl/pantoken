#: css/tag.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A small tag."
msgstr "תווית קטנה."

#: css/tag.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A small tag. Long-form alias of `-size-sm`."
msgstr "תווית קטנה. כינוי ארוך לצורה של `-size-sm`."

