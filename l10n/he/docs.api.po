#: css/alert.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "`.instui-alert` · <span class=\"instui-pill -color-success pantoken-doc-tag\">stable</span> — An inline message with a status colour bar and a masked status glyph from the shared icon set."
msgstr "`.instui-alert` · <span class=\"instui-pill -color-success pantoken-doc-tag\">stable</span> — הודעה inline עם פס צבע מצב ואייקון מצב ממוסך מתוך ערכת האייקונים המשותפת."

#: css/alert.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "A custom `-icon-<name>` swaps the status glyph but keeps the variant's coloured bar; the bar fill is re-asserted at higher specificity so the shared icon painter doesn't consume it. A direct close button defaults to small; add a size modifier to override it."
msgstr "`-icon-<name>` מותאם אישית מחליף את אייקון המצב אך שומר על פס הצבע של הווריאנט; מילוי הפס מוחזר בעדיפות גבוהה יותר כך שמצייר האייקון המשותף לא צורך אותו. כפתור סגירה ישיר כברירת מחדל קטן; הוסף מודיפייר גודל כדי לעקוף זאת."

