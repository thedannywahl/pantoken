#: tools/demo/src/interfaces/ExampleSrcdocOptions.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Wrap `html` in the shared `.instui-card` surface (default `true`)."
msgstr "Plaats `html` in de gedeelde `.instui-card` surface (standaard `true`)."

#: tools/demo/src/interfaces/ExampleSrcdocOptions.md
#, no-c-format
