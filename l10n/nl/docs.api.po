#, no-c-format
msgctxt "docs.api:prose"
msgid "The target directory (default `\".\"`). Its basename (or `\"pantoken-app\"` for `\".\"`)\n  is substituted for `{{projectName}}` in the scaffold's template files."
msgstr "De doelmap (standaard `\".\"`). De basisnaam ervan (of `\"pantoken-app\"` voor `\".\"`)\n  wordt vervangen door `{{projectName}}` in de sjabloonbestanden van het scaffold."

