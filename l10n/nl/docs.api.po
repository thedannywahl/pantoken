#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match. Long-form alias of `-size-lg`."
msgstr "Groot. @affects list.item — Schaalt de ruimte tussen items overeenkomstig. Langvormig alias van `-size-lg`."

#: css/list.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Large. @affects list.item — Scales the item spacing to match."
msgstr "Groot. @affects list.item — Schaalt de ruimte tussen items overeenkomstig."

