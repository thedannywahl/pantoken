msgstr "AST‑geëxtraheerde sub‑element delen (klasse‑gebaseerd), geannoteerd met `@part` proza waar geschreven."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### shadowParts"
msgstr "### shadowParts"

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:prose"
msgid "Shadow-DOM exposed parts (`::part(name)`), from `@csspart` or a `::part()` selector."
msgstr "Shadow‑DOM blootgestelde parts (`::part(name)`), afkomstig van `@csspart` of een `::part()` selector."

#: renderers/tinymce/src/interfaces/CssDocEntry.md
#, no-c-format
msgctxt "docs.api:text"
msgid "### pseudoElements"
msgstr "### pseudoElements"

