{
  "name": "@pantoken/interactions",
  "version": "0.1.0",
  "description": "Per-component interaction helpers for InstUI components: spacing attributes, invoker commands, and component-specific behaviors.",
  "homepage": "https://pantoken.iywahl.com",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "formats/interactions"
  },
  "files": [
    "dist",
    "component-capabilities.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/interactions.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*.js": "./dist/*.js",
    "./component-capabilities.json": {
      "types": "./component-capabilities.d.ts",
      "default": "./dist/component-capabilities.json"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
