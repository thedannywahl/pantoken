{
  "name": "@pantoken/components",
  "version": "0.6.0",
  "description": "An InstUI-look CSS component library from the pantoken tokens: prose/content styling plus class-based components (button, alert, badge).",
  "homepage": "https://pantoken.iywahl.com",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "formats/components"
  },
  "files": [
    "dist",
    "assets/fonts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./base.css": "./dist/base.css",
    "./components.css": "./dist/components.css",
    "./component-icons.css": "./dist/component-icons.css",
    "./*.css": "./dist/*.css",
    "./icons/*.css": "./dist/icons/*.css",
    "./fonts.css": "./dist/fonts.css",
    "./prose.css": "./dist/prose.css",
    "./select.css": "./dist/select.css",
    "./icons.css": "./dist/icons.css",
    "./utilities.css": "./dist/utilities.css",
    "./spacing.css": "./dist/utilities/spacing.css",
    "./gap.css": "./dist/utilities/gap.css",
    "./layout.css": "./dist/utilities/layout.css",
    "./position.css": "./dist/utilities/position.css",
    "./overflow.css": "./dist/utilities/overflow.css",
    "./cursor.css": "./dist/utilities/cursor.css",
    "./stacking.css": "./dist/utilities/stacking.css",
    "./mask.css": "./dist/utilities/mask.css",
    "./icon.css": "./dist/utilities/icon.css",
    "./screen-reader-content.css": "./dist/utilities/screen-reader-content.css",
    "./transition.css": "./dist/utilities/transition.css",
    "./responsive.css": "./dist/utilities/responsive.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "component-styles": "node scripts/component-styles.ts",
    "dev": "vp run @pantoken/plugin-theme-custom-media#build && node scripts/component-styles.ts && node scripts/generate.ts && node scripts/build-entries.ts && vp pack --watch",
    "test": "vp run @pantoken/plugin-theme-custom-media#build && node scripts/component-styles.ts && vp test",
    "check": "vp run @pantoken/plugin-theme-custom-media#build && node scripts/component-styles.ts && node scripts/build-entries.ts && vp check"
  },
  "dependencies": {
    "@pantoken/plugin-colors": "workspace:*",
    "@pantoken/tokens": "workspace:*",
    "@pantoken/utils": "workspace:*"
  },
  "devDependencies": {
    "@cssdoc/config": "catalog:",
    "@cssdoc/core": "catalog:",
    "@pantoken/icons": "workspace:*",
    "@pantoken/plugin-props-minify": "workspace:*",
    "@pantoken/plugin-theme-custom-media": "workspace:*",
    "@types/node": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pantoken": {
    "key": "components",
    "kind": "namespace"
  }
}
