{
  "name": "@pantoken/demo",
  "version": "0.1.3",
  "description": "Self-hosted, token-themed live-demo runner for docs: resolve a @demo <provider>:<ref> spec to an embeddable iframe, and render bare HTML/CSS/JS demos same-origin.",
  "homepage": "https://pantoken.iywahl.com",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "tools/demo"
  },
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./demo.css": "./assets/demo.css",
    "./card.css": "./assets/card.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "@shikijs/types": "^4.3.1",
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:",
    "dompurify": "^3.4.12",
    "markdown-it": "catalog:",
    "shiki": "^4.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "markdown-it": ">=14"
  },
  "peerDependenciesMeta": {
    "markdown-it": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
