{
  "name": "@pantoken/web-components",
  "version": "0.9.0",
  "description": "Framework-agnostic custom elements for Instructure UI, including A2UI 1.0 Universal components.",
  "homepage": "https://pantoken.app",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "renderers/web-components"
  },
  "files": [
    "dist",
    "src/i18n.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./i18n.json": "./src/i18n.json",
    "./components.css": "./dist/components.css",
    "./*.css": "./dist/*.css",
    "./scaffold-preset": "./dist/scaffold-preset.mjs",
    "./a2ui": "./dist/a2ui.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check:compatibility": "node scripts/check-compatibility.ts",
    "generate": "node ../../ai/pantoken-ai/scripts/generate-a2ui-catalog.ts && node scripts/generate.ts && node scripts/build-bundles.ts",
    "dev": "node ../../ai/pantoken-ai/scripts/generate-a2ui-catalog.ts && node scripts/generate.ts && node scripts/build-bundles.ts && node scripts/build-entries.ts && vp pack --watch",
    "extract": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" extract ui.strings",
    "translate": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate ui.strings --provider claude",
    "translate:agy": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate ui.strings --provider agy",
    "translate:copilot": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate ui.strings --provider copilot",
    "translate:force": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate ui.strings --provider claude --force",
    "translate:force:agy": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate ui.strings --provider agy --force",
    "translate:force:copilot": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate ui.strings --provider copilot --force",
    "check:drift": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" check ui.strings",
    "test": "node ../../ai/pantoken-ai/scripts/generate-a2ui-catalog.ts && vp test",
    "check": "node ../../ai/pantoken-ai/scripts/generate-a2ui-catalog.ts && vp check"
  },
  "dependencies": {
    "@pantoken/components": "workspace:*",
    "@pantoken/icons": "workspace:*",
    "@pantoken/interactions": "workspace:*",
    "@pantoken/model": "workspace:*",
    "@pantoken/scaffold-base": "workspace:*",
    "messageformat": "catalog:"
  },
  "devDependencies": {
    "@a2ui/web_core": "catalog:",
    "@pantoken/i18n-engine": "workspace:*",
    "@types/node": "catalog:",
    "bingo-stratum": "catalog:",
    "happy-dom": "catalog:",
    "lit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@a2ui/web_core": "^0.15.0",
    "lit": "^3.3.3"
  },
  "peerDependenciesMeta": {
    "@a2ui/web_core": {
      "optional": true
    },
    "lit": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pantoken": {
    "key": "webComponents",
    "kind": "namespace"
  }
}
