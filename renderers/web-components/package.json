{
  "name": "@pantoken/web-components",
  "version": "0.5.8",
  "description": "Framework-agnostic custom elements for Instructure UI: <instui-icon> plus token-styled primitives.",
  "homepage": "https://pantoken.app",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "renderers/web-components"
  },
  "files": [
    "dist",
    "src/i18n.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./i18n.json": "./src/i18n.json",
    "./components.css": "./dist/components.css",
    "./*.css": "./dist/*.css",
    "./scaffold-preset": "./dist/scaffold-preset.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/generate.ts && node scripts/build-bundles.ts",
    "dev": "node scripts/generate.ts && node scripts/build-bundles.ts && node scripts/build-entries.ts && vp pack --watch",
    "translate": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" translate ui.strings",
    "check:drift": "i18n --config \"$(git rev-parse --show-toplevel)/i18n.config.json\" check ui.strings",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@pantoken/components": "workspace:*",
    "@pantoken/icons": "workspace:*",
    "@pantoken/interactions": "workspace:*",
    "@pantoken/model": "workspace:*",
    "@pantoken/scaffold-base": "workspace:*",
    "messageformat": "catalog:"
  },
  "devDependencies": {
    "@pantoken/i18n-engine": "workspace:*",
    "@types/node": "catalog:",
    "bingo-stratum": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pantoken": {
    "key": "webComponents",
    "kind": "namespace"
  }
}
