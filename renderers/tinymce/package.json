{
  "name": "@pantoken/tinymce",
  "version": "0.2.10",
  "description": "Shared TinyMCE + CodeMirror editor integration for pantoken: content-CSS wiring, an Insert Template plugin, components/icons/logos pickers with dynamic @import injection, and CodeMirror HTML lint/autocomplete driven by cssdoc.",
  "homepage": "https://pantoken.app",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "renderers/tinymce"
  },
  "files": [
    "dist",
    "src/i18n.json"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./skins/next-gen/skin.css": "./dist/skins/next-gen/skin.css",
    "./skins/next-gen/content.css": "./dist/skins/next-gen/content.css",
    "./skins/canvas/skin.css": "./dist/skins/canvas/skin.css",
    "./skins/canvas/content.css": "./dist/skins/canvas/content.css",
    "./skins/canvas-high-contrast/skin.css": "./dist/skins/canvas-high-contrast/skin.css",
    "./skins/canvas-high-contrast/content.css": "./dist/skins/canvas-high-contrast/content.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "dev": "vp pack --watch",
    "extract": "node ../../tools/i18n-engine/bin/i18n.mjs --config ../../i18n.config.json extract tinymce.strings",
    "translate": "node ../../tools/i18n-engine/bin/i18n.mjs --config ../../i18n.config.json translate tinymce.strings --provider claude",
    "translate:agy": "node ../../tools/i18n-engine/bin/i18n.mjs --config ../../i18n.config.json translate tinymce.strings --provider agy",
    "translate:copilot": "node ../../tools/i18n-engine/bin/i18n.mjs --config ../../i18n.config.json translate tinymce.strings --provider copilot",
    "translate:force": "node ../../tools/i18n-engine/bin/i18n.mjs --config ../../i18n.config.json translate tinymce.strings --provider claude --force",
    "translate:force:agy": "node ../../tools/i18n-engine/bin/i18n.mjs --config ../../i18n.config.json translate tinymce.strings --provider agy --force",
    "translate:force:copilot": "node ../../tools/i18n-engine/bin/i18n.mjs --config ../../i18n.config.json translate tinymce.strings --provider copilot --force",
    "check:drift": "node ../../tools/i18n-engine/bin/i18n.mjs --config ../../i18n.config.json check tinymce.strings",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@cssdoc/core": "catalog:",
    "@pantoken/cdn": "workspace:*",
    "@pantoken/components": "workspace:*",
    "@pantoken/plugin-custom-components": "workspace:*",
    "@pantoken/plugin-custom-icons": "workspace:*",
    "@pantoken/plugin-layouts": "workspace:*",
    "@pantoken/plugin-logos": "workspace:*",
    "@pantoken/plugin-lucide-lab": "workspace:*",
    "@pantoken/plugin-simple-icons": "workspace:*",
    "@pantoken/tinymce-codemirror": "workspace:*",
    "@pantoken/tokens": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@pantoken/utils": "workspace:*",
    "@types/node": "catalog:",
    "less": "catalog:",
    "postcss": "catalog:",
    "tinymce": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.0.0",
    "tinymce": "^8.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pantoken": {
    "key": "tinymce",
    "kind": "subpath"
  }
}
