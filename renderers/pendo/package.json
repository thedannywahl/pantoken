{
  "name": "@pantoken/pendo",
  "version": "0.3.11",
  "description": "Instructure-styled global CSS for Pendo guides, built on pantoken tokens (ported from @instructure/pendo-global-css).",
  "homepage": "https://pantoken.iywahl.com",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "renderers/pendo"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./global.css": "./dist/global.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "embed": "node scripts/embed.ts",
    "generate": "node scripts/generate.ts",
    "dev": "vp run embed && vp run generate && vp pack --watch",
    "test": "vp run embed && vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@pantoken/components": "workspace:*",
    "@pantoken/css": "workspace:*",
    "@pantoken/model": "workspace:*",
    "@pantoken/plugin-props-minify": "workspace:*",
    "@pantoken/tokens": "workspace:*",
    "postcss": "catalog:"
  },
  "devDependencies": {
    "@pantoken/utils": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pantoken": {
    "key": "pendo",
    "kind": "subpath"
  }
}
