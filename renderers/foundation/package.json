{
  "name": "@pantoken/foundation",
  "version": "0.2.1",
  "description": "Theme Foundation for Sites with concrete light-mode Sass settings and a CSS variable overlay.",
  "homepage": "https://pantoken.app",
  "bugs": "https://github.com/thedannywahl/pantoken/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedannywahl/pantoken.git",
    "directory": "renderers/foundation"
  },
  "files": [
    "dist",
    "generated/_settings.scss"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./settings.scss": "./generated/_settings.scss",
    "./theme.css": "./dist/theme.css",
    "./components.css": "./dist/components.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check:compatibility": "node scripts/check-compatibility.ts",
    "generate": "node scripts/generate.ts",
    "dev": "vp run generate && vp pack --watch",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@pantoken/tokens": "workspace:*",
    "@pantoken/utils": "workspace:*"
  },
  "devDependencies": {
    "@pantoken/components": "workspace:*",
    "@pantoken/plugin-props-minify": "workspace:*",
    "@types/node": "catalog:",
    "foundation-sites": "catalog:",
    "postcss": "catalog:",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pantoken": {
    "key": "foundation",
    "kind": "namespace"
  }
}
